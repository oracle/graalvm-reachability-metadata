{
  "resources" : [
    {
      "condition" : {
        "typeReached" : "org.apache.aries.proxy.FinalModifierException"
      },
      "glob" : "META-INF/services/java.util.spi.ResourceBundleControlProvider"
    },
    {
      "condition" : {
        "typeReached" : "org.apache.aries.proxy.FinalModifierException"
      },
      "glob" : "org/apache/aries/proxy/nls/ProxyMessages.properties"
    },
    {
      "bundle" : "org.apache.aries.proxy.nls.ProxyMessages"
    }
  ]
}
