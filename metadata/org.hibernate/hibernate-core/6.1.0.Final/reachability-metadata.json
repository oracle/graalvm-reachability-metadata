{
  "reflection": [
    {
    "condition": {
      "typeReached": "org.hibernate.type.descriptor.JdbcTypeNameMapper"
    },
    "type": "java.sql.Types",
      "allPublicFields": true
    }
  ],
  "resources": [
    {
      "condition": {
        "typeReached": "org.hibernate.boot.registry.classloading.internal.AggregatedClassLoader"
      },
      "glob": "META-INF/services/org.hibernate.*"
    }
  ]
}
