{
  "reflection" : [
    {
      "condition" : {
        "typeReached" : "io.micronaut.web.router.ServerFilterRouteBuilder"
      },
      "type" : "io.micronaut.http.HttpMethod[]"
    }
  ],
  "resources" : [
    {
      "condition" : {
        "typeReached" : "io.micronaut.web.router.resource.StaticResourceResolver"
      },
      "glob" : "META-INF/micronaut-configuration-schemas/io.micronaut.web.router.resource.StaticResourceConfiguration.json"
    },
    {
      "condition" : {
        "typeReached" : "io.micronaut.web.router.resource.StaticResourceResolver"
      },
      "glob" : "META-INF/micronaut-configuration-schemas/missing.json"
    },
    {
      "condition" : {
        "typeReached" : "io.micronaut.web.router.naming.$HyphenatedUriNamingStrategy$Definition"
      },
      "glob" : "META-INF/services/io.micronaut.context.env.PropertyExpressionResolver"
    }
  ]
}
