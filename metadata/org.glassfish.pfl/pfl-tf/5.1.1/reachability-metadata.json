    },
    {
      "condition" : {
        "typeReached" : "org.glassfish.pfl.tf.spi.MethodMonitorRegistry"
      },
      "glob" : "org_glassfish_pfl_pfl_tf/monitors_en_US.properties"
    },
    {
      "bundle" : "org_glassfish_pfl_pfl_tf.monitors"
    }
  ]
