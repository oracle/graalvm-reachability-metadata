{
  "resources" : [
    {
      "condition" : {
        "typeReached" : "io.helidon.config.mp.MpMetaConfig"
      },
      "glob" : "mp-config-sources/meta-config.properties"
    },
    {
      "condition" : {
        "typeReached" : "io.helidon.config.mp.MpPropertiesMetaConfigProvider"
      },
      "glob" : "mp-config-sources/service-dev.properties"
    },
    {
      "condition" : {
        "typeReached" : "io.helidon.config.mp.MpConfigSources"
      },
      "glob" : "mp-config-sources/service.properties"
    }
  ]
}
