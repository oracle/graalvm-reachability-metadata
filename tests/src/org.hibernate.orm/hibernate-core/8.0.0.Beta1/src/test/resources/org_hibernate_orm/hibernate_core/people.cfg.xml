<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <property name="jakarta.persistence.jdbc.driver">org.h2.Driver</property>
        <property name="jakarta.persistence.jdbc.url">jdbc:h2:mem:people_cfg_xml;DB_CLOSE_DELAY=-1</property>
        <property name="jakarta.persistence.jdbc.user">sa</property>
        <property name="hibernate.hbm2ddl.auto">create-drop</property>
        <mapping class="org_hibernate_orm.hibernate_core.entity.Person"/>
        <mapping package="org_hibernate_orm.hibernate_core.packaged"/>
    </session-factory>
</hibernate-configuration>
