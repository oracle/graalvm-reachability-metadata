nate-models:2.0.0.Alpha1/gradle-test/gradle-test-2026-09-28T22-32-13-455147Z.log\n/home/oracle/oracle/graalvm-reachability-metadata/forge/logs/org.hibernate.models:hibernate-models:2.0.0.Alpha1/gradle-test/gradle-test-2026-09-28T22-31-15-860209Z.log\n/home/oracle/oracle/graalvm-reachability-metadata/forge/logs/org.hibernate.models:hibernate-models:2.0.0.Alpha1/gradle-test/gradle-test-2026-09-28T22-13-31-672386Z.log\n/home/oracle/oracle/graalvm-reachability-metadata/forge/logs/org.hibernate.models:hibernate-models:2.0.0.Alpha1/gradle-test/gradle-test-2026-09-28T22-31-10-225333Z.log\n/home/oracle/oracle/graalvm-reachability-metadata/forge/logs/org.hibernate.models:hibernate-models:2.0.0.Alpha1/gradle-test/gradle-test-2026-09-28T21-49-59-241217Z.log\n/home/oracle/oracle/graalvm-reachability-metadata/forge/logs/org.hibernate.models:hibernate-models:2.0.0.Alpha1/gradle-test/gradle-test-2026-09-28T22-09-05-691976Z.log\n/home/oracle/oracle/graalvm-reachability-metadata/forge/logs/org.hibernate.models:hibernate-models:2.0.0.Alpha1/gradle-test/gradle-test-2026-09-28T22-27-24-385334Z.log", "truncated": true, "truncatedBy": "bytes", "totalLines": 401, "totalBytes": 65949, "outputLines": 308, "outputBytes": 51058, "lastLinePartial": false, "firstLineExceedsLimit": false, "maxLines": 2000, "maxBytes": 51200}, "fullOutputPath": "/tmp/pi-bash-09cabeb9133ffa4d.log"}, "isError": false, "timestamp": 1792537835210}}
