/hadoop-common/2.2.0/src/test/java/org_apache_hadoop/hadoop_common/HttpServerTest.java\n/home/mihailo/git/graalvm-reachability-metadata/forge/local_repositories/forge_worktrees/5373-c215ea75/tests/src/org.apache.hadoop/hadoop-common/2.2.0/src/test/java/org_apache_hadoop/hadoop_common/CompositeContextInnerMetricsRecordDelegatorTest.java\n/home/mihailo/git/graalvm-reachability-metadata/forge/local_repositories/forge_worktrees/5373-c215ea75/tests/src/org.apache.hadoop/hadoop-common/2.2.0/src/test/java/org_apache_hadoop/hadoop_common/ClassUtilTest.java\n/home/mihailo/git/graalvm-reachability-metadata/forge/local_repositories/forge_worktrees/5373-c215ea75/tests/src/org.apache.hadoop/hadoop-common/2.2.0/src/test/java/org_apache_hadoop/hadoop_common/ProtocolProxyTest.java\n/home/mihailo/git/graalvm-reachability-metadata/forge/local_repositories/forge_worktrees/5373-c215ea75/tests/src/org.apache.hadoop/hadoop-common/2.2.0/src/test/java/org_apache_hadoop/hadoop_common/CompositeContextTest.java\n/home/mihailo/git/graalvm-reachability-metadata/forge/local_repositories/forge_worktrees/5373-c215ea75/tests/src/org.apache.hadoop/hadoop-common/2.2.0/src/test/java/org_apache_hadoop/hadoop_common/Retr
