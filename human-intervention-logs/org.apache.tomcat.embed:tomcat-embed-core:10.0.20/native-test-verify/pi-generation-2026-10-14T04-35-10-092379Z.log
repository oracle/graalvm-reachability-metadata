rvlet.**\"\n+    },\n+    {\n+      \"includeClasses\" : \"org.apache.**\"\n+    },\n+    {\n+      \"includeClasses\" : \"tomcat.**\"\n+    },\n+    {\n+      \"includeClasses\" : \"org_apache_tomcat_embed.tomcat_embed_core.**\"\n     }\n   ]\n }\n"}], "isError": false, "timestamp": 1791952585890}}
