  530:                 negativeMethodLookups.computeIfAbsent(metaAccess.lookupJavaType(declaringClass), (key) -> ConcurrentHashMap.newKeySet())
  531:                                 .add(new AnalysisMethod.Signature(methodName, metaAccess.lookupJavaTypes(parameterTypes)));
  532:             } catch (LinkageError le) {
  533:                 registerLinkageError(declaringClass, le, methodLookupExceptions);
  534:             }
