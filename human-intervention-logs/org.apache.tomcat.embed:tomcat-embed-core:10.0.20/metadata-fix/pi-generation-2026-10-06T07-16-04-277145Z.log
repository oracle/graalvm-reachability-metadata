  448:     private void registerMethod(ConfigurationCondition cnd, boolean queriedOnly, Executable reflectExecutable) {
  449:         if (reflectivityFilter.shouldExclude(reflectExecutable)) {
  450:             return;
  451:         }
  452: 
  453:         AnalysisMethod analysisMethod = metaAccess.lookupJavaMethod(reflectExecutable);
  454:         AnalysisType declaringType = analysisMethod.getDeclaringClass();
  455:         var classMethods = registeredMethods.computeIfAbsent(declaringType, t -> new ConcurrentHashMap<>());
  456:         var shouldRegisterReachabilityHandler = classMethods.isEmpty();
  457: 
  458:         boolean registered = false;
  459:         ConditionalRuntimeValue<Executable> conditionalValue = classMethods.get(analysisMethod);
  460:         if (conditionalValue == null) {
  461:             var newConditionalValue = new ConditionalRuntimeValue<>(RuntimeConditionSet.emptySet(), reflectExecutable);
  462:             conditionalValue = classMethods.putIfAbsent(analysisMethod, newConditionalValue);
  463:             if (conditionalValue == null) {
  464:                 conditionalValue = newConditionalValue;
  465:                 registered = true;
  466:             }
  505:                     return unregisteredAccessors;
  506:                 });
  507:             }
  508:         }
  509: 
  510:         /*
  511:          * We need to run this even if the method has already been registered, in case it was only
  512:          * registered as queried.
  513:          */
  514:         if (!queriedOnly) {
  515:             methodAccessors.computeIfAbsent(analysisMethod, aMethod -> {
  516:                 SubstrateAccessor accessor = ImageSingletons.lookup(ReflectionFeature.class).getOrCreateAccessor(reflectExecutable);
  517:                 universe.getHeapScanner().rescanObject(accessor);
  518:                 return accessor;
  519:             });
  520:         }
  521:     }
