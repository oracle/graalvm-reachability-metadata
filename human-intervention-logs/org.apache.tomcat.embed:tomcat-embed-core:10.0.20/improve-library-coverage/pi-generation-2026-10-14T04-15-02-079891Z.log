ion 'jakarta.servlet:jakarta.servlet-api:5.0.0'\n\ttestImplementation 'org.assertj:assertj-core:3.22.0'\n\ttestRuntimeOnly 'org.apache.tomcat:jakartaee-migration:1.0.6'\n    testImplementation \"com.h2database:h2:2.2.224\"\n    testImplementation \"jakarta.annotation:jakarta.annotation-api:3.0.0\"\n}\n\nString digesterPropertySource =\n        '-Dorg.apache.tomcat.util.digester.PROPERTY_SOURCE=org.apache.tomcat.util.digester.SystemPropertySource'\n\ntasks.withType(Test).configureEach {\n    jvmArgs digesterPropertySource\n}\n\ntasks.named(\"nativeTest\") {\n    runtimeArgs.add(\"-Djava.home=${javaHome}\")\n    runtimeArgs.add(digesterPropertySource)\n}\n\ngraalvmNative {\n    binaries {\n        test {\n            buildArgs.add('--allow-incomplete-classpath')\n            runtimeArgs(\"-Djava.home=${javaHome}\", digesterPropertySource)\n        }\n    }\n    agent {\n        defaultMode = \"conditional\"\n        modes {\n            conditional {\n                userCodeFilterPath = \"user-code-filter.json\"\n            }\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1791957264892}, {"role": "toolResult", "toolCallId": "call_mfKHaOAchvnXDz6DUhrWTpj9|fc_0e79467fc6ad5e21016acf1910159087d09e4a7aab1f75ce9c", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_tomcat_embed.tomcat_embed_core;\n\nimport java.util.Map;\nimport java.util.concurrent.atomic.AtomicBoolean;\n\nimport javax.security.auth.Subject;\nimport javax.security.auth.callback.CallbackHandler;\n\nimport jakarta.security.auth.message.AuthException;\nimport jakarta.security.auth.message.AuthStatus;\nimport jakarta.security.auth.message.MessageInfo;\nimport jakarta.security.auth.message.config.AuthConfigFactory;\nimport jakarta.security.auth.message.config.AuthConf