/src/org.apache.tomcat.embed/tomcat-embed-core/11.0.23/src/test/resources/ProxyErrorReportValve.properties\ntests/src/org.apache.tomcat.embed/tomcat-embed-core/11.0.23/src/test/resources/server-embed.xml\ntests/src/org.apache.tomcat.embed/tomcat-embed-core/11.0.23/src/test/resources/tomcat/jaas-realm-resource.config\ntests/src/org.apache.tomcat.embed/tomcat-embed-core/10.0.20/build.gradle\ntests/src/org.apache.tomcat.embed/tomcat-embed-core/10.0.20/.gradle\ntests/src/org.apache.tomcat.embed/tomcat-embed-core/10.0.20/settings.gradle\ntests/src/org.apache.tomcat.embed/tomcat-embed-core/11.0.18/build.gradle\ntests/src/org.apache.tomcat.embed/tomcat-embed-core/11.0.18/settings.gradle\ntests/src/org.apache.tomcat.embed/tomcat-embed-core/11.0.22/build.gradle\ntests/src/org.apache.tomcat.embed/tomcat-embed-core/11.0.22/settings.gradle\ntests/src/org.apache.tomcat.embed/tomcat-embed-core/11.0.23/build.gradle\ntests/src/org.apache.tomcat.embed/tomcat-embed-core/11.0.23/settings.gradle\n M forge/.continuation-marker.json\n"}], "isError": false, "timestamp": 1791951324288}}
