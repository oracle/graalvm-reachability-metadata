          if (code != null) {
              code.append(digester.toVariableName(child)).append(".setParentClassLoader(");
              code.append(digester.toVariableName(parent)).append(".getParentClassLoader());");
              code.append(System.lineSeparator());
          }
      }
  
  
  }
