etPath()).isEqualTo(\"/application\");\n            assertThat(context.getDocBase()).isEqualTo(directory.toAbsolutePath().toString());\n            assertThat(Arrays.stream(listeners)).anyMatch(ContextConfig.class::isInstance);\n        } finally {\n            tomcat.destroy();\n        }\n    }\n\n    @Test\n    void createsHostConfiguredContextImplementation(@TempDir Path directory) throws Exception {\n        Tomcat tomcat = new Tomcat();\n        tomcat.setBaseDir(directory.resolve(\"base\").toString());\n        ((StandardHost) tomcat.getHost()).setContextClass(FailedContext.class.getName());\n\n        try {\n            Context context = tomcat.addContext(null, \"/custom\", directory.toAbsolutePath().toString());\n\n            assertThat(context).isInstanceOf(FailedContext.class);\n            assertThat(context.getPath()).isEqualTo(\"/custom\");\n        } finally {\n            tomcat.destroy();\n        }\n    }\n}\n"}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-sol", "usage": {"input": 669, "output": 758, "cacheRead": 121344, "cacheWrite": 0, "reasoning": 166, "totalTokens": 122771, "cost": {"input": 0.002676, "output": 0.015160000000000002, "cacheRead": 0.04853760000000001, "cacheWrite": 0, "total": 0.0663736}}, "stopReason": "toolUse", "timestamp": 1791951535021, "responseId": "resp_0432a73627f9cce4016acf02b07c0487d08e543e915159b4d1", "rawStopReason": "completed"}, "toolResults": [{"role": "toolResult", "toolCallId": "call_u1VCbv9TyLmneOYG4eSupFyh|fc_0432a73627f9cce4016acf02b7827887d095f9f08939bef604", "toolName": "write", "content": [{"type": "text", "text": "Successfully wrote to tests/src/org.apache.tomcat.embed/tomcat-embed-core/10.0.20/src/test/java/org_apache_tomcat_embed/tomcat_embed_core/TomcatTest.java"}], "isError": false, "timestamp": 1791951557735}]}
