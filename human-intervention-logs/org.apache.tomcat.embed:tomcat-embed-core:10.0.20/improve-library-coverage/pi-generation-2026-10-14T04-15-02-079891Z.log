[tool-exec] start id=call_x4kiUCjM4xFvWjo9xkizxAfR|fc_0e79467fc6ad5e21016acf18f2d12087d0b82261d9a2d7499e name=write args={"path": "tests/src/org.apache.tomcat.embed/tomcat-embed-core/10.0.20/src/test/java/org_apache_tomcat_embed/tomcat_embed_core/CopyParentClassLoaderRuleTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_tomcat_embed.tomcat_embed_core;\n\nimport java.io.ByteArrayInputStream;\nimport java.nio.charset.StandardCharsets;\n\nimport org.apache.catalina.core.StandardEngine;\nimport org.apache.catalina.core.StandardHost;\nimport org.apache.catalina.startup.CopyParentClassLoaderRule;\nimport org.apache.tomcat.util.digester.Digester;\nimport org.junit.jupiter.api.Test;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\npublic class CopyParentClassLoaderRuleTest {\n\n    @Test\n    void copiesTheParentContainerClassLoaderToItsChild() throws Exception {\n        ClassLoader parentLoader = getClass().getClassLoader();\n        StandardEngine engine = new StandardEngine();\n        engine.setParentClassLoader(parentLoader);\n        StandardHost host = new StandardHost();\n        Digester digester = new Digester();\n        digester.push(engine);\n        digester.addObjectCreate(\"Host\", StandardHost.class.getName());\n        digester.addRule(\"Host\", new CopyParentClassLoaderRule());\n        digester.addSetNext(\"Host\", \"addChild\", \"org.apache.catalina.Container\");\n\n        digester.parse(new ByteArrayInputStream(\"<Host/>\".getBytes(StandardCharsets.UTF_8)));\n\n        assertThat(engine.findChildren()).hasSize(1);\n        assertThat(engine.findChildren()[0].getParentClassLoader()).isSameAs(parentLoader);\n        assertThat(host.getParentClassLoader()).isNull();\n    }\n}\n"}
[tool-exec] start id=call_3jF4dQq7Csrm3kGzXpNcpDaN|fc_0e79467fc6ad5e21016acf18f2d12887d0bad27a144d74a35f name=write args={"path": "tests/src/org.apache.tomcat.embed/tomcat-embed-core/10.0.20/src/test/java/org_apache_tomcat_embed/tomcat_embed_core/WebappClassLoaderBaseTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_tomcat_embed.tomcat_embed_core;\n\nimport java.io.InputStream;\n\nimport org.apache.catalina.loader.ParallelWebappClassLoader;\nimport org.junit.jupiter.api.Test;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\npublic class WebappClassLoaderBaseTest {\n\n    private static final String CLASS_RESOURCE =\n            \"org_apache_tomcat_embed/tomcat_embed_core/WebappClassLoaderBaseTest.class\";\n\n    @Test\n    void delegatesClassAndResourceLookupsToItsParent() throws Exception {\n        try (ParallelWebappClassLoader loader =\n                new ParallelWebappClassLoader(WebappClassLoaderBaseTest.class.getClassLoader())) {\n            loader.setDelegate(true);\n\n            assertThat(loader.loadClass(getClass().getName())).isSameAs(getClass());\n            assertThat(loader.getResource(CLASS_RESOURCE)).isNotNull();\n            try (InputStream input = loader.getResourceAsStream(CLASS_RESOURCE)) {\n                assertThat(input).isNotNull();\n                assertThat(input.read()).isNotNegative();\n            }\n        }\n    }\n}\n"}
