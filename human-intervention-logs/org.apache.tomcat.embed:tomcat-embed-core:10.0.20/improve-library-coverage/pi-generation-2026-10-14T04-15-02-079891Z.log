omcat-embed-core/10.0.20/src/test/java/org_apache_tomcat_embed/tomcat_embed_core/BootstrapTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_tomcat_embed.tomcat_embed_core;\n\nimport java.nio.file.Files;\nimport java.nio.file.Path;\n\nimport org.apache.catalina.startup.Bootstrap;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.io.TempDir;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\npublic class BootstrapTest {\n\n    @Test\n    void delegatesServerLifecycleToCatalina(@TempDir Path catalinaBase) throws Exception {\n        Path serverXml = createServerXml(catalinaBase);\n        Bootstrap bootstrap = new Bootstrap();\n        bootstrap.init(new String[] {\"-config\", serverXml.toString(), \"-nonaming\", \"start\" });\n\n        bootstrap.setAwait(false);\n        bootstrap.start();\n        assertThat(System.getProperty(\"catalina.base\")).isNotBlank();\n\n        bootstrap.stopServer(new String[] {\"stop\" });\n        bootstrap.stopServer();\n        bootstrap.stop();\n    }\n\n    @Test\n    void validatesServerConfigurationThroughMainEntryPoint(@TempDir Path catalinaBase) throws Exception {\n        Path serverXml = createServerXml(catalinaBase);\n\n        Bootstrap.main(new String[] {\"-config\", serverXml.toString(), \"-nonaming\", \"configtest\" });\n\n        assertThat(Files.isRegularFile(serverXml)).isTrue();\n    }\n\n    private static Path createServerXml(Path catalinaBase) throws Exception {\n        Files.createDirectories(catalinaBase.resolve(\"conf\"));\n        Files.createDirectories(catalinaBase.resolve(\"logs\"));\n        Files.createDirectories(catalinaBase.resolve(\"temp\"));\n        Files.createDirectories(catalinaBase.resolve(\"webapps\"));\n        Files.createDirectories(catalinaBase.resolve(\"work\"));\n        Path serverXml = catalinaBase.resolve(\"conf/server.xml\");\n        Files.writeString(serverXml, \"\"\"\n                <?xml version=\"1.0\" encoding=\"UTF-8\"?>\n                <Server port=\"-2\" shutdown=\"SHUTDOWN\">\n                  <Service name=\"Catalina\">\n                    <Engine name=\"Catalina\" defaultHost=\"localhost\">\n                      <Host name=\"localhost\" appBase=\"webapps\" autoDeploy=\"false\" deployOnStartup=\"false\" />\n                    </Engine>\n                  </Service>\n                </Server>\n                \"\"\");\n        return serverXml;\n    }\n}\n"}}, {"type": "toolCall", "id": "call_PKcMqwca5sxHcobbLOcYLZe2|fc_0e79467fc6ad5e21016acf18f2d0fc87d0a936a31af8cfc154", "name": "write", "arguments": {"path": "tests/src/org.apache.tomcat.embed/tomcat-embed-core/10.0.20/src/test/java/org_apache_tomcat_embed/tomcat_embed_core/JreMemoryLeakPreventionListenerTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_tomcat_embed.tomcat_embed_core;\n\nimport java.util.concurrent.atomic.AtomicBoolean;\n\nimport org.apache.catalina.Lifecycle;\nimport org.apache.catalina.LifecycleEvent;\nimport org.apache.catalina.core.JreMemoryLeakPreventionListener;\nimport org.apache.catalina.core.StandardServer;\nimport org.junit.jupiter.api.Test;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\npublic class JreMemoryLeakPreventionListenerTest {\n\n    private static final AtomicBoolean INITIALIZED = new AtomicBoolean();\n\n    @Test\n    void initializesConfiguredClassBeforeServerInitialization() {\n        INITIALIZED.set(false);\n        JreMemoryLeakPreventionListener listener = new JreMemoryLeakPreventionListener();\n        listener.setAppContextProtection(false);\n        listener.setDriverManagerProtection(false);\n        listener.setUrlCacheProtection(false);\n        listener.setClassesToInitialize(StartupComponent.class.getName());\n\n        listener.lifecycleEvent(new LifecycleEvent(new StandardServer(), Lifecycle.BEFORE_INIT_EVENT, null));\n\n        assertThat(INITIALIZED).isTrue();\n    }\n\n    public static final class StartupComponent {\n\n        static {\n            INITIALIZED.set(true);\n        }\n\n        private StartupComponent() {\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_cpDIYI0CadJPgI2X78b85NwV|fc_0e79467fc6ad5e21016acf18f2d10887d08e1d85fa94e7e0cd", "name": "write", "arguments": {"path": "tests/src/org.apache.tomcat.embed/tomcat-embed-core/10.0.20/src/test/java/org_apache_tomcat_embed/tomcat_embed_core/DigesterTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_tomcat_embed.tomcat_embed_core;\n\nimport java.io.ByteArrayInputStream;\nimport java.nio.charset.StandardCharsets;\nimport java.util.concurrent.atomic.AtomicReference;\n\nimport org.apache.tomcat.util.digester.Digester;\nimport org.apache.tomcat.util.digester.Rule;\nimport org.junit.jupiter.api.Test;\nimport org.xml.sax.Attributes;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\npublic class DigesterTest {\n\n    @Test\n    void resolvesSystemPropertiesWhileParsingXml() throws Exception {\n        String propertyName = \"tomcat.test.digester.message\";\n        String previousValue = System.getProperty(propertyName);\n        System.setProperty(propertyName, \"resolved-message\");\n        AtomicReference<String> parsedMessage = new AtomicReference<>();\n        Digester digester = new Digester();\n        digester.addRule(\"message\", new Rule() {\n            @Override\n            public void begin(String namespace, String name, Attributes attributes) {\n                parsedMessage.set(attributes.getValue(\"text\"));\n            }\n        });\n\n        try {\n            String xml = \"<message text=\\\"${\" + propertyName + \"}\\\"/>\";\n            digester.parse(new ByteArrayInputStream(xml.getBytes(StandardCharsets.UTF_8)));\n        } finally {\n            if (previousValue == null) {\n                System.clearProperty(propertyName);\n            } else {\n                System.setProperty(propertyName, previousValue);\n            }\n        }\n\n        assertThat(parsedMessage).hasValue(\"resolved-message\");\n    }\n}\n"}}, {"type": "toolCall", "id": "call_DNbVV00KZz0U49q7Ys8xwBwT|fc_0e79467fc6ad5e21016acf18f2d11087d0b877c417c3e35e1e", "name": "write", "arguments": {"path": "tests/src/org.apache.tomcat.embed/tomcat-embed-core/10.0.20/src/test/java/org_apache_tomcat_embed/tomcat_embed_core/TomcatInnerExistingStandardWrapperTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_tomcat_embed.tomcat_embed_core;\n\nimport java.util.concurrent.atomic.AtomicInteger;\n\nimport jakarta.servlet.ServletConfig;\nimport jakarta.servlet.ServletException;\nimport jakarta.servlet.SingleThreadModel;\nimport jakarta.servlet.http.HttpServlet;\nimport org.apache.catalina.Wrapper;\nimport org.apache.catalina.core.StandardContext;\nimport org.apache.catalina.startup.Tomcat;\nimport org.junit.jupiter.api.Test;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\n@SuppressWarnings(\"deprecation\")\npublic class TomcatInnerExistingStandardWrapperTest {\n\n    @Test\n    void createsASeparateInitializedServletForSingleThreadModel() throws Exception {\n        CountingServlet.reset();\n        CountingServlet suppliedServlet = new CountingServlet();\n        StandardContext context = new StandardContext();\n        context.setName(\"existing-servlet-context\");\n        Wrapper wrapper = Tomcat.addServlet(context, \"counting\", suppliedServlet);\n\n        CountingServlet loadedServlet = (CountingServlet) wrapper.loadServlet();\n\n        assertThat(loadedServlet).isNotSameAs(suppliedServlet);\n        assertThat(CountingServlet.instances()).isEqualTo(2);\n        assertThat(CountingServlet.initializations()).isEqualTo(1);\n    }\n\n    public static final class CountingServlet extends HttpServlet implements SingleThreadModel {\n\n        private static final AtomicInteger INSTANCES = new AtomicInteger();\n        private static final AtomicInteger INITIALIZATIONS = new AtomicInteger();\n\n        public CountingServlet() {\n            INSTANCES.incrementAndGet();\n        }\n\n        @Override\n        public void init(ServletConfig config) throws ServletException {\n            INITIALIZATIONS.incrementAndGet();\n        }\n\n        private static void reset() {\n            INSTANCES.set(0);\n            INITIALIZATIONS.set(0);\n        }\n\n        private static int instances() {\n            return INSTANCES.get();\n        }\n\n        private static int initializations() {\n            return INITIALIZATIONS.get();\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_uYw2xJDl1aPiESQK78tdlaYT|fc_0e79467fc6ad5e21016acf18f2d11887d0b3bbd6378c545e1f", "name": "write", "arguments": {"path": "tests/src/org.apache.tomcat.embed/tomcat-embed-core/10.0.20/src/test/java/org_apache_tomcat_embed/tomcat_embed_core/LifecycleListenerRuleTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_tomcat_embed.tomcat_embed_core;\n\nimport java.io.ByteArrayInputStream;\nimport java.nio.charset.StandardCharsets;\nimport java.util.Arrays;\n\nimport org.apache.catalina.core.StandardHost;\nimport org.apache.catalina.startup.HostConfig;\nimport org.apache.catalina.startup.LifecycleListenerRule;\nimport org.apache.tomcat.util.digester.Digester;\nimport org.junit.jupiter.api.Test;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\npublic class LifecycleListenerRuleTest {\n\n    @Test\n    void createsAndAttachesConfiguredLifecycleListener() throws Exception {\n        StandardHost host = new StandardHost();\n        Digester digester = new Digester();\n        digester.push(host);\n        digester.addRule(\"Host\", new LifecycleListenerRule(HostConfig.class.getName(), \"configClass\"));\n\n        digester.parse(new ByteArrayInputStream(\"<Host/>\".getBytes(StandardCharsets.UTF_8)));\n\n        assertThat(Arrays.stream(host.findLifecycleListeners())).anyMatch(HostConfig.class::isInstance);\n    }\n}\n"}}, {"type": "toolCall", "id": "call_x4kiUCjM4xFvWjo9xkizxAfR|fc_0e79467fc6ad5e21016acf18f2d12087d0b82261d9a2d7499e", "name": "write", "arguments": {"path": "tests/src/org.apache.tomcat.embed/tomcat-embed-core/10.0.20/src/test/java/org_apache_tomcat_embed/tomcat_embed_core/CopyParentClassLoaderRuleTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_tomcat_embed.tomcat_embed_core;\n\nimport java.io.ByteArrayInputStream;\nimport java.nio.charset.StandardCharsets;\n\nimport org.apache.catalina.core.StandardEngine;\nimport org.apache.catalina.core.StandardHost;\nimport org.apache.catalina.startup.CopyParentClassLoaderRule;\nimport org.apache.tomcat.util.digester.Digester;\nimport org.junit.jupiter.api.Test;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\npublic class CopyParentClassLoaderRuleTest {\n\n    @Test\n    void copiesTheParentContainerClassLoaderToItsChild() throws Exception {\n        ClassLoader parentLoader = getClass().getClassLoader();\n        StandardEngine engine = new StandardEngine();\n        engine.setParentClassLoader(parentLoader);\n        StandardHost host = new StandardHost();\n        Digester digester = new Digester();\n        digester.push(engine);\n        digester.addObjectCreate(\"Host\", StandardHost.class.getName());\n        digester.addRule(\"Host\", new CopyParentClassLoaderRule());\n        digester.addSetNext(\"Host\", \"addChild\", \"org.apache.catalina.Container\");\n\n        digester.parse(new ByteArrayInputStream(\"<Host/>\".getBytes(StandardCharsets.UTF_8)));\n\n        assertThat(engine.findChildren()).hasSize(1);\n        assertThat(engine.findChildren()[0].getParentClassLoader()).isSameAs(parentLoader);\n        assertThat(host.getParentClassLoader()).isNull();\n    }\n}\n"}}, {"type": "toolCall", "id": "call_3jF4dQq7Csrm3kGzXpNcpDaN|fc_0e79467fc6ad5e21016acf18f2d12887d0bad27a144d74a35f", "name": "write", "arguments": {"path": "tests/src/org.apache.tomcat.embed/tomcat-embed-core/10.0.20/src/test/java/org_apache_tomcat_embed/tomcat_embed_core/WebappClassLoaderBaseTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_tomcat_embed.tomcat_embed_core;\n\nimport java.io.InputStream;\n\nimport org.apache.catalina.loader.ParallelWebappClassLoader;\nimport org.junit.jupiter.api.Test;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\npublic class WebappClassLoaderBaseTest {\n\n    private static final String CLASS_RESOURCE =\n            \"org_apache_tomcat_embed/tomcat_embed_core/WebappClassLoaderBaseTest.class\";\n\n    @Test\n    void delegatesClassAndResourceLookupsToItsParent() throws Exception {\n        try (ParallelWebappClassLoader loader =\n                new ParallelWebappClassLoader(WebappClassLoaderBaseTest.class.getClassLoader())) {\n           