  	@ConditionalOnMissingBean(name = BeanIds.SPRING_SECURITY_FILTER_CHAIN)
  	@ConditionalOnClass(EnableWebSecurity.class)
  	@EnableWebSecurity
  	static class EnableWebSecurityConfiguration {
  
  	}
  
  }
