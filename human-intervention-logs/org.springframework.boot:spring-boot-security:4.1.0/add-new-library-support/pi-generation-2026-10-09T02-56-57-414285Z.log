buildOutputCleanup/outputFiles.bin\n./tests/src/org.springframework.boot/spring-boot-security/4.1.0/.gradle/buildOutputCleanup/buildOutputCleanup.lock\n./tests/src/org.springframework.boot/spring-boot-security/4.1.0/.gradle/buildOutputCleanup/cache.properties\n./tests/src/org.springframework.boot/spring-boot-security/4.1.0/.gradle/vcs-1\n./tests/src/org.springframework.boot/spring-boot-security/4.1.0/.gradle/vcs-1/gc.properties\n./tests/src/org.springframework.boot/spring-boot-security/4.1.0/.gradle/noVersion\n./tests/src/org.springframework.boot/spring-boot-security/4.1.0/.gradle/noVersion/buildLogic.lock\n./tests/src/org.springframework.boot/spring-boot-security/4.1.0/.gradle/file-system.probe\n./tests/src/org.springframework.boot/spring-boot-security/4.1.0/build\n./tests/src/org.springframework.boot/spring-boot-security/4.1.0/build/jacoco\n./tests/src/org.springframework.boot/spring-boot-security/4.1.0/build/jacoco/effective\n./tests/src/org.springframework.boot/spring-boot-security/4.1.0/build/jacoco/effective/spring_boot_security_4_1_0_jar\n./tests/src/org.springframework.boot/spring-boot-security/4.1.0/build/jacoco/effective/spring_boot_security_4_1_0_jar/META-INF\n./tests/src/org.springframework.boot/spring-boot-security/4.1.0/build/jacoco/effective/spring_boot_security_4_1_0_jar/META-INF/spring\n./tests/src/org.springframework.boot/spring-boot-security/4.1.0/build/jacoco/effective/spring_boot_security_4_1_0_jar/org\n./tests/src/org.springframework.boot/spring-boot-security/4.1.0/build/jacoco/effective/spring_boot_security_4_1_0_jar/org/springframework\n./tests/src/org.springframework.boot/spring-boot-security/4.1.0/build/jacoco/effective/spring_boot_security_4_1_0_jar/org/springframework/boot\n./tests/src/org.springframework.boot/spring-boot-security/4.1.0/build/jacoco/effective/spring_boot_security_4_1_0_jar/org/springframework/boot/security\n./tests/src/org.springframework.boot/spring-boot-security/4.1.0/build/jacoco/effective/spring_boot_security_4_1_0_jar/org/springframework/boot/security/web\n./tests/src/org.springframework.boot/spring-boot-security/4.1.0/build/jacoco/effective/spring_boot_security_4_1_0_jar/org/springframework/boot/security/web/servlet\n./tests/src/org.springframework.boot/spring-boot-security/4.1.0/build/jacoco/effective/spring_boot_security_4_1_0_jar/org/springframework/boot/security/web/servlet/package-info.class\n./tests/src/org.springframework.boot/spring-boot-security/4.1.0/build/jacoco/effective/spring_boot_security_4_1_0_jar/org/springframework/boot/security/web/servlet/ApplicationContextRequestMatcher.class\n./tests/src/org.springframework.boot/spring-boot-security/4.1.0/build/jacoco/effective/spring_boot_security_4_1_0_jar/org/springframework/boot/security/web/reactive\n./tests/src/org.springframework.boot/spring-boot-security/4.1.0/build/jacoco/effective/spring_boot_security_4_1_0_jar/org/springframework/boot/security/web/reactive/ApplicationContextServerWebExchangeMatcher.class\n./tests/src/org.springframework.boot/spring-boot-security/4.1.0/build/jacoco/effective/spring_boot_security_4_1_0_jar/org/springframework/boot/security/web/reactive/package-info.class\n./tests/src/org.springframework.boot/spring-boot-security/4.1.0/build/jacoco/effective/spring_boot_security_4_1_0_jar/org/springframework/boot/security/autoconfigure\n./tests/src/org.springframework.boot/spring-boot-security/4.1.0/build/jacoco/effective/spring_boot_security_4_1_0_jar/org/springframework/boot/security/autoconfigure/MissingAlternativeUserDetailsManagerOrUserPropertiesConfigured.class\n./tests/src/org.springframework.boot/spring-boot-security/4.1.0/build/jacoco/effective/spring_boot_security_4_1_0_jar/org/springframework/boot/security/autoconfigure/SecurityProperties.class\n./tests/src/org.springframework.boot/spring-boot-security/4.1.0/build/jacoco/effective/spring_boot_security_4_1_0_jar/org/springframework/boot/security/autoconfigure/ReactiveUserDetailsServiceAutoConfiguration$RSocketEnabledOrReactiveWebApplicat