tThat;\n\npublic class HibernateSpatialTest {\n\n    @Test\n    void discoversSpatialIntegrationThroughServiceRegistry() {\n        StandardServiceRegistry registry = new StandardServiceRegistryBuilder().build();\n        try {\n            SpatialService spatialService = registry.getService(SpatialService.class);\n\n            assertThat(spatialService).isNotNull();\n            assertThat(spatialService.isEnabled()).isTrue();\n        } finally {\n            StandardServiceRegistryBuilder.destroy(registry);\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1790465715589}, {"role": "toolResult", "toolCallId": "call_o6LmXDGcAiJMIyBYmeRoiwdw|fc_03e5a883d45eb735016ab856b37d4487d2bc7acc7938dc6811", "toolName": "bash", "content": [{"type": "text", "text": "metadata/org.hibernate/hibernate-spatial/7.2.0.Final/reachability-metadata.json:31:        \"typeReached\": \"org.hibernate.internal.CoreMessageLogger\"\nmetadata/org.hibernate/hibernate-spatial/7.2.0.Final/reachability-metadata.json:33:      \"type\": \"org.hibernate.internal.CoreMessageLogger_$logger\",\nmetadata/org.hibernate/hibernate-spatial/7.2.0.Final/reachability-metadata.json:45:        \"typeReached\": \"org.hibernate.internal.CoreMessageLogger\"\nmetadata/org.hibernate/hibernate-spatial/7.2.0.Final/reachability-metadata.json:47:      \"type\": \"org.hibernate.internal.CoreMessageLogger_$logger_en\"\nmetadata/org.hibernate/hibernate-spatial/7.2.0.Final/reachability-metadata.json:51:        \"typeReached\": \"org.hibernate.internal.CoreMessageLogger\"\nmetadata/org.hibernate/hibernate-spatial/7.2.0.Final/reachability-metadata.json:53:      \"type\": \"org.hibernate.internal.CoreMessageLogger_$logger_en_US\"\nmetadata/org.hibernate/hibernate-spatial/7.2.0.Final/reachability-metadata.json:83:        \"typeReached\": \"org.hibernate.spatial.integration.SpatialService\"\nmetadata/org.hibernate/hibernate-spatial/7.2.0.Final/reachability-metadata.json:85:      \"type\": \"org.hibernate.spatial.HSMessageLo