ss HibernateSpatialTest {\n \n     @Test\n-    void test() throws Exception {\n-        new SpatialInitializer().contribute(new StandardServiceRegistryBuilder());\n+    public void discoversAndEnablesSpatialIntegration() {\n+        StandardServiceRegistry registry = new StandardServiceRegistryBuilder().build();\n+        try {\n+            SpatialService spatialService = registry.getService(SpatialService.class);\n+\n+            assertNotNull(spatialService);\n+            assertTrue(spatialService.isEnabled());\n+        } finally {\n+            StandardServiceRegistryBuilder.destroy(registry);\n+        }\n     }\n }\n\nBASE FILES\n/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\nplugins {\n    id \"org.graalvm.internal.tck\"\n}\n\nString libraryVersion = tck.testedLibraryVersion.get()\n\ndependencies {\n    testImplementation \"org.hibernate:hibernate-spatial:$libraryVersion\"\n    testImplementation 'org.assertj:assertj-core:3.22.0'\n}\n\ngraalvmNative {\n    agent {\n        defaultMode = \"conditional\"\n        modes {\n            conditional {\n                userCodeFilterPath = \"user-code-filter.json\"\n            }\n        }\n    }\n}\n/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_hibernate.hibernate_spatial;\n\nimport org.hibernate.boot.registry.StandardServiceRegistryBuilder;\nimport org.hibernate.spatial.integration.SpatialInitializer;\nimport org.junit.jupiter.api.Test;\n\nclass HibernateSpatialTest {\n\n    @Test\n    void test() throws Exception {\n        new SpatialInitializer().contribute(new StandardServiceRegistryBuilder());\n    }\n}\n"}], "isError": false, "timestamp": 1790515903801}}
