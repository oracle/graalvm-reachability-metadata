ogger\"\n                    ]\n                }\n            ]\n        },\n        {\n            \"condition\": {\n                \"typeReached\": \"org.hibernate.internal.CoreMessageLogger\"\n            },\n            \"type\": \"org.hibernate.internal.CoreMessageLogger_$logger_en\"\n        },\n        {\n            \"condition\": {\n                \"typeReached\": \"org.hibernate.internal.CoreMessageLogger\"\n            },\n            \"type\": \"org.hibernate.internal.CoreMessageLogger_$logger_en_US\"\n        },\n        {\n            \"condition\": {\n                \"typeReached\": \"org.hibernate.service.internal.ServiceLogger\"\n            },\n            \"type\": \"org.hibernate.service.internal.ServiceLogger_$logger\",\n            \"methods\": [\n                {\n                    \"name\": \"<init>\",\n                    \"parameterTypes\": [\n                        \"org.jboss.logging.Logger\"\n                    ]\n                }\n            ]\n        },\n        {\n            \"condition\": {\n                \"typeReached\": \"org.hibernate.service.internal.ServiceLogger\"\n            },\n            \"type\": \"org.hibernate.service.internal.ServiceLogger_$logger_en\"\n        },\n        {\n            \"condition\": {\n                \"typeReached\": \"org.hibernate.service.internal.ServiceLogger\"\n            },\n            \"type\": \"org.hibernate.service.internal.ServiceLogger_$logger_en_US\"\n        },\n        {\n            \"condition\": {\n                \"typeReached\": \"org.hibernate.spatial.integration.SpatialService\"\n            },\n            \"type\": \"org.hibernate.spatial.HSMessageLogger_$logger\",\n            \"methods\": [\n                {\n                    \"name\": \"<init>\",\n                    \"parameterTypes\": [\n                        \"org.jboss.logging.Logger\"\n                    ]\n                }\n            ]\n        },\n        {\n            \"condition\": {\n