.Test;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\npublic class HibernateSpatialTest {\n\n    @Test\n    void registersSpatialServiceDuringHibernateBootstrap() {\n        try (StandardServiceRegistry registry = new StandardServiceRegistryBuilder().build()) {\n            SpatialService spatialService = registry.requireService(SpatialService.class);\n\n            assertThat(spatialService.isEnabled()).isTrue();\n        }\n    }\n}\n"}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-sol", "usage": {"input": 1271, "output": 974, "cacheRead": 55552, "cacheWrite": 0, "reasoning": 720, "totalTokens": 57797, "cost": {"input": 0.005084, "output": 0.01948, "cacheRead": 0.022220800000000002, "cacheWrite": 0, "total": 0.0467848}}, "stopReason": "toolUse", "timestamp": 1790451120048, "responseId": "resp_0f27bba762ff1d7b016ab81db03e0487d28613eaa15ca3adf5", "rawStopReason": "completed"}}
