[tool-call] delta {"path":"tests/src/org.hibernate/hibernate-spatial/8.0.0.Beta1/src/test/java/org_hibernate/hibernate_spatial/HibernateSpatialTest.java","edits":[{"oldText":"import org.hibernate.spatial.JTSGeometryJavaType;\nimport org.junit.jupiter.api.Test;\nimport org.locationtech.jts.geom.Geometry;\nimport org.locationtech.jts.geom.Point;\n","newText":"import org.hibernate.boot.registry.StandardServiceRegistry;\nimport org.hibernate.boot.registry.StandardServiceRegistryBuilder;\nimport org.hibernate.spatial.integration.SpatialService;\nimport org.junit.jupiter.api.Test;\n"},{"oldText":"    void parsesGeometryThroughHibernateSpatialJavaType() {\n        Geometry geometry = JTSGeometryJavaType.GEOMETRY_INSTANCE.fromString(\"POINT (1 2)\");\n\n        assertThat(geometry).isInstanceOf(Point.class);\n        assertThat(geometry.getCoordinate().getX()).isEqualTo(1.0);\n        assertThat(geometry.getCoordinate().getY()).isEqualTo(2.0);\n    }\n","newText":"    void discoversAndEnablesSpatialIntegrationDuringRegistryBootstrap() {\n        StandardServiceRegistry registry = new StandardServiceRegistryBuilder().build();\n        try {\n            SpatialService spatialService = registry.requireService(SpatialService.class);\n\n            assertThat(spatialService.isEnabled()).isTrue();\n        } finally {\n            registry.close();\n        }\n    }\n"}]}
