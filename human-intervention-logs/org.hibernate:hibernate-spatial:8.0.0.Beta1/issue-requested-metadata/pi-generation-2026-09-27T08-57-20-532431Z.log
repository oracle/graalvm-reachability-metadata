  package org_hibernate.hibernate_spatial;
  
  import org.hibernate.spatial.JTSGeometryJavaType;
  import org.junit.jupiter.api.Test;
  import org.locationtech.jts.geom.Geometry;
  
  import static org.assertj.core.api.Assertions.assertThat;
  
  public class HibernateSpatialTest {
  
      @Test
      void parsesJtsGeometry() {
          Geometry geometry = JTSGeometryJavaType.POINT_INSTANCE.fromString("POINT (1 2)");
  
          assertThat(geometry.getGeometryType()).isEqualTo("Point");
          assertThat(geometry.getCoordinate().getX()).isEqualTo(1.0);
          assertThat(geometry.getCoordinate().getY()).isEqualTo(2.0);
      }
  }
