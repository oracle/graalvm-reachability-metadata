[tool-call] delta {"path":"tests/src/org.hibernate/hibernate-spatial/8.0.0.Beta1/src/test/java/org_hibernate/hibernate_spatial/HibernateSpatialTest.java","content":"/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_hibernate.hibernate_spatial;\n\nimport org.hibernate.spatial.JTSGeometryJavaType;\nimport org.junit.jupiter.api.Test;\nimport org.locationtech.jts.geom.Geometry;\nimport org.locationtech.jts.geom.Point;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\npublic class HibernateSpatialTest {\n\n    @Test\n    void parsesGeometryThroughHibernateSpatialJavaType() {\n        Geometry geometry = JTSGeometryJavaType.GEOMETRY_INSTANCE.fromString(\"POINT (1 2)\");\n\n        assertThat(geometry).isInstanceOf(Point.class);\n        assertThat(geometry.getCoordinate().getX()).isEqualTo(1.0);\n        assertThat(geometry.getCoordinate().getY()).isEqualTo(2.0);\n    }\n}\n"}
