ation.toString();\n\n        assertThat(description)\n                .contains(ImportedAnnotation.class.getName())\n                .contains(\"name=\\\"fixture module\\\"\")\n                .contains(String.class.getName())\n                .contains(\"first\")\n                .contains(\"second\");\n    }\n}\n\n\n--- AnnotationProxyTest\n/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage com_tngtech_archunit.archunit;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport com.tngtech.archunit.core.domain.JavaClass;\nimport com.tngtech.archunit.core.importer.ClassFileImporter;\nimport org.junit.jupiter.api.Test;\n\npublic class AnnotationProxyTest {\n    @Test\n    void convertsImportedAnnotationValuesToRuntimeTypes() {\n        JavaClass importedClass = new ClassFileImporter().importClass(AnnotatedFixture.class);\n\n        ImportedAnnotation annotation = importedClass.getAnnotationOfType(ImportedAnnotation.class);\n\n        assertThat(annotation.name()).isEqualTo(\"fixture module\");\n        assertThat(annotation.types()).containsExactly(String.class, Integer.class);\n        assertThat(annotation.nested())\n                .extracting(NestedAnnotation::value)\n                .containsExactly(\"first\", \"second\");\n        assertThat(annotation.annotationType()).isEqualTo(ImportedAnnotation.class);\n    }\n}\n\n\n--- ArchModulesTest\n/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage com_tngtech_archunit.archunit;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport com_tngtech_archunit.archunit.moduleone.ModuleOneRoot;\nimport com_tngtech_archunit.archunit.moduletwo.ModuleTwoRoot;\nimport com.tngtech.archunit.core.domain.JavaClasses;\nimport com.tngtech.archunit.core.importer.ClassFileImporter;\nimport com.tngtech.archunit.library.modules.ArchModules;\nimport org.junit.jupiter.api.Test;\n\npublic class ArchModulesTest {\n    @Test\n    void definesNamedModulesFromRuntimeAnnotations() {\n        JavaClasses importedClasses =\n                new ClassFileImporter().importClasses(ModuleOneRoot.class, ModuleTwoRoot.class);\n\n        ArchModules<?> modules =\n                ArchModules.defineByAnnotation(ImportedAnnotation.class).modularize(importedClasses);\n\n        assertThat(modules.getNames()).containsExactlyInAnyOrder(\"one\", \"two\");\n        assertThat(modules.getByName(\"one\"))\n                .extracting(javaClass -> javaClass.getName())\n                .containsExactly(ModuleOneRoot.class.getName());\n        assertThat(modules.getByName(\"two\"))\n                .extracting(javaClass -> javaClass.getName())\n                .containsExactly(ModuleTwoRoot.class.getName());\n    }\n}\n\n\n--- ClassResolverInnerFactoryAnonymous1Test\n/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage com_tngtech_archunit.archunit;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport com.tngtech.archunit.ArchConfiguration;\nimport com.tngtech.archunit.core.domain.JavaClass;\nimport com.tngtech.archunit.core.importer.ClassFileImporter;\nimport com.tngtech.archunit.core.importer.resolvers.ClassResolver;\nimport java.util.List;\nimport java.util.Optional;\nimport java.util.concurrent.atomic.AtomicReference;\nimport org.junit.jupiter.api.Test;\n\npublic class ClassResolverInnerFactoryAnonymous1Test {\n    private static final AtomicReference<List<String>> RECEIVED_ARGUMENTS = new AtomicReference<>();\n\n    @Test\n    void importerInstantiatesConfiguredResolverThroughListConstructor() {\n        ArchConfiguration.withThreadLocalScope(configuration -> {\n            configuration.setClassResolver(ListConstructorResolver.class);\n            configuration.setClassResolverArguments(\"first\", \"second\");\n\n            JavaClass imported = new ClassFileImporter().importClass(AnnotatedFixture.class);\n\n            assertThat(imported.getName()).isEqualTo(AnnotatedFixture.class.getName());\n            assertThat(RECEIVED_ARGUMENTS.get()).containsExactly(\"first\", \"second\");\n        });\n    }\n\n    public static final class ListConstructorResolver implements ClassResolver {\n        public ListConstructorResolver(List<String> arguments) {\n            RECEIVED_ARGUMENTS.set(List.copyOf(arguments));\n        }\n\n        @Override\n        public void setClassUriImporter(ClassUriImporter classUriImporter) {}\n\n        @Override\n        public Optional<JavaClass> tryResolve(String typeName) {\n            return Optional.empty();\n        }\n    }\n}\n\n\n--- EvaluationResultTest\n/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage com_tngtech_archunit.archunit;\n\nimport static com.tngtech.archunit.lang.syntax.ArchRuleDefinition.classes;\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport com.tngtech.archunit.core.domain.JavaClasses;\nimport com.tngtech.archunit.core.importer.ClassFileImporter;\nimport com.tngtech.archunit.lang.EvaluationResult;\nimport org.junit.jupiter.api.Test;\n\npublic class EvaluationResultTest {\n    @Test\n    void evaluationLoadsIgnorePatternsBeforeReportingViolations() {\n        JavaClasses importedClasses =\n                new ClassFileImporter().importClasses(AnnotatedFixture.class);\n\n        EvaluationResult result = classes()\n                .should()\n                .haveSimpleName(\"DifferentName\")\n                .evaluate(importedClasses);\n\n        assertThat(result.hasViolation()).isTrue();\n        assertThat(result.getFailureReport().getDetails())\n                .anySatisfy(detail -> assertThat(detail).contains(\"AnnotatedFixture\"));\n    }\n}\n\n\n--- FailureDisplayFormatFactoryTest\n/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage com_tngtech_archunit.archunit;\n\nimport static com.tngtech.archunit.lang.syntax.ArchRuleDefinition.classes;\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport com.tngtech.archunit.ArchConfiguration;\nimport com.tngtech.archunit.base.HasDescription;\nimport com.tngtech.archunit.core.domain.JavaClasses;\nimport com.tngtech.archunit.core.importer.ClassFileImporter;\nimport com.tngtech.archunit.lang.FailureDisplayFormat;\nimport com.tngtech.archunit.lang.FailureMessages;\nimport com.tngtech.archunit.lang.Priority;\nimport org.junit.jupiter.api.Test;\n\npublic class FailureDisplayFormatFactoryTest {\n    @Test\n    void failureReportUsesConfiguredDisplayFormat() {\n        ArchConfiguration.withThreadLocalScope(configuration -> {\n            configuration.setProperty(\"failureDisplayFormat\", CompactFailureFormat.class.getName());\n            JavaClasses classesToCheck =\n                    new ClassFileImporter().importClasses(AnnotatedFixture.class);\n\n            String report = classes()\n                    .should()\n                    .haveSimpleName(\"DifferentName\")\n                    .evaluate(classesToCheck)\n                    .getFailureReport()\n                    .toString();\n\n            assertThat(report).isEqualTo(\"formatted:1\");\n        });\n    }\n\n    public static final class CompactFailureFormat implements FailureDisplayFormat {\n        public CompactFailureFormat() {}\n\n        @Override\n        public String formatFailure(