chunit.lang.FailureDisplayFormat;\nimport com.tngtech.archunit.lang.FailureMessages;\nimport com.tngtech.archunit.lang.Priority;\nimport org.junit.jupiter.api.Test;\n\npublic class FailureDisplayFormatFactoryTest {\n    @Test\n    void failureReportUsesConfiguredDisplayFormat() {\n        ArchConfiguration.withThreadLocalScope(configuration -> {\n            configuration.setProperty(\"failureDisplayFormat\", CompactFailureFormat.class.getName());\n            JavaClasses classesToCheck =\n                    new ClassFileImporter().importClasses(AnnotatedFixture.class);\n\n            String report = classes()\n                    .should()\n                    .haveSimpleName(\"DifferentName\")\n                    .evaluate(classesToCheck)\n                    .getFailureReport()\n                    .toString();\n\n            assertThat(report).isEqualTo(\"formatted:1\");\n        });\n    }\n\n    public static final class CompactFailureFormat implements FailureDisplayFormat {\n        public CompactFailureFormat() {}\n\n        @Override\n        public String formatFailure(\n                HasDescription rule, FailureMessages failureMessages, Priority priority) {\n            return \"formatted:\" + failureMessages.size();\n        }\n    }\n}\n\n\n--- JavaClassDescriptorInnerFromInnerAbstractClassDescriptorTest\n/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage com_tngtech_archunit.archunit;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport com.tngtech.archunit.core.domain.JavaClass;\nimport com.tngtech.archunit.core.importer.ClassFileImporter;\nimport org.junit.jupiter.api.Test;\n\npublic class JavaClassDescriptorInnerFromInnerAbstractClassDescriptorTest {\n    @Test\n    void reflectsAnImportedClassThroughItsDomainDescriptor() {\n        JavaClass importedClass = new ClassFileImporter().importClass(AnnotatedFixture.class);\n\n        Class<?> reflectedClass = importedClass.reflect();\n\n        assertThat(reflectedClass).isSameAs(AnnotatedFixture.class);\n        assertThat(reflectedClass.getName()).isEqualTo(AnnotatedFixture.class.getName());\n    }\n}\n\n\n--- JavaClassProcessorInnerAnnotationArrayProcessorInnerArrayValueBuilderTest\n/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage com_tngtech_archunit.archunit;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport com.tngtech.archunit.core.domain.JavaAnnotation;\nimport com.tngtech.archunit.core.domain.JavaClass;\nimport com.tngtech.archunit.core.importer.ClassFileImporter;\nimport org.junit.jupiter.api.Test;\n\npublic class JavaClassProcessorInnerAnnotationArrayProcessorInnerArrayValueBuilderTest {\n    @Test\n    void importsAnnotationArraysWithTheirCompleteElementTypes() {\n        JavaClass importedClass = new ClassFileImporter().importClass(AnnotatedFixture.class);\n        JavaAnnotation<?> annotation =\n                importedClass.getAnnotationOfType(ImportedAnnotation.class.getName());\n\n        assertThat(annotation.get(\"types\").orElseThrow()).isInstanceOf(Object[].class);\n        assertThat((Object[]) annotation.get(\"types\").orElseThrow()).hasSize(2);\n        assertThat(annotation.get(\"nested\").orElseThrow()).isInstanceOf(Object[].class);\n        assertThat((Object[]) annotation.get(\"nested\").orElseThrow()).hasSize(2);\n    }\n}\n\n\n--- JavaConstructorInnerReflectConstructorSupplierTest\n/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage com_tngtech_archunit.archunit;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport com.tngtech.archunit.core.domain.JavaClass;\nimport com.tngtech.archunit.core.importer.ClassFileImporter;\nimport java.lang.reflect.Constructor;\nimport org.junit.jupiter.api.Test;\n\npublic class JavaConstructorInnerReflectConstructorSupplierTest {\n    @Test\n    void reflectsAnImportedConstructorFromItsDomainModel() {\n        JavaClass importedClass = new ClassFileImporter().importClass(AnnotatedFixture.class);\n\n        Constructor<?> constructor = importedClass.getConstructor().reflect();\n\n        assertThat(constructor.getDeclaringClass()).isEqualTo(AnnotatedFixture.class);\n        assertThat(constructor.getParameterCount()).isZero();\n    }\n}\n\n\n--- JavaFieldInnerReflectFieldSupplierTest\n/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage com_tngtech_archunit.archunit;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport com.tngtech.archunit.core.domain.JavaClass;\nimport com.tngtech.archunit.core.importer.ClassFileImporter;\nimport java.lang.reflect.Field;\nimport org.junit.jupiter.api.Test;\n\npublic class JavaFieldInnerReflectFieldSupplierTest {\n    @Test\n    void reflectsAnImportedFieldFromItsDomainModel() {\n        JavaClass importedClass = new ClassFileImporter().importClass(AnnotatedFixture.class);\n\n        Field field = importedClass.getField(\"value\").reflect();\n\n        assertThat(field.getDeclaringClass()).isEqualTo(AnnotatedFixture.class);\n        assertThat(field.getName()).isEqualTo(\"value\");\n        assertThat(field.getType()).isEqualTo(String.class);\n    }\n}\n\n\n--- JavaMethodInnerReflectMethodSupplierTest\n/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */