  import org.apache.avro.io.EncoderFactory;
  import org.apache.avro.reflect.ReflectionUtil;
  import org.apache.avro.specific.SpecificData;
  import org.junit.jupiter.api.Test;
  
  import static org.assertj.core.api.Assertions.assertThat;
  
  public class ReflectionUtilTest {
      @Test
      void decodesMapKeysThroughConfiguredStringConstructor() throws IOException {
          Schema mapSchema = Schema.createMap(Schema.create(Schema.Type.INT));
          mapSchema.addProp(SpecificData.KEY_CLASS_PROP, String.class.getName());
          SpecificData specificData = new SpecificData();
          DatumReader<Map<String, Integer>> reader = specificData.getFastReaderBuilder().createDatumReader(mapSchema);
  
          Map<String, Integer> decoded = reader.read(null,
                  DecoderFactory.get().binaryDecoder(encodeMap("constructed-key", 17), null));
  
          assertThat(decoded).containsEntry("constructed-key", 17);
          assertThat(decoded.keySet().iterator().next()).isInstanceOf(String.class);
      }
  
      private static byte[] encodeMap(String key, int value) throws IOException {
          ByteArrayOutputStream output = new ByteArrayOutputStream();
          Encoder encoder = EncoderFactory.get().binaryEncoder(output, null);
          encoder.writeMapStart();
          encoder.setItemCount(1);
