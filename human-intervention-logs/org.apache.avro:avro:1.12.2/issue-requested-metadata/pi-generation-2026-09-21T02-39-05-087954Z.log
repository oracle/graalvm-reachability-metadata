87d296a51bd75afadb47", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_avro.avro;\n\nimport java.io.ByteArrayOutputStream;\nimport java.io.IOException;\nimport java.util.Map;\nimport java.util.function.Function;\n\nimport org.apache.avro.Schema;\nimport org.apache.avro.io.DatumReader;\nimport org.apache.avro.io.DecoderFactory;\nimport org.apache.avro.io.Encoder;\nimport org.apache.avro.io.EncoderFactory;\nimport org.apache.avro.reflect.ReflectionUtil;\nimport org.apache.avro.specific.SpecificData;\nimport org.junit.jupiter.api.Test;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\npublic class ReflectionUtilTest {\n    @Test\n    void decodesMapKeysThroughConfiguredStringConstructor() throws IOException {\n        Schema mapSchema = Schema.createMap(Schema.create(Schema.Type.INT));\n        mapSchema.addProp(SpecificData.KEY_CLASS_PROP, String.class.getName());\n        SpecificData specificData = new SpecificData();\n        DatumReader<Map<String, Integer>> reader = specificData.getFastReaderBuilder().createDatumReader(mapSchema);\n\n        Map<String, Integer> decoded = reader.read(null,\n                DecoderFactory.get().binaryDecoder(encodeMap(\"constructed-key\", 17), null));\n\n        assertThat(decoded).containsEntry(\"constructed-key\", 17);\n        assertThat(decoded.keySet().iterator().next()).isInstanceOf(String.class);\n    }\n\n    private static byte[] encodeMap(String key, int value) throws IOException {\n        ByteArrayOutputStream output = new ByteArrayOutputStream();\n        Encoder encoder = EncoderFactory.get().binaryEncoder(output, null);\n        encoder.writeMapStart();\n        encoder.setItemCount(1);\n        encoder.startItem();\n        encoder.writeString(key);\n        encoder.writeInt(value);\n        encoder.writeMapEnd();\n        encoder.flush();\n        return output.toByteArray();\n    }\n\n    @Test\n    void returnsNullWhenOneArgumentConstructorIsNotAccessible() {\n        Function<String, PrivateStringConstructor> constructor = ReflectionUtil.getConstructorAsFunction(String.class,\n                PrivateStringConstructor.class);\n\n        assertThat(constructor).isNull();\n    }\n\n    public static class PrivateStringConstructor {\n        private PrivateStringConstructor(String value) {\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1789958367254}, {"role": "toolResult", "toolCallId": "call_KuJ2oruSHCyJeYmeUU3ikRcB|fc_005f4d61f783f2e5016ab098df213487d29dae2f53a63ff445", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_avro.avro;\n\nimport java.io.ByteArrayOutputStream;\nimport java.io.IOException;\n\nimport org.apache.avro.Schema;\nimport org.apache.avro.generic.GenericData;\nimport org.apache.avro.generic.GenericDatumReader;\nimport org.apache.avro.io.Decoder;\nimport org.apache.avro.io.DecoderFactory;\nimport org.apache.avro.io.Encoder;\nimport org.apache.avro.io.EncoderFactory;\nimport org.junit.jupiter.api.Test;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\npublic class GenericDatumReaderInnerReaderCacheTest {\n    @Test\n    void createsCustomStringRepresentationThroughCachedStringConstructor() throws IOException {\n        Schema schema = Schema.create(Schema.Type.STRING);\n        GenericData data = new GenericData().setFastReaderEnabled(false);\n        GenericDatumReader<Object> reader = new StringTokenDatumReader(schema, data);\n        byte[] encoded = encodeStrings(\"first\", \"second\");\n        Decoder decoder = DecoderFactory.get().binaryDecoder(enc