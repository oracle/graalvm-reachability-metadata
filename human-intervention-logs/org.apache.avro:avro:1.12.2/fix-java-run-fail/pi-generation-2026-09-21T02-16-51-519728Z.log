/avro/1.12.2/.gradle/file-system.probe\ntests/src/org.apache.avro/avro/1.12.2/.gradle/noVersion/buildLogic.lock\ntests/src/org.apache.avro/avro/1.12.2/gradle.properties\ntests/src/org.apache.avro/avro/1.12.2/.gradle/vcs-1/gc.properties\ntests/src/org.apache.avro/avro/1.12.2/settings.gradle\ntests/src/org.apache.avro/avro/1.12.2/test-results-native/test/TEST-junit-jupiter.xml\ntests/src/org.apache.avro/avro/1.12.2/test-results-native/test/TEST-junit-vintage.xml\ntests/src/org.apache.avro/avro/1.12.2/user-code-filter.json\n\nSource target:\n     1\t/*\n     2\t * Licensed to the Apache Software Foundation (ASF) under one\n     3\t * or more contributor license agreements.  See the NOTICE file\n     4\t * distributed with this work for additional information\n     5\t * regarding copyright ownership.  The ASF licenses this file\n     6\t * to you under the Apache License, Version 2.0 (the\n     7\t * \"License\"); you may not use this file except in compliance\n     8\t * with the License.  You may obtain a copy of the License at\n     9\t *\n    10\t *     https://www.apache.org/licenses/LICENSE-2.0\n    11\t *\n    12\t * Unless required by applicable law or agreed to in writing, software\n    13\t * distributed under the License is distributed on an \"AS IS\" BASIS,\n    14\t * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n    15\t * See the License for the specific language governing permissions and\n    16\t * limitations under the License.\n    17\t */\n    18\tpackage org.apache.avro.reflect;\n    19\t\n    20\timport org.apache.avro.AvroRuntimeException;\n    21\t\n    22\timport java.lang.invoke.CallSite;\n    23\timport java.lang.invoke.LambdaMetafactory;\n    24\timport java.lang.invoke.MethodHandle;\n    25\timport java.lang.invoke.MethodHandles;\n    26\timport java.lang.invoke.MethodType;\n    27\timport java.lang.reflect.Field;\n    28\timport java.lang.reflect.ParameterizedType;\n    29\timport java.lang.reflect.Type;\n    30\timport java.lang.reflect.TypeVariable;\n    31\timport java.util.IdentityHashMap;\n    32\timport java.util.Map;\n    33\timport java.util.function.Function;\n    34\timport java.util.function.Supplier;\n    35\t\n    36\t/**\n    37\t * A few utility methods for using @link{java.misc.Unsafe}, mostly for private\n    38\t * use.\n    39\t *\n    40\t * Use of Unsafe on Android is forbidden, as Android provides only a very\n    41\t * limited functionality for this class compared to the JDK version.\n    42\t *\n    43\t * InterfaceAudience.Private\n    44\t */\n    45\tpublic class ReflectionUtil {\n    46\t\n    47\t  private ReflectionUtil() {\n    48\t  }\n    49\t\n    50\t  private static FieldAccess fieldAccess;\n    51\t  static {\n    52\t    resetFieldAccess();\n    53\t  }\n    54\t\n    55\t  static void resetFieldAccess() {\n    56\t    // load only one implementation of FieldAccess\n    57\t    // so it is monomorphic and the JIT can inline\n    58\t    FieldAccess access = null;\n    59\t    try {\n    60\t      FieldAccess reflectAccess = new FieldAccessReflect();\n    61\t      if (validate(reflectAccess)) {\n    62\t        fieldAccess = reflectAccess;\n    63\t      }\n    64\t    } catch (Throwable oops) {\n    65\t      throw new AvroRuntimeException(\"Unable to load a functional FieldAccess class!\");\n    66\t    }\n    67\t  }\n    68\t\n    69\t  private static <T> T load(String name, Class<T> type) throws Exception {\n    70\t    return ReflectionUtil.class.getClassLoader().loadClass(name).asSubclass(type).getDeclaredConstructor()\n    71\t        .newInstance();\n    72\t  }\n    73\t\n    74\t  public static FieldAccess getFieldAccess() {\n    75\t    return fieldAccess;\n    76\t  }\n    77\t\n    78\t  private static boolean validate(FieldAccess access) throws Exception {\n    79\t    return new AccessorTestClass().validate(access);\n    80\t  }\n    81\t\n    82\t  private static final class AccessorTestClass {\n    83\t    private boolean b = true;\n    84\t    protected byte by = 0xf;\n    85\t    public char c = 'c';\n    86\t    short s = 123;\n    87\t    int i = 999;\n    88\t    long l = 12345L;\n    89\t    float f = 2.2f;\n    90\t    double d = 4.4d;\n    91\t    Object o = \"foo\";\n    92\t    Integer i2 = 555;\n    93\t\n    94\t    private boolean validate(FieldAccess access) throws Exception {\n    95\t      boolean valid = true;\n    96\t      valid &= validField(access, \"b\", b, false);\n    97\t      valid &= validField(access, \"by\", by, (byte) 0xaf);\n    98\t      valid &= validField(access, \"c\", c, 'C');\n    99\t      valid &= validField(access, \"s\", s, (short) 321);\n   100\t      valid &= validField(access, \"i\", i, 111);\n   101\t      valid &= validField(access, \"l\", l, 54321L);\n   102\t      valid &= validField(access, \"f\", f, 0.2f);\n   103\t      valid &= validField(access, \"d\", d, 0.4d);\n   104\t      valid &= validField(access, \"o\", o, new Object());\n   105\t      valid &= validField(access, \"i2\", i2, -555);\n   106\t      return valid;\n   107\t    }\n   108\t\n   109\t    private boolean validField(FieldAccess access, String name, Object original, Object toSet) throws Exception {\n   110\t      FieldAccessor a = accessor(access, name);\n   111\t      boolean valid = original.equals(a.get(this));\n   112\t      a.set(this, toSet);\n   113\t      valid &= !original.equals(a.get(this));\n   114\t      return valid;\n   115\t    }\n   116\t\n   117\t    private FieldAccessor accessor(FieldAccess access, String name) throws Exception {\n   118\t      return access.getAccessor(this.getClass().getDeclaredField(name));\n   119\t    }\n   120\t  }\n   121\t\n   122\t  /**\n   123\t   * For an interface, get a map of any {@link TypeVariable}s to their actual\n   124\t   * types.\n   125\t   *\n   126\t   * @param iface interface to resolve types for.\n   127\t   * @return a map of {@link TypeVariable}s to actual types.\n   128\t   */\n   129\t  protected static Map<TypeVariable<?>, Type> resolveTypeVariables(Class<?> iface) {\n   130\t    return resolveTypeVariables(iface, new IdentityHashMap<>());\n   131\t  }\n   132\t\n   133\t  private static Map<TypeVariable<?>, Type> resolveTypeVariables(Class<?> iface, Map<TypeVariable<?>, Type> reuse) {\n   134\t\n   135\t    for (Type type : iface.getGenericInterfaces()) {\n   136\t      if (type instanceof ParameterizedType) {\n   137\t        ParameterizedType parameterizedType = (ParameterizedType) type;\n   138\t        Type rawType = parameterizedType.getRawType();\n   139\t        if (rawType instanceof Class<?>) {\n   140\t          Class<?> classType = (Class<?>) rawType;\n   141\t          TypeVariable<? extends Class<?>>[] typeParameters = classType.getTypeParameters();\n   142\t          Type[] actualTypeArguments = parameterizedType.getActualTypeArguments();\n   143\t          for (int i = 0; i < typeParameters.length; i++) {\n   144\t            reuse.putIfAbsent(typeParameters[i], reuse.getOrDefault(actualTypeArguments[i], actualTypeArguments[i]));\n   145\t          }\n   146\t          resolveTypeVariables(classType, reuse);\n   147\t        }\n   148\t      }\n   149\t    }\n   150\t    return reuse;\n   151\t  }\n   152\t\n   153\t  private static <D> Supplier<D> getConstructorAsSupplier(Class<D> clazz) {\n   154\t    try {\n   155\t      MethodHandles.Lookup lookup = MethodHandles.lookup();\n   156\t      MethodHandle constructorHandle = lookup.findConstructor(clazz, MethodType.methodType(void.class));\n   157\t\n   158\t      CallSite site = LambdaMetafactory.metafactory(lookup, \"get\", MethodType.methodType(Supplier.class),\n   159\t          constructorHandle.type().generic(), constructorHandle, constructorHandle.type());\n   160\t\n   161\t      return (Supplier<D>) site.getTarget().invokeExact();\n   162\t    } catch (Throwable t) {\n   163\t      // if anything goes wrong, don't provide a Supplier\n   164\t      return null;\n   165\t    }\n   166\t  }\n   167\t\n   168\t  private static <V, R> Supplier<R> getOneArgConstructorAsSupplier(Class<R> clazz, Class<V> argumentClass, V argument) {\n   169\t    Function<V, R> supplierFunction = getConstructorAsFunction(argumentClass, clazz);\n   170\t    if (supplierFunction != null) {\n   171\t      return () -> supplierFunction.apply(argument);\n   172\t    } else {\n   173\t      return null;\n   174\t    }\n   175\t  }\n   176\t\n   177\t  public static <V, R> Function<V, R> getConstructorAsFunction(Class<V> parameterClass, Class<R> clazz) {\n   178\t    try {\n   179\t      MethodHandles.Lookup lookup = MethodHandles.lookup();\n   180\t      MethodHandle constructorHandle = lookup.findConstructor(clazz, MethodType.methodType(void.class, parameterClass));\n   181\t\n   182\t      CallSite site = LambdaMetafactory.metafactory(lookup, \"apply\", MethodType.methodType(Function.class),\n   183\t          constructorHandle.type().generic(), constructorHandle, constructorHandle.type());\n   184\t\n   185\t      return (Function<V, R>) site.getTarget().invokeExact();\n   186\t    } catch (Throwable t) {\n   187\t      // if something goes wrong, do not provide a Function instance\n   188\t      return null;\n   189\t    }\n   190\t  }\n   191\t\n   192\t  protected static AvroEncode getAvroEncode(Field field) {\n   193\t    var enc = field.getAnnotation(AvroEncode.class);\n   194\t    if (enc != null) {\n   195\t      return enc;\n   196\t    } else {\n   197\t      return getAvroEncode(field.getType());\n   198\t    }\n   199\t  }\n   200\t\n   201\t  protected static AvroEncode getAvroEncode(Class<?> clazz) {\n   202\t    if (clazz == null) {\n   203\t      return null;\n   204\t    }\n   205\t    return clazz.getAnnotation(AvroEncode.class);\n   206\t  }\n   207\t}\n"}], "isError": false, "timestamp": 1789957400017}}
