     103	      valid &= validField(access, "d", d, 0.4d);
     104	      valid &= validField(access, "o", o, new Object());
     105	      valid &= validField(access, "i2", i2, -555);
     106	      return valid;
     107	    }
     108	
     109	    private boolean validField(FieldAccess access, String name, Object original, Object toSet) throws Exception {
     110	      FieldAccessor a = accessor(access, name);
     111	      boolean valid = original.equals(a.get(this));
     112	      a.set(this, toSet);
     113	      valid &= !original.equals(a.get(this));
     114	      return valid;
     115	    }
     116	
     117	    private FieldAccessor accessor(FieldAccess access, String name) throws Exception {
     118	      return access.getAccessor(this.getClass().getDeclaredField(name));
     119	    }
     120	  }
     121	
     122	  /**
     123	   * For an interface, get a map of any {@link TypeVariable}s to their actual
     124	   * types.
     125	   *
     126	   * @param iface interface to resolve types for.
     127	   * @return a map of {@link TypeVariable}s to actual types.
     128	   */
     129	  protected static Map<TypeVariable<?>, Type> resolveTypeVariables(Class<?> iface) {
     130	    return resolveTypeVariables(iface, new IdentityHashMap<>());
     131	  }
     132	
     133	  private static Map<TypeVariable<?>, Type> resolveTypeVariables(Class<?> iface, Map<TypeVariable<?>, Type> reuse) {
     134	
     135	    for (Type type : iface.getGenericInterfaces()) {
     136	      if (type instanceof ParameterizedType) {
     137	        ParameterizedType parameterizedType = (ParameterizedType) type;
     138	        Type rawType = parameterizedType.getRawType();
     139	        if (rawType instanceof Class<?>) {
     140	          Class<?> classType = (Class<?>) rawType;
     141	          TypeVariable<? extends Class<?>>[] typeParameters = classType.getTypeParameters();
     142	          Type[] actualTypeArguments = parameterizedType.getActualTypeArguments();
     143	          for (int i = 0; i < typeParameters.length; i++) {
     144	            reuse.putIfAbsent(typeParameters[i], reuse.getOrDefault(actualTypeArguments[i], actualTypeArguments[i]));
     145	          }
     146	          resolveTypeVariables(classType, reuse);
     147	        }
     148	      }
     149	    }
     150	    return reuse;
     151	  }
     152	
     153	  private static <D> Supplier<D> getConstructorAsSupplier(Class<D> clazz) {
     154	    try {
     155	      MethodHandles.Lookup lookup = MethodHandles.lookup();
     156	      MethodHandle constructorHandle = lookup.findConstructor(clazz, MethodType.methodType(void.class));
     157	
     158	      CallSite site = LambdaMetafactory.metafactory(lookup, "get", MethodType.methodType(Supplier.class),
     159	          constructorHandle.type().generic(), constructorHandle, constructorHandle.type());
     160	
     161	      return (Supplier<D>) site.getTarget().invokeExact();
     162	    } catch (Throwable t) {
     163	      // if anything goes wrong, don't provide a Supplier
     164	      return null;
     165	    }
     166	  }
     167	
     168	  private static <V, R> Supplier<R> getOneArgConstructorAsSupplier(Class<R> clazz, Class<V> argumentClass, V argument) {
     169	    Function<V, R> supplierFunction = getConstructorAsFunction(argumentClass, clazz);
     170	    if (supplierFunction != null) {
     171	      return () -> supplierFunction.apply(argument);
     172	    } else {
     173	      return null;
     174	    }
     175	  }
     176	
     177	  public static <V, R> Function<V, R> getConstructorAsFunction(Class<V> parameterClass, Class<R> clazz) {
     178	    try {
     179	      MethodHandles.Lookup lookup = MethodHandles.lookup();
     180	      MethodHandle constructorHandle = lookup.findConstructor(clazz, MethodType.methodType(void.class, parameterClass));
     181	
     182	      CallSite site = LambdaMetafactory.metafactory(lookup, "apply", MethodType.methodType(Function.class),
     183	          constructorHandle.type().generic(), constructorHandle, constructorHandle.type());
     184	
     185	      return (Function<V, R>) site.getTarget().invokeExact();
     186	    } catch (Throwable t) {
     187	      // if something goes wrong, do not provide a Function instance
     188	      return null;
     189	    }
     190	  }
     191	
     192	  protected static AvroEncode getAvroEncode(Field field) {
     193	    var enc = field.getAnnotation(AvroEncode.class);
     194	    if (enc != null) {
     195	      return enc;
     196	    } else {
     197	      return getAvroEncode(field.getType());
     198	    }
     199	  }
     200	
     201	  protected static AvroEncode getAvroEncode(Class<?> clazz) {
     202	    if (clazz == null) {
     203	      return null;
     204	    }
     205	    return clazz.getAnnotation(AvroEncode.class);
     206	  }
     207	}
[recv] {"type": "message_start", "message": {"role": "toolResult", "toolCallId": "call_qeJekZmoZRQCvuz1YnhMTJDX|fc_0f01c63e7b0d6882016ab09517dbcc87d2bdea1fb80d32bda2", "toolName": "read", "content": [{"type": "text", "text": "# GraalVM Reachability Metadata Repository <picture><img alt=\"\" src=\"docs/assets/readme/title-robot-facing-user.png\" height=\"58\" align=\"middle\"></picture>\n\n<p><a href=\"COVERAGE.md\"><picture><source media=\"(prefers-color-scheme: dark)\" srcset=\"https://img.shields.io/badge/dynamic/json.svg?label=supported%20libraries&query=%24.badges.librariesSupported&url=https%3A%2F%2Fraw.githubusercontent.com%2Foracle%2Fgraalvm-reachability-metadata%2Fstats%2Fcoverage%2Flatest%2Fbadges.json&style=flat&color=38BDF8&labelColor=1F2937\"><img alt=\"Supported libraries\" src=\"https://img.shields.io/badge/dynamic/json.svg?label=supported%20libraries&query=%24.badges.librariesSupported&url=https%3A%2F%2Fraw.githubusercontent.com%2Foracle%2Fgraalvm-reachability-metadata%2Fstats%2Fcoverage%2Flatest%2Fbadges.json&style=flat&color=0A7EC2&labelColor=E5E7EB\"></picture></a>&nbsp;&nbsp;<a href=\"COVERAGE.md\"><picture><source media=\"(prefers-color-scheme: dark)\" srcset=\"https://img.shields.io/badge/dynamic/json.svg?label=tested%20library%20versions&query=%24.badges.testedLibraryVersions&url=https%3A%2F%2Fraw.githubusercontent.com%2Foracle%2Fgraalvm-reachability-metadata%2Fstats%2Fcoverage%2Flatest%2Fbadges.json&style=flat&color=F59E0B&labelColor=1F2937\"><img alt=\"Tested library versions\" src=\"https://img.shields.io/badge/dynamic/json.svg?label=tested%20library%20versions&query=%24.badges.testedLibraryVersions&url=https%3A%2F%2Fraw.githubusercontent.com%2Foracle%2Fgraalvm-reachability-metadata%2Fstats%2Fcoverage%2Flatest%2Fbadges.json&style=flat&color=BF8700&labelColor=E5E7EB\"></picture></a>&nbsp;&nbsp;<a href=\"COVERAGE.md\"><picture><source media=\"(prefers-color-scheme: dark)\" srcset=\"https://img.shields.io/badge/dynamic/json.svg?label=dynamic%20access%20coverage&query=%24.badges.dynamicAccessCoverage&url=https%3A%2F%2Fraw.githubusercontent.com%2Foracle%2Fgraalvm-reachability-metadata%2Fstats%2Fcoverage%2Flatest%2Fbadges.json&style=flat&color=34D399&labelColor=1F2937\"><img alt=\"Dynamic access coverage\" src=\"https://img.shields.io/badge/dynamic/json.svg?label=dynamic%20access%20coverage&query=%24.badges.dynamicAccessCoverage&url=https%3A%2F%2Fraw.githubusercontent.com%2Foracle%2Fgraalvm-reachability-metadata%2Fstats%2Fcoverage%2Flatest%2Fbadges.json&style=flat&color=1F9D55&labelColor=E5E7EB\"></picture></a>&nbsp;&nbsp;<a href=\"COVERAGE.md\"><picture><source media=\"(prefers-color-scheme: dark)\" srcset=\"https://img.shields.io/badge/dynamic/json.svg?label=tested%20LoC&query=%24.badges.testedLinesOfCode&url=https%3A%2F%2Fraw.githubusercontent.com%2Foracle%2Fgraalvm-reachability-metadata%2Fstats%2Fcoverage%2Flatest%2Fbadges.json&style=flat&color=FB923C&labelColor=1F2937\"><img alt=\"Tested LoC\" src=\"https://img.shields.io/badge/dynamic/json.svg?label=tested%20LoC&query=%24.badges.testedLinesOfCode&url=https%3A%2F%2Fraw.githubusercontent.com%2Foracle%2Fgraalvm-reachability-metadata%2Fstats%2Fcoverage%2Flatest%2Fbadges.json&style=flat&color=C2410C&labelColor=E5E7EB\"></picture></a></p>\n\nThis repository contains [reachability metadata](https://www.graalvm.org/latest/reference-manual/native-image/metadata/) for JVM libraries and frameworks, enabling them to work out of the box with [GraalVM Native Image](https://www.graalvm.org/latest/reference-manual/native-image/).\n\nThe [GraalVM Gradle Plugin](https://graalvm.github.io/native-build-tools/latest/gradle-plugin.html) and [GraalVM Maven Plugin](https://graalvm.github.io/native-build-tools/latest/maven-plugin.html) automatically use the [reachability metadata](https://www.graalvm.org/latest/reference-manual/native-image/metadata/) from this repository, so most projects do not need to configure it directly.\n\n> [!TIP]\n> **Missing metadata for a library you depend on?** Run the [Native Build Tools](https://graalvm.github.io/native-build-tools/latest/) task in your project to detect the gap and automatically open an issue here.\n>\n> **Gradle**\n>\n> ```bash\n> ./gradlew listLibrariesMissingMetadata -PcreateIssues=true\n> ```\n>\n> **Maven**\n>\n> ```bash\n> ./mvnw native:list-libraries-missing-metadata -DcreateIssues=true\n> ```\n\n---\n\n### 🔎 Check if Your Library Is Supported\n\nTo quickly check whether reachability metadata exists for a specific library, run this command directly from your terminal:\n\n```bash\ncurl -sSL \\\n  https://raw.githubusercontent.com/oracle/graalvm-reachability-metadata/master/check-library-support.sh \\\n  | bash -s \"<groupId>:<artifactId>:<version>\"\n```\n\n### 🙋 Manually Request Library Support\n\n<p align=\"center\">\n  <a href=\"https://github.com/oracle/graalvm-reachability-metadata/issues/new?template=01_support_new_library.yml\"><picture><source media=\"(prefers-color-scheme: dark)\" srcset=\"docs/assets/readme/button-new-library-dark.png\"><img alt=\"Open a new library support issue\" src=\"docs/assets/readme/button-new-library-light.png\" width=\"400\"></picture></a>\n  <a href=\"https://github.com/oracle/graalvm-reachability-metadata/issues/new?template=02_update_existing_library.yml\"><picture><source media=\"(prefers-color-scheme: dark)\" srcset=\"docs/assets/readme/button-update-metadata-dark.png\"><img alt=\"Open an existing library update issue\" src=\"docs/assets/readme/button-update-metadata-light.png\" width=\"400\"></picture></a>\n</p>\n\n---\n\n### Contributing\n\nWe welcome contributions from the community. Thank you!\n\nBefore submitting a pull request, please [open a ticket](https://github.com/oracle/graalvm-reachability-metadata/issues/new?template=02_update_existing_library.yml) and [review our contribution guide](docs/CONTRIBUTING.md).\n\n> [!NOTE]\n> We always fix issues by changing the system, not the problem itself. Tests are updated only very rarely, and the metadata itself is never modified by hand.\n\n### Further Information\n\n1. Continuous integration is described in [ci.md](docs/architecture/ci.md).\n2. Pull request review guidelines are in [REVIEWING.md](docs/REVIEWING.md).\n3. Development workflow is described in [DEVELOPING.md](docs/DEVELOPING.md).\n\n---\nBuilt with ❤️ by the community and the [GraalVM](https://www.graalvm.org/), [Spring](https://spring.io/projects/spring-boot), and [Micronaut](https://micronaut.io/) teams.\n"}], "isError": false, "timestamp": 1789957400015}}
