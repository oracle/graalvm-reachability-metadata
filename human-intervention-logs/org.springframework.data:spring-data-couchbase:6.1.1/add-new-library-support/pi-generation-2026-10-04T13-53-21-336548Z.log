  				return (Mono<T>) replaceById(clazz).inScope(scope)
  						.inCollection(collection)
  						.one(entity);
  			} else { // there is a version property, but it's zero or not set.
  				// Creating new document
  				return (Mono<T>) insertById(clazz).inScope(scope)
  						.inCollection(collection)
