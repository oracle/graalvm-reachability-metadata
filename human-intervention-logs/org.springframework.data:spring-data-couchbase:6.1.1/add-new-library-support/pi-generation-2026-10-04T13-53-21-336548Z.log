mport java.util.List;\n\nimport org.junit.jupiter.api.Test;\n\nimport org.springframework.data.couchbase.core.convert.join.N1qlJoinResolver;\nimport org.springframework.data.couchbase.core.mapping.CouchbaseMappingContext;\nimport org.springframework.data.couchbase.core.mapping.CouchbasePersistentProperty;\nimport org.springframework.data.couchbase.core.mapping.Document;\nimport org.springframework.data.couchbase.core.query.FetchType;\nimport org.springframework.data.couchbase.core.query.N1qlJoin;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\npublic class N1qlJoinResolverInnerN1qlJoinProxyTest {\n\n    @Test\n    void identifiesLazyJoinProperties() {\n        CouchbaseMappingContext mappingContext = new CouchbaseMappingContext();\n        CouchbasePersistentProperty property = mappingContext.getPersistentEntity(JoinDocument.class)\n                .getRequiredPersistentProperty(\"joined\");\n\n        assertThat(N1qlJoinResolver.isLazyJoin(property.findAnnotation(N1qlJoin.class))).isTrue();\n    }\n\n    @Document\n    public static class JoinDocument {\n\n        @N1qlJoin(on = \"rks.documentId\", fetchType = FetchType.LAZY)\n        public List<JoinedDocument> joined;\n    }\n\n    @Document\n    public static class JoinedDocument {\n\n        public String documentId;\n    }\n}\n"}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-luna", "usage": {"input": 2711, "output": 1272, "cacheRead": 135680, "cacheWrite": 0, "reasoning": 836, "totalTokens": 139663, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1791122696068, "responseId": "resp_0088c86152f8f9e7016ac25d0898c087d18f7fdcfd89aeeef5", "rawStopReason": "completed"}, "toolResults": [{"role": "toolResult", "toolCallId": "call_dr84HTCdYjTisYpzeIvfNhoO|fc_0088c86152f8f9e7016ac25d1c089487d195241c1fb5e9e400", "toolName": "write", "content": [{"type": "text", "text": "Successfully wrote 1540 bytes t