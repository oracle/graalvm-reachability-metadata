fault\", elements))\n                .isEqualTo(\"sales\");\n        assertThat(OptionsBuilder.annotationString(Collection.class, \"value\", \"_default\", elements))\n                .isEqualTo(\"orders\");\n        assertThat(OptionsBuilder.annotationString(Scope.class, \"_default\", elements)).isEqualTo(\"sales\");\n    }\n\n    @Collection(\"orders\")\n    @Scope(\"sales\")\n    public static class AnnotatedDocument {\n    }\n}\n"}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-luna", "usage": {"input": 4740, "output": 2768, "cacheRead": 118272, "cacheWrite": 0, "reasoning": 2365, "totalTokens": 125780, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1791122468390, "responseId": "resp_0088c86152f8f9e7016ac25c24e95087d1af1e788a87a2d619", "rawStopReason": "completed"}, "toolResults": [{"role": "toolResult", "toolCallId": "call_MyB6VqAyIoqdYIMMRZotI8sF|fc_0088c86152f8f9e7016ac25c53565487d1a1c4be788da65b37", "toolName": "write", "content": [{"type": "text", "text": "Successfully wrote 1425 bytes to tests/src/org.springframework.data/spring-data-couchbase/6.1.1/src/test/java/org_springframework_data/spring_data_couchbase/OptionsBuilderTest.java"}], "isError": false, "timestamp": 1791122524019}]}
