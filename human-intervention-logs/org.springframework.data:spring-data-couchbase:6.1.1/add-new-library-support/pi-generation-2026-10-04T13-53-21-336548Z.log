  	@Override
  	public Class<?> getWriteClassFor(Class<?> clazz) {
  		return this.conversions.getCustomWriteTarget(clazz).orElse(clazz);
  	}
  
  	@Override
  	public CustomConversions getConversions() {
  		return conversions;
  	}
  }
  
