  	@SuppressWarnings("unchecked")
  	protected <R> R read(final TypeInformation<R> type, final CouchbaseDocument source, final Object parent) {
  		if (source == null) {
  			return null;
  		}
  
  		TypeInformation<? extends R> typeToUse = typeMapper.readType(source, type);
