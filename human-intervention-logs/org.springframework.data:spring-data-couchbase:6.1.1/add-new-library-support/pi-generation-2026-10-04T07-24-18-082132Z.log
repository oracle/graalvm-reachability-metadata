[tool-call] delta {"path":"tests/src/org.springframework.data/spring-data-couchbase/6.1.1/src/test/java/org_springframework_data/spring_data_couchbase/Spring_data_couchbaseTest.java","edits":[{"oldText":"import static org.assertj.core.api.Assertions.assertThat;\n","newText":"import static org.assertj.core.api.Assertions.assertThat;\nimport static org.assertj.core.api.Assertions.assertThatThrownBy;\n"},{"oldText":"import org.springframework.data.annotation.Id;\n","newText":"import org.springframework.data.annotation.Id;\nimport org.springframework.data.annotation.Version;\n"},{"oldText":"    @Test\n    void couchbaseTemplateConvertsAndQueriesDocuments() {\n","newText":"    @Test\n    void versionedRepositoryRejectsStaleDocumentUpdates() {\n        VersionedPersonRepository repository =\n                applicationContext.getBean(VersionedPersonRepository.class);\n        String id = \"optimistic-locking-ada\";\n        repository.save(new VersionedPerson(id, \"Ada\"));\n\n        VersionedPerson current = repository.findById(id).orElseThrow();\n        VersionedPerson stale = repository.findById(id).orElseThrow();\n        current.setName(\"updated Ada\");\n        VersionedPerson updated = repository.save(current);\n\n        assertThat(updated.getVersion()).isGreaterThan(stale.getVersion());\n        stale.setName(\"stale Ada\");\n        assertThatThrownBy(() -> repository.save(stale))\n                .isInstanceOf(org.springframework.dao.OptimisticLockingFailureException.class);\n        assertThat(repository.findById(id).orElseThrow().getName()).isEqualTo(\"updated Ada\");\n\n        repository.deleteById(id);\n    }\n\n    @Test\n    void couchbaseTemplateConvertsAndQueriesDocuments() {\n"},{"oldText":"    public interface PersonRepository extends CouchbaseRepository<Person, String> {\n        List<Person> findByCategory(String category);\n    }\n\n    @Document\n    public static class Person {\n","newText":"    public interface PersonRepository extends CouchbaseRepository<Person, String> {\n        List<Person> findByCategory(String category);\n    }\n\n    public interface VersionedPersonRepository extends CouchbaseRepository<VersionedPerson, String> {\n    }\n\n    @Document\n    public static class VersionedPerson {\n        @Id\n        private String id;\n        private String name;\n        @Version\n        private Long version;\n\n        public VersionedPerson() {\n        }\n\n        VersionedPerson(String id, String name) {\n            this.id = id;\n            this.name = name;\n        }\n\n        public String getName() {\n            return name;\n        }\n\n        public void setName(String name) {\n            this.name = name;\n        }\n\n        public Long getVersion() {\n            return version;\n        }\n    }\n\n    @Document\n    public static class Person {\n"}]}
[tool-call] end id=call_8Q3fp33cSoSdAgLj7F1l73qV|fc_0f3f891f04ddbb53016ac2030b0f0887d1baf3a82a4fe6be4f name=edit args={"path": "tests/src/org.springframework.data/spring-data-couchbase/6.1.1/src/test/java/org_springframework_data/spring_data_couchbase/Spring_data_couchbaseTest.java", "edits": [{"oldText": "import static org.assertj.core.api.Assertions.assertThat;\n", "newText": "import static org.assertj.core.api.Assertions.assertThat;\nimport static org.assertj.core.api.Assertions.assertThatThrownBy;\n"}, {"oldText": "import org.springframework.data.annotation.Id;\n", "newText": "import org.springframework.data.annotation.Id;\nimport org.springframework.data.annotation.Version;\n"}, {"oldText": "    @Test\n    void couchbaseTemplateConvertsAndQueriesDocuments() {\n", "newText": "    @Test\n    void versionedRepositoryRejectsStaleDocumentUpdates() {\n        VersionedPersonRepository repository =\n                applicationContext.getBean(VersionedPersonRepository.class);\n        String id = \"optimistic-locking-ada\";\n        repository.save(new VersionedPerson(id, \"Ada\"));\n\n        VersionedPerson current = repository.findById(id).orElseThrow();\n        VersionedPerson stale = repository.findById(id).orElseThrow();\n        current.setName(\"updated Ada\");\n        VersionedPerson updated = repository.save(current);\n\n        assertThat(updated.getVersion()).isGreaterThan(stale.getVersion());\n        stale.setName(\"stale Ada\");\n        assertThatThrownBy(() -> repository.save(stale))\n                .isInstanceOf(org.springframework.dao.OptimisticLockingFailureException.class);\n        assertThat(repository.findById(id).orElseThrow().getName()).isEqualTo(\"updated Ada\");\n\n        repository.deleteById(id);\n    }\n\n    @Test\n    void couchbaseTemplateConvertsAndQueriesDocuments() {\n"}, {"oldText": "    public interface PersonRepository extends CouchbaseRepository<Person, String> {\n        List<Person> findByCategory(String category);\n    }\n\n    @Document\n    public static class Person {\n", "newText": "    public interface PersonRepository extends CouchbaseRepository<Person, String> {\n        List<Person> findByCategory(String category);\n    }\n\n    public interface VersionedPersonRepository extends CouchbaseRepository<VersionedPerson, String> {\n    }\n\n    @Document\n    public static class VersionedPerson {\n        @Id\n        private String id;\n        private String name;\n        @Version\n        private Long version;\n\n        public VersionedPerson() {\n        }\n\n        VersionedPerson(String id, String name) {\n            this.id = id;\n            this.name = name;\n        }\n\n        public String getName() {\n            return name;\n        }\n\n        public void setName(String name) {\n            this.name = name;\n        }\n\n        public Long getVersion() {\n            return version;\n        }\n    }\n\n    @Document\n    public static class Person {\n"}]}
