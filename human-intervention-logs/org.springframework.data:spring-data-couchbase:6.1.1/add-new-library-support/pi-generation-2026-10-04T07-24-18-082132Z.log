\t *                           opened for the given transaction\n/tmp/spring-data-couchbase-6.1.1-src/org/springframework/data/couchbase/transaction/CouchbaseTransactionStatus.java:36:\t * @param readOnly           whether the transaction is marked as read-only\n/tmp/spring-data-couchbase-6.1.1-src/org/springframework/data/couchbase/transaction/CouchbaseTransactionStatus.java:37:\t * @param debug              should debug logging be enabled for the handling of this transaction?\n/tmp/spring-data-couchbase-6.1.1-src/org/springframework/data/couchbase/transaction/CouchbaseTransactionStatus.java-38-\t *                           Caching it in here can prevent repeated calls to ask the logging system whether\n/tmp/spring-data-couchbase-6.1.1-src/org/springframework/data/couchbase/transaction/CouchbaseTransactionStatus.java-39-\t *                           debug logging should be enabled.\n/tmp/spring-data-couchbase-6.1.1-src/org/springframework/data/couchbase/transaction/CouchbaseTransactionStatus.java-40-\t * @param suspendedResources a holder for resources that have been suspended\n/tmp/spring-data-couchbase-6.1.1-src/org/springframework/data/couchbase/transaction/CouchbaseTransactionStatus.java-41-\t */\n/tmp/spring-data-couchbase-6.1.1-src/org/springframework/data/couchbase/transaction/CouchbaseTransactionStatus.java:42:\tpublic CouchbaseTransactionStatus(Object transaction, boolean newTransaction, boolean newSynchronization, boolean readOnly, boolean debug, Object suspendedResources) {\n/tmp/spring-data-couchbase-6.1.1-src/org/springframework/data/couchbase/transaction/CouchbaseTransactionStatus.java-43-\t\tsuper(null,\n/tmp/spring-data-couchbase-6.1.1-src/org/springframework/data/couchbase/transaction/CouchbaseTransactionStatus.java:44:\t\t\t\ttransaction,\n/tmp/spring-data-couchbase-6.1.1-src/org/springframework/data/couchbase/transaction/CouchbaseTransactionStatus.java-45-\t\t\t\tnewTransaction,\n/tmp/spring-data-couchbase-6.1.1-src/org/springframework/data/couchbase/transaction/CouchbaseTransactionStatus.java-46-\t\t\t\tnewSynchronization,\n/tmp/spring-data-couchbase-6.1.1-src/org/springframework/data/couchbase/transaction/CouchbaseTransactionStatus.java-47-\t\t\t\tfalse,\n/tmp/spring-data-couchbase-6.1.1-src/org/springframework/data/couchbase/transaction/CouchbaseTransactionStatus.java-48-\t\t\t\treadOnly,\n/tmp/spring-data-couchbase-6.1.1-src/org/springframework/data/couchbase/transaction/CouchbaseTransactionStatus.java-49-\t\t\t\tdebug,\n/tmp/spring-data-couchbase-6.1.1-src/org/springframework/data/couchbase/transaction/CouchbaseTransactionStatus.java-50-\t\t\t\tsuspendedResources);\n/tmp/spring-data-couchbase-6.1.1-src/org/springframework/data/couchbase/transaction/CouchbaseTransactionStatus.java-51-\t}\n/tmp/spring-data-couchbase-6.1.1-src/org/springframework/data/couchbase/transaction/CouchbaseTransactionStatus.java-52-}\n--\n/tmp/spring-data-couchbase-6.1.1-src/org/springframework/data/couchbase/transaction/CouchbaseTransactionInterceptor.java-8- *      https://www.apache.org/licenses/LICENSE-2.0\n/tmp/spring-data-couchbase-6.1.1-src/org/springframework/data/couchbase/transaction/CouchbaseTransactionInterceptor.java-9- *\n/tmp/spring-data-couchbase-6.1.1-src/org/springframework/data/couchbase/transaction/CouchbaseTransactionInterceptor.java-10- * Unless required by applicable law or agreed to in writing, software\n/tmp/spring-data-couchbase-6.1.1-src/org/springframework/data/couchbase/transaction/CouchbaseTransactionInterceptor.java-11- * distributed under the License is distributed on an \"AS IS\" BASIS,\n/tmp/spring-data-couchbase-6.1.1-src/org/springframework/data/couchbase/transaction/CouchbaseTransactionInterceptor.java-12- * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n/tmp/spring-data-couchbase-6.1.1-src/org/springframework/data/couchbase/transaction/CouchbaseTransactionInterceptor.java-13- * See the License for the specific language governing permissions and\n/tmp/spring-data-c