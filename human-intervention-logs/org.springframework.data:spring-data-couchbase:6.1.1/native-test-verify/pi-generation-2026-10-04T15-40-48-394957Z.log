uchbaseDocument().put(\"types\", types));\n\n        assertThat(document.types).containsEntry(\"target\", String.class);\n    }\n\n    @Document\n    public static class ClassDocument {\n\n        public Map<String, Class<?>> types;\n    }\n}\n"}], "isError": false, "timestamp": 1791128497967}}
