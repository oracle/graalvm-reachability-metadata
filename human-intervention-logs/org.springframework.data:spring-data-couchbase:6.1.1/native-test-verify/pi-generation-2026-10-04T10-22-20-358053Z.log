[tool-call] delta {"command":"export GRAALVM_HOME=/home/mihailo/git/graal/sdk/latest_graalvm_home JAVA_HOME=/home/mihailo/git/graal/sdk/latest_graalvm_home\nfor f in tests/src/org.springframework.data/spring-data-couchbase/6.1.1/build/natively-collected/{_global_/agent,runs/cycle-{0,1,2,3,4,5}}/reachability-metadata.json; do\n  if rg -q 'docker-java\\.properties' \"$f\"; then echo \"--- $f\"; rg -n -B 4 -A 2 'docker-java\\.properties' \"$f\"; fi\ndone\nprintf '%s\\n' '--- source condition counts ---'\npython3 - <<'PY'\nimport json\nfrom collections import Counter\np='tests/src/org.springframework.data/spring-data-couchbase/6.1.1/src/test/resources/META-INF/native-image/reachability-metadata.json'\ndata=json.load(open(p))\nfor section, entries in data.items():\n    if isinstance(entries,list):\n        c=Counter((e.get('condition') or {}).get('typeReached') for e in entries)\n        print(section, len(entries), c.most_common(10))\nPY","timeout":30}
