s/src/org.springframework.data/spring-data-couchbase/6.1.1/src/test/resources/META-INF/native-image/reachability-metadata.json-3425-      },\ntests/src/org.springframework.data/spring-data-couchbase/6.1.1/src/test/resources/META-INF/native-image/reachability-metadata.json-3426-      \"type\" : \"org.testcontainers.shaded.com.github.dockerjava.core.command.AbstrDockerCmd\"\ntests/src/org.springframework.data/spring-data-couchbase/6.1.1/src/test/resources/META-INF/native-image/reachability-metadata.json-3427-    },\ntests/src/org.springframework.data/spring-data-couchbase/6.1.1/src/test/resources/META-INF/native-image/reachability-metadata.json-3428-    {\ntests/src/org.springframework.data/spring-data-couchbase/6.1.1/src/test/resources/META-INF/native-image/reachability-metadata.json-3429-      \"condition\" : {\ntests/src/org.springframework.data/spring-data-couchbase/6.1.1/src/test/resources/META-INF/native-image/reachability-metadata.json:3430:        \"typeReached\" : \"org_springframework_data.spring_data_couchbase.Spring_data_couchbaseTest\"\ntests/src/org.springframework.data/spring-data-couchbase/6.1.1/src/test/resources/META-INF/native-image/reachability-metadata.json-3431-      },\ntests/src/org.springframework.data/spring-data-couchbase/6.1.1/src/test/resources/META-INF/native-image/reachability-metadata.json-3432-      \"type\" : \"org.testcontainers.shaded.com.github.dockerjava.core.command.CreateContainerCmdImpl\",\ntests/src/org.springframework.data/spring-data-couchbase/6.1.1/src/test/resources/META-INF/native-image/reachability-metadata.json-3433-      \"fields\" : [\ntests/src/org.springframework.data/spring-data-couchbase/6.1.1/src/test/resources/META-INF/native-image/reachability-metadata.json-3434-        {\ntests/src/org.springframework.data/spring-data-couchbase/6.1.1/src/test/resources/META-INF/native-image/reachability-metadata.json-3435-          \"name\" : \"argsEscaped\"\n--\ntests/src/org.springframework.data/spring-data-couchbase/6.1.1/s