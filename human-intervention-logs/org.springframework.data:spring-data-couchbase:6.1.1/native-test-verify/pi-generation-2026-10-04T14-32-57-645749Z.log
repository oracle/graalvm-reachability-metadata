ata/spring-data-couchbase/6.1.1/.gradle/9.1.0/fileHashes/fileHashes.bin\ntests/src/org.springframework.data/spring-data-couchbase/6.1.1/.gradle/9.1.0/fileHashes/fileHashes.lock\ntests/src/org.springframework.data/spring-data-couchbase/6.1.1/.gradle/9.1.0/fileHashes/resourceHashesCache.bin\ntests/src/org.springframework.data/spring-data-couchbase/6.1.1/.gradle/9.1.0/gc.properties\ntests/src/org.springframework.data/spring-data-couchbase/6.1.1/.gradle/buildOutputCleanup/buildOutputCleanup.lock\ntests/src/org.springframework.data/spring-data-couchbase/6.1.1/.gradle/buildOutputCleanup/cache.properties\ntests/src/org.springframework.data/spring-data-couchbase/6.1.1/.gradle/buildOutputCleanup/outputFiles.bin\ntests/src/org.springframework.data/spring-data-couchbase/6.1.1/.gradle/file-system.probe\ntests/src/org.springframework.data/spring-data-couchbase/6.1.1/.gradle/noVersion/buildLogic.lock\ntests/src/org.springframework.data/spring-data-couchbase/6.1.1/gradle.properties\ntests/src/org.springframework.data/spring-data-couchbase/6.1.1/.gradle/vcs-1/gc.properties\ntests/src/org.springframework.data/spring-data-couchbase/6.1.1/settings.gradle\ntests/src/org.springframework.data/spring-data-couchbase/6.1.1/test-results-native/test/TEST-junit-jupiter.xml\ntests/src/org.springframework.data/spring-data-couchbase/6.1.1/test-results-native/test/TEST-junit-vintage.xml\ntests/src/org.springframework.data/spring-data-couchbase/6.1.1/user-code-filter.json\n\nRelated references:\ntests/src/org.springframework.data/spring-data-couchbase/6.1.1/src/test/java/org_springframework_data/spring_data_couchbase/MappingCouchbaseConverterTest.java:14:import org.springframework.data.couchbase.core.convert.MappingCouchbaseConverter;\ntests/src/org.springframework.data/spring-data-couchbase/6.1.1/src/test/java/org_springframework_data/spring_data_couchbase/MappingCouchbaseConverterTest.java:22:public class MappingCouchbaseConverterTest {\ntests/src/org.springframework.data/spring-data-couchbase/6.