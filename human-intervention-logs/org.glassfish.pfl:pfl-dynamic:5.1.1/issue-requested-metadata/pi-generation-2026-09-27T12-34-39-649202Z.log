[tool-call] delta {"path":"tests/src/org.glassfish.pfl/pfl-dynamic/5.1.1/src/test/java/org_glassfish_pfl/pfl_dynamic/ClassCopierOrdinaryImplTest.java","edits":[{"oldText":"import static org.assertj.core.api.Assertions.assertThat;\n\nimport org.glassfish.pfl.dynamic.copyobject.spi.CopyobjectDefaults;","newText":"import static org.assertj.core.api.Assertions.assertThat;\n\nimport java.io.Serializable;\nimport org.glassfish.pfl.dynamic.copyobject.spi.CopyobjectDefaults;"},{"oldText":"    public static final class OrdinaryValue {\n        private int number;\n        private String text;\n\n        public OrdinaryValue() {}\n\n        public OrdinaryValue(int number, String text) {\n            this.number = number;\n            this.text = text;\n        }\n    }\n}","newText":"    @Test\n    void appliesReadResolveToTheCopiedObject() {\n        ResolvedValue source = new ResolvedValue(\"source\");\n        ObjectCopier copier = CopyobjectDefaults.makeReflectObjectCopierFactory().make();\n\n        ResolvedValue copy = (ResolvedValue) copier.copy(source);\n\n        assertThat(copy).isSameAs(ResolvedValue.CANONICAL);\n        assertThat(copy.value).isEqualTo(\"canonical\");\n    }\n\n    public static final class OrdinaryValue {\n        private int number;\n        private String text;\n\n        public OrdinaryValue() {}\n\n        public OrdinaryValue(int number, String text) {\n            this.number = number;\n            this.text = text;\n        }\n    }\n\n    public static final class ResolvedValue implements Serializable {\n        private static final ResolvedValue CANONICAL = new ResolvedValue(\"canonical\");\n\n        private String value;\n\n        public ResolvedValue() {}\n\n        public ResolvedValue(String value) {\n            this.value = value;\n        }\n\n        private Object readResolve() {\n            return CANONICAL;\n        }\n    }\n}"}]}
