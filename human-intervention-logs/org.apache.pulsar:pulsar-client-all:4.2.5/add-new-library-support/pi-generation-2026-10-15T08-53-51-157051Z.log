coordinates = org.apache.pulsar:pulsar-client-all:4.2.5\ntests/src/org.apache.pulsar/pulsar-client-all/4.2.5/gradle.properties:6:metadata.dir = org.apache.pulsar/pulsar-client-all/4.2.5/\ntests/src/org.apache.pulsar/pulsar-client-all/4.2.5/build.gradle:14:    testImplementation \"org.apache.pulsar:pulsar-client-all:$libraryVersion\"\ntests/src/org.apache.pulsar/pulsar-client-api/4.2.1/src/test/java/org_apache_pulsar/pulsar_client_api/DefaultImplementationTest.java:12:import org.apache.pulsar.client.internal.PulsarClientImplementationBinding;\ntests/src/org.apache.pulsar/pulsar-client-api/4.2.1/src/test/java/org_apache_pulsar/pulsar_client_api/DefaultImplementationTest.java:18:        final PulsarClientImplementationBinding implementation = DefaultImplementation.getDefaultImplementation();\ntests/src/org.apache.pulsar/pulsar-client-api/4.2.1/src/test/java/org_apache_pulsar/pulsar_client_api/DefaultImplementationTest.java:22:                .isEqualTo(\"org.apache.pulsar.client.impl.PulsarClientImplementationBindingImpl\");\ntests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/resources/META-INF/native-image/reachability-metadata.json:101:      \"type\" : \"org_apache_pulsar.pulsar_client_all.PulsarClientAllTest$PurchaseOrder\"\ntests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/resources/META-INF/native-image/reachability-metadata.json:107:      \"type\" : \"org_apache_pulsar.pulsar_client_all.PulsarClientAllTest$PurchaseOrder\",\ntests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/resources/META-INF/native-image/reachability-metadata.json:123:      \"type\" : \"org_apache_pulsar.pulsar_client_all.PulsarClientAllTest$PurchaseOrder\",\ntests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/resources/META-INF/native-image/reachability-metadata.json:143:      \"type\" : \"org_apache_pulsar.pulsar_client_all.PulsarClientAllTest$PurchaseOrder\",\ntests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/resources/META-INF/native-image/reachability-metadata.json:155:      \"type\" : \"org_apache_pulsar.pulsar_client_all.PulsarClientAllTest$PurchaseOrder\"\ntests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/PulsarClientAllTest.java:22:import org.apache.pulsar.client.api.PulsarClient;\ntests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/PulsarClientAllTest.java:35:public class PulsarClientAllTest {\ntests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/PulsarClientAllTest.java:39:    private static final String CONTAINER_NAME = \"graalvm-pulsar-client-all-test\";\ntests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/PulsarClientAllTest.java:45:    private PulsarClient client;\ntests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/PulsarClientAllTest.java:67:            waitUntil(PulsarClientAllTest::brokerIsReady, READINESS_TIMEOUT);\ntests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/PulsarClientAllTest.java:69:            client = PulsarClient.builder()\n"}], "isError": false, "timestamp": 1792054458758}}
