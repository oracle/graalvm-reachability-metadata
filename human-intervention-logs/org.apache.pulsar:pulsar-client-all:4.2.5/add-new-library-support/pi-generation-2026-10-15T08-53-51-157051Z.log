[tool-call] delta {"path":"tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/PulsarClientAllTest.java","edits":[{"oldText":"import java.util.concurrent.Callable;\nimport java.util.concurrent.TimeUnit;\n","newText":"import java.util.concurrent.Callable;\nimport java.util.concurrent.CompletableFuture;\nimport java.util.concurrent.TimeUnit;\n"},{"oldText":"import org.apache.pulsar.client.api.SubscriptionInitialPosition;\n","newText":"import org.apache.pulsar.client.api.SubscriptionInitialPosition;\nimport org.apache.pulsar.client.api.TableView;\n"},{"oldText":"    @Test\n    void readsBytesFromEarliestMessage() throws Exception {\n","newText":"    @Test\n    void buildsTableViewFromLatestKeyedValues() throws Exception {\n        String topic = topic(\"table-view\");\n        try (Producer<String> producer = client.newProducer(Schema.STRING)\n                        .topic(topic)\n                        .producerName(\"table-view-producer\")\n                        .sendTimeout(OPERATION_TIMEOUT_SECONDS, TimeUnit.SECONDS)\n                        .enableBatching(false)\n                        .create()) {\n            producer.newMessage()\n                    .key(\"service-a\")\n                    .value(\"starting\")\n                    .sendAsync()\n                    .get(OPERATION_TIMEOUT_SECONDS, TimeUnit.SECONDS);\n            CompletableFuture<MessageId> serviceAUpdate = producer.newMessage()\n                    .key(\"service-a\")\n                    .value(\"ready\")\n                    .sendAsync();\n            CompletableFuture<MessageId> serviceBUpdate = producer.newMessage()\n                    .key(\"service-b\")\n                    .value(\"idle\")\n                    .sendAsync();\n            CompletableFuture.allOf(serviceAUpdate, serviceBUpdate)\n                    .get(OPERATION_TIMEOUT_SECONDS, TimeUnit.SECONDS);\n\n            try (TableView<String> tableView = client.newTableViewBuilder(Schema.STRING)\n                    .topic(topic)\n                    .createAsync()\n                    .get(OPERATION_TIMEOUT_SECONDS, TimeUnit.SECONDS)) {\n                assertThat(tableView).hasSize(2);\n                assertThat(tableView.get(\"service-a\")).isEqualTo(\"ready\");\n                assertThat(tableView.get(\"service-b\")).isEqualTo(\"idle\");\n                assertThat(tableView.keySet()).containsExactlyInAnyOrder(\"service-a\", \"service-b\");\n            }\n        }\n    }\n\n    @Test\n    void readsBytesFromEarliestMessage() throws Exception {\n"}]}
[tool-call] end id=call_gs044m5dMxUNXqfxzcdVU6tC|fc_08d8869def8ce40a016ad097d193f487d183f5639f7113ec37 name=edit args={"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/PulsarClientAllTest.java", "edits": [{"oldText": "import java.util.concurrent.Callable;\nimport java.util.concurrent.TimeUnit;\n", "newText": "import java.util.concurrent.Callable;\nimport java.util.concurrent.CompletableFuture;\nimport java.util.concurrent.TimeUnit;\n"}, {"oldText": "import org.apache.pulsar.client.api.SubscriptionInitialPosition;\n", "newText": "import org.apache.pulsar.client.api.SubscriptionInitialPosition;\nimport org.apache.pulsar.client.api.TableView;\n"}, {"oldText": "    @Test\n    void readsBytesFromEarliestMessage() throws Exception {\n", "newText": "    @Test\n    void buildsTableViewFromLatestKeyedValues() throws Exception {\n        String topic = topic(\"table-view\");\n        try (Producer<String> producer = client.newProducer(Schema.STRING)\n                        .topic(topic)\n                        .producerName(\"table-view-producer\")\n                        .sendTimeout(OPERATION_TIMEOUT_SECONDS, TimeUnit.SECONDS)\n                        .enableBatching(false)\n                        .create()) {\n            producer.newMessage()\n                    .key(\"service-a\")\n                    .value(\"starting\")\n                    .sendAsync()\n                    .get(OPERATION_TIMEOUT_SECONDS, TimeUnit.SECONDS);\n            CompletableFuture<MessageId> serviceAUpdate = producer.newMessage()\n                    .key(\"service-a\")\n                    .value(\"ready\")\n                    .sendAsync();\n            CompletableFuture<MessageId> serviceBUpdate = producer.newMessage()\n                    .key(\"service-b\")\n                    .value(\"idle\")\n                    .sendAsync();\n            CompletableFuture.allOf(serviceAUpdate, serviceBUpdate)\n                    .get(OPERATION_TIMEOUT_SECONDS, TimeUnit.SECONDS);\n\n            try (TableView<String> tableView = client.newTableViewBuilder(Schema.STRING)\n                    .topic(topic)\n                    .createAsync()\n                    .get(OPERATION_TIMEOUT_SECONDS, TimeUnit.SECONDS)) {\n                assertThat(tableView).hasSize(2);\n                assertThat(tableView.get(\"service-a\")).isEqualTo(\"ready\");\n                assertThat(tableView.get(\"service-b\")).isEqualTo(\"idle\");\n                assertThat(tableView.keySet()).containsExactlyInAnyOrder(\"service-a\", \"service-b\");\n            }\n        }\n    }\n\n    @Test\n    void readsBytesFromEarliestMessage() throws Exception {\n"}]}
