t {\n    @Test\n    void serializesFieldAndGetterAsArrayElements() throws Exception {\n        ObjectMapper mapper = new ObjectMapper();\n\n        String json = mapper.writeValueAsString(new TopicSummary(\"orders\", 4));\n        TopicSummary restored = mapper.readValue(json, TopicSummary.class);\n\n        assertThat(json).startsWith(\"[\").endsWith(\"]\").contains(\"4\", \"orders\");\n        assertThat(restored.partitions).isEqualTo(4);\n        assertThat(restored.getName()).isEqualTo(\"orders\");\n    }\n\n    @JsonFormat(shape = JsonFormat.Shape.ARRAY)\n    public static final class TopicSummary {\n        public int partitions;\n        private String name;\n\n        public TopicSummary() { }\n\n        TopicSummary(String name, int partitions) {\n            this.name = name;\n            this.partitions = partitions;\n        }\n\n        public String getName() {\n            return name;\n        }\n\n        public void setName(String name) {\n            this.name = name;\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792099167259}, {"role": "toolResult", "toolCallId": "call_s2llR26003stdtJP6GkXedQ4|fc_0473f1a7bf29e04a016ad1435db14487d1a64d8dcd8ea5d36f", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.fasterxml.jackson.annotation.JsonAlias;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.annotation.JsonProperty;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.ObjectMapper;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.Timeout;\n\n@Timeout(55)\npublic class JacksonAnnotationIntrospectorTest {\n    @Test\n    void honorsEnumNamesAndAliases() throws Exception {\n        ObjectMapper mapper = new ObjectMapper();\n\n        String encoded = mapper.writeValueAsString(Mode.SHARED);\n        Mode alias = mapper.readValue(\"\\\"shared-subscription\\\"\", Mode.class);\n\n        assertThat(encoded).isEqualTo(\"\\\"shared\\\"\");\n        assertThat(alias).isEqualTo(Mode.SHARED);\n    }\n\n    private enum Mode {\n        @JsonProperty(\"shared\")\n        @JsonAlias(\"shared-subscription\")\n        SHARED\n    }\n}\n"}], "isError": false, "timestamp": 1792099167259}, {"role": "toolResult", "toolCallId": "call_8gEPpBMeFU9hfZm48kSaPoQY|fc_0473f1a7bf29e04a016ad1435db15087d19d0961fd1e386bb4", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.google.common.collect.CompactHashSet;\nimport org.apache.pulsar.shade.org.apache.commons.lang3.SerializationUtils;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.Timeout;\n\n@Timeout(55)\npublic class CompactHashSetTest {\n    @Test\n    void preservesCompactSetElementsAcrossSerialization() {\n        CompactHashSet<String> original = CompactHashSet.create(\"topic-a\", \"topic-b\");\n\n        CompactHashSet<String> restored = SerializationUtils.roundtrip(original);\n\n        assertThat(restored).containsExactlyInAnyOrder(\"topic-a\", \"topic-b\");\n        assertThat(restored).isNotSameAs(original);\n    }\n}\n"}], "isError": false, "timestamp": 1792099167259}, {"role": "toolResult", "toolCallId": "call_Hr6xgQiRJ1D7VBq11qFif6Tr|fc_0473f1a7bf29e04a016ad1435db15c87d183fa2b429209d870", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You sho