mport java.util.ArrayList;\nimport java.util.List;\nimport org.apache.pulsar.shade.org.apache.commons.lang3.SerializationUtils;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.Timeout;\n\n@Timeout(55)\npublic class SerializationUtilsTest {\n    @Test\n    void clonesAndRoundTripsSerializableValues() {\n        ArrayList<String> original = new ArrayList<>(List.of(\"ledger\", \"cursor\"));\n\n        ArrayList<String> clone = SerializationUtils.clone(original);\n        byte[] encoded = SerializationUtils.serialize(original);\n        ArrayList<String> decoded = SerializationUtils.deserialize(encoded);\n\n        assertThat(clone).containsExactlyElementsOf(original).isNotSameAs(original);\n        assertThat(decoded).containsExactlyElementsOf(original).isNotSameAs(original);\n    }\n}\n"}}, {"type": "toolCall", "id": "call_zkdVG0VVp05YjpKBdzxou33v|fc_0473f1a7bf29e04a016ad1414fcacc87d1ac1d6cc77084f4d9", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ObjectUtilsTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.org.apache.commons.lang3.ObjectUtils;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.Timeout;\n\n@Timeout(55)\npublic class ObjectUtilsTest {\n    @Test\n    void clonesPrimitiveArraysAndCloneableObjects() {\n        int[] numbers = {1, 2, 3};\n        CloneableValue value = new CloneableValue(\"cursor\");\n\n        int[] copiedNumbers = ObjectUtils.clone(numbers);\n        CloneableValue copiedValue = ObjectUtils.clone(value);\n\n        assertThat(copiedNumbers).containsExactly(1, 2, 3).isNotSameAs(numbers);\n        assertThat(copiedValue).isNotSameAs(value);\n        assertThat(copiedValue.name).isEqualTo(\"cursor\");\n    }\n\n    public static final class CloneableValue implements Cloneable {\n        private final String name;\n\n        CloneableValue(String name) {\n            this.name = name;\n        }\n\n        @Override\n        public CloneableValue clone() {\n            return new CloneableValue(name);\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_272HuYeJmXKRQCWHrcMyTwpI|fc_0473f1a7bf29e04a016ad1414fcadc87d186273b28fa986bb3", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ClassUtilsTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.lang.reflect.Method;\nimport java.util.Collections;\nimport java.util.List;\nimport java.util.Map;\nimport org.apache.pulsar.shade.org.apache.commons.lang3.ClassUtils;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.Timeout;\n\n@Timeout(55)\npublic class ClassUtilsTest {\n    @Test\n    void resolvesNamesArraysAndPublicInterfaceMethods() throws Exception {\n        List<Class<?>> classes = ClassUtils.convertClassNamesToClasses(\n                List.of(String.class.getName(), \"missing.example.Type\"));\n        Class<?> entryArray = ClassUtils.getClass(\n                getClass().getClassLoader(), \"java.util.Map.Entry[]\", true);\n        Method size = ClassUtils.getPublicMethod(\n                Collections.unmodifiableList(List.of(\"entry\")).getClass(), \"size\");\n\n        assertThat(classes).containsExactly(String.class, null);\n        assertThat(entryArray).isEqualTo(Map.Entry[].class);\n        as