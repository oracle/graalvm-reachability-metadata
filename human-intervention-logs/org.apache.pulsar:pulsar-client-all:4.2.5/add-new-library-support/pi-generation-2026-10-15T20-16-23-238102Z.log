uilder(withPrefix = \"with\")\n        public static final class Builder {\n            private String name;\n            private int priority;\n\n            public Builder withName(String name) {\n                this.name = name;\n                return this;\n            }\n\n            public Builder withPriority(int priority) {\n                this.priority = priority;\n                return this;\n            }\n\n            public Subscription build() {\n                return new Subscription(name, priority);\n            }\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_297KKcbPh5GiFwj6amiPDDrC|fc_0473f1a7bf29e04a016ad142654a7887d1b3e00fc208c9ea96", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/SetterlessPropertyTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.ArrayList;\nimport java.util.List;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.ObjectMapper;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.Timeout;\n\n@Timeout(55)\npublic class SetterlessPropertyTest {\n    @Test\n    void populatesMutableCollectionReturnedByGetter() throws Exception {\n        ObjectMapper mapper = new ObjectMapper();\n\n        ConsumerGroup group = mapper.readValue(\n                \"{\\\"consumers\\\":[\\\"consumer-a\\\",\\\"consumer-b\\\"]}\", ConsumerGroup.class);\n\n        assertThat(group.getConsumers()).containsExactly(\"consumer-a\", \"consumer-b\");\n    }\n\n    public static final class ConsumerGroup {\n        private final List<String> consumers = new ArrayList<>();\n\n        public List<String> getConsumers() {\