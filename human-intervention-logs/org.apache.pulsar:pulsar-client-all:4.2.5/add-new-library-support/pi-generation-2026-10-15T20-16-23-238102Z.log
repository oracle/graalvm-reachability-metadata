      private Class<? extends Object> wrapIfPrimitive(Class<?> clazz) {
        if (!clazz.isPrimitive()) {
          return clazz;
        }
        if (clazz == Integer.TYPE) {
          return Integer.class;
        }
        if (clazz == Float.TYPE) {
          return Float.class;
        }
        if (clazz == Double.TYPE) {
          return Double.class;
        }
        if (clazz == Boolean.TYPE) {
          return Boolean.class;
