).isEqualTo(4);\n        assertThat(decodedShipment).isEqualTo(new Shipment(\"shipment-9\", 3));\n    }\n\n    public static final class InventoryItem {\n        public int units;\n        private String name;\n\n        public InventoryItem() { }\n\n        public String getName() {\n            return name;\n        }\n\n        public void setName(String name) {\n            this.name = name;\n        }\n    }\n\n    public record Shipment(String id, int units) { }\n}\n"}}, {"type": "toolCall", "id": "call_K7lGqiB63JCSEYvH2VPjBpxS|fc_0672f30ea9308838016ad13c1f7d2c87d18e9395a4e7e3c332", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ReflectionHelperInnerRecordSupportedHelperTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.google.gson.Gson;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.Timeout;\n\n@Timeout(55)\npublic class ReflectionHelperInnerRecordSupportedHelperTest {\n    @Test\n    void mapsRecordsEnumsArraysAndMutableFields() {\n        Gson gson = new Gson();\n        Delivery delivery = new Delivery(\"route-7\", State.READY, new String[] {\"cold\", \"priority\"});\n        MutableStop mutableStop = new MutableStop(\"warehouse\", 2);\n\n        String deliveryJson = gson.toJson(delivery);\n        Delivery decodedDelivery = gson.fromJson(deliveryJson, Delivery.class);\n        MutableStop decodedStop = gson.fromJson(gson.toJson(mutableStop), MutableStop.class);\n\n        assertThat(decodedDelivery.route()).isEqualTo(\"route-7\");\n        assertThat(decodedDelivery.state()).isEqualTo(State.READY);\n        assertThat(decodedDelivery.tags()).containsExactly(\"cold\", \"priority\");\n        assertThat(decodedStop.name).isEqualTo(\"warehouse\");\n        assertThat(decodedStop.sequence).isEqualTo(2);\n    }\n\n    public enum State {\n        READY,\n        DELIVERED\n    }\n\n    public record Delivery(String route, State state, String[] tags) { }\n\n    public static final class MutableStop {\n        private String name;\n        private int sequence;\n\n        public MutableStop() { }\n\n        public MutableStop(String name, int sequence) {\n            this.name = name;\n            this.sequence = sequence;\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_9HtiSw08uHgcqAbbtuYSk0jR|fc_0672f30ea9308838016ad13c1f7d3c87d196115f2e8898b4df", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ConstructorInnerConstructScalarTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.List;\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.LoaderOptions;\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.Yaml;\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.constructor.Constructor;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.Timeout;\n\n@Timeout(55)\npublic class ConstructorInnerConstructScalarTest {\n    @Test\n    void constructsBeanScalarsSequencesAndProperties() {\n        Constructor constructor = new Constructor(BrokerConfig.class, new LoaderOptions());\n        Yaml yaml = new Yaml(constructor);\n\n        BrokerConfig config = yaml.load(\"\"\"\n                name: local\n                port: 6650\n                address: [localhost, 6650]\n                roles: [producer, consumer]\n                \"\"\");\n        String emitted = yaml.dumpAsMap(config);\n\n        assertThat(config.getName()).isEqualTo(\"local\");\n        assertThat(config.getPort().value()).isEqualTo(6650);\n        assertThat(config.getAddress().host()).isEqualTo(\"localhost\");\n        assertThat(config.getAddress().port()).isEqualTo(6650);\n        assertThat(config.getRoles()).containsExactly(\"producer\", \"consumer\");\n        assertThat(emitted).contains(\"name: local\", \"producer\", \"consumer\");\n    }\n\n    public static final class BrokerConfig {\n        private String name;\n        private Port port;\n        private Address address;\n        private List<String> roles;\n\n        public BrokerConfig() { }\n\n        public String getName() {\n            return name;\n        }\n\n        public void setName(String name) {\n            this.name = name;\n        }\n\n        public Port getPort() {\n            return port;\n        }\n\n        public void setPort(Port port) {\n            this.port = port;\n        }\n\n        public Address getAddress() {\n            return address;\n        }\n\n        public void setAddress(Address address) {\n            this.address = address;\n        }\n\n        public List<String> getRoles() {\n            return roles;\n        }\n\n        public void setRoles(List<String> roles) {\n            this.roles = roles;\n        }\n    }\n\n    public static final class Port {\n        private final int value;\n\n        public Port(String value) {\n            this.value = Integer.parseInt(value);\n        }\n\n        public int value() {\n            return value;\n        }\n    }\n\n    public static final class Address {\n        private final String host;\n        private final int port;\n\n        public Address(String host, int port) {\n            this.host = host;\n            this.port = port;\n        }\n\n        public String host() {\n            return host;\n        }\n\n        public int port() {\n            return port;\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_vJRUoT0FLJr9fGeBLZ7GsWJy|fc_0672f30ea9308838016ad13c1f7d5487d1bcdc2acd00debdca", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ClientBuilderTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.net.URI;\nimport java.util.concurrent.TimeUnit;\nimport org.apache.pulsar.shade.javax.ws.rs.client.Client;\nimport org.apache.pulsar.shade.javax.ws.rs.client.ClientBuilder;\nimport org.apache.pulsar.shade.javax.ws.rs.client.WebTarget;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.Timeout;\n\n@Timeout(55)\npublic class ClientBuilderTest {\n    @Test\n    void buildsAndConfiguresJerseyClientTarget() {\n        Client client = ClientBuilder.newBuilder()\n                .connectTimeout(10, TimeUnit.SECONDS)\n                .readTimeout(10, TimeUnit.SECONDS)\n                .build();\n        try {\n            WebTarget target = client.target(\"http://localhost:8080\")\n                    .path(\"admin/v2/clusters\")\n                    .queryParam(\"authoritative\", true);\n            URI uri = target.getUri();\n\n            assertThat(uri.getScheme()).isEqualTo(\"http\");\n            assertThat(uri.getPath()).isEqualTo(\"/admin/v2/clusters\");\n            assertThat(uri.getQuery()).isEqualTo(\"authoritative=true\");\n            assertThat(client.getConfiguration().getRuntimeType().name()).isEqualTo(\"CLIENT\");\n        } finally {\n            client.close();\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_ubNriG7buultVwvlr9yaKDVH|fc_0672f30ea9308838016ad13c1f7d6887d18d2ec40b2a2f1cda", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/SimpleTimeLimiterTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.concurrent.ExecutorService;\nimport java.util.concurrent.Executors;\nimport java.util.concurrent.TimeUnit;\nimport org.apache.pulsar.shade.com.google.common.util.concurrent.SimpleTimeLimiter;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.Timeout;\n\n@Timeout(55)\npublic class SimpleTimeLimiterTest {\n    @Test\n    void invokesInterruptibleInterfaceThroughTimedProxy() throws Exception {\n        ExecutorService executor = Executors.newSingleThreadExecutor();\n        try {\n            Greeting target = new GreetingService();\n            Greeting proxy = SimpleTimeLimiter.create(executor)\n                    .newProxy(target, Greeting.class, 10, TimeUnit.SECONDS);\n\n            assertThat(proxy.greet(\"Pulsar\")).isEqualTo(\"hello Pulsar\");\n        } finally {\n            executor.shutdownNow();\n            assertThat(executor.awaitTermination(10, TimeUnit.SECONDS)).isTrue();\n        }\n    }\n\n    public interface Greeting {\n        String greet(String name) throws InterruptedException;\n    }\n\n    public static final class GreetingService implements Greeting {\n        @Override\n        public String greet(String name) {\n            return \"hello \" + name;\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_IgL9wgUVogqCmxKy3m4Ckvvh|fc_0672f30ea9308838016ad13c1f7d7887d1a45d5e97759ad4e0", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/SubscriberTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.ArrayList;\nimport java.util.List;\nimport org.apache.pulsar.shade.com.google.common.eventbus.EventBus;\nimport org.apache.pulsar.shade.com.google.common.eventbus.Subscribe;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.Timeout;\n\n@Timeout(55)\npublic class SubscriberTest {\n    @Test\n    void discoversAndInvokesAnnotatedSubscriber() {\n        EventBus eventBus = new EventBus(\"pulsar-events\");\n        MessageListener listener = new MessageListener();\n        eventBus.register(listener);\n\n        eventBus.post(\"connected\");\n        eventBus.post(\"ready\");\n\n        assertThat(listener.messages).containsExactly(\"connected\", \"ready\");\n        eventBus.unregister(listener);\n    }\n\n    public static final class MessageListener {\n        private final List<String> messages = new ArrayList<>();\n\n        @Subscribe\n        public void onMessage(String message) {\n            messages.add(message);\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_UIG5lhJm5R4u0OAdaOZ54rAp|fc_0672f30ea9308838016ad13c1f7d8887d1a7260f6e835d13ad", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/EventListenerSupportTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.ArrayList;\nimport java.util.List;\nimport org.apache.pulsar.shade.org.apache.commons.lang3.event.EventListenerSupport;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.Timeout;\n\n@Timeout(55)\npublic class EventListenerSupportTest {\n    @Test\n    void forwardsEventsToAllRegisteredListeners() {\n        EventListenerSupport<StateListener> support =\n                EventListenerSupport.create(StateListener.class);\n        List<String> first = new ArrayList<>();\n        List<String> second = new ArrayList<>();\n        support.addListener(first::add);\n        support.addListener(second::add);\n\n        support.fire().stateChanged(\"active\");\n\n        assertThat(first).containsExactly(\"active\");\n        assertThat(second).containsExactly(\"active\");\n        assertThat(support.getListeners()).hasSize(2);\n    }\n\n    public interface StateListener {\n        void stateChanged(String state);\n    }\n}\n"}}, {"type": "toolCall", "id": "call_g4yHmm6grrBxAdgKVztfko7H|fc_0672f30ea9308838016ad13c1f7d9487d1a1814a052da1f69c", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/JdkAlpnSslUtilsTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.List;\nimport java.util.function.BiFunction;\nimport javax.net.ssl.SSLEngine;\nimport org.apache.pulsar.shade.io.netty.buffer.UnpooledByteBufAllocator;\nimport org.apache.pulsar.shade.io.netty.handler.ssl.ApplicationProtocolConfig;\nimport org.apache.pulsar.shade.io.netty.handler.ssl.SslContext;\nimport org.apache.pulsar.shade.io.netty.handler.ssl.SslContextBuilder;\nimport org.apache.pulsar.shade.io.netty.handler.ssl.SslProvider;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.Timeout;\n\n@Timeout(55)\npublic class JdkAlpnSslUtilsTest {\n    @Test\n    void configuresAndQueriesJdkAlpnEngine() throws Exception {\n        ApplicationProtocolConfig protocols = new ApplicationProtocolConfig(\n                ApplicationProtocolConfig.Protocol.ALPN,\n                ApplicationProtocolConfig.SelectorFailureBehavior.NO_ADVERTISE,\n                ApplicationProtocolConfig.SelectedListenerFailureBehavior.ACCEPT,\n                \"h2\",\n                \"http/1.1\");\n        SslContext context = SslContextBuilder.forClient()\n                .sslProvider(SslProvider.JDK)\n                .applicationProtocolConfig(protocols)\n                .build();\n        SSLEngine engine = context.newEngine(UnpooledByteBufAllocator.DEFAULT);\n        try {\n            BiFunction<SSLEngine, List<String>, String> selector =\n                    (ignored, offered) -> offered.contains(\"h2\") ? \"h2\" : null;\n            engine.setHandshakeApplicationProtocolSelector(selector);\n\n            assertThat(engine.getSSLParameters().getApplicationProtocols())\n                    .containsExactly(\"h2\", \"http/1.1\");\n            assertThat(engine.getHandshakeApplicationProtocolSelector()).isSameAs(selector);\n            assertThat(engine.getApplicationProtocol()).isIn(null, \"\");\n            assertThat(engine.getHandshakeApplicationProtocol()).isNull();\n        } finally {\n            engine.closeOutbound();\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_v63pIBi3JxwifYhfqG0mMcfY|fc_0672f30ea9308838016ad13c1f7da887d1b879159e29cda9c9", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/NioDatagramChannelConfigTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.concurrent.TimeUnit;\nimport org.apache.pulsar.shade.io.netty.channel.socket.DatagramChannelConfig;\nimport org.apache.pulsar.shade.io.netty.channel.socket.nio.NioDatagramChannel;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.Timeout;\n\n@Timeout(55)\npublic class NioDatagramChannelConfigTest {\n    @Test\n    void readsAndWritesMulticastSocketOptions() {\n        NioDatagramChannel channel = new NioDatagramChannel();\n        try {\n            DatagramChannelConfig config = channel.config();\n            config.setTimeToLive(8);\n            config.setLoopbackModeDisabled(false);\n\n            assertThat(config.getTimeToLive()).isEqualTo(8);\n            assertThat(config.isLoopbackModeDisabled()).isFalse();\n        } finally {\n            channel.close().awaitUninterruptibly(10, TimeUnit.SECONDS);\n        }\n        assertThat(channel.isOpen()).isFalse();\n    }\n}\n"}}, {"type": "toolCall", "id": "call_jTXuuffuxxPY3Pnhx2HXBvaL|fc_0672f30ea9308838016ad13c1f7db487d1850362aa3b03d97b", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/QuantilesItemsSketchTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.Comparator;\nimport org.apache.pulsar.shade.com.yahoo.sketches.quantiles.ItemsSketch;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.Timeout;\n\n@Timeout(55)\npublic class QuantilesItemsSketchTest {\n    @Test\n    void returnsTypedQuantileArrays() {\n        ItemsSketch<String> sketch = ItemsSketch.getInstance(Comparator.naturalOrder());\n        sketch.update(\"alpha\");\n        sketch.update(\"charlie\");\n        sketch.update(\"bravo\");\n        sketch.update(\"delta\");\n\n        String[] quantiles = sketch.getQuantiles(new double[] {0.0, 0.5, 1.0});\n\n        assertThat(quantiles).containsExactly(\"alpha\", \"bravo\", \"delta\");\n        assertThat(sketch.getQuantile(0.5)).isEqualTo(\"bravo\");\n    }\n}\n"}}, {"type": "toolCall", "id": "call_4Vz7lMPy17o7n08xrMmKfMpk|fc_0672f30ea9308838016ad13c1f7dc487d1b2d8193948776cb2", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ReservoirItemsSketchTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.yahoo.sketches.sampling.ReservoirItemsSketch;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.Timeout;\n\n@Timeout(55)\npublic class ReservoirItemsSketchTest {\n    @Test\n    void returnsSamplesWithInferredAndRequestedComponentTypes() {\n        ReservoirItemsSketch<CharSequence> sketch = ReservoirItemsSketch.getInstance(8);\n        sketch.update(\"one\");\n        sketch.update(\"two\");\n        sketch.update(\"three\");\n\n        CharSequence[] inferred = sketch.getSamples();\n        CharSequence[] requested = sketch.getSamples(CharSequence.class);\n\n        assertThat(inferred).containsExactly(\"one\", \"two\", \"three\");\n        assertThat(inferred.getClass().getComponentType()).isEqualTo(String.class);\n        assertThat(requested).containsExactly(\"one\", \"two\", \"three\");\n        assertThat(requested.getClass().getComponentType()).isEqualTo(CharSequence.class);\n    }\n}\n"}}, {"type": "toolCall", "id": "call_4b7UdtqVMQy44AsbOOTgNQIZ|fc_0672f30ea9308838016ad13c1f7dd487d1addf173fbbc02bd3", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/FrequenciesItemsSketchTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.yahoo.sketches.frequencies.ErrorType;\nimport org.apache.pulsar.shade.com.yahoo.sketches.frequencies.ItemsSketch;\nimport org.apache.pulsar.shade.com.yahoo.sketches.frequencies.ItemsSketch.Row;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.Timeout;\n\n@Timeout(55)\npublic class FrequenciesItemsSketchTest {\n    @Test\n    void returnsTypedRowsForFrequentItems() {\n        ItemsSketch<String> sketch = new ItemsSketch<>(16);\n        sketch.update(\"orders\", 5);\n        sketch.update(\"payments\", 2);\n        sketch.update(\"audit\", 1);\n\n        Row<String>[] rows = sketch.getFrequentItems(ErrorType.NO_FALSE_NEGATIVES);\n\n        assertThat(rows).extracting(Row::getItem)\n                .containsExactly(\"orders\", \"payments\", \"audit\");\n        assertThat(rows[0].getEstimate()).isEqualTo(5);\n    }\n}\n"}}, {"type": "toolCall", "id": "call_KnEdAt4GDsW66I4vx0I1GYQA|fc_0672f30ea9308838016ad13c1f7de487d1943ba6ad0c0b26e7", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/MultivaluedStringMapTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.org.glassfish.jersey.internal.util.collection.MultivaluedStringMap;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.Timeout;\n\n@Timeout(55)\npublic class MultivaluedStringMapTest {\n    @Test\n    void convertsStringValuesThroughPublicConstructors() {\n        MultivaluedStringMap values = new MultivaluedStringMap();\n        values.putSingle(\"port\", \"6650\");\n        values.putSingle(\"retries\", \"4\");\n\n        Port port = values.getFirst(\"port\", Port.class);\n        RetryCount retries = values.getFirst(\"retries\", new RetryCount(\"1\"));\n\n        assertThat(port.value()).isEqualTo(6650);\n        assertThat(retries.value()).isEqualTo(4);\n        assertThat(values.getFirst(\"missing\", new RetryCount(\"2\")).value()).isEqualTo(2);\n    }\n\n    public static final class Port {\n        private final int value;\n\n        public Port(String value) {\n            this.value = Integer.parseInt(value);\n        }\n\n        public int value() {\n            return value;\n        }\n    }\n\n    public static final class RetryCount {\n        private final int value;\n\n        public RetryCount(String value) {\n            this.value = Integer.parseInt(value);\n        }\n\n        public int value() {\n            return value;\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_EnKgui81YTzZGcoSWcp6abx9|fc_0672f30ea9308838016ad13c1f7df487d1b8579736f4ebe777", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ReflectionToStringBuilderTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 lega