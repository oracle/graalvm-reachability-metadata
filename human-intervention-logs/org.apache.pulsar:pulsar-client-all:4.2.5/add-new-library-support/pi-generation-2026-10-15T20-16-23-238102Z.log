pache_pulsar/pulsar_client_all/AvroSchemaTest.java:30:                \"event-17\", Instant.parse(\"2025-01-15T10:15:30.123Z\"), 4);\ntests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/DateDeserializersInnerCalendarDeserializerTest.java:24:                \"\\\"2024-06-15T10:20:30.000+00:00\\\"\", GregorianCalendar.class);\ntests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/FieldUtilsTest.java:22:        Field hidden = FieldUtils.getDeclaredField(ChildFields.class, \"hidden\", true);\ntests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/PulsarClientAllTest.java:40:    private static final String IMAGE = \"apachepulsar/pulsar:4.2.5\";\ntests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/PulsarClientAllTest.java:195:                Thread.sleep(1_000L);\n\nDiff check:\n\nStats excluding pre-existing metadata:\n .../EventListenerSupportTest.java                  | 27 +++++++++++++++++++++-\n 1 file changed, 26 insertions(+), 1 deletion(-)\n"}], "isError": false, "timestamp": 1792099088547}, {"role": "toolResult", "toolCallId": "call_zVVrn2WoBykzilFjN6rahqbJ|fc_0473f1a7bf29e04a016ad1430ff69487d19ea6d4757c238fcf", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.io.Serializable;\nimport java.util.ArrayList;\nimport java.util.EventListener;\nimport java.util.List;\nimport org.apache.pulsar.shade.org.apache.commons.lang3.SerializationUtils;\nimport org.apache.pulsar.shade.org.apache.commons.lang3.event.EventListenerSupport;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.Timeout;\n\n@Timeout(55)\npublic class EventListenerSupportTest {\n    @Test\n    void forwardsEventsToAllRegisteredListeners() {\n        EventListenerSupport<StateListener> support =\n                EventListenerSupport.create(StateListener.class);\n        List<String> first = new ArrayList<>();\n        List<String> second = new ArrayList<>();\n        support.addListener(first::add);\n        support.addListener(second::add);\n\n        support.fire().stateChanged(\"active\");\n\n        assertThat(first).containsExactly(\"active\");\n        assertThat(second).containsExactly(\"active\");\n        assertThat(support.getListeners()).hasSize(2);\n    }\n\n    @Test\n    void serializesSerializableListenersAndRestoresEventDispatch() {\n        EventListenerSupport<StateListener> support =\n                EventListenerSupport.create(StateListener.class);\n        support.addListener(new RecordingListener());\n\n        EventListenerSupport<StateListener> restored = SerializationUtils.roundtrip(support);\n        restored.fire().stateChanged(\"restored\");\n\n        RecordingListener listener = (RecordingListener) restored.getListeners()[0];\n        assertThat(listener.events).containsExactly(\"restored\");\n    }\n\n    public interface StateListener extends EventListener, Serializable {\n        void stateChanged(String state);\n    }\n\n    public static final class RecordingListener implements StateListener {\n        private final List<String> events = new ArrayList<>();\n\n        @Override\n        public void stateChanged(String state) {\n            events.add(state);\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792099088548}, {"role": "toolResult", "toolCallId": "call_ywIQm5Okf9E3QC34t4HMNaJo|fc_0473f1a7bf29e04a016ad1430ff6a087d19d2419de8be02bb6", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.google.common.collect.ImmutableSetMultimap;\nimport org.apache.pulsar.shade.org.apache.commons.lang3.SerializationUtils;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.Timeout;\n\n@Timeout(55)\npublic class ImmutableSetMultimapTest {\n    @Test\n    void preservesImmutableMappingsAcrossSerialization() {\n        ImmutableSetMultimap<String, Integer> original =\n                ImmutableSetMultimap.<String, Integer>builder()\n                        .put(\"topic-a\", 1)\n                        .put(\"topic-a\", 2)\n                        .put(\"topic-b\", 3)\n                        .build();\n\n        ImmutableSetMultimap<String, Integer> restored =\n                SerializationUtils.roundtrip(original);\n\n        assertThat(restored).isEqualTo(original).isNotSameAs(original);\n        assertThat(restored.get(\"topic-a\")).containsExactlyInAnyOrder(1, 2);\n    }\n}\n"}], "isError": false, "timestamp": 1792099088548}, {"role": "toolResult", "toolCallId": "call_cfXz2fd2beAz0owfrpSfViDu|fc_0473f1a7bf29e04a016ad1430ff6a887d1b47d48854bb172d9", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.Map;\nimport java.util.Objects;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.core.type.TypeReference;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.ObjectMapper;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.Timeout;\n\n@Timeout(55)\npublic class StdKeyDeserializerInnerStringFactoryKeyDeserializerTest {\n    @Test\n    void invokesStringFactoryForJsonPropertyName() throws Exception {\n        ObjectMapper mapper = new ObjectMapper();\n\n        Map<SubscriptionKey, Boolean> values = mapper.readValue(\n                \"{\\\"orders-sub\\\":true}\",\n                new TypeReference<Map<SubscriptionKey, Boolean>>() { });\n\n        assertThat(values).containsEntry(SubscriptionKey.valueOf(\"orders-sub\"), true);\n    }\n\n    public static final class SubscriptionKey {\n        private final String value;\n\n        private SubscriptionKey(String value) {\n            this.value = value;\n        }\n\n        public static SubscriptionKey valueOf(String value) {\n            return new SubscriptionKey(value);\n        }\n\n        @Override\n        public boolean equals(Object other) {\n            return other instanceof SubscriptionKey\n                    && Objects.equals(value, ((SubscriptionKey) other).value);\n        }\n\n        @Override\n        public int hashCode() {\n            return Objects.hash(value);\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792099088548}]}
