[tool-call] delta {"path":"tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/AnnotatedMethodTest.java","content":"/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.ObjectMapper;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.Timeout;\n\n@Timeout(55)\npublic class AnnotatedMethodTest {\n    @Test\n    void mapsBeanFieldsMethodsAndRecordComponents() throws Exception {\n        ObjectMapper mapper = new ObjectMapper();\n        InventoryItem item = new InventoryItem();\n        item.setName(\"ledger\");\n        item.units = 4;\n\n        String itemJson = mapper.writeValueAsString(item);\n        InventoryItem decodedItem = mapper.readValue(itemJson, InventoryItem.class);\n        Shipment decodedShipment = mapper.readValue(\n                mapper.writeValueAsString(new Shipment(\"shipment-9\", 3)), Shipment.class);\n\n        assertThat(itemJson).contains(\"ledger\", \"units\");\n        assertThat(decodedItem.getName()).isEqualTo(\"ledger\");\n        assertThat(decodedItem.units).isEqualTo(4);\n        assertThat(decodedShipment).isEqualTo(new Shipment(\"shipment-9\", 3));\n    }\n\n    public static final class InventoryItem {\n        public int units;\n        private String name;\n\n        public InventoryItem() { }\n\n        public String getName() {\n            return name;\n        }\n\n        public void setName(String name) {\n            this.name = name;\n        }\n    }\n\n    public record Shipment(String id, int units) { }\n}\n"}
[tool-call] end id=call_td1ovkTZS9kyDmTFOWTVE4mb|fc_0672f30ea9308838016ad13c1f7d0c87d1b50538a96c6eb6c1 name=write args={"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/AnnotatedMethodTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.ObjectMapper;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.Timeout;\n\n@Timeout(55)\npublic class AnnotatedMethodTest {\n    @Test\n    void mapsBeanFieldsMethodsAndRecordComponents() throws Exception {\n        ObjectMapper mapper = new ObjectMapper();\n        InventoryItem item = new InventoryItem();\n        item.setName(\"ledger\");\n        item.units = 4;\n\n        String itemJson = mapper.writeValueAsString(item);\n        InventoryItem decodedItem = mapper.readValue(itemJson, InventoryItem.class);\n        Shipment decodedShipment = mapper.readValue(\n                mapper.writeValueAsString(new Shipment(\"shipment-9\", 3)), Shipment.class);\n\n        assertThat(itemJson).contains(\"ledger\", \"units\");\n        assertThat(decodedItem.getName()).isEqualTo(\"ledger\");\n        assertThat(decodedItem.units).isEqualTo(4);\n        assertThat(decodedShipment).isEqualTo(new Shipment(\"shipment-9\", 3));\n    }\n\n    public static final class InventoryItem {\n        public int units;\n        private String name;\n\n        public InventoryItem() { }\n\n        public String getName() {\n            return name;\n        }\n\n        public void setName(String name) {\n            this.name = name;\n        }\n    }\n\n    public record Shipment(String id, int units) { }\n}\n"}
