;\n\n        public TopicSummary() { }\n\n        TopicSummary(String name, int partitions) {\n            this.name = name;\n            this.partitions = partitions;\n        }\n\n        public String getName() {\n            return name;\n        }\n\n        public void setName(String name) {\n            this.name = name;\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_kO8amsdq6NCv8XzAkImE9zMC|fc_0473f1a7bf29e04a016ad14236e56087d18efa9bc4f5c0bd90", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/JacksonFieldPropertyTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.ObjectMapper;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.Timeout;\n\n@Timeout(55)\npublic class JacksonFieldPropertyTest {\n    @Test\n    void updatesPublicFieldsFromJson() throws Exception {\n        ObjectMapper mapper = new ObjectMapper();\n        PartitionState state = new PartitionState();\n        state.owner = \"before\";\n        state.backlog = 1;\n\n        PartitionState updated = mapper.readerForUpdating(state)\n                .readValue(\"{\\\"owner\\\":\\\"broker-a\\\",\\\"backlog\\\":12}\");\n\n        assertThat(updated).isSameAs(state);\n        assertThat(updated.owner).isEqualTo(\"broker-a\");\n        assertThat(updated.backlog).isEqualTo(12);\n    }\n\n    public static final class PartitionState {\n        public String owner;\n        public int backlog;\n    }\n}\n"}}, {"type": "toolCall", "id": "call_zXs9qDl8XLH2anA600ThElZP|fc_0473f1a7bf29e04a016ad14236e56c87d18170ee6a26a7645b", "name": "write", "a