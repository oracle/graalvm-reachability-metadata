hade.com.google.common.util.concurrent.Futures;\nimport org.apache.pulsar.shade.com.google.common.util.concurrent.ListenableFuture;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.Timeout;\n\n@Timeout(55)\npublic class FuturesGetCheckedTest {\n    @Test\n    void convertsFailedFutureToRequestedCheckedException() {\n        IOException failure = new IOException(\"lookup unavailable\");\n        ListenableFuture<String> future = Futures.immediateFailedFuture(failure);\n\n        Throwable thrown = catchThrowable(() -> Futures.getChecked(\n                future, BrokerLookupException.class));\n\n        assertThat(thrown)\n                .isInstanceOf(BrokerLookupException.class)\n                .hasMessageContaining(\"lookup unavailable\")\n                .hasCause(failure);\n    }\n\n    public static final class BrokerLookupException extends Exception {\n        public BrokerLookupException(String message) {\n            super(message);\n        }\n\n        public BrokerLookupException(Throwable cause) {\n            super(cause);\n        }\n    }\n}\n"}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-sol", "usage": {"input": 1453, "output": 7709, "cacheRead": 181376, "cacheWrite": 0, "reasoning": 1086, "totalTokens": 190538, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1792097170287, "responseId": "resp_0672f30ea9308838016ad13b93b6a087d194a2237494aad0ae", "rawStopReason": "completed"}, "toolResults": [{"role": "toolResult", "toolCallId": "call_td1ovkTZS9kyDmTFOWTVE4mb|fc_0672f30ea9308838016ad13c1f7d0c87d1b50538a96c6eb6c1", "toolName": "write", "content": [{"type": "text", "text": "Successfully wrote 1644 bytes to tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/AnnotatedMethodTest.java"}], "isError": false, "timestamp": 1792097311854}, {"role": "toolResult", "toolCallId": "call_K7lGq