6996666}, {"role": "toolResult", "toolCallId": "call_D5q2Ik1mQHqfWkmgjRN8iLI5|fc_0672f30ea9308838016ad13ae4640887d1a193c1fe8cfb6ae3", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.io.IOException;\nimport java.net.InetSocketAddress;\nimport java.net.Socket;\nimport java.time.Duration;\nimport java.util.concurrent.Callable;\nimport java.util.concurrent.TimeUnit;\nimport org.apache.pulsar.client.api.CompressionType;\nimport org.apache.pulsar.client.api.Consumer;\nimport org.apache.pulsar.client.api.Message;\nimport org.apache.pulsar.client.api.MessageId;\nimport org.apache.pulsar.client.api.Producer;\nimport org.apache.pulsar.client.api.PulsarClient;\nimport org.apache.pulsar.client.api.Schema;\nimport org.apache.pulsar.client.api.SubscriptionInitialPosition;\nimport org.apache.pulsar.common.schema.SchemaInfo;\nimport org.apache.pulsar.common.schema.SchemaType;\nimport org.junit.jupiter.api.AfterAll;\nimport org.junit.jupiter.api.BeforeAll;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.TestInstance;\nimport org.junit.jupiter.api.Timeout;\n\n@TestInstance(TestInstance.Lifecycle.PER_CLASS)\n@Timeout(55)\npublic class PulsarClientAllTest {\n    private static final String BROKER_HOST = \"127.0.0.1\";\n    private static final int BROKER_PORT = 6650;\n    private static final String BROKER_URL = \"pulsar://\" + BROKER_HOST + \":\" + BROKER_PORT;\n    private static final String CONTAINER_NAME = \"graalvm-pulsar-client-all-test\";\n    private static final String IMAGE = \"apachepulsar/pulsar:4.2.5\";\n    private static final Duration PROCESS_TIMEOUT = Duration.ofSeconds(20);\n    private static final Duration READINESS_TIMEOUT = Duration.ofSeconds(50);\n    private static final int OPERATION_TIMEOUT_SECONDS = 15;\n\n    private PulsarClient client;\n\n    @BeforeAll\n    void startPulsar() throws Exception {\n        removeExistingContainer();\n        try {\n            runDocker(\n                    true,\n                    \"run\",\n                    \"--detach\",\n                    \"--rm\",\n                    \"--name\",\n                    CONTAINER_NAME,\n                    \"-p\",\n                    \"6650:6650\",\n                    \"-p\",\n                    \"8080:8080\",\n                    IMAGE,\n                    \"bin/pulsar\",\n                    \"standalone\",\n                    \"--no-functions-worker\",\n                    \"--no-stream-storage\");\n            waitUntil(PulsarClientAllTest::brokerIsReady, READINESS_TIMEOUT);\n\n            client = PulsarClient.builder()\n                    .serviceUrl(BROKER_URL)\n                    .connectionTimeout(10, TimeUnit.SECONDS)\n                    .operationTimeout(OPERATION_TIMEOUT_SECONDS, TimeUnit.SECONDS)\n                    .lookupTimeout(OPERATION_TIMEOUT_SECONDS, TimeUnit.SECONDS)\n                    .build();\n            waitUntil(\n                    () ->\n                            client.getPartitionsForTopic(topic(\"readiness\"))\n                                            .get(OPERATION_TIMEOUT_SECONDS, TimeUnit.SECONDS)\n                                    != null,\n                    READINESS_TIMEOUT);\n        } catch (Exception e) {\n            runDocker(false, \"logs\", CONTAINER_NAME);\n            removeExistingContainer();\n            throw e;\n        }\n    }\n\n    @AfterAll\n    void stopPulsar() throws Exception {\n        try {\n            if (client != null) {\n                client.close();\n            }\n        } finally {\n            removeExistingContainer();\n        }\n    }\n\n    @Test\n    void publishesAndAcknowledgesStringMessage() throws Exception {\n        String topic = topic(\"strings\");\n        String subscription = \"string-subscription\";\n        try (Consumer<String> consumer = client.newConsumer(Schema.STRING)\n                        .topic(topic)\n                        .subscriptionName(subscription)\n                        .subscriptionInitialPosition(SubscriptionInitialPosition.Earliest)\n                        .subscribe();\n                Producer<String> producer = client.newProducer(Schema.STRING)\n                        .topic(topic)\n                        .producerName(\"string-producer\")\n                        .sendTimeout(OPERATION_TIMEOUT_SECONDS, TimeUnit.SECONDS)\n                        .compressionType(CompressionType.LZ4)\n                        .create()) {\n            MessageId sentId = producer.newMessage()\n                    .key(\"order-7\")\n                    .property(\"source\", \"integration-test\")\n                    .eventTime(123456789L)\n                    .value(\"pulsar-message\")\n                    .sendAsync()\n                    .get(OPERATION_TIMEOUT_SECONDS, TimeUnit.SECONDS);\n            Message<String> received =\n                    consumer.receive(OPERATION_TIMEOUT_SECONDS, TimeUnit.SECONDS);\n\n            assertThat(sentId).isNotNull();\n            assertThat(received).isNotNull();\n            assertThat(received.getValue()).isEqualTo(\"pulsar-message\");\n            assertThat(received.getKey()).isEqualTo(\"order-7\");\n            assertThat(received.getProperty(\"source\")).isEqualTo(\"integration-test\");\n            assertThat(received.getEventTime()).isEqualTo(123456789L);\n            assertThat(received.getTopicName()).isEqualTo(topic);\n\n            consumer.acknowledge(received);\n            assertThat(consumer.isConnected()).isTrue();\n            assertThat(producer.isConnected()).isTrue();\n        }\n    }\n\n    @Test\n    void exchangesJsonMessageWithCompressionAndRegisteredSchema() throws Exception {\n        String topic = topic(\"json\");\n        Schema<PurchaseOrder> schema = Schema.JSON(PurchaseOrder.class);\n        try (Consumer<PurchaseOrder> consumer = client.newConsumer(schema)\n                        .topic(topic)\n                        .subscriptionName(\"json-subscription\")\n                        .subscriptionInitialPosition(SubscriptionInitialPosition.Earliest)\n                        .subscribe();\n                Producer<PurchaseOrder> producer = client.newProducer(schema)\n                        .topic(topic)\n                        .producerName(\"json-producer\")\n                        .sendTimeout(OPERATION_TIMEOUT_SECONDS, TimeUnit.SECONDS)\n                        .compressionType(CompressionType.ZSTD)\n                        .enableBatching(false)\n                        .create()) {\n            PurchaseOrder order = new PurchaseOrder(\"purchase-42\", 3);\n            producer.send(order);\n\n            Message<PurchaseOrder> received =\n                    consumer.receive(OPERATION_TIMEOUT_SECONDS, TimeUnit.SECONDS);\n            SchemaInfo schemaInfo = schema.getSchemaInfo();\n\n            assertThat(received).isNotNull();\n            assertThat(received.getValue().getOrderId()).isEqualTo(\"purchase-42\");\n            assertThat(received.getValue().getUnits()).isEqualTo(3);\n            assertThat(schemaInfo.getType()).isEqualTo(SchemaType.JSON);\n            assertThat(schemaInfo.getSchemaDefinition()).contains(\"orderId\", \"units\");\n\n            consumer.acknowledge(received);\n        }\n    }\n\n    private static String topic(String suffix) {\n        return \"persistent://public/default/graalvm-client-all-\" + suffix;\n    }\n\n    private static boolean brokerIsReady() throws IOException {\n        try (Socket socket = new Socket()) {\n            socket.connect(new InetSocketAddress(BROKER_HOST, BROKER_PORT), 10_000);\n            return true;\n        }\n    }\n\n    private static void waitUntil(Callable<Boolean> condition, Duration timeout)\n            throws Exception {\n        Exception lastException = null;\n        long deadline = System.nanoTime() + timeout.toNanos();\n        while (System.nanoTime() < deadline) {\n            try {\n                if (condition.call()) {\n                    return;\n                }\n            } catch (Exception e) {\n                lastException = e;\n            }\n            try {\n                Thread.sleep(1_000L);\n            } catch (InterruptedException e) {\n                Thread.currentThread().interrupt();\n                throw new IllegalStateException(\"Interrupted while waiting for Pulsar\", e);\n            }\n        }\n        String message = \"Pulsar did not become ready within \" + timeout;\n        throw lastException == null\n                ? new IllegalStateException(message)\n                : new IllegalStateException(message, lastException);\n    }\n\n    private static void removeExistingContainer() throws Exception {\n        runDocker(false, \"rm\", \"--force\", CONTAINER_NAME);\n    }\n\n    private static void runDocker(boolean requireSuccess, String... arguments)\n            throws Exception {\n        String[] command = new String[arguments.length + 1];\n        command[0] = \"docker\";\n        System.arraycopy(arguments, 0, command, 1, arguments.length);\n        Process process = new ProcessBuilder(command).inheritIO().start();\n        if (!process.waitFor(PROCESS_TIMEOUT.toMillis(), TimeUnit.MILLISECONDS)) {\n            process.destroyForcibly();\n            process.waitFor(10, TimeUnit.SECONDS);\n            throw new IllegalStateException(\n                    \"Docker command timed out: \" + String.join(\" \", command));\n        }\n        if (requireSuccess && process.exitValue() != 0) {\n            throw new IllegalStateException(\n                    \"Docker command failed with exit code \"\n                            + process.exitValue()\n                            + \": \"\n                            + String.join(\" \", command));\n        }\n    }\n\n    public static final class PurchaseOrder {\n        private String orderId;\n        private int units;\n\n        public PurchaseOrder() { }\n\n        public PurchaseOrder(String orderId, int units) {\n            this.orderId = orderId;\n            this.units = units;\n        }\n\n        public String getOrderId() {\n            return orderId;\n        }\n\n        public void setOrderId(String orderId) {\n            this.orderId = orderId;\n        }\n\n        public int getUnits() {\n            return units;\n        }\n\n        public void setUnits(int units) {\n            this.units = units;\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792096996666}, {"role": "toolResult", "toolCallId": "call_slqea6HPvilDZPwvtxMzERrJ|fc_0672f30ea9308838016ad13ae4641487d1972e002e6ba92491", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.time.Instant;\nimport org.apache.pulsar.client.api.Schema;\nimport org.apache.pulsar.client.api.schema.SchemaDefinition;\nimport org.apache.pulsar.common.schema.SchemaType;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.Timeout;\n\n@Timeout(55)\npublic class AvroSchemaTest {\n    @Test\n    void roundTripsPojoWithJsr310AvroSchema() {\n        SchemaDefinition<AuditEvent> definition = SchemaDefinition.<AuditEvent>builder()\n                .withPojo(AuditEvent.class)\n                .withAlwaysAllowNull(false)\n                .withJSR310ConversionEnabled(true)\n                .addProperty(\"domain\", \"audit\")\n                .build();\n        Schema<AuditEvent> schema = Schema.AVRO(definition);\n        AuditEvent event = new AuditEvent(\n                \"event-17\", Instant.parse(\"2025-01-15T10:15:30.123Z\"), 4);\n\n        byte[] encoded = schema.encode(event);\n        AuditEvent decoded = schema.decode(encoded);\n\n        assertThat(encoded).isNotEmpty();\n        assertThat(schema.getSchemaInfo().getType()).isEqualTo(SchemaType.AVRO);\n        assertThat(schema.getSchemaInfo().getProperties()).containsEntry(\"domain\", \"audit\");\n        assertThat(decoded.getEventId()).isEqualTo(event.getEventId());\n        assertThat(decoded.getOccurredAt()).isEqualTo(event.getOccurredAt());\n        assertThat(decoded.getSeverity()).isEqualTo(event.getSeverity());\n    }\n\n    public static final class AuditEvent {\n        private String eventId;\n        private Instant occurredAt;\n        private int severity;\n\n        public AuditEvent() { }\n\n        public AuditEvent(String eventId, Instant occurredAt, int severity) {\n            this.eventId = eventId;\n            this.occurredAt = occurredAt;\n            this.severity = severity;\n        }\n\n        public String getEventId() {\n            return eventId;\n        }\n\n        public void setEventId(String eventId) {\n            this.eventId = eventId;\n        }\n\n        public Instant getOccurredAt() {\n            return occurredAt;\n        }\n\n        public void setOccurredAt(Instant occurredAt) {\n            this.occurredAt = occurredAt;\n        }\n\n        public int getSeverity() {\n            return severity;\n        }\n\n        public void setSeverity(int severity) {\n            this.severity = severity;\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792096996666}, {"role": "toolResult", "toolCallId": "call_6kVOkzRTY3y7O8yiGdScZXVs|fc_0672f30ea9308838016ad13ae4642487d183b8d8e499db95a2", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.io.IOException;\nimport org.apache.pulsar.shade.org.apache.avro.Protocol;\nimport org.apache.pulsar.shade.org.apache.avro.Schema;\nimport org.apache.pulsar.shade.org.apache.avro.io.Decoder;\nimport org.apache.pulsar.shade.org.apache.avro.io.Encoder;\nimport org.apache.avro.reflect.AvroEncode;\nimport org.apache.pulsar.shade.org.apache.avro.reflect.CustomEncoding;\nimport org.apache.pulsar.shade.org.apache.avro.reflect.ReflectData;\nimport org.apache.pulsar.shade.org.apache.avro.util.ClassSecurityValidator;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.Timeout;\n\n@Timeout(55)\npublic class ReflectDataTest {\n    @Test\n    void derivesDefaultsArraysProtocolsAndCustomEncodings() {\n        ClassSecurityValidator.ClassSecurityPredicate previousValidator =\n                ClassSecurityValidator.getGlobal();\n        ClassSecurityValidator.setGlobal(ClassSecurityValidator.composite(\n                previousValidator,\n                ClassSecurityValidator.builder().add(EncodedValue.class).build()));\n        try {\n            ReflectData reflectData = new ReflectData().setDefaultsGenerated(true);\n\n            Schema defaultsSchema = reflectData.getSchema(DefaultValues.class);\n            Schema arraySchema = reflectData.getSchema(String[].class);\n            Protocol protocol = reflectData.getProtocol(GreetingService.class);\n            Schema encodedSchema = reflectData.getSchema(EncodedValue.class);\n            Schema containerSchema = reflectData.getSchema(EncodedContainer.class);\n\n            assertThat(defaultsSchema.getField(\"state\").defaultVal()).isEqualTo(\"ready\");\n            assertThat(reflectData.getClass(arraySchema)).isEqualTo(String[].class);\n            assertThat(protocol.getMessages()).containsKey(\"greet\");\n            assertThat(encodedSchema.getType()).isEqualTo(Schema.Type.STRING);\n            assertThat(reflectData.getCustomEncoding(encodedSchema))\n                    .isInstanceOf(EncodedValueEncoding.class);\n            assertThat(containerSchema.getField(\"value\").schema().getType())\n                    .isEqualTo(Schema.Type.STRING);\n        } finally {\n            ClassSecurityValidator.setGlobal(previousValidator);\n        }\n    }\n\n    public interface GreetingService {\n        String greet(String name);\n    }\n\n    public static final class DefaultValues {\n        public String state = \"ready\";\n\n        public DefaultValues() { }\n    }\n\n    @AvroEncode(using = EncodedValueEncoding.class)\n    public static final class EncodedValue {\n        private final String value;\n\n        public EncodedValue(String value) {\n            this.value = value;\n        }\n    }\n\n    public static final class EncodedContainer {\n        @AvroEncode(using = EncodedValueEncoding.class)\n        public EncodedValue value;\n\n        public EncodedContainer() { }\n    }\n\n    public static final class EncodedValueEncoding extends CustomEncoding<EncodedValue> {\n        public EncodedValueEncoding() {\n            schema = Schema.create(Schema.Type.STRING);\n            schema.addProp(\"java-class\", EncodedValue.class.getName());\n        }\n\n        @Override\n        protected void write(Object datum, Encoder out) throws IOException {\n            out.writeString(((EncodedValue) datum).value);\n        }\n\n        @Override\n        protected EncodedValue read(Object reuse, Decoder in) throws IOException {\n            return new EncodedValue(in.readString());\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792096996666}, {"role": "toolResult", "toolCallId": "call_Z6PNOC6v5BOmrM9Y85XcU1ez|fc_0672f30ea9308838016ad13ae4643087d19fccf7ed442010d9", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.client.api.Authentication;\nimport org.apache.pulsar.client.api.AuthenticationDataProvider;\nimport org.apache.pulsar.client.api.AuthenticationFactory;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.Timeout;\n\n@Timeout(55)\npublic class AuthenticationUtilTest {\n    private static final String TOKEN_PLUGIN_CLASS =\n            \"org.apache.pulsar.client.impl.auth.AuthenticationToken\";\n\n    @Test\n    void createsAndConfiguresTokenAuthenticationPlugin() throws Exception {\n        String token = \"spring-pulsar-token\";\n\n        try (Authentication authentication =\n                AuthenticationFactory.create(TOKEN_PLUGIN_CLASS, token)) {\n            authentication.start();\n            AuthenticationDataProvider authenticationData = authentication.getAuthData();\n\n            assertThat(authentication.getAuthMethodName()).isEqualTo(\"token\");\n            assertThat(authenticationData.hasDataFromCommand()).isTrue();\n            assertThat(authenticationData.getCommandData()).isEqualTo(token);\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792096996667}, {"role": "toolResult", "toolCallId": "call_b4CdieMR4cHRSSlni37UCbUA|fc_0672f30ea9308838016ad13ae4643887d18e0ab4cb2b425039", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.lang.reflect.Field;\nimport java.util.List;\nimport org.apache.pulsar.common.util.Reflections;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.Timeout;\n\n@Timeout(55)\npublic class ReflectionsTest {\n    @Test\n    void createsObjectsAndResolvesClassesThroughTheUtilityApi() throws Exception {\n        ClassLoader classLoader = getClass().getClassLoader();\n\n        Named named = Reflections.createInstance(\n                DefaultNamed.class.getName(), Named.class, classLoader);\n        Object marker = Reflections.createInstance(DefaultMarker.class.getName(), classLoader);\n        Prefix prefix = (Prefix) Reflections.createInstance(\n                Prefix.class.getName(),\n                classLoader,\n                new Object[] {\"pulsar\"},\n                new Class<?>[] {String.class});\n\n        assertThat(named.name()).isEqualTo(\"default\");\n        assertThat(marker).isInstanceOf(DefaultMarker.class);\n        assertThat(prefix.value()).isEqualTo(\"pulsar\");\n        assertThat(Reflections.classExists(DefaultNamed.class.getName())).isTrue();\n        assertThat(Reflections.classImplementsIface(DefaultNamed.class.getName(), Named.class))\n                .isTrue();\n        assertThat(Reflections.loadClass(\"java.lang.String\", classLoader))\n                .isEqualTo(String.class);\n        assertThat(Reflections.loadClass(\"Ljava.lang.String;\", classLoader))\n                .isEqualTo(String.class);\n        assertThat(Reflections.loadClass(\"[[Ljava.lang.String;\", classLoader))\n                .isEqualTo(String[][].class);\n\n        List<Field> fields = Reflections.getAllFields(ChildFields.class);\n        assertThat(fields).extracting(Field::getName).contains(\"parent\", \"child\");\n    }\n\n    public interface Named {\n        String name();\n    }\n\n    public static final class DefaultNamed implements Named {\n        public DefaultNamed() { }\n\n        @Override\n        public String name() {\n            return \"default\";\n  