\n    @Test\n    void comparesHashesAndFormatsAnnotationMembers() {\n        Service first = FirstService.class.getAnnotation(Service.class);\n        Service second = SecondService.class.getAnnotation(Service.class);\n\n        assertThat(AnnotationUtils.equals(first, second)).isTrue();\n        assertThat(AnnotationUtils.hashCode(first)).isEqualTo(AnnotationUtils.hashCode(second));\n        assertThat(AnnotationUtils.toString(first))\n                .contains(\"name=pulsar\", \"ports={6650,8080}\");\n    }\n\n    @Retention(RetentionPolicy.RUNTIME)\n    public @interface Service {\n        String name();\n\n        int[] ports();\n    }\n\n    @Service(name = \"pulsar\", ports = {6650, 8080})\n    public static final class FirstService { }\n\n    @Service(name = \"pulsar\", ports = {6650, 8080})\n    public static final class SecondService { }\n}\n"}}, {"type": "toolCall", "id": "call_VsLWEBvqXd1fFT6hezB9nKJS|fc_0ccf643e9a94802d016ad136498ed087d19071e0d9d8466b45", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/FieldUtilsTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.lang.reflect.Field;\nimport org.apache.pulsar.shade.org.apache.commons.lang3.reflect.FieldUtils;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.Timeout;\n\n@Timeout(55)\npublic class FieldUtilsTest {\n    @Test\n    void discoversReadsAndWritesInheritedAndDeclaredFields() throws Exception {\n        ChildFields target = new ChildFields();\n\n        Field hidden = FieldUtils.getDeclaredField(ChildFields.class, \"hidden\", true);\n        Field inherited = FieldUtils.getField(ChildFields.class, \"inherited\");\n        Field interfaceField = FieldUtils.getField(ChildFields.class, \"CATEGORY\");\n        FieldUtils.writeField(target, \"hidden\", \"updated\", true);\n\n        assertThat(FieldUtils.getAllFieldsList(ChildFields.class))\n                .extracting(Field::getName)\n                .contains(\"hidden\", \"inherited\");\n        assertThat(hidden).isNotNull();\n        assertThat(inherited).isNotNull();\n        assertThat(interfaceField).isNotNull();\n        assertThat(FieldUtils.readField(target, \"hidden\", true)).isEqualTo(\"updated\");\n        assertThat(FieldUtils.readField(inherited, target)).isEqualTo(\"parent\");\n        assertThat(FieldUtils.readStaticField(interfaceField)).isEqualTo(\"pulsar\");\n    }\n\n    public interface Categorized {\n        String CATEGORY = \"pulsar\";\n    }\n\n    public static class ParentFields {\n        public String inherited = \"parent\";\n    }\n\n    public static final class ChildFields extends ParentFields implements Categorized {\n        private String hidden = \"initial\";\n    }\n}\n"}}, {"type": "toolCall", "id": "call_39Xaw1qIjyUSHY4daaWehkBT|fc_0ccf643e9a94802d016ad136498ee487d1b94c547dc0c22b0d", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ConstructorUtilsTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.org.apache.commons.lang3.reflect.ConstructorUtils;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.Timeout;\n\n@Timeout(55)\npublic class ConstructorUtilsTest {\n    @Test\n    void selectsExactAndAssignmentCompatibleConstructors() throws Exception {\n        Constructed exact =\n                ConstructorUtils.invokeExactConstructor(Constructed.class, \"exact\");\n        Constructed compatible =\n                ConstructorUtils.invokeConstructor(Constructed.class, Integer.valueOf(7));\n\n        assertThat(exact.value()).isEqualTo(\"exact\");\n        assertThat(compatible.value()).isEqualTo(\"number:7\");\n        assertThat(ConstructorUtils.getAccessibleConstructor(Constructed.class, String.class))\n                .isNotNull();\n        assertThat(ConstructorUtils.getMatchingAccessibleConstructor(\n                        Constructed.class, Integer.class))\n                .isNotNull();\n    }\n\n    public static final class Constructed {\n        private final String value;\n\n        public Constructed(String value) {\n            this.value = value;\n        }\n\n        public Constructed(Number value) {\n            this.value = \"number:\" + value;\n        }\n\n        public String value() {\n            return value;\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_DLn1pv5K67rDQ9WZ5KnrqGYc|fc_0ccf643e9a94802d016ad136498ef487d1b9624091dc7156fd", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/TopicCompactionStrategyTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.client.api.Schema;\nimport org.apache.pulsar.common.topics.TopicCompactionStrategy;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.Timeout;\n\n@Timeout(55)\npublic class TopicCompactionStrategyTest {\n    @Test\n    void loadsAndCachesConfiguredCompactionStrategy() {\n        String tag = \"coverage-strategy\";\n        TopicCompactionStrategy<?> loaded =\n                TopicCompactionStrategy.load(tag, KeepLongestStrategy.class.getName());\n\n        assertThat(loaded).isInstanceOf(KeepLongestStrategy.class);\n        assertThat(TopicCompactionStrategy.getInstance(tag)).isSameAs(loaded);\n        assertThat(((KeepLongestStrategy) loaded).shouldKeepLeft(\"longer\", \"short\"))\n                .isTrue();\n        assertThat(loaded.getSchema()).isSameAs(Schema.STRING);\n    }\n\n    public static final class KeepLongestStrategy implements TopicCompactionStrategy<String> {\n        public KeepLongestStrategy() { }\n\n        @Override\n        public Schema<String> getSchema() {\n            return Schema.STRING;\n        }\n\n        @Override\n        public boolean shouldKeepLeft(String previous, String current) {\n            return previous.length() >= current.length();\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_wMpznX1yW5bpt17yVuYODLCR|fc_0ccf643e9a94802d016ad136498efc87d1b5bfb797a71a3ac3", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/BrokerEntryMetadataUtilsTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.Set;\nimport org.apache.pulsar.common.api.proto.BrokerEntryMetadata;\nimport org.apache.pulsar.common.intercept.BrokerEntryMetadataInterceptor;\nimport org.apache.pulsar.common.intercept.BrokerEntryMetadataUtils;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.Timeout;\n\n@Timeout(55)\npublic class BrokerEntryMetadataUtilsTest {\n    @Test\n    void loadsTypedAndGenericInterceptorsByConfiguredClassName() {\n        ClassLoader classLoader = getClass().getClassLoader();\n        Set<BrokerEntryMetadataInterceptor> brokerInterceptors =\n                BrokerEntryMetadataUtils.loadBrokerEntryMetadataInterceptors(\n                        Set.of(CountingInterceptor.class.getName()), classLoader);\n        Set<GenericInterceptor> genericInterceptors = BrokerEntryMetadataUtils.loadInterceptors(\n                Set.of(GenericInterceptor.class.getName()), classLoader);\n\n        BrokerEntryMetadata metadata = new BrokerEntryMetadata();\n        BrokerEntryMetadata updated = brokerInterceptors.iterator().next()\n                .interceptWithNumberOfMessages(metadata, 5);\n\n        assertThat(updated).isSameAs(metadata);\n        assertThat(updated.getNumMessagesInBatch()).isEqualTo(5);\n        assertThat(genericInterceptors)\n                .singleElement()\n                .extracting(GenericInterceptor::name)\n                .isEqualTo(\"generic\");\n    }\n\n    public static final class CountingInterceptor implements BrokerEntryMetadataInterceptor {\n        public CountingInterceptor() { }\n\n        @Override\n        public BrokerEntryMetadata intercept(BrokerEntryMetadata brokerMetadata) {\n            return brokerMetadata;\n        }\n\n        @Override\n        public BrokerEntryMetadata interceptWithNumberOfMessages(\n                BrokerEntryMetadata brokerMetadata, int numberOfMessages) {\n            brokerMetadata.setNumMessagesInBatch(numberOfMessages);\n            return brokerMetadata;\n        }\n    }\n\n    public static final class GenericInterceptor {\n        public GenericInterceptor() { }\n\n        public String name() {\n            return \"generic\";\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_SxqELKNBoHtyjUxb1sQBQyDb|fc_0ccf643e9a94802d016ad136498f0887d18926b83ecd8c8375", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/PulsarURLStreamHandlerFactoryTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.io.InputStream;\nimport java.net.URL;\nimport java.net.URLConnection;\nimport java.net.URLStreamHandler;\nimport java.nio.charset.StandardCharsets;\nimport org.apache.pulsar.client.api.url.PulsarURLStreamHandlerFactory;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.Timeout;\n\n@Timeout(55)\npublic class PulsarURLStreamHandlerFactoryTest {\n    @Test\n    void createsADataHandlerThatDecodesInlineContent() throws Exception {\n        PulsarURLStreamHandlerFactory factory = new PulsarURLStreamHandlerFactory();\n        URLStreamHandler handler = factory.createURLStreamHandler(\"data\");\n        URL url = new URL(null, \"data:text/plain;base64,cHVsc2Fy\", handler);\n        URLConnection connection = url.openConnection();\n\n        byte[] content;\n        try (InputStream input = connection.getInputStream()) {\n            content = input.readAllBytes();\n        }\n\n        assertThat(handler).isNotNull();\n        assertThat(connection.getContentType()).isEqualTo(\"text/plain\");\n        assertThat(new String(content, StandardCharsets.UTF_8)).isEqualTo(\"pulsar\");\n        assertThat(factory.createURLStreamHandler(\"unknown\")).isNull();\n    }\n}\n"}}, {"type": "toolCall", "id": "call_tjAcfyKxvIDohZ6t6hR57YO5|fc_0ccf643e9a94802d016ad136498f1087d19e036b20420dfe92", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/JvmMetricsTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <htt