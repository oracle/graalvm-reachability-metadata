      @SuppressWarnings("unchecked")
      @Override
      public boolean equals(final Object obj) {
        if (this == obj) { return true; }
        if (obj == null) { return false; }
        if ( !(obj instanceof Row)) { return false; }
        final Row<T> that = (Row<T>) obj;
        if (est != that.est) { return false; }
