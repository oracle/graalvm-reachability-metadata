[tool-exec] start id=call_sCxMASq4ORzC6CuZNFfIhCBO|fc_0ccf643e9a94802d016ad135fdc5d887d1bdc4462f986951dd name=write args={"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/MethodUtilsTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.lang.annotation.Retention;\nimport java.lang.annotation.RetentionPolicy;\nimport java.lang.reflect.Method;\nimport java.util.List;\nimport org.apache.pulsar.shade.org.apache.commons.lang3.reflect.MethodUtils;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.Timeout;\n\n@Timeout(55)\npublic class MethodUtilsTest {\n    @Test\n    void invokesExactCompatiblePrivateInterfaceAndVarargsMethods() throws Exception {\n        Operations operations = new Operations();\n\n        assertThat(MethodUtils.invokeExactMethod(operations, \"echo\", \"client\"))\n                .isEqualTo(\"client\");\n        assertThat(MethodUtils.invokeExactStaticMethod(\n                        Operations.class, \"identity\", \"static\"))\n                .isEqualTo(\"static\");\n        assertThat(MethodUtils.invokeMethod(operations, \"describe\", Integer.valueOf(4)))\n                .isEqualTo(\"number:4\");\n        assertThat(MethodUtils.invokeMethod(operations, true, \"hidden\", \"metadata\"))\n                .isEqualTo(\"hidden:metadata\");\n        assertThat(MethodUtils.invokeMethod(new GreetingImpl(), \"greet\", \"Pulsar\"))\n                .isEqualTo(\"Hello Pulsar\");\n        assertThat(MethodUtils.invokeStaticMethod(Operations.class, \"sum\", 1, 2, 3))\n                .isEqualTo(6);\n\n        assertThat(MethodUtils.getMethodObject(Operations.class, \"echo\", String.class))\n                .isNotNull();\n        assertThat(MethodUtils.getMatchingMethod(Operations.class, \"describe\", Integer.class))\n                .isNotNull();\n\n        List<Method> declared = MethodUtils.getMethodsListWithAnnotation(\n                Operations.class, Exercised.class, false, true);\n        List<Method> accessible = MethodUtils.getMethodsListWithAnnotation(\n                Operations.class, Exercised.class, false, false);\n        assertThat(declared).extracting(Method::getName).contains(\"echo\", \"hidden\");\n        assertThat(accessible).extracting(Method::getName).contains(\"echo\");\n    }\n\n    @Retention(RetentionPolicy.RUNTIME)\n    public @interface Exercised { }\n\n    public interface Greeting {\n        String greet(String name);\n    }\n\n    private static final class GreetingImpl implements Greeting {\n        @Override\n        public String greet(String name) {\n            return \"Hello \" + name;\n        }\n    }\n\n    public static final class Operations {\n        @Exercised\n        public String echo(String value) {\n            return value;\n        }\n\n        public String describe(Number value) {\n            return \"number:\" + value;\n        }\n\n        @Exercised\n        private String hidden(String value) {\n            return \"hidden:\" + value;\n        }\n\n        public static String identity(String value) {\n            return value;\n        }\n\n        public static int sum(int... values) {\n            int result = 0;\n            for (int value : values) {\n                result += value;\n            }\n            return result;\n        }\n    }\n}\n"}
[tool-exec] start id=call_c8PDXNqwOIND1gLup0J7dNhN|fc_0ccf643e9a94802d016ad135fdc5e087d1be3ab5b804687db0 name=write args={"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ReflectDataTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.io.IOException;\nimport org.apache.pulsar.shade.org.apache.avro.Protocol;\nimport org.apache.pulsar.shade.org.apache.avro.Schema;\nimport org.apache.pulsar.shade.org.apache.avro.io.Decoder;\nimport org.apache.pulsar.shade.org.apache.avro.io.Encoder;\nimport org.apache.pulsar.shade.org.apache.avro.reflect.AvroEncode;\nimport org.apache.pulsar.shade.org.apache.avro.reflect.CustomEncoding;\nimport org.apache.pulsar.shade.org.apache.avro.reflect.ReflectData;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.Timeout;\n\n@Timeout(55)\npublic class ReflectDataTest {\n    @Test\n    void derivesDefaultsArraysProtocolsAndCustomEncodings() {\n        ReflectData reflectData = new ReflectData().setDefaultsGenerated(true);\n\n        Schema defaultsSchema = reflectData.getSchema(DefaultValues.class);\n        Schema arraySchema = reflectData.getSchema(String[].class);\n        Protocol protocol = reflectData.getProtocol(GreetingService.class);\n        Schema encodedSchema = reflectData.getSchema(EncodedValue.class);\n        Schema containerSchema = reflectData.getSchema(EncodedContainer.class);\n\n        assertThat(defaultsSchema.getField(\"state\").defaultVal()).isEqualTo(\"ready\");\n        assertThat(reflectData.getClass(arraySchema)).isEqualTo(String[].class);\n        assertThat(protocol.getMessages()).containsKey(\"greet\");\n        assertThat(encodedSchema.getType()).isEqualTo(Schema.Type.STRING);\n        assertThat(reflectData.getCustomEncoding(encodedSchema))\n                .isInstanceOf(EncodedValueEncoding.class);\n        assertThat(containerSchema.getField(\"value\").schema().getType())\n                .isEqualTo(Schema.Type.STRING);\n    }\n\n    public interface GreetingService {\n        String greet(String name);\n    }\n\n    public static final class DefaultValues {\n        public String state = \"ready\";\n\n        public DefaultValues() { }\n    }\n\n    @AvroEncode(using = EncodedValueEncoding.class)\n    public static final class EncodedValue {\n        private final String value;\n\n        public EncodedValue(String value) {\n            this.value = value;\n        }\n    }\n\n    public static final class EncodedContainer {\n        @AvroEncode(using = EncodedValueEncoding.class)\n        public EncodedValue value;\n\n        public EncodedContainer() { }\n    }\n\n    public static final class EncodedValueEncoding extends CustomEncoding<EncodedValue> {\n        public EncodedValueEncoding() {\n            schema = Schema.create(Schema.Type.STRING);\n            schema.addProp(\"java-class\", EncodedValue.class.getName());\n        }\n\n        @Override\n        protected void write(Object datum, Encoder out) throws IOException {\n            out.writeString(((EncodedValue) datum).value);\n        }\n\n        @Override\n        protected EncodedValue read(Object reuse, Decoder in) throws IOException {\n            return new EncodedValue(in.readString());\n        }\n    }\n}\n"}
[tool-exec] start id=call_aMcWZcVzP3vItP2xXcaD2YqG|fc_0ccf643e9a94802d016ad135fdc64887d1ac45e8c084762797 name=write args={"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/OffloadPoliciesImplTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.Properties;\nimport org.apache.pulsar.common.policies.data.OffloadPoliciesImpl;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.Timeout;\n\n@Timeout(55)\npublic class OffloadPoliciesImplTest {\n    @Test\n    void createsExportsAndMergesOffloadConfiguration() {\n        Properties source = new Properties();\n        source.setProperty(\"managedLedgerOffloadDriver\", \"S3\");\n        source.setProperty(\"s3ManagedLedgerOffloadRegion\", \"us-test-1\");\n        source.setProperty(\"s3ManagedLedgerOffloadBucket\", \"archive\");\n        source.setProperty(\"managedLedgerOffloadThresholdInBytes\", \"4096\");\n        source.setProperty(\"managedLedgerOffloadExtraConfigStorageClass\", \"cold\");\n\n        OffloadPoliciesImpl created = OffloadPoliciesImpl.create(source);\n        Properties exported = created.toProperties();\n\n        assertThat(created.isS3Driver()).isTrue();\n        assertThat(created.bucketValid()).isTrue();\n        assertThat(created.getManagedLedgerOffloadThresholdInBytes()).isEqualTo(4096L);\n        assertThat(exported)\n                .containsEntry(\"managedLedgerOffloadDriver\", \"S3\")\n                .containsEntry(\"s3ManagedLedgerOffloadRegion\", \"us-test-1\")\n                .containsEntry(\"managedLedgerOffloadExtraConfigStorageClass\", \"cold\");\n\n        OffloadPoliciesImpl topic = OffloadPoliciesImpl.builder()\n                .managedLedgerOffloadThresholdInSeconds(30L)\n                .build();\n        OffloadPoliciesImpl namespace = OffloadPoliciesImpl.builder()\n                .managedLedgerOffloadDriver(\"filesystem\")\n                .fileSystemURI(\"file:///archive\")\n                .build();\n        Properties broker = new Properties();\n        broker.setProperty(\"managedLedgerOffloadMaxThreads\", \"7\");\n\n        OffloadPoliciesImpl merged =\n                OffloadPoliciesImpl.mergeConfiguration(topic, namespace, broker);\n        assertThat(merged).isNotNull();\n        assertThat(merged.getManagedLedgerOffloadThresholdInSeconds()).isEqualTo(30L);\n        assertThat(merged.getManagedLedgerOffloadDriver()).isEqualTo(\"filesystem\");\n        assertThat(merged.getFileSystemURI()).isEqualTo(\"file:///archive\");\n        assertThat(merged.getManagedLedgerOffloadMaxThreads()).isEqualTo(7);\n    }\n}\n"}
[tool-exec] start id=call_R7WKcFEP86BzkZYdiC1cE929|fc_0ccf643e9a94802d016ad135fdc65887d1b8408593a222b86d name=write args={"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ArrayUtilsTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.org.apache.commons.lang3.ArrayUtils;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.Timeout;\n\n@Timeout(55)\npublic class ArrayUtilsTest {\n    @Test\n    void preservesComponentTypesAcrossArrayTransformations() {\n        String[] inserted = ArrayUtils.add(new String[] {\"a\", \"c\"}, 1, \"b\");\n        String[] grown = ArrayUtils.add(new String[] {\"a\"}, \"b\");\n        String[] createdFromNull = ArrayUtils.add((String[]) null, \"first\");\n        String[] allocated = ArrayUtils.newInstance(String.class, 3);\n        String[] empty = ArrayUtils.nullToEmpty(null, String[].class);\n        String[] removed = ArrayUtils.remove(new String[] {\"a\", \"b\", \"c\"}, 1);\n        String[] removedByIndex =\n                ArrayUtils.removeAll(new String[] {\"a\", \"b\", \"c\", \"d\"}, 1, 3);\n        String[] removedOccurrences = ArrayUtils.removeAllOccurrences(\n                new String[] {\"keep\", \"drop\", \"drop\"}, \"drop\");\n\n        assertThat(inserted).containsExactly(\"a\", \"b\", \"c\");\n        assertThat(grown).containsExactly(\"a\", \"b\");\n        assertThat(createdFromNull).containsExactly(\"first\");\n        assertThat(allocated).hasSize(3).containsOnlyNulls();\n        assertThat(empty).isEmpty();\n        assertThat(removed).containsExactly(\"a\", \"c\");\n        assertThat(removedByIndex).containsExactly(\"a\", \"c\");\n        assertThat(removedOccurrences).containsExactly(\"keep\");\n    }\n}\n"}
[tool-exec] start id=call_OrXHea0fO49OkuXss7uNhejH|fc_0ccf643e9a94802d016ad135fdc66487d1abdb42680b938fd7 name=write args={"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/PropertySubstituteTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.List;\nimport java.util.Map;\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.introspector.PropertySubstitute;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.Timeout;\n\n@Timeout(55)\npublic class PropertySubstituteTest {\n    @Test\n    void readsWritesAndFillsBeanProperties() throws Exception {\n        Config config = new Config();\n        PropertySubstitute name =\n                property(\"name\", String.class, \"getName\", \"setName\");\n        PropertySubstitute tags =\n                property(\"tags\", List.class, \"getTags\", \"addTag\", String.class);\n        PropertySubstitute scores = property(\n                \"scores\", Map.class, \"getScores\", \"putScore\", String.class, Integer.class);\n        PropertySubstitute codes =\n                property(\"codes\", List.class, \"getCodes\", \"addCode\", String.class);\n        PropertySubstitute direct = new PropertySubstitute(\"direct\", String.class);\n        direct.setTargetType(Config.class);\n\n        name.set(config, \"broker\");\n        tags.set(config, List.of(\"fast\", \"durable\"));\n        scores.set(config, Map.of(\"quality\", 9));\n        codes.set(config, new String[] {\"A\", \"B\"});\n        direct.set(config, \"field\");\n\n        assertThat(name.get(config)).isEqualTo(\"broker\");\n        assertThat(tags.get(config)).isEqualTo(List.of(\"fast\", \"durable\"));\n        assertThat(scores.get(config)).isEqualTo(Map.of(\"quality\", 9));\n        assertThat(codes.get(config)).isEqualTo(List.of(\"A\", \"B\"));\n        assertThat(direct.get(config)).isEqualTo(\"field\");\n    }\n\n    private static PropertySubstitute property(\n            String name,\n            Class<?> type,\n            String readMethod,\n            String writeMethod,\n            Class<?>... parameters) {\n        PropertySubstitute property =\n                new PropertySubstitute(name, type, readMethod, writeMethod, parameters);\n        property.setTargetType(Config.class);\n        return property;\n    }\n\n    public static final class Config {\n        private String name;\n        private final java.util.ArrayList<String> tags = new java.util.ArrayList<>();\n        private final java.util.HashMap<String, Integer> scores = new java.util.HashMap<>();\n        private final java.util.ArrayList<String> codes = new java.util.ArrayList<>();\n        private String direct;\n\n        public String getName() {\n            return name;\n        }\n\n        public void setName(String name) {\n            this.name = name;\n        }\n\n        public List<String> getTags() {\n            return tags;\n        }\n\n        public void addTag(String tag) {\n            tags.add(tag);\n        }\n\n        public Map<String, Integer> getScores() {\n            return scores;\n        }\n\n        public void putScore(String key, Integer value) {\n            scores.put(key, value);\n        }\n\n        public List<String> getCodes() {\n            return codes;\n        }\n\n        public void addCode(String code) {\n            codes.add(code);\n        }\n    }\n}\n"}
[tool-exec] start id=call_AosOhLuNBfwjb84Fpi8Y2mqK|fc_0ccf643e9a94802d016ad135fdc66c87d1907c69048b51514a name=write args={"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/FieldParserTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.LinkedHashMap;\nimport java.util.List;\nimport java.util.Map;\nimport java.util.Optional;\nimport java.util.Set;\nimport org.apache.pulsar.common.util.FieldParser;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.Timeout;\n\n@Timeout(55)\npublic class FieldParserTest {\n    @Test\n    void updatesTypedFieldsAndInitializesEmptyCollections() {\n        ParserConfig populated = new ParserConfig();\n        Map<String, String> values = new LinkedHashMap<>();\n        values.put(\"threads\", \"8\");\n        values.put(\"enabled\", \"true\");\n        values.put(\"names\", \"alpha, beta\");\n        values.put(\"ports\", \"6650, 8080\");\n        values.put(\"labels\", \"zone=east, tier=storage\");\n        values.put(\"optionalName\", \"pulsar\");\n        FieldParser.update(values, populated);\n\n        assertThat(populated.threads).isEqualTo(8);\n        assertThat(populated.enabled).isTrue();\n        assertThat(populated.names).containsExactly(\"alpha\", \"beta\");\n        assertThat(populated.ports).containsExactly(6650, 8080);\n        assertThat(populated.labels)\n                .containsEntry(\"zone\", \"east\")\n                .containsEntry(\"tier\", \"storage\");\n        assertThat(populated.optionalName).contains(\"pulsar\");\n\n        ParserConfig empty = new ParserConfig();\n        FieldParser.update(\n                Map.of(\n                        \"names\", \" \",\n                        \"ports\", \" \",\n                        \"optionalName\", \" \",\n                        \"nullableLimit\", \" \"),\n                empty);\n        assertThat(empty.names).isEmpty();\n        assertThat(empty.ports).isEmpty();\n        assertThat(empty.optionalName).isEmpty();\n        assertThat(empty.nullableLimit).isNull();\n    }\n\n    public static final class ParserConfig {\n        private int threads;\n        private boolean enabled;\n        private List<String> names;\n        private Set<Integer> ports;\n        private Map<String, String> labels;\n        private Optional<String> optionalName;\n        private Integer nullableLimit = 1;\n    }\n}\n"}
