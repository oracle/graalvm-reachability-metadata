          return clusters;
      }
  
      List<Integer> getPorts() {
          return ports;
      }
  
      Set<String> getRoles() {
          return roles;
      }
  
      Map<String, Integer> getWeights() {
          return weights;
      }
  
      Optional<Integer> getMaybePort() {
          return maybePort;
      }
  }
