oken.class);\n        assertThat(mapped.getAuthMethodName()).isEqualTo(\"token\");\n\n        encoded.close();\n        mapped.close();\n    }\n}\n"}}, {"type": "toolCall", "id": "call_sY1Ibhbm4E4vKlekUmnnhYTv|fc_04c9418095f9a914016ad5e1b7dd6887d18528f668cf892bea", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/BrokerEntryMetadataUtilsTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.Set;\n\nimport org.apache.pulsar.common.api.proto.BrokerEntryMetadata;\nimport org.apache.pulsar.common.intercept.AppendBrokerTimestampMetadataInterceptor;\nimport org.apache.pulsar.common.intercept.AppendIndexMetadataInterceptor;\nimport org.apache.pulsar.common.intercept.BrokerEntryMetadataInterceptor;\nimport org.apache.pulsar.common.intercept.BrokerEntryMetadataUtils;\nimport org.junit.jupiter.api.Test;\n\npublic class BrokerEntryMetadataUtilsTest {\n    @Test\n    void loadsAndAppliesConfiguredMetadataInterceptors() {\n        Set<String> classNames = Set.of(\n                AppendBrokerTimestampMetadataInterceptor.class.getName(),\n                AppendIndexMetadataInterceptor.class.getName());\n        Set<BrokerEntryMetadataInterceptor> interceptors =\n                BrokerEntryMetadataUtils.loadBrokerEntryMetadataInterceptors(\n                        classNames, getClass().getClassLoader());\n        Set<BrokerEntryMetadataInterceptor> genericInterceptors =\n                BrokerEntryMetadataUtils.loadInterceptors(classNames, getClass().getClassLoader());\n        BrokerEntryMetadata metadata = new BrokerEntryMetadata();\n\n        for (BrokerEntryMetadataInterceptor interceptor : interceptors) {\n            interceptor.interceptWithNumberOfMessages(metadata, 4);\n        }\n\n        assertThat(interceptors).hasSize(2);\n        assertThat(genericInterceptors).hasSize(2);\n        assertThat(metadata.hasBrokerTimestamp()).isTrue();\n        assertThat(metadata.hasIndex()).isTrue();\n    }\n}\n"}}, {"type": "toolCall", "id": "call_W3veVkVydGLwY2fQ2YpJzT9H|fc_04c9418095f9a914016ad5e1b7dd7487d1acd1a06de85d635c", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/TopicCompactionStrategyTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.client.api.Schema;\nimport org.apache.pulsar.common.topics.TopicCompactionStrategy;\nimport org.junit.jupiter.api.Test;\n\npublic class TopicCompactionStrategyTest {\n    @Test\n    void loadsAndCachesConfiguredStrategyByClassName() {\n        TopicCompactionStrategy<?> loaded = TopicCompactionStrategy.load(\n                \"coverage\", KeepLongestValue.class.getName());\n\n        assertThat(loaded).isInstanceOf(KeepLongestValue.class);\n        assertThat(TopicCompactionStrategy.getInstance(\"coverage\")).isSameAs(loaded);\n        KeepLongestValue strategy = (KeepLongestValue) loaded;\n        assertThat(strategy.getSchema()).isSameAs(Schema.STRING);\n        assertThat(strategy.shouldKeepLeft(\"longer\", \"new\")).isTrue();\n        assertThat(strategy.shouldKeepLeft(\"old\", \"longer\")).isFalse();\n    }\n\n    public static class KeepLongestValue implements TopicCompactionStrategy<String> {\n        public KeepLongestValue() {\n        }\n\n        @Override\n        public Schema<String> getSchema() {\n            return Schema.STRING;\n        }\n\n        @Override\n        public boolean shouldKeepLeft(String previous, String current) {\n            return previous.length() > current.length();\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_s7lBjrnxP8l9kZkhDBSB4tLS|fc_04c9418095f9a914016ad5e1b7dd7c87d18e424b802f22424b", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/PulsarURLStreamHandlerFactoryTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.net.URL;\nimport java.net.URLStreamHandler;\n\nimport org.apache.pulsar.client.api.url.PulsarURLStreamHandlerFactory;\nimport org.junit.jupiter.api.Test;\n\npublic class PulsarURLStreamHandlerFactoryTest {\n    @Test\n    void createsHandlersForPulsarServiceSchemes() throws Exception {\n        PulsarURLStreamHandlerFactory factory = new PulsarURLStreamHandlerFactory();\n        URLStreamHandler handler = factory.createURLStreamHandler(\"pulsar\");\n        URLStreamHandler secureHandler = factory.createURLStreamHandler(\"pulsar+ssl\");\n\n        URL plain = new URL(null, \"pulsar://broker.example.test:6650/topic\", handler);\n        URL secure = new URL(null, \"pulsar+ssl://broker.example.test:6651/topic\", secureHandler);\n\n        assertThat(plain.getProtocol()).isEqualTo(\"pulsar\");\n        assertThat(plain.getHost()).isEqualTo(\"broker.example.test\");\n        assertThat(secure.getProtocol()).isEqualTo(\"pulsar+ssl\");\n        assertThat(secure.getPort()).isEqualTo(6651);\n        assertThat(factory.createURLStreamHandler(\"http\")).isNull();\n    }\n}\n"}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-sol", "usage": {"input": 3500, "output": 1754, "cacheRead": 195200, "cacheWrite": 0, "reasoning": 29, "totalTokens": 200454, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1792401786517, "responseId": "resp_04c9418095f9a914016ad5e17b1b1887d197c220e701023589", "rawStopReason": "completed"}, "toolResults": [{"role": "toolResult", "toolCallId": "call_tpK1o5BBbu1V56nwtfyj5I3U|fc_04c9418095f9a914016ad5e1b7dd5887d181bbb46eb875d15e", "toolName": "write", "content": [{"type": "text", "text": "Successfully wrote 1389 bytes to tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/AuthenticationUtilTest.java"}], "isError": false, "timestamp": 1792401848116}, {"role": "toolResult", "toolCallId": "call_sY1Ibhbm4E4vKlekUmnnhYTv|fc_04c9418095f9a914016ad5e1b7dd6887d18528f668cf892bea", "toolName": "write", "content": [{"type": "text", "text": "Successfully wrote 1827 bytes to tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/BrokerEntryMetadataUtilsTest.java"}], "isError": false, "timestamp": 1792401848116}, {"role": "toolResult", "toolCallId": "call_W3veVkVydGLwY2fQ2YpJzT9H|fc_04c9418095f9a914016ad5e1b7dd7487d1acd1a06de85d635c", "toolName": "write", "content": [{"type": "text", "text": "Successfully wrote 1536 bytes to tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/TopicCompactionStrategyTest.java"}], "isError": false, "timestamp": 1792401848117}, {"role": "toolResult", "toolCallId": "call_s7lBjrnxP8l9kZkhDBSB4tLS|fc_04c9418095f9a914016ad5e1b7dd7c87d18e424b802f22424b", "toolName": "write", "content": [{"type": "text", "text": "Successfully wrote 1363 bytes to tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/PulsarURLStreamHandlerFactoryTest.java"}], "isError": false, "time