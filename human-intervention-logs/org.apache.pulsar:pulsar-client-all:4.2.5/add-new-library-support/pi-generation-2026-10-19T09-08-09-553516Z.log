[tool-call] delta {"path":"tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ServiceFinderTest.java","content":"/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.org.glassfish.jersey.internal.ServiceFinder;\nimport org.apache.pulsar.shade.org.glassfish.jersey.internal.inject.InjectionManagerFactory;\nimport org.junit.jupiter.api.Test;\n\npublic class ServiceFinderTest {\n    @Test\n    void discoversServiceImplementationsAndClasses() {\n        ServiceFinder<InjectionManagerFactory> finder = ServiceFinder.find(InjectionManagerFactory.class);\n\n        InjectionManagerFactory[] services = finder.toArray();\n        Class<InjectionManagerFactory>[] serviceClasses = finder.toClassArray();\n\n        assertThat(services).isNotEmpty();\n        assertThat(serviceClasses).isNotEmpty();\n        assertThat(serviceClasses[0]).isAssignableFrom(services[0].getClass());\n    }\n}\n"}
