est/java/org_apache_pulsar/pulsar_client_all/MultimapsInnerCustomMultimapTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.io.Serializable;\nimport java.util.ArrayList;\nimport java.util.Collection;\nimport java.util.HashMap;\n\nimport org.apache.pulsar.shade.com.google.common.base.Supplier;\nimport org.apache.pulsar.shade.com.google.common.collect.Multimap;\nimport org.apache.pulsar.shade.com.google.common.collect.Multimaps;\nimport org.junit.jupiter.api.Test;\n\npublic class MultimapsInnerCustomMultimapTest {\n    @Test\n    void roundTripPreservesFactoryAndValues() throws Exception {\n        Multimap<String, String> input = Multimaps.newMultimap(new HashMap<>(), new CollectionSupplier());\n        input.put(\"letters\", \"a\");\n        input.put(\"letters\", \"b\");\n\n        Multimap<String, String> restored = SerializationSupport.roundTrip(input);\n\n        assertThat(restored.get(\"letters\")).containsExactly(\"a\", \"b\");\n        restored.put(\"numbers\", \"one\");\n        assertThat(restored.get(\"numbers\")).containsExactly(\"one\");\n    }\n\n    private static final class CollectionSupplier implements Supplier<Collection<String>>, Serializable {\n        @Override\n        public Collection<String> get() {\n            return new ArrayList<>();\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_CeITQxbDBa8VxF1on3i660fa|fc_08b27a44b4090f02016ad5f25824fc87d1a8779071e07ce140", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/MultimapsInnerCustomListMultimapTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.io.Serializable;\nimport java.util.ArrayList;\nimport java.util.Collection;\nimport java.util.HashMap;\nimport java.util.List;\n\nimport org.apache.pulsar.shade.com.google.common.base.Supplier;\nimport org.apache.pulsar.shade.com.google.common.collect.ListMultimap;\nimport org.apache.pulsar.shade.com.google.common.collect.Multimaps;\nimport org.junit.jupiter.api.Test;\n\npublic class MultimapsInnerCustomListMultimapTest {\n    @Test\n    void roundTripPreservesListOrderAndDuplicates() throws Exception {\n        ListMultimap<String, String> input = Multimaps.newListMultimap(new HashMap<>(), new ListSupplier());\n        input.put(\"letters\", \"a\");\n        input.put(\"letters\", \"b\");\n        input.put(\"letters\", \"a\");\n\n        ListMultimap<String, String> restored = SerializationSupport.roundTrip(input);\n\n        assertThat(restored.get(\"letters\")).containsExactly(\"a\", \"b\", \"a\");\n        restored.put(\"letters\", \"c\");\n        assertThat(restored.get(\"letters\")).endsWith(\"c\");\n    }\n\n    private static final class ListSupplier implements Supplier<List<String>>, Serializable {\n        @Override\n        public List<String> get() {\n            return new ArrayList<>();\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_LknHNm0MZQsN55nUBBBMaKRf|fc_08b27a44b4090f02016ad5f258250487d1a809c7a12d5107d6", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/MultimapsInnerCustomSetMultimapTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.io.Serializable;\nimport java.util.Collection;\nimport java.util.HashMap;\nimport java.util.LinkedHashSet;\nimport java.util.Set;\n\nimport org.apache.pulsar.shade.com.google.common.base.Supplier;\nimport org.apache.pulsar.shade.com.google.common.collect.Multimaps;\nimport org.apache.pulsar.shade.com.google.common.collect.SetMultimap;\nimport org.junit.jupiter.api.Test;\n\npublic class MultimapsInnerCustomSetMultimapTest {\n    @Test\n    void roundTripPreservesDistinctInsertionOrderedValues() throws Exception {\n        SetMultimap<String, String> input = Multimaps.newSetMultimap(new HashMap<>(), new SetSupplier());\n        input.put(\"letters\", \"b\");\n        input.put(\"letters\", \"a\");\n        input.put(\"letters\", \"b\");\n\n        SetMultimap<String, String> restored = SerializationSupport.roundTrip(input);\n\n        assertThat(restored.get(\"letters\")).containsExactly(\"b\", \"a\");\n        restored.put(\"letters\", \"c\");\n        assertThat(restored.get(\"letters\")).containsExactly(\"b\", \"a\", \"c\");\n    }\n\n    private static final class SetSupplier implements Supplier<Set<String>>, Serializable {\n        @Override\n        public Set<String> get() {\n            return new LinkedHashSet<>();\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_MR7DGee2IXrLx8z90EoWavna|fc_08b27a44b4090f02016ad5f258251087d18b2c192c80ff1978", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/MultimapsInnerCustomSortedSetMultimapTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static java.util.Comparator.reverseOrder;\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.io.Serializable;\nimport java.util.Collection;\nimport java.util.HashMap;\nimport java.util.SortedSet;\nimport java.util.TreeSet;\n\nimport org.apache.pulsar.shade.com.google.common.base.Supplier;\nimport org.apache.pulsar.shade.com.google.common.collect.Multimaps;\nimport org.apache.pulsar.shade.com.google.common.collect.SortedSetMultimap;\nimport org.junit.jupiter.api.Test;\n\npublic class MultimapsInnerCustomSortedSetMultimapTest {\n    @Test\n    void roundTripPreservesValueComparator() throws Exception {\n        SortedSetMultimap<String, String> input =\n                Multimaps.newSortedSetMultimap(new HashMap<>(), new SortedSetSupplier());\n        input.put(\"letters\", \"a\");\n        input.put(\"letters\", \"c\");\n        input.put(\"letters\", \"b\");\n\n        SortedSetMultimap<String, String> restored = SerializationSupport.roundTrip(input);\n\n        assertThat(restored.get(\"letters\")).containsExactly(\"c\", \"b\", \"a\");\n        restored.put(\"letters\", \"z\");\n        assertThat(restored.get(\"letters\")).startsWith(\"z\");\n    }\n\n    private static final class SortedSetSupplier implements Supplier<SortedSet<String>>, Serializable {\n        @Override\n        public SortedSet<String> get() {\n            return new TreeSet<>(reverseOrder());\n        }\n    }\n}\n"}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-sol", "usage": {"input": 3706, "output": 1965, "cacheRead": 151040, "cacheWrite": 0, "reasoning": 126, "totalTokens": 156711, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1792406061310, "responseId": "resp_08b27a44b4090f02016ad5f22e089887d193f9dda5d2a20fa2", "rawStopReason": "completed"}, "toolResults": [{"role": "toolResult", "toolCallId": "call_UtSuMrjpo5xMR8SN7VxVsyt0|fc_08b27a44b4090f02016ad5f25824e887d19f