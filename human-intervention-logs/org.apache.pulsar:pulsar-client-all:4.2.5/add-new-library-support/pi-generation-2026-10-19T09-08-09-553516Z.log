new Class<?>[0]);\n        AnnotatedMethod setValue = description.findMethod(\"setValue\", new Class<?>[] {String.class});\n        AnnotatedMethod combine = description.findMethod(\n                \"combine\", new Class<?>[] {String.class, String.class});\n\n        MethodTarget created = (MethodTarget) create.call();\n        MethodTarget supplied = (MethodTarget) fromString.call1(\"supplied\");\n        MethodTarget suppliedWithArray = (MethodTarget) fromString.call(new Object[] {\"array\"});\n        setValue.setValue(created, \"set\");\n\n        assertThat(getValue.getValue(created)).isEqualTo(\"set\");\n        assertThat(getValue.callOn(supplied)).isEqualTo(\"supplied\");\n        assertThat(getValue.callOn(suppliedWithArray)).isEqualTo(\"array\");\n        assertThat(combine.callOnWith(created, \"left\", \"right\")).isEqualTo(\"left-right-set\");\n    }\n\n    private static AnnotatedMethod factoryMethod(BeanDescription description, String name) {\n        for (AnnotatedMethod method : description.getFactoryMethods()) {\n            if (method.getName().equals(name)) {\n                return method;\n            }\n        }\n        throw new AssertionError(\"Missing factory method \" + name);\n    }\n\n    public static class MethodTarget {\n        private String value;\n\n        public MethodTarget() {\n            value = \"created\";\n        }\n\n        @JsonCreator\n        public static MethodTarget create() {\n            return new MethodTarget();\n        }\n\n        public static MethodTarget fromString(String value) {\n            MethodTarget target = new MethodTarget();\n            target.value = value;\n            return target;\n        }\n\n        public String getValue() {\n            return value;\n        }\n\n        public void setValue(String value) {\n            this.value = value;\n        }\n\n        public String combine(String left, String right) {\n            return left + \"-\" + right + \"-\" + value;\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792402501526}, {"role": "toolResult", "toolCallId": "call_2iSlWaK2peJMT0lMc1dHiJjR|fc_04c9418095f9a914016ad5e44513cc87d181a85dfea6898ec4", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.io.IOException;\n\nimport org.apache.avro.reflect.AvroEncode;\nimport org.apache.pulsar.client.schema.AvroTrustedClasses;\nimport org.apache.pulsar.shade.org.apache.avro.Protocol;\nimport org.apache.pulsar.shade.org.apache.avro.Schema;\nimport org.apache.pulsar.shade.org.apache.avro.io.Decoder;\nimport org.apache.pulsar.shade.org.apache.avro.io.Encoder;\nimport org.apache.pulsar.shade.org.apache.avro.reflect.CustomEncoding;\nimport org.apache.pulsar.shade.org.apache.avro.reflect.ReflectData;\nimport org.apache.pulsar.shade.org.apache.avro.specific.SpecificData;\nimport org.junit.jupiter.api.Test;\n\npublic class ReflectDataTest {\n    @Test\n    void derivesDefaultsFieldsProtocolsAndArrayClasses() {\n        ReflectData data = new ReflectData();\n        data.setDefaultsGenerated(true);\n\n        Schema recordSchema = data.getSchema(DefaultRecord.class);\n        Protocol protocol = data.getProtocol(EchoService.class);\n        Class<?> arrayClass = data.getClass(Schema.createArray(Schema.create(Schema.Type.STRING)));\n\n        assertThat(recordSchema.getField(\"text\").defaultVal()).isEqualTo(\"default text\");\n        assertThat(recordSchema.getField(\"count\").defaultVal()).isEqualTo(3);\n        assertThat(protocol.getMessages()).containsKey(\"echo\");\n        assertThat(arrayClass).isEqualTo(String[].class);\n    }\n\n    @Test\n    void createsAndCachesCustomFieldAndTypeEncodings() {\n        synchronized (AvroTrustedClasses.class) {\n            AvroTrustedClasses.State previousTrust = AvroTrustedClasses.snapshot();\n            AvroTrustedClasses.trustExactly(EncodedValue.class);\n            try {\n                ReflectData data = new ReflectData();\n                Schema typeSchema = data.getSchema(EncodedValue.class);\n                Schema fieldSchema = data.getSchema(EncodedRecord.class).getField(\"value\").schema();\n                Schema cacheSchema = Schema.create(Schema.Type.STRING);\n                cacheSchema.addProp(SpecificData.CLASS_PROP, EncodedValue.class.getName());\n                CustomEncoding<?> cached = data.getCustomEncoding(cacheSchema);\n\n                assertThat(typeSchema.getType()).isEqualTo(Schema.Type.STRING);\n                assertThat(fieldSchema.getType()).isEqualTo(Schema.Type.STRING);\n                assertThat(cached).isInstanceOf(ValueEncoding.class);\n            } finally {\n                AvroTrustedClasses.restore(previousTrust);\n            }\n        }\n    }\n\n    public interface EchoService {\n        String echo(String value);\n    }\n\n    public static class DefaultRecord {\n        public String text = \"default text\";\n        public int count = 3;\n\n        public DefaultRecord() {\n        }\n    }\n\n    @AvroEncode(using = ValueEncoding.class)\n    public static class EncodedValue {\n        private final String text;\n\n        public EncodedValue() {\n            this(\"empty\");\n        }\n\n        public EncodedValue(String text) {\n            this.text = text;\n        }\n    }\n\n    public static class EncodedRecord {\n        @AvroEncode(using = ValueEncoding.class)\n        public EncodedValue value = new EncodedValue(\"field\");\n\n        public EncodedRecord() {\n        }\n    }\n\n    public static class ValueEncoding extends CustomEncoding<EncodedValue> {\n        public ValueEncoding() {\n            schema = Schema.create(Schema.Type.STRING);\n        }\n\n        @Override\n        protected void write(Object datum, Encoder output) throws IOException {\n            output.writeString(((EncodedValue) datum).text);\n        }\n\n        @Override\n        protected EncodedValue read(Object reuse, Decoder input) throws IOException {\n            return new EncodedValue(input.readString().toString());\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792402501526}, {"role": "toolResult", "toolCallId": "call_8zoor4S0DWb33ozLnI4cBG5Q|fc_04c9418095f9a914016ad5e44513d887d1b7388abfd50989bb", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.client.schema.AvroTrustedClasses;\nimport org.apache.pulsar.shade.org.apache.avro.Protocol;\nimport org.apache.pulsar.shade.org.apache.avro.Schema;\nimport org.apache.pulsar.shade.org.apache.avro.generic.GenericData.InstanceSupplier;\nimport org.apache.pulsar.shade.org.apache.avro.specific.SpecificData;\nimport org.apache.pulsar.shade.org.apache.avro.specific.SpecificRecordBase;\nimport org.junit.jupiter.api.Test;\n\npublic class SpecificDataTest {\n    @Test\n    void readsGeneratedModelSchemaAndProtocolFields() {\n        SpecificData model = SpecificData.getForClass(GeneratedRecord.class);\n        Schema schema = SpecificData.get().getSchema(GeneratedRecord.class);\n        Protocol protocol = SpecificData.get().getProtocol(GeneratedService.class);\n\n        assertThat(model).isSameAs(GeneratedRecord.MODEL$);\n        assertThat(schema.getType()).isEqualTo(Schema.Type.RECORD);\n        assertThat(schema.getName()).isEqualTo(\"GeneratedRecord\");\n        assertThat(protocol.getMessages()).containsKey(\"lookup\");\n    }\n\n    @Test\n    void constructsSpecificRecordsAndUsesCachedInstanceSupplier() {\n        synchronized (AvroTrustedClasses.class) {\n            AvroTrustedClasses.State previousTrust = AvroTrustedClasses.snapshot();\n            AvroTrustedClasses.trustExactly(GeneratedRecord.class);\n            try {\n                SchemaConstructedRecord constructed = (SchemaConstructedRecord) SpecificData.newInstance(\n                        SchemaConstructedRecord.class, SchemaConstructedRecord.SCHEMA$);\n                InstanceSupplier supplier = SpecificData.get().getNewRecordSupplier(GeneratedRecord.SCHEMA$);\n                Object supplied = supplier.newInstance(null, GeneratedRecord.SCHEMA$);\n\n                assertThat(constructed.constructorSchema).isSameAs(SchemaConstructedRecord.SCHEMA$);\n                assertThat(supplied).isInstanceOf(GeneratedRecord.class);\n                assertThat(supplier.newInstance(supplied, GeneratedRecord.SCHEMA$)).isSameAs(supplied);\n            } finally {\n                AvroTrustedClasses.restore(previousTrust);\n            }\n        }\n    }\n\n    public interface GeneratedService {\n        Protocol PROTOCOL = Protocol.parse(\"\"\"\n                {\n                  \"protocol\": \"GeneratedService\",\n                  \"namespace\": \"org_apache_pulsar.pulsar_client_all\",\n                  \"messages\": {\n                    \"lookup\": {\n                      \"request\": [{\"name\": \"key\", \"type\": \"string\"}],\n                      \"response\": \"string\"\n                    }\n                  }\n                }\n                \"\"\");\n    }\n\n    public static class GeneratedRecord extends SpecificRecordBase {\n        public static final Schema SCHEMA$ = new Schema.Parser().parse(\"\"\"\n                {\n                  \"type\": \"record\",\n                  \"name\": \"GeneratedRecord\",\n                  \"namespace\": \"org_apache_pulsar.pulsar_client_all.SpecificDataTest\",\n                  \"fields\": []\n                }\n                \"\"\");\n        public static final SpecificData MODEL$ = new SpecificData();\n\n        public GeneratedRecord() {\n        }\n\n        @Override\n        public Schema getSchema() {\n            return SCHEMA$;\n        }\n\n        @Override\n        public Object get(int field) {\n            throw new IndexOutOfBoundsException(\"field \" + field);\n        }\n\n        @Override\n        public void put(int field, Object value) {\n            throw new IndexOutOfBoundsException(\"field \" + field);\n        }\n    }\n\n    public static class SchemaConstructedRecord extends SpecificRecordBase\n            implements SpecificData.SchemaConstructable {\n        public static final Schema SCHEMA$ = new Schema.Parser().parse(\"\"\"\n                {\n                  \"type\": \"record\",\n                  \"name\": \"SchemaConstructedRecord\",\n                  \"namespace\": \"org_apache_pulsar.pulsar_client_all.SpecificDataTest\",\n                  \"fields\": []\n                }\n                \"\"\");\n        private final Schema constructorSchema;\n\n        public SchemaConstructedRecord(Schema schema) {\n            constructorSchema = schema;\n        }\n\n        @Override\n        public Schema getSchema() {\n            return SCHEMA$;\n        }\n\n        @Override\n        public Object get(int field) {\n            throw new IndexOutOfBoundsException(\"field \" + field);\n        }\n\n        @Override\n        public void put(int field, Object value) {\n            throw new IndexOutOfBoundsException(\"field \" + field);\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792402501527}]}
