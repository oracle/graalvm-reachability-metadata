fferentAnnotated.class.getAnnotation(Composite.class);\n\n        assertThat(AnnotationUtils.equals(first, matching)).isTrue();\n        assertThat(AnnotationUtils.equals(first, different)).isFalse();\n        assertThat(AnnotationUtils.hashCode(first)).isEqualTo(first.hashCode());\n        assertThat(AnnotationUtils.toString(first))\n                .contains(\"value=alpha\")\n                .contains(\"numbers=[1,2,3]\")\n                .contains(\"name=inner\");\n    }\n\n    @Retention(RetentionPolicy.RUNTIME)\n    public @interface Nested {\n        String name();\n    }\n\n    @Retention(RetentionPolicy.RUNTIME)\n    public @interface Composite {\n        String value();\n\n        int[] numbers();\n\n        Nested nested();\n    }\n\n    @Composite(value = \"alpha\", numbers = {1, 2, 3}, nested = @Nested(name = \"inner\"))\n    public static class FirstAnnotated {\n    }\n\n    @Composite(value = \"alpha\", numbers = {1, 2, 3}, nested = @Nested(name = \"inner\"))\n    public static class MatchingAnnotated {\n    }\n\n    @Composite(value = \"beta\", numbers = {5, 8}, nested = @Nested(name = \"other\"))\n    public static class DifferentAnnotated {\n    }\n}\n"}}, {"type": "toolCall", "id": "call_qbvCDnq7sDyCXJAvIyx8Wx66|fc_0e54691b1a885b91016ad5ebd89eb887d1a948a14982d7f983", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/FieldUtilsTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.lang.reflect.Field;\nimport java.util.List;\n\nimport org.apache.pulsar.shade.org.apache.commons.lang3.reflect.FieldUtils;\nimport org.junit.jupiter.api.Test;\n\npublic class FieldUtilsTest {\n    @Test\n    void discoversReadsAndWritesFieldsAcrossAClassHierarchy() throws Exception {\n        MutableChild target = new MutableChild();\n        Field hidden = FieldUtils.getDeclaredField(MutableChild.class, \"message\", true);\n        Field inherited = FieldUtils.getField(MutableChild.class, \"inherited\", true);\n        Field shared = FieldUtils.getField(MutableChild.class, \"SHARED\");\n        List<Field> fields = FieldUtils.getAllFieldsList(MutableChild.class);\n\n        assertThat(FieldUtils.readField(hidden, target)).isEqualTo(\"initial\");\n        FieldUtils.writeField(hidden, target, \"updated\");\n\n        assertThat(target.message()).isEqualTo(\"updated\");\n        assertThat(inherited.getDeclaringClass()).isEqualTo(MutableParent.class);\n        assertThat(shared.getDeclaringClass()).isEqualTo(SharedLabel.class);\n        assertThat(fields).extracting(Field::getName).contains(\"message\", \"inherited\");\n    }\n\n    public interface SharedLabel {\n        String SHARED = \"label\";\n    }\n\n    public static class MutableParent {\n        private String inherited = \"parent\";\n    }\n\n    public static class MutableChild extends MutableParent implements SharedLabel {\n        private String message = \"initial\";\n\n        public String message() {\n            return message;\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_CV2R1ddSoedMfGNG3nxgWBhT|fc_0e54691b1a885b91016ad5ebd89ec887d1b7da025138b590f2", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ConstructorUtilsTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.lang.reflect.Constructor;\n\nimport org.apache.pulsar.shade.org.apache.commons.lang3.reflect.ConstructorUtils;\nimport org.junit.jupiter.api.Test;\n\npublic class ConstructorUtilsTest {\n    @Test\n    void resolvesExactAndAssignablePublicConstructors() throws Exception {\n        Constructor<Constructed> exact = ConstructorUtils.getAccessibleConstructor(Constructed.class, String.class);\n        Constructor<Constructed> matching = ConstructorUtils.getMatchingAccessibleConstructor(\n                Constructed.class, Integer.class);\n        Constructed exactValue = ConstructorUtils.invokeExactConstructor(Constructed.class, \"pulsar\");\n        Constructed compatibleValue = ConstructorUtils.invokeConstructor(Constructed.class, Integer.valueOf(7));\n\n        assertThat(exact).isNotNull();\n        assertThat(matching.getParameterTypes()).containsExactly(Number.class);\n        assertThat(exactValue.description()).isEqualTo(\"text:pulsar\");\n        assertThat(compatibleValue.description()).isEqualTo(\"number:7\");\n    }\n\n    public static class Constructed {\n        private final String description;\n\n        public Constructed(String value) {\n            description = \"text:\" + value;\n        }\n\n        public Constructed(Number value) {\n            description = \"number:\" + value;\n        }\n\n        public String description() {\n            return description;\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_ydjYe4BkAvyR7v5q9oYaSc6A|fc_0e54691b1a885b91016ad5ebd89ed087d191aabd67edac10e1", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/BeanPropertyWriterTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.LinkedHashMap;\nimport java.util.Map;\n\nimport org.apache.pulsar.shade.com.fasterxml.jackson.annotation.JsonFilter;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.annotation.JsonFormat;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.core.JsonGenerator;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.ObjectMapper;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.SerializerProvider;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.ser.BeanPropertyWriter;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.ser.PropertyWriter;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.ser.impl.SimpleBeanPropertyFilter;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.ser.impl.SimpleFilterProvider;\nimport org.junit.jupiter.api.Test;\n\npublic class BeanPropertyWriterTest {\n    @Test\n    void serializesFieldAndGetterPropertiesAsFieldsAndArrayElements() throws Exception {\n        ObjectMapper mapper = new ObjectMapper();\n        CapturingFilter filter = new CapturingFilter();\n        SimpleFilterProvider filters = new SimpleFilterProvider().addFilter(\"capture\", filter);\n\n        String objectJson = mapper.writer(filters).writeValueAsString(new FilteredBean(\"field\", \"getter\"));\n        String arrayJson = mapper.writeValueAsString(new ArrayBean(\"field\", \"getter\"));\n\n        assertThat(objectJson).contains(\"\\\"fieldValue\\\":\\\"field\\\"\").contains(\"\\\"methodValue\\\":\\\"getter\\\"\");\n        assertThat(arrayJson).isEqualTo(\"[\\\"field\\\",\\\"getter\\\"]\");\n        assertThat(filter.values).containsEntry(\"fieldValue\", \"field\").containsEntry(\"methodValue\", \"getter\");\n    }\n\n    public static class CapturingFilter extends SimpleBeanPropertyFilter {\n        private final Map<String, Object> values = new LinkedHashMap<>();\n\n        @Override\n        public void serializeAsField(\n                Object bean, JsonGenerator generator, SerializerProvider provider, PropertyWriter writer)\n                throws Exception {\n            if (writer instanceof BeanPropertyWriter beanWriter) {\n                values.put(writer.getName(), beanWriter.get(bean));\n            }\n            writer.serializeAsField(bean, generator, provider);\n        }\n    }\n\n    @JsonFilter(\"capture\")\n    public static class FilteredBean {\n        public final String fieldValue;\n        private final String methodValue;\n\n        public FilteredBean(String fieldValue, String methodValue) {\n            this.fieldValue = fieldValue;\n            this.methodValue = methodValue;\n        }\n\n        public String getMethodValue() {\n            return methodValue;\n        }\n    }\n\n    @JsonFormat(shape = JsonFormat.Shape.ARRAY)\n    public static class ArrayBean {\n        public final String fieldValue;\n        private final String methodValue;\n\n        public ArrayBean(String fieldValue, String methodValue) {\n            this.fieldValue = fieldValue;\n            this.methodValue = methodValue;\n        }\n\n        public String getMethodValue() {\n            return methodValue;\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_xiBtwk0PbzcHTMYyC1UjKjv6|fc_0e54691b1a885b91016ad5ebd89edc87d1905d45c7399bd295", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/FieldPropertyTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.ObjectMapper;\nimport org.junit.jupiter.api.Test;\n\npublic class FieldPropertyTest {\n    @Test\n    void deserializesAndUpdatesFieldBackedProperties() throws Exception {\n        ObjectMapper mapper = new ObjectMapper();\n        FieldBean created = mapper.readValue(\"{\\\"name\\\":\\\"created\\\",\\\"count\\\":3}\", FieldBean.class);\n        FieldBean updated = new FieldBean();\n\n        mapper.readerForUpdating(updated).readValue(\"{\\\"name\\\":\\\"updated\\\",\\\"count\\\":5}\");\n\n        assertThat(created.name).isEqualTo(\"created\");\n        assertThat(created.count).isEqualTo(3);\n        assertThat(updated.name).isEqualTo(\"updated\");\n        assertThat(updated.count).isEqualTo(5);\n    }\n\n    public static class FieldBean {\n        public String name;\n        public int count;\n\n        public FieldBean() {\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_b9hgUxdtpv53A5cl9eOOanv6|fc_0e54691b1a885b91016ad5ebd89ee887d1b2daefbbf69e61e5", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/MethodPropertyTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.ObjectMapper;\nimport org.junit.jupiter.api.Test;\n\npublic class MethodPropertyTest {\n    @Test\n    void deserializesAndUpdatesSetterBackedProperties() throws Exception {\n        ObjectMapper mapper = new ObjectMapper();\n        SetterBean created = mapper.readValue(\"{\\\"name\\\":\\\"created\\\",\\\"count\\\":3}\", SetterBean.class);\n        SetterBean updated = new SetterBean();\n\n        mapper.readerForUpdating(updated).readValue(\"{\\\"name\\\":\\\"updated\\\",\\\"count\\\":5}\");\n\n        assertThat(created.getName()).isEqualTo(\"cre