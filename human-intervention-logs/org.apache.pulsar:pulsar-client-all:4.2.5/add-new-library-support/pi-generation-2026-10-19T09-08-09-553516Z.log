\n    private static final class InitializedComponent {\n        static {\n            InitializationTracker.initialized = true;\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_YP49scm99HueDkG8U97XlrzC|fc_08b27a44b4090f02016ad5f2933fb887d18b6f5176d1bd164b", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/SimpleTimeLimiterTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static java.util.concurrent.TimeUnit.SECONDS;\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.concurrent.ExecutorService;\nimport java.util.concurrent.Executors;\n\nimport org.apache.pulsar.shade.com.google.common.util.concurrent.SimpleTimeLimiter;\nimport org.junit.jupiter.api.Test;\n\npublic class SimpleTimeLimiterTest {\n    @Test\n    void proxyInvokesTargetWithinBoundedTimeout() {\n        ExecutorService executor = Executors.newSingleThreadExecutor();\n        try {\n            SimpleTimeLimiter limiter = SimpleTimeLimiter.create(executor);\n            Calculator proxy = limiter.newProxy(value -> value * 2, Calculator.class, 10, SECONDS);\n\n            assertThat(proxy.doubleValue(21)).isEqualTo(42);\n        } finally {\n            executor.shutdownNow();\n        }\n    }\n\n    public interface Calculator {\n        int doubleValue(int value);\n    }\n}\n"}}, {"type": "toolCall", "id": "call_ZLH8869hDY1NS9Mt4uKNCrN3|fc_08b27a44b4090f02016ad5f2933fc487d1ab56443aa2716b28", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/SubscriberTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.google.common.eventbus.EventBus;\nimport org.apache.pulsar.shade.com.google.common.eventbus.Subscribe;\nimport org.junit.jupiter.api.Test;\n\npublic class SubscriberTest {\n    @Test\n    void eventBusInvokesSubscriberMethod() {\n        EventBus eventBus = new EventBus();\n        MessageSubscriber subscriber = new MessageSubscriber();\n        eventBus.register(subscriber);\n\n        eventBus.post(\"delivered\");\n\n        assertThat(subscriber.message).isEqualTo(\"delivered\");\n    }\n\n    public static class MessageSubscriber {\n        private String message;\n\n        @Subscribe\n        public void receive(String received) {\n            message = received;\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_Vznzl3ZIvCbkcoP28n57uSCx|fc_08b27a44b4090f02016ad5f2933fcc87d1a6ff76f2d1159edf", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/SubscriberRegistryTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.ArrayList;\nimport java.util.List;\n\nimport org.apache.pulsar.shade.com.google.common.eventbus.EventBus;\nimport org.apache.pulsar.shade.com.google.common.eventbus.Subscribe;\nimport org.junit.jupiter.api.Test;\n\npublic class SubscriberRegistryTest {\n    @Test\n    void registrationDiscoversAnnotatedMethods() {\n        EventBus eventBus = new EventBus();\n        RecordingSubscriber subscriber = new RecordingSubscriber();\n        eventBus.register(subscriber);\n\n        eventBus.post(\"first\");\n        eventBus.post(\"second\");\n\n        assertThat(subscriber.messages).containsExactly(\"first\", \"second\");\n    }\n\n    public static class RecordingSubscriber {\n        private final List<String> messages = new ArrayList<>();\n\n        @Subscribe\n        public void record(String message) {\n            messages.add(message);\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_CYkrnc35XfeeGk4qdcacRXhC|fc_08b27a44b4090f02016ad5f2933fd887d191a6c59e4cbdb05a", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ResourcesTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.net.URL;\n\nimport org.apache.pulsar.shade.com.google.common.io.Resources;\nimport org.junit.jupiter.api.Test;\n\npublic class ResourcesTest {\n    @Test\n    void locatesResourcesByClassLoaderAndClassContext() {\n        URL absolute = Resources.getResource(\n                \"org/apache/pulsar/shade/com/google/common/io/Resources.class\");\n        URL relative = Resources.getResource(Resources.class, \"Resources.class\");\n\n        assertThat(absolute).isNotNull();\n        assertThat(relative).isNotNull();\n        assertThat(relative.toExternalForm()).endsWith(\"/Resources.class\");\n    }\n}\n"}}, {"type": "toolCall", "id": "call_Re7GMiCNZM5Rnlv6Evs1gqae|fc_08b27a44b4090f02016ad5f2933fe087d186e1c50ef10205ef", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/EventListenerSupportTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.io.Serializable;\n\nimport org.apache.pulsar.shade.org.apache.commons.lang3.event.EventListenerSupport;\nimport org.junit.jupiter.api.Test;\n\npublic class EventListenerSupportTest {\n    @Test\n    void roundTripPreservesSerializableListeners() throws Exception {\n        EventListenerSupport<MessageListener> input = EventListenerSupport.create(MessageListener.class);\n        input.addListener(new RecordingListener());\n\n        EventListenerSupport<MessageListener> restored = SerializationSupport.roundTrip(input);\n        restored.fire().messageReceived(\"restored\");\n\n        assertThat(restored.getListeners()).hasSize(1);\n        assertThat(((RecordingListener) restored.getListeners()[0]).message).isEqualTo(\"restored\");\n    }\n\n    public interface MessageListener {\n        void messageReceived(String message);\n    }\n\n    public static class RecordingListener implements MessageListener, Serializable {\n        private String message;\n\n        @Override\n        public void messageReceived(String received) {\n            message = received;\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_3Q25FKgwc0mr6S55uvSy3cLZ|fc_08b27a44b4090f02016ad5f2933fe887d1bdd0a3f7089de08d", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/EventListenerSupportInnerProxyInvocationHandlerTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.ArrayList;\nimport java.util.List;\n\nimport org.apache.pulsar.shade.org.apache.commons.lang3.event.EventListenerSupport;\nimport org.junit.jupiter.api.Test;\n\npublic class EventListenerSupportInnerProxyInvocationHandlerTest {\n    @Test\n    void fireProxyDispatchesToEveryListener() {\n        EventListenerSupport<UpdateListener> support = EventListenerSupport.create(UpdateListener.class);\n        List<String> updates = new ArrayList<>();\n        support.addListener(value -> updates.add(\"first:\" + value));\n        support.addListener(value -> updates.add(\"second:\" + value));\n\n        support.fire().updated(\"ready\");\n\n        assertThat(updates).containsExactly(\"first:ready\", \"second:ready\");\n    }\n\n    public interface UpdateListener {\n        void updated(String value);\n    }\n}\n"}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-sol", "usage": {"input": 2321, "output": 2761, "cacheRead": 154624, "cacheWrite": 0, "reasoning": 433, "totalTokens": 159706, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1792406104445, "responseId": "resp_08b27a44b4090f02016ad5f259119087d1847622c673223055", "rawStopReason": "completed"}, "toolResults": [{"role": "toolResult", "toolCallId": "call_5eJyJln61eKjiquOav57LJCi|fc_08b27a44b4090f02016ad5f2933fa487d1b17ee9ac06fbc228", "toolName": "write", "content": [{"type": "text", "text": "Successfully wrote 1221 bytes to tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ReflectionTest.java"}], "isError": false, "timestamp": 1792406163516}, {"role": "toolResult", "toolCallId": "call_YP49scm99HueDkG8U97XlrzC|fc_08b27a44b4090f02016ad5f2933fb887d18b6f5176d1bd164b", "toolName": "write", "content": [{"type": "text", "text": "Successfully wrote 1140 byte