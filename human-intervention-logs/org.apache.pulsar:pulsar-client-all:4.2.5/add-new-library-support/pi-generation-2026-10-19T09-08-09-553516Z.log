", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport java.io.ByteArrayInputStream;\nimport java.io.ByteArrayOutputStream;\nimport java.io.ObjectInputStream;\nimport java.io.ObjectOutputStream;\n\npublic final class SerializationSupport {\n    private SerializationSupport() {\n    }\n\n    public static <T> T roundTrip(T value) throws Exception {\n        ByteArrayOutputStream bytes = new ByteArrayOutputStream();\n        try (ObjectOutputStream output = new ObjectOutputStream(bytes)) {\n            output.writeObject(value);\n        }\n        try (ObjectInputStream input = new ObjectInputStream(new ByteArrayInputStream(bytes.toByteArray()))) {\n            @SuppressWarnings(\"unchecked\")\n            T restored = (T) input.readObject();\n            return restored;\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792405903318}, {"role": "toolResult", "toolCallId": "call_Z7QzOXsljTT8mnZm8wVXKQfK|fc_08b27a44b4090f02016ad5f18f097487d1905ae20c1b9c87b9", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static java.util.Comparator.reverseOrder;\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.google.common.collect.TreeMultimap;\nimport org.junit.jupiter.api.Test;\n\npublic class TreeMultimapTest {\n    @Test\n    void roundTripPreservesComparatorsKeysAndValues() throws Exception {\n        TreeMultimap<String, String> input = TreeMultimap.create(reverseOrder(), reverseOrder());\n        input.put(\"letters\", \"a\");\n        input.put(\"letters\", \"c\");\n        input.put(\"letters\", \"b\");\n        input.put(\"numbers\", \"one\");\n\n        TreeMultimap<String, String> restored = SerializationSupport.roundTrip(input);\n\n        assertThat(restored).isEqualTo(input);\n        assertThat(restored.keySet()).containsExactly(\"numbers\", \"letters\");\n        assertThat(restored.get(\"letters\")).containsExactly(\"c\", \"b\", \"a\");\n        restored.put(\"greek\", \"omega\");\n        assertThat(restored.keySet()).containsExactly(\"numbers\", \"letters\", \"greek\");\n    }\n}\n"}], "isError": false, "timestamp": 1792405903319}, {"role": "toolResult", "toolCallId": "call_13iYmlbJ4RWuyYEfzBrSl4Lm|fc_08b27a44b4090f02016ad5f18f097c87d1acb0068f4756d556", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.ObjectMapper;\nimport org.junit.jupiter.api.Test;\n\npublic class FieldPropertyTest {\n    @Test\n    void deserializesAndUpdatesFieldBackedProperties() throws Exception {\n        ObjectMapper mapper = new ObjectMapper();\n        FieldBean created = mapper.readValue(\"{\\\"name\\\":\\\"created\\\",\\\"count\\\":3}\", FieldBean.class);\n        FieldBean updated = new FieldBean();\n\n        mapper.readerForUpdating(updated).readValue(\"{\\\"name\\\":\\\"updated\\\",\\\"count\\\":5}\");\n\n        assertThat(created.name).isEqualTo(\"created\");\n        assertThat(created.count).isEqualTo(3);\n        assertThat(updated.name).isEqualTo(\"updated\");\n        assertThat(updated.count).isEqualTo(5);\n    }\n\n    public static class FieldBean {\n        public String name;\n        public int count;\n\n        public FieldBean() {\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792405903319}, {"role": "toolResult", "toolCallId": "call_IUu4eL1UatAIWeM5pmR9Z8LY|fc_08b27a44b4090f02016ad5f18f098487d19f5b8650de548a20", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.Collections;\nimport java.util.Map;\n\nimport org.apache.pulsar.shade.javax.xml.bind.JAXBContext;\nimport org.apache.pulsar.shade.javax.xml.bind.JAXBContextFactory;\nimport org.apache.pulsar.shade.javax.xml.bind.JAXBException;\nimport org.apache.pulsar.shade.javax.xml.bind.Marshaller;\nimport org.apache.pulsar.shade.javax.xml.bind.Unmarshaller;\nimport org.apache.pulsar.shade.javax.xml.bind.Validator;\nimport org.junit.jupiter.api.Test;\n\npublic class ContextFinderTest {\n    @Test\n    void discoversClassArrayFactoryFromSystemProperty() throws Exception {\n        String previous = System.getProperty(JAXBContext.JAXB_CONTEXT_FACTORY);\n        System.setProperty(JAXBContext.JAXB_CONTEXT_FACTORY, TestContextFactory.class.getName());\n        try {\n            JAXBContext context = JAXBContext.newInstance(new Class<?>[] {BoundValue.class}, Collections.emptyMap());\n\n            assertThat(context).isInstanceOf(StubContext.class);\n            assertThat(((StubContext) context).source).isEqualTo(\"classes\");\n        } finally {\n            restoreFactory(previous);\n        }\n    }\n\n    @Test\n    void invokesLegacyContextPathFactoryContract() throws Exception {\n        String previous = System.getProperty(JAXBContext.JAXB_CONTEXT_FACTORY);\n        System.setProperty(JAXBContext.JAXB_CONTEXT_FACTORY, LegacyContextFactory.class.getName());\n        try {\n            JAXBContext context = JAXBContext.newInstance(\n                    \"org_apache_pulsar.pulsar_client_all\", getClass().getClassLoader(), Collections.emptyMap());\n\n            assertThat(context).isInstanceOf(StubContext.class);\n            assertThat(((StubContext) context).source).isEqualTo(\"legacy-path\");\n        } finally {\n            restoreFactory(previous);\n        }\n    }\n\n    private static void restoreFactory(String previous) {\n        if (previous == null) {\n            System.clearProperty(JAXBContext.JAXB_CONTEXT_FACTORY);\n        } else {\n            System.setProperty(JAXBContext.JAXB_CONTEXT_FACTORY, previous);\n        }\n    }\n\n    public static class BoundValue {\n    }\n\n    public static class TestContextFactory implements JAXBContextFactory {\n        public TestContextFactory() {\n        }\n\n        @Override\n        public JAXBContext createContext(Class<?>[] classes, Map<String, ?> properties) {\n            return new StubContext(\"classes\");\n        }\n\n        @Override\n        public JAXBContext createContext(String contextPath, ClassLoader classLoader, Map<String, ?> properties) {\n            return new StubContext(\"path\");\n        }\n    }\n\n    public static class LegacyContextFactory {\n        public static JAXBContext createContext(String contextPath, ClassLoader classLoader) {\n            return new StubContext(\"legacy-path\");\n        }\n    }\n\n    public static class StubContext extends JAXBContext {\n        private final String source;\n\n        StubContext(String source) {\n            this.source = source;\n        }\n\n        @Override\n        public Unmarshaller createUnmarshaller() throws JAXBException {\n            throw new JAXBException(\"not used\");\n        }\n\n        @Override\n        public Marshaller createMarshaller() throws JAXBException {\n            throw new JAXBException(\"not used\");\n        }\n\n        @Override\n        public Validator createValidator() throws JAXBException {\n            throw new JAXBException(\"not used\");\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792405903320}, {"role": "toolResult", "toolCallId": "call_mVQZyaeniogLdHHNCZUTvEba|fc_08b27a44b4090f02016ad5f18f099087d1b5e8a90a2337fe2e", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.it.unimi.dsi.fastutil.longs.Long2ObjectAVLTreeMap;\nimport org.junit.jupiter.api.Test;\n\npublic class Long2ObjectAVLTreeMapTest {\n    @Test\n    void roundTripPreservesSortedPrimitiveKeysAndValues() throws Exception {\n        Long2ObjectAVLTreeMap<String> input = new Long2ObjectAVLTreeMap<>();\n        input.put(30L, \"thirty\");\n        input.put(10L, \"ten\");\n        input.put(20L, \"twenty\");\n\n        Long2ObjectAVLTreeMap<String> restored = SerializationSupport.roundTrip(input);\n\n        assertThat(restored).isEqualTo(input);\n        assertThat(restored.keySet()).containsExactly(10L, 20L, 30L);\n        assertThat(restored.get(20L)).isEqualTo(\"twenty\");\n    }\n}\n"}], "isError": false, "timestamp": 1792405903320}]}
