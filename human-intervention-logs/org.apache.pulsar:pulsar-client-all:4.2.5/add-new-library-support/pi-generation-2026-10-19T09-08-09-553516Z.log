You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.fasterxml.jackson.annotation.JsonFormat;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.annotation.JsonPropertyOrder;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.ObjectMapper;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.annotation.JsonDeserialize;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.annotation.JsonPOJOBuilder;\nimport org.junit.jupiter.api.Test;\n\npublic class BeanAsArrayBuilderDeserializerTest {\n    @Test\n    void finishesArrayShapedObjectThroughBuilder() throws Exception {\n        ObjectMapper mapper = new ObjectMapper();\n\n        ArrayMessage message = mapper.readValue(\"[\\\"ready\\\",3]\", ArrayMessage.class);\n\n        assertThat(message.text).isEqualTo(\"ready\");\n        assertThat(message.priority).isEqualTo(3);\n    }\n\n    @JsonFormat(shape = JsonFormat.Shape.ARRAY)\n    @JsonPropertyOrder({\"text\", \"priority\"})\n    @JsonDeserialize(builder = ArrayMessageBuilder.class)\n    public static class ArrayMessage {\n        private final String text;\n        private final int priority;\n\n        private ArrayMessage(String text, int priority) {\n            this.text = text;\n            this.priority = priority;\n        }\n    }\n\n    @JsonPOJOBuilder(withPrefix = \"\")\n    public static class ArrayMessageBuilder {\n        private String text;\n        private int priority;\n\n        public ArrayMessageBuilder text(String value) {\n            text = value;\n            return this;\n        }\n\n        public ArrayMessageBuilder priority(int value) {\n            priority = value;\n            return this;\n        }\n\n        public ArrayMessage build() {\n            return new ArrayMessage(text, priority);\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792407111132}, {"role": "toolResult", "toolCallId": "call_m0zEZLdkjV8qkscisttzrf5h|fc_08b27a44b4090f02016ad5f645c6a087d1a88061ec2e985b02", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.fasterxml.jackson.annotation.JsonAlias;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.annotation.JsonProperty;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.introspect.JacksonAnnotationIntrospector;\nimport org.junit.jupiter.api.Test;\n\n@SuppressWarnings(\"deprecation\")\npublic class JacksonAnnotationIntrospectorTest {\n    @Test\n    void discoversEnumNamesAndAliases() {\n        JacksonAnnotationIntrospector introspector = new JacksonAnnotationIntrospector();\n        Status[] values = Status.values();\n        String[] names = {null, null};\n        String[][] aliases = new String[values.length][];\n\n        introspector.findEnumValues(Status.class, values, names);\n        introspector.findEnumAliases(Status.class, values, aliases);\n\n        assertThat(introspector.findEnumValue(Status.IN_PROGRESS)).isEqualTo(\"in-progress\");\n        assertThat(names).containsExactly(\"in-progress\", null);\n        assertThat(aliases[Status.DONE.ordinal()]).containsExactly(\"complete\", \"finished\");\n    }\n\n    private enum Status {\n        @JsonProperty(\"in-progress\")\n        IN_PROGRESS,\n        @JsonAlias({\"complete\", \"finished\"})\n        DONE\n    }\n}\n"}], "isError": false, "timestamp": 1792407111133}]}
