nt": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.org.apache.commons.compress.archivers.zip.AsiExtraField;\nimport org.apache.pulsar.shade.org.apache.commons.compress.archivers.zip.ExtraFieldUtils;\nimport org.apache.pulsar.shade.org.apache.commons.compress.archivers.zip.ZipExtraField;\nimport org.apache.pulsar.shade.org.apache.commons.compress.archivers.zip.ZipShort;\nimport org.junit.jupiter.api.Test;\n\npublic class ExtraFieldUtilsTest {\n    @Test\n    void registersAndRecreatesZipExtraFields() throws Exception {\n        AsiExtraField field = new AsiExtraField();\n        ZipShort headerId = field.getHeaderId();\n\n        ExtraFieldUtils.register(AsiExtraField.class);\n        ZipExtraField recreated = ExtraFieldUtils.createExtraFieldNoDefault(headerId);\n\n        assertThat(recreated).isInstanceOf(AsiExtraField.class).isNotSameAs(field);\n        assertThat(recreated.getHeaderId()).isEqualTo(headerId);\n    }\n}\n"}}, {"type": "toolCall", "id": "call_Q5Nhf4Nw0qnl2F6rQJoHfSbI|fc_0e54691b1a885b91016ad5ec60eb4c87d1ab0a9e6b2c7434a2", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ClassUtilsTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.lang.reflect.Method;\nimport java.util.List;\n\nimport org.apache.pulsar.shade.org.apache.commons.lang3.ClassUtils;\nimport org.junit.jupiter.api.Test;\n\npublic class ClassUtilsTest {\n    @Test\n    void resolvesClassNamesArraysAndPublicInterfaceMethods() throws Exception {\n        List<Class<?>> classes = ClassUtils.convertClassNamesToClasses(\n                List.of(\"java.lang.String\", \"java.util.ArrayList\", \"missing.Type\"));\n        Class<?> arrayClass = ClassUtils.getClass(getClass().getClassLoader(), \"java.lang.String[]\");\n        Method directMethod = ClassUtils.getPublicMethod(String.class, \"length\");\n        Method interfaceMethod = ClassUtils.getPublicMethod(HiddenGreeter.class, \"greet\", String.class);\n\n        assertThat(classes).containsExactly(String.class, java.util.ArrayList.class, null);\n        assertThat(arrayClass).isEqualTo(String[].class);\n        assertThat(directMethod.invoke(\"pulsar\")).isEqualTo(6);\n        assertThat(interfaceMethod.invoke(new HiddenGreeter(), \"client\")).isEqualTo(\"hello client\");\n    }\n\n    public interface Greeter {\n        String greet(String name);\n    }\n\n    private static class HiddenGreeter implements Greeter {\n        @Override\n        public String greet(String name) {\n            return \"hello \" + name;\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_PAtByP7f3W176tMSmGlMupf2|fc_0e54691b1a885b91016ad5ec60eb5487d1a8295be5bedd6352", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ObjectUtilsTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.org.apache.commons.lang3.ObjectUtils;\nimport org.junit.jupiter.api.Test;\n\npublic class ObjectUtilsTest {\n    @Test\n    void clonesPrimitiveArraysAndPubliclyCloneableObjects() {\n        int[] numbers = {1, 2, 3};\n        CloneableValue value = new CloneableValue(\"pulsar\");\n\n        int[] clonedNumbers = ObjectUtils.clone(numbers);\n        CloneableValue clonedValue = ObjectUtils.clone(value);\n\n        assertThat(clonedNumbers).containsExactly(1, 2, 3).isNotSameAs(numbers);\n        assertThat(clonedValue.text).isEqualTo(\"pulsar\");\n        assertThat(clonedValue).isNotSameAs(value);\n    }\n\n    public static class CloneableValue implements Cloneable {\n        private final String text;\n\n        public CloneableValue(String text) {\n            this.text = text;\n        }\n\n        @Override\n        public CloneableValue clone() {\n            try {\n                return (CloneableValue) super.clone();\n            } catch (CloneNotSupportedException exception) {\n                throw new AssertionError(exception);\n            }\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_oYaIajQPLYuPEAV4TxEOnzsX|fc_0e54691b1a885b91016ad5ec60eb6087d19eb2f5565b178200", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/SerializationUtilsTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.io.Serializable;\n\nimport org.apache.pulsar.shade.org.apache.commons.lang3.SerializationUtils;\nimport org.junit.jupiter.api.Test;\n\npublic class SerializationUtilsTest {\n    @Test\n    void serializesDeserializesAndClonesSerializableValues() {\n        SerializableValue input = new SerializableValue(\"pulsar\", 4);\n\n        byte[] bytes = SerializationUtils.serialize(input);\n        SerializableValue restored = SerializationUtils.deserialize(bytes);\n        SerializableValue cloned = SerializationUtils.clone(input);\n\n        assertThat(restored).usingRecursiveComparison().isEqualTo(input);\n        assertThat(cloned).usingRecursiveComparison().isEqualTo(input);\n        assertThat(cloned).isNotSameAs(input);\n    }\n\n    public static class SerializableValue implements Serializable {\n        private static final long serialVersionUID = 1L;\n\n        private final String name;\n        private final int count;\n\n        public SerializableValue(String name, int count) {\n            this.name = name;\n            this.count = count;\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_1sof2sEqg2HBWcWpmxfqZ7pk|fc_0e54691b1a885b91016ad5ec60eb6887d1bcf5bc8c1a9a8cad", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ReflectionToStringBuilderTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.org.apache.commons.lang3.builder.ReflectionToStringBuilder;\nimport org.apache.pulsar.shade.org.apache.commons.lang3.builder.ToStringStyle;\nimport org.junit.jupiter.api.Test;\n\npublic class ReflectionToStringBuilderTest {\n    @Test\n    void rendersPrivateFieldsAcrossAClassHierarchy() {\n        String rendered = ReflectionToStringBuilder.toString(\n                new ChildValue(\"client\", 4), ToStringStyle.SHORT_PREFIX_STYLE);\n\n        assertThat(rendered).contains(\"name=client\").contains(\"count=4\");\n    }\n\n    public static class ParentValue {\n        private final String name;\n\n        public ParentValue(String name) {\n            this.name = name;\n        }\n    }\n\n    public static class ChildValue extends ParentValue {\n        private final int count;\n\n        public ChildValue(String name, int count) {\n            super(name);\n            this.count = count;\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_6RjxOXXAcavnxGHiTq2RzUTd|fc_0e54691b1a885b91016ad5ec60eb7087d1839ea17ae3051237", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/CompareToBuilderTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.org.apache.commons.lang3.builder.CompareToBuilder;\nimport org.junit.jupiter.api.Test;\n\npublic class CompareToBuilderTest {\n    @Test\n    void comparesPrivateStateReflectively() {\n        RankedValue lower = new RankedValue(\"alpha\", 1);\n        RankedValue higher = new RankedValue(\"alpha\", 2);\n\n        assertThat(CompareToBuilder.reflectionCompare(lower, higher)).isNegative();\n        assertThat(CompareToBuilder.reflectionCompare(higher, lower)).isPositive();\n        assertThat(CompareToBuilder.reflectionCompare(lower, new RankedValue(\"alpha\", 1))).isZero();\n    }\n\n    public static class RankedValue {\n        private final String name;\n        private final int rank;\n\n        public RankedValue(String name, int rank) {\n            this.name = name;\n            this.rank = rank;\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_WgpibSUx6jsoj77EJ2wEDVj3|fc_0e54691b1a885b91016ad5ec60eb7887d1bf39c44e89101510", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/EqualsBuilderTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.org.apache.commons.lang3.builder.EqualsBuilder;\nimport org.junit.jupiter.api.Test;\n\npublic class EqualsBuilderTest {\n    @Test\n    void comparesPrivateStateReflectively() {\n        Value first = new Value(\"pulsar\", 4);\n\n        assertThat(EqualsBuilder.reflectionEquals(first, new Value(\"pulsar\", 4))).isTrue();\n        assertThat(EqualsBuilder.reflectionEquals(first, new Value(\"pulsar\", 5))).isFalse();\n    }\n\n    public static class Value {\n        private final String name;\n        private final int count;\n\n        public Value(String name, int count) {\n            this.name = name;\n            this.count = count;\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_OJqiUjbhKXFhDlKzARXO9es9|fc_0e54691b1a885b91016ad5ec60eb8487d1ba371bb5916fb622", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/HashCodeBuilderTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.org.apache.commons.lang3.builder.HashCodeBuilder;\nimport org.junit.jupiter.api.Test;\n\npublic class HashCodeBuilderTest {\n    @Test\n    void hashesPrivateStateReflectively() {\n        int first = HashCodeBuilder.reflectionHashCode(new Value(\"pulsar\", 4));\n        int matching = HashCodeBuilder.ref