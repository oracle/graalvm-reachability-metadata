son gson = new Gson();\n        ChildValue input = new ChildValue(\"parent\", \"child\");\n\n        String json = gson.toJson(input);\n        ChildValue restored = gson.fromJson(\"{\\\"parent\\\":\\\"base\\\",\\\"child\\\":\\\"leaf\\\"}\", ChildValue.class);\n\n        assertThat(json).contains(\"\\\"parent\\\":\\\"parent\\\"\").contains(\"\\\"child\\\":\\\"child\\\"\");\n        assertThat(restored.parent).isEqualTo(\"base\");\n        assertThat(restored.child).isEqualTo(\"leaf\");\n    }\n\n    public static class ParentValue {\n        private String parent;\n\n        public ParentValue() {\n        }\n\n        public ParentValue(String parent) {\n            this.parent = parent;\n        }\n    }\n\n    public static class ChildValue extends ParentValue {\n        private String child;\n\n        public ChildValue() {\n        }\n\n        public ChildValue(String parent, String child) {\n            super(parent);\n            this.child = child;\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_9gdDk9WHtQX2jigQFoYZ7EvW|fc_0e54691b1a885b91016ad5ecbf538c87d19ac8685e366395b5", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ReflectiveTypeAdapterFactoryInnerRecordAdapterTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.google.gson.Gson;\nimport org.junit.jupiter.api.Test;\n\npublic class ReflectiveTypeAdapterFactoryInnerRecordAdapterTest {\n    @Test\n    void constructsRecordFromCollectedComponentValues() {\n        Gson gson = new Gson();\n\n        Message restored = gson.fromJson(\"{\\\"topic\\\":\\\"persistent://events\\\",\\\"par