he.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/CloseShieldChannelTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.nio.ByteBuffer;\nimport java.nio.channels.SeekableByteChannel;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\n\nimport org.apache.pulsar.shade.org.apache.commons.io.channels.CloseShieldChannel;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.io.TempDir;\n\npublic class CloseShieldChannelTest {\n    @Test\n    void wrappedCloseLeavesUnderlyingChannelOpen(@TempDir Path temporaryDirectory) throws Exception {\n        Path output = temporaryDirectory.resolve(\"shielded.bin\");\n        try (SeekableByteChannel delegate = Files.newByteChannel(output,\n                java.nio.file.StandardOpenOption.CREATE, java.nio.file.StandardOpenOption.WRITE)) {\n            SeekableByteChannel shield = CloseShieldChannel.wrap(delegate);\n            shield.close();\n\n            assertThat(shield.isOpen()).isFalse();\n            assertThat(delegate.isOpen()).isTrue();\n            assertThat(delegate.write(ByteBuffer.wrap(new byte[] {1, 2, 3}))).isEqualTo(3);\n        }\n        assertThat(Files.readAllBytes(output)).containsExactly(1, 2, 3);\n    }\n}\n"}}, {"type": "toolCall", "id": "call_bAHAbuREtsWPGJtXDwWpbJKu|fc_08b27a44b4090f02016ad5f2db4db487d1888e1300a90a80b0", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/CloseShieldChannelHandlerTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.nio.ByteBuffer;\nimport java.nio.channels.SeekableByteChannel;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.nio.file.StandardOpenOption;\n\nimport org.apache.pulsar.shade.org.apache.commons.io.channels.CloseShieldChannel;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.io.TempDir;\n\npublic class CloseShieldChannelHandlerTest {\n    @Test\n    void proxyForwardsChannelOperations(@TempDir Path temporaryDirectory) throws Exception {\n        Path output = temporaryDirectory.resolve(\"forwarded.bin\");\n        try (SeekableByteChannel delegate = Files.newByteChannel(\n                output, StandardOpenOption.CREATE, StandardOpenOption.READ, StandardOpenOption.WRITE)) {\n            SeekableByteChannel shield = CloseShieldChannel.wrap(delegate);\n\n            assertThat(shield.write(ByteBuffer.wrap(new byte[] {4, 5, 6}))).isEqualTo(3);\n            assertThat(shield.position()).isEqualTo(3);\n            shield.position(0);\n            ByteBuffer bytes = ByteBuffer.allocate(3);\n            assertThat(shield.read(bytes)).isEqualTo(3);\n            assertThat(bytes.array()).containsExactly(4, 5, 6);\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_dTbnHOgXeKcoVX3vS14BlaoG|fc_08b27a44b4090f02016ad5f2db4dc087d1bd9547e5cf330662", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ObjectEncoderOutputStreamTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport jav