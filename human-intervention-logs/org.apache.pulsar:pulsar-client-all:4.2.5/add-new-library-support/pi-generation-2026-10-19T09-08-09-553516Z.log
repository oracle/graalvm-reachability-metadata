[tool-call] delta {"path":"tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ClientBuilderTest.java","content":"/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.javax.ws.rs.client.Client;\nimport org.apache.pulsar.shade.javax.ws.rs.client.ClientBuilder;\nimport org.junit.jupiter.api.Test;\n\npublic class ClientBuilderTest {\n    @Test\n    void discoversProviderAndBuildsClosableClient() {\n        ClientBuilder builder = ClientBuilder.newBuilder();\n        Client client = builder.build();\n        try {\n            assertThat(builder.getClass().getName()).contains(\"JerseyClientBuilder\");\n            assertThat(client.isRegistered(Object.class)).isFalse();\n        } finally {\n            client.close();\n        }\n    }\n}\n"}
