mitiveVarargsMethods() throws Exception {\n        InvocationTarget target = new InvocationTarget();\n\n        Object instance = MethodUtils.invokeMethod(\n                target,\n                \"total\",\n                new Object[] {\"items\", 2, 3, 4},\n                new Class<?>[] {String.class, Integer.class, Integer.class, Integer.class});\n        Object staticValue = MethodUtils.invokeStaticMethod(\n                InvocationTarget.class,\n                \"staticTotal\",\n                new Object[] {\"items\", 5, 6},\n                new Class<?>[] {String.class, Integer.class, Integer.class});\n        Object exact = MethodUtils.invokeExactMethod(\n                target, \"echo\", new Object[] {\"exact\"}, new Class<?>[] {String.class});\n        Object exactStatic = MethodUtils.invokeExactStaticMethod(\n                InvocationTarget.class, \"staticEcho\", new Object[] {\"value\"}, new Class<?>[] {String.class});\n\n        assertThat(instance).isEqualTo(\"items:9\");\n        assertThat(staticValue).isEqualTo(\"items:11\");\n        assertThat(exact).isEqualTo(\"exact\");\n        assertThat(exactStatic).isEqualTo(\"VALUE\");\n    }\n\n    @Test\n    void searchesInterfacesHierarchiesAndAnnotatedMethods() {\n        Method interfaceMethod = MethodUtils.getAccessibleMethod(HiddenGreeter.class, \"greet\", String.class);\n        Method matching = MethodUtils.getMatchingMethod(ChildTarget.class, \"describe\", Integer.class);\n        List<Method> publicAnnotated = MethodUtils.getMethodsListWithAnnotation(\n                AnnotatedChild.class, Marker.class, true, false);\n        List<Method> allAnnotated = MethodUtils.getMethodsListWithAnnotation(\n                AnnotatedChild.class, Marker.class, true, true);\n\n        assertThat(interfaceMethod).isNotNull();\n        assertThat(interfaceMethod.getDeclaringClass()).isEqualTo(Greeter.class);\n        assertThat(matching).isNotNull();\n        assertThat(matching.getDeclaringClass()).isEqualTo(ChildTarget.class);\n        assertThat(publicAnnotated).extracting(Method::getName).contains(\"visible\").doesNotContain(\"hidden\");\n        assertThat(allAnnotated).extracting(Method::getName).contains(\"visible\", \"hidden\");\n        assertThat(MethodUtils.getMethodObject(InvocationTarget.class, \"echo\", String.class)).isNotNull();\n    }\n\n    public interface Greeter {\n        String greet(String value);\n    }\n\n    @Retention(RetentionPolicy.RUNTIME)\n    @Target(ElementType.METHOD)\n    public @interface Marker {\n    }\n\n    public static class InvocationTarget {\n        public String total(String label, int... values) {\n            return label + \":\" + sum(values);\n        }\n\n        public static String staticTotal(String label, int... values) {\n            return label + \":\" + sum(values);\n        }\n\n        public String echo(String value) {\n            return value;\n        }\n\n        public static String staticEcho(String value) {\n            return value.toUpperCase();\n        }\n\n        private static int sum(int[] values) {\n            int result = 0;\n            for (int value : values) {\n                result += value;\n            }\n            return result;\n        }\n    }\n\n    static class HiddenGreeter implements Greeter {\n        @Override\n        public String greet(String value) {\n            return \"hello \" + value;\n        }\n    }\n\n    public static class ParentTarget {\n        public String describe(Number value) {\n            return \"number:\" + value;\n        }\n    }\n\n    public static class ChildTarget extends ParentTarget {\n        public String describe(Integer value) {\n            return \"integer:\" + value;\n        }\n    }\n\n    public static class AnnotatedParent {\n        @Marker\n        public void visible() {\n        }\n    }\n\n    public static class AnnotatedChild extends AnnotatedParent {\n        @Marker\n        private void hidden() {\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_A6t1YN98eGGEFYCey0gTIHON|fc_04c9418095f9a914016ad5e10c1aec87d1a82afc10ff005666", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ReflectDataTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.io.IOException;\n\nimport org.apache.pulsar.shade.org.apache.avro.Protocol;\nimport org.apache.pulsar.shade.org.apache.avro.Schema;\nimport org.apache.pulsar.shade.org.apache.avro.io.Decoder;\nimport org.apache.pulsar.shade.org.apache.avro.io.Encoder;\nimport org.apache.pulsar.shade.org.apache.avro.reflect.AvroEncode;\nimport org.apache.pulsar.shade.org.apache.avro.reflect.CustomEncoding;\nimport org.apache.pulsar.shade.org.apache.avro.reflect.ReflectData;\nimport org.apache.pulsar.shade.org.apache.avro.specific.SpecificData;\nimport org.junit.jupiter.api.Test;\n\npublic class ReflectDataTest {\n    @Test\n    void derivesDefaultsFieldsProtocolsAndArrayClasses() {\n        ReflectData data = new ReflectData();\n        data.setDefaultsGenerated(true);\n\n        Schema recordSchema = data.getSchema(DefaultRecord.class);\n        Protocol protocol = data.getProtocol(EchoService.class);\n        Class<?> arrayClass = data.getClass(Schema.createArray(Schema.create(Schema.Type.STRING)));\n\n        assertThat(recordSchema.getField(\"text\").defaultVal()).isEqualTo(\"default text\");\n        assertThat(recordSchema.getField(\"count\").defaultVal()).isEqualTo(3);\n        assertThat(protocol.getMessages()).containsKey(\"echo\");\n        assertThat(arrayClass).isEqualTo(String[].class);\n    }\n\n    @Test\n    void createsAndCachesCustomFieldAndTypeEncodings() {\n        ReflectData data = new ReflectData();\n\n        Schema typeSchema = data.getSchema(EncodedValue.class);\n        Schema fieldSchema = data.getSchema(EncodedRecord.class).getField(\"value\").schema();\n        Schema cacheSchema = Schema.create(Schema.Type.STRING);\n        cacheSchema.addProp(SpecificData.CLASS_PROP, EncodedValue.class.getName());\n        CustomEncoding<?> cached = data.getCustomEncoding(cacheSchema);\n\n        assertThat(typeSchema.getType()).isEqualTo(Schema.Type.STRING);\n        assertThat(fieldSchema.getType()).isEqualTo(Schema.Type.STRING);\n        assertThat(cached).isInstanceOf(ValueEncoding.class);\n    }\n\n    public interface EchoService {\n        String echo(String value);\n    }\n\n    public static class DefaultRecord {\n        public String text = \"default text\";\n        public int count = 3;\n\n        public DefaultRecord() {\n        }\n    }\n\n    @AvroEncode(using = ValueEncoding.class)\n    public static class EncodedValue {\n        private final String text;\n\n        public EncodedValue() {\n            this(\"empty\");\n        }\n\n        public EncodedValue(String text) {\n            this.text = text;\n        }\n    }\n\n    public static class EncodedRecord {\n        @AvroEncode(using = ValueEncoding.class)\n        public EncodedValue value = new EncodedValue(\"field\");\n\n        public EncodedRecord() {\n        }\n    }\n\n    public static class ValueEncoding extends CustomEncoding<EncodedValue> {\n        public ValueEncoding() {\n            schema = Schema.create(Schema.Type.STRING);\n        }\n\n        @Override\n        protected void write(Object datum, Encoder output) throws IOException {\n            output.writeString(((EncodedValue) datum).text);\n        }\n\n        @Override\n        protected EncodedValue read(Object reuse, Decoder input) throws IOException {\n            return new EncodedValue(input.readString().toString());\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_bSEI6UprW65SG9Mc35TgvOt7|fc_04c9418095f9a914016ad5e10c1af887d1a5160572de4b2540", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/SerializationTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.io.ByteArrayInputStream;\nimport java.io.ByteArrayOutputStream;\nimport java.io.ObjectInputStream;\nimport java.io.ObjectOutputStream;\nimport java.io.Serializable;\n\nimport org.apache.pulsar.shade.com.google.common.collect.ArrayListMultimap;\nimport org.apache.pulsar.shade.com.google.common.collect.HashBiMap;\nimport org.apache.pulsar.shade.com.google.common.collect.HashMultiset;\nimport org.junit.jupiter.api.Test;\n\npublic class SerializationTest {\n    @Test\n    void preservesMapMultisetAndMultimapEntries() throws Exception {\n        HashBiMap<String, Integer> map = HashBiMap.create();\n        map.put(\"one\", 1);\n        map.put(\"two\", 2);\n        HashMultiset<String> multiset = HashMultiset.create();\n        multiset.add(\"red\", 2);\n        multiset.add(\"blue\", 3);\n        ArrayListMultimap<String, String> multimap = ArrayListMultimap.create();\n        multimap.put(\"letters\", \"a\");\n        multimap.put(\"letters\", \"b\");\n\n        HashBiMap<String, Integer> restoredMap = roundTrip(map);\n        HashMultiset<String> restoredMultiset = roundTrip(multiset);\n        ArrayListMultimap<String, String> restoredMultimap = roundTrip(multimap);\n\n        assertThat(restoredMap).isEqualTo(map);\n        assertThat(restoredMap.inverse().get(2)).isEqualTo(\"two\");\n        assertThat(restoredMultiset.count(\"red\")).isEqualTo(2);\n        assertThat(restoredMultiset.count(\"blue\")).isEqualTo(3);\n        assertThat(restoredMultimap.get(\"letters\")).containsExactly(\"a\", \"b\");\n    }\n\n    private static <T extends Serializable> T roundTrip(T value) throws Exception {\n        ByteArrayOutputStream bytes = new ByteArrayOutputStream();\n        try (ObjectOutputStream output = new ObjectOutputStream(bytes)) {\n            output.writeObject(value);\n        }\n        try (ObjectInputStream input = new ObjectInputStream(new ByteArrayInputStream(bytes.toByteArray()))) {\n            @SuppressWarnings(\"unchecked\")\n            T restored = (T) input.readObject();\n            return restored;\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_XbUgwQnkvJXcoV3IWrnfsL98|fc_04c9418095f9a914016ad5e10c1b0087d1a99e8b67adc87403", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/JdkAlpnSslUtilsTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.List;\nimport java.util.function.BiFunction;\n\nimport javax.net.ssl.SSLEngine;\n\nimport org.apache.pulsar.shade.io.netty.buffer.ByteBufAllocator;\nimport org.apache.pulsar.shade.io.netty.handler.ssl.ApplicationProtocolConfig;\nimport org.apache.pulsar.shade.io.netty.handler.ssl.ApplicationProtocolConfig.Protocol;\nimport org.apache.pulsar.shade.io.netty.handler.ssl.ApplicationProtocolConfig.SelectedListenerFailureBehavior;\nimport org.apache.pulsar.shade.io.netty.handler.ssl.ApplicationProtocolConfig.SelectorFailureBehavior;\nimport org.apache.pulsar.shade.io.netty.handler.ssl.SslContext;\nimport org.apache.pulsar.shade.io.netty.handler.ssl.SslContextBuilder;\nimport org.apache.pulsar.shade.io.netty.handler.ssl.SslProvider;\nimport org.junit.jupiter.api.Test;\n\npublic class JdkAlpnSslUtilsTest {\n    @Test\n    void configuresAndQueriesJdkAlpnEngine() throws Exception {\n        ApplicationProtocolConfig protocols = new ApplicationProtocolConfig(\n                Protocol.ALPN,\n                SelectorFailureBehavior.NO_ADVERTISE,\n                SelectedListenerFailureBehavior.ACCEPT,\n                \"h2\",\n                \"http/1.1\");\n        SslContext context = SslContextBuilder.forClient()\n                .sslProvider(SslProvider.JDK)\n                .applicationProtocolConfig(protocols)\n                .build();\n        SSLEngine engine = context.newEngine(ByteBufAllocator.DEFAULT);\n        BiFunction<SSLEngine, List<String>, String> selector = (ignored, offered) -> offered.get(0);\n\n        engine.setHandshakeApplicationProtocolSelector(selector);\n\n        assertThat(engine.getHandshakeApplicationProtocolSelector()).isSameAs(selector);\n        assertThat(engine.getApplicationProtocol()).isNotNull();\n        assertThat(engine.getHandshakeApplicationProtocol()).isNull();\n        assertThat(engine.getSSLParameters().getApplicationProtocols()).containsExactly(\"h2\", \"http/1.1\");\n    }\n}\n"}}, {"type": "toolCall", "id": "call_M7FXjtW2edcayVgov0JFehuo|fc_04c9418095f9a914016ad5e10c1b0887d18b882b0c87bbd9d6", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ClassUtilTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.lang.annotation.Retention;\nimport java.lang.annotation.RetentionPolicy;\nimport java.lang.reflect.Constructor;\nimport java.lang.reflect.Field;\nimport java.lang.reflect.Method;\n\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.util.ClassUtil;\nimport org.junit.jupiter.api.Test;\n\npublic class ClassUtilTest {\n    @Test\n    void createsInstancesAndExposesClassMembers() {\n        Constructed value = ClassUtil.createInstance(Constructed.class, false);\n        Constructor<Constructed> constructor = ClassUtil.findConstructor(Constructed.class, false);\n        ClassUtil.Ctor[] constructors = ClassUtil.getConstructors(Constructed.class);\n        Field[] fields = ClassUtil.getDeclaredFields(Constructed.class);\n        Method[] declaredMethods = ClassUtil.getDeclaredMethods(Constructed.class);\n        Method[] classMethods = ClassUtil.getClassMethods(Constructed.class);\n\n        assertThat(value.name()).isEqualTo(\"created\");\n        assertThat(constructor).isNotNull();\n        assertThat(constructors).isNotEmpty();\n        assertThat(fields).extracting(Field::getName).contains(\"name\");\n        assertThat(declaredMethods).extracting(Method::getName).contains(\"name\");\n        assertThat(classMethods).extracting(Method::getName).contains(\"name\", \"toString\");\n    }\n\n    @Test\n    void findsAnnotatedEnumConstant() {\n        Enum<?> result = ClassUtil.findFirstAnnotatedEnumValue(\n                annotatedEnumClass(), Preferred.class);\n\n        assertThat(result).isEqualTo(Choice.SECOND);\n    }\n\n    @SuppressWarnings({\"unchecked\", \"rawtypes\"})\n    private static Class<Enum<?>> annotatedEnumClass() {\n        return (Class) Choice.class;\n    }\n\n    @Retention(RetentionPolicy.RUNTIME)\n    public @interface Preferred {\n    }\n\n    public enum Choice {\n        FIRST,\n        @Preferred\n        SECOND\n    }\n\n    public static class Constructed {\n        private final String name;\n\n        public Constructed() {\n            name = \"created\";\n        }\n\n        public String name() {\n            return name;\n  