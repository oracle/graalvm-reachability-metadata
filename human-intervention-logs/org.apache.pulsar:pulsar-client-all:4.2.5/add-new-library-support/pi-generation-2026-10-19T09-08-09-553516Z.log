d rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static java.util.Map.entry;\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.google.common.collect.LinkedListMultimap;\nimport org.junit.jupiter.api.Test;\n\npublic class LinkedListMultimapTest {\n    @Test\n    void roundTripPreservesGlobalAndPerKeyEntryOrder() throws Exception {\n        LinkedListMultimap<String, Integer> input = LinkedListMultimap.create();\n        input.put(\"first\", 1);\n        input.put(\"second\", 20);\n        input.put(\"first\", 2);\n        input.put(\"second\", 30);\n\n        LinkedListMultimap<String, Integer> restored = SerializationSupport.roundTrip(input);\n\n        assertThat(restored).isEqualTo(input);\n        assertThat(restored.entries()).containsExactly(\n                entry(\"first\", 1), entry(\"second\", 20), entry(\"first\", 2), entry(\"second\", 30));\n        assertThat(restored.get(\"first\")).containsExactly(1, 2);\n    }\n}\n"}}, {"type": "toolCall", "id": "call_Pm3lF8NpjhbyWfQZMLbFuZiY|fc_0e54691b1a885b91016ad5ec02dd1c87d18e411a9faf7c0255", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/TreeMultimapTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static java.util.Comparator.reverseOrder;\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.google.common.collect.TreeMultimap;\nimport org.junit.jupiter.api.Test;\n\npublic class TreeMultimapTest {\n    @Test\n    void roundTripPreservesComparatorsKeysAndValues() throws Exception {\n        TreeMultimap<String, String> input = TreeMultimap.create(reverseOrder(), reverseOrder());\n        input.put(\"letters\", \"a\");\n        input.put(\"letters\", \"c\");\n        input.put(\"letters\", \"b\");\n        input.put(\"numbers\", \"one\");\n\n        TreeMultimap<String, String> restored = SerializationSupport.roundTrip(input);\n\n        assertThat(restored).isEqualTo(input);\n        assertThat(restored.keySet()).containsExactly(\"numbers\", \"letters\");\n        assertThat(restored.get(\"letters\")).containsExactly(\"c\", \"b\", \"a\");\n        restored.put(\"greek\", \"omega\");\n        assertThat(restored.keySet()).containsExactly(\"numbers\", \"letters\", \"greek\");\n    }\n}\n"}}, {"type": "toolCall", "id": "call_FtYSHRIAhv6x0DlCjZ3zyGuX|fc_0e54691b1a885b91016ad5ec02dd2887d1a54ffa846073bde0", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/EnumBiMapTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.google.common.collect.EnumBiMap;\nimport org.junit.jupiter.api.Test;\n\npublic class EnumBiMapTest {\n    @Test\n    void roundTripPreservesEnumTypesAndInverseMappings() throws Exception {\n        EnumBiMap<Priority, Status> input = EnumBiMap.create(Priority.class, Status.class);\n        input.put(Priority.LOW, Status.QUEUED);\n        input.put(Priority.HIGH, Status.RUNNING);\n\n        EnumBiMap<Priority, Status> restored = SerializationSupport.roundTrip(input);\n\n        assertThat(restored).isEqualTo(input);\n        assertThat(restored.keyType()).isSameAs(Priority.class);\n        assertThat(restored.valueType()).isSameAs(Status.class);\n        assertThat(restored.inverse().get(Status.RUNNING)).isSameAs(Priority.HIGH);\n    }\n\n    public enum Priority {\n        LOW,\n        HIGH\n    }\n\n    public enum Status {\n        QUEUED,\n        RUNNING\n    }\n}\n"}}, {"type": "toolCall", "id": "call_AzqUUG6eAEVtPxIOdTcjaMA3|fc_0e54691b1a885b91016ad5ec02dd3087d18108b708dbca5c93", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/MapMakerInternalMapInnerAbstractSerializationProxyTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.concurrent.ConcurrentMap;\nimport java.util.concurrent.TimeUnit;\n\nimport org.apache.pulsar.shade.com.google.common.collect.MapMaker;\nimport org.junit.jupiter.api.Test;\n\npublic class MapMakerInternalMapInnerAbstractSerializationProxyTest {\n    @Test\n    void roundTripPreservesWeakValueMapConfigurationAndEntries() throws Exception {\n        ConcurrentMap<String, TimeUnit> input = new MapMaker().weakValues().concurrencyLevel(2).makeMap();\n        input.put(\"short\", TimeUnit.SECONDS);\n        input.put(\"long\", TimeUnit.DAYS);\n\n        ConcurrentMap<String, TimeUnit> restored = SerializationSupport.roundTrip(input);\n\n        assertThat(restored).containsEntry(\"short\", TimeUnit.SECONDS).containsEntry(\"long\", TimeUnit.DAYS);\n        assertThat(restored.getClass().getName()).contains(\"MapMakerInternalMap\");\n    }\n}\n"}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-sol", "usage": {"input": 4100, "output": 1864, "cacheRead": 165376, "cacheWrite":