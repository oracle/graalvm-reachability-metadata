[tool-exec] start id=call_Y90vd5XCD0XaB8GIeWN5CSjf|fc_08b27a44b4090f02016ad5f4b7f23887d19d7e1c152c6bd18e name=write args={"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/GeneralUtilitiesTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.org.glassfish.hk2.utilities.general.GeneralUtilities;\nimport org.junit.jupiter.api.Test;\n\npublic class GeneralUtilitiesTest {\n    @Test\n    void loadsOrdinaryAndArrayClasses() {\n        ClassLoader loader = getClass().getClassLoader();\n\n        assertThat(GeneralUtilities.loadClass(loader, \"java.lang.String\")).isEqualTo(String.class);\n        assertThat(GeneralUtilities.loadClass(loader, \"[[Ljava.lang.String;\"))\n                .isEqualTo(String[][].class);\n    }\n}\n"}
[tool-exec] start id=call_yj8YP3tXLSUOZH7cLbZQZYKs|fc_08b27a44b4090f02016ad5f4b7f24087d1a1347565b1f13899 name=write args={"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/HK2LoaderImplTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.org.glassfish.hk2.utilities.HK2LoaderImpl;\nimport org.junit.jupiter.api.Test;\n\npublic class HK2LoaderImplTest {\n    @Test\n    void loadsClassThroughConfiguredLoader() {\n        HK2LoaderImpl loader = new HK2LoaderImpl(getClass().getClassLoader());\n\n        Class<?> loaded = loader.loadClass(\"org.apache.pulsar.client.api.PulsarClient\");\n\n        assertThat(loaded.getName()).isEqualTo(\"org.apache.pulsar.client.api.PulsarClient\");\n    }\n}\n"}
[tool-exec] start id=call_1JyiH9pVGICt1JVfFq5InjjB|fc_08b27a44b4090f02016ad5f4b7f24c87d1b418b83080fdb528 name=write args={"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/BeanReflectionHelperTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.Map;\n\nimport org.apache.pulsar.shade.org.glassfish.hk2.utilities.reflection.BeanReflectionHelper;\nimport org.apache.pulsar.shade.org.glassfish.hk2.utilities.reflection.internal.ClassReflectionHelperImpl;\nimport org.junit.jupiter.api.Test;\n\npublic class BeanReflectionHelperTest {\n    @Test\n    void convertsJavaBeanGettersToPropertyMap() {\n        ClassReflectionHelperImpl helper = new ClassReflectionHelperImpl();\n        try {\n            Map<String, Object> properties = BeanReflectionHelper.convertJavaBeanToBeanLikeMap(\n                    helper, new ClientSettings(\"persistent\", 3));\n\n            assertThat(properties).containsEntry(\"mode\", \"persistent\").containsEntry(\"retries\", 3);\n        } finally {\n            helper.clean(new ClientSettings(\"unused\", 0).getClass());\n        }\n    }\n\n    public static class ClientSettings {\n        private final String mode;\n        private final int retries;\n\n        public ClientSettings(String mode, int retries) {\n            this.mode = mode;\n            this.retries = retries;\n        }\n\n        public String getMode() {\n            return mode;\n        }\n\n        public int getRetries() {\n            return retries;\n        }\n    }\n}\n"}
