[tool-call] delta {"path":"tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/VersionTest.java","content":"/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.Map;\n\nimport org.apache.pulsar.shade.io.netty.util.Version;\nimport org.junit.jupiter.api.Test;\n\npublic class VersionTest {\n    @Test\n    void identifiesBundledNettyArtifactsFromPropertiesResources() {\n        Map<String, Version> versions = Version.identify(getClass().getClassLoader());\n\n        assertThat(versions).isNotEmpty();\n        assertThat(versions.values())\n                .allSatisfy(version -> assertThat(version.artifactId()).isNotBlank());\n    }\n}\n"}
