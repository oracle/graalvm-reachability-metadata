ublic static FactoryValue valueOf(String value) {\n            return new FactoryValue(value.toUpperCase(java.util.Locale.ROOT));\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_4U9eNJ8BFqWNpuWvLAvrW5bg|fc_08b27a44b4090f02016ad5f4b7f22c87d1b680511b13f2b38f", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/MultivaluedStringMapTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.org.glassfish.jersey.internal.util.collection.MultivaluedStringMap;\nimport org.junit.jupiter.api.Test;\n\npublic class MultivaluedStringMapTest {\n    @Test\n    void convertsFirstValueWithBothTypedOverloads() {\n        MultivaluedStringMap values = new MultivaluedStringMap();\n        values.putSingle(\"count\", \"42\");\n        values.putSingle(\"priority\", \"7\");\n\n        NumericValue count = values.getFirst(\"count\", NumericValue.class);\n        NumericValue priority = values.getFirst(\"priority\", new NumericValue(\"0\"));\n\n        assertThat(count.value).isEqualTo(42);\n        assertThat(priority.value).isEqualTo(7);\n        assertThat(values.getFirst(\"missing\", new NumericValue(\"5\")).value).isEqualTo(5);\n    }\n\n    public static class NumericValue {\n        private final int value;\n\n        public NumericValue(String value) {\n            this.value = Integer.parseInt(value);\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_Y90vd5XCD0XaB8GIeWN5CSjf|fc_08b27a44b4090f02016ad5f4b7f23887d19d7e1c152c6bd18e", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_cli