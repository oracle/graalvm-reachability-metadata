kage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.LoaderOptions;\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.Yaml;\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.constructor.Constructor;\nimport org.junit.jupiter.api.Test;\n\npublic class SnakeYamlConstructorTest {\n    @Test\n    void loadsNamedRootClass() throws Exception {\n        Constructor constructor = new Constructor(Settings.class.getName(), new LoaderOptions());\n\n        Settings settings = new Yaml(constructor).load(\"mode: persistent\\nretries: 4\");\n\n        assertThat(settings.mode).isEqualTo(\"persistent\");\n        assertThat(settings.retries).isEqualTo(4);\n    }\n\n    public static class Settings {\n        public String mode;\n        public int retries;\n    }\n}\n"}}, {"type": "toolCall", "id": "call_8Z9uNw3TJ9LUMVqbl0HDdy0F|fc_08b27a44b4090f02016ad5f5eb6a6087d1a0fbb6686d0e5e89", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ConstructorInnerConstructScalarTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.LoaderOptions;\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.Yaml;\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.constructor.Constructor;\nimport org.junit.jupiter.api.Test;\n\npublic class ConstructorInnerConstructScalarTest {\n    @Test\n    void createsScalarThroughSingleArgumentConstructor() {\n        Yaml yaml = new Yaml(new Constructor(ScalarValue.class, new LoaderOptions()));\n\n        ScalarValue value = yaml.load(\"message\