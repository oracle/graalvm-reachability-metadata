ath": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/EnumTypeAdapterTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.google.gson.Gson;\nimport org.apache.pulsar.shade.com.google.gson.annotations.SerializedName;\nimport org.junit.jupiter.api.Test;\n\npublic class EnumTypeAdapterTest {\n    @Test\n    void mapsSerializedNamesAlternatesAndToStringFallbacks() {\n        Gson gson = new Gson();\n\n        assertThat(gson.toJson(WorkflowState.STARTED)).isEqualTo(\"\\\"started\\\"\");\n        assertThat(gson.fromJson(\"\\\"queued\\\"\", WorkflowState.class)).isEqualTo(WorkflowState.STARTED);\n        assertThat(gson.fromJson(\"\\\"done\\\"\", WorkflowState.class)).isEqualTo(WorkflowState.FINISHED);\n    }\n\n    public enum WorkflowState {\n        @SerializedName(value = \"started\", alternate = {\"queued\", \"running\"})\n        STARTED,\n        FINISHED;\n\n        @Override\n        public String toString() {\n            return this == FINISHED ? \"done\" : name();\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_P4MjKzkBb6Cn2vtQCk3DcYor|fc_0e54691b1a885b91016ad5ecbf537487d184555ea9a86dcbee", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ConstructorConstructorTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\nimport static org.assertj.core.api.Assertions.assertThatThrownBy;\n\nimport org.apache.pulsar.shade.com.google.gson.Gson;\nimport org.apache.pulsar.shade.com.google.gson.GsonBuilder;\nimport org.apache.pulsar.shade.com.google.gson.JsonIOException;\nimport org.junit.jupiter.api.Test;\n\npublic class ConstructorConstructorTest {\n    @Test\n    void invokesNoArgumentConstructorDuringDeserialization() {\n        ConstructedValue value = new Gson().fromJson(\"{\\\"name\\\":\\\"pulsar\\\"}\", ConstructedValue.class);\n\n        assertThat(value.name).isEqualTo(\"pulsar\");\n        assertThat(value.constructorCalled).isTrue();\n    }\n\n    @Test\n    void reportsMissingNoArgumentConstructorWhenUnsafeIsDisabled() {\n        Gson gson = new GsonBuilder().disableJdkUnsafe().create();\n\n        assertThatThrownBy(() -> gson.fromJson(\"{\\\"name\\\":\\\"pulsar\\\"}\", ConstructorOnlyValue.class))\n                .isInstanceOf(JsonIOException.class)\n                .hasMessageContaining(\"Unable to create instance\")\n                .hasMessageContaining(\"JDK Unsafe is disabled\");\n    }\n\n    public static class ConstructedValue {\n        private String name;\n        private boolean constructorCalled;\n\n        public ConstructedValue() {\n            constructorCalled = true;\n        }\n    }\n\n    public static class ConstructorOnlyValue {\n        private String name;\n\n        public ConstructorOnlyValue(String name) {\n            this.name = name;\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_4zCSbZUaiZUWzVrRhUdrSO0l|fc_0e54691b1a885b91016ad5ecbf537c87d195958d516551fe6f", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ReflectiveTypeAdapterFactoryAnonymous2Test.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.google.gson.Gson;\nimport org.junit.jupiter.api.Test;\n\npublic class ReflectiveTypeAdapterFactoryAnonymous2Test {\n    @Test\n    void readsAndWritesPrivateFieldsThroughBoundFields() {\n        Gson gson = new Gson();\n        PrivateFields input = new PrivateFields(\"client\", 4);\n\n        String json = gson.toJson(input);\n        PrivateFields restored = gson.fromJson(\"{\\\"name\\\":\\\"admin\\\",\\\"count\\\":7}\", PrivateFields.class);\n\n        assertThat(json).contains(\"\\\"name\\\":\\\"client\\\"\").contains(\"\\\"count\\\":4\");\n        assertThat(restored.name).isEqualTo(\"admin\");\n        assertThat(restored.count).isEqualTo(7);\n    }\n\n    public static class PrivateFields {\n        private String name;\n        private int count;\n\n        public PrivateFields() {\n        }\n\n        public PrivateFields(String name, int count) {\n            this.name = name;\n            this.count = count;\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_EvBerVMTMe5TYVRNjp9yLed4|fc_0e54691b1a885b91016ad5ecbf538487d18491220aeda86c48", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ReflectiveTypeAdapterFactoryTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.google.gson.Gson;\nimport org.junit.jupiter.api.Test;\n\npublic class ReflectiveTypeAdapterFactoryTest {\n    @Test\n    void discoversInheritedFieldsForReflectiveMapping() {\n        Gson gson = new Gson();\n        ChildValue input = new ChildValue(\"parent\", \"child\");\n\n        String json = gson.toJson(input);\n        ChildValue restored = gson.fromJson(\"{\\\"parent\\\":\\\"base\\\",\\\"child\\\":\\\"leaf\\\"}\", ChildValue.class);\n\n        assertThat(json).contains(\"\\\"parent\\\":\\\"parent\\\"\").contains(\"\\\"child\\\":\\\"child\\\"\");\n        assertThat(restored.parent).isEqualTo(\"base\");\n        assertThat(restored.child).isEqualTo(\"leaf\");\n    }\n\n    public static class ParentValue {\n        private String parent;\n\n        public ParentValue() {\n        }\n\n        public ParentValue(String parent) {\n            this.parent = parent;\n        }\n    }\n\n    public static class ChildValue extends ParentValue {\n        private String child;\n\n        public ChildValue() {\n        }\n\n        public ChildValue(String parent, String child) {\n            super(parent);\n            this.child = child;\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_9gdDk9WHtQX2jigQFoYZ7EvW|fc_0e54691b1a885b91016ad5ecbf538c87d19ac8685e366395b5", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ReflectiveTypeAdapterFactoryInnerRecordAdapterTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.google.gson.Gson;\nimport org.junit.jupiter.api.Test;\n\npublic class ReflectiveTypeAdapterFactoryInnerRecordAdapterTest {\n    @Test\n    void constructsRecordFromCollectedComponentValues() {\n        Gson gson = new Gson();\n\n        Message restored = gson.fromJson(\"{\\\"topic\\\":\\\"persistent://events\\\",\\\"partit