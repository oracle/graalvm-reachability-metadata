.fasterxml.jackson.databind.ObjectMapper;\nimport org.junit.jupiter.api.Test;\n\npublic class StdKeyDeserializerInnerStringFactoryKeyDeserializerTest {\n    @Test\n    void createsMapKeyThroughStringFactory() throws Exception {\n        ObjectMapper mapper = new ObjectMapper();\n\n        Map<FactoryKey, Integer> result = mapper.readValue(\n                \"{\\\"message\\\":9}\", new TypeReference<Map<FactoryKey, Integer>>() { });\n\n        assertThat(result).hasSize(1);\n        assertThat(result.keySet().iterator().next().value).isEqualTo(\"MESSAGE\");\n        assertThat(result.values()).containsExactly(9);\n    }\n\n    public static class FactoryKey {\n        private final String value;\n\n        private FactoryKey(String value) {\n            this.value = value;\n        }\n\n        public static FactoryKey valueOf(String value) {\n            return new FactoryKey(value.toUpperCase(java.util.Locale.ROOT));\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_K4MU69q2X1oIVeMzaBcSHOZI|fc_08b27a44b4090f02016ad5f39726ac87d190ff9ef49f6abd11", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/BuilderBasedDeserializerTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.ObjectMapper;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.annotation.JsonDeserialize;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.annotation.JsonPOJOBuilder;\nimport org.junit.jupiter.api.Test;\n\npublic class BuilderBasedDeserializerTest {\n    @Test\n    void finishesObjectThroughConfiguredBuilder() throws Exception {\n        ObjectMapper mapper = new ObjectMapper();\n\n        BuiltMessage message = mapper.readValue(\"{\\\"text\\\":\\\"ready\\\"}\", BuiltMessage.class);\n\n        assertThat(message.text).isEqualTo(\"ready\");\n    }\n\n    @JsonDeserialize(builder = MessageBuilder.class)\n    public static class BuiltMessage {\n        private final String text;\n\n        private BuiltMessage(String text) {\n            this.text = text;\n        }\n    }\n\n    @JsonPOJOBuilder(withPrefix = \"\")\n    public static class MessageBuilder {\n        private String text;\n\n        public MessageBuilder text(String value) {\n            text = value;\n            return this;\n        }\n\n        public BuiltMessage build() {\n            return new BuiltMessage(text);\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_sY09DF8wMdc4MlVMOSVNviKm|fc_08b27a44b4090f02016ad5f39726c487d1bf560630fe78263c", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/BeanAsArrayBuilderDeserializerTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.fasterxml.jackson.annotation.JsonFormat;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.annotation.JsonPropertyOrder;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.ObjectMapper;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.annotation.JsonDeserialize;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.annotation.JsonPOJOBuilder;\nimport org.junit.jupiter.api.Test;\n\npublic class BeanAsArrayBuilderDeserializerTest {\n    @Test\n    void finishesArrayShapedObjectThroughBuilder() thr