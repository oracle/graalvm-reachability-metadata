[tool-call] delta {"path":"tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ConcurrentHashMultisetTest.java","content":"/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.google.common.collect.ConcurrentHashMultiset;\nimport org.junit.jupiter.api.Test;\n\npublic class ConcurrentHashMultisetTest {\n    @Test\n    void roundTripPreservesCountsAndAtomicUpdates() throws Exception {\n        ConcurrentHashMultiset<String> input = ConcurrentHashMultiset.create();\n        input.add(\"message\", 3);\n        input.add(\"other\", 1);\n\n        ConcurrentHashMultiset<String> restored = SerializationSupport.roundTrip(input);\n\n        assertThat(restored.count(\"message\")).isEqualTo(3);\n        assertThat(restored.removeExactly(\"message\", 2)).isTrue();\n        assertThat(restored.count(\"message\")).isEqualTo(1);\n        assertThat(restored.count(\"other\")).isEqualTo(1);\n    }\n}\n"}
