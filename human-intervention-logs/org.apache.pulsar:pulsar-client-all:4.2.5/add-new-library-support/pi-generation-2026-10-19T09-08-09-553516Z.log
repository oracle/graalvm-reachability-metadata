[tool-exec] start id=call_jtDbx9ZP7GE0DJBt3ytjKxgM|fc_08b27a44b4090f02016ad5f2db4df087d1b9470abd69f8707f name=write args={"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ClassLoaderClassResolverTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.io.netty.handler.codec.serialization.ClassResolver;\nimport org.apache.pulsar.shade.io.netty.handler.codec.serialization.ClassResolvers;\nimport org.junit.jupiter.api.Test;\n\npublic class ClassLoaderClassResolverTest {\n    @Test\n    void resolvesClassThroughConfiguredLoader() throws Exception {\n        ClassResolver resolver = ClassResolvers.weakCachingResolver(getClass().getClassLoader());\n\n        Class<?> resolved = resolver.resolve(\"org.apache.pulsar.client.api.PulsarClient\");\n\n        assertThat(resolved.getName()).isEqualTo(\"org.apache.pulsar.client.api.PulsarClient\");\n    }\n}\n"}
[tool-exec] start id=call_h37FZ0NBxfN5vVwCfy7m2CPI|fc_08b27a44b4090f02016ad5f2db4df887d19d9e0cb0f7f5d3d5 name=write args={"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/VersionTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.Map;\n\nimport org.apache.pulsar.shade.io.netty.util.Version;\nimport org.junit.jupiter.api.Test;\n\npublic class VersionTest {\n    @Test\n    void identifiesBundledNettyArtifactsFromPropertiesResources() {\n        Map<String, Version> versions = Version.identify(getClass().getClassLoader());\n\n        assertThat(versions).isNotEmpty();\n        assertThat(versions.values())\n                .allSatisfy(version -> assertThat(version.artifactId()).isNotBlank());\n    }\n}\n"}
