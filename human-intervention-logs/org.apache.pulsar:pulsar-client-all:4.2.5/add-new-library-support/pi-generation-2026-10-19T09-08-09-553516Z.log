ent_all;\n\nimport java.io.ByteArrayInputStream;\nimport java.io.ByteArrayOutputStream;\nimport java.io.ObjectInputStream;\nimport java.io.ObjectOutputStream;\n\npublic final class SerializationSupport {\n    private SerializationSupport() {\n    }\n\n    public static <T> T roundTrip(T value) throws Exception {\n        ByteArrayOutputStream bytes = new ByteArrayOutputStream();\n        try (ObjectOutputStream output = new ObjectOutputStream(bytes)) {\n            output.writeObject(value);\n        }\n        try (ObjectInputStream input = new ObjectInputStream(new ByteArrayInputStream(bytes.toByteArray()))) {\n            @SuppressWarnings(\"unchecked\")\n            T restored = (T) input.readObject();\n            return restored;\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_cBLmfuHTzjNozrgIYsx0wJ9d|fc_0e54691b1a885b91016ad5eb8d597887d1b28679f18941a709", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/JvmDefaultGCMetricsLoggerTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.Map;\n\nimport org.apache.pulsar.common.stats.JvmDefaultGCMetricsLogger;\nimport org.apache.pulsar.common.stats.Metrics;\nimport org.junit.jupiter.api.Test;\n\npublic class JvmDefaultGCMetricsLoggerTest {\n    @Test\n    void refreshesGarbageCollectorAndSafepointMetrics() {\n        JvmDefaultGCMetricsLogger logger = new JvmDefaultGCMetricsLogger();\n\n        logger.refresh();\n        logger.refresh();\n        Metrics metrics = Metrics.create(Map.of(\"component\", \"client\"));\n        logger.logMetrics(metrics);\n\n        assertThat(metrics.getDimensions()).containsEntry(\"component\", \"client\");\n        assertThat(metrics.getMetrics()).containsKeys(\"jvm_full_gc_pause\", \"jvm_full_gc_count\");\n        assertThat(metrics.getMetrics().get(\"jvm_full_gc_pause\")).isInstanceOf(Long.class);\n        assertThat(metrics.getMetrics().get(\"jvm_full_gc_count\")).isInstanceOf(Long.class);\n    }\n}\n"}}, {"type": "toolCall", "id": "call_51dI1ZmCPtFCdUnVEvuK12Mt|fc_0e54691b1a885b91016ad5eb8d598887d1a7e13cdb4aaea624", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/JvmMetricsTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.List;\n\nimport org.apache.pulsar.common.stats.JvmG1GCMetricsLogger;\nimport org.apache.pulsar.common.stats.JvmMetrics;\nimport org.apache.pulsar.common.stats.Metrics;\nimport org.junit.jupiter.api.Test;\n\npublic class JvmMetricsTest {\n    @Test\n    void createsConfiguredGarbageCollectorLoggerByClassName() {\n        JvmMetrics metrics = JvmMetrics.create(null, \"client\", JvmG1GCMetricsLogger.class.getName());\n\n        List<Metrics> generated = metrics.generate();\n\n        assertThat(generated).hasSize(1);\n        assertThat(generated.get(0).getDimensions()).containsEntry(\"metric\", \"jvm_metrics\");\n        assertThat(generated.get(0).getMetrics())\n                .containsKeys(\"jvm_gc_young_pause\", \"jvm_gc_old_pause\", \"client_default_pool_allocated\");\n    }\n}\n"}}, {"type": "toolCall", "id": "call_ezgZJTXDZNBcaArxq4DHyYyH|fc_0e54691b1a885b91016ad5eb8d599487d1817b9920538df32d", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar