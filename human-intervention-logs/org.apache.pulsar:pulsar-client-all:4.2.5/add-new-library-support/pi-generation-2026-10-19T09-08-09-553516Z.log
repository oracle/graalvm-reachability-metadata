e org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.LoaderOptions;\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.Yaml;\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.constructor.Constructor;\nimport org.junit.jupiter.api.Test;\n\npublic class SnakeYamlConstructorTest {\n    @Test\n    void loadsNamedRootClass() throws Exception {\n        Constructor constructor = new Constructor(Settings.class.getName(), new LoaderOptions());\n\n        Settings settings = new Yaml(constructor).load(\"mode: persistent\\nretries: 4\");\n\n        assertThat(settings.mode).isEqualTo(\"persistent\");\n        assertThat(settings.retries).isEqualTo(4);\n    }\n\n    public static class Settings {\n        public String mode;\n        public int retries;\n    }\n}\n"}}, {"type": "toolCall", "id": "call_8Z9uNw3TJ9LUMVqbl0HDdy0F|fc_08b27a44b4090f02016ad5f5eb6a6087d1a0fbb6686d0e5e89", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ConstructorInnerConstructScalarTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.LoaderOptions;\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.Yaml;\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.constructor.Constructor;\nimport org.junit.jupiter.api.Test;\n\npublic class ConstructorInnerConstructScalarTest {\n    @Test\n    void createsScalarThroughSingleArgumentConstructor() {\n        Yaml yaml = new Yaml(new Constructor(ScalarValue.class, new LoaderOptions()));\n\n        ScalarValue value = yaml.load(\"message\");\n\n        assertThat(value.text).isEqualTo(\"message\");\n    }\n\n    public static class ScalarValue {\n        private final String text;\n\n        public ScalarValue(String text) {\n            this.text = text;\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_zaItZxZW6RZzDch27tqm6OOW|fc_08b27a44b4090f02016ad5f5eb6a6c87d19d3b325ce3f1a258", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ConstructorInnerConstructSequenceTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.LoaderOptions;\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.Yaml;\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.constructor.Constructor;\nimport org.junit.jupiter.api.Test;\n\npublic class ConstructorInnerConstructSequenceTest {\n    @Test\n    void createsImmutableValueThroughSequenceConstructor() {\n        Yaml yaml = new Yaml(new Constructor(SequenceValue.class, new LoaderOptions()));\n\n        SequenceValue value = yaml.load(\"[message, 5]\");\n\n        assertThat(value.text).isEqualTo(\"message\");\n        assertThat(value.priority).isEqualTo(5);\n    }\n\n    public static class SequenceValue {\n        private final String text;\n        private final int priority;\n\n        public SequenceValue(String text, int priority) {\n            this.text = text;\n            this.priority = priority;\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_Wg5IL3XVc6xmdd9Bgl0Gcf9d|fc_08b27a44b4090f02016ad5f5eb6a7487d194a5ff3e46f76941", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/BaseConstructorTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.LoaderOptions;\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.Yaml;\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.constructor.Constructor;\nimport org.junit.jupiter.api.Test;\n\npublic class BaseConstructorTest {\n    @Test\n    void createsBeanAndTypedArray() {\n        Yaml yaml = new Yaml(new Constructor(ArraySettings.class, new LoaderOptions()));\n\n        ArraySettings settings = yaml.load(\"values: [one, two]\");\n\n        assertThat(settings.values).containsExactly(\"one\", \"two\");\n        assertThat(settings.values.getClass()).isEqualTo(String[].class);\n    }\n\n    public static class ArraySettings {\n        public String[] values;\n    }\n}\n"}}, {"type": "toolCall", "id": "call_J2tDiOMgVlnPVlc0aKA9dkKv|fc_08b27a44b4090f02016ad5f5eb6a7c87d1bd119fc4f50acd83", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/TypeDescriptionTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.LoaderOptions;\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.TypeDescription;\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.Yaml;\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.constructor.Constructor;\nimport org.junit.jupiter.api.Test;\n\npublic class TypeDescriptionTest {\n    @Test\n    void createsDescribedTypeAndAppliesProperties() {\n        TypeDescription description = new TypeDescription(DescribedSettings.class);\n        Yaml yaml = new Yaml(new Constructor(description, new LoaderOptions()));\n\n        DescribedSettings settings = yaml.load(\"name: configured\");\n\n        assertThat(settings.name).isEqualTo(\"configured\");\n    }\n\n    public static class DescribedSettings {\n        public String name;\n    }\n}\n"}}, {"type": "toolCall", "id": "call_Fe45AN4vmGpUo2kf5a2Im7UY|fc_08b27a44b4090f02016ad5f5eb6a8487d1bade1ccbdb5fa5f6", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/SnakeYamlFieldPropertyTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.LoaderOptions;\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.Yaml;\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.constructor.Constructor;\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.introspector.BeanAccess;\nimport org.junit.jupiter.api.Test;\n\npublic class SnakeYamlFieldPropertyTest {\n    @Test\n    void readsAndWritesFieldBackedProperty() {\n        Constructor constructor = new Constructor(FieldSettings.class, new LoaderOptions());\n        constructor.getPropertyUtils().setBeanAccess(BeanAccess.FIELD);\n\n        FieldSettings settings = new Yaml(constructor).load(\"name: field-value\");\n\n        assertThat(settings.name).isEqualTo(\"field-value\");\n    }\n\n    public static class FieldSettings {\n        public String name;\n    }\n}\n"}}, {"typ