three\", 3);\n        assertThat(restored).containsEntry(\"three\", 3);\n    }\n}\n"}}, {"type": "toolCall", "id": "call_etWJ6fL09ADJVMykXiG1GBPo|fc_08b27a44b4090f02016ad5f22d04d087d1a4f2f0ad8c45c10a", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/CompactHashSetTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.google.common.collect.CompactHashSet;\nimport org.junit.jupiter.api.Test;\n\npublic class CompactHashSetTest {\n    @Test\n    void roundTripPreservesElementsAndMutability() throws Exception {\n        CompactHashSet<String> input = CompactHashSet.create(\"alpha\", \"beta\");\n\n        CompactHashSet<String> restored = SerializationSupport.roundTrip(input);\n\n        assertThat(restored).containsExactlyInAnyOrder(\"alpha\", \"beta\");\n        assertThat(restored.add(\"gamma\")).isTrue();\n        assertThat(restored).contains(\"gamma\");\n    }\n}\n"}}, {"type": "toolCall", "id": "call_kllhKCwQK1qauOXUPz8wVOyY|fc_08b27a44b4090f02016ad5f22d04d887d19495220e5330cd62", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ImmutableSetMultimapTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.google.common.collect.ImmutableSetMultimap;\nimport org.junit.jupiter.api.Test;\n\npublic class ImmutableSetMultimapTest {\n    @Test\n    void roundTripPreservesDistinctValues() throws Exception {\n        ImmutableSetMultimap<String, String> input = ImmutableSetMultimap.<String, String>builder()\n                .put(\"letters\", \"a\")\n                .put(\"letters\", \"b\")\n                .put(\"letters\", \"a\")\n                .put(\"numbers\", \"one\")\n                .build();\n\n        ImmutableSetMultimap<String, String> restored = SerializationSupport.roundTrip(input);\n\n        assertThat(restored).isEqualTo(input);\n        assertThat(restored.get(\"letters\")).containsExactlyInAnyOrder(\"a\", \"b\");\n        assertThat(restored.inverse().get(\"one\")).containsExactly(\"numbers\");\n    }\n}\n"}}, {"type": "toolCall", "id": "call_4h4J1ZXOtLTX1fX7IHDM0zZy|fc_08b27a44b4090f02016ad5f22d04e487d1982d862756a97dbf", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ImmutableListMultimapTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.google.common.collect.ImmutableListMultimap;\nimport org.junit.jupiter.api.Test;\n\npublic class ImmutableListMultimapTest {\n    @Test\n    void roundTripPreservesValueOrderAndDuplicates() throws Exception {\n        ImmutableListMultimap<String, String> input = ImmutableListMultimap.<String, String>builder()\n                .put(\"letters\", \"a\")\n                .put(\"letters\", \"b\")\n                .put(\"letters\", \"a\")\n                .build();\n\n        ImmutableListMultimap<String, String> restored = SerializationSupport.roundTrip(input);\n\n        assertThat(restored).isEqualTo(input);\n        assertThat(restored.get(\"letters\")).containsExactly(\"a\", \"b\", \"a\");\n        assertThat(restored.inverse().get(\"a\")).containsExactly(\"letters\", \"letters\");\n    }\n}\n"}}, {"type": "toolCall", "id": "call_BUCBxpLJCeiOUGUYeAJxA8tY|fc_08b27a44b4090f02016ad5f22d04ec87d18e399f94d6a8e607", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ConcurrentHashMultisetTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.google.common.collect.ConcurrentHashMultiset;\nimport org.junit.jupiter.api.Test;\n\npublic class ConcurrentHashMultisetTest {\n    @Test\n    void roundTripPreservesCountsAndAtomicUpdates() throws Exception {\n        ConcurrentHashMultiset<String> input = ConcurrentHashMultiset.create();\n        input.add(\"message\", 3);\n        input.add(\"other\", 1);\n\n        ConcurrentHashMultiset<String> restored = SerializationSupport.roundTrip(input);\n\n        assertThat(restored.count(\"message\")).isEqualTo(3);\n        assertThat(restored.removeExactly(\"message\", 2)).isTrue();\n        assertThat(restored.count(\"message\")).isEqualTo(1);\n        assertThat(restored.count(\"other\")).isEqualTo(1);\n    }\n}\n"}}, {"type": "toolCall", "id": "call_S7p9qtIlNxewWJtB7gOVIN4W|fc_08b27a44b4090f02016ad5f22d04f487d1a125dcddbb7e7b14", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/EnumHashBiMapTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have rece