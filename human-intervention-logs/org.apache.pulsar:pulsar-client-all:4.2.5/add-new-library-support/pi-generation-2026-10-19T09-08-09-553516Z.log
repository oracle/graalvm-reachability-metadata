r.api.Test;\n\npublic class EnumsTest {\n    @Test\n    void returnsFieldDeclaringRequestedEnumConstant() {\n        Field field = Enums.getField(State.READY);\n\n        assertThat(field.getName()).isEqualTo(\"READY\");\n        assertThat(field.getDeclaringClass()).isEqualTo(State.class);\n        assertThat(field.isEnumConstant()).isTrue();\n    }\n\n    private enum State {\n        READY\n    }\n}\n"}}, {"type": "toolCall", "id": "call_6MVlhSoshMxo8KaLdOSPgjuX|fc_08b27a44b4090f02016ad5f3e12c1c87d1b434f21ebe5b703c", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ArrayTableTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.List;\n\nimport org.apache.pulsar.shade.com.google.common.collect.ArrayTable;\nimport org.junit.jupiter.api.Test;\n\npublic class ArrayTableTest {\n    @Test\n    void exportsTypedTwoDimensionalArray() {\n        ArrayTable<String, String, String> table = ArrayTable.create(\n                List.of(\"row-one\", \"row-two\"), List.of(\"left\", \"right\"));\n        table.put(\"row-one\", \"left\", \"a\");\n        table.put(\"row-one\", \"right\", \"b\");\n        table.put(\"row-two\", \"left\", \"c\");\n        table.put(\"row-two\", \"right\", \"d\");\n\n        String[][] values = table.toArray(String.class);\n\n        assertThat(values).isDeepEqualTo(new String[][] {{\"a\", \"b\"}, {\"c\", \"d\"}});\n        assertThat(values.getClass()).isEqualTo(String[][].class);\n    }\n}\n"}}, {"type": "toolCall", "id": "call_4N02tzooRT1pmEJa02FHmLzm|fc_08b27a44b4090f02016ad5f3e12c2887d18fdc4fcea4fcaf0d", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/InvokableInnerConstructorInvokableTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.google.common.reflect.Invokable;\nimport org.junit.jupiter.api.Test;\n\npublic class InvokableInnerConstructorInvokableTest {\n    @Test\n    void invokesRepresentedConstructor() throws Exception {\n        Invokable<Message, Message> constructor = Invokable.from(Message.class.getConstructor(String.class));\n\n        Message message = constructor.invoke(null, \"created\");\n\n        assertThat(message.value).isEqualTo(\"created\");\n        assertThat(constructor.getReturnType().getRawType()).isEqualTo(Message.class);\n    }\n\n    public static class Message {\n        private final String value;\n\n        public Message(String value) {\n            this.value = value;\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_Tj1HAnU8NGPrhFwMcT3pjiW0|fc_08b27a44b4090f02016ad5f3e12c2c87d1b89e4b4efcc1d340", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/InvokableInnerMethodInvokableTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.google.common.reflect.Invokable;\nimport org.junit.jupiter.api.Test;\n\npublic class InvokableInnerMethodInvokableTest {\n    @Test\n    void invokesRepresentedInstanceMethod() throws Exception {\n        Invokable<?, Object> method = Invokable.from(Message.class.getMethod(\"decorate\", String.class));\n\n        Object result = method.invoke(new Message(\"payload\"), \"received\");\n\n        assertThat(result).isEqualTo(\"received:payload\");\n        assertThat(method.getName()).isEqualTo(\"decorate\");\n    }\n\n    public static class Message {\n        private final String value;\n\n        public Message(String value) {\n            this.value = value;\n        }\n\n        public String decorate(String prefix) {\n            return prefix + \":\" + value;\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_ebGcbTSSUykgMQ8wCYjKDog4|fc_08b27a44b4090f02016ad5f3e12c3887d18a88eb825868c11d", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/FuturesGetCheckedTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThatThrownBy;\n\nimport org.apache.pulsar.shade.com.google.common.util.concurrent.Futures;\nimport org.junit.jupiter.api.Test;\n\npublic class FuturesGetCheckedTest {\n    @Test\n    void wrapsFailedFutureInRequestedCheckedException() {\n        IllegalStateException failure = new IllegalStateException(\"unavailable\");\n\n        assertThatThrownBy(() -> Futures.getChecked(Futures.immediateFailedFuture(failure), ClientException.class))\n                .isInstanceOf(ClientException.class)\n                .hasCause(failure);\n    }\n\n    public static class ClientException extends Exception {\n        public ClientException(String message, Throwable cause) {\n            super(message, cause);\n        }\n\n        public ClientException(Throwable cause) {\n            super(cause);\n        }\n    }\n}\n"}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-sol", "usage": {"input": 707, "output": 1699, "cacheRead": 183808, "cacheWrite": 0, "reasoning": 94, "totalTokens": 186214, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1792406459281, "responseId": "resp_08b27a44b4090f02016ad5f3bbf6d887d1919c77e0557718e0", "rawStopReason": "completed"}, "toolResults": [{"role": "toolResult", "toolCallId": "call_UFALW8QGqq3HbTMWs6LkFpB4|fc_08b27a44b4090f02016ad5f3e12c0c87d18d63ca6645a2fb74", "toolName": "write", "content": [{"type": "text", "text": "Successfully wrote 814 bytes to tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/EnumsTest.java"}], "isError": false, "timestamp": 1792406497472}, {"role": "toolResult", "toolCallId": "call_6MVlhSoshMxo8KaLdOSPgjuX|fc_08b27a44b4090f02016ad5f3e12c1c87d1b434f21ebe5b703c", "toolName": "write", "content": [{"type": "text", "text": "Successfully wrote 1057 bytes to tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ArrayTableTest.java"}], "isError": false, "timestamp": 1792406497473}, {"role": "toolResult", "toolCallId": "call_4N02tzooRT1pmEJa02FHmLzm|fc_08b27a44b4090f02016ad5f3e12c2887d18fdc4fcea4fcaf0d", "toolName": "write", "content": [{"type": "text", "text": "Successfully wrote 1021 bytes to tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/InvokableInnerConstructorInvokableTest.java"}], "isError": false, "timestamp": 1792406497473}, {"role": "toolResult", "toolCallId": "call_Tj1HAnU8NGPrhFwMcT3pjiW0|fc_08b27a44b4090f02016ad5f3e12c2c87d1b89e4b4efcc1d340", "toolName": "write", "content": [{"type": "text", "text": "Successfully wrote 1101 bytes to tests/src/org.apache.pulsar/pulsar-cli