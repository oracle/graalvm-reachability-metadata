       *        serialized object
       */
      public ObjectDecoderInputStream(InputStream in, ClassLoader classLoader) {
          this(in, classLoader, 1048576);
      }
  
      /**
       * Creates a new {@link ObjectInput}.
       *
       * @param in
       *        the {@link InputStream} where the serialized form will be
