[tool-exec] start id=call_l1pPthuh9aorTFRzYRh9d17u|fc_07e64c7a1924f579016ad21bd449a887d1878513fa570864a2 name=write args={"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/StdKeyDeserializerInnerStringFactoryKeyDeserializerTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.Map;\n\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.ObjectMapper;\nimport org.junit.jupiter.api.Test;\n\npublic class StdKeyDeserializerInnerStringFactoryKeyDeserializerTest {\n    @Test\n    void createsMapKeysWithStaticStringFactory() throws Exception {\n        final KeyedValues values = new ObjectMapper().readValue(\n                \"{\\\"values\\\":{\\\"alpha\\\":\\\"first\\\"}}\", KeyedValues.class);\n\n        assertThat(values.values).containsEntry(FactoryKey.valueOf(\"alpha\"), \"first\");\n    }\n\n    public static final class KeyedValues {\n        public Map<FactoryKey, String> values;\n    }\n\n    public static final class FactoryKey {\n        private final String value;\n\n        private FactoryKey(String configuredValue, boolean fromFactory) {\n            value = configuredValue;\n        }\n\n        public static FactoryKey valueOf(String value) {\n            return new FactoryKey(value, true);\n        }\n\n        @Override\n        public boolean equals(Object other) {\n            return other instanceof FactoryKey && value.equals(((FactoryKey) other).value);\n        }\n\n        @Override\n        public int hashCode() {\n            return value.hashCode();\n        }\n    }\n}\n"}
[tool-exec] start id=call_rvmfOzbEUkK1xwSNXYQ50bjc|fc_07e64c7a1924f579016ad21bd449b087d19bd92c37e5c42238 name=write args={"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/BuilderBasedDeserializerTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.ObjectMapper;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.annotation.JsonDeserialize;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.annotation.JsonPOJOBuilder;\nimport org.junit.jupiter.api.Test;\n\npublic class BuilderBasedDeserializerTest {\n    @Test\n    void invokesBuilderCompletionMethod() throws Exception {\n        final BuiltValue value = new ObjectMapper().readValue(\"{\\\"name\\\":\\\"events\\\"}\", BuiltValue.class);\n\n        assertThat(value.name).isEqualTo(\"events\");\n    }\n\n    @JsonDeserialize(builder = Builder.class)\n    public static final class BuiltValue {\n        private final String name;\n\n        private BuiltValue(String configuredName) {\n            name = configuredName;\n        }\n    }\n\n    @JsonPOJOBuilder(withPrefix = \"\")\n    public static final class Builder {\n        public String name;\n\n        public BuiltValue build() {\n            return new BuiltValue(name);\n        }\n    }\n}\n"}
[tool-exec] start id=call_uHA0dTppT27GJJU4Upr9zTHl|fc_07e64c7a1924f579016ad21bd449b887d18a9a1e43281345a9 name=write args={"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/AnnotatedMethodCollectorTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.fasterxml.jackson.annotation.JsonIgnore;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.annotation.JsonProperty;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.JsonNode;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.ObjectMapper;\nimport org.junit.jupiter.api.Test;\n\npublic class AnnotatedMethodCollectorTest {\n    @Test\n    void appliesMethodMixInDuringBeanIntrospection() throws Exception {\n        final ObjectMapper mapper = new ObjectMapper();\n        mapper.addMixIn(MethodBean.class, MethodMixin.class);\n        final MethodBean bean = new MethodBean(\"events\", \"hidden\");\n\n        final JsonNode tree = mapper.readTree(mapper.writeValueAsString(bean));\n\n        assertThat(tree.get(\"external_name\").asText()).isEqualTo(\"events\");\n        assertThat(tree.has(\"secret\")).isFalse();\n    }\n\n    private abstract static class MethodMixin {\n        @JsonProperty(\"external_name\")\n        abstract String getName();\n\n        @JsonIgnore\n        abstract String getSecret();\n    }\n\n    public static final class MethodBean {\n        private final String name;\n        private final String secret;\n\n        public MethodBean(String configuredName, String configuredSecret) {\n            name = configuredName;\n            secret = configuredSecret;\n        }\n\n        public String getName() {\n            return name;\n        }\n\n        public String getSecret() {\n            return secret;\n        }\n    }\n}\n"}
[tool-exec] start id=call_AE736iVB3bVTrN6pTZUraZGd|fc_07e64c7a1924f579016ad21bd449c487d18315b02a2ae6f9db name=write args={"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/AnnotatedFieldCollectorTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.fasterxml.jackson.annotation.JsonIgnore;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.annotation.JsonProperty;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.JsonNode;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.ObjectMapper;\nimport org.junit.jupiter.api.Test;\n\npublic class AnnotatedFieldCollectorTest {\n    @Test\n    void appliesFieldMixInDuringBeanIntrospection() throws Exception {\n        final ObjectMapper mapper = new ObjectMapper();\n        mapper.addMixIn(FieldBean.class, FieldMixin.class);\n\n        final JsonNode tree = mapper.readTree(mapper.writeValueAsString(new FieldBean()));\n\n        assertThat(tree.get(\"external_name\").asText()).isEqualTo(\"events\");\n        assertThat(tree.has(\"secret\")).isFalse();\n    }\n\n    private abstract static class FieldMixin {\n        @JsonProperty(\"external_name\")\n        public String name;\n\n        @JsonIgnore\n        public String secret;\n    }\n\n    public static final class FieldBean {\n        public String name = \"events\";\n        public String secret = \"hidden\";\n    }\n}\n"}
