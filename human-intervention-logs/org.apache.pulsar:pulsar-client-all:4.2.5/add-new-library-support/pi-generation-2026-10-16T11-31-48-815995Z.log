[tool-call] delta {"path":"tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/CompactHashMapTest.java","content":"/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.google.common.collect.CompactHashMap;\nimport org.junit.jupiter.api.Test;\n\npublic class CompactHashMapTest {\n    @Test\n    void preservesEntriesAcrossSerialization() throws Exception {\n        final CompactHashMap<String, Integer> values = CompactHashMap.create();\n        values.put(\"partitions\", 4);\n        values.put(\"replicas\", 3);\n\n        final CompactHashMap<String, Integer> restored = SerializationTestSupport.roundTrip(values);\n        assertThat(restored).containsEntry(\"partitions\", 4).containsEntry(\"replicas\", 3);\n    }\n}\n"}
