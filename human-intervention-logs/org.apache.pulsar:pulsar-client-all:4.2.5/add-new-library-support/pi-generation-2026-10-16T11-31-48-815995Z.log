r/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/AnnotationUtilsTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.lang.annotation.Retention;\nimport java.lang.annotation.RetentionPolicy;\n\nimport org.apache.pulsar.shade.org.apache.commons.lang3.AnnotationUtils;\nimport org.junit.jupiter.api.Test;\n\npublic class AnnotationUtilsTest {\n    @Test\n    void comparesFormatsAndHashesRuntimeAnnotations() {\n        final Descriptor first = First.class.getAnnotation(Descriptor.class);\n        final Descriptor second = Second.class.getAnnotation(Descriptor.class);\n        final Descriptor different = Different.class.getAnnotation(Descriptor.class);\n\n        assertThat(AnnotationUtils.equals(first, second)).isTrue();\n        assertThat(AnnotationUtils.equals(first, different)).isFalse();\n        assertThat(AnnotationUtils.hashCode(first)).isEqualTo(first.hashCode());\n        assertThat(AnnotationUtils.toString(first)).contains(\"name=events\", \"partitions=[1,2,3]\");\n    }\n\n    @Retention(RetentionPolicy.RUNTIME)\n    public @interface Descriptor {\n        String name();\n\n        int[] partitions();\n    }\n\n    @Descriptor(name = \"events\", partitions = {1, 2, 3})\n    public static final class First {\n    }\n\n    @Descriptor(name = \"events\", partitions = {1, 2, 3})\n    public static final class Second {\n    }\n\n    @Descriptor(name = \"other\", partitions = {5})\n    public static final class Different {\n    }\n}\n"}}, {"type": "toolCall", "id": "call_b8MZw3yx9zzKffsqF8di2c7F|fc_07e64c7a1924f579016ad21a7934c487d1b2220839d727d559", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/SpecificDataTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.org.apache.avro.Protocol;\nimport org.apache.pulsar.shade.org.apache.avro.Schema;\nimport org.apache.pulsar.shade.org.apache.avro.generic.GenericData.InstanceSupplier;\nimport org.apache.pulsar.shade.org.apache.avro.specific.SpecificData;\nimport org.apache.pulsar.shade.org.apache.avro.specific.SpecificRecordBase;\nimport org.junit.jupiter.api.Test;\n\npublic class SpecificDataTest {\n    @Test\n    void readsGeneratedFieldsAndConstructsSpecificRecords() {\n        final SpecificData data = SpecificData.getForClass(GeneratedRecord.class);\n        final Schema schema = data.getSchema(GeneratedRecord.class);\n        final Protocol protocol = data.getProtocol(GeneratedService.class);\n        final InstanceSupplier supplier = data.getNewRecordSupplier(schema);\n\n        final Object supplied = supplier.newInstance(null, schema);\n        final SchemaConstructed constructed = (SchemaConstructed) SpecificData.newInstance(\n                SchemaConstructed.class, SchemaConstructed.SCHEMA$);\n\n        assertThat(data).isSameAs(GeneratedRecord.MODEL$);\n        assertThat(protocol.getMessages()).containsKey(\"echo\");\n        assertThat(supplied).isInstanceOf(GeneratedRecord.class);\n        assertThat(constructed.constructorSchema).isSameAs(SchemaConstructed.SCHEMA$);\n    }\n\n    public interface GeneratedService {\n        Protocol PROTOCOL = Protocol.parse(\"\"\"\n                {\n                  \"protocol\": \"GeneratedService\",\n                  \"namespace\": \"org_apache_pulsar.pulsar_client_all\",\n                  \"messages\": {\n                    \"echo\": {\n                      \"request\": [{\"name\": \"value\", \"type\": \"string\"}],\n                      \"response\": \"string\"\n                    }\n                  }\n                }\n                \"\"\");\n    }\n\n    public static class GeneratedRecord extends SpecificRecordBase {\n        public static final Schema SCHEMA$ = new Schema.Parser().parse(\"\"\"\n                {\n                  \"type\": \"record\",\n                  \"name\": \"GeneratedRecord\",\n                  \"namespace\": \"org_apache_pulsar.pulsar_client_all.SpecificDataTest\",\n                  \"fields\": []\n                }\n                \"\"\");\n        public static final SpecificData MODEL$ = new SpecificData();\n\n        @Override\n        public Schema getSchema() {\n            return SCHEMA$;\n        }\n\n        @Override\n        public Object get(int field) {\n            throw new IndexOutOfBoundsException(field);\n        }\n\n        @Override\n        public void put(int field, Object value) {\n            throw new IndexOutOfBoundsException(field);\n        }\n    }\n\n    public static class SchemaConstructed extends SpecificRecordBase implements SpecificData.SchemaConstructable {\n        public static final Schema SCHEMA$ = new Schema.Parser().parse(\"\"\"\n                {\n                  \"type\": \"record\",\n                  \"name\": \"SchemaConstructed\",\n                  \"namespace\": \"org_apache_pulsar.pulsar_client_all.SpecificDataTest\",\n                  \"fields\": []\n                }\n                \"\"\");\n\n        private final Schema constructorSchema;\n\n        public SchemaConstructed(Schema schema) {\n            constructorSchema = schema;\n        }\n\n        @Override\n        public Schema getSchema() {\n            return SCHEMA$;\n        }\n\n        @Override\n        public Object get(int field) {\n            throw new IndexOutOfBoundsException(field);\n        }\n\n        @Override\n        public void put(int field, Object value) {\n            throw new IndexOutOfBoundsException(field);\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_La9DIaCqRyeWur4pAq77m5bH|fc_07e64c7a1924f579016ad21a7934d087d18519a39aeb065364", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/MapMakerInternalMapInnerAbstractSerializationProxyTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.concurrent.ConcurrentMap;\nimport java.util.concurrent.TimeUnit;\n\nimport org.apache.pulsar.shade.com.google.common.collect.MapMaker;\nimport org.junit.jupiter.api.Test;\n\npublic class MapMakerInternalMapInnerAbstractSerializationProxyTest {\n    @Test\n    void preservesWeakValueMapEntriesAndFactoryConfiguration() throws Exception {\n        final ConcurrentMap<String, TimeUnit> map = new MapMaker().weakValues().concurrencyLevel(2).makeMap();\n        map.put(\"short\", TimeUnit.SECONDS);\n        map.put(\"long\", TimeUnit.DAYS);\n\n        final ConcurrentMap<String, TimeUnit> restored = SerializationTestSupport.roundTrip(map);\n\n        assertThat(restored).containsEntry(\"short\", TimeUnit.SECONDS).containsEntry(\"long\", TimeUnit.DAYS);\n        restored.put(\"new\", TimeUnit.MINUTES);\n        assertThat(restored.get(\"new\")).isSameAs(TimeUnit.MINUTES);\n    }\n}\n"}}, {"type": "toolCall", "id": "call_vF46XTzjr5zpC32Co1m3UWxN|fc_07e64c7a1924f579016ad21a7934d887d1bdc4cc72eb586561", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/MultimapsInnerCustomListMultimapTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.io.Serializable;\nimport java.util.ArrayList;\nimport java.util.Collection;\nimport java.util.LinkedHashMap;\nimport java.util.List;\nimport java.util.Map;\n\nimport org.apache.pulsar.shade.com.google.common.base.Supplier;\nimport org.apache.pulsar.shade.com.google.common.collect.ListMultimap;\nimport org.apache.pulsar.shade.com.google.common.collect.Multimaps;\nimport org.junit.jupiter.api.Test;\n\npublic class MultimapsInnerCustomListMultimapTest {\n    @Test\n    void restoresBackingMapEntriesAndListFactory() throws Exception {\n        final Map<String, Collection<String>> backing = new LinkedHashMap<>();\n        final ListMultimap<String, String> map = Multimaps.newListMultimap(backing, new ListSupplier());\n        map.put(\"letters\", \"a\");\n        map.put(\"letters\", \"b\");\n\n        final ListMultimap<String, String> restored = SerializationTestSupport.roundTrip(map);\n\n        assertThat(restored.get(\"letters\")).containsExactly(\"a\", \"b\");\n        restored.put(\"new\", \"value\");\n        assertThat(restored.get(\"new\")).containsExactly(\"value\");\n    }\n\n    private static final class ListSupplier implements Supplier<List<String>>, Serializable {\n        private static final long serialVersionUID = 1L;\n\n        @Override\n        public List<String> get() {\n            return new ArrayList<>();\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_aDNmvn24KrvsLRrTCVe1WDnK|fc_07e64c7a1924f579016ad21a7934e487d1b5f6da656c3315fb", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/MultimapsInnerCustomMultimapTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.io.Serializable;\nimport java.util.ArrayDeque;\nimport java.util.Collection;\nimport java.util.LinkedHashMap;\nimport java.util.Map;\n\nimport org.apache.pulsar.shade.com.google.common.base.Supplier;\nimport org.apache.pulsar.shade.com.google.common.collect.Multimap;\nimport org.apache.pulsar.shade.com.google.common.collect.Multimaps;\nimport org.junit.jupiter.api.Test;\n\npublic class MultimapsInnerCustomMultimapTest {\n    @Test\n    void restoresBackingMapEntriesAndCollectionFactory() throws Exception {\n        final Map<String, Collection<String>> backing = new LinkedHashMap<>();\n        final Multimap<String, String> map = Multimaps.newMultimap(backing, new DequeSupplier());\n        map.put(\"letters\", \"a\");\n        map.put(\"letters\", \"b\");\n\n        final Multimap<String, String> restored = SerializationTestSupport.roundTrip(map);\n\n        assertThat(restored.get(\"letters\")).containsExactly(\"a\", \"b\");\n        restored.put(\"new\", \"value\");\n        assertThat(restored.get(\"new\")).containsExactly(\"value\");\n    }\n\n    private static final class DequeSupplier implements Supplier<Collection<String>>, Serializable {\n        private static final long serialVersionUID = 1L;\n\n        @Override\n        public Collection<String> get() {\n            return new ArrayDeque<>();\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_fTma716vZNSEWWFOjRQ669ZX|fc_07e64c7a1924f579016ad21a7934ec87d19b01242e89432e79", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/MultimapsInnerCustomSetMultimapTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.io.Serializable;\nimport java.util.Collection;\nimport java.util.LinkedHashMap;\nimport java.util.LinkedHashSet;\nimport java.util.Map;\nimport java.util.Set;\n\nimport org.apache.pulsar.shade.com.google.common.base.Supplier;\nimport org.apache.pulsar.shade.com.google.common.collect.Multimaps;\nimport org.apache.pulsar.shade.com.google.common.collect.SetMultimap;\nimport org.junit.jupiter.api.Test;\n\npublic class MultimapsInnerCustomSetMultimapTest {\n    @Test\n    void restoresBackingMapEntriesAndSetFactory() throws Exception {\n        final Map<String, Collection<String>> backing = new LinkedHashMap<>();\n        final SetMultimap<String, String> map = Multimaps.newSetMultimap(backing, new SetSupplier());\n        map.put(\"letters\", \"a\");\n        map.put(\"letters\", \"a\");\n        map.put(\"letters\", \"b\");\n\n        final SetMultimap<String, String> restored = SerializationTestSupport.roundTrip(map);\n\n        assertThat(restored.get(\"letters\")).containsExactly(\"a\", \"b\");\n        restored.put(\"new\", \"value\");\n        assertThat(restored.get(\"new\")).containsExactly(\"value\");\n    }\n\n    private static final class SetSupplier implements Supplier<Set<String>>, Serializable {\n        private static final long serialVersionUID = 1L;\n\n        @Override\n        public Set<String> get() {\n            return new LinkedHashSet<>();\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_B7a52p319ym7kbjk9UHv5SAg|fc_07e64c7a1924f579016ad21a7934f487d19a58cbdf255c5c9e", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/MultimapsInnerCustomSortedSetMultimapTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.io.Serializable;\nimport java.util.Collection;\nimport java.util.Comparator;\nimport java.util.LinkedHashMap;\nimport java.util.Map;\nimport java.util.SortedSet;\nimport java.util.TreeSet;\n\nimport org.apache.pulsar.shade.com.google.common.base.Supplier;\nimport org.apache.pulsar.shade.com.google.common.collect.Multimaps;\nimport org.apache.pulsar.shade.com.google.common.collect.SortedSetMultimap;\nimport org.junit.jupiter.api.Test;\n\npublic class MultimapsInnerCustomSortedSetMultimapTest {\n    @Test\n    void restoresSortedSetFactoryAndComparator() throws Exception {\n        final Map<String, Collection<String>> backing = new LinkedHashMap<>();\n        final SortedSetMultimap<String, String> map =\n                Multimaps.newSortedSetMultimap(backing, new SortedSetSupplier());\n        map.put(\"letters\", \"a\");\n        map.put(\"letters\", \"b\");\n\n        final SortedSetMultimap<String, String> restored = SerializationTestSupport.roundTrip(map);\n\n        assertThat(restored.get(\"letters\")).containsExactly(\"b\", \"a\");\n        assertThat(restored.valueComparator()).isNotNull();\n        restored.put(\"new\", \"value\");\n        assertThat(restored.get(\"new\")).containsExactly(\"value\");\n    }\n\n    private static final class SortedSetSupplier implements Supplier<SortedSet<String>>, Serializable {\n        private static final long serialVersionUID = 1L;\n\n        @Override\n        public SortedSet<String> get() {\n            return new TreeSet<>(Comparator.reverseOrder());\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_OMjiGdtZbdVX6ouHCXDNqYJf|fc_07e64c7a1924f579016ad21a7934fc87d19fc260f0c89bde71", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/AbstractBiMapInnerInverseTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.google.common.collect.BiMap;\nimport org.apache.pulsar.shade.com.google.common.collect.EnumBiMap;\nimport org.junit.jupiter.api.Test;\n\npublic class AbstractBiMapInnerInverseTest {\n    @Test\n    void preservesForwardAndInverseMappingsDuringSerialization() throws Exception {\n        final EnumBiMap<Priority, Status> map = EnumBiMap.create(Priority.class, Status.class);\n        map.put(Priority.LOW, Status.QUEUED);\n        map.put(Priority.HIGH, Status.RUNNING);\n\n        final BiMap<Status, Priority> restored = SerializationTestSupport.roundTrip(map.inverse());\n\n        assertThat(restored.get(Status.QUEUED)).isSameAs(Priority.LOW);\n        assertThat(restored.get(Status.RUNNING)).isSameAs(Priority.HIGH);\n        assertThat(restored.inverse().inverse()).isSameAs(restored);\n    }\n\n    private enum Priority {\n        LOW,\n        HIGH\n    }\n\n    private enum Status {\n        QUEUED,\n        RUNNING\n    }\n}\n"}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-sol", "usage": {"input": 2239, "output": 5148, "cacheRead": 163712, "cacheWrite": 0, "reasoning": 1026, "totalTokens": 171099, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1792154138354, "responseId": "resp_07e64c7a1924f579016ad21a1aeb6087d1bdd5bf9b94a84