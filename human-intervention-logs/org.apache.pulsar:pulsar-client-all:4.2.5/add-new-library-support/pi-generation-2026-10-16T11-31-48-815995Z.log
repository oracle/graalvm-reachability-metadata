[tool-exec] start id=call_HSViqCsZLvIELE2AJ2A5f0rp|fc_01ddf0e646054b84016ad20eb4ec9887d1bbe96ba02790f36b name=write args={"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/EnumsTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.google.common.base.Enums;\nimport org.junit.jupiter.api.Test;\n\npublic class EnumsTest {\n    @Test\n    void exposesTheFieldThatDefinesAnEnumConstant() {\n        assertThat(Enums.getField(State.READY).getName()).isEqualTo(\"READY\");\n        assertThat(Enums.getIfPresent(State.class, \"STARTING\").get()).isEqualTo(State.STARTING);\n    }\n\n    private enum State {\n        STARTING,\n        READY\n    }\n}\n"}
[tool-exec] start id=call_K8o3zSFQEYqdiUd2ixYYoEo4|fc_01ddf0e646054b84016ad20eb4eca087d18c0087ed4e420d94 name=write args={"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/SubscriberTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.google.common.eventbus.EventBus;\nimport org.apache.pulsar.shade.com.google.common.eventbus.Subscribe;\nimport org.junit.jupiter.api.Test;\n\npublic class SubscriberTest {\n    @Test\n    void invokesAnnotatedSubscriberMethods() {\n        final EventBus eventBus = new EventBus(\"pulsar-client-test\");\n        final Listener listener = new Listener();\n        eventBus.register(listener);\n\n        eventBus.post(\"message\");\n\n        assertThat(listener.message).isEqualTo(\"message\");\n    }\n\n    public static final class Listener {\n        private String message;\n\n        @Subscribe\n        public void receive(String received) {\n            message = received;\n        }\n    }\n}\n"}
[tool-exec] start id=call_3HIXM0LEL9Dk0H9fbI2R4QL0|fc_01ddf0e646054b84016ad20eb4ecac87d1a686128aad91d8e1 name=write args={"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/SubscriberRegistryTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.google.common.eventbus.EventBus;\nimport org.apache.pulsar.shade.com.google.common.eventbus.Subscribe;\nimport org.junit.jupiter.api.Test;\n\npublic class SubscriberRegistryTest {\n    @Test\n    void discoversAnnotatedSubscriberMethods() {\n        final EventBus eventBus = new EventBus();\n        final CountingListener listener = new CountingListener();\n        eventBus.register(listener);\n\n        eventBus.post(2);\n        eventBus.post(3);\n\n        assertThat(listener.total).isEqualTo(5);\n    }\n\n    public static final class CountingListener {\n        private int total;\n\n        @Subscribe\n        public void receive(Integer value) {\n            total += value;\n        }\n    }\n}\n"}
[tool-exec] start id=call_LD0gNNwuO1016VmAJ8boU1vO|fc_01ddf0e646054b84016ad20eb4ecb487d1a1e5b2e6582eacb3 name=write args={"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/SimpleTimeLimiterTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.concurrent.ExecutorService;\nimport java.util.concurrent.Executors;\nimport java.util.concurrent.TimeUnit;\n\nimport org.apache.pulsar.shade.com.google.common.util.concurrent.SimpleTimeLimiter;\nimport org.junit.jupiter.api.Test;\n\npublic class SimpleTimeLimiterTest {\n    @Test\n    void invokesServiceMethodsThroughATimeLimitedProxy() {\n        final ExecutorService executor = Executors.newSingleThreadExecutor();\n        try {\n            final EchoService proxy = SimpleTimeLimiter.create(executor)\n                    .newProxy(new EchoServiceImpl(), EchoService.class, 10, TimeUnit.SECONDS);\n\n            assertThat(proxy.echo(\"pulsar\")).isEqualTo(\"pulsar\");\n        } finally {\n            executor.shutdownNow();\n        }\n    }\n\n    public interface EchoService {\n        String echo(String value);\n    }\n\n    public static final class EchoServiceImpl implements EchoService {\n        @Override\n        public String echo(String value) {\n            return value;\n        }\n    }\n}\n"}
