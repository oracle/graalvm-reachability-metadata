st;\n\npublic class ClassUtilTest {\n    @Test\n    void createsInstancesAndInspectsMembers() {\n        final Inspected value = ClassUtil.createInstance(Inspected.class, true);\n\n        assertThat(value.label).isEqualTo(\"created\");\n        assertThat(ClassUtil.findConstructor(Inspected.class, true)).isNotNull();\n        assertThat(ClassUtil.getConstructors(Inspected.class)).isNotEmpty();\n        assertThat(ClassUtil.getDeclaredFields(Inspected.class))\n                .extracting(field -> field.getName())\n                .contains(\"label\");\n        assertThat(ClassUtil.getDeclaredMethods(Inspected.class))\n                .extracting(method -> method.getName())\n                .contains(\"getLabel\");\n        assertThat(ClassUtil.getClassMethods(Inspected.class))\n                .extracting(method -> method.getName())\n                .contains(\"getLabel\", \"toString\");\n    }\n\n    public static final class Inspected {\n        private final String label = \"created\";\n\n        public String getLabel() {\n            return label;\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792151668851}, {"role": "toolResult", "toolCallId": "call_ipRA0zkDbqmgbu8kKVpoogJa|fc_01ddf0e646054b84016ad21074665c87d1b6609a01e3bc837e", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.nio.channels.Pipe;\n\nimport org.apache.pulsar.shade.org.apache.commons.io.channels.CloseShieldChannel;\nimport org.junit.jupiter.api.Test;\n\npublic class CloseShieldChannelTest {\n    @Test\n    void shieldsTheUnderlyingChannelFromClose() throws Exception {\n        final Pipe pipe = Pipe.open();\n        try (Pipe.SourceChannel source = pipe.source(); Pipe.SinkChannel sink = pipe.sink()) {\n            final Pipe.SinkChannel shield = CloseShieldChannel.wrap(sink);\n            assertThat(shield.isOpen()).isTrue();\n\n            shield.close();\n\n            assertThat(shield.isOpen()).isFalse();\n            assertThat(sink.isOpen()).isTrue();\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792151668853}, {"role": "toolResult", "toolCallId": "call_YA0lgSpVc9wlAamZ8AX3l5mh|fc_01ddf0e646054b84016ad21074666887d19ac32a5c9f9ad342", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.org.apache.avro.Protocol;\nimport org.apache.pulsar.shade.org.apache.avro.Schema;\nimport org.apache.pulsar.shade.org.apache.avro.reflect.ReflectData;\nimport org.junit.jupiter.api.Test;\n\npublic class ReflectDataTest {\n    @Test\n    void derivesRecordArrayAndProtocolSchemasFromJavaTypes() {\n        final ReflectData data = ReflectData.AllowNull.get();\n        final Schema messageSchema = data.getSchema(Message.class);\n        final Schema arraySchema = data.getSchema(Message[].class);\n        final Protocol protocol = data.getProtocol(EchoService.class);\n\n        assertThat(messageSchema.getFields()).extracting(Schema.Field::name).contains(\"id\", \"payload\");\n        assertThat(data.getClass(arraySchema)).isEqualTo(Message[].class);\n        assertThat(protocol.getMessages()).containsKey(\"echo\");\n    }\n\n    public interface EchoService {\n        Message echo(Message message);\n    }\n\n    public static final class Message {\n        private long id;\n        private String payload;\n\n        public Message() {\n        }\n    }\n}\n"}], "isError"