, Serializable {\n        void messageReceived(String message);\n    }\n\n    public static final class RecordingListener implements MessageListener {\n        private static final long serialVersionUID = 1L;\n\n        private String message;\n\n        @Override\n        public void messageReceived(String received) {\n            message = received;\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_yfe79WzGJwWvlhsiUu8EasMJ|fc_01ddf0e646054b84016ad20c70ffa887d1b5afb41abbaccd6c", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/CloseShieldChannelTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.nio.channels.Pipe;\n\nimport org.apache.pulsar.shade.org.apache.commons.io.channels.CloseShieldChannel;\nimport org.junit.jupiter.api.Test;\n\npublic class CloseShieldChannelTest {\n    @Test\n    void shieldsTheUnderlyingChannelFromClose() throws Exception {\n        final Pipe pipe = Pipe.open();\n        try (Pipe.SourceChannel source = pipe.source(); Pipe.SinkChannel sink = pipe.sink()) {\n            final Pipe.SinkChannel shield = CloseShieldChannel.wrap(sink);\n            assertThat(shield.isOpen()).isTrue();\n\n            shield.close();\n\n            assertThat(shield.isOpen()).isFalse();\n            assertThat(sink.isOpen()).isTrue();\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_JB4vdZf3UuP95vuV3h5K1bN0|fc_01ddf0e646054b84016ad20c70ffb087d19485b3c6f9a08486", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ResourcesTest.java", "content": "/*\n * Copyright a