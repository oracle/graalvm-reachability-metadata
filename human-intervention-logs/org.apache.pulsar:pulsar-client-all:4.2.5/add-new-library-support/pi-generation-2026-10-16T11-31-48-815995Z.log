[tool-exec] start id=call_tbeZXwmuNIXG0jV07k8R4dAi|fc_01ddf0e646054b84016ad20d70fcf487d1abf67c10c5fccf71 name=write args={"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/SnakeYamlFieldPropertyTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.Yaml;\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.introspector.BeanAccess;\nimport org.junit.jupiter.api.Test;\n\npublic class SnakeYamlFieldPropertyTest {\n    @Test\n    void readsAndWritesFieldsWhenFieldAccessIsSelected() {\n        final Yaml yaml = new Yaml();\n        yaml.setBeanAccess(BeanAccess.FIELD);\n        final FieldConfiguration configuration = yaml.loadAs(\"topic: events\", FieldConfiguration.class);\n\n        assertThat(configuration.topic).isEqualTo(\"events\");\n        assertThat(yaml.dumpAsMap(configuration)).contains(\"topic: events\");\n    }\n\n    public static final class FieldConfiguration {\n        private String topic;\n    }\n}\n"}
[tool-exec] start id=call_9U3glT8m5cQwDdeA36IRV0cz|fc_01ddf0e646054b84016ad20d70fd0487d184ccd2e661d72969 name=write args={"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/PropertyUtilsTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.Yaml;\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.introspector.BeanAccess;\nimport org.junit.jupiter.api.Test;\n\npublic class PropertyUtilsTest {\n    @Test\n    void discoversPropertiesUsingBeanAndFieldAccessModes() {\n        final Yaml beanYaml = new Yaml();\n        final BeanConfiguration bean = beanYaml.loadAs(\"name: events\", BeanConfiguration.class);\n\n        final Yaml fieldYaml = new Yaml();\n        fieldYaml.setBeanAccess(BeanAccess.FIELD);\n        final FieldConfiguration field = fieldYaml.loadAs(\"name: commands\", FieldConfiguration.class);\n\n        assertThat(bean.getName()).isEqualTo(\"events\");\n        assertThat(field.name).isEqualTo(\"commands\");\n    }\n\n    public static final class BeanConfiguration {\n        private String name;\n\n        public String getName() {\n            return name;\n        }\n\n        public void setName(String configuredName) {\n            name = configuredName;\n        }\n    }\n\n    public static final class FieldConfiguration {\n        private String name;\n    }\n}\n"}
[tool-exec] start id=call_nkZ18TxvihOI4dhPqePZqrq4|fc_01ddf0e646054b84016ad20d70fd1087d1ad37039666c570f6 name=write args={"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/PropertySubstituteTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.introspector.PropertySubstitute;\nimport org.junit.jupiter.api.Test;\n\npublic class PropertySubstituteTest {\n    @Test\n    void discoversAndInvokesConfiguredAccessors() throws Exception {\n        final PropertySubstitute property = new PropertySubstitute(\n                \"topic\", String.class, \"getTopic\", \"setTopic\");\n        property.setTargetType(Configuration.class);\n        final Configuration configuration = new Configuration();\n\n        property.set(configuration, \"persistent://tenant/ns/events\");\n\n        assertThat(property.get(configuration)).isEqualTo(\"persistent://tenant/ns/events\");\n        assertThat(property.isReadable()).isTrue();\n        assertThat(property.isWritable()).isTrue();\n    }\n\n    public static final class Configuration {\n        private String topic;\n\n        public String getTopic() {\n            return topic;\n        }\n\n        public void setTopic(String configuredTopic) {\n            topic = configuredTopic;\n        }\n    }\n}\n"}
