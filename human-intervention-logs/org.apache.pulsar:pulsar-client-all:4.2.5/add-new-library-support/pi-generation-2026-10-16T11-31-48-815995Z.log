[tool-call] delta {"path":"tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ClassUtilsTest.java","content":"/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.lang.reflect.Method;\nimport java.util.List;\n\nimport org.apache.pulsar.shade.org.apache.commons.lang3.ClassUtils;\nimport org.junit.jupiter.api.Test;\n\npublic class ClassUtilsTest {\n    @Test\n    void resolvesClassNamesAndPublicInterfaceMethods() throws Exception {\n        final List<Class<?>> classes = ClassUtils.convertClassNamesToClasses(\n                List.of(Loadable.class.getName(), \"missing.Type\"));\n        final Class<?> loaded = ClassUtils.getClass(\n                getClass().getClassLoader(), Loadable.class.getName(), false);\n        final Method method = ClassUtils.getPublicMethod(HiddenGreeting.class, \"greet\", String.class);\n\n        assertThat(classes).containsExactly(Loadable.class, null);\n        assertThat(loaded).isSameAs(Loadable.class);\n        assertThat(method.getDeclaringClass()).isSameAs(Greeting.class);\n    }\n\n    public interface Greeting {\n        String greet(String name);\n    }\n\n    public static final class Loadable {\n    }\n\n    static final class HiddenGreeting implements Greeting {\n        @Override\n        public String greet(String name) {\n            return \"hello \" + name;\n        }\n    }\n}\n"}
