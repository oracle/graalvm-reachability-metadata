  package org_apache_pulsar.pulsar_client_all;
  
  import static org.assertj.core.api.Assertions.assertThat;
  
  import org.apache.pulsar.shade.com.fasterxml.jackson.annotation.JsonFormat;
  import org.apache.pulsar.shade.com.fasterxml.jackson.annotation.JsonPropertyOrder;
  import org.apache.pulsar.shade.com.fasterxml.jackson.databind.ObjectMapper;
  import org.apache.pulsar.shade.com.fasterxml.jackson.databind.annotation.JsonDeserialize;
  import org.apache.pulsar.shade.com.fasterxml.jackson.databind.annotation.JsonPOJOBuilder;
  import org.junit.jupiter.api.Test;
  
  public class BeanAsArrayBuilderDeserializerTest {
      @Test
      void buildsArrayShapedBeanThroughConfiguredBuilder() throws Exception {
          final BuiltValue value = new ObjectMapper().readValue("[\"events\",12]", BuiltValue.class);
  
          assertThat(value.name).isEqualTo("events");
          assertThat(value.partitions).isEqualTo(12);
      }
  
      @JsonFormat(shape = JsonFormat.Shape.ARRAY)
      @JsonPropertyOrder({"name", "partitions"})
      @JsonDeserialize(builder = Builder.class)
      public static final class BuiltValue {
          private final String name;
          private final int partitions;
  
          private BuiltValue(String configuredName, int configuredPartitions) {
              name = configuredName;
              partitions = configuredPartitions;
          }
      }
  
      @JsonFormat(shape = JsonFormat.Shape.ARRAY)
      @JsonPropertyOrder({"name", "partitions"})
      @JsonPOJOBuilder(withPrefix = "")
      public static final class Builder {
          public String name;
          public int partitions;
  
          public BuiltValue build() {
              return new BuiltValue(name, partitions);
          }
      }
  }
