pache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.fasterxml.jackson.annotation.JsonAlias;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.annotation.JsonProperty;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.ObjectMapper;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.introspect.JacksonAnnotationIntrospector;\nimport org.junit.jupiter.api.Test;\n\npublic class JacksonAnnotationIntrospectorTest {\n    @Test\n    void readsEnumNamesAndAliasesFromAnnotatedConstants() throws Exception {\n        final JacksonAnnotationIntrospector introspector = new JacksonAnnotationIntrospector();\n        final State[] values = State.values();\n        final String[] names = {\"READY\", \"STOPPED\"};\n        final String[][] aliases = new String[values.length][];\n\n        assertThat(introspector.findEnumValue(State.READY)).isEqualTo(\"ready-json\");\n        assertThat(introspector.findEnumValues(State.class, values, names))\n                .containsExactly(\"ready-json\", \"STOPPED\");\n        introspector.findEnumAliases(State.class, values, aliases);\n        assertThat(aliases[0]).containsExactly(\"ready-alias\");\n\n        final ObjectMapper mapper = new ObjectMapper();\n        assertThat(mapper.writeValueAsString(State.READY)).isEqualTo(\"\\\"ready-json\\\"\");\n        assertThat(mapper.readValue(\"\\\"ready-alias\\\"\", State.class)).isSameAs(State.READY);\n    }\n\n    public enum State {\n        @JsonProperty(\"ready-json\")\n        @JsonAlias(\"ready-alias\")\n        READY,\n\n        STOPPED\n    }\n}\n"}}, {"type": "toolCall", "id": "call_qTWFvNA2pM4qLKSAyEwn7Q1r|fc_07e64c7a1924f579016ad21b7f3fd087d19a77ba3785a93ee9", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/BeanAsArrayBuilderDeserializerTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.fasterxml.jackson.annotation.JsonFormat;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.annotation.JsonPropertyOrder;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.ObjectMapper;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.annotation.JsonDeserialize;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.annotation.JsonPOJOBuilder;\nimport org.junit.jupiter.api.Test;\n\npublic class BeanAsArrayBuilderDeserializerTest {\n    @Test\n    void buildsArrayShapedBeanThroughConfiguredBuilder() throws Exception {\n        final BuiltValue value = new ObjectMapper().readValue(\"[\\\"events\\\",12]\", BuiltValue.class);\n\n        assertThat(value.name).isEqualTo(\"events\");\n        assertThat(value.partitions).isEqualTo(12);\n    }\n\n    @JsonFormat(shape = JsonFormat.Shape.ARRAY)\n    @JsonPropertyOrder({\"name\", \"partitions\"})\n    @JsonDeserialize(builder = Builder.class)\n    public static final class BuiltValue {\n        private final String name;\n        private final int partitions;\n\n        private BuiltValue(String configuredName, int configuredPartitions) {\n            name = configuredName;\n            partitions = configuredPartitions;\n        }\n    }\n\n    @JsonFormat(shape = JsonFormat.Shape.ARRAY)\n    @JsonPropertyOrder({\"name\", \"partitions\"})\n    @JsonPOJOBuilder(withPrefix = \"\")\n    public static final class Builder {\n        public String name;\n        public int partitions;\n\n        public BuiltValue build() {\n            return new BuiltValue(name, partitions);\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_91m8NRcElTN60SIhHPtJZ1Ci|fc_07e64c7a1924f579016ad21b7f3fdc87d1b062b5c92390bddc", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/SetterlessPropertyTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.ArrayList;\nimport java.util.List;\n\nimport org.apache.pulsar.shade.com.fasterxml.jackson.annotation.JsonAutoDetect;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.annotation.PropertyAccessor;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.ObjectMapper;\nimport org.junit.jupiter.api.Test;\n\npublic class SetterlessPropertyTest {\n    @Test\n    void populatesCollectionReturnedByGetterWithoutSetter() throws Exception {\n        final ObjectMapper mapper = new ObjectMapper()\n                .setVisibility(PropertyAccessor.FIELD, JsonAutoDetect.Visibility.NONE);\n\n        final Subscription value = mapper.readValue(\"{\\\"topics\\\":[\\\"a\\\",\\\"b\\\"]}\", Subscription.class);\n\n        assertThat(value.getTopics()).containsExactly(\"a\", \"b\");\n    }\n\n    public static final class Subscription {\n        private final List<String> topics = new ArrayList<>();\n\n        public List<String> getTopics() {\n            return topics;\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_e1zWoOmhwKkeTG82Gr9USCmv|fc_07e64c7a1924f579016ad21b7f3fe887d1b66ec07ea3f93347", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ObjectArrayDeserializerTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.DeserializationFeature;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.ObjectMapper;\nimport org.junit.jupiter.api.Test;\n\npublic class ObjectArrayDeserializerTest {\n    @Test\n    void wrapsSingleJsonObjectInTypedArray() throws Exception {\n        final ObjectMapper mapper = new ObjectMapper()\n                .enable(DeserializationFeature.ACCEPT_SINGLE_VALUE_AS_ARRAY);\n\n        final Topic[] topics = mapper.readValue(\"{\\\"name\\\":\\\"events\\\"}\", Topic[].class);\n\n        assertThat(topics).extracting(Topic::getName).containsExactly(\"events\");\n    }\n\n    public static final class Topic {\n        private String name;\n\n        public String getName() {\n            return name;\n        }\n\n        public void setName(String configuredName) {\n            name = configuredName;\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_JATDPzJACWNZK6QL2K8dJnms|fc_07e64c7a1924f579016ad21b7f3ff087d19c741ae1fea6eda8", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/OptionalHandlerFactoryTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.ObjectMapper;\nimport org.junit.jupiter.api.Test;\nimport org.w3c.dom.Document;\n\npublic class OptionalHandlerFactoryTest {\n    @Test\n    void deserializesAndSerializesDomDocument() throws Exception {\n        final Objec