d", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.introspector.PropertySubstitute;\nimport org.junit.jupiter.api.Test;\n\npublic class PropertySubstituteTest {\n    @Test\n    void discoversAndInvokesConfiguredAccessors() throws Exception {\n        final PropertySubstitute property = new PropertySubstitute(\n                \"topic\", String.class, \"getTopic\", \"setTopic\");\n        property.setTargetType(Configuration.class);\n        final Configuration configuration = new Configuration();\n\n        property.set(configuration, \"persistent://tenant/ns/events\");\n\n        assertThat(property.get(configuration)).isEqualTo(\"persistent://tenant/ns/events\");\n        assertThat(property.isReadable()).isTrue();\n        assertThat(property.isWritable()).isTrue();\n    }\n\n    public static final class Configuration {\n        private String topic;\n\n        public String getTopic() {\n            return topic;\n        }\n\n        public void setTopic(String configuredTopic) {\n            topic = configuredTopic;\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792153974247}, {"role": "toolResult", "toolCallId": "call_bpCVkyUJYg7MwMkzaat00SoD|fc_07e64c7a1924f579016ad21975ec4087d1bc15ed8de85348c9", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.Map;\n\nimport org.apache.pulsar.common.stats.JvmDefaultGCMetricsLogger;\nimport org.apache.pulsar.common.stats.Metrics;\nimport org.junit.jupiter.api.Test;\n\npublic class JvmDefaultGCMetricsLoggerTest {\n    @Test\n    void refreshesAndPublishesGcAndSafepointMetrics() {\n        final JvmDefaultGCMetricsLogger logger = new JvmDefaultGCMetricsLogger();\n        logger.refresh();\n        logger.refresh();\n\n        final Metrics metrics = Metrics.create(Map.of(\"component\", \"client\"));\n        logger.logMetrics(metrics);\n\n        assertThat(metrics.getMetrics()).containsKeys(\"jvm_full_gc_pause\", \"jvm_full_gc_count\");\n        assertThat(metrics.getDimensions()).containsEntry(\"component\", \"client\");\n    }\n}\n"}], "isError": false, "timestamp": 1792153974247}, {"role": "toolResult", "toolCallId": "call_LfSyHIkDdaDk9h5kVQCkyyR7|fc_07e64c7a1924f579016ad21975ec5087d1a3ec6358c8c99a61", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.google.common.reflect.Reflection;\nimport org.junit.jupiter.api.Test;\n\npublic class GuavaReflectionTest {\n    @Test\n    void initializesClassesAndCreatesInterfaceProxies() {\n        Reflection.initialize(Initialized.class);\n        final Greeting greeting = Reflection.newProxy(\n                Greeting.class, (proxy, method, arguments) -> \"hello \" + arguments[0]);\n\n        assertThat(Initialized.VALUE).isEqualTo(\"initialized\");\n        assertThat(greeting.greet(\"pulsar\")).isEqualTo(\"hello pulsar\");\n    }\n\n    public interface Greeting {\n        String greet(String name);\n    }\n\n    public static final class Initialized {\n        private static final Strin