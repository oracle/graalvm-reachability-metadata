[tool-call] delta {"path":"tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/DefaultChannelIdTest.java","content":"/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.io.netty.channel.DefaultChannelId;\nimport org.junit.jupiter.api.Test;\n\npublic class DefaultChannelIdTest {\n    @Test\n    void createsUniqueProcessAwareChannelIdentifiers() {\n        final DefaultChannelId first = DefaultChannelId.newInstance();\n        final DefaultChannelId second = DefaultChannelId.newInstance();\n\n        assertThat(first).isNotEqualTo(second);\n        assertThat(first.asShortText()).hasSize(8);\n        assertThat(first.asLongText()).contains(\"-\");\n    }\n}\n"}
[tool-call] end id=call_7thNRpE0ITHu0NYzPGvghLtw|fc_01ddf0e646054b84016ad20dea2aa487d1855e0332e8fa5562 name=write args={"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/DefaultChannelIdTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.io.netty.channel.DefaultChannelId;\nimport org.junit.jupiter.api.Test;\n\npublic class DefaultChannelIdTest {\n    @Test\n    void createsUniqueProcessAwareChannelIdentifiers() {\n        final DefaultChannelId first = DefaultChannelId.newInstance();\n        final DefaultChannelId second = DefaultChannelId.newInstance();\n\n        assertThat(first).isNotEqualTo(second);\n        assertThat(first.asShortText()).hasSize(8);\n        assertThat(first.asLongText()).contains(\"-\");\n    }\n}\n"}
