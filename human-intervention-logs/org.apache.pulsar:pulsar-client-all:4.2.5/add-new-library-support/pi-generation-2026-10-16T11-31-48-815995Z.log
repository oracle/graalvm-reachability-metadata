sionCodecNone.class.getName();\n\n        assertThat(Reflections.classExists(codecName)).isTrue();\n        assertThat(Reflections.classImplementsIface(codecName, CompressionCodec.class)).isTrue();\n        assertThat(Reflections.loadClass(\"int\", CLASS_LOADER)).isEqualTo(int.class);\n        assertThat(Reflections.loadClass(\"L\" + Reflections.class.getName() + \";\", CLASS_LOADER))\n                .isEqualTo(Reflections.class);\n        assertThat(Reflections.loadClass(\"[[L\" + Reflections.class.getName() + \";\", CLASS_LOADER))\n                .isEqualTo(Reflections[][].class);\n\n        final List<String> fields = Reflections.getAllFields(NonPersistentTopicStatsImpl.class).stream()\n                .map(field -> field.getName())\n                .toList();\n        assertThat(fields).contains(\"msgDropRate\", \"msgRateIn\", \"bytesInCounter\");\n    }\n}\n"}
[tool-exec] start id=call_fUhdf4yTiQrHfAjpiajPUmNb|fc_01ddf0e646054b84016ad20bf6e0e887d1891a5a6ba0d340ea name=write args={"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/OffloadPoliciesImplTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.Properties;\n\nimport org.apache.pulsar.common.policies.data.OffloadPoliciesImpl;\nimport org.junit.jupiter.api.Test;\n\npublic class OffloadPoliciesImplTest {\n    @Test\n    void createsSerializesAndMergesPolicies() {\n        final Properties configured = new Properties();\n        configured.setProperty(\"managedLedgerOffloadDriver\", \"aws-s3\");\n        configured.setProperty(\"managedLedgerOffloadBucket\", \"archive\");\n        configured.setProperty(\"managedLedgerOffloadRegion\", \"eu-west-1\");\n        configured.setProperty(\"managedLedgerOffloadMaxBlockSizeInBytes\", \"8388608\");\n\n        final OffloadPoliciesImpl created = OffloadPoliciesImpl.create(configured);\n        assertThat(created.toProperties())\n                .containsEntry(\"managedLedgerOffloadDriver\", \"aws-s3\")\n                .containsEntry(\"managedLedgerOffloadBucket\", \"archive\");\n\n        final OffloadPoliciesImpl topic = OffloadPoliciesImpl.builder()\n                .managedLedgerOffloadDriver(\"aws-s3\")\n                .managedLedgerOffloadRegion(\"topic-region\")\n                .build();\n        final OffloadPoliciesImpl namespace = OffloadPoliciesImpl.builder()\n                .managedLedgerOffloadBucket(\"namespace-bucket\")\n                .build();\n        final Properties broker = new Properties();\n        broker.setProperty(OffloadPoliciesImpl.OFFLOAD_THRESHOLD_NAME_IN_CONF_FILE, \"4096\");\n\n        final OffloadPoliciesImpl merged = OffloadPoliciesImpl.mergeConfiguration(topic, namespace, broker);\n        assertThat(merged.getManagedLedgerOffloadRegion()).isEqualTo(\"topic-region\");\n        assertThat(merged.getManagedLedgerOffloadBucket()).isEqualTo(\"namespace-bucket\");\n        assertThat(merged.getManagedLedgerOffloadThresholdInBytes()).isEqualTo(4096L);\n    }\n}\n"}
[tool-exec] start id=call_JKM0StStVZ7zsYHoMDMokeuk|fc_01ddf0e646054b84016ad20bf6e0f487d18f35a806b0c35feb name=write args={"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/FieldParserTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.ArrayList;\nimport java.util.LinkedHashMap;\nimport java.util.LinkedHashSet;\nimport java.util.List;\nimport java.util.Map;\nimport java.util.Optional;\nimport java.util.Set;\n\nimport org.apache.pulsar.common.util.FieldParser;\nimport org.junit.jupiter.api.Test;\n\npublic class FieldParserTest {\n    @Test\n    void convertsUpdatesAndClearsConfigurationFields() {\n        final Configuration configuration = new Configuration();\n        final Map<String, String> values = new LinkedHashMap<>();\n        values.put(\"name\", \"broker-a\");\n        values.put(\"port\", \"6650\");\n        values.put(\"clusters\", \"east, west\");\n        values.put(\"roles\", \"admin, proxy\");\n        values.put(\"weights\", \"primary=10, secondary=20\");\n        values.put(\"optionalPort\", \"7000\");\n\n        FieldParser.update(values, configuration);\n        assertThat(configuration.name).isEqualTo(\"broker-a\");\n        assertThat(configuration.port).isEqualTo(6650);\n        assertThat(configuration.clusters).containsExactly(\"east\", \"west\");\n        assertThat(configuration.roles).containsExactly(\"admin\", \"proxy\");\n        assertThat(configuration.weights).containsEntry(\"primary\", 10).containsEntry(\"secondary\", 20);\n        assertThat(configuration.optionalPort).contains(7000);\n\n        FieldParser.update(Map.of(\"clusters\", \"\", \"roles\", \" \", \"optionalPort\", \"\", \"port\", \"\"), configuration);\n        assertThat(configuration.clusters).isEmpty();\n        assertThat(configuration.roles).isEmpty();\n        assertThat(configuration.optionalPort).isEmpty();\n        assertThat(configuration.port).isNull();\n    }\n\n    public static final class Configuration {\n        private String name = \"initial\";\n        private Integer port = 1;\n        private List<String> clusters = new ArrayList<>(List.of(\"initial\"));\n        private Set<String> roles = new LinkedHashSet<>(Set.of(\"initial\"));\n        private Map<String, Integer> weights = new LinkedHashMap<>(Map.of(\"initial\", 1));\n        private Optional<Integer> optionalPort = Optional.of(1);\n    }\n}\n"}
