ved via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.org.apache.commons.lang3.exception.ExceptionUtils;\nimport org.junit.jupiter.api.Test;\n\npublic class ExceptionUtilsTest {\n    @Test\n    void resolvesLegacyCauseAccessor() {\n        final IllegalArgumentException cause = new IllegalArgumentException(\"nested\");\n\n        final Throwable resolved = ExceptionUtils.getCause(new LegacyException(cause), new String[] {\"getException\"});\n\n        assertThat(resolved).isSameAs(cause);\n    }\n\n    public static final class LegacyException extends RuntimeException {\n        private final Throwable nested;\n\n        public LegacyException(Throwable cause) {\n            super(\"legacy wrapper\");\n            nested = cause;\n        }\n\n        public Throwable getException() {\n            return nested;\n        }\n    }\n}\n"}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-sol", "usage": {"input": 360, "output": 2772, "cacheRead": 171392, "cacheWrite": 0, "reasoning": 86, "totalTokens": 174524, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1792154238399, "responseId": "resp_07e64c7a1924f579016ad21a7f045887d1ae6afc1f35810da3", "rawStopReason": "completed"}, "toolResults": [{"role": "toolResult", "toolCallId": "call_EJgP0jHhGzABJCGQUWzYNzvK|fc_07e64c7a1924f579016ad21ab3b26487d195fcaa307f218d11", "toolName": "write", "content": [{"type": "text", "text": "Successfully wrote 1309 bytes to tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/FuturesGetCheckedTest.java"}], "isError": false, "timestamp": 1792154291991}, {"role": "toolResult", "toolCallId": "c