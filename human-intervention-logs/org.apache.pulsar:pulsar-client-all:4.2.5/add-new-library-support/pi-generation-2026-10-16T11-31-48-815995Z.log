      case STRING:
        if (STRING_TYPE_STRING.equals(schema.getProp(STRING_PROP)))
          return String.class;
        return CharSequence.class;
      case BYTES:
        return ByteBuffer.class;
      case INT:
        return Integer.TYPE;
      case LONG:
        return Long.TYPE;
      case FLOAT:
        return Float.TYPE;
      case DOUBLE:
        return Double.TYPE;
      case BOOLEAN:
