n\nimport java.io.IOException;\nimport java.util.concurrent.Future;\n\nimport org.apache.pulsar.shade.com.google.common.util.concurrent.Futures;\nimport org.junit.jupiter.api.Test;\n\npublic class FuturesGetCheckedTest {\n    @Test\n    void createsRequestedCheckedExceptionAroundFutureFailure() {\n        final IOException cause = new IOException(\"broker unavailable\");\n        final Future<String> failed = Futures.immediateFailedFuture(cause);\n\n        assertThatThrownBy(() -> Futures.getChecked(failed, ClientOperationException.class))\n                .isInstanceOf(ClientOperationException.class)\n                .hasCause(cause)\n                .satisfies(error -> assertThat(error.getMessage()).contains(\"broker unavailable\"));\n    }\n\n    public static final class ClientOperationException extends Exception {\n        public ClientOperationException(String message, Throwable cause) {\n            super(message, cause);\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_AlPNGFMUhLjVF9ETAEfDeL2R|fc_07e64c7a1924f579016ad21ab3b27c87d18f5904d3d1f4c8b9", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ThrowablesTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.List;\n\nimport org.apache.pulsar.shade.com.google.common.base.Throwables;\nimport org.junit.jupiter.api.Test;\n\npublic class ThrowablesTest {\n    @Test\n    void exposesAStableLazyStackTraceView() {\n        final Throwable failure = captureFailure();\n\n        final List<StackTraceElement> stack = Throwables.lazyStackTrace(failure);\n\n        assertThat(stack).containsExactly(failure.getStackTrace());\n        assertThat(stack.get(0).getMethodName()).isEqualTo(\"captureFailure\");\n    }\n\n    private static Throwable captureFailure() {\n        return new Throwable(\"source\");\n    }\n}\n"}}, {"type": "toolCall", "id": "call_1qxKScWToOkMUVwqsoWS59GF|fc_07e64c7a1924f579016ad21ab3b28887d1ad1253b09b4ec525", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ObjectArraysTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.google.common.collect.ObjectArrays;\nimport org.junit.jupiter.api.Test;\n\npublic class ObjectArraysTest {\n    @Test\n    void createsTypedArraysWithRequestedLength() {\n        final String[] values = ObjectArrays.newArray(String.class, 3);\n\n        assertThat(values).isInstanceOf(String[].class).hasSize(3).containsOnlyNulls();\n    }\n}\n"}}, {"type": "toolCall", "id": "call_4wGLI4XYvrLuKK6TZ9JR5R7h|fc_07e64c7a1924f579016ad21ab3b29087d1a83beaa5e867f251", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ArrayTableTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.List;\n\nimport org.apache.pulsar.shade.com.google.common.collect.ArrayTable;\nimport org.junit.jupiter.api.Test;\n\npublic class ArrayTableTest {\n    @Test\n    void exportsValuesAsTypedTwoDimensionalArray() {\n        final ArrayTable<String, String, Integer> table =\n                ArrayTable.create(List.of(\"north\", \"south\"), List.of(\"morning\", \"evening\"));\n        table.put(\"north\", \"morning\", 11);\n        table.put(\"south\", \"evening\", 22);\n\n        final Integer[][] values = table.toArray(Integer.class);\n\n        assertThat(values).isInstanceOf(Integer[][].class);\n        assertThat(values[0]).containsExactly(11, null);\n        assertThat(values[1]).containsExactly(null, 22);\n    }\n}\n"}}, {"type": "toolCall", "id": "call_cbQYYs5Ee0SeeGl0RjLOkOe3|fc_07e64c7a1924f579016ad21ab3b29887d1a177e9f493f82c4c", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ExtraFieldUtilsTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.org.apache.commons.compress.archivers.zip.AsiExtraField;\nimport org.apache.pulsar.shade.org.apache.commons.compress.archivers.zip.ExtraFieldUtils;\nimport org.apache.pulsar.shade.org.apache.commons.compress.archivers.zip.ZipExtraField;\nimport org.apache.pulsar.shade.org.apache.commons.compress.archivers.zip.ZipShort;\nimport org.junit.jupiter.api.Test;\n\npublic class ExtraFieldUtilsTest {\n    @Test\n    void registersAndRecreatesZipExtraFieldImplementations() throws Exception {\n        final ZipShort header = new AsiExtraField().getHeaderId();\n\n        ExtraFieldUtils.register(AsiExtraField.class);\n        final ZipExtraField created = ExtraFieldUtils.createExtraFieldNoDefault(header);\n\n        assertThat(created).isInstanceOf(AsiExtraField.class);\n        assertThat(created.getHeaderId()).isEqualTo(header);\n    }\n}\n"}}, {"type": "toolCall", "id": "call_XX8oa9aHqIzKln3g7pxLkfln|fc_07e64c7a1924f579016ad21ab3b2a487d18979ce3255ff2b58", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ClassUtilsTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.lang.reflect.Method;\nimport java.util.List;\n\nimport org.apache.pulsar.shade.org.apache.commons.lang3.ClassUtils;\nimport org.junit.jupiter.api.Test;\n\npublic class ClassUtilsTest {\n    @Test\n    void resolvesClassNamesAndPublicInterfaceMethods() throws Exception {\n        final List<Class<?>> classes = ClassUtils.convertClassNamesToClasses(\n                List.of(Loadable.class.getName(), \"missing.Type\"));\n        final Class<?> loaded = ClassUtils.getClass(\n                getClass().getClassLoader(), Loadable.class.getName(), false);\n        final Method method = ClassUtils.getPublicMethod(HiddenGreeting.class, \"greet\", String.class);\n\n        assertThat(classes).containsExactly(Loadable.class, null);\n        assertThat(loaded).isSameAs(Loadable.class);\n        assertThat(method.getDeclaringClass()).isSameAs(Greeting.class);\n    }\n\n    public interface Greeting {\n        String greet(String name);\n    }\n\n    public static final class Loadable {\n    }\n\n    static final class HiddenGreeting implements Greeting {\n        @Override\n        public String greet(String name) {\n            return \"hello \" + name;\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_ss0BgCCERpHiPGyj7qah3YTU|fc_07e64c7a1924f579016ad21ab3b2ac87d1bf3bebc35d5fc784", "name": "write", "arguments": {