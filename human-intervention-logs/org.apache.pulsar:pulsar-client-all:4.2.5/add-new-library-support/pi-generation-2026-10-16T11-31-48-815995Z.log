  package org_apache_pulsar.pulsar_client_all;
  
  import static org.assertj.core.api.Assertions.assertThat;
  
  import org.apache.pulsar.shade.com.fasterxml.jackson.annotation.JsonIgnore;
  import org.apache.pulsar.shade.com.fasterxml.jackson.annotation.JsonProperty;
  import org.apache.pulsar.shade.com.fasterxml.jackson.databind.JsonNode;
  import org.apache.pulsar.shade.com.fasterxml.jackson.databind.ObjectMapper;
  import org.junit.jupiter.api.Test;
  
  public class AnnotatedMethodCollectorTest {
      @Test
      void appliesMethodMixInDuringBeanIntrospection() throws Exception {
          final ObjectMapper mapper = new ObjectMapper();
          mapper.addMixIn(MethodBean.class, MethodMixin.class);
          final MethodBean bean = new MethodBean("events", "hidden");
  
          final JsonNode tree = mapper.readTree(mapper.writeValueAsString(bean));
  
          assertThat(tree.get("external_name").asText()).isEqualTo("events");
          assertThat(tree.has("secret")).isFalse();
      }
  
      private abstract static class MethodMixin {
          @JsonProperty("external_name")
          abstract String getName();
  
          @JsonIgnore
          abstract String getSecret();
      }
  
      public static final class MethodBean {
          private final String name;
          private final String secret;
  
          public MethodBean(String configuredName, String configuredSecret) {
              name = configuredName;
              secret = configuredSecret;
          }
  
          public String getName() {
              return name;
          }
  
          public String getSecret() {
              return secret;
          }
      }
  }
