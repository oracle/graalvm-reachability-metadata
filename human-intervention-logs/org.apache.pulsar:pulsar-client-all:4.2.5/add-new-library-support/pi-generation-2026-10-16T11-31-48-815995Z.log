", "id": "call_nbsKGBGW4EhgqDquXJ4kzMVg|fc_01ddf0e646054b84016ad20bf6e0d487d1b9df1ff7946dbbd3", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ReflectionsTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.List;\n\nimport org.apache.pulsar.common.compression.CompressionCodec;\nimport org.apache.pulsar.common.compression.CompressionCodecNone;\nimport org.apache.pulsar.common.policies.data.TopicPolicies;\nimport org.apache.pulsar.common.policies.data.stats.NonPersistentTopicStatsImpl;\nimport org.apache.pulsar.common.schema.LongSchemaVersion;\nimport org.apache.pulsar.common.util.Reflections;\nimport org.junit.jupiter.api.Test;\n\npublic class ReflectionsTest {\n    private static final ClassLoader CLASS_LOADER = Reflections.class.getClassLoader();\n\n    @Test\n    void createsInstancesUsingAllConstructorForms() {\n        final CompressionCodec codec = Reflections.createInstance(\n                CompressionCodecNone.class.getName(), CompressionCodec.class, CLASS_LOADER);\n        final Object policies = Reflections.createInstance(TopicPolicies.class.getName(), CLASS_LOADER);\n        final Object version = Reflections.createInstance(\n                LongSchemaVersion.class.getName(), CLASS_LOADER, new Object[] {42L}, new Class<?>[] {long.class});\n\n        assertThat(codec).isInstanceOf(CompressionCodecNone.class);\n        assertThat(policies).isInstanceOf(TopicPolicies.class);\n        assertThat(version).isEqualTo(new LongSchemaVersion(42L));\n    }\n\n    @Test\n    void resolvesClassesAndInspectsTheirFields() throws Exception {\n        final String codecName = CompressionCodecNone.class.getName();\n\n        assertThat(Reflections.classExists(codecName)).isTrue();\n        assertThat(Reflections.classImplementsIface(codecName, CompressionCodec.class)).isTrue();\n        assertThat(Reflections.loadClass(\"int\", CLASS_LOADER)).isEqualTo(int.class);\n        assertThat(Reflections.loadClass(\"L\" + Reflections.class.getName() + \";\", CLASS_LOADER))\n                .isEqualTo(Reflections.class);\n        assertThat(Reflections.loadClass(\"[[L\" + Reflections.class.getName() + \";\", CLASS_LOADER))\n                .isEqualTo(Reflections[][].class);\n\n        final List<String> fields = Reflections.getAllFields(NonPersistentTopicStatsImpl.class).stream()\n                .map(field -> field.getName())\n                .toList();\n        assertThat(fields).contains(\"msgDropRate\", \"msgRateIn\", \"bytesInCounter\");\n    }\n}\n"}}, {"type": "toolCall", "id": "call_fUhdf4yTiQrHfAjpiajPUmNb|fc_01ddf0e646054b84016ad20bf6e0e887d1891a5a6ba0d340ea", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/OffloadPoliciesImplTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.Properties;\n\nimport org.apache.pulsar.common.policies.data.OffloadPoliciesImpl;\nimport org.junit.jupiter.api.Test;\n\npublic class OffloadPoliciesImplTest {\n    @Test\n    void createsSerializesAndMergesPolicies() {\n        final Properties configured = new Properties();\n        configured.setProperty(\"managedLedgerOffloadDriver\", \"aws-s3\");\n        configured.setProperty(\"managedLedgerOffloadBucket\", \"archive\");\n        configured.setProperty(\"managedLedgerOffloadRegion\", \"eu-west-1\");\n        configured.setProperty(\"managedLedgerOffloadMaxBlockSizeInBytes\", \"8388608\");\n\n        final OffloadPoliciesImpl created = OffloadPoliciesImpl.create(configured);\n        assertThat(created.toProperties())\n                .containsEntry(\"managedLedgerOffloadDriver\", \"aws-s3\")\n                .containsEntry(\"managedLedgerOffloadBucket\", \"archive\");\n\n        final OffloadPoliciesImpl topic = OffloadPoliciesImpl.builder()\n                .managedLedgerOffloadDriver(\"aws-s3\")\n                .managedLedgerOffloadRegion(\"topic-region\")\n                .build();\n        final OffloadPoliciesImpl namespace = OffloadPoliciesImpl.builder()\n                .managedLedgerOffloadBucket(\"namespace-bucket\")\n                .build();\n        final Properties broker = new Properties();\n        broker.setProperty(OffloadPoliciesImpl.OFFLOAD_THRESHOLD_NAME_IN_CONF_FILE, \"4096\");\n\n        final OffloadPoliciesImpl merged = OffloadPoliciesImpl.mergeConfiguration(topic, namespace, broker);\n        assertThat(merged.getManagedLedgerOffloadRegion()).isEqualTo(\"topic-region\");\n        assertThat(merged.getManagedLedgerOffloadBucket()).isEqualTo(\"namespace-bucket\");\n        assertThat(merged.getManagedLedgerOffloadThresholdInBytes()).isEqualTo(4096L);\n    }\n}\n"}}, {"type": "toolCall", "id": "call_JKM0StStVZ7zsYHoMDMokeuk|fc_01ddf0e646054b84016ad20bf6e0f487d18f35a806b0c35feb", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/FieldParserTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.ArrayList;\nimport java.util.LinkedHashMap;\nimport java.util.LinkedHashSet;\nimport java.util.List;\nimport java.util.Map;\nimport java.util.Optional;\nimport java.util.Set;\n\nimport org.apache.pulsar.common.util.FieldParser;\nimport org.junit.jupiter.api.Test;\n\npublic class FieldParserTest {\n    @Test\n    void convertsUpdatesAndClearsConfigurationFields() {\n        final Configuration configuration = new Configuration();\n        final Map<String, String> values = new LinkedHashMap<>();\n        values.put(\"name\", \"broker-a\");\n        values.put(\"port\", \"6650\");\n        values.put(\"clusters\", \"east, west\");\n        values.put(\"roles\", \"admin, proxy\");\n        values.put(\"weights\", \"primary=10, secondary=20\");\n        values.put(\"optionalPort\", \"7000\");\n\n        FieldParser.update(values, configuration);\n        assertThat(configuration.name).isEqualTo(\"broker-a\");\n        assertThat(configuration.port).isEqualTo(6650);\n        assertThat(configuration.clusters).containsExactly(\"east\", \"west\");\n        assertThat(configuration.roles).containsExactly(\"admin\", \"proxy\");\n        assertThat(configuration.weights).containsEntry(\"primary\", 10).containsEntry(\"secondary\", 20);\n        assertThat(configuration.optionalPort).contains(7000);\n\n        FieldParser.update(Map.of(\"clusters\", \"\", \"roles\", \" \", \"optionalPort\", \"\", \"port\", \"\"), configuration);\n        assertThat(configuration.clusters).isEmpty();\n        assertThat(configuration.roles).isEmpty();\n        assertThat(configuration.optionalPort).isEmpty();\n        assertThat(configuration.port).isNull();\n    }\n\n    public static final class Configuration {\n        private String name = \"initial\";\n        private Integer port = 1;\n        private List<String> clusters = new ArrayList<>(List.of(\"initial\"));\n        private Set<String> roles = new LinkedHashSet<>(Set.of(\"initial\"));\n        private Map<String, Integer> weights = new LinkedHashMap<>(Map.of(\"initial\", 1));\n        private Optional<Integer> optionalPort = Optional.of(1);\n    }\n}\n"}}, {"type": "toolCall", "id": "call_Qc7et5dp7D0QS8XpiUTp6nYG|fc_01ddf0e646054b84016ad20bf6e10087d1b997fa410fbaaeb5", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/AuthenticationUtilTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.Map;\n\nimport org.apache.pulsar.client.api.Authentication;\nimport org.apache.pulsar.client.impl.AuthenticationUtil;\nimport org.apache.pulsar.client.impl.auth.AuthenticationDisabled;\nimport org.apache.pulsar.client.impl.auth.AuthenticationToken;\nimport org.junit.jupiter.api.Test;\n\npublic class AuthenticationUtilTest {\n    @Test\n    void createsAuthenticationPluginsFromEncodedAndMappedParameters() throws Exception {\n        try (Authentication encoded = AuthenticationUtil.create(\n                        AuthenticationToken.class.getName(), \"token:encoded-secret\");\n                Authentication mapped = AuthenticationUtil.create(\n                        AuthenticationToken.class.getName(), Map.of(\"token\", \"mapped-secret\"));\n                Authentication disabled = AuthenticationUtil.create(\"\", Map.of())) {\n            assertThat(encoded).isInstanceOf(AuthenticationToken.class);\n            assertThat(mapped).isInstanceOf(AuthenticationToken.class);\n            assertThat(disabled).isInstanceOf(AuthenticationDisabled.class);\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_xoLzvSnmNelgb7GMeVnHClFu|fc_01ddf0e646054b84016ad20bf6e10887d1b5fe5cfc76686e4e", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/PulsarURLStreamHandlerFactoryTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.io.InputStream;\nimport java.net.URL;\nimport java.net.URLStreamHandler;\nimport java.nio.charset.StandardCharsets;\n\nimport org.apache.pulsar.client.api.url.DataURLStreamHandler;\nimport org.apache.pulsar.client.api.url.PulsarURLStreamHandlerFactory;\nimport org.junit.jupiter.api.Test;\n\npublic class PulsarURLStreamHandlerFactoryTest {\n    @Test\n    void createsAHandlerThatDecodesDataUrls() throws Exception {\n        final URLStreamHandler handler = new PulsarURLStreamHandlerFactory().createURLStreamHandler(\"data\");\n        assertThat(handler).isInstanceOf(DataURLStreamHandler.class);\n\n        final URL url = new URL(null, \"data:text/plain;base64,cHVsc2Fy\", handler);\n        try (InputStream stream = url.openStream()) {\n            assertThat(new String(stream.readAllBytes(), StandardCharsets.UTF_8)).isEqualTo(\"pulsar\");\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_GdOzkvjuYsVzRJMvxTC9eVb9|fc_01ddf0e646054b84016ad20bf6e11087d1971fe27d96ed12a9", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/TopicCompactionStrategyTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.client.api.Schema;\nimport org.apache.pulsar.common.topics.TopicCompactionStrategy;\nimport org.junit.jupiter.api.Test;\n\npublic class TopicCompactionStrategyTest {\n    @Test\n    void loadsAndUsesAConfiguredStrategy() {\n        final String tag = \"largest-value\";\n        try {\n            final TopicCompactionStrategy<?> loaded = TopicCompactionStrategy.load(tag, LargestValue.class.getName());\n            assertThat(loaded).isInstanceOf(LargestValue.class);\n            assertThat(TopicCompactionStrategy.getInstance(tag)).isSameAs(loaded);\n            assertThat(((LargestValue) loaded).shouldKeepLeft(8, 3)).isTrue();\n        } finally {\n            TopicCompactionStrategy.INSTANCES.remove(tag);\n        }\n    }\n\n    public static final class LargestValue implements TopicCompactionStrategy<Integer> {\n        @Override\n        public Schema<Integer> getSchema() {\n            return Schema.INT32;\n        }\n\n        @Override\n        public boolean shouldKeepLeft(Integer previous, Integer current) {\n            return previous >= current;\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_EINbwa6Vj9e093EbJfSox3ut|fc_01ddf0e646054b84016ad20bf6e11c87d18afe02e8ceef9035", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/BrokerEntryMetadataUtilsTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.LinkedHashSet;\nimport java.util.Set;\n\nimport org.apache.pulsar.common.api.proto.BrokerEntryMetadata;\nimport org.apache.pulsar.common.intercept.AppendBrokerTimestampMetadataInterceptor;\nimport org.apache.pulsar.common.intercept.AppendIndexMetadataInterceptor;\nimport org.apache.pulsar.common.intercept.BrokerEntryMetadataInterceptor;\nimport org.apache.pulsar.common.intercept.BrokerEntryMetadataUtils;\nimport org.junit.jupiter.api.Test;\n\npublic class BrokerEntryMetadataUtilsTest {\n    @Test\n    void loadsAndExecutesConfiguredInterceptors() {\n        final Set<String> names = new LinkedHashSet<>();\n        names.add(AppendBrokerTimestampMetadataInterceptor.class.getName());\n        names.add(AppendIndexMetadataInterceptor.class.getName());\n\n        final Set<BrokerEntryMetadataInterceptor> interceptors =\n                BrokerEntryMetadataUtils.loadBrokerEntryMetadataInterceptors(\n                        names, BrokerEntryMetadataUtilsTest.class.getClassLoader());\n        final Set<BrokerEntryMetadataInterceptor> generic = BrokerEntryMetadataUtils.loadInterceptors(\n                names, BrokerEntryMetadataUtilsTest.class.getClassLoader());\n\n        final BrokerEntryMetadata metadata = new BrokerEntryMetadata();\n        interceptors.forEach(interceptor -> interceptor.intercept(metadata));\n        interceptors.forEach(interceptor -> interceptor.interceptWithNumberOfMessages(metadata, 3));\n\n        assertThat(interceptors).hasSize(2);\n        assertThat(generic).hasSize(2);\n        assertThat(metadata.hasBrokerTimestamp()).isTrue();\n        assertThat(metadata.getIndex()).isEqualTo(2L);\n    }\n}\n"}}, {"type": "toolCall", "id": "call_XINcVO1daV33mFqbw0Oud9Tb|fc_01ddf0e646054b84016ad20bf6e12487d18b161efac5cdf270", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/JvmMetricsTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.u