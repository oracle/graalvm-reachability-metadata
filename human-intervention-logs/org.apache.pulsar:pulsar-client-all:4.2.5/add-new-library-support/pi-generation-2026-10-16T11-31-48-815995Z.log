          private final List<Ingredient> values = new ArrayList<>();
  
          public List<Ingredient> getIngredients() {
              return values;
          }
      }
  
      public static final class Ingredient {
          private String name;
  
          public String getName() {
              return name;
          }
  
          public void setName(String name) {
