r-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ResourceLeakDetectorTest.java"}}, {"type": "toolCall", "id": "call_co70My1DOFbVkRjXRuYOeRA4|fc_0936964dff2d7b74016ad502d7944487d1a68d7d5ac2507802", "name": "read", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/required-docker-images.txt"}}, {"type": "toolCall", "id": "call_duwZ70YctDjFgBvoiGSViOj3|fc_0936964dff2d7b74016ad502d7945087d18b7351b4e7c2383e", "name": "bash", "arguments": {"command": "find tests/src -path '*src/test/java*' -type f \\( -iname '*mosquitto*' -o -iname '*mqtt*' \\) | head -20", "timeout": 30}}, {"type": "toolCall", "id": "call_ewbVZ7ziVHiaufKKYrwCT7QV|fc_0936964dff2d7b74016ad502d7945c87d1b67439c34f26e486", "name": "bash", "arguments": {"command": "git show --stat --oneline HEAD && git show --stat --oneline HEAD~1 && git ls-files tests/src/org.apache.pulsar/pulsar-client-all/4.2.5 | wc -l", "timeout": 30}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-sol", "usage": {"input": 2904, "output": 413, "cacheRead": 99968, "cacheWrite": 0, "reasoning": 88, "totalTokens": 103285, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1792344781135, "responseId": "resp_0936964dff2d7b74016ad502ce162887d19cd6fb155e4eaa8f", "rawStopReason": "completed"}, "toolResults": [{"role": "toolResult", "toolCallId": "call_wuIRXwN2rbmOaKj8WIahOOVt|fc_0936964dff2d7b74016ad502d7941c87d1ad8a9d5ac07285be", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.io.IOException;\nimport java.time.Duration;\nimport java.util.EnumSet;\nimport java.util.HashSet;\nimport java.util.Set;\nimport java.util.UUID;\nimport java.util.concurrent.TimeUnit;\nimport org.apache.pulsar.client.api.BatchReceivePolicy;\nimport org.apache.pulsar.client.api.CompressionType;\nimport org.apache.pulsar.client.api.Consumer;\nimport org.apache.pulsar.client.api.Message;\nimport org.apache.pulsar.client.api.Messages;\nimport org.apache.pulsar.client.api.Producer;\nimport org.apache.pulsar.client.api.PulsarClient;\nimport org.apache.pulsar.client.api.PulsarClientException;\nimport org.apache.pulsar.client.api.Schema;\nimport org.apache.pulsar.client.api.SubscriptionInitialPosition;\nimport org.apache.pulsar.shade.javax.ws.rs.client.Client;\nimport org.apache.pulsar.shade.javax.ws.rs.client.ClientBuilder;\nimport org.apache.pulsar.shade.javax.ws.rs.core.MediaType;\nimport org.apache.pulsar.shade.javax.ws.rs.core.Response;\nimport org.junit.jupiter.api.AfterAll;\nimport org.junit.jupiter.api.BeforeAll;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.TestInstance;\nimport org.junit.jupiter.api.Timeout;\n\n@TestInstance(TestInstance.Lifecycle.PER_CLASS)\npublic class PulsarChannelInitializerTest {\n\n    private static final String SERVICE_URL = \"pulsar://localhost:6650\";\n    private static final Duration STARTUP_TIMEOUT = Duration.ofMinutes(5);\n\n    private Process broker;\n    private PulsarClient client;\n\n    @BeforeAll\n    void startBroker() throws Exception {\n        broker = new ProcessBuilder(\n                        \"docker\",\n                        \"run\",\n                        \"--rm\",\n                        \"-p\",\n                        \"6650:6650\",\n                        \"-p\",\n                        \"8080:8080\",\n                        \"apachepulsar/pulsar:4.2.5\",\n                        \"bin/pulsar\",\n                        \"standalone\")\n                .inheritIO()\n                .start();\n        client = waitForBroker();\n    }\n\n    @AfterAll\n    void stopBroker() throws Exception {\n        if (client != null) {\n            client.close();\n        }\n        if (broker != null && broker.isAlive()) {\n            broker.destroy();\n            if (!broker.waitFor(20, TimeUnit.SECONDS)) {\n                broker.destroyForcibly();\n                broker.waitFor(20, TimeUnit.SECONDS);\n            }\n        }\n    }\n\n    @Test\n    @Timeout(60)\n    void publishesAndConsumesMessagesWithEveryCompressionCodec() throws Exception {\n        final String topic = \"persistent://public/default/metadata-\" + UUID.randomUUID();\n        final EnumSet<CompressionType> compressionTypes = EnumSet.allOf(CompressionType.class);\n        final BatchReceivePolicy batchPolicy = BatchReceivePolicy.builder()\n                .maxNumMessages(compressionTypes.size())\n                .timeout(10, TimeUnit.SECONDS)\n                .build();\n\n        try (Consumer<String> consumer = client.newConsumer(Schema.STRING)\n                .topic(topic)\n                .subscriptionName(\"metadata-subscription\")\n                .subscriptionInitialPosition(SubscriptionInitialPosition.Earliest)\n                .batchReceivePolicy(batchPolicy)\n                .subscribe()) {\n            for (CompressionType compressionType : compressionTypes) {\n                try (Producer<String> producer = client.newProducer(Schema.STRING)\n                        .topic(topic)\n                        .producerName(\"producer-\" + compressionType.name().toLowerCase())\n                        .compressionType(compressionType)\n                        .compressionMinMsgBodySize(0)\n                        .sendTimeout(30, TimeUnit.SECONDS)\n                        .create()) {\n                    producer.newMessage()\n                            .property(\"compression\", compressionType.name())\n                            .value(\"payload-\" + compressionType.name())\n                            .send();\n                }\n            }\n\n            final Messages<String> received = consumer.batchReceive();\n            final Set<String> values = new HashSet<>();\n            for (Message<String> message : received) {\n                values.add(message.getValue());\n                assertThat(message.getProperty(\"compression\")).isNotBlank();\n                consumer.acknowledge(message);\n            }\n\n            assertThat(values).containsExactlyInAnyOrderElementsOf(compressionTypes.stream()\n                    .map(type -> \"payload-\" + type.name())\n                    .toList());\n        }\n    }\n\n    @Test\n    @Timeout(60)\n    void queriesBrokerAdministrationEndpointWithJerseyClient() {\n        final Client httpClient = ClientBuilder.newBuilder()\n                .connectTimeout(10, TimeUnit.SECONDS)\n                .readTimeout(10, TimeUnit.SECONDS)\n                .build();\n        try {\n            try (Response response = httpClient.target(\"http://localhost:8080/admin/v2/clusters\")\n                    .request(MediaType.APPLICATION_JSON_TYPE)\n                    .get()) {\n                assertThat(response.getStatus()).isEqualTo(200);\n                assertThat(response.readEntity(String.class)).contains(\"standalone\");\n            }\n        } finally {\n            httpClient.close();\n        }\n    }\n\n    private PulsarClient waitForBroker() throws Exception {\n        final long deadline = System.nanoTime() + STARTUP_TIMEOUT.toNanos();\n        Exception lastFailure = null;\n        while (System.nanoTime() < deadline) {\n            if (!broker.isAlive()) {\n                throw new IllegalStateException(\"Pulsar broker process exited with code \" + broker.exitValue());\n            }\n\n            PulsarClient candidate = null;\n            try {\n                candidate = newClient();\n                candidate.getPartitionsForTopic(\"persistent://public/default/readiness\")\n                        .get(15, TimeUnit.SECONDS);\n                return candidate;\n            } catch (Exception e) {\n                lastFailure = e;\n                closeCandidate(candidate);\n                Thread.sleep(2000);\n            }\n        }\n        throw new IllegalStateException(\"Pulsar broker did not become ready within \" + STARTUP_TIMEOUT, lastFailure);\n    }\n\n    private static PulsarClient newClient() throws PulsarClientException {\n        return PulsarClient.builder()\n                .serviceUrl(SERVICE_URL)\n                .connectionTimeout(15, TimeUnit.SECONDS)\n                .lookupTimeout(15, TimeUnit.SECONDS)\n                .operationTimeout(30, TimeUnit.SECONDS)\n                .build();\n    }\n\n    private static void closeCandidate(PulsarClient candidate) throws IOException {\n        if (candidate != null) {\n            candidate.close();\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792344792402}, {"role": "toolResult", "toolCallId": "call_UzyCr3xxtNdkEEEoUgHzbYo2|fc_0936964dff2d7b74016ad502d7943087d18b0c96c5d36230ae", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.security.Provider;\nimport java.security.Security;\nimport org.apache.pulsar.common.util.SecurityUtility;\nimport org.junit.jupiter.api.Test;\n\npublic class SecurityUtilityTest {\n\n    @Test\n    void loadsAndRegistersBouncyCastleFromTheClientClasspath() throws Exception {\n        final Provider provider = SecurityUtility.getBCProviderFromClassPath();\n\n        assertThat(provider.getName()).isNotBlank();\n        assertThat(Security.getProvider(provider.getName()).getName()).isEqualTo(provider.getName());\n    }\n}\n"}], "isError": false, "timestamp": 1792344792403}, {"role": "toolResult", "toolCallId": "call_bDF0NYYcYnqfoxW0flvBRyjN|fc_0936964dff2d7b74016ad502d7943c87d1aa36833c7ef65be4", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.io.netty.util.ResourceLeakDetector;\nimport org.apache.pulsar.shade.io.netty.util.ResourceLeakTracker;\nimport org.junit.jupiter.api.Test;\n\npublic class ResourceLeakDetectorTest {\n\n    @Test\n    void validatesExclusionMethodsAndTracksResourceLifecycle() {\n        ResourceLeakDetector.addExclusions(TrackedResource.class, \"close\");\n        final ResourceLeakDetector<TrackedResource> detector =\n                new ResourceLeakDetector<>(TrackedResource.class, 1);\n        final TrackedResource resource = new TrackedResource();\n        final ResourceLeakTracker<TrackedResource> tracker = detector.trackForcibly(resource);\n\n        assertThat(tracker).isNotNull();\n        tracker.record(\"used\");\n        assertThat(tracker.close(resource)).isTrue();\n    }\n\n    public static final class TrackedResource {\n        public void close() {\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792344792404}, {"role": "toolResult", "toolCallId": "call_co70My1DOFbVkRjXRuYOeRA4|fc_0936964dff2d7b74016ad502d7944487d1a68d7d5ac2507802", "toolName": "read", "content": [{"type": "text", "text": "apachepulsar/pulsar:4.2.5\n"}], "isError": false, "timestamp": 1792344792404}, {"role": "toolResult", "toolCallId": "call_duwZ70YctDjFgBvoiGSViOj3|fc_0936964dff2d7b74016ad502d7945087d18b7351b4e7c2383e", "toolName": "bash", "content": [{"type": "text", "text": "tests/src/io.netty/netty-codec-mqtt/4.1.74.Final/src/test/java/io_netty/netty_codec_mqtt/Netty_codec_mqttTest.java\ntests/src/org.eclipse.paho/org.eclipse.paho.mqttv5.client/1.2.5/src/test/java/org_eclipse_paho/org_eclipse_paho_mqttv5_client/MqttExceptionTest.java\ntests/src/org.eclipse.paho/org.eclipse.paho.mqttv5.client/1.2.5/src/test/java/org_eclipse_paho/org_eclipse_paho_mqttv5_client/Mqttv5ClientTest.java\ntests/src/org.eclipse.paho/org.eclipse.paho.client.mqttv3/1.2.5/src/test/java/org_eclipse_paho/org_eclipse_paho_client_mqttv3/Mqttv3Test.java\n"}], "isError": false, "timestamp": 1792344792407}, {"role": "toolResult", "toolCallId": "call_ewbVZ7ziVHiaufKKYrwCT7QV|fc_0936964dff2d7b74016ad502d7945c87d1b67439c34f26e486", "toolName": "bash", "content": [{"type": "text", "text": "d41dbab835 Bulk dynamic-access coverage (299/989)\n .../pulsar-client-all/4.2.5/user-code-filter.json           | 13 ++++++++-----\n 1 file changed, 8 insertions(+), 5 deletions(-)\n37b7eb817f Fix Pulsar dynamic-access test failures\n .../pulsar_client_all/BeanAsArrayBuilderDeserializerTest.java  |  2 ++\n .../DateDeserializersInnerCalendarDeserializerTest.java        | 10 +++++++++-\n .../pulsar_client_all/NioDatagramChannelConfigTest.java        |  4 ++++\n .../pulsar_client_all/TypeDescriptionTest.java                 |  3 +++\n 4 files changed, 18 insertions(+), 1 deletion(-)\n89\n"}], "isError": false, "timestamp": 1792344792407}]}
