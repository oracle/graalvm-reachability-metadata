: "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ClassLoaderObjectInputStreamTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.io.ByteArrayInputStream;\nimport java.util.ArrayList;\nimport java.util.List;\nimport org.apache.pulsar.shade.org.apache.commons.io.input.ClassLoaderObjectInputStream;\nimport org.apache.pulsar.shade.org.apache.commons.lang3.SerializationUtils;\nimport org.junit.jupiter.api.Test;\n\npublic class ClassLoaderObjectInputStreamTest {\n\n    @Test\n    void resolvesSerializedClassesWithTheConfiguredLoader() throws Exception {\n        final ArrayList<String> source = new ArrayList<>(List.of(\"created\", \"stored\"));\n        final byte[] serialized = SerializationUtils.serialize(source);\n\n        try (ClassLoaderObjectInputStream input = new ClassLoaderObjectInputStream(\n                getClass().getClassLoader(), new ByteArrayInputStream(serialized))) {\n            assertThat(input.readObject()).isEqualTo(source);\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_M2ju0fz7ksFcPehEHQ78lsqQ|fc_0936964dff2d7b74016ad5051f593887d1b6fb42ff8e526640", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ValidatingObjectInputStreamTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.io.ByteArrayInputStream;\nimport java.util.ArrayList;\nimport java.util.List;\nimport org.apache.pulsar.shade.org.apache.commons.io.serialization.ValidatingObjectInputStream;\nimport org.apache.pulsar.shade.org.apache.commons.lang3.SerializationUtils;\nimport org.junit.jupiter.api.Test;\n\npublic class ValidatingObjectInputStreamTest {\n\n    @Test\n    void deserializesOnlyExplicitlyAcceptedCollectionTypes() throws Exception {\n        final ArrayList<String> source = new ArrayList<>(List.of(\"created\", \"stored\"));\n        final byte[] serialized = SerializationUtils.serialize(source);\n\n        try (ValidatingObjectInputStream input = new ValidatingObjectInputStream(\n                        new ByteArrayInputStream(serialized))\n                .accept(ArrayList.class)) {\n            final ArrayList<?> restored = input.readObjectCast();\n            assertThat(restored).containsExactly(\"created\", \"stored\");\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_5nvQz36lVR6GU6ZxIkcMrX3S|fc_0936964dff2d7b74016ad5051f595487d197ee24c34c141636", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/CompatibleObjectEncoderTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.io.ObjectInputStream;\nimport org.apache.pulsar.shade.io.netty.buffer.ByteBuf;\nimport org.apache.pulsar.shade.io.netty.buffer.ByteBufInputStream;\nimport org.apache.pulsar.shade.io.netty.channel.embedded.EmbeddedChannel;\nimport org.apache.pulsar.shade.io.netty.handler.codec.serialization.CompatibleObjectEncoder;\nimport org.junit.jupiter.api.Test;\n\npublic class CompatibleObjectEncoderTest {\n\n    @Test\n    @SuppressWarnings(\"deprecation\")\n    void writesAStandardJavaSerializationStream() throws Exception {\n        final EmbeddedChannel encoder = new EmbeddedChannel(new CompatibleObjectEncoder());\n        try {\n            assertThat(encoder.writeOutbound(\"pulsar-message\")).isTrue();\n            final ByteBuf encoded = encoder.readOutbound();\n            try (ObjectInputStream input = new ObjectInputStream(new ByteBufInputStream(encoded, true))) {\n                assertThat(input.readObject()).isEqualTo(\"pulsar-message\");\n            }\n        } finally {\n            encoder.finishAndReleaseAll();\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_sbUKcNsstdLJrupb8UH1AVMt|fc_0936964dff2d7b74016ad5051f596487d1a6b339fb4b2d13ec", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/CompactObjectInputStreamTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.io.Serializable;\nimport org.apache.pulsar.shade.io.netty.buffer.ByteBuf;\nimport org.apache.pulsar.shade.io.netty.channel.embedded.EmbeddedChannel;\nimport org.apache.pulsar.shade.io.netty.handler.codec.serialization.ClassResolvers;\nimport org.apache.pulsar.shade.io.netty.handler.codec.serialization.ObjectDecoder;\nimport org.apache.pulsar.shade.io.netty.handler.codec.serialization.ObjectEncoder;\nimport org.junit.jupiter.api.Test;\n\npublic class CompactObjectInputStreamTest {\n\n    @Test\n    void resolvesAndReadsAUserDefinedMessageClass() {\n        final EmbeddedChannel encoder = new EmbeddedChannel(new ObjectEncoder());\n        final EmbeddedChannel decoder = new EmbeddedChannel(\n                new ObjectDecoder(ClassResolvers.cacheDisabled(getClass().getClassLoader())));\n        try {\n            assertThat(encoder.writeOutbound(new Message(\"orders\", 7))).isTrue();\n            final ByteBuf encoded = encoder.readOutbound();\n            assertThat(decoder.writeInbound(encoded)).isTrue();\n\n            assertThat((Message) decoder.readInbound()).isEqualTo(new Message(\"orders\", 7));\n        } finally {\n            encoder.finishAndReleaseAll();\n            decoder.finishAndReleaseAll();\n        }\n    }\n\n    public record Message(String topic, int sequence) implements Serializable {\n        private static final long serialVersionUID = 1L;\n    }\n}\n"}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-sol", "usage": {"input": 314, "output": 1795, "cacheRead": 175616, "cacheWrite": 0, "reasoning": 265, "totalTokens": 177725, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1792345341435, "responseId": "resp_0936964dff2d7b74016ad504fdf92487d1bb484310e04ab259", "rawStopReason": "completed"}, "toolResults": [{"role": "toolResult", "toolCallId": "call_x2KucuGH5S2RHYqgOeM2FYYs|fc_0936964dff2d7b74016ad5051f591487d180a7a043f668c788", "toolName": "write", "content": [{"type": "text", "text": "Successfully wrote 1146 bytes to tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ClassLoaderObjectInputStreamTest.java"}], "isError": false, "timestamp": 1792345375659}, {"role": "toolResult", "toolCallId": "call_M2ju0fz7ksFcPehEHQ78lsqQ|fc_0936964dff2d7b74016ad5051f593887d1b6fb42ff8e526640", "toolName": "write", "content": [{"type": "text", "text": "Successfully wrote 1246 bytes to tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ValidatingObjectInputStreamTest.java"}], "isError": false, "timestamp": 1792345375659}, {"role": "toolResult", "toolCallId": "call_5nvQz36lVR6GU6Z