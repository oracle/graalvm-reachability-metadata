void preservesPrimitiveLongMappings() {\n        final Long2ObjectArrayMap<String> source = new Long2ObjectArrayMap<>();\n        source.put(1L, \"one\");\n        source.put(2L, \"two\");\n\n        final Long2ObjectArrayMap<String> restored = SerializationUtils.clone(source);\n\n        assertThat(restored.get(1L)).isEqualTo(\"one\");\n        assertThat(restored.get(2L)).isEqualTo(\"two\");\n    }\n}\n"}}, {"type": "toolCall", "id": "call_IUK47S3kntXSHSXDfqjlAmVW|fc_0936964dff2d7b74016ad5043e91fc87d1aff4dbfc95a92bab", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/Long2ObjectOpenHashMapTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.it.unimi.dsi.fastutil.longs.Long2ObjectOpenHashMap;\nimport org.apache.pulsar.shade.org.apache.commons.lang3.SerializationUtils;\nimport org.junit.jupiter.api.Test;\n\npublic class Long2ObjectOpenHashMapTest {\n\n    @Test\n    void preservesPrimitiveLongHashMappings() {\n        final Long2ObjectOpenHashMap<String> source = new Long2ObjectOpenHashMap<>();\n        source.put(0L, \"zero\");\n        source.put(23L, \"twenty-three\");\n\n        final Long2ObjectOpenHashMap<String> restored = SerializationUtils.clone(source);\n\n        assertThat(restored.get(0L)).isEqualTo(\"zero\");\n        assertThat(restored.get(23L)).isEqualTo(\"twenty-three\");\n    }\n}\n"}}, {"type": "toolCall", "id": "call_BaQF2T1EuGqRFKcog3Ll1YzB|fc_0936964dff2d7b74016ad5043e920887d1900d219297ce98c6", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/Long