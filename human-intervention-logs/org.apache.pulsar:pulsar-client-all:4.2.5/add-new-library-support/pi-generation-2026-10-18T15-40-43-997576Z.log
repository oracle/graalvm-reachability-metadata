[recv] {"type": "message_start", "message": {"role": "toolResult", "toolCallId": "call_HSzZaKZbDs2V9P1DBkGfxrEi|fc_0c4b4cfdacc159d6016ad4eb5e568887d18fb68bbfe6d767fd", "toolName": "bash", "content": [{"type": "text", "text": "diff --git a/tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ClientBuilderTest.java b/tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ClientBuilderTest.java\nnew file mode 100644\nindex 0000000000..00bf9e499f\n--- /dev/null\n+++ b/tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ClientBuilderTest.java\n@@ -0,0 +1,62 @@\n+/*\n+ * Copyright and related rights waived via CC0\n+ *\n+ * You should have received a copy of the CC0 legalcode along with this\n+ * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n+ */\n+package org_apache_pulsar.pulsar_client_all;\n+\n+import static org.assertj.core.api.Assertions.assertThat;\n+\n+import com.sun.net.httpserver.HttpExchange;\n+import com.sun.net.httpserver.HttpServer;\n+import java.io.IOException;\n+import java.io.OutputStream;\n+import java.net.InetAddress;\n+import java.net.InetSocketAddress;\n+import java.nio.charset.StandardCharsets;\n+import java.util.concurrent.ExecutorService;\n+import java.util.concurrent.Executors;\n+import java.util.concurrent.TimeUnit;\n+import org.apache.pulsar.shade.javax.ws.rs.client.Client;\n+import org.apache.pulsar.shade.javax.ws.rs.client.ClientBuilder;\n+import org.apache.pulsar.shade.javax.ws.rs.core.MediaType;\n+import org.apache.pulsar.shade.javax.ws.rs.core.Response;\n+import org.junit.jupiter.api.Test;\n+\n+public class ClientBuilderTest {\n+\n+    @Test\n+    void performsHttpRequestThroughJerseyClient() throws Exception {\n+        final ExecutorService executor = Executors.newSingleThreadExecutor();\n+        final HttpServer server = HttpServer.create(new InetSocketAddress(InetAddress.getLoopbackAddress(), 0), 0);\n+        server.setExecutor(executor);\n+        server.createContext(\"/status\", exchange -> respond(exchange, \"ready\"));\n+        server.start();\n+\n+        try (Client client = ClientBuilder.newBuilder()\n+                .connectTimeout(10, TimeUnit.SECONDS)\n+                .readTimeout(10, TimeUnit.SECONDS)\n+                .build()) {\n+            final String endpoint = \"http://\" + server.getAddress().getHostString() + \":\"\n+                    + server.getAddress().getPort() + \"/status\";\n+            try (Response response = client.target(endpoint).request(MediaType.TEXT_PLAIN_TYPE).get()) {\n+                assertThat(response.getStatus()).isEqualTo(200);\n+                assertThat(response.readEntity(String.class)).isEqualTo(\"ready\");\n+            }\n+        } finally {\n+            server.stop(0);\n+            executor.shutdownNow();\n+            assertThat(executor.awaitTermination(10, TimeUnit.SECONDS)).isTrue();\n+        }\n+    }\n+\n+    private static void respond(HttpExchange exchange, String body) throws IOException {\n+        final byte[] payload = body.getBytes(StandardCharsets.UTF_8);\n+        exchange.getResponseHeaders().set(\"Content-Type\", \"text/plain\");\n+        exchange.sendResponseHeaders(200, payload.length);\n+        try (OutputStream output = exchange.getResponseBody()) {\n+            output.write(payload);\n+        }\n+    }\n+}\ndiff --git a/tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/PulsarChannelInitializerTest.java b/tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/PulsarChannelInitializerTest.java\nnew file mode 100644\nindex 0000000000..20ec406a56\n--- /dev/null\n+++ b/tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/PulsarChannelInitializerTest.java\n@@ -0,0 +1,157 @@\n+/*\n+ * Copyright and related rights waived via CC0\n+ *\n+ * You should have received a copy of the CC0 legalcode along with this\n+ * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n+ */\n+package org_apache_pulsar.pulsar_client_all;\n+\n+import static org.assertj.core.api.Assertions.assertThat;\n+\n+import java.io.IOException;\n+import java.time.Duration;\n+import java.util.EnumSet;\n+import java.util.HashSet;\n+import java.util.Set;\n+import java.util.UUID;\n+import java.util.concurrent.TimeUnit;\n+import org.apache.pulsar.client.api.BatchReceivePolicy;\n+import org.apache.pulsar.client.api.CompressionType;\n+import org.apache.pulsar.client.api.Consumer;\n+import org.apache.pulsar.client.api.Message;\n+import org.apache.pulsar.client.api.Messages;\n+import org.apache.pulsar.client.api.Producer;\n+import org.apache.pulsar.client.api.PulsarClient;\n+import org.apache.pulsar.client.api.PulsarClientException;\n+import org.apache.pulsar.client.api.Schema;\n+import org.apache.pulsar.client.api.SubscriptionInitialPosition;\n+import org.junit.jupiter.api.AfterAll;\n+import org.junit.jupiter.api.BeforeAll;\n+import org.junit.jupiter.api.Test;\n+import org.junit.jupiter.api.TestInstance;\n+import org.junit.jupiter.api.Timeout;\n+\n+@TestInstance(TestInstance.Lifecycle.PER_CLASS)\n+public class PulsarChannelInitializerTest {\n+\n+    private static final String SERVICE_URL = \"pulsar://localhost:6650\";\n+    private static final Duration STARTUP_TIMEOUT = Duration.ofMinutes(5);\n+\n+    private Process broker;\n+    private PulsarClient client;\n+\n+    @BeforeAll\n+    void startBroker() throws Exception {\n+        broker = new ProcessBuilder(\n+                        \"docker\",\n+                        \"run\",\n+                        \"--rm\",\n+                        \"-p\",\n+                        \"6650:6650\",\n+                        \"-p\",\n+                        \"8080:8080\",\n+                        \"apachepulsar/pulsar:4.2.5\",\n+                        \"bin/pulsar\",\n+                        \"standalone\")\n+                .inheritIO()\n+                .start();\n+        client = waitForBroker();\n+    }\n+\n+    @AfterAll\n+    void stopBroker() throws Exception {\n+        if (client != null) {\n+            client.close();\n+        }\n+        if (broker != null && broker.isAlive()) {\n+            broker.destroy();\n+            if (!broker.waitFor(20, TimeUnit.SECONDS)) {\n+                broker.destroyForcibly();\n+                broker.waitFor(20, TimeUnit.SECONDS);\n+            }\n+        }\n+    }\n+\n+    @Test\n+    @Timeout(60)\n+    void publishesAndConsumesMessagesWithEveryCompressionCodec() throws Exception {\n+        final String topic = \"persistent://public/default/metadata-\" + UUID.randomUUID();\n+        final EnumSet<CompressionType> compressionTypes = EnumSet.allOf(CompressionType.class);\n+        final BatchReceivePolicy batchPolicy = BatchReceivePolicy.builder()\n+                .maxNumMessages(compressionTypes.size())\n+                .timeout(10, TimeUnit.SECONDS)\n+                .build();\n+\n+        try (Consumer<String> consumer = client.newConsumer(Schema.STRING)\n+                .topic(topic)\n+                .subscriptionName(\"metadata-subscription\")\n+                .subscriptionInitialPosition(SubscriptionInitialPosition.Earliest)\n+                .batchReceivePolicy(batchPolicy)\n+                .subscribe()) {\n+            for (CompressionType compressionType : compressionTypes) {\n+                try (Producer<String> producer = client.newProducer(Schema.STRING)\n+                        .topic(topic)\n+                        .producerName(\"producer-\" + compressionType.name().toLowerCase())\n+                        .compressionType(compressionType)\n+                        .compressionMinMsgBodySize(0)\n+                        .sendTimeout(30, TimeUnit.SECONDS)\n+                        .create()) {\n+                    producer.newMessage()\n+                            .property(\"compression\", compressionType.name())\n+                            .value(\"payload-\" + compressionType.name())\n+                            .send();\n+                }\n+            }\n+\n+            final Messages<String> received = consumer.batchReceive();\n+            final Set<String> values = new HashSet<>();\n+            for (Message<String> message : received) {\n+                values.add(message.getValue());\n+                assertThat(message.getProperty(\"compression\")).isNotBlank();\n+                consumer.acknowledge(message);\n+            }\n+\n+            assertThat(values).containsExactlyInAnyOrderElementsOf(compressionTypes.stream()\n+                    .map(type -> \"payload-\" + type.name())\n+                    .toList());\n+        }\n+    }\n+\n+    private PulsarClient waitForBroker() throws Exception {\n+        final long deadline = System.nanoTime() + STARTUP_TIMEOUT.toNanos();\n+        Exception lastFailure = null;\n+        while (System.nanoTime() < deadline) {\n+            if (!broker.isAlive()) {\n+                throw new IllegalStateException(\"Pulsar broker process exited with code \" + broker.exitValue());\n+            }\n+\n+            PulsarClient candidate = null;\n+            try {\n+                candidate = newClient();\n+                candidate.getPartitionsForTopic(\"persistent://public/default/readiness\")\n+                        .get(15, TimeUnit.SECONDS);\n+                return candidate;\n+            } catch (Exception e) {\n+                lastFailure = e;\n+                closeCandidate(candidate);\n+                Thread.sleep(2000);\n+            }\n+        }\n+        throw new IllegalStateException(\"Pulsar broker did not become ready within \" + STARTUP_TIMEOUT, lastFailure);\n+    }\n+\n+    private static PulsarClient newClient() throws PulsarClientException {\n+        return PulsarClient.builder()\n+                .serviceUrl(SERVICE_URL)\n+                .connectionTimeout(15, TimeUnit.SECONDS)\n+                .lookupTimeout(15, TimeUnit.SECONDS)\n+                .operationTimeout(30, TimeUnit.SECONDS)\n+                .build();\n+    }\n+\n+    private static void closeCandidate(PulsarClient candidate) throws IOException {\n+        if (candidate != null) {\n+            candidate.close();\n+        }\n+    }\n+}\n"}], "isError": false, "timestamp": 1792338783545}}
