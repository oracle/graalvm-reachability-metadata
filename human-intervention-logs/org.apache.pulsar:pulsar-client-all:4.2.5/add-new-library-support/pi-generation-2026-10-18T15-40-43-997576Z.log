();\n        final Map<String, String> values = new LinkedHashMap<>();\n        values.put(\"name\", \"primary\");\n        values.put(\"port\", \"6650\");\n        values.put(\"enabled\", \"true\");\n        values.put(\"clusters\", \"east, west\");\n        values.put(\"roles\", \"reader, writer, reader\");\n        values.put(\"weights\", \"east=4, west=6\");\n        values.put(\"fallbackPort\", \"6651\");\n\n        FieldParser.update(values, target);\n\n        assertThat(target.name).isEqualTo(\"primary\");\n        assertThat(target.port).isEqualTo(6650);\n        assertThat(target.enabled).isTrue();\n        assertThat(target.clusters).containsExactly(\"east\", \"west\");\n        assertThat(target.roles).containsExactly(\"reader\", \"writer\");\n        assertThat(target.weights).containsEntry(\"east\", 4).containsEntry(\"west\", 6);\n        assertThat(target.fallbackPort).contains(6651);\n    }\n\n    @Test\n    void clearsOptionalCollectionAndNumberValuesForBlankConfiguration() {\n        final ParserTarget target = new ParserTarget();\n\n        FieldParser.update(Map.of(\"port\", \"\", \"clusters\", \" \", \"fallbackPort\", \"\"), target);\n\n        assertThat(target.port).isNull();\n        assertThat(target.clusters).isEmpty();\n        assertThat(target.fallbackPort).isEmpty();\n    }\n\n    public static final class ParserTarget {\n        private String name = \"unset\";\n        private Integer port = 1;\n        private Boolean enabled = false;\n        private List<String> clusters = new ArrayList<>(List.of(\"initial\"));\n        private Set<String> roles = new LinkedHashSet<>();\n        private Map<String, Integer> weights = new LinkedHashMap<>();\n        private Optional<Integer> fallbackPort = Optional.of(1);\n    }\n}\n"}], "isError": false, "timestamp": 1792344923366}, {"role": "toolResult", "toolCallId": "call_S8OwwJk32qKVur8TBshnkj2V|fc_0936964dff2d7b74016ad5035b1d9c87d1ae1253b89e9912b9", "toolName": "read", "content": [{"type": "text", "text": "                if (typeClazz instanceof ParameterizedType) {\n                    throw new IllegalArgumentException(format(\"unsupported non-primitive Optional<%s> for %s\",\n                            typeClazz.getClass(), field.getName()));\n                }\n                return Optional.ofNullable(convert(strValue, (Class) typeClazz));\n            } else {\n                throw new IllegalArgumentException(\n                        format(\"unsupported field-type %s for %s\", field.getType(), field.getName()));\n            }\n        } else {\n            return convert(strValue, field.getType());\n        }\n    }\n\n    /**\n     * Sets the empty/null value if field is allowed to be set empty.\n     *\n     * @param strValue\n     * @param field\n     * @param obj\n     * @throws IllegalArgumentException\n     * @throws IllegalAccessException\n     */\n    public static <T> void setEmptyValue(String strValue, Field field, T obj)\n            throws IllegalArgumentException, IllegalAccessException {\n        requireNonNull(field);\n        // if field is not primitive type\n        Type fieldType = field.getGenericType();\n        if (fieldType instanceof ParameterizedType) {\n            if (field.getType().equals(List.class)) {\n                field.set(obj, new ArrayList<>());\n            } else if (field.getType().equals(Set.class)) {\n                field.set(obj, new LinkedHashSet<>());\n            } else if (field.getType().equals(Optional.class)) {\n                field.set(obj, Optional.empty());\n            } else {\n                throw new IllegalArgumentException(\n                        format(\"unsupported field-type %s for %s\", field.getType(), field.getName()));\n            }\n        } else if (Number.class.isAssignableFrom(field.getType()) || fieldType.getClass().equals(String.class)) {\n            field.set(obj, null);\n        }\n    }\n\n    private static Class<?> wrap(Class<?> type) {\n        return WRAPPER_TYPES.containsKey(type) ? WRAPPER_TYPES.get(type) : type;\n    }\n\n    private static void initConverters() {\n        Method[] methods = FieldParser.class.getDeclaredMethods();\n        Arrays.stream(methods).forEach(method -> {\n\n            if (method.getParameterTypes().length == 1) {\n                // Converter should accept 1 argument. This skips the convert() method.\n                CONVERTERS.put(method.getParameterTypes()[0].getName() + \"_\" + method.getReturnType().getName(),\n\n[165 more lines in file. Use offset=235 to continue.]"}], "isError": false, "timestamp": 1792344923366}, {"role": "toolResult", "toolCallId": "call_FQa3BGMJFwgNTxg2h4QVu7MU|fc_0936964dff2d7b74016ad5035b1da887d18b9e005f2df46c67", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.BeanDescription;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.ObjectMapper;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.introspect.AnnotatedMethod;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.introspect.BeanPropertyDefinition;\nimport org.junit.jupiter.api.Test;\n\npublic class AnnotatedMethodTest {\n\n    @Test\n    void invokesMethodsDiscoveredByJacksonIntrospection() throws Exception {\n        final ObjectMapper mapper = new ObjectMapper();\n        final BeanDescription serialization = mapper.getSerializationConfig()\n                .introspect(mapper.constructType(MethodBean.class));\n        final BeanDescription deserialization = mapper.getDeserializationConfig()\n                .introspect(mapper.constructType(MethodBean.class));\n        final AnnotatedMethod getter = property(serialization).getGetter();\n        final AnnotatedMethod setter = property(deserialization).getSetter();\n        final MethodBean bean = new MethodBean();\n\n        setter.callOnWith(bean, \"orders\");\n        assertThat(getter.callOn(bean)).isEqualTo(\"orders\");\n        setter.setValue(bean, \"events\");\n        assertThat(getter.getValue(bean)).isEqualTo(\"events\");\n    }\n\n    private static BeanPropertyDefinition property(BeanDescription description) {\n        return description.findProperties().stream()\n                .filter(candidate -> candidate.getName().equals(\"name\"))\n                .findFirst()\n                .orElseThrow();\n    }\n\n    public static final class MethodBean {\n        private String name;\n\n        public String getName() {\n            return name;\n        }\n\n        public void setName(String name) {\n            this.name = name;\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792344923366}, {"role": "toolResult", "toolCallId": "call_IzTueLYFBiyLNjAQRvBKRCuT|fc_0936964dff2d7b74016ad5035b1db087d1b3a859d9620f55dd", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport com.fasterxml.jackson.annotation.JsonFormat;\nimport com.fasterxml.jackson.annotation.JsonPropertyOrder;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.ObjectMapper;\nimport org.junit.jupiter.api.Test;\n\npublic class BeanPropertyWriterTest {\n\n    @Test\n    void serializesFieldAndGetterPropertiesAsArrayElements() throws Exception {\n        final ArrayMessage message = new ArrayMessage();\n        message.topic = \"orders\";\n        message.sequence = 41;\n\n        assertThat(new ObjectMapper().writeValueAsString(message)).isEqualTo(\"[\\\"orders\\\",41]\");\n    }\n\n    @JsonFormat(shape = JsonFormat.Shape.ARRAY)\n    @JsonPropertyOrder({\"topic\", \"sequence\"})\n    public static final class ArrayMessage {\n        public String topic;\n        private int sequence;\n\n        public int getSequence() {\n            return sequence;\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792344923366}]}
