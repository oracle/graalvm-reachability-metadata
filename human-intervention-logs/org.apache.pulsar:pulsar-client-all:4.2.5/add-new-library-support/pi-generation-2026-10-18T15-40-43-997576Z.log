 If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.io.IOException;\nimport java.time.Duration;\nimport java.util.EnumSet;\nimport java.util.HashSet;\nimport java.util.Set;\nimport java.util.UUID;\nimport java.util.concurrent.TimeUnit;\nimport org.apache.pulsar.client.api.BatchReceivePolicy;\nimport org.apache.pulsar.client.api.CompressionType;\nimport org.apache.pulsar.client.api.Consumer;\nimport org.apache.pulsar.client.api.Message;\nimport org.apache.pulsar.client.api.Messages;\nimport org.apache.pulsar.client.api.Producer;\nimport org.apache.pulsar.client.api.PulsarClient;\nimport org.apache.pulsar.client.api.PulsarClientException;\nimport org.apache.pulsar.client.api.Schema;\nimport org.apache.pulsar.client.api.SubscriptionInitialPosition;\nimport org.apache.pulsar.shade.javax.ws.rs.client.Client;\nimport org.apache.pulsar.shade.javax.ws.rs.client.ClientBuilder;\nimport org.apache.pulsar.shade.javax.ws.rs.core.MediaType;\nimport org.apache.pulsar.shade.javax.ws.rs.core.Response;\nimport org.junit.jupiter.api.AfterAll;\nimport org.junit.jupiter.api.BeforeAll;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.TestInstance;\nimport org.junit.jupiter.api.Timeout;\n\n@TestInstance(TestInstance.Lifecycle.PER_CLASS)\npublic class PulsarChannelInitializerTest {\n\n    private static final String SERVICE_URL = \"pulsar://localhost:6650\";\n    private static final Duration STARTUP_TIMEOUT = Duration.ofMinutes(5);\n\n    private Process broker;\n    private PulsarClient client;\n\n    @BeforeAll\n    void startBroker() throws Exception {\n        broker = new ProcessBuilder(\n                        \"docker\",\n                        \"run\",\n                        \"--rm\",\n                        \"-p\",\n                        \"6650:6650\",\n                        \"-p\",\n                        \"8080:8080\",\n                        \"apachepulsar/pulsar:4.2.5\",\n                        \"bin/pulsar\",\n                        \"standalone\")\n                .inheritIO()\n                .start();\n        client = waitForBroker();\n    }\n\n    @AfterAll\n    void stopBroker() throws Exception {\n        if (client != null) {\n            client.close();\n        }\n        if (broker != null && broker.isAlive()) {\n            broker.destroy();\n            if (!broker.waitFor(20, TimeUnit.SECONDS)) {\n                broker.destroyForcibly();\n                broker.waitFor(20, TimeUnit.SECONDS);\n            }\n        }\n    }\n\n    @Test\n    @Timeout(60)\n    void publishesAndConsumesMessagesWithEveryCompressionCodec() throws Exception {\n        final String topic = \"persistent://public/default/metadata-\" + UUID.randomUUID();\n        final EnumSet<CompressionType> compressionTypes = EnumSet.allOf(CompressionType.class);\n        final BatchReceivePolicy batchPolicy = BatchReceivePolicy.builder()\n                .maxNumMessages(compressionTypes.size())\n                .timeout(10, TimeUnit.SECONDS)\n                .build();\n\n        try (Consumer<String> consumer = client.newConsumer(Schema.STRING)\n                .topic(topic)\n                .subscriptionName(\"metadata-subscription\")\n                .subscriptionInitialPosition(SubscriptionInitialPosition.Earliest)\n                .batchReceivePolicy(batchPolicy)\n                .subscribe()) {\n            for (CompressionType compressionType : compressionTypes) {\n                try (Producer<String> producer = client.newProducer(Schema.STRING)\n                        .topic(topic)\n                        .producerName(\"producer-\" + compressionType.name().toLowerCase())\n                        .compressionType(compressionType)\n                        .compressionMinMsgBodySize(0)\n                        .sendTimeout(30, TimeUnit.SECONDS)\n                        .create()) {\n                    producer.newMessage()\n                            .property(\"compression\", compressionType.name())\n                            .value(\"payload-\" + compressionType.name())\n                            .send();\n                }\n            }\n\n            final Messages<String> received = consumer.batchReceive();\n            final Set<String> values = new HashSet<>();\n            for (Message<String> message : received) {\n                values.add(message.getValue());\n                assertThat(message.getProperty(\"compression\")).isNotBlank();\n                consumer.acknowledge(message);\n            }\n\n            assertThat(values).containsExactlyInAnyOrderElementsOf(compressionTypes.stream()\n                    .map(type -> \"payload-\" + type.name())\n                    .toList());\n        }\n    }\n\n    @Test\n    @Timeout(60)\n    void queriesBrokerAdministrationEndpointWithJerseyClient() {\n        final Client httpClient = ClientBuilder.newBuilder()\n                .connectTimeout(10, TimeUnit.SECONDS)\n                .readTimeout(10, TimeUnit.SECONDS)\n                .build();\n        try {\n            try (Response response = httpClient.target(\"http://localhost:8080/admin/v2/clusters\")\n                    .request(MediaType.APPLICATION_JSON_TYPE)\n                    .get()) {\n                assertThat(response.getStatus()).isEqualTo(200);\n                assertThat(response.readEntity(String.class)).contains(\"standalone\");\n            }\n        } finally {\n            httpClient.close();\n        }\n    }\n\n    private PulsarClient waitForBroker() throws Exception {\n        final long deadline = System.nanoTime() + STARTUP_TIMEOUT.toNanos();\n        Exception lastFailure = null;\n        while (System.nanoTime() < deadline) {\n            if (!broker.isAlive()) {\n                throw new IllegalStateException(\"Pulsar broker process exited with code \" + broker.exitValue());\n            }\n\n            PulsarClient candidate = null;\n            try {\n                candidate = newClient();\n                candidate.getPartitionsForTopic(\"persistent://public/default/readiness\")\n                        .get(15, TimeUnit.SECONDS);\n                return candidate;\n            } catch (Exception e) {\n                lastFailure = e;\n                closeCandidate(candidate);\n                Thread.sleep(2000);\n            }\n        }\n        throw new IllegalStateException(\"Pulsar broker did not become ready within \" + STARTUP_TIMEOUT, lastFailure);\n    }\n\n    private static PulsarClient newClient() throws PulsarClientException {\n        return PulsarClient.builder()\n                .serviceUrl(SERVICE_URL)\n                .connectionTimeout(15, TimeUnit.SECONDS)\n                .lookupTimeout(15, TimeUnit.SECONDS)\n                .operationTimeout(30, TimeUnit.SECONDS)\n                .build();\n    }\n\n    private static void closeCandidate(PulsarClient candidate) throws IOException {\n        if (candidate != null) {\n            candidate.close();\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792341646138}, {"role": "toolResult", "toolCallId": "call_P4Tfz7DRTCrN95bUcD9Hfw5U|fc_05227da7d5a84e72016ad4f68dc16087d1b07e57f86097ea2c", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.List;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.ObjectMapper;\nimport org.junit.jupiter.api.Test;\n\npublic class ClassUtilTest {\n\n    @Test\n    void mapsBeansRecordsEnumsAndArraysThroughJackson() throws Exception {\n        final ObjectMapper mapper = new ObjectMapper();\n        final Envelope source = new Envelope();\n        source.setName(\"orders\");\n        source.setState(State.READY);\n        source.setEvents(List.of(new Event(\"created\", 3)));\n\n        final String json = mapper.writeValueAsString(source);\n        final Envelope restored = mapper.readValue(json, Envelope.class);\n        final Event record = mapper.readValue(\"{\\\"name\\\":\\\"stored\\\",\\\"count\\\":5}\", Event.class);\n        final State[] states = mapper.readValue(\"[\\\"READY\\\",\\\"DONE\\\"]\", State[].class);\n\n        assertThat(restored.getName()).isEqualTo(\"orders\");\n        assertThat(restored.getState()).isEqualTo(State.READY);\n        assertThat(restored.getEvents()).containsExactly(new Event(\"created\", 3));\n        assertThat(record).isEqualTo(new Event(\"stored\", 5));\n        assertThat(states).containsExactly(State.READY, State.DONE);\n    }\n\n    public enum State {\n        READY,\n        DONE\n    }\n\n    public record Event(String name, int count) {\n    }\n\n    public static final class Envelope {\n        private String name;\n        private State state;\n        private List<Event> events;\n\n        public Envelope() {\n        }\n\n        public String getName() {\n            return name;\n        }\n\n        public void setName(String name) {\n            this.name = name;\n        }\n\n        public State getState() {\n            return state;\n        }\n\n        public void setState(State state) {\n            this.state = state;\n        }\n\n        public List<Event> getEvents() {\n            return events;\n        }\n\n        public void setEvents(List<Event> events) {\n            this.events = events;\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792341646138}, {"role": "toolResult", "toolCallId": "call_6SB4dHCDAsxrwEaNBlViNnEL|fc_05227da7d5a84e72016ad4f68dc17087d1b8c7b11e527645a1", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.List;\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.Yaml;\nimport org.junit.jupiter.api.Test;\n\npublic class ConstructorInnerConstructScalarTest {\n\n    @Test\n    void constructsBeanPropertiesCollectionsEnumsAndStringValueObjects() {\n        final String document = \"\"\"\n                name: broker-a\n                state: ACTIVE\n                endpoint: pulsar://localhost:6650\n                ports: [6650, 6651]\n                \"\"\";\n\n        final Configuration configuration = new Yaml().loadAs(document, Configuration.class);\n        final String dumped = new Yaml().dump(configuration);\n\n        assertThat(configuration.getName()).isEqualTo(\"broker-a\");\n        assertThat(configuration.getState()).isEqualTo(State.ACTIVE);\n        assertThat(configuration.getEndpoint().getValue()).isEqualTo(\"pulsar://localhost:6650\");\n        assertThat(configuration.getPorts()).containsExactly(6650, 6651);\n        assertThat(dumped).contains(\"broker-a\", \"ACTIVE\", \"6650\");\n    }\n\n    public enum State {\n        ACTIVE,\n        INACTIVE\n    }\n\n    public static final class Endpoint {\n        private final String value;\n\n        public Endpoint(String value) {\n            this.value = value;\n        }\n\n        public String getValue() {\n            return value;\n        }\n    }\n\n    public static final class Configuration {\n        private String name;\n        private State state;\n        private Endpoint endpoint;\n        private List<Integer> ports;\n\n        public Configuration() {\n        }\n\n        public String getName() {\n            return name;\n        }\n\n        public void setName(String name) {\n            this.name = name;\n        }\n\n        public State getState() {\n            return state;\n        }\n\n        public void setState(State state) {\n            this.state = state;\n        }\n\n        public Endpoint getEndpoint() {\n            return endpoint;\n        }\n\n        public void setEndpoint(Endpoint endpoint) {\n            this.endpoint = endpoint;\n        }\n\n        public List<Integer> getPorts() {\n            return ports;\n        }\n\n        public void setPorts(List<Integer> ports) {\n            this.ports = ports;\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792341646139}, {"role": "toolResult", "toolCallId": "call_AaOoqQDAy51BOeQorEPaKOhD|fc_05227da7d5a84e72016ad4f68dc18487d197cab5aedc89b409", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage io_nats.jnats;\n\nimport io.nats.client.Connection;\nimport io.nats.client.Dispatcher;\nimport io.nats.client.Nats;\nimport org.junit.jupiter.api.AfterAll;\nimport org.junit.jupiter.api.BeforeAll;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.TestInstance;\n\nimport java.io.IOException;\nimport java.nio.charset.StandardCharsets;\nimport java.util.ArrayList;\nimport java.util.List;\nimport java.util.concurrent.Callable;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\n@TestInstance(TestInstance.Lifecycle.PER_CLASS)\nclass JnatsTest {\n\n    private Process process;\n\n    @BeforeAll\n    public void init() throws IOException {\n        System.out.println(\"Starting NATS ...\");\n        process = new ProcessBuilder(\"docker\", \"run\", \"--rm\", \"-p\", \"4222:4222\", \"nats:2.15.0\").inheritIO().start();\n\n        waitUntil(() -> {\n            openConnection().close();\n            return true;\n        }, 120, 1);\n\n        System.out.println(\"NATS started\");\n    }\n\n    @AfterAll\n    public void close() {\n        if (process != null && process.isAlive()) {\n            System.out.println(\"Shutting down NATS\");\n            process.destroy();\n        }\n    }\n\n    // not using Awaitility library because of `com.oracle.svm.core.jdk.UnsupportedFeatureError: ThreadMXBean methods` issue\n    // which happens if a condition is not fulfilled when a test is running in a native image\n    private void waitUntil(Callable<Boolean> conditionEvaluator, int timeoutSeconds, int sleepTimeSeconds) {\n        Exception lastException = null;\n\n        long end  = System.currentTimeMillis() + timeoutSeconds * 1000L;\n        while (System.currentTimeMillis() < end) {\n            try {\n                Thread.sleep(sleepTimeSeconds * 1000L);\n            } catch (InterruptedException e) {\n                // continue\n            }\n            try {\n                if (conditionEvaluator.call()) {\n                    return;\n                }\n            } catch (Exception e) {\n                lastException = e;\n            }\n        }\n        String errorMessage = \"Condition was not fulfilled within \" + timeoutSeconds + \" seconds\";\n        throw lastException == null ? new IllegalStateException(errorMessage) : new IllegalStateException(errorMessage, lastException);\n    }\n\n    private Connection openConnection() throws Exception {\n        return Nats.connect();\n    }\n\n    @Test\n    void test() throws Exception {\n        try (Connection connection = openConnection()) {\n            final List<String> receivedMessages = new ArrayList<>();\n            Dispatcher dispatcher = connection.createDispatcher((msg) -> receivedMessages.add(new String(msg.getData(), StandardCharsets.UTF_8)));\n            dispatcher.subscribe(\"test-subject\");\n\n            connection.publish(\"test-subject\", \"test-message\".getBytes(StandardCharsets.UTF_8));\n\n            waitUntil(() -> !receivedMessages.isEmpty(), 10, 1);\n\n            assertThat(receivedMessages)\n                    .hasSize(1)\n                    .containsExactly(\"test-message\");\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792341646139}, {"role": "toolResult", "toolCallId": "call_ybXpKYou3kI5vIhlXn405gTC|fc_05227da7d5a84e72016ad4f68dc19487d1999252fcbef7e73a", "toolName": "bash", "content": [{"type": "text", "text": "   48 tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/AnnotationUtilsTest.java\n   30 tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ArrayUtilsTest.java\n   36 tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/AuthenticationUtilTest.java\n   28 tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/BouncyCastleUtilAnonymous1Test.java\n   46 tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/BrokerEntryMetadataUtilsTest.java\n   77 tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ClassUtilTest.java\n   94 tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ConstructorInnerConstructScalarTest.java\n   39 tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ConstructorUtilsTest.java\n   26 tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/DefaultChannelIdTest.java\n   46 tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/EventListenerSupportTest.java\n   66 tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/FieldParserTest.java\n   41 tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/o