hema<Event> json = Schema.JSON(Event.class);\n        final Event jsonValue = json.decode(json.encode(new Event(\"json\", 11)));\n\n        assertThat(avro.getSchemaInfo().getSchema()).isNotEmpty();\n        assertThat(avroValue.getName()).isEqualTo(\"avro\");\n        assertThat(avroValue.getSequence()).isEqualTo(7);\n        assertThat(json.getSchemaInfo().getSchema()).isNotEmpty();\n        assertThat(jsonValue).isEqualTo(new Event(\"json\", 11));\n    }\n\n    public static final class Payload {\n        private String name;\n        private int sequence;\n\n        public Payload() {\n        }\n\n        public Payload(String name, int sequence) {\n            this.name = name;\n            this.sequence = sequence;\n        }\n\n        public String getName() {\n            return name;\n        }\n\n        public void setName(String name) {\n            this.name = name;\n        }\n\n        public int getSequence() {\n            return sequence;\n        }\n\n        public void setSequence(int sequence) {\n            this.sequence = sequence;\n        }\n    }\n\n    public record Event(String name, int sequence) {\n    }\n}\n"}}, {"type": "toolCall", "id": "call_1jbTrGahx0Rae1nFueXiXwFw|fc_0c4b4cfdacc159d6016ad4e9f8de7487d1ab19a7a65d239f0d", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/AuthenticationUtilTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.Map;\nimport org.apache.pulsar.client.api.Authentication;\nimport org.apache.pulsar.client.impl.AuthenticationUtil;\nimport org.apache.pulsar.client.impl.auth.AuthenticationToken;\nimport org.junit.jupiter.api.Test;\n\npublic class AuthenticationUtilTest {\n\n    @Test\n    void createsConfiguredAuthenticationPluginsFromBothParameterForms() throws Exception {\n        try (Authentication encoded = AuthenticationUtil.create(\n                        AuthenticationToken.class.getName(), \"token:encoded-secret\");\n                Authentication mapped = AuthenticationUtil.create(\n                        AuthenticationToken.class.getName(), Map.of(\"token\", \"mapped-secret\"))) {\n            encoded.start();\n            mapped.start();\n\n            assertThat(encoded.getAuthMethodName()).isEqualTo(\"token\");\n            assertThat(encoded.getAuthData().getCommandData()).isEqualTo(\"encoded-secret\");\n            assertThat(mapped.getAuthMethodName()).isEqualTo(\"token\");\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_ViYL9V4aGfH6lkkSm3MCNovt|fc_0c4b4cfdacc159d6016ad4e9f8de7c87d1839206fd1bb60762", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ReflectionsTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.List;\nimport org.apache.pulsar.common.compression.CompressionCodec;\nimport org.apache.pulsar.common.compression.CompressionCodecNone;\nimport org.apache.pulsar.common.schema.LongSchemaVersion;\nimport org.apache.pulsar.common.util.Reflections;\nimport org.junit.jupiter.api.Test;\n\npublic class ReflectionsTest {\n\n    @Test\n    void createsChecksAndInspectsPulsarTypesByName() throws Exception {\n        final ClassLoader loader = Reflections.class.getClassLoader();\n        final String codecName = CompressionCodecNone.class.getName();\n\n        final CompressionCodec codec = Reflections.createInstance(codecName, CompressionCodec.class, loader);\n        final LongSchemaVersion version = (LongSchemaVersion) Reflections.createInstance(\n                LongSchemaVersion.class.getName(), loader, new Object[] {23L}, new Class<?>[] {long.class});\n        final List<String> fields = Reflections.getAllFields(LongSchemaVersion.class).stream()\n                .map(field -> field.getName())\n                .toList();\n\n        assertThat(codec).isInstanceOf(CompressionCodecNone.class);\n        assertThat(version).isEqualTo(new LongSchemaVersion(23L));\n        assertThat(Reflections.classExists(codecName)).isTrue();\n        assertThat(Reflections.classImplementsIface(codecName, CompressionCodec.class)).isTrue();\n        assertThat(Reflections.loadClass(\"[[L\" + codecName + \";\", loader))\n                .isEqualTo(CompressionCodecNone[][].class);\n        assertThat(fields).contains(\"version\");\n    }\n}\n"}}, {"type": "toolCall", "id": "call_ilWqvdEYFs9hlpEzdeU3vUrt|fc_0c4b4cfdacc159d6016ad4e9f8de8487d1938b43ff72ca0ee0", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/OffloadPoliciesImplTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.Properties;\nimport org.apache.pulsar.common.policies.data.OffloadPoliciesImpl;\nimport org.junit.jupiter.api.Test;\n\npublic class OffloadPoliciesImplTest {\n\n    @Test\n    void createsSerializesAndMergesOffloadConfiguration() {\n        final Properties broker = new Properties();\n        broker.setProperty(\"managedLedgerOffloadDriver\", \"aws-s3\");\n        broker.setProperty(\"managedLedgerOffloadBucket\", \"archive-bucket\");\n        broker.setProperty(\"managedLedgerOffloadRegion\", \"eu-central-1\");\n        broker.setProperty(OffloadPoliciesImpl.OFFLOAD_THRESHOLD_NAME_IN_CONF_FILE, \"4096\");\n\n        final OffloadPoliciesImpl configured = OffloadPoliciesImpl.create(broker);\n        final OffloadPoliciesImpl topic = OffloadPoliciesImpl.builder()\n                .managedLedgerOffloadDriver(\"aws-s3\")\n                .managedLedgerOffloadRegion(\"topic-region\")\n                .build();\n        final OffloadPoliciesImpl namespace = OffloadPoliciesImpl.builder()\n                .managedLedgerOffloadBucket(\"namespace-bucket\")\n                .build();\n        final OffloadPoliciesImpl merged = OffloadPoliciesImpl.mergeConfiguration(topic, namespace, broker);\n\n        assertThat(configured.driverSupported()).isTrue();\n        assertThat(configured.toProperties())\n                .containsEntry(\"managedLedgerOffloadBucket\", \"archive-bucket\")\n                .containsEntry(\"managedLedgerOffloadRegion\", \"eu-central-1\");\n        assertThat(merged.getManagedLedgerOffloadRegion()).isEqualTo(\"topic-region\");\n        assertThat(merged.getManagedLedgerOffloadBucket()).isEqualTo(\"namespace-bucket\");\n        assertThat(merged.getManagedLedgerOffloadThresholdInBytes()).isEqualTo(4096L);\n    }\n}\n"}}, {"type": "toolCall", "id": "call_hHDx4drgEipv20qnhTJ9cvPa|fc_0c4b4cfdacc159d6016ad4e9f8de8c87d1ac23028e3b4e4f57", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/FieldParserTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.ArrayList;\nimport java.util.LinkedHashMap;\nimport java.util.LinkedHashSet;\nimport java.util.List;\nimport java.util.Map;\nimport java.util.Optional;\nimport java.util.Set;\nimport org.apache.pulsar.common.util.FieldParser;\nimport org.junit.jupiter.api.Test;\n\npublic class FieldParserTest {\n\n    @Test\n    void updatesScalarsAndGenericContainersFromConfigurationText() {\n        final ParserTarget target = new ParserTarget();\n        final Map<String, String> values = new LinkedHashMap<>();\n        values.put(\"name\", \"primary\");\n        values.put(\"port\", \"6650\");\n        values.put(\"enabled\", \"true\");\n        values.put(\"clusters\", \"east, west\");\n        values.put(\"roles\", \"reader, writer, reader\");\n        values.put(\"weights\", \"east=4, west=6\");\n        values.put(\"fallbackPort\", \"6651\");\n\n        FieldParser.update(values, target);\n\n        assertThat(target.name).isEqualTo(\"primary\");\n        assertThat(target.port).isEqualTo(6650);\n        assertThat(target.enabled).isTrue();\n        assertThat(target.clusters).containsExactly(\"east\", \"west\");\n        assertThat(target.roles).containsExactly(\"reader\", \"writer\");\n        assertThat(target.weights).containsEntry(\"east\", 4).containsEntry(\"west\", 6);\n        assertThat(target.fallbackPort).contains(6651);\n    }\n\n    @Test\n    void clearsOptionalCollectionAndNumberValuesForBlankConfiguration() {\n        final ParserTarget target = new ParserTarget();\n\n        FieldParser.update(Map.of(\"port\", \"\", \"clusters\", \" \", \"fallbackPort\", \"\"), target);\n\n        assertThat(target.port).isNull();\n        assertThat(target.clusters).isEmpty();\n        assertThat(target.fallbackPort).isEmpty();\n    }\n\n    public static final class ParserTarget {\n        private String name = \"unset\";\n        private Integer port = 1;\n        private Boolean enabled = false;\n        private List<String> clusters = new ArrayList<>(List.of(\