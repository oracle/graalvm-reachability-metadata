        final Batch restored = SerializationUtils.clone(source);\n\n        assertThat(restored).isNotSameAs(source);\n        assertThat(restored.topic).isEqualTo(\"orders\");\n        assertThat(restored.messages).containsExactly(\"one\", \"two\");\n    }\n\n    public static final class Batch implements Serializable {\n        private static final long serialVersionUID = 1L;\n        private final String topic;\n        private final List<String> messages;\n\n        public Batch(String topic, List<String> messages) {\n            this.topic = topic;\n            this.messages = messages;\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792344781132}, {"role": "toolResult", "toolCallId": "call_l7nFEk1Mk83p4AEmQWUGOft8|fc_0936964dff2d7b74016ad502ccd9a887d188aa7d8b45595000", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.List;\nimport org.apache.pulsar.common.compression.CompressionCodec;\nimport org.apache.pulsar.common.compression.CompressionCodecNone;\nimport org.apache.pulsar.common.schema.LongSchemaVersion;\nimport org.apache.pulsar.common.util.Reflections;\nimport org.junit.jupiter.api.Test;\n\npublic class ReflectionsTest {\n\n    @Test\n    void createsChecksAndInspectsPulsarTypesByName() throws Exception {\n        final ClassLoader loader = Reflections.class.getClassLoader();\n        final String codecName = CompressionCodecNone.class.getName();\n\n        final CompressionCodec codec = Reflections.createInstance(codecName, CompressionCodec.class, loader);\n        final LongSchemaVersion version = (LongSchemaVersion) Reflections.createInstance(\n                LongSchemaVersion.class.getName(), loader, new Object[] {23L}, new Class<?>[] {long.class});\n        final List<String> fields = Reflections.getAllFields(LongSchemaVersion.class).stream()\n                .map(field -> field.getName())\n                .toList();\n\n        assertThat(codec).isInstanceOf(CompressionCodecNone.class);\n        assertThat(version).isEqualTo(new LongSchemaVersion(23L));\n        assertThat(Reflections.classExists(codecName)).isTrue();\n        assertThat(Reflections.classImplementsIface(codecName, CompressionCodec.class)).isTrue();\n        assertThat(Reflections.loadClass(\"[[L\" + codecName + \";\", loader))\n                .isEqualTo(CompressionCodecNone[][].class);\n        assertThat(fields).contains(\"version\");\n    }\n}\n"}], "isError": false, "timestamp": 1792344781132}, {"role": "toolResult", "toolCallId": "call_tbQTkixxKVAWSMIIAK89IjzN|fc_0936964dff2d7b74016ad502ccd9b087d1a87468c60d31fdae", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.Map;\nimport org.apache.pulsar.common.stats.JvmDefaultGCMetricsLogger;\nimport org.apache.pulsar.common.stats.Metrics;\nimport org.junit.jupiter.api.Test;\n\npublic class JvmDefaultGCMetricsLoggerTest {\n\n    @Test\n    void refreshesAndExportsDefaultCollectorMetrics() {\n        final JvmDefaultGCMetricsLogger logger = new JvmDefaultGCMetricsLogger();\n        logger.refresh();\n        logger.refresh();\n\n        final Metrics metrics = Metrics.create(Map.of(\"component\", \"client\"));\n        logger.logMetrics(metrics);\n\n        assertThat(metrics.getDimensions()).containsEntry(\"component\", \"client\");\n        assertThat(metrics.getMetrics()).containsKeys(\"jvm_full_gc_pause\", \"jvm_full_gc_count\");\n        assertThat(metrics.getMetrics().get(\"jvm_full_gc_pause\")).isInstanceOf(Long.class);\n    }\n}\n"}], "isError": false, "timestamp": 1792344781133}, {"role": "toolResult", "toolCallId": "call_xAGqfGmZg1MXVARvu6Fxwws9|fc_0936964dff2d7b74016ad502ccd9b887d1a26f0d69f4a4d050", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.ArrayList;\nimport java.util.List;\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.LoaderOptions;\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.TypeDescription;\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.Yaml;\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.constructor.Constructor;\nimport org.junit.jupiter.api.Test;\n\npublic class PropertySubstituteTest {\n\n    @Test\n    void populatesAndReadsACollectionThroughSubstitutedAccessors() {\n        final TypeDescription description = new TypeDescription(Labels.class);\n        description.substituteProperty(\"labels\", List.class, \"getLabels\", \"addLabel\", String.class);\n        final Constructor constructor = new Constructor(description, new LoaderOptions());\n\n        final Labels labels = new Yaml(constructor).loadAs(\"labels: [primary, replicated]\", Labels.class);\n\n        assertThat(labels.getLabels()).containsExactly(\"primary\", \"replicated\");\n        assertThat(description.getProperty(\"labels\").get(labels)).isEqualTo(labels.getLabels());\n    }\n\n    public static final class Labels {\n        private final List<String> labels = new ArrayList<>();\n\n        public void addLabel(String label) {\n            labels.add(label);\n        }\n\n        public List<String> getLabels() {\n            return labels;\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792344781133}, {"role": "toolResult", "toolCallId": "call_zOFiziz1EeyJNrkYg0L19J6D|fc_0936964dff2d7b74016ad502ccdaa887d1907b208d922d9c23", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage io_nats.jnats;\n\nimport io.nats.client.Connection;\nimport io.nats.client.Dispatcher;\nimport io.nats.client.Nats;\nimport org.junit.jupiter.api.AfterAll;\nimport org.junit.jupiter.api.BeforeAll;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.TestInstance;\n\nimport java.io.IOException;\nimport java.nio.charset.StandardCharsets;\nimport java.util.ArrayList;\nimport java.util.List;\nimport java.util.concurrent.Callable;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\n@TestInstance(TestInstance.Lifecycle.PER_CLASS)\nclass JnatsTest {\n\n    private Process process;\n\n    @BeforeAll\n    public void init() throws IOException {\n        System.out.println(\"Starting NATS ...\");\n        process = new ProcessBuilder(\"docker\", \"run\", \"--rm\", \"-p\", \"4222:4222\", \"nats:2.15.0\").inheritIO().start();\n\n        waitUntil(() -> {\n            openConnection().close();\n            return true;\n        }, 120, 1);\n\n        System.out.println(\"NATS started\");\n    }\n\n    @AfterAll\n    public void close() {\n        if (process != null && process.isAlive()) {\n            System.out.println(\"Shutting down NATS\");\n            process.destroy();\n        }\n    }\n\n    // not using Awaitility library because of `com.oracle.svm.core.jdk.UnsupportedFeatureError: ThreadMXBean methods` issue\n    // which happens if a condition is not fulfilled when a test is running in a native image\n    private void waitUntil(Callable<Boolean> conditionEvaluator, int timeoutSeconds, int sleepTimeSeconds) {\n        Exception lastException = null;\n\n        long end  = System.currentTimeMillis() + timeoutSeconds * 1000L;\n        while (System.currentTimeMillis() < end) {\n            try {\n                Thread.sleep(sleepTimeSeconds * 1000L);\n            } catch (InterruptedException e) {\n                // continue\n            }\n            try {\n                if (conditionEvaluator.call()) {\n                    return;\n                }\n            } catch (Exception e) {\n                lastException = e;\n            }\n        }\n        String errorMessage = \"Condition was not fulfilled within \" + timeoutSeconds + \" seconds\";\n        throw lastException == null ? new IllegalStateException(errorMessage) : new IllegalStateException(errorMessage, lastException);\n    }\n\n    private Connection openConnection() throws Exception {\n        return Nats.connect();\n    }\n\n    @Test\n    void test() throws Exception {\n        try (Connection connection = openConnection()) {\n            final List<String> receivedMessages = new ArrayList<>();\n            Dispatcher dispatcher = connection.createDispatcher((msg) -> receivedMessages.add(new String(msg.getData(), StandardCharsets.UTF_8)));\n            dispatcher.subscribe(\"test-subject\");\n\n            connection.publish(\"test-subject\", \"test-message\".getBytes(StandardCharsets.UTF_8));\n\n            waitUntil(() -> !receivedMessages.isEmpty(), 10, 1);\n\n            assertThat(receivedMessages)\n                    .hasSize(1)\n                    .containsExactly(\"test-message\");\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792344781133}]}
