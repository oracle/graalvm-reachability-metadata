 java.util.Map;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.JavaType;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.ObjectMapper;\nimport org.junit.jupiter.api.Test;\n\npublic class StdKeyDeserializerInnerStringCtorKeyDeserializerTest {\n\n    @Test\n    void createsMapKeysWithAStringConstructor() throws Exception {\n        final ObjectMapper mapper = new ObjectMapper();\n        final JavaType type = mapper.getTypeFactory().constructMapType(Map.class, TopicKey.class, Integer.class);\n        final Map<TopicKey, Integer> values = mapper.readValue(\"{\\\"orders\\\":3}\", type);\n\n        assertThat(values).containsEntry(new TopicKey(\"orders\"), 3);\n    }\n\n    public static final class TopicKey {\n        private final String value;\n\n        public TopicKey(String value) {\n            this.value = value;\n        }\n\n        @Override\n        public boolean equals(Object other) {\n            return other instanceof TopicKey && value.equals(((TopicKey) other).value);\n        }\n\n        @Override\n        public int hashCode() {\n            return value.hashCode();\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_sPWnpKT81DcD5EbRywKYXMfu|fc_05227da7d5a84e72016ad4f8965e0487d1a09ac832de1f3e64", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/StdKeyDeserializerInnerStringFactoryKeyDeserializerTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.Map;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.JavaType;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.ObjectMapper;\nimport org.junit.jupiter.api.Test;\n\npublic class StdKeyDeserializerInnerStringFactoryKeyDeserializerTest {\n\n    @Test\n    void createsMapKeysWithAStringFactory() throws Exception {\n        final ObjectMapper mapper = new ObjectMapper();\n        final JavaType type = mapper.getTypeFactory().constructMapType(Map.class, SubscriptionKey.class, Boolean.class);\n        final Map<SubscriptionKey, Boolean> values = mapper.readValue(\"{\\\"replication\\\":true}\", type);\n\n        assertThat(values).containsEntry(SubscriptionKey.valueOf(\"replication\"), true);\n    }\n\n    public static final class SubscriptionKey {\n        private final String value;\n\n        private SubscriptionKey(String value) {\n            this.value = value;\n        }\n\n        public static SubscriptionKey valueOf(String value) {\n            return new SubscriptionKey(value);\n        }\n\n        @Override\n        public boolean equals(Object other) {\n            return other instanceof SubscriptionKey && value.equals(((SubscriptionKey) other).value);\n        }\n\n        @Override\n        public int hashCode() {\n            return value.hashCode();\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_6Of6B1FI6ZaVa3r87t4fNGbb|fc_05227da7d5a84e72016ad4f8965e1087d186696f9a534b3afb", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/BuilderBasedDeserializerTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.ObjectMapper;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.annotation.JsonDeserialize;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.annotation.JsonPOJOBuilder;\nimport org.junit.jupiter.api.Test;\n\npublic class BuilderBasedDeserializerTest {\n\n    @Test\n    void finishesObjectDeserializationThroughABuilder() throws Exception {\n        final ClientSettings settings = new ObjectMapper().readValue(\n                \"{\\\"serviceUrl\\\":\\\"pulsar://broker:6650\\\",\\\"connections\\\":4}\", ClientSettings.class);\n\n        assertThat(settings.serviceUrl).isEqualTo(\"pulsar://broker:6650\");\n        assertThat(settings.connections).isEqualTo(4);\n    }\n\n    @JsonDeserialize(builder = ClientSettings.Builder.class)\n    public static final class ClientSettings {\n        private final String serviceUrl;\n        private final int connections;\n\n        private ClientSettings(String serviceUrl, int connections) {\n            this.serviceUrl = serviceUrl;\n            this.connections = connections;\n        }\n\n        @JsonPOJOBuilder(withPrefix = \"\")\n        public static final class Builder {\n            private String serviceUrl;\n            private int connections;\n\n            public Builder serviceUrl(String serviceUrl) {\n                this.serviceUrl = serviceUrl;\n                return this;\n            }\n\n            public Builder connections(int connections) {\n                this.connections = connections;\n                return this;\n            }\n\n            public ClientSettings build() {\n                return new ClientSettings(serviceUrl, connections);\n            }\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_6xAHJpOZnyhBrjBf4KcaqF0J|fc_05227da7d5a84e72016ad4f8965e1c87d1816d0858f6f7f18f", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/BeanAsArrayBuilderDeserializerTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport com.fasterxml.jackson.annotation.JsonFormat;\nimport com.fasterxml.jackson.annotation.JsonPropertyOrder;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.ObjectMapper;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.annotation.JsonDeserialize;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.annotation.JsonPOJOBuilder;\nimport org.junit.jupiter.api.Test;\n\npublic class BeanAsArrayBuilderDeserializerTest {\n\n    @Test\n    void finishesArrayShapedDeserializationThroughABuilder() throws Exception {\n        final RoutingRule rule = new ObjectMapper().readValue(\"[\\\"orders\\\",6]\", RoutingRule.class);\n\n        assertThat(rule.topic).isEqualTo(\"orders\");\n        assertThat(rule.partitions).isEqualTo(6);\n    }\n\n    @JsonFormat(shape = JsonFormat.Shape.ARRAY)\n    @JsonPropertyOrder({\"topic\", \"partitions\"})\n    @JsonDeserialize(builder = RoutingRule.Builder.class)\n    public static final class RoutingRule {\n        private final String topic;\n        private final int partitions;\n\n        private RoutingRule(String topic, int partitions) {\n            this.topic = topic;\n            this.partitions = partitions;\n        }\n\n        @JsonPOJOBuilder(withPrefix = \"\")\n        public static final class Builder {\n            private String topic;\n            private int partitions;\n\n            public Builder topic(String topic) {\n                this.topic = topic;\n                return this;\n            }\n\n            public Builder partitions(int partitions) {\n                this.partitions = partitions;\n                return this;\n            }\n\n            public RoutingRule build() {\n                return new RoutingRule(topic, partitions);\n            }\n        }\n    }\n}\n"}}, {"type": "toolCall",