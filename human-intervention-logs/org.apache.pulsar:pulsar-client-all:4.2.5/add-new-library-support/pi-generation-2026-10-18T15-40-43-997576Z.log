tions.assertThatThrownBy;\n\nimport java.io.IOException;\nimport org.apache.pulsar.shade.com.google.common.util.concurrent.Futures;\nimport org.junit.jupiter.api.Test;\n\npublic class FuturesGetCheckedTest {\n\n    @Test\n    void wrapsAFailedFutureInTheRequestedCheckedException() {\n        final IOException failure = new IOException(\"storage unavailable\");\n\n        assertThatThrownBy(() -> Futures.getChecked(Futures.immediateFailedFuture(failure), ClientFailure.class))\n                .isInstanceOf(ClientFailure.class)\n                .hasCause(failure);\n    }\n\n    public static final class ClientFailure extends Exception {\n        public ClientFailure(String message, Throwable cause) {\n            super(message, cause);\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_KbGwmk33BrYPQLSvi0o8gXay|fc_05227da7d5a84e72016ad4f7be950087d1a15414d4f796236a", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/SubscriberTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.ArrayList;\nimport java.util.List;\nimport org.apache.pulsar.shade.com.google.common.eventbus.EventBus;\nimport org.apache.pulsar.shade.com.google.common.eventbus.Subscribe;\nimport org.junit.jupiter.api.Test;\n\npublic class SubscriberTest {\n\n    @Test\n    void invokesAnAnnotatedSubscriber() {\n        final EventBus bus = new EventBus(\"pulsar-events\");\n        final MessageListener listener = new MessageListener();\n        bus.register(listener);\n\n        bus.post(\"created\");\n\n        assertThat(listener.events).containsExactly(\"created\");\n    }\n\n    public static final class MessageListener {\n        private final List<String> events = new ArrayList<>();\n\n        @Subscribe\n        public void onMessage(String event) {\n            events.add(event);\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_LMHrNVTpPNJZfaFdigCSC1wX|fc_05227da7d5a84e72016ad4f7be950c87d183e2ff2852258d09", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/SubscriberRegistryTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.concurrent.atomic.AtomicInteger;\nimport org.apache.pulsar.shade.com.google.common.eventbus.EventBus;\nimport org.apache.pulsar.shade.com.google.common.eventbus.Subscribe;\nimport org.junit.jupiter.api.Test;\n\npublic class SubscriberRegistryTest {\n\n    @Test\n    void discoversRegistersAndUnregistersSubscriberMethods() {\n        final EventBus bus = new EventBus();\n        final Counter counter = new Counter();\n        bus.register(counter);\n        bus.post(4);\n        bus.unregister(counter);\n        bus.post(9);\n\n        assertThat(counter.total.get()).isEqualTo(4);\n    }\n\n    public static final class Counter {\n        private final AtomicInteger total = new AtomicInteger();\n\n        @Subscribe\n        public void add(Integer value) {\n            total.addAndGet(value);\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_J1LwutCGAjrHgl5Uz0iKiDFt|fc_05227da7d5a84e72016ad4f7be951487d18680a7bbe55f0984", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/FileBackedOutputStreamTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.nio.charset.StandardCharsets;\nimport org.apache.pulsar.shade.com.google.common.io.FileBackedOutputStream;\nimport org.junit.jupiter.api.Test;\n\npublic class FileBackedOutputStreamTest {\n\n    @Test\n    void spillsToDiskAndResetsTheReadableView() throws Exception {\n        final FileBackedOutputStream output = new FileBackedOutputStream(4, true);\n        try {\n            output.write(\"pulsar-client\".getBytes(StandardCharsets.UTF_8));\n            output.close();\n            assertThat(output.asByteSource().read()).asString(StandardCharsets.UTF_8).isEqualTo(\"pulsar-client\");\n\n            output.reset();\n            assertThat(output.asByteSource().isEmpty()).isTrue();\n        } finally {\n            output.reset();\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_xDTXdK7YS7EXsv5gfsjgvJkv|fc_05227da7d5a84e72016ad4f7be952087d183f594674f85e32e", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ArrayTableTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.List;\nimport org.apache.pulsar.shade.com.google.common.collect.ArrayTable;\nimport org.junit.jupiter.api.Test;\n\npublic class ArrayTableTest {\n\n    @Test\n    void exportsValuesAsATypedMatrix() {\n        final ArrayTable<String, String, String> table =\n                ArrayTable.create(List.of(\