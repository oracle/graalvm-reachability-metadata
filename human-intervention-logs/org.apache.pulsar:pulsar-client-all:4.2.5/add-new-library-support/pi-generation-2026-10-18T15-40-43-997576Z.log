chTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.yahoo.sketches.sampling.ReservoirItemsSketch;\nimport org.junit.jupiter.api.Test;\n\npublic class ReservoirItemsSketchTest {\n\n    @Test\n    void returnsTypedSamplesFromAReservoir() {\n        final ReservoirItemsSketch<String> sketch = ReservoirItemsSketch.getInstance(8);\n        sketch.update(\"one\");\n        sketch.update(\"two\");\n        sketch.update(\"three\");\n\n        assertThat(sketch.getSamples(String.class)).containsExactlyInAnyOrder(\"one\", \"two\", \"three\");\n        assertThat(sketch.getSamples()).containsExactlyInAnyOrder(\"one\", \"two\", \"three\");\n    }\n}\n"}}, {"type": "toolCall", "id": "call_ENYPNId0pvsva9j86qxmYKBx|fc_05227da7d5a84e72016ad4f8ec323087d188c874e41883961c", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/FrequenciesItemsSketchTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.yahoo.sketches.frequencies.ErrorType;\nimport org.apache.pulsar.shade.com.yahoo.sketches.frequencies.ItemsSketch;\nimport org.junit.jupiter.api.Test;\n\npublic class FrequenciesItemsSketchTest {\n\n    @Test\n    void sortsFrequentItemsIntoATypedResultArray() {\n        final ItemsSketch<String> sketch = new ItemsSketch<>(16);\n        sketch.update(\"orders\", 8