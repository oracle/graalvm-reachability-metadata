[tool-exec] start id=call_SkwUKI8oMYEZ6nr2R8WeFbZ6|fc_0936964dff2d7b74016ad503c7f25887d18cbe74005989cbf1 name=write args={"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/EnumBiMapTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.google.common.collect.EnumBiMap;\nimport org.apache.pulsar.shade.org.apache.commons.lang3.SerializationUtils;\nimport org.junit.jupiter.api.Test;\n\npublic class EnumBiMapTest {\n\n    @Test\n    void preservesEnumTypesAndBidirectionalMappings() {\n        final EnumBiMap<State, Result> source = EnumBiMap.create(State.class, Result.class);\n        source.put(State.PENDING, Result.ACCEPTED);\n        source.put(State.COMPLETE, Result.STORED);\n\n        final EnumBiMap<State, Result> restored = SerializationUtils.clone(source);\n\n        assertThat(restored.keyType()).isEqualTo(State.class);\n        assertThat(restored.valueType()).isEqualTo(Result.class);\n        assertThat(restored.inverse().get(Result.STORED)).isEqualTo(State.COMPLETE);\n    }\n\n    private enum State {\n        PENDING,\n        COMPLETE\n    }\n\n    private enum Result {\n        ACCEPTED,\n        STORED\n    }\n}\n"}
[tool-exec] start id=call_Z7JGiH4nUaOAh4zPlFoERHRv|fc_0936964dff2d7b74016ad503c7f26087d1a0adef92e0a98081 name=write args={"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/EnumHashBiMapTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.google.common.collect.EnumHashBiMap;\nimport org.apache.pulsar.shade.org.apache.commons.lang3.SerializationUtils;\nimport org.junit.jupiter.api.Test;\n\npublic class EnumHashBiMapTest {\n\n    @Test\n    void preservesEnumKeyTypeAndInverseLookup() {\n        final EnumHashBiMap<Priority, String> source = EnumHashBiMap.create(Priority.class);\n        source.put(Priority.NORMAL, \"orders\");\n        source.put(Priority.HIGH, \"alerts\");\n\n        final EnumHashBiMap<Priority, String> restored = SerializationUtils.clone(source);\n\n        assertThat(restored.keyType()).isEqualTo(Priority.class);\n        assertThat(restored.inverse().get(\"alerts\")).isEqualTo(Priority.HIGH);\n    }\n\n    private enum Priority {\n        NORMAL,\n        HIGH\n    }\n}\n"}
[tool-exec] start id=call_dKrVS4fAlqUthBDVzjUXlf2i|fc_0936964dff2d7b74016ad503c7f26887d18b9147833c3774a8 name=write args={"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/EnumMultisetTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.google.common.collect.EnumMultiset;\nimport org.apache.pulsar.shade.org.apache.commons.lang3.SerializationUtils;\nimport org.junit.jupiter.api.Test;\n\npublic class EnumMultisetTest {\n\n    @Test\n    void preservesCountsForEachDeliveryState() {\n        final EnumMultiset<DeliveryState> source = EnumMultiset.create(DeliveryState.class);\n        source.add(DeliveryState.RECEIVED, 5);\n        source.add(DeliveryState.ACKNOWLEDGED, 3);\n\n        final EnumMultiset<DeliveryState> restored = SerializationUtils.clone(source);\n\n        assertThat(restored.count(DeliveryState.RECEIVED)).isEqualTo(5);\n        assertThat(restored.count(DeliveryState.ACKNOWLEDGED)).isEqualTo(3);\n    }\n\n    private enum DeliveryState {\n        RECEIVED,\n        ACKNOWLEDGED\n    }\n}\n"}
[tool-exec] start id=call_xHaP3ZcrzBZ3ZzYS4nEZPZ5t|fc_0936964dff2d7b74016ad503c7f27087d1bd11d55a32a5f9b7 name=write args={"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ImmutableListMultimapTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.google.common.collect.ImmutableListMultimap;\nimport org.apache.pulsar.shade.org.apache.commons.lang3.SerializationUtils;\nimport org.junit.jupiter.api.Test;\n\npublic class ImmutableListMultimapTest {\n\n    @Test\n    void preservesImmutableListsForEveryKey() {\n        final ImmutableListMultimap<String, String> source = ImmutableListMultimap.<String, String>builder()\n                .put(\"orders\", \"created\")\n                .put(\"orders\", \"stored\")\n                .put(\"audit\", \"recorded\")\n                .build();\n\n        final ImmutableListMultimap<String, String> restored = SerializationUtils.clone(source);\n\n        assertThat(restored).isEqualTo(source);\n        assertThat(restored.get(\"orders\")).containsExactly(\"created\", \"stored\");\n    }\n}\n"}
