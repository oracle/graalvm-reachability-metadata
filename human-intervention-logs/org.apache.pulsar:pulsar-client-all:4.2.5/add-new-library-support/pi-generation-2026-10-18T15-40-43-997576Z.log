"/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.google.common.collect.ArrayListMultimap;\nimport org.apache.pulsar.shade.com.google.common.collect.HashBiMap;\nimport org.apache.pulsar.shade.com.google.common.collect.HashMultiset;\nimport org.apache.pulsar.shade.org.apache.commons.lang3.SerializationUtils;\nimport org.junit.jupiter.api.Test;\n\npublic class GoogleCommonCollectSerializationTest {\n\n    @Test\n    void preservesMapMultimapAndMultisetEntries() {\n        final HashBiMap<String, Integer> map = HashBiMap.create();\n        map.put(\"one\", 1);\n        map.put(\"two\", 2);\n        final ArrayListMultimap<String, String> multimap = ArrayListMultimap.create();\n        multimap.put(\"topic\", \"first\");\n        multimap.put(\"topic\", \"second\");\n        final HashMultiset<String> multiset = HashMultiset.create();\n        multiset.add(\"message\", 3);\n\n        final HashBiMap<String, Integer> restoredMap = SerializationUtils.clone(map);\n        final ArrayListMultimap<String, String> restoredMultimap = SerializationUtils.clone(multimap);\n        final HashMultiset<String> restoredMultiset = SerializationUtils.clone(multiset);\n\n        assertThat(restoredMap).containsExactlyInAnyOrderEntriesOf(map);\n        assertThat(restoredMultimap.get(\"topic\")).containsExactly(\"first\", \"second\");\n        assertThat(restoredMultiset.count(\"message\")).isEqualTo(3);\n    }\n}\n"}}, {"type": "toolCall", "id": "call_ap4mNUxVdAj9fMbkT1dbcTqA|fc_0936964dff2d7b74016ad503c7f22c87d192e19f5ebf3ba279", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/LinkedHashMultimapTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.google.common.collect.LinkedHashMultimap;\nimport org.apache.pulsar.shade.org.apache.commons.lang3.SerializationUtils;\nimport org.junit.jupiter.api.Test;\n\npublic class LinkedHashMultimapTest {\n\n    @Test\n    void preservesKeyAndEntryInsertionOrder() {\n        final LinkedHashMultimap<String, String> source = LinkedHashMultimap.create();\n        source.put(\"primary\", \"one\");\n        source.put(\"primary\", \"two\");\n        source.put(\"secondary\", \"three\");\n\n        final LinkedHashMultimap<String, String> restored = SerializationUtils.clone(source);\n\n        assertThat(restored.keySet()).containsExactly(\"primary\", \"secondary\");\n        assertThat(restored.get(\"primary\")).containsExactly(\"one\", \"two\");\n        assertThat(restored.get(\"secondary\")).containsExactly(\"three\");\n    }\n}\n"}}, {"type": "toolCall", "id": "call_ILUIycjFv9f6Ohx8hBzmMoup|fc_0936964dff2d7b74016ad503c7f23887d1a768821c3e2bf0d3", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/LinkedListMultimapTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.google.common.collect.LinkedListMultimap;\nimport org.apache.pulsar.shade.org.apache.commons.lang3.SerializationUtils;\nimport org.junit.jupiter.api.Test;\n\npublic class LinkedListMultimapTest {\n\n    @Test\n    void preservesRepeatedKeysAndGlobalEntryOrder() {\n        final LinkedListMultimap<String, String> source = LinkedListMultimap.create();\n        source.put(\"orders\", \"created\");\n        source.put(\"audit\", \"recorded\");\n        source.put(\"orders\", \"stored\");\n\n        final LinkedListMultimap<String, String> restored = SerializationUtils.clone(source);\n\n        assertThat(restored.entries()).containsExactlyElementsOf(source.entries());\n        assertThat(restored.get(\"orders\")).containsExactly(\"created\", \"stored\");\n    }\n}\n"}}, {"type": "toolCall", "id": "call_Dvdhn09PPEUd5iejyjhP8AWw|fc_0936964dff2d7b74016ad503c7f24487d1b1f1912b5be385df", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/GoogleCommonTreeMultimapTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.google.common.collect.TreeMultimap;\nimport org.apache.pulsar.shade.org.apache.commons.lang3.SerializationUtils;\nimport org.junit.jupiter.api.Test;\n\npublic class GoogleCommonTreeMultimapTest {\n\n    @Test\n    void preservesSortedKeysAndValues() {\n        final TreeMultimap<String, Integer> source = TreeMultimap.create();\n        source.put(\"secondary\", 3);\n        source.put(\"primary\", 2);\n        source.put(\"primary\", 1);\n\n        final TreeMultimap<String, Integer> restored = SerializationUtils.clone(source);\n\n        assertThat(restored.keySet()).containsExactly(\"primary\", \"secondary\");\n        assertThat(restored.get(\"primary\")).containsExactly(1, 2);\n    }\n}\n