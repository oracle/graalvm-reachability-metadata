 Schema<Event> json = Schema.JSON(Event.class);\n        final Event jsonValue = json.decode(json.encode(new Event(\"json\", 11)));\n\n        assertThat(avro.getSchemaInfo().getSchema()).isNotEmpty();\n        assertThat(avroValue.getName()).isEqualTo(\"avro\");\n        assertThat(avroValue.getSequence()).isEqualTo(7);\n        assertThat(json.getSchemaInfo().getSchema()).isNotEmpty();\n        assertThat(jsonValue).isEqualTo(new Event(\"json\", 11));\n    }\n\n    public static final class Payload {\n        private String name;\n        private int sequence;\n\n        public Payload() {\n        }\n\n        public Payload(String name, int sequence) {\n            this.name = name;\n            this.sequence = sequence;\n        }\n\n        public String getName() {\n            return name;\n        }\n\n        public void setName(String name) {\n            this.name = name;\n        }\n\n        public int getSequence() {\n            return sequence;\n        }\n\n        public void setSequence(int sequence) {\n            this.sequence = sequence;\n        }\n    }\n\n    public record Event(String name, int sequence) {\n    }\n}\n"}}, {"type": "toolCall", "id": "call_1jbTrGahx0Rae1nFueXiXwFw|fc_0c4b4cfdacc159d6016ad4e9f8de7487d1ab19a7a65d239f0d", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/AuthenticationUtilTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.Map;\nimport org.apache.pulsar.client.api.Authentication;\nimport org.apache.pulsar.client.impl.AuthenticationUtil;\nimport org.apache.pulsar.client.impl.auth.AuthenticationToken;\nimport org.junit.jupiter.api.Test;\n\npublic class AuthenticationUtilTest {\n\n    @Test\n    void createsConfiguredAuthenticationPluginsFromBothParameterForms() throws Exception {\n        try (Authentication encoded = AuthenticationUtil.create(\n                        AuthenticationToken.class.getName(), \"token:encoded-secret\");\n                Authentication mapped = AuthenticationUtil.create(\n                        AuthenticationToken.class.getName(), Map.of(\"token\", \"mapped-secret\"))) {\n            encoded.start();\n            mapped.start();\n\n            assertThat(encoded.getAuthMethodName()).isEqualTo(\"token\");\n            assertThat(encoded.getAuthData().getCommandData()).isEqualTo(\"encoded-secret\");\n            assertThat(mapped.getAuthMethodName()).isEqualTo(\"token\");\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_ViYL9V4aGfH6lkkSm3MCNovt|fc_0c4b4cfdacc159d6016ad4e9f8de7c87d1839206fd1bb60762", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ReflectionsTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.List;\nimport org.apache.pulsar.common.compression.CompressionCodec;\nimport org.apache.pulsar.common.compression.CompressionCodecNone;\nimport org.apache.pulsar.common.schema.LongSchemaVersion;\nimport org.apache.pulsar.common.util.Reflections;\nimport org.junit.jupiter.api.Test;\n\npublic class ReflectionsTest {\n\n    @Test\n    void createsChecksAndInspectsPulsarTypesByName() throws Exception {\n        final ClassLoader loader = Reflections.class.getClassLoader();\n        final String codecName = CompressionCodecNone.class.getName();\n\n     