[tool-exec] start id=call_3NiVii68iOB83slF3TEfBgbE|fc_05227da7d5a84e72016ad4f85398e887d18ed68e8679deb783 name=write args={"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/JacksonAnnotationIntrospectorTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport com.fasterxml.jackson.annotation.JsonAlias;\nimport com.fasterxml.jackson.annotation.JsonProperty;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.introspect.JacksonAnnotationIntrospector;\nimport org.junit.jupiter.api.Test;\n\n@SuppressWarnings(\"deprecation\")\npublic class JacksonAnnotationIntrospectorTest {\n\n    @Test\n    void discoversEnumNamesAndAliasesFromAnnotations() {\n        final JacksonAnnotationIntrospector introspector = new JacksonAnnotationIntrospector();\n        final State[] values = State.values();\n        final String[] names = {\"READY\", \"DONE\"};\n        final String[][] aliases = new String[values.length][];\n\n        introspector.findEnumValues(State.class, values, names);\n        introspector.findEnumAliases(State.class, values, aliases);\n\n        assertThat(introspector.findEnumValue(State.READY)).isEqualTo(\"ready-state\");\n        assertThat(names).containsExactly(\"ready-state\", \"DONE\");\n        assertThat(aliases[1]).containsExactly(\"complete\", \"finished\");\n    }\n\n    public enum State {\n        @JsonProperty(\"ready-state\")\n        READY,\n\n        @JsonAlias({\"complete\", \"finished\"})\n        DONE\n    }\n}\n"}
[tool-exec] start id=call_2AKktrbK1VpIQPJ1upPrcfaf|fc_05227da7d5a84e72016ad4f85398f087d1a3edec29b7732ace name=write args={"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/TypeFactoryTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.lang.reflect.GenericArrayType;\nimport java.lang.reflect.Type;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.type.TypeFactory;\nimport org.junit.jupiter.api.Test;\n\npublic class TypeFactoryTest {\n\n    @Test\n    void resolvesNamedAndGenericArrayClasses() throws Exception {\n        final TypeFactory factory = TypeFactory.defaultInstance();\n        final GenericArrayType genericArray = new GenericArrayType() {\n            @Override\n            public Type getGenericComponentType() {\n                return String.class;\n            }\n        };\n\n        assertThat(factory.findClass(\"java.util.ArrayList\")).isEqualTo(java.util.ArrayList.class);\n        assertThat(TypeFactory.rawClass(genericArray)).isEqualTo(String[].class);\n    }\n}\n"}
[tool-exec] start id=call_kBF8aiHNNEa5fJ6Z3k3uPPGT|fc_05227da7d5a84e72016ad4f85398fc87d19e7db7f75b8fbe5f name=write args={"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ArrayTypeTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.JavaType;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.type.ArrayType;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.type.TypeBindings;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.type.TypeFactory;\nimport org.junit.jupiter.api.Test;\n\npublic class ArrayTypeTest {\n\n    @Test\n    void replacesTheArrayComponentType() {\n        final TypeFactory factory = TypeFactory.defaultInstance();\n        final ArrayType strings = ArrayType.construct(factory.constructType(String.class), TypeBindings.emptyBindings());\n        final JavaType longs = strings.withContentType(factory.constructType(Long.class));\n\n        assertThat(longs.getRawClass()).isEqualTo(Long[].class);\n        assertThat(longs.getContentType().getRawClass()).isEqualTo(Long.class);\n    }\n}\n"}
[tool-exec] start id=call_Ghfmw9KSuJrqLsqVqw4gL3Cg|fc_05227da7d5a84e72016ad4f853996487d189fe7d0c550c4619 name=write args={"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ArrayBuildersTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.util.ArrayBuilders;\nimport org.junit.jupiter.api.Test;\n\npublic class ArrayBuildersTest {\n\n    @Test\n    void prependsNewValuesAndMovesExistingValuesToTheFront() {\n        final String[] original = {\"secondary\", \"primary\"};\n\n        assertThat(ArrayBuilders.insertInListNoDup(original, \"new\")).containsExactly(\"new\", \"secondary\", \"primary\");\n        assertThat(ArrayBuilders.insertInListNoDup(original, original[1])).containsExactly(\"primary\", \"secondary\");\n    }\n}\n"}
[tool-exec] start id=call_eiyN13te9XK3xO3EPMxTEgi3|fc_05227da7d5a84e72016ad4f853998887d1b15e6b097a6b12cf name=write args={"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ObjectArrayDeserializerTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.DeserializationFeature;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.ObjectMapper;\nimport org.junit.jupiter.api.Test;\n\npublic class ObjectArrayDeserializerTest {\n\n    @Test\n    void acceptsASingleValueAsATypedArray() throws Exception {\n        final ObjectMapper mapper = new ObjectMapper();\n        mapper.enable(DeserializationFeature.ACCEPT_SINGLE_VALUE_AS_ARRAY);\n\n        assertThat(mapper.readValue(\"\\\"orders\\\"\", String[].class)).containsExactly(\"orders\");\n    }\n}\n"}
