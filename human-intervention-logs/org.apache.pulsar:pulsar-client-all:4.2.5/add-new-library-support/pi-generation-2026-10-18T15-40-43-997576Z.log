UpdatableSketchBuilder;\nimport org.junit.jupiter.api.Test;\n\npublic class QuickSelectSketchTest {\n\n    @Test\n    void growsAndCompactsATupleSketchWithTypedSummaries() {\n        final UpdatableSketch<Double, DoubleSummary> sketch =\n                new UpdatableSketchBuilder<Double, DoubleSummary>(new DoubleSummaryFactory())\n                        .setNominalEntries(16)\n                        .build();\n        for (int index = 0; index < 40; index++) {\n            sketch.update(\"key-\" + index, (double) index);\n        }\n\n        final DoubleSummary[] summaries = sketch.getSummaries();\n        final CompactSketch<DoubleSummary> compact = sketch.compact();\n\n        assertThat(sketch.getRetainedEntries()).isGreaterThan(0);\n        assertThat(summaries).hasSize(sketch.getRetainedEntries());\n        assertThat(summaries.getClass()).isEqualTo(DoubleSummary[].class);\n        assertThat(compact.getSummaries()).hasSize(compact.getRetainedEntries());\n        assertThat(compact.getSummaries().getClass()).isEqualTo(DoubleSummary[].class);\n    }\n}\n"}}, {"type": "toolCall", "id": "call_NqGn9FYLWDEyekvWZNZyC5YB|fc_0936964dff2d7b74016ad50751806487d1bec890baf6252a95", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/SerializerDeserializerTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.yahoo.memory.NativeMemory;\nimport org.apache.pulsar.shade.com.yahoo.sketches.tuple.DoubleSummary;\nimport org.apache.pulsar.shade.com.yahoo.sketches.tuple.DoubleSummaryFactory;\nimport org.apache.pulsar.shade.com.yahoo.sketches.tuple.Sketch;\nimport org.apache.pulsar.shade.com.yahoo.sketches.tuple.Sketches;\nimport org.apache.pulsar.shade.com.yahoo.sketches.tuple.UpdatableSketch;\nimport org.apache.pulsar.shade.com.yahoo.sketches.tuple.UpdatableSketchBuilder;\nimport org.junit.jupiter.api.Test;\n\npublic class SerializerDeserializerTest {\n\n    @Test\n    void restoresSummaryAndFactoryTypesFromSerializedSketchData() {\n        final UpdatableSketch<Double, DoubleSummary> source =\n                new UpdatableSketchBuilder<Double, DoubleSummary>(new DoubleSummaryFactory()).build();\n        source.update(\"orders\", 2.5);\n        source.update(\"orders\", 1.5);\n        source.update(\"audit\", 3.0);\n\n        final byte[] serialized = source.toByteArray();\n        final Sketch<DoubleSummary> restored = Sketches.heapifySketch(new NativeMemory(serialized));\n\n        assertThat(restored.getRetainedEntries()).isEqualTo(2);\n        assertThat(restored.getSummaries()).allSatisfy(summary -> assertThat(summary).isInstanceOf(DoubleSummary.class));\n        assertThat(restored.getSummaries()).extracting(DoubleSummary::getValue).containsExactlyInAnyOrder(4.0, 3.0);\n    }\n}\n"}}, {"type": "toolCall", "id": "call_RiR9b8PRN2wyab6sBBMsjHh1|fc_0936964dff2d7b74016ad50751807087d1a124d5bd0e29226e", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/AnotBTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.yahoo.sketches.tuple.AnotB;\nimport org.apache.pulsar.shade.com.yahoo.sketches.tuple.CompactSketch;\nimport org.apache.pulsar.shade.com.yahoo.sketches.tuple.DoubleSummary;\nimport org.apache.pulsar.shade.com.yahoo.sketches.