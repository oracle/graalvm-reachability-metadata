rg.assertj.core.api.Assertions.assertThat;\n\nimport java.util.List;\nimport org.apache.pulsar.shade.it.unimi.dsi.fastutil.objects.ObjectArraySet;\nimport org.junit.jupiter.api.Test;\n\npublic class ObjectArraySetTest {\n\n    @Test\n    void copiesUniqueElementsIntoATypedArray() {\n        final ObjectArraySet<String> values = new ObjectArraySet<>(List.of(\"one\", \"two\"));\n\n        final String[] copied = values.toArray(new String[0]);\n\n        assertThat(copied).containsExactlyInAnyOrder(\"one\", \"two\");\n        assertThat(copied.getClass()).isEqualTo(String[].class);\n    }\n}\n"}}, {"type": "toolCall", "id": "call_KFLZcBzzuDWTfNuOafebOkIz|fc_05227da7d5a84e72016ad4f8ec325c87d18449c993d87a8a80", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ObjectImmutableListTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.it.unimi.dsi.fastutil.objects.ObjectImmutableList;\nimport org.junit.jupiter.api.Test;\n\npublic class ObjectImmutableListTest {\n\n    @Test\n    void copiesListsAndSublistsIntoTypedArrays() {\n        final ObjectImmutableList<String> values = ObjectImmutableList.of(\"zero\", \"one\", \"two\");\n\n        assertThat(values.toArray(new String[0])).containsExactly(\"zero\", \"one\", \"two\");\n        assertThat(values.subList(1, 3).toArray(new String[0])).containsExactly(\"one\", \"two\");\n    }\n}\n"}}, {"type": "toolCall", "id": "call_hoSoi3hDKetu6xGjcNXeGbsQ|fc_05227da7d5a84e72016ad4f8ec326887d1bbde30b0c784e749", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/