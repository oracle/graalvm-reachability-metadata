elds(Envelope.class))\n                        .map(field -> field.getName()))\n                .contains(\"name\", \"state\", \"events\");\n        assertThat(Arrays.stream(ClassUtil.getDeclaredMethods(Envelope.class))\n                        .map(method -> method.getName()))\n                .contains(\"getName\", \"setName\");\n        assertThat(Arrays.stream(ClassUtil.getClassMethods(Envelope.class))\n                        .map(method -> method.getName()))\n                .contains(\"getName\", \"toString\");\n        assertThat(ClassUtil.findFirstAnnotatedEnumValue(enumType, Primary.class)).isEqualTo(State.READY);\n    }\n\n    public enum State {\n        @Primary\n        READY,\n        DONE\n    }\n\n    @Retention(RetentionPolicy.RUNTIME)\n    @Target(ElementType.FIELD)\n\n[40 more lines in file. Use offset=68 to continue.]"}], "isError": false, "timestamp": 1792346151305}, {"role": "toolResult", "toolCallId": "call_pbpw77WJoh2iQ2817VoWHZ0N|fc_0936964dff2d7b74016ad5082604c487d183318b97fed6ff4c", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.io.InputStream;\nimport java.nio.charset.StandardCharsets;\nimport org.apache.pulsar.shade.org.apache.commons.codec.Resources;\nimport org.apache.pulsar.shade.org.apache.commons.io.IOUtils;\nimport org.junit.jupiter.api.Test;\n\npublic class CommonsCodecResourcesTest {\n\n    @Test\n    void opensARequiredClasspathResource() throws Exception {\n        try (InputStream input = Resources.getInputStream(\"/META-INF/io.netty.versions.properties\")) {\n            assertThat(IOUtils.toString(input, StandardCharsets.UTF_8)).contains(\"artifactId=pulsar-test-transport\");\n        }\n 