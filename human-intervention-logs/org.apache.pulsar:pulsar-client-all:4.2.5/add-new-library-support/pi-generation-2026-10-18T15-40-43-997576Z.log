ketchTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.yahoo.sketches.sampling.ReservoirItemsSketch;\nimport org.junit.jupiter.api.Test;\n\npublic class ReservoirItemsSketchTest {\n\n    @Test\n    void returnsTypedSamplesFromAReservoir() {\n        final ReservoirItemsSketch<String> sketch = ReservoirItemsSketch.getInstance(8);\n        sketch.update(\"one\");\n        sketch.update(\"two\");\n        sketch.update(\"three\");\n\n        assertThat(sketch.getSamples(String.class)).containsExactlyInAnyOrder(\"one\", \"two\", \"three\");\n        assertThat(sketch.getSamples()).containsExactlyInAnyOrder(\"one\", \"two\", \"three\");\n    }\n}\n"}}, {"type": "toolCall", "id": "call_ENYPNId0pvsva9j86qxmYKBx|fc_05227da7d5a84e72016ad4f8ec323087d188c874e41883961c", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/FrequenciesItemsSketchTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.yahoo.sketches.frequencies.ErrorType;\nimport org.apache.pulsar.shade.com.yahoo.sketches.frequencies.ItemsSketch;\nimport org.junit.jupiter.api.Test;\n\npublic class FrequenciesItemsSketchTest {\n\n    @Test\n    void sortsFrequentItemsIntoATypedResultArray() {\n        final ItemsSketch<String> sketch = new ItemsSketch<>(16);\n        sketch.update(\"orders\", 8);\n        sketch.update(\"events\", 3);\n        sketch.update(\"metrics\", 1);\n\n        assertThat(sketch.getFrequentItems(ErrorType.NO_FALSE_NEGATIVES))\n                .extracting(ItemsSketch.Row::getItem)\n                .contains(\"orders\", \"events\", \"metrics\");\n    }\n}\n"}}, {"type": "toolCall", "id": "call_zTDsUJMLWk1O0qTQVBBwnctm|fc_05227da7d5a84e72016ad4f8ec323c87d1aa73c9847dbb4630", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ObjectArrayListTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.it.unimi.dsi.fastutil.objects.ObjectArrayList;\nimport org.junit.jupiter.api.Test;\n\npublic class ObjectArrayListTest {\n\n    @Test\n    void copiesElementsIntoATypedArray() {\n        final ObjectArrayList<String> values = new ObjectArrayList<>(new String[] {\"one\", \"two\"});\n\n        final String[] copied = values.toArray(new String[0]);\n\n        assertThat(copied).containsExactly(\"one\", \"two\");\n        assertThat(copied.getClass()).isEqualTo(String[].class);\n    }\n}\n"}}, {"type": "toolCall", "id": "call_B1U37GXSiu6Xhb8QrGCKvXzL|fc_05227da7d5a84e72016ad4f8ec325487d1b19279f54079b824", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ObjectArraySetTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.List;\nimport org.apache.pulsar.shade.it.unimi.dsi.fastutil.objects.ObjectArraySet;\nimport org.junit.jupiter.api.Test;\n\npublic class ObjectArraySetTest {\n\n    @Test\n    void copiesUniqueElementsIntoATypedArray() {\n        final ObjectArraySet<String> values = new ObjectArraySet<>(List.of(\"one\", \"two\"));\n\n        final String[] copied = values.toArray(new String[0]);\n\n        assertThat(copied).containsExactlyInAnyOrder(\"one\", \"two\");\n        assertThat(copied.getClass()).isEqualTo(String[].class);\n    }\n}\n"}}, {"type": "toolCall", "id": "call_KFLZcBzzuDWTfNuOafebOkIz|fc_05227da7d5a84e72016ad4f8ec325c87d18449c993d87a8a80", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ObjectImmutableListTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.it.unimi.dsi.fastutil.objects.ObjectImmutableList;\nimport org.junit.jupiter.api.Test;\n\npublic class ObjectImmutableListTest {\n\n    @Test\n    void copiesListsAndSublistsIntoTypedArrays() {\n        final ObjectImmutableList<String> values = ObjectImmutableList.of(\"zero\", \"one\", \"two\");\n\n        assertThat(values.toArray(new String[0])).containsExactly(\"zero\", \"one\", \"two\");\n        assertThat(values.subList(1, 3).toArray(new String[0])).containsExactly(\"one\", \"two\");\n    }\n}\n"}}, {"type": "toolCall", "id": "call_hoSoi3hDKetu6xGjcNXeGbsQ|fc_05227da7d5a84e72016ad4f8ec326887d1bbde30b0c784e749", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/BigArraysTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.it.unimi.dsi.fastutil.BigArrays;\nimport org.junit.jupiter.api.Test;\n\npublic class BigArraysTest {\n\n    @Test\n    void wrapsAndGrowsGenericBigArrays() {\n        final String[][] wrapped = BigArrays.wrap(new String[] {\"one\", \"two\"});\n        final String[][] grown = BigArrays.forceCapacity(wrapped, 5, 2);\n\n        assertThat(BigArrays.length(grown)).isEqualTo(5);\n        assertThat(BigArrays.get(grown, 0)).isEqualTo(\"one\");\n        assertThat(BigArrays.get(grown, 1)).isEqualTo(\"two\");\n    }\n}\n"}}, {"type": "toolCall", "id": "call_WUwwQY9hOU4iPRKyxNTiPBhF|fc_05227da7d5a84e72016ad4f8ec327087d1bb04db3ca125089d", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ObjectBigArraysTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.it.unimi.dsi.fastutil.objects.ObjectBigArrays;\nimport org.junit.jupiter.api.Test;\n\npublic class ObjectBigArraysTest {\n\n    @Test\n    void createsTypedBigArraysFromAPrototype() {\n        final String[][] prototype = new String[0][];\n        final String[][] values = ObjectBigArrays.newBigArray(prototype, 4);\n        ObjectBigArrays.set(values, 2, \"two\");\n\n        assertThat(ObjectBigArrays.length(values)).isEqualTo(4);\n        assertThat(ObjectBigArrays.get(values, 2)).isEqualTo(\"two\");\n        assertThat(values.getClass()).isEqualTo(String[][].class);\n    }\n}\n"}}, {"type": "toolCall", "id": "call_aVXjg2jWRCndQdikHM8mFEfF|fc_05227da7d5a84e72016ad4f8ec327887d191570d3f58c43c59", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ObjectEncoderTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.io.netty.buffer.ByteBuf;\nimport org.apache.pulsar.shade.io.netty.channel.embedded.EmbeddedChannel;\nimport org.apache.pulsar.shade.io.netty.handler.codec.serialization.ObjectEncoder;\nimport org.junit.jupiter.api.Test;\n\npublic class ObjectEncoderTest {\n\n    @Test\n    void encodesSerializableMessagesWithALengthPrefix() {\n        final EmbeddedChannel channel = new EmbeddedChannel(new ObjectEncoder());\n        try {\n            assertThat(channel.writeOutbound(\"pulsar-message\")).isTrue();\n            final ByteBuf encoded = channel.readOutbound();\n            try {\n                assertThat(encoded.readableBytes()).isGreaterThan(4);\n                assertThat(encoded.getInt(0)).isEqualTo(encoded.readableBytes() - 4);\n            } finally {\n                encoded.release();\n            }\n        } finally {\n            channel.finishAndReleaseAll();\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_MvbAUGV5Alc1BJcDrHTJj9Fh|fc_05227da7d5a84e72016ad4f8ec328087d197ab340e81df6437", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ObjectDecoderTest.java", "conte