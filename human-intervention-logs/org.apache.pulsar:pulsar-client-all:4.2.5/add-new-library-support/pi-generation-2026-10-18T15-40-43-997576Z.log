.jupiter.api.Test;\n\npublic class TopicCompactionStrategyTest {\n\n    @Test\n    void loadsAndCachesCompactionStrategyByClassName() {\n        final String tag = \"keep-largest-integer\";\n        try {\n            final TopicCompactionStrategy<?> loaded =\n                    TopicCompactionStrategy.load(tag, LargestValueStrategy.class.getName());\n\n            assertThat(loaded).isInstanceOf(LargestValueStrategy.class);\n            assertThat(TopicCompactionStrategy.getInstance(tag)).isSameAs(loaded);\n            assertThat(((LargestValueStrategy) loaded).shouldKeepLeft(8, 3)).isTrue();\n            assertThat(((LargestValueStrategy) loaded).shouldKeepLeft(3, 8)).isFalse();\n        } finally {\n            TopicCompactionStrategy.INSTANCES.remove(tag);\n        }\n    }\n\n    public static final class LargestValueStrategy implements TopicCompactionStrategy<Integer> {\n        public LargestValueStrategy() {\n        }\n\n        @Override\n        public Schema<Integer> getSchema() {\n            return Schema.INT32;\n        }\n\n        @Override\n        public boolean shouldKeepLeft(Integer previous, Integer current) {\n            return previous >= current;\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_Qysv8Cjw0Ene8lbZgSBD4SkA|fc_0c4b4cfdacc159d6016ad4ea877eb487d1bc13a518e95026f1", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/JvmMetricsTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.List;\nimport org.apache.pulsar.common.stats.JvmG1GCMetricsLogger;\nimport org.apache.pulsar.common.stats.JvmMetrics;\nimport org.apache.pulsar.common.stats.Metrics;\nimport org.junit.jupiter.api.Test;\n\npublic class JvmMetricsTest {\n\n    @Test\n    void createsConfiguredMetricsLoggerAndPublishesJvmMeasurements() {\n        final JvmMetrics collector = JvmMetrics.create(null, \"client\", JvmG1GCMetricsLogger.class.getName());\n        final List<Metrics> metrics = collector.generate();\n\n        assertThat(metrics).singleElement().satisfies(snapshot -> {\n            assertThat(snapshot.getDimensions()).containsEntry(\"metric\", \"jvm_metrics\");\n            assertThat(snapshot.getMetrics())\n                    .containsKeys(\n                            \"jvm_gc_young_pause\",\n                            \"jvm_gc_young_count\",\n                            \"jvm_gc_old_pause\",\n                            \"jvm_gc_old_count\",\n                            \"client_default_pool_allocated\",\n                            \"client_default_pool_used\");\n        });\n    }\n}\n"}}, {"type": "toolCall", "id": "call_07d0FxAAxUOg1GjEWFOmqcmK|fc_0c4b4cfdacc159d6016ad4ea877ec087d19419bd004cb7aa1b", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/JvmDefaultGCMetricsLoggerTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.Map;\nimport org.apache.pulsar.common.stats.JvmDefaultGCMetricsLogger;\nimport org.apache.pulsar.common.stats.Metrics;\nimport org.junit.jupiter.api.Test;\n\npublic class JvmDefaultGCMetricsLoggerTest {\n\n    @Test\n    void refreshesAndExportsDefaultCollectorMetrics() {\n        final JvmDefaultGCMetricsLogger logger = new JvmDefaultGCMetricsLogger();\n        logger.refresh();\n        logger.refresh();\n\n        final Metrics metrics = Metrics.create(Map.of(\"component\", \"client\"));\n        logger.logMetrics(metrics);\n\n        assertThat(metrics.getDimensions()).containsEntry(\"component\", \"client\");\n        assertThat(metrics.getMetrics()).containsKeys(\"jvm_full_gc_pause\", \"jvm_full_gc_count\");\n        assertThat(metrics.getMetrics().get(\"jvm_full_gc_pause\")).isInstanceOf(Long.class);\n    }\n}\n"}}, {"type": "toolCall", "id": "call_HPjbSBrERply4guIIk6tgG5F|fc_0c4b4cfdacc159d6016ad4ea877ec887d18c65f4221dcd5211", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/PulsarURLStreamHandlerFactoryTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.io.InputStream;\nimport java.net.URL;\nimport java.net.URLStreamHandler;\nimport java.nio.charset.StandardCharsets;\nimport org.apache.pulsar.client.api.url.DataURLStreamHandler;\nimport org.apache.pulsar.client.api.url.PulsarURLStreamHandlerFactory;\nimport org.junit.jupiter.api.Test;\n\npublic class PulsarURLStreamHandlerFactoryTest {\n\n    @Test\n    void createsHandlerAndReadsBase64DataUrl() throws Exception {\n        final URLStreamHandler handler = new PulsarURLStreamHandlerFactory().createURLStreamHandler(\"data\");\n        final URL url = new URL(null, \"data:text/plain;base64,cHVsc2Fy\", handler);\n\n        assertThat(handler).isInstanceOf(DataURLStreamHandler.class);\n        assertThat(url.openConnection().getContentType()).isEqualTo(\"text/plain\");\n        try (InputStream input = url.openStream()) {\n            assertThat(new String(input.readAllBytes(), StandardCharsets.UTF_8)).isEqualTo(\"pulsar\");\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_mLHiWN5RJlhfhACViSZBHKMV|fc_0c4b4cfdacc159d6016ad4ea877ed087d1aa4141f0c40edfaa", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/OpenJdkSelfSignedCertGeneratorTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.io.netty.handler.ssl.util.SelfSignedCertificate;\nimport org.junit.jupiter.api.Test;\n\npublic class OpenJdkSelfSignedCertGeneratorTest {\n\n    @Test\n    void generatesUsableCertificateAndPrivateKeyFiles() throws Exception {\n        final SelfSignedCertificate certificate = new SelfSignedCertificate(\"localhost\");\n        try {\n            assertThat(certificate.certificate()).exists().isNotEmpty();\n            assertThat(certificate.privateKey()).exists().isNotEmpty();\n            assertThat(certificate.cert().getSubjectX500Principal().getName()).contains(\"localhost\");\n            assertThat(certificate.key().getAlgorithm()).isEqualTo(\"RSA\");\n        } finally {\n            certificate.delete();\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_f1WfYk1HsBZ1zGEqsEpVnEfv|fc_0c4b4cfdacc159d6016ad4ea877edc87d18df34078ea0f4dec", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ObjectEncoderOutputStreamTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.io.ByteArrayInputStream;\nimport java.io.ByteArrayOutputStream;\nimport java.util.ArrayList;\nimport java.util.List;\nimport org.apache.pulsar.shade.io.netty.handler.codec.serialization.ObjectDecoderInputStream;\nimport org.apache.pulsar.shade.io.netty.handler.codec.serialization.ObjectEncoderOutputStream;\nimport org.junit.jupiter.api.Test;\n\n@SuppressWarnings(\"deprecation\")\npublic class ObjectEncoderOutputStreamTest {\n\n    @Test\n    void framesAndRestoresSerializableObjects() throws Exception {\n        final ByteArrayOutputStream bytes = new ByteArrayOutputStream();\n        try (ObjectEncoderOutputStream output = new ObjectEncoderOutputStream(bytes, 64)) {\n            output.writeObject(new ArrayList<>(List.of(\"one\", \"two\", \"three\")));\n        }\n\n        try (ObjectDecoderInputStream input =\n                new ObjectDecoderInputStream(new ByteArrayInputStream(bytes.toByteArray()), 4096)) {\n            assertThat(input.readObject()).isEqualTo(List.of(\"one\", \"two\", \"three\"));\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_vR8LdQjZmMz04Q8kdZQeMr7I|fc_0c4b4cfdacc159d6016ad4ea877ee487d1b0fcc1e16024850d", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/FieldUtilsTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.lang.reflect.Field;\nimport org.apache.pulsar.shade.org.apache.commons.lang3.reflect.FieldUtils;\nimport org.junit.jupiter.api.Test;\n\npublic class FieldUtilsTest {\n\n    @Test\n    void discoversReadsAndWritesInheritedAndDeclaredFields() throws Exception {\n        final FieldTarget target = new FieldTarget();\n        final Field name = FieldUtils.getDeclaredField(FieldTarget.class, \"name\", true);\n\n        assertThat(FieldUtils.getAllFieldsList(FieldTarget.class))\n                .extracting(Field::getName)\n                .contains(\"name\", \"identifier\");\n        assertThat(FieldUtils.readField(name, target, true)).isEqualTo(\"initial\");\n\n        FieldUtils.writeField(name, target, \"updated\", true);\n        FieldUtils.writeField(target, \"identifier\", 42L, true);\n\n        assertThat(FieldUtils.readDeclaredField(target, \"name\", true)).isEqualTo(\"updated\");\n        assertThat(FieldUtils.readField(target, \"identifier\", true)).isEqualTo(42L);\n    }\n\n    public static class FieldBase {\n        protected long identifier = 1L;\n    }\n\n    public static final class FieldTarget extends FieldBase {\n        private String name = \"initial\";\n    }\n}\n"}}, {"type": "toolCall", "id": "call_tXqFf9CV60FAaciwcInd0pDR|fc_0c4b4cfdacc159d6016ad4ea877ef087d1bc16f23a8542391a", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/AnnotationUtilsTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.lang.annotation.Retention;\nimport java.lang.annotation.RetentionPolicy;\nimport org.apache.pulsar.shade.org.apache.commons.lang3.AnnotationUtils;\nimport org.junit.jupiter.api.Test;\n\npublic class AnnotationUtilsTest {\n\n    @Test\n    void comparesHashesAndFormatsRuntimeAnnotations() {\n        final Descriptor first = First.class.getAnnotation(Descriptor.class);\n        final Descriptor second = Second.class.getAnnotation(Descripto