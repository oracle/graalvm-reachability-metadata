e;\n        private final int port;\n\n        public Broker(String name, int port) {\n            this.name = name;\n            this.port = port;\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_PKsEn0mR8wDl3pvaZlhjqM1e|fc_05227da7d5a84e72016ad4f7fdcf0087d19ab9a5d0efb31c45", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/CompareToBuilderTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.org.apache.commons.lang3.builder.CompareToBuilder;\nimport org.junit.jupiter.api.Test;\n\npublic class CompareToBuilderTest {\n\n    @Test\n    void comparesDomainValuesByTheirFields() {\n        final int comparison = CompareToBuilder.reflectionCompare(new Sequence(7, \"a\"), new Sequence(9, \"a\"));\n\n        assertThat(comparison).isNegative();\n    }\n\n    public static final class Sequence {\n        private final int value;\n        private final String partition;\n\n        public Sequence(int value, String partition) {\n            this.value = value;\n            this.partition = partition;\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_tELLE1H4rVKPyRnldLbyUcLm|fc_05227da7d5a84e72016ad4f7fdcf0c87d190ca151be2f4a2b4", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/EqualsBuilderTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.org.apache.commons.lang3.builder.EqualsBuilder;\nimport org.junit.jupiter.api.Test;\n\npublic class EqualsBuilderTest {\n\n    @Test\n    void comparesAllDomainFields() {\n        assertThat(EqualsBuilder.reflectionEquals(new Topic(\"events\", 4), new Topic(\"events\", 4))).isTrue();\n        assertThat(EqualsBuilder.reflectionEquals(new Topic(\"events\", 4), new Topic(\"events\", 5))).isFalse();\n    }\n\n    public static final class Topic {\n        private final String name;\n        private final int partitions;\n\n        public Topic(String name, int partitions) {\n            this.name = name;\n            this.partitions = partitions;\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_c3AnRRTajCGx7k8XsLsWjxFl|fc_05227da7d5a84e72016ad4f7fdcf1887d1a30201b709d28a5d", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/HashCodeBuilderTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.org.apache.commons.lang3.builder.HashCodeBuilder;\nimport org.junit.jupiter.api.Test;\n\npublic class HashCodeBuilderTest {\n\n    @Test\n    void hashesAllDomainFieldsConsistently() {\n        final int first = HashCodeBuilder.reflectionHashCode(new MessageKey(\"orders\", 12));\n        final int second = HashCodeBuilder.reflectionHashCode(new MessageKey(\"orders\", 12));\n        final int different = HashCodeBuilder.reflectionHashCode(new MessageKey(\"orders\", 13));\n\n        assertThat(first).isEqualTo(second).isNotEqualTo(different);\n    }\n\n    public static final class MessageKey {\n        private final String topic;\n        private final int sequence;\n\n        public MessageKey(String topic, int sequence) {\n            this.topic = topic;\n            this.sequence = sequence;\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_jY1qVGII4uxXPQ8oJPp9h8r8|fc_05227da7d5a84e72016ad4f7fdcf2487d1aa2b16ef07a9ca7e", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ExceptionUtilsTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.org.apache.commons.lang3.exception.ExceptionUtils;\nimport org.junit.jupiter.api.Test;\n\n@SuppressWarnings(\"deprecation\")\npublic class ExceptionUtilsTest {\n\n    @Test\n    void discoversLegacyNestedExceptionAccessors() {\n        final IllegalStateException nested = new IllegalStateException(\"ledger closed\");\n\n        assertThat(ExceptionUtils.getCause(new LegacyClientException(nested))).isSameAs(nested);\n    }\n\n    public static final class LegacyClientException extends Exception {\n        private final Throwable nested;\n\n        public LegacyClientException(Throwable nested) {\n            this.nested = nested;\n        }\n\n        public Throwable getNested() {\n            return nested;\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_WkhMDrq6FeFycldqUvDc4pom|fc_05227da7d5a84e72016ad4f7fdcf3087d19f673d0ee07ec3f5", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/SerializationUtilsTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * Yo