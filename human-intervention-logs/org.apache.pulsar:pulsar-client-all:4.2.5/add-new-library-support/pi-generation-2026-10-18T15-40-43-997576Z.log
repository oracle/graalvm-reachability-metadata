    private <T> ObjectConstructor<T> newUnsafeAllocator(Class<? super T> rawType) {
      if (useJdkUnsafe) {
        return () -> {
          try {
            @SuppressWarnings("unchecked")
            T newInstance = (T) UnsafeAllocator.INSTANCE.newInstance(rawType);
            return newInstance;
          } catch (Exception e) {
            throw new RuntimeException(
