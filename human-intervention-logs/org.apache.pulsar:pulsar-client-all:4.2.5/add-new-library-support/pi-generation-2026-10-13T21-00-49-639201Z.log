d": "call_3EC2fgaMOBCC2MFQasWVBtGN|fc_0c7c1e5cd2bac811016acea0f4ed8c87d195fb7ec6004f9a36", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/AvroSchemaTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.time.Instant;\nimport org.apache.pulsar.client.api.Schema;\nimport org.apache.pulsar.client.api.schema.SchemaDefinition;\nimport org.apache.pulsar.common.schema.SchemaType;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.Timeout;\n\n@Timeout(55)\npublic class AvroSchemaTest {\n    @Test\n    void roundTripsPojoWithJsr310AvroSchema() {\n        SchemaDefinition<AuditEvent> definition = SchemaDefinition.<AuditEvent>builder()\n                .withPojo(AuditEvent.class)\n                .withAlwaysAllowNull(false)\n                .withJSR310ConversionEnabled(true)\n                .addProperty(\"domain\", \"audit\")\n                .build();\n        Schema<AuditEvent> schema = Schema.AVRO(definition);\n        AuditEvent event = new AuditEvent(\n                \"event-17\", Instant.parse(\"2025-01-15T10:15:30.123Z\"), 4);\n\n        byte[] encoded = schema.encode(event);\n        AuditEvent decoded = schema.decode(encoded);\n\n        assertThat(encoded).isNotEmpty();\n        assertThat(schema.getSchemaInfo().getType()).isEqualTo(SchemaType.AVRO);\n        assertThat(schema.getSchemaInfo().getProperties()).containsEntry(\"domain\", \"audit\");\n        assertThat(decoded.getEventId()).isEqualTo(event.getEventId());\n        assertThat(decoded.getOccurredAt()).isEqualTo(event.getOccurredAt());\n        assertThat(decoded.getSeverity()).isEqualTo(event.getSeverity());\n    }\n\n    public static final class AuditEvent {\n        private String eventId;\n        private Instant occurredAt;\n        private int severity;\n\n        public AuditEvent() {}\n\n        public AuditEvent(String eventId, Instant occurredAt, int severity) {\n            this.eventId = eventId;\n            this.occurredAt = occurredAt;\n            this.severity = severity;\n        }\n\n        public String getEventId() {\n            return eventId;\n        }\n\n        public void setEventId(String eventId) {\n            this.eventId = eventId;\n        }\n\n        public Instant getOccurredAt() {\n            return occurredAt;\n        }\n\n        public void setOccurredAt(Instant occurredAt) {\n            this.occurredAt = occurredAt;\n        }\n\n        public int getSeverity() {\n            return severity;\n        }\n\n        public void setSeverity(int severity) {\n            this.severity = severity;\n        }\n    }\n}\n"}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-sol", "usage": {"input": 2369, "output": 1596, "cacheRead": 69632, "cacheWrite": 0, "reasoning": 883, "totalTokens": 73597, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1791926491090, "responseId": "resp_0c7c1e5cd2bac811016acea0dbb96887d1a19eeb1fbdcab553", "rawStopReason": "completed"}, "toolResults": [{"role": "toolResult", "toolCallId": "call_3EC2fgaMOBCC2MFQasWVBtGN|fc_0c7c1e5cd2bac811016acea0f4ed8c87d195fb7ec6004f9a36", "toolName": "write", "content": [{"type": "text", "text": "Successfully wrote 2617 bytes to tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/AvroSchemaTest.java"}], "isError": false, "timestamp": 1791926534545}]}
