      }
  
      reservoirSize_ = k;
      rf_ = rf;
  
      itemsSeen_ = 0;
  
      final int ceilingLgK = Util.toLog2(Util.ceilingPowerOf2(reservoirSize_), "ReservoirLongsSketch");
