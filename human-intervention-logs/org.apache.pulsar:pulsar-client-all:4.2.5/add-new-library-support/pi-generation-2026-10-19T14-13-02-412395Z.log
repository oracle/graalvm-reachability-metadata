      @Override
      File createTempFile(String prefix) throws IOException {
        return java.nio.file.Files.createTempFile(
                Paths.get(JAVA_IO_TMPDIR.value()),
                /* prefix= */ prefix,
                /* suffix= */ null,
                filePermissions.get())
            .toFile();
