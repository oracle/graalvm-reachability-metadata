[tool-call] delta {"path":"tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ClassLoaderUtilsTest.java","content":"/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.common.util.ClassLoaderUtils;\nimport org.junit.jupiter.api.Test;\n\npublic class ClassLoaderUtilsTest {\n    @Test\n    void loadsKnownClassFromSuppliedLoader() throws Exception {\n        Class<?> loaded = ClassLoaderUtils.loadClass(\n                \"org.apache.pulsar.client.api.PulsarClient\", getClass().getClassLoader());\n\n        assertThat(loaded.getName()).isEqualTo(\"org.apache.pulsar.client.api.PulsarClient\");\n        assertThat(loaded.getClassLoader()).isEqualTo(getClass().getClassLoader());\n    }\n}\n"}
