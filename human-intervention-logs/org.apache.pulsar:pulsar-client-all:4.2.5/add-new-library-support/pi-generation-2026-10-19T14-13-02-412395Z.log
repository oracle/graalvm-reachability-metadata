s**\"},{\"type\":\"summary_text\",\"text\":\"**Planning localization metadata tests**\"}]}"}, {"type": "toolCall", "id": "call_Put81v7cjcigz372zqzJqzJp|fc_0afec38eb29cac6c016ad6af1f1ec487d19e9cffd315b5b1b6", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/AbstractBiMapInnerInverseTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.google.common.collect.BiMap;\nimport org.apache.pulsar.shade.com.google.common.collect.HashBiMap;\nimport org.junit.jupiter.api.Test;\n\npublic class AbstractBiMapInnerInverseTest {\n    @Test\n    void serializationPreservesInverseMappingsAndIdentity() throws Exception {\n        HashBiMap<String, Integer> forward = HashBiMap.create();\n        forward.put(\"one\", 1);\n        forward.put(\"two\", 2);\n\n        BiMap<Integer, String> restored = SerializationSupport.roundTrip(forward.inverse());\n\n        assertThat(restored).containsEntry(1, \"one\").containsEntry(2, \"two\");\n        assertThat(restored.inverse().inverse()).isSameAs(restored);\n    }\n}\n"}}, {"type": "toolCall", "id": "call_IBM4C2y2EKae26w264NJ8sG5|fc_0afec38eb29cac6c016ad6af1f1edc87d19bbe351040185c64", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/AnnotationImplTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.lang.annotation.Retention;\nimport java.lang.annotation.RetentionPolicy;\n\nimport org.apache.pulsar.shade.javassist.bytecode.ConstPool;\nimport org.apache.pulsar.shade.javassist.bytecode.annotation.Annotation;\nimport org.apache.pulsar.shade.javassist.bytecode.annotation.IntegerMemberValue;\nimport org.apache.pulsar.shade.javassist.bytecode.annotation.StringMemberValue;\nimport org.junit.jupiter.api.Test;\n\npublic class AnnotationImplTest {\n    @Test\n    void runtimeProxyHasAnnotationEqualityAndHashCodeSemantics() throws Exception {\n        ConstPool constPool = new ConstPool(getClass().getName());\n        Annotation annotation = new Annotation(RuntimeLabel.class.getName(), constPool);\n        annotation.addMemberValue(\"name\", new StringMemberValue(\"pulsar\", constPool));\n        annotation.addMemberValue(\"priority\", new IntegerMemberValue(constPool, 4));\n\n        RuntimeLabel proxy = (RuntimeLabel) annotation.toAnnotationType(getClass().getClassLoader(), null);\n        RuntimeLabel declared = Labelled.class.getAnnotation(RuntimeLabel.class);\n\n        assertThat(proxy.annotationType()).isEqualTo(RuntimeLabel.class);\n        assertThat(proxy.name()).isEqualTo(\"pulsar\");\n        assertThat(proxy.priority()).isEqualTo(4);\n        assertThat(proxy.hashCode()).isEqualTo(declared.hashCode());\n        assertThat(proxy).isEqualTo(declared);\n    }\n\n    @Retention(RetentionPolicy.RUNTIME)\n    public @interface RuntimeLabel {\n        String name();\n\n        int priority();\n    }\n\n    @RuntimeLabel(name = \"pulsar\", priority = 4)\n    public static class Labelled {\n    }\n}\n"}}, {"type": "toolCall", "id": "call_TAAkJZ19PbVzneDFAnVbjTaV|fc_0afec38eb29cac6c016ad6af1f1ee887d1b1953db0d390a03a", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ArrayMemberValueTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.javassist.bytecode.ConstPool;\nimport org.apache.pulsar.shade.javassist.bytecode.annotation.Annotation;\nimport org.apache.pulsar.shade.javassist.bytecode.annotation.ArrayMemberValue;\nimport org.apache.pulsar.shade.javassist.bytecode.annotation.MemberValue;\nimport org.apache.pulsar.shade.javassist.bytecode.annotation.StringMemberValue;\nimport org.junit.jupiter.api.Test;\n\npublic class ArrayMemberValueTest {\n    @Test\n    void convertsNestedMemberValuesToTypedArrays() throws Exception {\n        ConstPool constPool = new ConstPool(getClass().getName());\n        ArrayMemberValue first = stringArray(constPool, \"persistent\", \"non-persistent\");\n        ArrayMemberValue second = stringArray(constPool, \"partitioned\");\n        ArrayMemberValue matrix = new ArrayMemberValue(first, constPool);\n        matrix.setValue(new MemberValue[] {first, second});\n        Annotation annotation = new Annotation(ArrayCarrier.class.getName(), constPool);\n        annotation.addMemberValue(\"values\", matrix);\n\n        ArrayCarrier proxy = (ArrayCarrier) annotation.toAnnotationType(getClass().getClassLoader(), null);\n\n        assertThat(proxy.values()).containsExactly(\n                new String[] {\"persistent\", \"non-persistent\"},\n                new String[] {\"partitioned\"});\n    }\n\n    private static ArrayMemberValue stringArray(ConstPool constPool, String... values) {\n        MemberValue[] members = new MemberValue[values.length];\n        for (int i = 0; i < values.length; i++) {\n            members[i] = new StringMemberValue(values[i], constPool);\n        }\n        ArrayMemberValue result = new ArrayMemberValue(constPool);\n       