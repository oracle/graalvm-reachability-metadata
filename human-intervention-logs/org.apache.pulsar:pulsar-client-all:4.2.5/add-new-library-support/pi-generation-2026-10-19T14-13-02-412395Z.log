src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/MemberValueTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.javassist.bytecode.ConstPool;\nimport org.apache.pulsar.shade.javassist.bytecode.annotation.Annotation;\nimport org.apache.pulsar.shade.javassist.bytecode.annotation.ClassMemberValue;\nimport org.junit.jupiter.api.Test;\n\npublic class MemberValueTest {\n    @Test\n    void resolvesClassMemberThroughRuntimeAnnotation() throws Exception {\n        ConstPool constPool = new ConstPool(getClass().getName());\n        Annotation annotation = new Annotation(TypeCarrier.class.getName(), constPool);\n        annotation.addMemberValue(\"value\", new ClassMemberValue(String.class.getName(), constPool));\n\n        TypeCarrier proxy = (TypeCarrier) annotation.toAnnotationType(getClass().getClassLoader(), null);\n\n        assertThat(proxy.value()).isEqualTo(String.class);\n    }\n\n    public @interface TypeCarrier {\n        Class<?> value();\n    }\n}\n"}}, {"type": "toolCall", "id": "call_uKKXgGOJhimxq5gJVYuniwC1|fc_0afec38eb29cac6c016ad6af1f1f0087d19925e4866617f846", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ClassLoaderUtilsTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.client.api.PulsarClient;\nimport org.apache.pulsar.common.util.ClassLoaderUtils;\nimport org.junit.jupiter.api.Test;\n\npublic class ClassLoaderUtilsTest {\n    private static final String ALIAS = \"example.PulsarClientAlias\";\n\n    @Test\n    void fallsBackToProvidedLoaderForAnApplicationAlias() throws Exception {\n        AliasClassLoader loader = new AliasClassLoader(getClass().getClassLoader());\n\n        Class<?> loaded = ClassLoaderUtils.loadClass(ALIAS, loader);\n\n        assertThat(loaded).isEqualTo(PulsarClient.class);\n        assertThat(loader.requested).isTrue();\n    }\n\n    private static final class AliasClassLoader extends ClassLoader {\n        private boolean requested;\n\n        private AliasClassLoader(ClassLoader parent) {\n            super(parent);\n        }\n\n        @Override\n        public Class<?> loadClass(String name) throws ClassNotFoundException {\n            if (ALIAS.equals(name)) {\n                requested = true;\n                return PulsarClient.class;\n            }\n            return super.loadClass(name);\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_BHLoaoJJMCQXVjw8PmPRHgi5|fc_0afec38eb29cac6c016ad6af1f1f0487d1836b84436bc531a7", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/DescTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.javassist.runtime.Desc;\nimport org.junit.jupiter.api.Test;\n\npublic class DescTest {\n    @Test\n    void resolvesDescriptorsWithDefaultAndContextClassLoaders() {\n        assertThat(Desc.getClazz(String.class.getName())).isEqualTo(String.class);\n        assertThat(Desc.getParams(\"(Ljava/lang/String;I)V\")).containsExactly(String.class, int.class);\n\n        Desc.setUseContextClassLoaderLocally();\n        try {\n            assertThat(Desc.getType(\"[Ljava/lang/String;\")).isEqualTo(String[].class);\n        } finally {\n            Desc.resetUseContextClassLoaderLocally();\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_UwWdGZkuNEJ34pRr0hBwI5Me|fc_0afec38eb29cac6c016ad6af1f1f0c87d1b1f36df8418ee0d7", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/Java9IntHashTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport com.scurrilous.circe.checksum.Java9IntHash;\nimport java.nio.charset.StandardCharsets;\nimport java.util.zip.CRC32C;\nimport org.apache.pulsar.shade.io.netty.buffer.ByteBuf;\nimport org.apache.pulsar.shade.io.netty.buffer.Unpooled;\nimport org.junit.jupiter.api.Test;\n\npublic class Java9IntHashTest {\n    private static final byte[] PAYLOAD = \"pulsar-java9-crc32c\".getBytes(StandardCharsets.UTF_8);\n\n    @Test\n    void computesCrc32cFromArrayAndDirectBuffer() {\n        Java9IntHash hash = new Java9IntHash();\n        int arrayHash = hash.resume(0, PAYLOAD, 0, PAYLOAD.length);\n        ByteBuf buffer = Unpooled.directBuffer(PAYLOAD.length);\n        try {\n            buffer.writeBytes(PAYLOAD);\n            int directHash = hash.resume(0, buffer, 0, PAYLOAD.length);\n\n            assertThat(Integer.toUnsignedLong(arrayHash)).isEqualTo(expectedChecksum());\n            assertThat(Integer.toUnsignedLong(directHash)).isEqualTo(expectedChecksum());\n        } finally {\n            buffer.release();\n        }\n    }\n\n    private static long expectedChecksum() {\n        CRC32C checksum = new CRC32C();\n        checksum.update(PAYLOAD, 0, PAYLOAD.length);\n        return checksum.getValue();\n    }\n}\n"}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-sol", "usage": {"input": 2402, "output": 4303, "cacheRead": 170240, "cacheWrite": 0, "reasoning": 1003, "totalTokens": 176945, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1792454343532, "responseId": "resp_0afec38eb29cac6c016ad6aec81b9c87d1a9fdc48e59e9d4ec", "rawStopReason": "completed"}}
