isEqualTo(input);\n        assertThat(restored.keySet()).containsExactly(\"numbers\", \"letters\");\n        assertThat(restored.get(\"letters\")).containsExactly(\"c\", \"b\", \"a\");\n        restored.put(\"greek\", \"omega\");\n        assertThat(restored.keySet()).containsExactly(\"numbers\", \"letters\", \"greek\");\n    }\n}\n"}], "isError": false, "timestamp": 1792424999743}, {"role": "toolResult", "toolCallId": "call_yXSxi0PN5xXEI5zwWvEwoYlP|fc_0bf7130f74ebe3a8016ad63c277d0487d191adb8002271f2fc", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.io.Serializable;\nimport java.util.ArrayList;\nimport java.util.HashMap;\nimport java.util.List;\n\nimport org.apache.pulsar.shade.com.google.common.base.Supplier;\nimport org.apache.pulsar.shade.com.google.common.collect.ListMultimap;\nimport org.apache.pulsar.shade.com.google.common.collect.Multimaps;\nimport org.junit.jupiter.api.Test;\n\npublic class MultimapsInnerCustomListMultimapTest {\n    @Test\n    void roundTripPreservesListOrderAndDuplicates() throws Exception {\n        ListMultimap<String, String> input = Multimaps.newListMultimap(new HashMap<>(), new ListSupplier());\n        input.put(\"letters\", \"a\");\n        input.put(\"letters\", \"b\");\n        input.put(\"letters\", \"a\");\n\n        ListMultimap<String, String> restored = SerializationSupport.roundTrip(input);\n\n        assertThat(restored.get(\"letters\")).containsExactly(\"a\", \"b\", \"a\");\n        restored.put(\"letters\", \"c\");\n        assertThat(restored.get(\"letters\")).endsWith(\"c\");\n    }\n\n    private static final class ListSupplier implements Supplier<List<String>>, Serializable {\n        @Override\n        public List<String> get() {\n            return new ArrayList<>();\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792424999744}, {"role": "toolResult", "toolCallId": "call_WszyTD57U3SwT3ivO9XGlRBW|fc_0bf7130f74ebe3a8016ad63c277d0c87d1a9370cc5ecdf8088", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport java.io.ByteArrayInputStream;\nimport java.io.ByteArrayOutputStream;\nimport java.io.ObjectInputStream;\nimport java.io.ObjectOutputStream;\n\npublic final class SerializationSupport {\n    private SerializationSupport() {\n    }\n\n    public static <T> T roundTrip(T value) throws Exception {\n        ByteArrayOutputStream bytes = new ByteArrayOutputStream();\n        try (ObjectOutputStream output = new ObjectOutputStream(bytes)) {\n            output.writeObject(value);\n        }\n        try (ObjectInputStream input = new ObjectInputStream(new ByteArrayInputStream(bytes.toByteArray()))) {\n            @SuppressWarnings(\"unchecked\")\n            T restored = (T) input.readObject();\n            return restored;\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792424999744}, {"role": "toolResult", "toolCallId": "call_fOKfRRwgkXHweysjfi7kTpcH|fc_0bf7130f74ebe3a8016ad63c277d1487d1a376035add6e1f0f", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.javax.ws.rs.client.Client;\nimport org.apache.pulsar.shade.javax.ws.rs.client.ClientBuilder;\nimport org.junit.jupiter.api.Test;\n\npublic class ClientBuilderTest {\n    @Test\n    void discoversProviderAndBuildsClosableClient() {\n        ClientBuilder builder = ClientBuilder.newBuilder();\n        Client client = builder.build();\n        try {\n            assertThat(builder.getClass().getName()).contains(\"JerseyClientBuilder\");\n            assertThat(client.getConfiguration().isRegistered(Object.class)).isFalse();\n        } finally {\n            client.close();\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792424999745}, {"role": "toolResult", "toolCallId": "call_0NWKVWyynpM3Z7OT5lk1XPQn|fc_0bf7130f74ebe3a8016ad63c277d1c87d18024c2f484d81f8e", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.net.URI;\n\nimport org.apache.pulsar.shade.javax.ws.rs.ext.RuntimeDelegate;\nimport org.junit.jupiter.api.Test;\n\npublic class RuntimeDelegateTest {\n    @Test\n    void discoversDelegateAndCreatesUriBuilder() {\n        RuntimeDelegate delegate = RuntimeDelegate.getInstance();\n\n        URI uri = delegate.createUriBuilder().path(\"topics\").path(\"persistent\").build();\n\n        assertThat(delegate.getClass().getName()).contains(\"RuntimeDelegateImpl\");\n        assertThat(uri.toString()).isEqualTo(\"topics/persistent\");\n    }\n}\n"}], "isError": false, "timestamp": 1792424999745}, {"role": "toolResult", "toolCallId": "call_nvmbYrQIVzQu1B4JDe1noXLi|fc_0bf7130f74ebe3a8016ad63c277d2487d1b8e364430395c12d", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.net.URI;\nimport java.net.http.HttpRequest;\nimport java.net.http.HttpResponse;\nimport java.time.Duration;\nimport java.util.concurrent.Callable;\nimport java.util.concurrent.TimeUnit;\nimport org.apache.pulsar.client.admin.PulsarAdmin;\nimport org.apache.pulsar.client.api.Consumer;\nimport org.apache.pulsar.client.api.Message;\nimport org.apache.pulsar.client.api.Producer;\nimport org.apache.pulsar.client.api.PulsarClient;\nimport org.apache.pulsar.client.api.Schema;\nimport org.junit.jupiter.api.AfterAll;\nimport org.junit.jupiter.api.BeforeAll;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.TestInstance;\n\n@TestInstance(TestInstance.Lifecycle.PER_CLASS)\npublic class ByteBufPairTest {\n    private static final String CONTAINER_NAME = \"graalvm-pulsar-client-all-test\";\n    private static final String HTTP_URL = \"http://localhost:8080\";\n    private static final String SERVICE_URL = \"pulsar://localhost:6650\";\n    private static final String TOPIC = \"persistent://public/default/reachability-metadata\";\n\n    private Process pulsar;\n\n    @BeforeAll\n    void startPulsar() throws Exception {\n        removeExistingContainer();\n        pulsar = new ProcessBuilder(\n                        \"docker\",\n                        \"run\",\n                        \"--rm\",\n                        \"--name\",\n                        CONTAINER_NAME,\n                        \"-p\",\n                        \"6650:6650\",\n                        \"-p\",\n                        \"8080:8080\",\n                        \"apachepulsar/pulsar:4.2.5\",\n                        \"bin/pulsar\",\n                        \"standalone\",\n                        \"--no-functions-worker\",\n                        \"-nss\")\n                .inheritIO()\n                .start();\n\n        waitUntil(this::standaloneNamespaceIsReady, Duration.ofSeconds(120), Duration.ofSeconds(1));\n    }\n\n    @AfterAll\n    void stopPulsar() throws Exception {\n        if (pulsar != null && pulsar.isAlive()) {\n            pulsar.destroy();\n            if (!pulsar.waitFor(10, TimeUnit.SECONDS)) {\n                pulsar.destroyForcibly();\n                pulsar.waitFor(10, TimeUnit.SECONDS);\n            }\n        }\n        removeExistingContainer();\n    }\n\n    @Test\n    void publishesAndConsumesThroughTheBinaryProtocol() throws Exception {\n        try (PulsarAdmin admin = PulsarAdmin.builder()\n                        .serviceHttpUrl(HTTP_URL)\n                        .connectionTimeout(10, TimeUnit.SECONDS)\n                        .readTimeout(30, TimeUnit.SECONDS)\n                        .build();\n                PulsarClient client = PulsarClient.builder()\n                        .serviceUrl(SERVICE_URL)\n                        .connectionTimeout(10, TimeUnit.SECONDS)\n                        .operationTimeout(30, TimeUnit.SECONDS)\n                        .build();\n                Consumer<String> consumer = client.newConsumer(Schema.STRING)\n                        .topic(TOPIC)\n                        .subscriptionName(\"reachability-metadata-subscription\")\n                        .subscribe();\n                Producer<String> producer = client.newProducer(Schema.STRING).topic(TOPIC).create()) {\n            assertThat(admin.clusters().getClusters()).contains(\"standalone\");\n\n            producer.newMessage()\n                    .key(\"integration-key\")\n                    .property(\"source\", \"native-image-test\")\n                    .value(\"pulsar-message\")\n                    .send();\n            Message<String> message = consumer.receive(30, TimeUnit.SECONDS);\n\n            assertThat(message).isNotNull();\n            assertThat(message.getValue()).isEqualTo(\"pulsar-message\");\n            assertThat(message.getKey()).isEqualTo(\"integration-key\");\n            assertThat(message.getProperty(\"source\")).isEqualTo(\"native-image-test\");\n            consumer.acknowledge(message);\n            assertThat(admin.topics().getStats(TOPIC).getSubscriptions())\n                    .containsKey(\"reachability-metadata-subscription\");\n        }\n    }\n\n    private boolean standaloneNamespaceIsReady() throws Exception {\n        if (!pulsar.isAlive()) {\n            throw new IllegalStateException(\"Pulsar container exited before becoming ready\");\n        }\n        java.net.http.HttpClient client = java.net.http.HttpClient.newBuilder()\n                .connectTimeout(Duration.ofSeconds(10))\n                .build();\n        HttpRequest request = HttpRequest.newBuilder()\n                .uri(URI.create(HTTP_URL + \"/admin/v2/namespaces/public\"))\n                .timeout(Duration.ofSeconds(10))\n                .GET()\n                .build();\n        HttpResponse<String> response = client.send(request, HttpResponse.BodyHandlers.ofString());\n        return response.statusCode() == 200 && response.body().contains(\"public/default\");\n    }\n\n    private static void removeExistingContainer() throws Exception {\n        Process process = new ProcessBuilder(\"docker\", \"rm\", \"-f\", CONTAINER_NAME)\n                .redirectErrorStream(true)\n                .start();\n        if (!process.waitFor(10, TimeUnit.SECONDS)) {\n            process.destroyForcibly();\n            process.waitFor(10, TimeUnit.SECONDS);\n        }\n    }\n\n    private static void waitUntil(\n            Callable<Boolean> condition, Duration timeout, Duration sleepTime) throws Exception {\n        Exception lastException = null;\n        long deadline = System.nanoTime() + timeout.toNanos();\n        while (System.nanoTime() < deadline) {\n            try {\n                if (condition.call()) {\n                    return;\n                }\n            } catch (Exception e) {\n                lastException = e;\n            }\n            Thread.sleep(sleepTime.toMillis());\n        }\n        throw new IllegalStateException(\"Pulsar was not ready within \" + timeout, lastException);\n    }\n}\n"}], "isError": false, "timestamp": 1792424999745}]}
