: "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.javassist.bytecode.ConstPool;\nimport org.apache.pulsar.shade.javassist.bytecode.annotation.Annotation;\nimport org.apache.pulsar.shade.javassist.bytecode.annotation.ArrayMemberValue;\nimport org.apache.pulsar.shade.javassist.bytecode.annotation.MemberValue;\nimport org.apache.pulsar.shade.javassist.bytecode.annotation.StringMemberValue;\nimport org.junit.jupiter.api.Test;\n\npublic class ArrayMemberValueTest {\n    @Test\n    void convertsNestedMemberValuesToTypedArrays() throws Exception {\n        ConstPool constPool = new ConstPool(getClass().getName());\n        ArrayMemberValue first = stringArray(constPool, \"persistent\", \"non-persistent\");\n        ArrayMemberValue second = stringArray(constPool, \"partitioned\");\n        ArrayMemberValue matrix = new ArrayMemberValue(first, constPool);\n        matrix.setValue(new MemberValue[] {first, second});\n        Annotation annotation = new Annotation(ArrayCarrier.class.getName(), constPool);\n        annotation.addMemberValue(\"values\", matrix);\n\n        ArrayCarrier proxy = (ArrayCarrier) annotation.toAnnotationType(getClass().getClassLoader(), null);\n\n        assertThat(proxy.values()).containsExactly(\n                new String[] {\"persistent\", \"non-persistent\"},\n                new String[] {\"partitioned\"});\n    }\n\n    private static ArrayMemberValue stringArray(ConstPool constPool, String... values) {\n        MemberValue[] members = new MemberValue[values.length];\n        for (int i = 0; i < values.length; i++) {\n            members[i] = new StringMemberValue(values[i], constPool);\n        }\n        ArrayMemberValue result = new ArrayMemberValue(constPool);\n        result.setValue(members);\n        return result;\n    }\n\n    public @interface ArrayCarrier {\n        String[][] values();\n    }\n}\n"}], "isError": false, "timestamp": 1792455073148}, {"role": "toolResult", "toolCallId": "call_bfmqo5dvIcmo9k8bF1AIUGxu|fc_0afec38eb29cac6c016ad6b19f9b9487d193ff4c99a25a2396", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.io.netty.buffer.ByteBuf;\nimport org.apache.pulsar.shade.io.netty.channel.embedded.EmbeddedChannel;\nimport org.apache.pulsar.shade.io.netty.handler.codec.serialization.ClassResolvers;\nimport org.apache.pulsar.shade.io.netty.handler.codec.serialization.ObjectDecoder;\nimport org.apache.pulsar.shade.io.netty.handler.codec.serialization.ObjectEncoder;\n\npublic final class NettyObjectSerializationSupport {\n    private NettyObjectSerializationSupport() {\n    }\n\n    public static void roundTrip() {\n        EmbeddedChannel encoder = new EmbeddedChannel(new ObjectEncoder());\n        EmbeddedChannel decoder = new EmbeddedChannel(\n                new ObjectDecoder(ClassResolvers.cacheDisabled(\n                        NettyObjectSerializationSupport.class.getClassLoader())));\n        try {\n            assertThat(encoder.writeOutbound(\"serialized-pulsar-value\")).isTrue();\n            ByteBuf encoded = encoder.readOutbound();\n            assertThat(decoder.writeInbound(encoded)).isTrue();\n            assertThat((String) decoder.readInbound()).isEqualTo(\"serialized-pulsar-value\");\n        } finally {\n            encoder.finishAndReleaseAll();\n            decoder.finishAndReleaseAll();\n        }\n    }\n\n    public static void roundTripArrayWithDefaultResolverFallback() {\n        EmbeddedChannel encoder = new EmbeddedChannel(new ObjectEncoder());\n        EmbeddedChannel decoder = new EmbeddedChannel(new ObjectDecoder(className -> {\n            throw new ClassNotFoundException(className);\n        }));\n        try {\n            assertThat(encoder.writeOutbound(new String[] {\"pulsar\", \"bookkeeper\"})).isTrue();\n            ByteBuf encoded = encoder.readOutbound();\n            assertThat(decoder.writeInbound(encoded)).isTrue();\n            assertThat((String[]) decoder.readInbound()).containsExactly(\"pulsar\", \"bookkeeper\");\n        } finally {\n            encoder.finishAndReleaseAll();\n            decoder.finishAndReleaseAll();\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792455073149}, {"role": "toolResult", "toolCallId": "call_F42m4T9flHFPni0UG1lMNyWW|fc_0afec38eb29cac6c016ad6b19f9ba487d1be1500afaee3ee73", "toolName": "bash", "content": [{"type": "text", "text": "7dbf53a0ba Cover additional Pulsar dynamic access paths\n02f8e4ed09 Stabilize Pulsar finalizer callback test\n"}], "isError": false, "timestamp": 1792455073150}]}
