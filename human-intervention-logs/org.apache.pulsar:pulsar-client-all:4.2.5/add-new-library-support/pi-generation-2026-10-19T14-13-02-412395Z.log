3c6caab1674c68b", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.lang.reflect.Field;\nimport java.util.List;\n\nimport org.apache.pulsar.common.util.Reflections;\nimport org.junit.jupiter.api.Test;\n\npublic class ReflectionsTest {\n    @Test\n    void createsConfiguredImplementationsByClassName() {\n        Greeter typed = Reflections.createInstance(\n                DefaultGreeter.class.getName(), Greeter.class, getClass().getClassLoader());\n        Object untyped = Reflections.createInstance(\n                UntypedValue.class.getName(), getClass().getClassLoader());\n        Object configured = Reflections.createInstance(\n                ConfiguredValue.class.getName(),\n                getClass().getClassLoader(),\n                new Object[] {\"configured\"},\n                new Class<?>[] {String.class});\n\n        assertThat(typed.greet(\"Pulsar\")).isEqualTo(\"hello Pulsar\");\n        assertThat(untyped).isInstanceOf(UntypedValue.class);\n        assertThat(((ConfiguredValue) configured).value).isEqualTo(\"configured\");\n    }\n\n    @Test\n    void inspectsClassesAndResolvesDescriptorAndArrayNames() throws Exception {\n        ClassLoader loader = getClass().getClassLoader();\n\n        assertThat(Reflections.classExists(DefaultGreeter.class.getName())).isTrue();\n        assertThat(Reflections.classImplementsIface(DefaultGreeter.class.getName(), Greeter.class)).isTrue();\n        assertThat(Reflections.loadClass(\"Ljava.lang.String;\", loader)).isEqualTo(String.class);\n        assertThat(Reflections.loadClass(\"[[java.lang.String\", loader)).isEqualTo(String[][].class);\n\n        List<Field> fields = Reflections.getAllFields(ChildFields.class);\n        assertThat(fields).extracting(Field::getName).contains(\"child\", \"parent\");\n    }\n\n    public interface Greeter {\n        String greet(String name);\n    }\n\n    public static class DefaultGreeter implements Greeter {\n        public DefaultGreeter() {\n        }\n\n        @Override\n        public String greet(String name) {\n            return \"hello \" + name;\n        }\n    }\n\n    public static class UntypedValue {\n        public UntypedValue() {\n        }\n    }\n\n    public static class ConfiguredValue {\n        private final String value;\n\n        public ConfiguredValue(String value) {\n            this.value = value;\n        }\n    }\n\n    public static class ParentFields {\n        private String parent;\n    }\n\n    public static class ChildFields extends ParentFields {\n        private String child;\n    }\n}\n"}], "isError": false, "timestamp": 1792425013260}, {"role": "toolResult", "toolCallId": "call_TaksQt7nBWfW1r3gQfBFPwyb|fc_0bf7130f74ebe3a8016ad63c3504c887d1b44ef022822ee19f", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.List;\n\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.JavaType;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.type.TypeFactory;\nimport org.junit.jupiter.api.Test;\n\npublic class TypeFactoryTest {\n    @Test\n    void resolvesCanonicalCollectionAndArrayTypes() {\n        TypeFactory factory = TypeFactory.defaultInstance();\n\n        JavaType listType = factory.constructFromCanonical(\"java.util.List<java.lang.String>\");\n        JavaType arrayType = factory.constructArrayType(String.class);\n        JavaType applicationType = factory.constructFromCanonical(Payload.class.getName());\n\n        assertThat(listType.getRawClass()).isEqualTo(List.class);\n        assertThat(listType.getContentType().getRawClass()).isEqualTo(String.class);\n        assertThat(arrayType.getRawClass()).isEqualTo(String[].class);\n        assertThat(applicationType.getRawClass()).isEqualTo(Payload.class);\n    }\n\n    public static class Payload {\n    }\n}\n"}], "isError": false, "timestamp": 1792425013260}, {"role": "toolResult", "toolCallId": "call_oOYKkdlCuqqjiNNP1hDSkfMj|fc_0bf7130f74ebe3a8016ad63c3504d487d1b26acc4b68139907", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.org.apache.commons.lang3.ArrayUtils;\nimport org.junit.jupiter.api.Test;\n\npublic class ArrayUtilsTest {\n    @Test\n    void createsGrowsAndCompactsTypedArrays() {\n        String[] inserted = ArrayUtils.add((String[]) null, 0, \"first\");\n        String[] appended = ArrayUtils.add(new String[] {\"first\"}, \"second\");\n        String[] empty = ArrayUtils.nullToEmpty(null, String[].class);\n        String[] allocated = ArrayUtils.newInstance(String.class, 2);\n        String[] removed = ArrayUtils.remove(new String[] {\"a\", \"b\", \"c\"}, 1);\n        String[] removedIndices = ArrayUtils.removeAll(new String[] {\"a\", \"b\", \"c\", \"d\"}, 1, 3);\n        String[] removedOccurrences = ArrayUtils.removeAllOccurrences(\n                new String[] {\"a\", \"b\", \"a\", \"c\"}, \"a\");\n\n        assertThat(inserted).containsExactly(\"first\");\n        assertThat(appended).containsExactly(\"first\", \"second\");\n        assertThat(empty).isInstanceOf(String[].class).isEmpty();\n        assertThat(allocated).isInstanceOf(String[].class).hasSize(2);\n        assertThat(removed).containsExactly(\"a\", \"c\");\n        assertThat(removedIndices).containsExactly(\"a\", \"c\");\n        assertThat(removedOccurrences).containsExactly(\"b\", \"c\");\n    }\n}\n"}], "isError": false, "timestamp": 1792425013260}, {"role": "toolResult", "toolCallId": "call_WLqiwF5nyxyXFJx1DCIaOSAa|fc_0bf7130f74ebe3a8016ad63c3504dc87d1841b4c9b649207bd", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.ObjectMapper;\nimport org.junit.jupiter.api.Test;\n\npublic class FieldPropertyTest {\n    @Test\n    void deserializesAndUpdatesFieldBackedProperties() throws Exception {\n        ObjectMapper mapper = new ObjectMapper();\n        FieldBean created = mapper.readValue(\"{\\\"name\\\":\\\"created\\\",\\\"count\\\":3}\", FieldBean.class);\n        FieldBean updated = new FieldBean();\n\n        mapper.readerForUpdating(updated).readValue(\"{\\\"name\\\":\\\"updated\\\",\\\"count\\\":5}\");\n\n        assertThat(created.name).isEqualTo(\"created\");\n        assertThat(created.count).isEqualTo(3);\n        assertThat(updated.name).isEqualTo(\"updated\");\n        assertThat(updated.count).isEqualTo(5);\n    }\n\n    public static class FieldBean {\n        public String name;\n        public int count;\n\n        public FieldBean() {\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792425013260}, {"role": "toolResult", "toolCallId": "call_jH2Zuj3BztqcxLKlAGZrly9b|fc_0bf7130f74ebe3a8016ad63c3504e487d1ae55abba975bc2c1", "toolName": "read", "content": 