.api.Assertions.assertThat;\n\nimport java.util.Map;\nimport org.apache.pulsar.shade.io.netty.util.Version;\nimport org.junit.jupiter.api.Test;\n\npublic class VersionTest {\n    @Test\n    void discoversBundledNettyBuildMetadata() {\n        Map<String, Version> versions = Version.identify();\n\n        assertThat(versions).isNotEmpty();\n        assertThat(versions.values())\n                .allSatisfy(version -> {\n                    assertThat(version.artifactId()).isNotBlank();\n                    assertThat(version.artifactVersion()).isNotBlank();\n                });\n    }\n}\n"}}, {"type": "toolCall", "id": "call_gD25fkRtHADjn4rCApmZX685|fc_0bf7130f74ebe3a8016ad63fa3946087d18502c27a34d05889", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/EventUtilsTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.ArrayList;\nimport java.util.List;\nimport org.apache.pulsar.shade.org.apache.commons.lang3.event.EventUtils;\nimport org.junit.jupiter.api.Test;\n\npublic class EventUtilsTest {\n    @Test\n    void bindsListenerEventsToTargetMethod() {\n        MessageSource source = new MessageSource();\n        MessageTarget target = new MessageTarget();\n        EventUtils.bindEventsToMethod(target, \"record\", source, MessageListener.class, \"received\");\n\n        source.publish(\"pulsar\");\n        source.publish(\"bookkeeper\");\n\n        assertThat(target.messages).containsExactly(\"pulsar\", \"bookkeeper\");\n    }\n\n    public interface MessageListener {\n        void received(String message);\n    }\n\n    public static class MessageSource {\n        private final List<MessageListener> listeners = new ArrayList<>();\n\n        public void addMessageListener(MessageListener listener) {\n            listeners.add(listener);\n        }\n\n        public void publish(String message) {\n            listeners.forEach(listener -> listener.received(message));\n        }\n    }\n\n    public static class MessageTarget {\n        private final List<String> messages = new ArrayList<>();\n\n        public void record(String message) {\n            messages.add(message);\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_dcMCXKpGjDzDnQnFgeiEoZ0v|fc_0bf7130f74ebe3a8016ad63fa3946887d1b9a9463477dab497", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ExceptionUtilsTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.org.apache.commons.lang3.exception.ExceptionUtils;\nimport org.junit.jupiter.api.Test;\n\n@SuppressWarnings(\"deprecation\")\npublic class ExceptionUtilsTest {\n    @Test\n    void obtainsCauseThroughConfiguredAccessorMethod() {\n        IllegalStateException cause = new IllegalStateException(\"broker unavailable\");\n        NestedFailure failure = new NestedFailure(cause);\n\n        Throwable resolved = ExceptionUtils.getCause(failure, new String[] {\"getNestedFailure\"});\n\n        assertThat(resolved).isSameAs(cause);\n    }\n\n    public static class NestedFailure extends Exception {\n        private final Throwable nestedFailure;\n\n        public NestedFailure(Throwable nestedFailure) {\n            this.nestedFailure = nestedFailure;\n        }\n\n        public Throwable getNestedFailure() {\n           