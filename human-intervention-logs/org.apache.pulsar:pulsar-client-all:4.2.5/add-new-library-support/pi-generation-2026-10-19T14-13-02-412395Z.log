ong with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.LoaderOptions;\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.Yaml;\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.constructor.CustomClassLoaderConstructor;\nimport org.junit.jupiter.api.Test;\n\npublic class CustomClassLoaderConstructorTest {\n    @Test\n    void resolvesExplicitYamlTagWithConfiguredLoader() {\n        CustomClassLoaderConstructor constructor = new CustomClassLoaderConstructor(\n                getClass().getClassLoader(), new LoaderOptions());\n        String yaml = \"!!\" + Settings.class.getName() + \" {mode: persistent}\";\n\n        Settings settings = new Yaml(constructor).load(yaml);\n\n        assertThat(settings.mode).isEqualTo(\"persistent\");\n    }\n\n    public static class Settings {\n        public String mode;\n    }\n}\n"}], "isError": false, "timestamp": 1792455255932}, {"role": "toolResult", "toolCallId": "call_BW7ZEzj0W6pzUHZZF3IPdCVQ|fc_0afec38eb29cac6c016ad6b25681b487d1a0993557b52d8b13", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.LoaderOptions;\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.Yaml;\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.constructor.Constructor;\nimport org.junit.jupiter.api.Test;\n\npublic class SnakeYamlConstructorTest {\n    @Test\n    void loadsNamedRootClass() throws Exception {\n        Constructor constructor = new Constructor(Settings.class.getName(), new LoaderOptions());\n\n        Settings settings = new Yaml(constructor).load(\"mode: persistent\\nretries: 4\");\n\n        assertThat(settings.mode).isEqualTo(\"persistent\");\n        assertThat(settings.retries).isEqualTo(4);\n    }\n\n    @Test\n    void resolvesClassNamedByExplicitYamlTag() {\n        Constructor constructor = new Constructor(new LoaderOptions());\n        String yaml = \"!!\" + Settings.class.getName() + \" {mode: shared, retries: 2}\";\n\n        Settings settings = new Yaml(constructor).load(yaml);\n\n        assertThat(settings.mode).isEqualTo(\"shared\");\n        assertThat(settings.retries).isEqualTo(2);\n    }\n\n    public static class Settings {\n        public String mode;\n        public int retries;\n    }\n}\n"}], "isError": false, "timestamp": 1792455255933}, {"role": "toolResult", "toolCallId": "call_CGV9tS9UAkIPIlhxwIKFUKrR|fc_0afec38eb29cac6c016ad6b25681c087d18f0bea40ef242a94", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.io.ByteArrayInputStream;\nimport java.io.Serializable;\nimport java.lang.reflect.InvocationHandler;\nimport java.lang.reflect.Method;\nimport java.util.ArrayList;\nimport java.util.List;\n\nimport org.apache.pulsar.shade.com.google.common.reflect.Reflection;\nimport org.apache.pulsar.shade.org.apache.commons.io.serialization.ValidatingObjectInputStream;\nimport org.apache.pulsar.shade.org.apache.commons.lang3.SerializationUtils;\nimport org.junit.jupiter.api.Test;\n\npublic class ValidatingObjectInputStreamTest {\n    @Test\n    void readsAcceptedObjectWithGenericCast() throws Exception {\n        byte[] encoded = SerializationUtils.serialize(new ArrayList<>(List.of(\"alpha\", \"beta\")));\n\n        try (ValidatingObjectInputStream input = new ValidatingObjectInputStream(\n                new ByteArrayInputStream(encoded)).accept(ArrayList.class)) {\n            List<String> restored = input.readObjectCast();\n\n            assertThat(restored).containsExactly(\"alpha\", \"beta\");\n        }\n    }\n\n    @Test\n    void validatesAndResolvesAcceptedProxyInterface() throws Exception {\n        Greeting proxy = Reflection.newProxy(Greeting.class, new GreetingHandler());\n        byte[] encoded = SerializationUtils.serialize(proxy);\n\n        try (ValidatingObjectInputStream input = new ValidatingObjectInputStream(\n                new ByteArrayInputStream(encoded)).accept(Greeting.class, GreetingHandler.class)) {\n            Greeting restored = input.readObjectCast();\n\n            assertThat(restored.greet(\"Pulsar\")).isEqualTo(\"hello Pulsar\");\n        }\n    }\n\n    public interface Greeting extends Serializable {\n        String greet(String name);\n    }\n\n    public static class GreetingHandler implements InvocationHandler, Serializable {\n        @Override\n        public Object invoke(Object proxy, Method method, Object[] arguments) {\n            return \"hello \" + arguments[0];\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792455255937}, {"role": "toolResult", "toolCallId": "call_zSu4ebbG6OTn83c7xNl9N9uY|fc_0afec38eb29cac6c016ad6b25681c887d1a3ad02bf69c0048a", "toolName": "bash", "content": [{"type": "text", "text": "ca27a0c47a Fix Pulsar nested array size assertion\n60c108af1f Fix Pulsar array coverage test compilation\n7dbf53a0ba Cover additional Pulsar dynamic access paths\n"}], "isError": false, "timestamp": 1792455255938}]}
