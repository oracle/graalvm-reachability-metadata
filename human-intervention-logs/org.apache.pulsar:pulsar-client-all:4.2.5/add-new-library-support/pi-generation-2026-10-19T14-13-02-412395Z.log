ulsar.shade.com.google.common.hash.Hashing;\nimport org.junit.jupiter.api.Test;\n\npublic class LittleEndianByteArrayInnerUnsafeByteArrayTest {\n    @Test\n    void hashesByteArraysWithTheFarmHashImplementation() {\n        HashCode first = Hashing.farmHashFingerprint64().hashBytes(\"pulsar\".getBytes(UTF_8));\n        HashCode second = Hashing.farmHashFingerprint64().hashBytes(\"bookkeeper\".getBytes(UTF_8));\n\n        assertThat(first.bits()).isEqualTo(64);\n        assertThat(first).isNotEqualTo(second);\n    }\n}\n"}}, {"type": "toolCall", "id": "call_ygeeL7Xzv1cLrKajA4EMe4WE|fc_0d0cab9a0d54d4d8016ad62883b4f487d1b045b13807d3b6cc", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/UnsignedBytesInnerLexicographicalComparatorHolderInnerUnsafeComparatorTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.Comparator;\nimport org.apache.pulsar.shade.com.google.common.primitives.UnsignedBytes;\nimport org.junit.jupiter.api.Test;\n\npublic class UnsignedBytesInnerLexicographicalComparatorHolderInnerUnsafeComparatorTest {\n    @Test\n    void comparesBytesAsUnsignedValues() {\n        Comparator<byte[]> comparator = UnsignedBytes.lexicographicalComparator();\n\n        assertThat(comparator.compare(new byte[] {(byte) 0xff}, new byte[] {1})).isPositive();\n        assertThat(comparator.compare(new byte[] {1, 2}, new byte[] {1, 3})).isNegative();\n    }\n}\n"}}, {"type": "toolCall", "id": "call_WUBJPl3HjDtUSH7TprDHAesQ|fc_0d0cab9a0d54d4d8016ad62883b4fc87d1b342b916336e7f07", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org