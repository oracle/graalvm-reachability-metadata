You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport org.junit.jupiter.api.Test;\n\npublic class OpenJdkSelfSignedCertGeneratorTest {\n    @Test\n    void generatesAUsableCertificateThroughNetty() throws Exception {\n        SelfSignedCertificateSupport.generateAndVerify();\n    }\n}\n"}], "isError": false, "timestamp": 1792453903221}, {"role": "toolResult", "toolCallId": "call_d6NgPXsVSxo4PHD1U00fNSu9|fc_0afec38eb29cac6c016ad6ad0e972887d1b770f0efb929a071", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport org.junit.jupiter.api.Test;\n\npublic class OpenJdkSelfSignedCertGeneratorAnonymous2Test {\n    @Test\n    void discoversCertificateConstructorsDuringGeneration() throws Exception {\n        SelfSignedCertificateSupport.generateAndVerify();\n    }\n}\n"}], "isError": false, "timestamp": 1792453903221}, {"role": "toolResult", "toolCallId": "call_jiLS3xs9eVHfQtP7Y93jIFEu|fc_0afec38eb29cac6c016ad6ad0e973087d1a34b06e9b51cf209", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.javax.ws.rs.client.Client;\nimport org.apache.pulsar.shade.javax.ws.rs.client.ClientBuilder;\nimport org.junit.jupiter.api.Test;\n\npublic class ClientFactoryFinderTest {\n    private static final String PROVIDER =\n            \"org.apache.pulsar.shade.org.glassfish.jersey.client.JerseyClientBuilder\";\n\n    @Test\n    void instantiatesConfiguredBuilderWithContextAndDefiningClassLoaders() {\n        String key = ClientBuilder.JAXRS_DEFAULT_CLIENT_BUILDER_PROPERTY;\n        String previous = System.getProperty(key);\n        ClassLoader previousLoader = Thread.currentThread().getContextClassLoader();\n        System.setProperty(key, PROVIDER);\n        try {\n            assertUsable(ClientBuilder.newBuilder());\n            Thread.currentThread().setContextClassLoader(null);\n            assertUsable(ClientBuilder.newBuilder());\n        } finally {\n            Thread.currentThread().setContextClassLoader(previousLoader);\n            restoreProperty(key, previous);\n        }\n    }\n\n    private static void assertUsable(ClientBuilder builder) {\n        Client client = builder.build();\n        try {\n            assertThat(client.getConfiguration().getProperties()).isNotNull();\n        } finally {\n            client.close();\n        }\n    }\n\n    private static void restoreProperty(String key, String value) {\n        if (value == null) {\n            System.clearProperty(key);\n        } else {\n            System.setProperty(key, value);\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792453903221}, {"role": "toolResult", "toolCallId": "call_1PcPqaTauSZaVa4m8YVIoPwt|fc_0afec38eb29cac6c016ad6ad0e973c87d1afc33424a576498e", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.javax.ws.rs.ext.RuntimeDelegate;\nimport org.junit.jupiter.api.Test;\n\npublic class RuntimeDelegateFactoryFinderTest {\n    private static final String PROVIDER =\n            \"org.apache.pulsar.shade.org.glassfish.jersey.internal.RuntimeDelegateImpl\";\n\n    @Test\n    void instantiatesConfiguredDelegateWithDefiningClassLoader() {\n        String key = RuntimeDelegate.JAXRS_RUNTIME_DELEGATE_PROPERTY;\n        String previous = System.getProperty(key);\n        ClassLoader previousLoader = Thread.currentThread().getContextClassLoader();\n        System.setProperty(key, PROVIDER);\n        Thread.currentThread().setContextClassLoader(null);\n        RuntimeDelegate.setInstance(null);\n        try {\n            RuntimeDelegate delegate = RuntimeDelegate.getInstance();\n\n            assertThat(delegate.createUriBuilder().path(\"topics\").build().toString())\n                    .isEqualTo(\"topics\");\n        } finally {\n            RuntimeDelegate.setInstance(null);\n            Thread.currentThread().setContextClassLoader(previousLoader);\n            if (previous == null) {\n                System.clearProperty(key);\n            } else {\n                System.setProperty(key, previous);\n            }\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792453903222}, {"role": "toolResult", "toolCallId": "call_pwbus7S1e0taOXxTnXlQjjN5|fc_0afec38eb29cac6c016ad6ad0e974487d1b90c5a134f13c951", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.javax.ws.rs.client.Client;\nimport org.apache.pulsar.shade.javax.ws.rs.client.ClientBuilder;\nimport org.junit.jupiter.api.Test;\n\npublic class ClientBuilderTest {\n    @Test\n    void discoversProviderAndBuildsClosableClient() {\n        ClientBuilder builder = ClientBuilder.newBuilder();\n        Client client = builder.build();\n        try {\n            assertThat(builder.getClass().getName()).contains(\"JerseyClientBuilder\");\n            assertThat(client.getConfiguration().isRegistered(Object.class)).isFalse();\n        } finally {\n            client.close();\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792453903222}, {"role": "toolResult", "toolCallId": "call_nJPXB3sGwGdDgR4x3pu9obl1|fc_0afec38eb29cac6c016ad6ad0e974c87d1b4f3a850970b81d4", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport java.io.ByteArrayInputStream;\nimport java.io.ByteArrayOutputStream;\nimport java.io.ObjectInputStream;\nimport java.io.ObjectOutputStream;\n\npublic final class SerializationSupport {\n    private SerializationSupport() {\n    }\n\n    public static <T> T roundTrip(T value) throws Exception {\n        ByteArrayOutputStream bytes = new ByteArrayOutputStream();\n        try (ObjectOutputStream output = new ObjectOutputStream(bytes)) {\n            output.writeObject(value);\n        }\n        try (ObjectInputStream input = new ObjectInputStream(new ByteArrayInputStream(bytes.toByteArray()))) {\n            @SuppressWarnings(\"unchecked\")\n            T restored = (T) input.readObject();\n            return restored;\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792453903222}, {"role": "toolResult", "toolCallId": "call_zhueXHLQo0Zf8hdecTxNQ7ST|fc_0afec38eb29cac6c016ad6ad0e975487d18f032d3cf589a204", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.lang.reflect.Field;\nimport java.util.List;\n\nimport org.apache.pulsar.common.util.Reflections;\nimport org.junit.jupiter.api.Test;\n\npublic class ReflectionsTest {\n    @Test\n    void createsConfiguredImplementationsByClassName() {\n        Greeter typed = Reflections.createInstance(\n                DefaultGreeter.class.getName(), Greeter.class, getClass().getClassLoader());\n        Object untyped = Reflections.createInstance(\n                UntypedValue.class.getName(), getClass().getClassLoader());\n        Object configured = Reflections.createInstance(\n                ConfiguredValue.class.getName(),\n                getClass().getClassLoader(),\n                new Object[] {\"configured\"},\n                new Class<?>[] {String.class});\n\n        assertThat(typed.greet(\"Pulsar\")).isEqualTo(\"hello Pulsar\");\n        assertThat(untyped).isInstanceOf(UntypedValue.class);\n        assertThat(((ConfiguredValue) configured).value).isEqualTo(\"configured\");\n    }\n\n    @Test\n    void inspectsClassesAndResolvesDescriptorAndArrayNames() throws Exception {\n        ClassLoader loader = getClass().getClassLoader();\n\n        assertThat(Reflections.classExists(DefaultGreeter.class.getName())).isTrue();\n        assertThat(Reflections.classImplementsIface(DefaultGreeter.class.getName(), Greeter.class)).isTrue();\n        assertThat(Reflections.loadClass(\"Ljava.lang.String;\", loader)).isEqualTo(String.class);\n        assertThat(Reflections.loadClass(\"[[java.lang.String\", loader)).isEqualTo(String[][].class);\n\n        List<Field> fields = Reflections.getAllFields(ChildFields.class);\n        assertThat(fields).extracting(Field::getName).contains(\"child\", \"parent\");\n    }\n\n    public interface Greeter {\n        String greet(String name);\n    }\n\n    public static class DefaultGreeter implements Greeter {\n        public DefaultGreeter() {\n        }\n\n        @Override\n        public String greet(String name) {\n            return \"hello \" + name;\n        }\n    }\n\n    public static class UntypedValue {\n        public UntypedValue() {\n        }\n    }\n\n    public static class ConfiguredValue {\n        private final String value;\n\n        public ConfiguredValue(String value) {\n            this.value = value;\n        }\n    }\n\n    public static class ParentFields {\n        private String parent;\n    }\n\n    public static class ChildFields extends ParentFields {\n        private String child;\n    }\n}\n"}], "isError": false, "timestamp": 1792453903222}]}
