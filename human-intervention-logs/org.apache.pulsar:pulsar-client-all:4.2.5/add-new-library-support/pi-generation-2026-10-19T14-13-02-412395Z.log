       */
      public EnumMemberValue(int type, int value, ConstPool cp) {
          super('e', cp);
          this.typeIndex = type;
          this.valueIndex = value;
      }
  
      /**
       * Constructs an enum constant value.
       * The initial value is not specified.
       */
      public EnumMemberValue(ConstPool cp) {
          super('e', cp);
          typeIndex = valueIndex = 0;
