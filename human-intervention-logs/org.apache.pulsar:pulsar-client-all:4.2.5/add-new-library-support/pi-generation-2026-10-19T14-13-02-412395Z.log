work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.it.unimi.dsi.fastutil.longs.Long2ObjectAVLTreeMap;\nimport org.junit.jupiter.api.Test;\n\npublic class Long2ObjectAVLTreeMapTest {\n    @Test\n    void roundTripPreservesSortedPrimitiveKeysAndValues() throws Exception {\n        Long2ObjectAVLTreeMap<String> input = new Long2ObjectAVLTreeMap<>();\n        input.put(30L, \"thirty\");\n        input.put(10L, \"ten\");\n        input.put(20L, \"twenty\");\n\n        Long2ObjectAVLTreeMap<String> restored = SerializationSupport.roundTrip(input);\n\n        assertThat(restored).isEqualTo(input);\n        assertThat(restored.keySet()).containsExactly(10L, 20L, 30L);\n        assertThat(restored.get(20L)).isEqualTo(\"twenty\");\n    }\n}\n"}], "isError": false, "timestamp": 1792425060609}, {"role": "toolResult", "toolCallId": "call_017O4ZqAVxgCEGvXU3H91Pdx|fc_0bf7130f74ebe3a8016ad63c64534487d1b2b8e345ec4e1e20", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.DeserializationFeature;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.ObjectMapper;\nimport org.junit.jupiter.api.Test;\n\npublic class ObjectArrayDeserializerTest {\n    @Test\n    void acceptsSingleValueAsTypedArray() throws Exception {\n        ObjectMapper mapper = new ObjectMapper();\n        mapper.enable(DeserializationFeature.ACCEPT_SINGLE_VALUE_AS_ARRAY);\n\n        String[] values = mapper.readValue(\"\\\"single\\\"\", String[].class);\n\n        assertThat(values).containsExactly(\"single\");\n        assertThat(values.getClass()).isEqualTo(String[].class);\n    }\n}\n"}], "isError": false, "timestamp": 1792425060609}, {"role": "toolResult", "toolCallId": "call_t0JYLMHCKsLP6PxYdiFMshQj|fc_0bf7130f74ebe3a8016ad63c64534c87d186d5bab11e12c793", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport com.fasterxml.jackson.annotation.JsonAlias;\nimport com.fasterxml.jackson.annotation.JsonProperty;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.introspect.JacksonAnnotationIntrospector;\nimport org.junit.jupiter.api.Test;\n\n@SuppressWarnings(\"deprecation\")\npublic class JacksonAnnotationIntrospectorTest {\n    @Test\n    void discoversEnumNamesAndAliases() {\n        JacksonAnnotationIntrospector introspector = new JacksonAnnotationIntrospector();\n        Status[] values = Status.values();\n        String[] names = {null, null};\n        String[][] aliases = new String[values.length][];\n\n        introspector.findEnumValues(Status.class, values, names);\n        introspector.findEnumAliases(Status.class, values, aliases);\n\n        assertThat(introspector.findEnumValue(Status.IN_PROGRESS)).isEqualTo(\"in-progress\");\n        assertThat(names).containsExactly(\"in-progress\", null);\n        assertThat(aliases[Status.DONE.ordinal()]).containsExactly(\"complete\", \"finished\");\n    }\n\n    private enum Status {\n        @JsonProperty(\"in-progress\")\n        IN_PROGRESS,\n        @JsonAlias({\"complete\", \"finished\"})\n        DONE\n    }\n}\n"}], "isError": false, "timestamp": 1792425060609}, {"role": "toolResult", "toolCallId": "call_PPfIHWqHaBTXmIMTrMUsVUun|fc_0bf7130f74ebe3a8016ad63c64535887d1b057d3d3c06d4d16", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.io.IOException;\n\nimport org.apache.avro.reflect.AvroEncode;\nimport org.apache.pulsar.client.schema.AvroTrustedClasses;\nimport org.apache.pulsar.shade.org.apache.avro.Protocol;\nimport org.apache.pulsar.shade.org.apache.avro.Schema;\nimport org.apache.pulsar.shade.org.apache.avro.io.Decoder;\nimport org.apache.pulsar.shade.org.apache.avro.io.Encoder;\nimport org.apache.pulsar.shade.org.apache.avro.reflect.CustomEncoding;\nimport org.apache.pulsar.shade.org.apache.avro.reflect.ReflectData;\nimport org.apache.pulsar.shade.org.apache.avro.specific.SpecificData;\nimport org.junit.jupiter.api.Test;\n\npublic class ReflectDataTest {\n    @Test\n    void derivesDefaultsFieldsProtocolsAndArrayClasses() {\n        ReflectData data = new ReflectData();\n        data.setDefaultsGenerated(true);\n\n        Schema recordSchema = data.getSchema(DefaultRecord.class);\n        Protocol protocol = data.getProtocol(EchoService.class);\n        Class<?> arrayClass = data.getClass(Schema.createArray(Schema.create(Schema.Type.STRING)));\n\n        assertThat(recordSchema.getField(\"text\").defaultVal()).isEqualTo(\"default text\");\n        assertThat(recordSchema.getField(\"count\").defaultVal()).isEqualTo(3);\n        assertThat(protocol.getMessages()).containsKey(\"echo\");\n        assertThat(arrayClass).isEqualTo(String[].class);\n    }\n\n    @Test\n    void createsAndCachesCustomFieldAndTypeEncodings() {\n        synchronized (AvroTrustedClasses.class) {\n            AvroTrustedClasses.State previousTrust = AvroTrustedClasses.snapshot();\n            AvroTrustedClasses.trustExactly(EncodedValue.class);\n            try {\n                ReflectData data = new ReflectData();\n                Schema typeSchema = data.getSchema(EncodedValue.class);\n                Schema fieldSchema = data.getSchema(EncodedRecord.class).getField(\"value\").schema();\n                Schema cacheSchema = Schema.create(Schema.Type.STRING);\n                cacheSchema.addProp(SpecificData.CLASS_PROP, EncodedValue.class.getName());\n                CustomEncoding<?> cached = data.getCustomEncoding(cacheSchema);\n\n                assertThat(typeSchema.getType()).isEqualTo(Schema.Type.STRING);\n                assertThat(fieldSchema.getType()).isEqualTo(Schema.Type.STRING);\n                assertThat(cached).isInstanceOf(ValueEncoding.class);\n            } finally {\n                AvroTrustedClasses.restore(previousTrust);\n            }\n        }\n    }\n\n    public interface EchoService {\n        String echo(String value);\n    }\n\n    public static class DefaultRecord {\n        public String text = \"default text\";\n        public int count = 3;\n\n        public DefaultRecord() {\n        }\n    }\n\n    @AvroEncode(using = ValueEncoding.class)\n    public static class EncodedValue {\n        private final String text;\n\n        public EncodedValue() {\n            this(\"empty\");\n        }\n\n        public EncodedValue(String text) {\n            this.text = text;\n        }\n    }\n\n    public static class EncodedRecord {\n        @AvroEncode(using = ValueEncoding.class)\n        public EncodedValue value = new EncodedValue(\"field\");\n\n        public EncodedRecord() {\n        }\n    }\n\n    public static class ValueEncoding extends CustomEncoding<EncodedValue> {\n        public ValueEncoding() {\n            schema = Schema.create(Schema.Type.STRING);\n        }\n\n        @Override\n        protected void write(Object datum, Encoder output) throws IOException {\n            output.writeString(((EncodedValue) datum).text);\n        }\n\n        @Override\n        protected EncodedValue read(Object reuse, Decoder input) throws IOException {\n            return new EncodedValue(input.readString().toString());\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792425060610}, {"role": "toolResult", "toolCallId": "call_TWXKhCPuCogjhomEAg3buOJo|fc_0bf7130f74ebe3a8016ad63c64536087d196e1a23ceaa8fb35", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.LoaderOptions;\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.Yaml;\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.constructor.Constructor;\nimport org.junit.jupiter.api.Test;\n\npublic class SnakeYamlConstructorTest {\n    @Test\n    void loadsNamedRootClass() throws Exception {\n        Constructor constructor = new Constructor(Settings.class.getName(), new LoaderOptions());\n\n        Settings settings = new Yaml(constructor).load(\"mode: persistent\\nretries: 4\");\n\n        assertThat(settings.mode).isEqualTo(\"persistent\");\n        assertThat(settings.retries).isEqualTo(4);\n    }\n\n    public static class Settings {\n        public String mode;\n        public int retries;\n    }\n}\n"}], "isError": false, "timestamp": 1792425060610}, {"role": "toolResult", "toolCallId": "call_8pC6Lie3xlWLyc4M8aTfrhsl|fc_0bf7130f74ebe3a8016ad63c64537087d1b03b12a7e2dcb47d", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.LoaderOptions;\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.TypeDescription;\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.Yaml;\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.constructor.Constructor;\nimport org.junit.jupiter.api.Test;\n\npublic class TypeDescriptionTest {\n    @Test\n    void createsDescribedTypeAndAppliesProperties() {\n        TypeDescription description = new TypeDescription(DescribedSettings.class);\n        Yaml yaml = new Yaml(new Constructor(description, new LoaderOptions()));\n\n        DescribedSettings settings = yaml.load(\"name: configured\");\n\n        assertThat(settings.name).isEqualTo(\"configured\");\n    }\n\n    public static class DescribedSettings {\n        public String name;\n    }\n}\n"}], "isError": false, "timestamp": 1792425060610}]}
