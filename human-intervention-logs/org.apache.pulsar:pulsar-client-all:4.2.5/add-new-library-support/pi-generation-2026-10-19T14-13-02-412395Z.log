[tool-call] delta {"path":"tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ByteBufPairTest.java","edits":[{"oldText":"        waitUntil(this::adminEndpointIsReady, Duration.ofSeconds(120), Duration.ofSeconds(1));","newText":"        waitUntil(this::standaloneNamespaceIsReady, Duration.ofSeconds(120), Duration.ofSeconds(1));"},{"oldText":"    private boolean adminEndpointIsReady() throws Exception {\n        if (!pulsar.isAlive()) {\n            throw new IllegalStateException(\"Pulsar container exited before becoming ready\");\n        }\n        java.net.http.HttpClient client = java.net.http.HttpClient.newBuilder()\n                .connectTimeout(Duration.ofSeconds(10))\n                .build();\n        HttpRequest request = HttpRequest.newBuilder()\n                .uri(URI.create(HTTP_URL + \"/admin/v2/clusters\"))\n                .timeout(Duration.ofSeconds(10))\n                .GET()\n                .build();\n        return client.send(request, HttpResponse.BodyHandlers.discarding()).statusCode() == 200;\n    }","newText":"    private boolean standaloneNamespaceIsReady() throws Exception {\n        if (!pulsar.isAlive()) {\n            throw new IllegalStateException(\"Pulsar container exited before becoming ready\");\n        }\n        java.net.http.HttpClient client = java.net.http.HttpClient.newBuilder()\n                .connectTimeout(Duration.ofSeconds(10))\n                .build();\n        HttpRequest request = HttpRequest.newBuilder()\n                .uri(URI.create(HTTP_URL + \"/admin/v2/namespaces/public\"))\n                .timeout(Duration.ofSeconds(10))\n                .GET()\n                .build();\n        HttpResponse<String> response = client.send(request, HttpResponse.BodyHandlers.ofString());\n        return response.statusCode() == 200 && response.body().contains(\"public/default\");\n    }"}]}
