  package org_apache_pulsar.pulsar_client_all;
  
  import static org.assertj.core.api.Assertions.assertThat;
  
  import java.util.concurrent.TimeUnit;
  import org.apache.pulsar.shade.javax.ws.rs.client.Client;
  import org.apache.pulsar.shade.javax.ws.rs.client.ClientBuilder;
  import org.apache.pulsar.shade.javax.ws.rs.sse.SseEventSource;
  import org.junit.jupiter.api.Test;
  
  public class SseFactoryFinderTest {
      private static final String PROVIDER =
              "org.apache.pulsar.shade.org.glassfish.jersey.media.sse.internal.JerseySseEventSource$Builder";
  
      @Test
      void instantiatesConfiguredSseBuilder() {
          String key = SseEventSource.Builder.JAXRS_DEFAULT_SSE_BUILDER_PROPERTY;
          String previous = System.getProperty(key);
          System.setProperty(key, PROVIDER);
          try (Client client = ClientBuilder.newClient();
                  SseEventSource source = SseEventSource.target(client.target("http://localhost:8080/events"))
                          .reconnectingEvery(10, TimeUnit.SECONDS)
                          .build()) {
              assertThat(source.isOpen()).isFalse();
          } finally {
              if (previous == null) {
                  System.clearProperty(key);
              } else {
                  System.setProperty(key, previous);
              }
          }
      }
  }
