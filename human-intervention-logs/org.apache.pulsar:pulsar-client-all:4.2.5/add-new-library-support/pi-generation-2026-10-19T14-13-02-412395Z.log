ype specified\");\n\n        Object a = Array.newInstance(type.getType(cl), 0);\n        return a.getClass();\n    }\n\n    /**\n     * Obtains the type of the elements.\n     *\n     * @return null if the type is not specified.\n     */\n    public MemberValue getType() {\n        return type;\n    }\n\n    /**\n     * Obtains the elements of the array.\n     */\n    public MemberValue[] getValue() {\n        return values;\n    }\n\n    /**\n     * Sets the elements of the array.\n     */\n    public void setValue(MemberValue[] elements) {\n        values = elements;\n        if (elements != null && elements.length > 0)\n            type = elements[0];\n    }\n\n    /**\n     * Obtains the string representation of this object.\n     */\n    @Override\n    public String toString() {\n        StringBuffer buf = new StringBuffer(\"{\");\n        if (values != null) {\n            for (int i = 0; i < values.length; i++) {\n                buf.append(values[i].toString());\n                if (i + 1 < values.length)\n\n[28 more lines in file. Use offset=125 to continue.]"}], "isError": false, "timestamp": 1792454027982}}
