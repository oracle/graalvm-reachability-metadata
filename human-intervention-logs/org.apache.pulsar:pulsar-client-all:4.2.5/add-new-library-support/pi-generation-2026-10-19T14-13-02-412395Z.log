asoning": 30, "totalTokens": 221652, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1792426110597, "responseId": "resp_0bf7130f74ebe3a8016ad6407f39a887d1998df93cbf03928d", "rawStopReason": "completed"}, "toolResults": [{"role": "toolResult", "toolCallId": "call_vqLMAprKdtxYqWkXFoJ6c7L6|fc_0bf7130f74ebe3a8016ad64088cd5487d184cb0d39eafd6471", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.LoaderOptions;\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.Yaml;\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.constructor.Constructor;\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.introspector.BeanAccess;\nimport org.junit.jupiter.api.Test;\n\npublic class SnakeYamlFieldPropertyTest {\n    @Test\n    void readsAndWritesFieldBackedProperty() {\n        Constructor constructor = new Constructor(FieldSettings.class, new LoaderOptions());\n        constructor.getPropertyUtils().setBeanAccess(BeanAccess.FIELD);\n\n        FieldSettings settings = new Yaml(constructor).load(\"name: field-value\");\n\n        assertThat(settings.name).isEqualTo(\"field-value\");\n        assertThat(yaml.dump(settings)).contains(\"name: field-value\");\n    }\n\n    public static class FieldSettings {\n        public String name;\n    }\n}\n"}], "isError": false, "timestamp": 1792426121209}, {"role": "toolResult", "toolCallId": "call_dgvKnHeIsuyzZCzunH4I1Uli|fc_0bf7130f74ebe3a8016ad64088cd6887d1b2c81182f3d51f82", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.LoaderOptions;\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.TypeDescription;\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.Yaml;\nimport org.apache.pulsar.shade.org.yaml.snakeyaml.constructor.Constructor;\nimport org.junit.jupiter.api.Test;\n\npublic class TypeDescriptionTest {\n    @Test\n    void createsDescribedTypeAndAppliesProperties() {\n        TypeDescription description = new TypeDescription(DescribedSettings.class);\n        Yaml yaml = new Yaml(new Constructor(description, new LoaderOptions()));\n\n        DescribedSettings settings = yaml.load(\"name: configured\");\n\n        assertThat(settings.name).isEqualTo(\"configured\");\n    }\n\n    @Test\n    void createsConfiguredImplementationClass() {\n        TypeDescription description = new TypeDescription(SettingsContract.class, Settings.class);\n        Yaml yaml = new Yaml(new Constructor(description, new LoaderOptions()));\n\n        SettingsContract settings = yaml.load(\"name: implemented\");\n\n        assertThat(settings).isInstanceOf(Settings.class);\n        assertThat(settings.getName()).isEqualTo(\"implemented\");\n    }\n\n    public static class DescribedSettings {\n        public String name;\n    }\n\n    public abstract static class SettingsContract {\n        public String name;\n\n        public String getName() {\n            return name;\n        }\n    }\n\n    public static class Settings extends SettingsContract {\n    }\n}\n"}], "isError": false, "timestamp": 1792426121210}, {"role": "toolResult", "toolCallId": "call_8Xer9xLBvyDBTNQ7KIo44Ai8|fc_0bf7130f74ebe3a8016ad64088cd7487d19d93fb1803fc88d2", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.it.unimi.dsi.fastutil.objects.ObjectBigArrays;\nimport org.junit.jupiter.api.Test;\n\npublic class ObjectBigArraysTest {\n    @Test\n    void allocatesTypedBigArraysFromClassAndPrototype() {\n        String[][] fromClass = (String[][]) ObjectBigArrays.newBigArray(String[].class, 3);\n        String[][] fromPrototype = ObjectBigArrays.newBigArray(new String[0][], 2);\n        ObjectBigArrays.set(fromClass, 1, \"pulsar\");\n        ObjectBigArrays.set(fromPrototype, 0, \"bookkeeper\");\n\n        assertThat(fromClass).isInstanceOf(String[][].class);\n        assertThat(ObjectBigArrays.get(fromClass, 1)).isEqualTo(\"pulsar\");\n        assertThat(ObjectBigArrays.get(fromPrototype, 0)).isEqualTo(\"bookkeeper\");\n    }\n}\n"}], "isError": false, "timestamp": 1792426121210}, {"role": "toolResult", "toolCallId": "call_Nuq3qHoCoqE00xooZG0XuC7h|fc_0bf7130f74ebe3a8016ad64088cd7c87d1982b6ed2e1053f08", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.javax.ws.rs.client.Client;\nimport org.apache.pulsar.shade.javax.ws.rs.client.ClientBuilder;\nimport org.junit.jupiter.api.Test;\n\npublic class ClientFactoryFinderTest {\n    private static final String PROVIDER =\n            \"org.apache.pulsar.shade.org.glassfish.jersey.client.JerseyClientBuilder\";\n\n    @Test\n    void instantiatesConfiguredBuilderWithContextAndDefiningClassLoaders() {\n        String key = ClientBuilder.JAXRS_DEFAULT_CLIENT_BUILDER_PROPERTY;\n        String previous = System.getProperty(key);\n        ClassLoader previousLoader = Thread.currentThread().getContextClassLoader();\n        System.setProperty(key, PROVIDER);\n        try {\n            assertUsable(ClientBuilder.newBuilder());\n            Thread.currentThread().setContextClassLoader(null);\n            assertUsable(ClientBuilder.newBuilder());\n        } finally {\n            Thread.currentThread().setContextClassLoader(previousLoader);\n            restoreProperty(key, previous);\n        }\n    }\n\n    private static void assertUsable(ClientBuilder builder) {\n        try (Client client = builder.build()) {\n            assertThat(client.getConfiguration().getProperties()).isNotNull();\n        }\n    }\n\n    private static void restoreProperty(String key, String value) {\n        if (value == null) {\n            System.clearProperty(key);\n        } else {\n            System.setProperty(key, value);\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792426121210}, {"role": "toolResult", "toolCallId": "call_q5qAkSO4sSOOFH84BKPr1il6|fc_0bf7130f74ebe3a8016ad64088cd8887d1ba227d36b0dc14c7", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.concurrent.TimeUnit;\nimport org.apache.pulsar.shade.javax.ws.rs.client.Client;\nimport org.apache.pulsar.shade.javax.ws.rs.client.ClientBuilder;\nimport org.apache.pulsar.shade.javax.ws.rs.sse.SseEventSource;\nimport org.junit.jupiter.api.Test;\n\npublic class SseFactoryFinderTest {\n    private static final String PROVIDER =\n            \"org.apache.pulsar.shade.org.glassfish.jersey.media.sse.internal.JerseySseEventSource$Builder\";\n\n    @Test\n    void instantiatesConfiguredSseBuilder() {\n        String key = SseEventSource.Builder.JAXRS_DEFAULT_SSE_BUILDER_PROPERTY;\n        String previous = System.getProperty(key);\n        System.setProperty(key, PROVIDER);\n        try (Client client = ClientBuilder.newClient();\n                SseEventSource source = SseEventSource.target(client.target(\"http://localhost:8080/events\"))\n                        .reconnectingEvery(10, TimeUnit.SECONDS)\n                        .build()) {\n            assertThat(source.isOpen()).isFalse();\n        } finally {\n            if (previous == null) {\n                System.clearProperty(key);\n            } else {\n                System.setProperty(key, previous);\n            }\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792426121210}]}
