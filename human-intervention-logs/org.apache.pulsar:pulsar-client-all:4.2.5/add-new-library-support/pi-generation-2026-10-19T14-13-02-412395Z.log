g.apache.avro.io.EncoderFactory;\nimport org.apache.pulsar.shade.org.apache.avro.reflect.ReflectData;", "newText": "import org.apache.pulsar.shade.org.apache.avro.io.Decoder;\nimport org.apache.pulsar.shade.org.apache.avro.io.DecoderFactory;\nimport org.apache.pulsar.shade.org.apache.avro.io.Encoder;\nimport org.apache.pulsar.shade.org.apache.avro.io.EncoderFactory;\nimport org.apache.pulsar.shade.org.apache.avro.reflect.CustomEncoding;\nimport org.apache.pulsar.shade.org.apache.avro.reflect.ReflectData;"}, {"oldText": "        assertThat(restored.labels).isInstanceOf(String[].class).containsExactly(\"pulsar\", \"bookkeeper\");\n    }\n\n    public static class TopicRecord {", "newText": "        assertThat(restored.labels).isInstanceOf(String[].class).containsExactly(\"pulsar\", \"bookkeeper\");\n    }\n\n    public static void roundTripCustomEncoding() throws Exception {\n        ReflectData reflectData = new ReflectData();\n        Schema schema = reflectData.getSchema(CustomRecord.class);\n        CustomRecord input = new CustomRecord(new EncodedValue(\"persistent\"));\n        ByteArrayOutputStream bytes = new ByteArrayOutputStream();\n        BinaryEncoder encoder = EncoderFactory.get().binaryEncoder(bytes, null);\n        new ReflectDatumWriter<CustomRecord>(schema, reflectData).write(input, encoder);\n        encoder.flush();\n\n        ReflectDatumReader<CustomRecord> reader = new ReflectDatumReader<>(schema, schema, reflectData);\n        CustomRecord restored =\n                reader.read(null, DecoderFactory.get().binaryDecoder(bytes.toByteArray(), null));\n\n        assertThat(restored.value.text).isEqualTo(\"persistent\");\n    }\n\n    public static class TopicRecord {"}, {"oldText": "    public static class TopicRecord {\n        public String name;\n        public String[] labels;\n\n        public TopicRecord() {\n        }\n\n        public TopicRecord(String name, String[] labels) {\n            this.name = name;\n            this.labels = labels;\n        }\n    }\n}", "newText": "    public static class TopicRecord {\n        public String name;\n        public String[] labels;\n\n        public TopicRecord() {\n        }\n\n        public TopicRecord(String name, String[] labels) {\n            this.name = name;\n            this.labels = labels;\n        }\n    }\n\n    public static class CustomRecord {\n        @AvroEncode(using = ValueEncoding.class)\n        public EncodedValue value;\n\n        public CustomRecord() {\n        }\n\n        public CustomRecord(EncodedValue value) {\n            this.value = value;\n        }\n    }\n\n    public static class EncodedValue {\n        private final String text;\n\n        public EncodedValue() {\n            this(\"\");\n        }\n\n        public EncodedValue(String text) {\n            this.text = text;\n        }\n    }\n\n    public static class ValueEncoding extends CustomEncoding<EncodedValue> {\n        public ValueEncoding() {\n            schema = Schema.create(Schema.Type.STRING);\n        }\n\n        @Override\n        protected void write(Object datum, Encoder output) throws IOException {\n            output.writeString(((EncodedValue) datum).text);\n        }\n\n        @Override\n        protected EncodedValue read(Object reuse, Decoder input) throws IOException {\n            return new EncodedValue(input.readString().toString());\n        }\n    }\n}"}]}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-sol", "usage": {"input": 1265, "output": 1330, "cacheRead": 231936, "cacheWrite": 0, "reasoning": 378, "totalTokens": 234531, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1792426275340, "responseId": "resp_0bf7130f74ebe3a8016ad64123f31487d1a8547653c2a7702a", "rawStopReason": "completed"}, "toolResults": [{"role": "toolResult", "toolCallId": "call_0TL7byOWv0l0l7nJsqT6pgaU|fc_0bf7130f74ebe3a8016ad6412d26a087d18f43ba1dd6a0da59", "too