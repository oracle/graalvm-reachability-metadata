n    void createsGrowsAndCompactsTypedArrays() {\n        String[] inserted = ArrayUtils.add((String[]) null, 0, \"first\");\n        String[] appended = ArrayUtils.add(new String[] {\"first\"}, \"second\");\n        String[] empty = ArrayUtils.nullToEmpty(null, String[].class);\n        String[] allocated = ArrayUtils.newInstance(String.class, 2);\n        String[] removed = ArrayUtils.remove(new String[] {\"a\", \"b\", \"c\"}, 1);\n        String[] removedIndices = ArrayUtils.removeAll(new String[] {\"a\", \"b\", \"c\", \"d\"}, 1, 3);\n        String[] removedOccurrences = ArrayUtils.removeAllOccurrences(\n                new String[] {\"a\", \"b\", \"a\", \"c\"}, \"a\");\n\n        assertThat(inserted).containsExactly(\"first\");\n        assertThat(appended).containsExactly(\"first\", \"second\");\n        assertThat(empty).isInstanceOf(String[].class).isEmpty();\n        assertThat(allocated).isInstanceOf(String[].class).hasSize(2);\n        assertThat(removed).containsExactly(\"a\", \"c\");\n        assertThat(removedIndices).containsExactly(\"a\", \"c\");\n        assertThat(removedOccurrences).containsExactly(\"b\", \"c\");\n    }\n}\n"}], "isError": false, "timestamp": 1792419311288}, {"role": "toolResult", "toolCallId": "call_0m4CZ0RI1En31izBLnXUG1I0|fc_0d0cab9a0d54d4d8016ad625eef7b087d1af1b1c3819d1411c", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static java.util.Comparator.reverseOrder;\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.google.common.collect.TreeMultimap;\nimport org.junit.jupiter.api.Test;\n\npublic class TreeMultimapTest {\n    @Test\n    void roundTripPreservesComparatorsKeysAndValues() throws Exception {\n        TreeMultimap<String, String> input = TreeMultimap.create(reverseOrder(), reverseOrder());\n        input.put(\"letters\", \"a\");\n        input.put(\"letters\", \"c\");\n        input.put(\"letters\", \"b\");\n        input.put(\"numbers\", \"one\");\n\n        TreeMultimap<String, String> restored = SerializationSupport.roundTrip(input);\n\n        assertThat(restored).isEqualTo(input);\n        assertThat(restored.keySet()).containsExactly(\"numbers\", \"letters\");\n        assertThat(restored.get(\"letters\")).containsExactly(\"c\", \"b\", \"a\");\n        restored.put(\"greek\", \"omega\");\n        assertThat(restored.keySet()).containsExactly(\"numbers\", \"letters\", \"greek\");\n    }\n}\n"}], "isError": false, "timestamp": 1792419311288}, {"role": "toolResult", "toolCallId": "call_3GFQhuzS8tsWdlmEqNG9NohC|fc_0d0cab9a0d54d4d8016ad625eef7bc87d180f433a2f3edcb42", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.List;\n\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.JavaType;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.databind.type.TypeFactory;\nimport org.junit.jupiter.api.Test;\n\npublic class TypeFactoryTest {\n    @Test\n    void resolvesCanonicalCollectionAndArrayTypes() {\n        TypeFactory factory = TypeFactory.defaultInstance();\n\n        JavaType listType = factory.constructFromCanonical(\"java.util.List<java.lang.String>\");\n        JavaType arrayType = factory.constructArrayType(String.class);\n        JavaType applicationType = factory.constructFromCanonical(Payload.class.getName());\n\n        assertThat(listType.getRawClass()).isEqualTo(List.class);\n        assertThat(listType.