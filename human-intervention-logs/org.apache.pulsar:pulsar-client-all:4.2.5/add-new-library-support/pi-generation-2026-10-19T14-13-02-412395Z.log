\nimport java.util.function.BiConsumer;\nimport java.util.function.BiFunction;\nimport java.util.function.Consumer;\nimport org.jspecify.annotations.Nullable;\n\n/**\n * CompactHashMap is an implementation of a Map. All optional operations (put and remove) are\n * supported. Null keys and values are supported.\n *\n * <p>{@code containsKey(k)}, {@code put(k, v)} and {@code remove(k)} are all (expected and\n * amortized) constant time operations. Expected in the hashtable sense (depends on the hash\n * function doing a good job of distributing the elements to the buckets to a distribution not far\n * from uniform), and amortized since some operations can trigger a hash table resize.\n *\n * <p>Unlike {@code java.util.HashMap}, iteration is only proportional to the actual {@code size()},\n * which is optimal, and <i>not</i> the size of the internal hashtable, which could be much larger\n * than {@code size()}. Furthermore, this structure places significantly reduced load on the garbage\n * collector by only using a constant number of internal objects.\n *\n * <p>If there are no removals, then iteration order for the {@link #entrySet()}, {@link #keySet()},\n * and {@link #values()} views is the same as insertion order. Any removal invalidates any ordering\n * guarantees.\n *\n * <p>This class should not be assumed to be universally superior to {@code java.util.HashMap}.\n * Generally speaking, this class reduces object allocation and memory consumption at the price of\n * moderately increased constant factors of CPU. Only use this class when there is a specific reason\n * to prioritize memory over CPU.\n *\n * @author Louis Wasserman\n * @author Jon Noack\n */\n@GwtIncompatible // not worth using in GWT for now\nclass CompactHashMap<K extends @Nullable Object, V extends @Nullable Object>\n    implements Map<K, V>, Serializable {\n  /*\n   * TODO: Make this a drop-in replacement for j.u. versions, actually drop them in, and test the\n   * world. Figure out what sort of space-time tradeoff we're actually going to get here with the\n   * *Map variants. This class is particularly hard to benchmark, because the benefit is not only in\n\n[1117 more lines in file. Use offset=90 to continue.]"}], "isError": false, "timestamp": 1792419412209}, {"role": "toolResult", "toolCallId": "call_LQeI7xixZ3qJ2y2oBaj6Nn0d|fc_0d0cab9a0d54d4d8016ad62653d89487d1906e8a45d94d7017", "toolName": "bash", "content": [{"type": "text", "text": "(no output)"}], "isError": false, "timestamp": 1792419412210}, {"role": "toolResult", "toolCallId": "call_9iOaAxNHH0knkAQb0bI0G9CQ|fc_0d0cab9a0d54d4d8016ad62653d8a087d19cb260a60ab51697", "toolName": "bash", "content": [{"type": "text", "text": "/home/mihailo/git/graalvm-reachability-metadata/forge/local_repositories/source_context/org.apache.pulsar/pulsar-client-all/4.2.5/main/extracted/org/apache/pulsar/client/impl/schema/AutoConsumeSchema.java:35:import org.apache.pulsar.client.api.schema.SchemaDefinition;\n/home/mihailo/git/graalvm-reachability-metadata/forge/local_repositories/source_context/org.apache.pulsar/pulsar-client-all/4.2.5/main/extracted/org/apache/pulsar/client/impl/schema/AutoConsumeSchema.java:172:                    componentName, topicName, schemaInfo.getSchemaDefinition());\n/home/mihailo/git/graalvm-reachability-metadata/forge/local_repositories/source_context/org.apache.pulsar/pulsar-client-all/4.2.5/main/extracted/org/apache/pulsar/client/impl/schema/AutoConsumeSchema.java:214:                return Schema.JSON(SchemaDefinition.builder()\n/home/mihailo/git/graalvm-reachability-metadata/forge/local_repositories/source_context/org.apache.pulsar/pulsar-client-all/4.2.5/main/extracted/org/apache/pulsar/client/impl/schema/AutoConsumeSchema.java:217:                return Schema.AVRO(SchemaDefinition.builder()\n/home/mihailo/git/graalvm-reachability-metadata/forge/local_repositories/source_context/org.apache.pulsar/pulsar-client-all/4.2.5/main/extracted/org/apache/pulsar/client/impl/schema/AutoConsumeSch