ry.NativeMemory;\nimport org.apache.pulsar.shade.com.yahoo.sketches.tuple.DoubleSummary;\nimport org.apache.pulsar.shade.com.yahoo.sketches.tuple.Sketch;\nimport org.apache.pulsar.shade.com.yahoo.sketches.tuple.Sketches;\nimport org.junit.jupiter.api.Test;\n\npublic class SerializerDeserializerTest {\n    @Test\n    void roundTripsTupleSketchFactoriesAndSummaries() {\n        byte[] serialized = TupleSketchSupport.sketch(\"one\", \"two\", \"three\").toByteArray();\n\n        Sketch<DoubleSummary> restored = Sketches.heapifySketch(new NativeMemory(serialized));\n\n        assertThat(restored.getRetainedEntries()).isEqualTo(3);\n        assertThat(restored.getSummaries()).isInstanceOf(DoubleSummary[].class).hasSize(3);\n    }\n}\n"}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-sol", "usage": {"input": 947, "output": 810, "cacheRead": 218496, "cacheWrite": 0, "reasoning": 159, "totalTokens": 220253, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1792420450361, "responseId": "resp_0d0cab9a0d54d4d8016ad62a63288087d19b019badd2ddb38e", "rawStopReason": "completed"}, "toolResults": [{"role": "toolResult", "toolCallId": "call_QhVpPaVS0VnOMMbnAWMZjP0M|fc_0d0cab9a0d54d4d8016ad62a753d6087d1ba00fa77fefeb645", "toolName": "write", "content": [{"type": "text", "text": "Successfully wrote 852 bytes to tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ReversePurgeItemHashMapTest.java"}], "isError": false, "timestamp": 1792420469536}, {"role": "toolResult", "toolCallId": "call_JoM9175kxG2fHAXM0TMG1n6y|fc_0d0cab9a0d54d4d8016ad62a753d7c87d1876013e1666ef40f", "toolName": "write", "content": [{"type": "text", "text": "Successfully wrote 1068 bytes to tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/SerializerDeserializerTest.java"}], "isError": false, "timestamp": 1792420469537