-all-test\";\n    private static final String HTTP_URL = \"http://localhost:8080\";\n    private static final String SERVICE_URL = \"pulsar://localhost:6650\";\n    private static final String TOPIC = \"persistent://public/default/reachability-metadata\";\n\n    private Process pulsar;\n\n    @BeforeAll\n    void startPulsar() throws Exception {\n        removeExistingContainer();\n        pulsar = new ProcessBuilder(\n                        \"docker\",\n                        \"run\",\n                        \"--rm\",\n                        \"--name\",\n                        CONTAINER_NAME,\n                        \"-p\",\n                        \"6650:6650\",\n                        \"-p\",\n                        \"8080:8080\",\n                        \"apachepulsar/pulsar:4.2.5\",\n                        \"bin/pulsar\",\n                        \"standalone\",\n                        \"--no-functions-worker\",\n                        \"-nss\")\n                .inheritIO()\n                .start();\n\n        waitUntil(this::adminEndpointIsReady, Duration.ofSeconds(120), Duration.ofSeconds(1));\n    }\n\n    @AfterAll\n    void stopPulsar() throws Exception {\n        if (pulsar != null && pulsar.isAlive()) {\n            pulsar.destroy();\n            if (!pulsar.waitFor(10, TimeUnit.SECONDS)) {\n                pulsar.destroyForcibly();\n                pulsar.waitFor(10, TimeUnit.SECONDS);\n            }\n        }\n        removeExistingContainer();\n    }\n\n    @Test\n    void publishesAndConsumesThroughTheBinaryProtocol() throws Exception {\n        try (PulsarAdmin admin = PulsarAdmin.builder()\n                        .serviceHttpUrl(HTTP_URL)\n                        .connectionTimeout(10, TimeUnit.SECONDS)\n                        .readTimeout(30, TimeUnit.SECONDS)\n                        .build();\n                PulsarClient client = PulsarClient.builder()\n                        .serviceUrl(SERVICE_URL)\n                        .connectionTimeout(10, TimeUnit.SECONDS)\n                        .operationTimeout(30, TimeUnit.SECONDS)\n                        .build();\n                Consumer<String> consumer = client.newConsumer(Schema.STRING)\n                        .topic(TOPIC)\n                        .subscriptionName(\"reachability-metadata-subscription\")\n                        .subscribe();\n                Producer<String> producer = client.newProducer(Schema.STRING).topic(TOPIC).create()) {\n            assertThat(admin.clusters().getClusters()).contains(\"standalone\");\n\n            producer.newMessage()\n                    .key(\"integration-key\")\n                    .property(\"source\", \"native-image-test\")\n                    .value(\"pulsar-message\")\n                    .send();\n            Message<String> message = consumer.receive(30, TimeUnit.SECONDS);\n\n            assertThat(message).isNotNull();\n            assertThat(message.getValue()).isEqualTo(\"pulsar-message\");\n            assertThat(message.getKey()).isEqualTo(\"integration-key\");\n            assertThat(message.getProperty(\"source\")).isEqualTo(\"native-image-test\");\n            consumer.acknowledge(message);\n            assertThat(admin.topics().getStats(TOPIC).getSubscriptions())\n                    .containsKey(\"reachability-metadata-subscription\");\n        }\n    }\n\n    private boolean adminEndpointIsReady() throws Exception {\n        if (!pulsar.isAlive()) {\n            throw new IllegalStateException(\"Pulsar container exited before becoming ready\");\n        }\n        java.net.http.HttpClient client = java.net.http.HttpClient.newBuilder()\n                .connectTimeout(Duration.ofSeconds(10))\n                .build();\n        HttpRequest request = HttpRequest.newBuilder()\n                .uri(URI.create(HTTP_URL + \"/admin/v2/clusters\"))\n                .timeout(Duration.ofSeconds(10))\n                .GET()\n                .build();\n        return client.send(request, HttpResponse.BodyHandlers.discarding()).statusCode() == 200;\n    }\n\n    private static void removeExistingContainer() throws Exception {\n        Process process = new ProcessBuilder(\"docker\", \"rm\", \"-f\", CONTAINER_NAME)\n                .redirectErrorStream(true)\n                .start();\n        if (!process.waitFor(10, TimeUnit.SECONDS)) {\n            process.destroyForcibly();\n            process.waitFor(10, TimeUnit.SECONDS);\n        }\n    }\n\n    private static void waitUntil(\n            Callable<Boolean> condition, Duration timeout, Duration sleepTime) throws Exception {\n        Exception lastException = null;\n        long deadline = System.nanoTime() + timeout.toNanos();\n        while (System.nanoTime() < deadline) {\n            try {\n                if (condition.call()) {\n                    return;\n                }\n            } catch (Exception e) {\n                lastException = e;\n            }\n            Thread.sleep(sleepTime.toMillis());\n        }\n        throw new IllegalStateException(\"Pulsar was not ready within \" + timeout, lastException);\n    }\n}\n"}}, {"type": "toolCall", "id": "call_5KYWWPDEODEvSBQgTd3U7ATI|fc_0d0cab9a0d54d4d8016ad6271b4cb887d1811f10edc8b829fe", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/HttpClientTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.client.api.PulsarClient;\nimport org.junit.jupiter.api.Test;\n\npublic class HttpClientTest {\n    @Test\n    void initializesTheConfiguredTlsFactoryForHttpsLookup() throws Exception {\n        try (PulsarClient client = PulsarClient.builder()\n                .serviceUrl(\"https://localhost:8443\")\n                .allowTlsInsecureConnection(true)\n                .build()) {\n            assertThat(client).isNotNull();\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_TmHlsTSwKmOYY5OQWuR8f1NB|fc_0d0cab9a0d54d4d8016ad6271b4ccc87d198ef0d7918ffc77b", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/AsyncHttpConnectorTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.client.admin.PulsarAdmin;\nimport org.junit.jupiter.api.Test;\n\npublic class AsyncHttpConnectorTest {\n    @Test\n    void initializesTheConfiguredTlsFactoryForAdminRequests() throws Exception {\n        try (PulsarAdmin admin = PulsarAdmin.builder()\n                .serviceHttpUrl(\"https://localhost:8443\")\n                .allowTlsInsecureConnection(true)\n                .build()) {\n            assertThat(admin).isNotNull();\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_ABxKnEacX84TicBv7N7r6KWh|fc_0d0cab9a0d54d4d8016ad6271b4cd887d19744fad1a7afbd27", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/SchemaUtilTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.client.api.Schema;\nimport org.junit.jupiter.api.Test;\n\npublic class SchemaUtilTest {\n    @Test\n    void derivesAnAvroSchemaAndRoundTripsAPojo() {\n        Schema<Account> schema = Schema.AVRO(Account.class);\n        Account input = new Account(\"Ada\", 7);\n\n        Account restored = schema.decode(schema.encode(input));\n\n        assertThat(restored.name).isEqualTo(\"Ada\");\n        assertThat(restored.level).isEqualTo(7);\n        assertThat(schema.getSchemaInfo().getSchemaDefinition()).contains(\"Account\", \"name\", \"level\");\n    }\n\n    public static class Account {\n        public String name;\n        public int level;\n\n        public Account() {\n        }\n\n        Account(String name, int level) {\n            this.name = name;\n            this.level = level;\n        }\n    }\n}\n"}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-sol", "usage": {"input": 2674, "output": 2507, "cacheRead": 164352, "cacheWrite": 0, "reasoning": 182, "totalTokens": 169533, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1792419552540, "responseId": "resp_0d0cab9a0d54d4d8016ad626e1226887d1b7085f5029529896", "rawStopReason": "completed"}}
[tool-exec] start id=call_iiHzstwKAYvRkCXMSWaUsC49|fc_0d0cab9a0d54d4d8016ad6271b4c9887d1aa31a10a8c9552af name=write args={"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/ByteBufPairTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.net.URI;\nimport java.net.http.HttpRequest;\nimport java.net.http.HttpResponse;\nimport java.time.Duration;\nimport java.util.concurrent.Callable;\nimport java.util.concurrent.TimeUnit;\nimport org.apache.pulsar.client.admin.PulsarAdmin;\nimport org.apache.pulsar.client.api.Consumer;\nimport org.apache.pulsar.client.api.Message;\nimport org.apache.pulsar.client.api.Producer;\nimport org.apache.pulsar.client.api.PulsarClient;\nimport org.apache.pulsar.client.api.Schema;\nimport org.junit.jupiter.api.AfterAll;\nimport org.junit.jupiter.api.BeforeAll;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.TestInstance;\n\n@TestInstance(TestInstance.Lifecycle.PER_CLASS)\npublic class ByteBufPairTest {\n    private static final String CONTAINER_NAME = \"graalvm-pulsar-client-all-test\";\n    private static final String HTTP_URL = \"http://localhost:8080\";\n    private static final String SERVICE_URL = \"pulsar://localhost:6650\";\n    private static final String TOPIC = \"persistent://public/default/reachability-metadata\";\n\n    private Process pulsar;\n\n    @BeforeAll\n    void startPulsar() throws Exception {\n        removeExistingContainer();\n        pulsar = new ProcessBuilder(\n                        \"docker\",\n                        \"run\",\n                        \"--rm\",\n                        \"--name\",\n                        CONTAINER_NAME,\n                        \"-p\",\n                        \"6650:6650\",\n                        \"-p\",\n                        \"8080:8080\",\n                        \"apachepulsar/pulsar:4.2.5\",\n                        \"bin/pulsar\",\n                        \"standalone\",\n                        \"--no-functions-worker\",\n                        \"-nss\")\n                .inheritIO()\n                .start();\n\n        waitUntil(this::adminEndpointIsReady, Duration.ofSeconds(120), Duration.ofSeconds(1));\n    }\n\n    @AfterAll\n    void stopPulsar() throws Exception {\n        if (pulsar != null && pulsar.isAlive()) {\n            pulsar.destroy();\n            if (!pulsar.waitFor(10, TimeUnit.SECONDS)) {\n                pulsar.destroyForcibly();\n                pulsar.waitFor(10, TimeUnit.SECONDS);\n            }\n        }\n        removeExistingContainer();\n    }\n\n    @Test\n    void publishesAndConsumesThroughTheBinaryProtocol() throws Exception {\n        try (PulsarAdmin admin = PulsarAdmin.builder()\n                        .serviceHttpUrl(HTTP_URL)\n                        .connectionTimeout(10, TimeUnit.SECONDS)\n                        .readTimeout(30, TimeUnit.SECONDS)\n                        .build();\n                PulsarClient client = PulsarClient.builder()\n                        .serviceUrl(SERVICE_URL)\n                        .connectionTimeout(10, TimeUnit.SECONDS)\n                        .operationTimeout(30, TimeUnit.SECONDS)\n                        .build();\n                Consumer<String> consumer = client.newConsumer(Schema.STRING)\n                        .topic(TOPIC)\n                        .subscriptionName(\"reachability-metadata-subscription\")\n                        .subscribe();\n                Producer<String> producer = client.newProducer(Schema.STRING).topic(TOPIC).create()) {\n            assertThat(admin.clusters().getClusters()).contains(\"standalone\");\n\n            producer.newMessage()\n                    .key(\"integration-key\")\n                    .property(\"source\", \"native-image-test\")\n                    .value(\"pulsar-message\")\n                    .send();\n            Message<String> message = consumer.receive(30, TimeUnit.SECONDS);\n\n            assertThat(message).isNotNull();\n            assertThat(message.getValue()).isEqualTo(\"pulsar-message\");\n            assertThat(message.getKey()).isEqualTo(\"integration-key\");\n            assertThat(message.getProperty(\"source\")).isEqualTo(\"native-image-test\");\n            consumer.acknowledge(message);\n            assertThat(admin.topics().getStats(TOPIC).getSubscriptions())\n                    .containsKey(\"reachability-metadata-subscription\");\n        }\n    }\n\n    private boolean adminEndpointIsReady() throws Exception {\n        if (!pulsar.isAlive()) {\n            throw new IllegalStateException(\"Pulsar container exited before becoming ready\");\n        }\n        java.net.http.HttpClient client = java.net.http.HttpClient.newBuilder()\n                .connectTimeout(Duration.ofSeconds(10))\n                .build();\n        HttpRequest request = HttpRequest.newBuilder()\n                .uri(URI.create(HTTP_URL + \"/admin/v2/clusters\"))\n                .timeout(Duration.ofSeconds(10))\n                .GET()\n                .build();\n        return client.send(request, HttpResponse.BodyHandlers.discarding()).statusCode() == 200;\n    }\n\n    private static void removeExistingContainer() throws Exception {\n        Process process = new ProcessBuilder(\"docker\", \"rm\", \"-f\", CONTAINER_NAME)\n                .redirectErrorStream(true)\n                .start();\n        if (!process.waitFor(10, TimeUnit.SECONDS)) {\n            process.destroyForcibly();\n            process.waitFor(10, TimeUnit.SECONDS);\n        }\n    }\n\n    private static void waitUntil(\n            Callable<Boolean> condition, Duration timeout, Duration sleepTime) throws Exception {\n        Exception lastException = null;\n        long deadline = System.nanoTime() + timeout.toNanos();\n        while (System.nanoTime() < deadline) {\n            try {\n                if (condition.call()) {\n                    return;\n                }\n            } catch (Exception e) {\n                lastException = e;\n            }\n            Thread.sleep(sleepTime.toMillis());\n        }\n        throw new IllegalStateException(\"Pulsar was not ready within \" + timeout, lastException);\n    }\n}\n"}
[tool-exec] start id=call_5KYWWPDEODEvSBQgTd3U7ATI|fc_0d0cab9a0d54d4d8016ad6271b4cb887d1811f10edc8b829fe name=write args={"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/HttpClientTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.client.api.PulsarClient;\nimport org.junit.jupiter.api.Test;\n\npublic class HttpClientTest {\n    @Test\n    void initializesTheConfiguredTlsFactoryForHttpsLookup() throws Exception {\n        try (PulsarClient client = PulsarClient.builder()\n                .serviceUrl(\"https://localhost:8443\")\n                .allowTlsInsecureConnection(true)\n                .build()) {\n            assertThat(client).isNotNull();\n        }\n    }\n}\n"}
[tool-exec] start id=call_TmHlsTSwKmOYY5OQWuR8f1NB|fc_0d0cab9a0d54d4d8016ad6271b4ccc87d198ef0d7918ffc77b name=write args={"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/AsyncHttpConnectorTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.client.admin.PulsarAdmin;\nimport org.junit.jupiter.api.Test;\n\npublic class AsyncHttpConnectorTest {\n    @Test\n    void initializesTheConfiguredTlsFactoryForAdminRequests() throws Exception {\n        try (PulsarAdmin admin = PulsarAdmin.builder()\n                .serviceHttpUrl(\"https://localhost:8443\")\n                .allowTlsInsecureConnection(true)\n                .build()) {\n            assertThat(admin).isNotNull();\n        }\n    }\n}\n"}
[tool-exec] start id=call_ABxKnEacX84TicBv7N7r6KWh|fc_0d0cab9a0d54d4d8016ad6271b4cd887d19744fad1a7afbd27 name=write args={"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/SchemaUtilTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.client.api.Schema;\nimport org.junit.jupiter.api.Test;\n\npublic class SchemaUtilTest {\n    @Test\n    void derivesAnAvroSchemaAndRoundTripsAPojo() {\n        Schema<Account> schema = Schema.AVRO(Account.class);\n        Account input = new Account(\"Ada\", 7);\n\n        Account restored = schema.decode(schema.encode(input));\n\n        assertThat(restored.name).isEqualTo(\"Ada\");\n        assertThat(restored.level).isEqualTo(7);\n        assertThat(schema.getSchemaInfo().getSchemaDefinition()).contains(\"Account\", \"name\", \"level\");\n    }\n\n    public static class Account {\n        public String name;\n        public int level;\n\n        public Account() {\n        }\n\n        Account(String name, int level) {\n            this.name = name;\n            this.level = level;\n        }\n    }\n}\n"}
