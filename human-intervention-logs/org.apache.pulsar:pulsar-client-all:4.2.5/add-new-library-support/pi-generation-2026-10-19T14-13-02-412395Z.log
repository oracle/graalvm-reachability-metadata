\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.fasterxml.jackson.core.Version;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.core.json.JsonReadFeature;\nimport org.apache.pulsar.shade.com.fasterxml.jackson.core.util.VersionUtil;\nimport org.junit.jupiter.api.Test;\n\npublic class VersionUtilTest {\n    @Test\n    void discoversPackageAndMavenVersionMetadata() {\n        Version packageVersion = VersionUtil.versionFor(JsonReadFeature.class);\n        Version mavenVersion = VersionUtil.mavenVersionFor(\n                JsonReadFeature.class.getClassLoader(),\n                \"com.fasterxml.jackson.core\",\n                \"jackson-core\");\n\n        assertThat(packageVersion.isUnknownVersion()).isFalse();\n        assertThat(packageVersion.getGroupId()).isEqualTo(\"com.fasterxml.jackson.core\");\n        assertThat(mavenVersion.isUnknownVersion()).isFalse();\n        assertThat(mavenVersion.getArtifactId()).isEqualTo(\"jackson-core\");\n    }\n}\n"}}, {"type": "toolCall", "id": "call_xSMPty2OYoQRx833P3LK1Ztm|fc_0d0cab9a0d54d4d8016ad627cfa84887d184b7e655d82e555e", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/TempFileCreatorInnerJavaNioCreatorTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.io.File;\nimport org.apache.pulsar.shade.com.google.common.io.Files;\nimport org.junit.jupiter.api.Test;\n\npublic class TempFileCreatorInnerJavaNioCreatorTest {\n    @Test\n    void createsAPrivateTemporaryDirectory() {\n        File directory = Files.createTempDir();\n        try {\n            assertThat(directory).isDirectory();\n            assertThat(directory.canRead()).isTrue();\n            assertThat(directory.canWrite()).isTrue();\n        } finally {\n            assertThat(directory.delete()).isTrue();\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_rfVlmku8pILh8ZeEhGK1yklq|fc_0d0cab9a0d54d4d8016ad627cfa85487d19ad40922a3cdaf0c", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/MailcapCommandMapTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.io.IOException;\nimport java.io.OutputStream;\nimport org.apache.pulsar.shade.javax.activation.DataContentHandler;\nimport org.apache.pulsar.shade.javax.activation.DataFlavor;\nimport org.apache.pulsar.shade.javax.activation.DataSource;\nimport org.apache.pulsar.shade.javax.activation.MailcapCommandMap;\nimport org.apache.pulsar.shade.javax.activation.UnsupportedFlavorException;\nimport org.junit.jupiter.api.Test;\n\npublic class MailcapCommandMapTest {\n    @Test\n    void loadsAConfiguredContentHandler() {\n        MailcapCommandMap commandMap = new MailcapCommandMap();\n        commandMap.addMailcap(\n                \"application/x-pulsar;; x-java-content-handler=\" + TestContentHandler.class.getName());\n\n        DataContentHandler handler = commandMap.createDataContentHandler(\"application/x-pulsar\");\n\n        assertThat(handler).isInstanceOf(TestContentHandler.class);\n    }\n\n    public static class TestContentHandler implements DataContentHandler {\n        public TestContentHandler() {\n        }\n\n        @Override\n        public DataFlavor[] getTransferDataFlavors() {\n            return new DataFlavor[0];\n        }\n\n        @Override\n        public Object getTransferData(DataFlavor flavor, DataSource source)\n                throws UnsupportedFlavorException {\n            throw new UnsupportedFlavorException(flavor);\n        }\n\n        @Override\n        public Object getContent(DataSource source) {\n            return \"pulsar\";\n        }\n\n        @Override\n        public void writeTo(Object value, String mimeType, OutputStream output) throws IOException {\n            output.write(value.toString().getBytes());\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_2TxOdbAogVeKulCLpUA92mzr|fc_0d0cab9a0d54d4d8016ad627cfa85c87d1ade120772d0864aa", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/IOUtilsTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.net.URL;\nimport org.apache.pulsar.shade.org.apache.commons.io.IOUtils;\nimport org.junit.jupiter.api.Test;\n\npublic class IOUtilsTest {\n    @Test\n    void resolvesResourcesWithClassAndExplicitClassLoaders() throws Exception {\n        URL fromClass = IOUtils.resourceToURL(\"/org/apache/pulsar/shade/org/apache/commons/io/IOUtils.class\");\n        URL fromLoader = IOUtils.resourceToURL(\n                \"org/apache/pulsar/shade/org/apache/commons/io/IOUtils.class\",\n                IOUtils.class.getClassLoader());\n\n        assertThat(fromClass).isNotNull();\n        assertThat(fromLoader).isNotNull();\n    }\n}\n"}}, {"type": "toolCall", "id": "call_3b6xmgAWG7vbWJXyhtTvIhPc|fc_0d0cab9a0d54d4d8016ad627cfa86887d1b78d933d43844a13", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/CommonsCodecResourcesTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.io.InputStream;\nimport org.apache.pulsar.shade.org.apache.commons.codec.Resources;\nimport org.junit.jupiter.api.Test;\n\npublic class CommonsCodecResourcesTest {\n    @Test\n    void opensAResourceRelativeToTheCodecClass() throws Exception {\n        try (InputStream input = Resources.getInputStream(\"Resources.class\")) {\n            assertThat(input.read()).isEqualTo(0xca);\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_m8ybvOoXmTIZjybOTIQO5V0G|fc_0d0cab9a0d54d4d8016ad627cfa87087d1afa97be42a6ef214", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/NettyVersionTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.Map;\nimport org.apache.pulsar.shade.io.netty.util.Version;\nimport org.junit.jupiter.api.Test;\n\npublic class NettyVersionTest {\n    @Test\n    void identifiesBundledNettyModulesFromTheirResource() {\n        Map<String, Version> versions = Version.identify();\n\n        assertThat(versions).isNotEmpty();\n        assertThat(versions.values()).allSatisfy(version -> {\n            assertThat(version.artifactId()).isNotBlank();\n            assertThat(version.artifactVersion()).isNotBl