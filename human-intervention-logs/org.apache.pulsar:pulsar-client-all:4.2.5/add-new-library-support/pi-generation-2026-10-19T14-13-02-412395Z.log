pulsar_client_all/QuickSelectSketchTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.stream.IntStream;\nimport org.apache.pulsar.shade.com.yahoo.sketches.tuple.DoubleSummary;\nimport org.apache.pulsar.shade.com.yahoo.sketches.tuple.UpdatableSketch;\nimport org.junit.jupiter.api.Test;\n\npublic class QuickSelectSketchTest {\n    @Test\n    void growsAndReturnsTypedSummaries() {\n        String[] keys = IntStream.range(0, 40).mapToObj(index -> \"key-\" + index).toArray(String[]::new);\n        UpdatableSketch<Double, DoubleSummary> sketch = TupleSketchSupport.sketch(keys);\n\n        DoubleSummary[] summaries = sketch.getSummaries();\n\n        assertThat(sketch.getRetainedEntries()).isPositive();\n        assertThat(summaries).isInstanceOf(DoubleSummary[].class).isNotEmpty();\n        assertThat(sketch.compact().getRetainedEntries()).isEqualTo(sketch.getRetainedEntries());\n    }\n}\n"}}, {"type": "toolCall", "id": "call_NVBwoutfwOA4n5W4XPzYC4U0|fc_0d0cab9a0d54d4d8016ad62794e20487d1af78e9a794990024", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/CompactSketchTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.yahoo.sketches.tuple.CompactSketch;\nimport org.apache.pulsar.shade.com.yahoo.sketches.tuple.DoubleSummary;\nimport org.junit.jupiter.api.Test;\n\npublic class CompactSketchTest {\n    @Test\n    void compactsKeysAndSummariesIntoTypedArrays() {\n        CompactSketch<DoubleSummary> compact =\n                TupleSketchSupport.sketch(\"one\", \"two\", \"three\").compact();\n\n        assertThat(compact.getRetainedEntries()).isEqualTo(3);\n        assertThat(compact.getSummaries()).isInstanceOf(DoubleSummary[].class).hasSize(3);\n    }\n}\n"}}, {"type": "toolCall", "id": "call_szc0eG7fuFcMEc3Txv2J7wTw|fc_0d0cab9a0d54d4d8016ad62794e20c87d1aaed03e948dc92bb", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/IntersectionTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.pulsar.shade.com.yahoo.sketches.tuple.DoubleSummary;\nimport org.apache.pulsar.shade.com.yahoo.sketches.tuple.DoubleSummaryFactory;\nimport org.apache.pulsar.shade.com.yahoo.sketches.tuple.Intersection;\nimport org.junit.jupiter.api.Test;\n\npublic class IntersectionTest {\n    @Test\n    void intersectsSketchesAndReturnsTypedSummaries() {\n        Intersection<DoubleSummary> intersection = new Intersection<>(new DoubleSummaryFactory());\n        intersection.update(TupleSketchSupport.sketch(\"shared\", \"left\"));\n        intersection.update(TupleSketchSupport.sketch(\"shared\", \"right\"));\n\n        assertThat(intersection.getResult().getSummaries())\n                .isInstanceOf(DoubleSummary[].class)\n                .hasSize(1);\n    }\n}\n"}}, {"type": "toolCall", "id": "call_ul46LHqoQgf8vqLYksN5qzx7|fc_0d0cab9a0d54d4d8016ad62794e21887d199e9da039a5d2635", "name": "write", "arguments": {"path": "tests/src/org.apache.pulsar/pulsar-client-all/4.