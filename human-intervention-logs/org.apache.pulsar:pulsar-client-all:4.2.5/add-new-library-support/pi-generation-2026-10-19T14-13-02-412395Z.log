ultEventLoop eventLoop = new DefaultEventLoop();\n+        DefaultDnsCache cache = new DefaultDnsCache(0, 60, 60);\n+        try {\n+            IllegalStateException failure = new IllegalStateException(\"resolver unavailable\");\n+            cache.cache(\"pulsar.invalid\", null, failure, eventLoop);\n+\n+            List<? extends DnsCacheEntry> entries = cache.get(\"pulsar.invalid\", null);\n+\n+            assertThat(entries).hasSize(1);\n+            assertThat(entries.get(0).cause())\n+                    .isInstanceOf(IllegalStateException.class)\n+                    .hasMessage(\"resolver unavailable\")\n+                    .isNotSameAs(failure);\n+        } finally {\n+            cache.clear();\n+            eventLoop.shutdownGracefully(0, 10, TimeUnit.SECONDS).syncUninterruptibly();\n+        }\n+    }\n+}\ndiff --git a/tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/FileBackedOutputStreamTest.java b/tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/FileBackedOutputStreamTest.java\nnew file mode 100644\nindex 0000000000..0d5334037f\n--- /dev/null\n+++ b/tests/src/org.apache.pulsar/pulsar-client-all/4.2.5/src/test/java/org_apache_pulsar/pulsar_client_all/FileBackedOutputStreamTest.java\n@@ -0,0 +1,28 @@\n+/*\n+ * Copyright and related rights waived via CC0\n+ *\n+ * You should have received a copy of the CC0 legalcode along with this\n+ * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n+ */\n+package org_apache_pulsar.pulsar_client_all;\n+\n+import static java.nio.charset.StandardCharsets.UTF_8;\n+import static org.assertj.core.api.Assertions.assertThat;\n+\n+import org.apache.pulsar.shade.com.google.common.io.FileBackedOutputStream;\n+import org.junit.jupiter.api.Test;\n+\n+public class FileBackedOutputStreamTest {\n+    @Test\n+    void spillsDataAndReadsItThroughTheByteSource() throws Exception {\n+        FileBackedOutputS