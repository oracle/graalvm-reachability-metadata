3d8e2f0ddd", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.net.URI;\nimport java.net.http.HttpRequest;\nimport java.net.http.HttpResponse;\nimport java.time.Duration;\nimport java.util.concurrent.Callable;\nimport java.util.concurrent.TimeUnit;\nimport org.apache.pulsar.client.admin.PulsarAdmin;\nimport org.apache.pulsar.client.api.Consumer;\nimport org.apache.pulsar.client.api.Message;\nimport org.apache.pulsar.client.api.Producer;\nimport org.apache.pulsar.client.api.PulsarClient;\nimport org.apache.pulsar.client.api.Schema;\nimport org.junit.jupiter.api.AfterAll;\nimport org.junit.jupiter.api.BeforeAll;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.TestInstance;\n\n@TestInstance(TestInstance.Lifecycle.PER_CLASS)\npublic class ByteBufPairTest {\n    private static final String CONTAINER_NAME = \"graalvm-pulsar-client-all-test\";\n    private static final String HTTP_URL = \"http://localhost:8080\";\n    private static final String SERVICE_URL = \"pulsar://localhost:6650\";\n    private static final String TOPIC = \"persistent://public/default/reachability-metadata\";\n\n    private Process pulsar;\n\n    @BeforeAll\n    void startPulsar() throws Exception {\n        removeExistingContainer();\n        pulsar = new ProcessBuilder(\n                        \"docker\",\n                        \"run\",\n                        \"--rm\",\n                        \"--name\",\n                        CONTAINER_NAME,\n                        \"-p\",\n                        \"6650:6650\",\n                        \"-p\",\n                        \"8080:8080\",\n                        \"apachepulsar/pulsar:4.2.5\",\n                        \"bin/pulsar\",\n                        \"standalone\",\n                        \"--no-functions-worker\",\n                        \"-nss\")\n                .inheritIO()\n                .start();\n\n        waitUntil(this::adminEndpointIsReady, Duration.ofSeconds(120), Duration.ofSeconds(1));\n    }\n\n    @AfterAll\n    void stopPulsar() throws Exception {\n        if (pulsar != null && pulsar.isAlive()) {\n            pulsar.destroy();\n            if (!pulsar.waitFor(10, TimeUnit.SECONDS)) {\n                pulsar.destroyForcibly();\n                pulsar.waitFor(10, TimeUnit.SECONDS);\n            }\n        }\n        removeExistingContainer();\n    }\n\n    @Test\n    void publishesAndConsumesThroughTheBinaryProtocol() throws Exception {\n        try (PulsarAdmin admin = PulsarAdmin.builder()\n                        .serviceHttpUrl(HTTP_URL)\n                        .connectionTimeout(10, TimeUnit.SECONDS)\n                        .readTimeout(30, TimeUnit.SECONDS)\n                        .build();\n                PulsarClient client = PulsarClient.builder()\n                        .serviceUrl(SERVICE_URL)\n                        .connectionTimeout(10, TimeUnit.SECONDS)\n                        .operationTimeout(30, TimeUnit.SECONDS)\n                        .build();\n                Consumer<String> consumer = client.newConsumer(Schema.STRING)\n                        .topic(TOPIC)\n                        .subscriptionName(\"reachability-metadata-subscription\")\n                        .subscribe();\n                Producer<String> producer = client.newProducer(Schema.STRING).topic(TOPIC).create()) {\n            assertThat(admin.clusters().getClusters()).contains(\"standalone\");\n\n            producer.newMessage()\n                    .key(\"integration-key\")\n                    .property(\"source\", \"native-image-test\")\n                    .value(\"pulsar-message\")\n                    .send();\n            Message<String> message = consumer.receive(30, TimeUnit.SECONDS);\n\n            assertThat(message).isNotNull();\n            assertThat(message.getValue()).isEqualTo(\"pulsar-message\");\n            assertThat(message.getKey()).isEqualTo(\"integration-key\");\n            assertThat(message.getProperty(\"source\")).isEqualTo(\"native-image-test\");\n            consumer.acknowledge(message);\n            assertThat(admin.topics().getStats(TOPIC).getSubscriptions())\n                    .containsKey(\"reachability-metadata-subscription\");\n        }\n    }\n\n    private boolean adminEndpointIsReady() throws Exception {\n        if (!pulsar.isAlive()) {\n            throw new IllegalStateException(\"Pulsar container exited before becoming ready\");\n        }\n        java.net.http.HttpClient client = java.net.http.HttpClient.newBuilder()\n                .connectTimeout(Duration.ofSeconds(10))\n                .build();\n        HttpRequest request = HttpRequest.newBuilder()\n                .uri(URI.create(HTTP_URL + \"/admin/v2/clusters\"))\n                .timeout(Duration.ofSeconds(10))\n                .GET()\n                .build();\n        return client.send(request, HttpResponse.BodyHandlers.discarding()).statusCode() == 200;\n    }\n\n    private static void removeExistingContainer() throws Exception {\n        Process process = new ProcessBuilder(\"docker\", \"rm\", \"-f\", CONTAINER_NAME)\n                .redirectErrorStream(true)\n                .start();\n        if (!process.waitFor(10, TimeUnit.SECONDS)) {\n            process.destroyForcibly();\n            process.waitFor(10, TimeUnit.SECONDS);\n        }\n    }\n\n    private static void waitUntil(\n            Callable<Boolean> condition, Duration timeout, Duration sleepTime) throws Exception {\n        Exception lastException = null;\n        long deadline = System.nanoTime() + timeout.toNanos();\n        while (System.nanoTime() < deadline) {\n            try {\n                if (condition.call()) {\n                    return;\n                }\n            } catch (Exception e) {\n                lastException = e;\n            }\n            Thread.sleep(sleepTime.toMillis());\n        }\n        throw new IllegalStateException(\"Pulsar was not ready within \" + timeout, lastException);\n    }\n}\n"}], "isError": false, "timestamp": 1792420385618}, {"role": "toolResult", "toolCallId": "call_3sTDp8mejAVbQqsHMq66ymS2|fc_0d0cab9a0d54d4d8016ad62a21528887d1a81cc08aad1d7cec", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.awt.datatransfer.DataFlavor;\nimport java.awt.datatransfer.UnsupportedFlavorException;\nimport java.io.IOException;\nimport java.io.OutputStream;\nimport org.apache.pulsar.shade.javax.activation.DataContentHandler;\nimport org.apache.pulsar.shade.javax.activation.DataSource;\nimport org.apache.pulsar.shade.javax.activation.MailcapCommandMap;\nimport org.junit.jupiter.api.Test;\n\npublic class MailcapCommandMapTest {\n    @Test\n    void loadsAConfiguredContentHandler() {\n        MailcapCommandMap commandMap = new MailcapCommandMap();\n        commandMap.addMailcap(\n                \"application/x-pulsar;; x-java-content-handler=\" + TestContentHandler.class.getName());\n\n        DataContentHandler handler = commandMap.createDataContentHandler(\"application/x-pulsar\");\n\n        assertThat(handler).isInstanceOf(TestContentHandler.class);\n    }\n\n    public static class TestContentHandler implements DataContentHandler {\n        public TestContentHandler() {\n        }\n\n        @Override\n        public DataFlavor[] getTransferDataFlavors() {\n            return new DataFlavor[0];\n        }\n\n        @Override\n        public Object getTransferData(DataFlavor flavor, DataSource source)\n                throws UnsupportedFlavorException {\n            throw new UnsupportedFlavorException(flavor);\n        }\n\n        @Override\n        public Object getContent(DataSource source) {\n            return \"pulsar\";\n        }\n\n        @Override\n        public void writeTo(Object value, String mimeType, OutputStream output) throws IOException {\n            output.write(value.toString().getBytes());\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792420385619}, {"role": "toolResult", "toolCallId": "call_Us0kYSyXpqz6So12rpyw29vs|fc_0d0cab9a0d54d4d8016ad62a21529887d1aaa449da29ddf844", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.stream.IntStream;\nimport org.apache.pulsar.shade.com.yahoo.sketches.tuple.DoubleSummary;\nimport org.apache.pulsar.shade.com.yahoo.sketches.tuple.UpdatableSketch;\nimport org.junit.jupiter.api.Test;\n\npublic class QuickSelectSketchTest {\n    @Test\n    void growsAndReturnsTypedSummaries() {\n        String[] keys = IntStream.range(0, 40).mapToObj(index -> \"key-\" + index).toArray(String[]::new);\n        UpdatableSketch<Double, DoubleSummary> sketch = TupleSketchSupport.sketch(keys);\n\n        DoubleSummary[] summaries = sketch.getSummaries();\n\n        assertThat(sketch.getRetainedEntries()).isPositive();\n        assertThat(summaries).isInstanceOf(DoubleSummary[].class).isNotEmpty();\n        assertThat(sketch.compact().getRetainedEntries()).isEqualTo(sketch.getRetainedEntries());\n    }\n}\n"}], "isError": false, "timestamp": 1792420385619}, {"role": "toolResult", "toolCallId": "call_3HcaNWAN6irFGzvdJF9yjn8u|fc_0d0cab9a0d54d4d8016ad62a2152a487d1836500820f322670", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_pulsar.pulsar_client_all;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.List;\nimport java.util.concurrent.TimeUnit;\nimport org.apache.pulsar.shade.io.netty.channel.DefaultEventLoop;\nimport org.apache.pulsar.shade.io.netty.resolver.dns.DefaultDnsCache;\nimport org.apache.pulsar.shade.io.netty.resolver.dns.DnsCacheEntry;\nimport org.junit.jupiter.api.Test;\n\npublic class DefaultDnsCacheTest {\n    @Test\n    void returnsAnIndependentCopyOfCachedFailures() {\n        DefaultEventLoop eventLoop = new DefaultEventLoop();\n        DefaultDnsCache cache = new DefaultDnsCache(0, 60, 60);\n        try {\n            IllegalStateException failure = new IllegalStateException(\"resolver unavailable\");\n            cache.cache(\"pulsar.invalid\", null, failure, eventLoop);\n\n            List<? extends DnsCacheEntry> entries = cache.get(\"pulsar.invalid\", null);\n\n            assertThat(entries).hasSize(1);\n            assertThat(entries.get(0).cause())\n                    .isInstanceOf(IllegalStateException.class)\n                    .hasMessage(\"resolver unavailable\")\n                    .isNotSameAs(failure);\n        } finally {\n            cache.clear();\n            eventLoop.shutdownGracefully(0, 10, TimeUnit.SECONDS).syncUninterruptibly();\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792420385619}]}
