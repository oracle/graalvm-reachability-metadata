     182	    private static void waitUntil(Callable<Boolean> condition, Duration timeout)
     183	            throws Exception {
     184	        Exception lastException = null;
     185	        long deadline = System.nanoTime() + timeout.toNanos();
     186	        while (System.nanoTime() < deadline) {
     187	            try {
     188	                if (condition.call()) {
     189	                    return;
     190	                }
     191	            } catch (Exception e) {
     192	                lastException = e;
     193	            }
     194	            try {
     195	                Thread.sleep(1_000L);
     196	            } catch (InterruptedException e) {
     197	                Thread.currentThread().interrupt();
     198	                throw new IllegalStateException("Interrupted while waiting for Pulsar", e);
     199	            }
     200	        }
     201	        String message = "Pulsar did not become ready within " + timeout;
     202	        throw lastException == null
     203	                ? new IllegalStateException(message)
     204	                : new IllegalStateException(message, lastException);
     205	    }
