      18	@Timeout(55)
      19	public class AvroSchemaTest {
      20	    @Test
      21	    void roundTripsPojoWithJsr310AvroSchema() {
      22	        SchemaDefinition<AuditEvent> definition = SchemaDefinition.<AuditEvent>builder()
      23	                .withPojo(AuditEvent.class)
      24	                .withAlwaysAllowNull(false)
      25	                .withJSR310ConversionEnabled(true)
      26	                .addProperty("domain", "audit")
      27	                .build();
      28	        Schema<AuditEvent> schema = Schema.AVRO(definition);
      29	        AuditEvent event = new AuditEvent(
      30	                "event-17", Instant.parse("2025-01-15T10:15:30.123Z"), 4);
      31	
      32	        byte[] encoded = schema.encode(event);
      33	        AuditEvent decoded = schema.decode(encoded);
      34	
      35	        assertThat(encoded).isNotEmpty();
      36	        assertThat(schema.getSchemaInfo().getType()).isEqualTo(SchemaType.AVRO);
      37	        assertThat(schema.getSchemaInfo().getProperties()).containsEntry("domain", "audit");
      38	        assertThat(decoded.getEventId()).isEqualTo(event.getEventId());
      39	        assertThat(decoded.getOccurredAt()).isEqualTo(event.getOccurredAt());
      40	        assertThat(decoded.getSeverity()).isEqualTo(event.getSeverity());
      41	    }
