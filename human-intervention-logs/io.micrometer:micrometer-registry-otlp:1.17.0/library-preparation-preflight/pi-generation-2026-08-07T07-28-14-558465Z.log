     488	    private static @Nullable Histogram getExplicitBucketHistogram(final Clock clock,
     489	            final DistributionStatisticConfig distributionStatisticConfig,
     490	            final AggregationTemporality aggregationTemporality, final long stepMillis,
     491	            final @Nullable TimeUnit baseTimeUnit, final @Nullable OtlpExemplarSamplerFactory exemplarSamplerFactory) {
     492	
     493	        double[] sloWithPositiveInf = getSloWithPositiveInf(distributionStatisticConfig);
     494	        if (AggregationTemporality.isCumulative(aggregationTemporality)) {
     495	            return new OtlpCumulativeBucketHistogram(clock, DistributionStatisticConfig.builder()
     496	                // effectively never roll over
     497	                .expiry(Duration.ofDays(1825))
     498	                .serviceLevelObjectives(sloWithPositiveInf)
     499	                .percentiles()
     500	                .bufferLength(1)
     501	                .build()
     502	                .merge(distributionStatisticConfig), exemplarSamplerFactory, baseTimeUnit != null);
     503	        }
     504	        if (AggregationTemporality.isDelta(aggregationTemporality) && stepMillis > 0) {
     505	            return new OtlpStepBucketHistogram(clock, stepMillis,
     506	                    DistributionStatisticConfig.builder()
     507	                        .serviceLevelObjectives(sloWithPositiveInf)
     508	                        .build()
     509	                        .merge(distributionStatisticConfig),
     510	                    exemplarSamplerFactory, baseTimeUnit != null);
     511	        }
     512	
     513	        return null;
     514	    }
