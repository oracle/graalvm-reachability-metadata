   private static @Nullable Histogram getExplicitBucketHistogram(final Clock clock,\n   489\t            final DistributionStatisticConfig distributionStatisticConfig,\n   490\t            final AggregationTemporality aggregationTemporality, final long stepMillis,\n   491\t            final @Nullable TimeUnit baseTimeUnit, final @Nullable OtlpExemplarSamplerFactory exemplarSamplerFactory) {\n   492\t\n   493\t        double[] sloWithPositiveInf = getSloWithPositiveInf(distributionStatisticConfig);\n   494\t        if (AggregationTemporality.isCumulative(aggregationTemporality)) {\n   495\t            return new OtlpCumulativeBucketHistogram(clock, DistributionStatisticConfig.builder()\n   496\t                // effectively never roll over\n   497\t                .expiry(Duration.ofDays(1825))\n   498\t                .serviceLevelObjectives(sloWithPositiveInf)\n   499\t                .percentiles()\n   500\t                .bufferLength(1)\n   501\t                .build()\n   502\t                .merge(distributionStatisticConfig), exemplarSamplerFactory, baseTimeUnit != null);\n   503\t        }\n   504\t        if (AggregationTemporality.isDelta(aggregationTemporality) && stepMillis > 0) {\n   505\t            return new OtlpStepBucketHistogram(clock, stepMillis,\n   506\t                    DistributionStatisticConfig.builder()\n   507\t                        .serviceLevelObjectives(sloWithPositiveInf)\n   508\t                        .build()\n   509\t                        .merge(distributionStatisticConfig),\n   510\t                    exemplarSamplerFactory, baseTimeUnit != null);\n   511\t        }\n   512\t\n   513\t        return null;\n   514\t    }\n   515\t\n   516\t    // VisibleForTesting\n   517\t    static double[] getSloWithPositiveInf(DistributionStatisticConfig distributionStatisticConfig) {\n   518\t        double[] sloBoundaries = distributionStatisticConfig.getServiceLevelObjectiveBoundaries();\n   519\t        if (sloBoundaries == null || sloBoundaries.length == 0) {\n   520\t            // When there are no SLO's associated with DistributionStatisticConfig we will\n   521\t            // add one with Positive\n   522\t            // Infinity. This will make sure we always have POSITIVE_INFINITY, and the\n   523\t            // NavigableSet will make sure\n   524\t            // duplicates if any will be ignored.\n   525\t            return EMPTY_SLO_WITH_POSITIVE_INF;\n   526\t        }\n   527\t\n   528\t        boolean containsPositiveInf = Arrays.stream(sloBoundaries).anyMatch(value -> value == Double.POSITIVE_INFINITY);\n   529\t        if (containsPositiveInf)\n   530\t            return sloBoundaries;\n   531\t\n   532\t        double[] sloWithPositiveInf = Arrays.copyOf(sloBoundaries, sloBoundaries.length + 1);\n   533\t        sloWithPositiveInf[sloWithPositiveInf.length - 1] = Double.POSITIVE_INFINITY;\n   534\t        return sloWithPositiveInf;\n   535\t    }\n   536\t\n   537\t    /**\n   538\t     * Overridable lookup mechanism for {@link HistogramFlavor}.\n   539\t     */\n   540\t    // VisibleForTesting\n   541\t    @FunctionalInterface\n   542\t    interface HistogramFlavorPerMeterLookup {\n   543\t\n   544\t        /**\n   545\t         * Default implementation.\n   546\t         */\n   547\t        HistogramFlavorPerMeterLookup DEFAULT = OtlpMeterRegistry::lookup;\n   548\t\n   549\t        /**\n   550\t         * Looks up the histogram flavor to use on a per-meter level. This will override\n   551\t         * the default {@link OtlpConfig#histogramFlavor()} for matching Meters.\n   552\t         * {@link OtlpConfig#histogramFlavorPerMeter()} provides the data while this\n   553\t         * method provides the logic for the lookup, and you can override them\n   554\t         * independently.\n   555\t         * @param perMeterMapping configured mapping data\n   556\t         * @param id the {@link Meter.Id} the {@link HistogramFlavor} is configured for\n   557\t         * @return the histogram flavor mapped to the {@link Meter.Id} or {@code null} if\n   558\t         * mapping is undefined\n   559\t         * @see OtlpConfig#histogramFlavorPerMeter()\n   560\t         * @see OtlpConfig#histogramFlavor()\n   561\t         */\n   562\t        @Nullable HistogramFlavor getHistogramFlavor(Map<String, HistogramFlavor> perMeterMapping, Meter.Id id);\n   563\t\n   564\t    }\n   565\t\n   566\t    /**\n   567\t     * Overridable lookup mechanism for max bucket count. This has no effect on a meter if\n   568\t     * it does not have an exponential bucket histogram configured.\n   569\t     */\n   570\t    // VisibleForTesting\n   571\t    @FunctionalInterface\n   572\t    interface MaxBucketsPerMeterLookup {\n   573\t\n   574\t        /**\n   575\t         * Default implementation.\n   576\t         */\n   577\t        MaxBucketsPerMeterLookup DEFAULT = OtlpMeterRegistry::lookup;\n   578\t\n   579\t        /**\n   580\t         * Looks up the max bucket count to use on a per-meter level. This will override\n   581\t         * the default {@link OtlpConfig#maxBucketCount()} for matching Meters.\n   582\t         * {@link OtlpConfig#maxBucketsPerMeter()} provides the data while this method\n   583\t         * provides the logic for the lookup, and you can override them independently.\n   584\t         * This has no effect on a meter if it does not have an exponential bucket\n   585\t         * histogram configured.\n   586\t         * @param perMeterMapping configured mapping data\n   587\t         * @param id the {@link Meter.Id} the max bucket count is configured for\n   588\t         * @return the max bucket count mapped to the {@link Meter.Id} or {@code null} if\n   589\t         * the mapping is undefined\n   590\t         * @see OtlpConfig#maxBucketsPerMeter()\n   591\t         * @see OtlpConfig#maxBucketCount()\n   592\t         */\n   593\t        @Nullable Integer getMaxBuckets(Map<String, Integer> perMeterMapping, Meter.Id id);\n   594\t\n   595\t    }\n   596\t\n   597\t    private static <T> @Nullable T lookup(Map<String, T> values, Meter.Id id) {\n   598\t        if (values.isEmpty()) {\n   599\t            return null;\n   600\t        }\n   601\t        return doLookup(values, id);\n   602\t    }\n   603\t\n   604\t    private static <T> @Nullable T doLookup(Map<String, T> values, Meter.Id id) {\n   605\t        String name = id.getName();\n   606\t        while (StringUtils.isNotEmpty(name)) {\n   607\t            T result = values.get(name);\n   608\t            if (result != null) {\n   609\t                return result;\n   610\t            }\n   611\t            int lastDot = name.lastIndexOf('.');\n   612\t            name = (lastDot != -1) ? name.substring(0, lastDot) : \"\";\n   613\t        }\n   614\t\n   615\t        return null;\n   616\t    }\n   617\t\n   618\t    /**\n   619\t     * Builder for {@link OtlpMeterRegistry}.\n   620\t     *\n     1\t/*\n     2\t * Copyright 2025 VMware, Inc.\n     3\t *\n     4\t * Licensed under the Apache License, Version 2.0 (the \"License\");\n     5\t * you may not use this file except in compliance with the License.\n     6\t * You may obtain a copy of the License at\n     7\t *\n     8\t * https://www.apache.org/licenses/LICENSE-2.0\n     9\t *\n    10\t * Unless required by applicable law or agreed to in writing, software\n    11\t * distributed under the License is distributed on an \"AS IS\" BASIS,\n    12\t * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n    13\t * See the License for the specific language governing permissions and\n    14\t * limitations under the License.\n    15\t */\n    16\tpackage io.micrometer.registry.otlp;\n    17\t\n    18\timport com.google.protobuf.InvalidProtocolBufferException;\n    19\timport io.opentelemetry.proto.collector.metrics.v1.ExportMetricsServiceRequest;\n    20\timport org.jspecify.annotations.Nullable;\n    21\t\n    22\timport java.nio.charset.StandardCharsets;\n    23\timport java.util.Collections;\n    24\timport java.util.Map;\n    25\timport java.util.Objects;\n    26\t\n    27\t/**\n    28\t * This is responsible for sending OTLP protobuf format metrics to a compatible location.\n    29\t * Specific implementations can use different transports or clients for sending the\n    30\t * metrics.\n    31\t *\n    32\t * @since 1.15.0\n    33\t */\n    34\tpublic interface OtlpMetricsSender {\n    35\t\n    36\t    /**\n    37\t     * Send a batch of OTLP Protobuf format metrics to an OTLP receiver.\n    38\t     * @param request metrics request to publish\n    39\t     * @throws Exception when there is an exception in sending the metrics; the caller\n    40\t     * should handle this in some way such as logging the exception\n    41\t     */\n    42\t    void send(Request request) throws Exception;\n    43\t\n    44\t    /**\n    45\t     * Immutable representation of a payload of metrics to use with an\n    46\t     * {@link OtlpMetricsSender}.\n    47\t     */\n    48\t    class Request {\n    49\t\n    50\t        private final @Nullable String address;\n    51\t\n    52\t        private final Map<String, String> headers;\n    53\t\n    54\t        private final byte[] metricsData;\n    55\t\n    56\t        private final CompressionMode compressionMode;\n    57\t\n    58\t        /**\n    59\t         * Represents a payload of metrics to be sent.\n    60\t         * @param address where to send the metrics\n    61\t         * @param headers metadata to send as headers with the metrics data\n    62\t         * @param metricsData OTLP protobuf encoded batch of metrics\n    63\t         * @param compressionMode compression mode for the metrics data\n    64\t         */\n    65\t        private Request(@Nullable String address, Map<String, String> headers, byte[] metricsData,\n    66\t                CompressionMode compressionMode) {\n    67\t            this.address = address;\n    68\t            this.headers = headers;\n    69\t            this.metricsData = metricsData;\n    70\t            this.compressionMode = compressionMode;\n    71\t        }\n    72\t\n    73\t        public @Nullable String getAddress() {\n    74\t            return address;\n    75\t        }\n    76\t\n    77\t        public byte[] getMetricsData() {\n    78\t            return metricsData;\n    79\t        }\n    80\t\n    81\t        public Map<String, String> getHeaders() {\n    82\t            return headers;\n    83\t        }\n    84\t\n    85\t        public CompressionMode getCompressionMode() {\n    86\t            return compressionMode;\n    87\t        }\n    88\t\n    89\t        @Override\n    90\t        public String toString() {\n    91\t            return \"OtlpMetricsSender.Request for address: \" + address + \", headers: \" + headers + \", compressionMode: \"\n    92\t                    + compressionMode + \", metricsData:\\n\" + readableMetricsData();\n    93\t        }\n    94\t\n    95\t        private String readableMetricsData() {\n    96\t            try {\n    97\t                return ExportMetricsServiceRequest.parseFrom(metricsData).toString();\n    98\t            }\n    99\t            catch (InvalidProtocolBufferException e) {\n   100\t                return new String(metricsData, StandardCharsets.UTF_8);\n   101\t            }\n   102\t        }\n   103\t\n   104\t        /**\n   105\t         * Get a builder for a request.\n   106\t         * @param metricsData OTLP protobuf encoded batch of metrics\n   107\t         * @return builder\n   108\t         */\n   109\t        public static Builder builder(byte[] metricsData) {\n   110\t            return new Builder(metricsData);\n   111\t        }\n   112\t\n   113\t        public static class Builder {\n   114\t\n   115\t            private final byte[] metricsData;\n   116\t\n   117\t            private @Nullable String address;\n   118\t\n   119\t            private Map<String, String> headers = Collections.emptyMap();\