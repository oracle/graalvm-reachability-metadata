va | sed -n '63,210p'; echo '--- sender'; nl -ba io/micrometer/registry/otlp/OtlpHttpMetricsSender.java | sed -n '1,140p'", "timeout": 30}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.5", "usage": {"input": 450, "output": 231, "cacheRead": 28160, "cacheWrite": 0, "totalTokens": 28841, "cost": {"input": 0.0022500000000000003, "output": 0.00693, "cacheRead": 0.014079999999999999, "cacheWrite": 0, "total": 0.02326}}, "stopReason": "toolUse", "timestamp": 1786087624117, "responseId": "resp_0fdb780e9c1688d2016a7588c874088191a9f0b9ec41952d2c"}, "toolResults": [{"role": "toolResult", "toolCallId": "call_nogV2ABiHQR29DLBnwXKiT36|fc_0fdb780e9c1688d2016a7588cb0dc08191aa78f8e1f28fc972", "toolName": "bash", "content": [{"type": "text", "text": "    41\tpublic interface OtlpConfig extends PushRegistryConfig {\n    42\t\n    43\t    /**\n    44\t     * Configuration with default values.\n    45\t     */\n    46\t    OtlpConfig DEFAULT = key -> null;\n    47\t\n    48\t    @Override\n    49\t    default String prefix() {\n    50\t        return \"otlp\";\n    51\t    }\n    52\t\n    53\t    /**\n    54\t     * If no value is returned by {@link #get(String)}, environment variables\n    55\t     * {@code OTEL_EXPORTER_OTLP_METRICS_ENDPOINT} and {@code OTEL_EXPORTER_OTLP_ENDPOINT}\n    56\t     * environment variables will be checked, in that order, by the default\n    57\t     * implementation.\n    58\t     * @return address to where metrics will be published. Default is\n    59\t     * {@code http://localhost:4318/v1/metrics}\n    60\t     * @see <a href=\n    61\t     * \"https://opentelemetry.io/docs/languages/sdk-configuration/otlp-exporter/\">OTLP\n    62\t     * Exporter Configuration</a>\n    63\t     */\n    64\t    default String url() {\n    65\t        return getUrlString(this, \"url\").orElseGet(() -> {\n    66\t            Map<String, String> env = System.getenv();\n    67\t            String endpoint = env.get(\"OTEL_EXPORTER_OTLP_METRICS_ENDPOINT\");\n    68\t            if (endpoint == null) {\n    69\t                endpoint = env.get(\"OTEL_EXPORTER_OTLP_ENDPOINT\");\n    70\t            }\n    71\t            if (endpoint == null) {\n    72\t                endpoint = \"http://localhost:4318/v1/metrics\";\n    73\t            }\n    74\t            else if (!endpoint.endsWith(\"/v1/metrics\")) {\n    75\t                endpoint = endpoint + \"/v1/metrics\";\n    76\t            }\n    77\t            return endpoint;\n    78\t        });\n    79\t    }\n    80\t\n    81\t    /**\n    82\t     * Default implementation supports the environment variable\n    83\t     * {@code OTEL_METRIC_EXPORT_INTERVAL} when the step value is not provided by the\n    84\t     * {@link #get(String)} implementation.\n    85\t     * @return step size (reporting frequency) to use. The default is 1 minute.\n    86\t     * @see <a href=\n    87\t     * \"https://opentelemetry.io/docs/specs/otel/configuration/sdk-environment-variables/#periodic-exporting-metricreader\">OTEL_METRIC_EXPORT_INTERVAL</a>\n    88\t     */\n    89\t    @Override\n    90\t    default Duration step() {\n    91\t        Validated<Duration> step = getDuration(this, \"step\");\n    92\t        return step.orElseGet(() -> {\n    93\t            String exportInterval = System.getenv().get(\"OTEL_METRIC_EXPORT_INTERVAL\");\n    94\t            if (exportInterval != null) {\n    95\t                return Duration.ofMillis(Long.parseLong(exportInterval));\n    96\t            }\n    97\t            return PushRegistryConfig.super.step();\n    98\t        });\n    99\t    }\n   100\t\n   101\t    /**\n   102\t     * Attributes to set on the Resource that will be used for all metrics published. This\n   103\t     * should include a {@code service.name} attribute that identifies your service.\n   104\t     * <p>\n   105\t     * By default, resource attributes will load using the {@link #get(String)} method,\n   106\t     * extracting key values from a comma-separated list in the format\n   107\t     * {@code key1=value1,key2=value2}. Resource attributes will be loaded from the\n   108\t     * {@code OTEL_RESOURCE_ATTRIBUTES} environment variable and the service name from the\n   109\t     * {@code OTEL_SERVICE_NAME} environment variable if they are set and\n   110\t     * {@link #get(String)} does not return a value.\n   111\t     * @return map of key value pairs to use as resource attributes\n   112\t     * @see <a href=\n   113\t     * \"https://opentelemetry.io/docs/reference/specification/resource/semantic_conventions/#service\">OpenTelemetry\n   114\t     * Resource Semantic Conventions</a>\n   115\t     */\n   116\t    default Map<String, String> resourceAttributes() {\n   117\t        Map<String, String> env = System.getenv();\n   118\t        String resourceAttributesConfig = getString(this, \"resourceAttributes\")\n   119\t            .orElse(env.get(\"OTEL_RESOURCE_ATTRIBUTES\"));\n   120\t        String[] splitResourceAttributesString = resourceAttributesConfig == null ? new String[] {}\n   121\t                : resourceAttributesConfig.trim().split(\",\");\n   122\t\n   123\t        Map<String, String> resourceAttributes = Arrays.stream(splitResourceAttributesString)\n   124\t            .map(String::trim)\n   125\t            .filter(keyValue -> keyValue.length() > 2 && keyValue.indexOf('=') > 0)\n   126\t            .collect(Collectors.toMap(keyvalue -> keyvalue.substring(0, keyvalue.indexOf('=')).trim(),\n   127\t                    keyValue -> keyValue.substring(keyValue.indexOf('=') + 1).trim()));\n   128\t\n   129\t        if (env.containsKey(\"OTEL_SERVICE_NAME\") && !resourceAttributes.containsKey(\"service.name\")) {\n   130\t            resourceAttributes.put(\"service.name\", env.get(\"OTEL_SERVICE_NAME\"));\n   131\t        }\n   132\t\n   133\t        return resourceAttributes;\n   134\t    }\n   135\t\n   136\t    /**\n   137\t     * {@link AggregationTemporality} of the OtlpMeterRegistry. This determines whether\n   138\t     * the meters should be cumulative(AGGREGATION_TEMPORALITY_CUMULATIVE) or\n   139\t     * step/delta(AGGREGATION_TEMPORALITY_DELTA). Default implementation supports the\n   140\t     * environment variable {@code OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE} when\n   141\t     * a value is not provided by {@link #get(String)}.\n   142\t     * @return the aggregationTemporality; default is Cumulative\n   143\t     * @see <a href=\n   144\t     * \"https://opentelemetry.io/docs/reference/specification/metrics/data-model/#temporality\">OTLP\n   145\t     * Temporality</a>\n   146\t     * @see <a href=\n   147\t     * \"https://opentelemetry.io/docs/specs/otel/metrics/sdk_exporters/otlp/#additional-configuration\">OpenTelemetry\n   148\t     * Metrics Exporter - OTLP</a>\n   149\t     * @since 1.11.0\n   150\t     */\n--- registry\n    63\tpublic class OtlpMeterRegistry extends PushMeterRegistry {\n    64\t\n    65\t    private static final ThreadFactory DEFAULT_THREAD_FACTORY = new NamedThreadFactory(\"otlp-metrics-publisher\");\n    66\t\n    67\t    private static final double[] EMPTY_SLO_WITH_POSITIVE_INF = new double[] { Double.POSITIVE_INFINITY };\n    68\t\n    69\t    private static final String TELEMETRY_SDK_NAME = \"telemetry.sdk.name\";\n    70\t\n    71\t    private static final String TELEMETRY_SDK_LANGUAGE = \"telemetry.sdk.language\";\n    72\t\n    73\t    private static final String TELEMETRY_SDK_VERSION = \"telemetry.sdk.version\";\n    74\t\n    75\t    private static final Set<String> RESERVED_RESOURCE_ATTRIBUTES = new HashSet<>(\n    76\t            Arrays.asList(TELEMETRY_SDK_NAME, TELEMETRY_SDK_LANGUAGE, TELEMETRY_SDK_VERSION));\n    77\t\n    78\t    private final InternalLogger logger = InternalLoggerFactory.getInstance(OtlpMeterRegistry.class);\n    79\t\n    80\t    private final OtlpConfig config;\n    81\t\n    82\t    private final OtlpMetricsSender metricsSender;\n    83\t\n    84\t    private final HistogramFlavorPerMeterLookup histogramFlavorPerMeterLookup;\n    85\t\n    86\t    private final MaxBucketsPerMeterLookup maxBucketsPerMeterLookup;\n    87\t\n    88\t    private final Resource resource;\n    89\t\n    90\t    private final AggregationTemporality aggregationTemporality;\n    91\t\n    92\t    private final TimeUnit baseTimeUnit;\n    93\t\n    94\t    private final @Nullable OtlpExemplarSamplerFactory exemplarSamplerFactory;\n    95\t\n    96\t    // Time when the last scheduled rollOver has started. Applicable only for delta\n    97\t    // flavour.\n    98\t    private volatile long lastMeterRolloverStartTime = -1;\n    99\t\n   100\t    private @Nullable ScheduledExecutorService meterPollingService;\n   101\t\n   102\t    public OtlpMeterRegistry() {\n   103\t        this(OtlpConfig.DEFAULT, Clock.SYSTEM);\n   104\t    }\n   105\t\n   106\t    public OtlpMeterRegistry(OtlpConfig config, Clock clock) {\n   107\t        this(config, clock, DEFAULT_THREAD_FACTORY);\n   108\t    }\n   109\t\n   110\t    /**\n   111\t     * Create an {@code OtlpMeterRegistry} instance with an HTTP metrics sender.\n   112\t     * @param config config\n   113\t     * @param clock clock\n   114\t     * @param threadFactory thread factory\n   115\t     * @since 1.14.0\n   116\t     */\n   117\t    public OtlpMeterRegistry(OtlpConfig config, Clock clock, ThreadFactory threadFactory) {\n   118\t        this(config, clock, threadFactory, new OtlpHttpMetricsSender(new HttpUrlConnectionSender()), null);\n   119\t    }\n   120\t\n   121\t    private OtlpMeterRegistry(OtlpConfig config, Clock clock, ThreadFactory threadFactory,\n   122\t            OtlpMetricsSender metricsSender, @Nullable ExemplarContextProvider exemplarContextProvider) {\n   123\t        super(config, clock);\n   124\t        this.config = config;\n   125\t        this.baseTimeUnit = config.baseTimeUnit();\n   126\t        this.metricsSender = metricsSender;\n   127\t        this.histogramFlavorPerMeterLookup = HistogramFlavorPerMeterLookup.DEFAULT;\n   128\t        this.maxBucketsPerMeterLookup = MaxBucketsPerMeterLookup.DEFAULT;\n   129\t        this.resource = Resource.newBuilder().addAllAttributes(getResourceAttributes()).build();\n   130\t        this.aggregationTemporality = config.aggregationTemporality();\n   131\t        this.exemplarSamplerFactory = exemplarContextProvider != null\n   132\t                ? new OtlpExemplarSamplerFactory(exemplarContextProvider, clock, config) : null;\n   133\t        config().namingConvention(NamingConvention.dot);\n   134\t        start(threadFactory);\n   135\t    }\n   136\t\n   137\t    /**\n   138\t     * Construct an {@link OtlpMeterRegistry} using the Builder pattern.\n   139\t     * @param config config for the registry; see {@link OtlpConfig#DEFAULT}\n   140\t     * @return builder\n   141\t     * @since 1.15.0\n   142\t     */\n   143\t    public static Builder builder(OtlpConfig config) {\n   144\t        return new Builder(config);\n   145\t    }\n   146\t\n   147\t    @Override\n   148\t    public void start(ThreadFactory threadFactory) {\n   149\t        super.start(threadFactory);\n   150\t\n   151\t        if (config.enabled() && isDelta()) {\n   152\t            this.meterPollingService = Executors.newSingleThreadScheduledExecutor(threadFactory);\n   153\t            this.meterPollingService.scheduleAtFixedRate(this::pollMetersToRollover, getInitialDelay(),\n   154\t                    config.step().toMillis(), TimeUnit.MILLISECONDS);\n   155\t        }\n   156\t    }\n   157\t\n   158\t    @Override\n   159\t    protected String startMessage() {\n   160\t        return String.format(\"Publishing metrics for %s every %s to %s with resource attributes %s\",\n   161\t                getClass().getSimpleName(), TimeUtils.format(config.step()), config.url(), config.resourceAttributes());\n   162\t    }\n   163\t\n   164\t    @Override\n   165\t    public void stop() {\n   166\t        super.stop();\n   167\t        if (this.meterPollingService != null) {\n   168\t            this.meterPollingService.shutdown();\n   169\t        }\n   170\t    }\n   171\t\n   172\t    @Override\n   173\t    protected void publish() {\n   174\t        for (List<Meter> batch : MeterPartition.partition(this, config.batchSize())) {\n   175\t            OtlpMetricConverter otlpMetricConverter = new OtlpMetricConverter(clock, config.step(), getBaseTimeUnit(),\n   176\t                    config.aggregationTemporality(), config().namingConvention(),\n   177\t                    config.publishMaxGaugeForHistograms());\n   178\t            otlpMetricConverter.addMeters(batch);\n   179\t\n   180\t            try {\n   181\t                ExportMetricsServiceRequest request = ExportMetricsServiceRequest.newBuilder()\n   182\t                    .addResourceMetrics(ResourceMetrics.newBuilder()\n   183\t                        .setResource(this.resource)\n   184\t                        .addScopeMetrics(ScopeMetrics.newBuilder()\n   185\t                            // we don't have instrumentation library/version\n   186\t                            // attached to meters; leave unknown for now\n   187\t                            // .setScope(InstrumentationScope.newBuilder().setName(\"\").setVersion(\"\").build())\n   188\t                            .addAllMetrics(otlpMetricConverter.getAllMetrics())\n   189\t                            .build())\n   190\t                        .build())\n   191\t                    .build();\n   192\t                logger.trace(\"Request: {}\", request);\n   193\t                metricsSender.send(OtlpMetricsSender.Request.builder(request.toByteArray())\n   194\t                    .address(config.url())\n   195\t                    .headers(config.headers())\n   196\t                    .compressionMode(config.compressionMode())\n   197\t                    .build());\n   198\t            }\n   199\t            catch (Exception e) {\n   200\t                logger.warn(String.format(\"Failed to publish metrics to OTLP receiver (context: %s)\",\n   201\t                        getConfigurationContext()), e);\n   202\t            }\n   203\t        }\n   204\t    }\n   205\t\n   206\t    /**\n   207\t     * Get the configuration context.\n   208\t     * @return A message containing enough information for the log reader to figure out\n   209\t     * what configuration details may have contributed to the failure.\n   210\t     */\n--- sender\n     1\t/*\n     2\t * Copyright 2025 VMware, Inc.\n     3\t *\n     4\t * Licensed under the Apache License, Version 2.0 (the \"License\");\n     5\t * you may not use this file except in compliance with the License.\n     6\t * You may obtain a copy of the License at\n     7\t *\n     8\t * https://www.apache.org/licenses/LICENSE-2.0\n     9\t *\n    10\t * Unless required by applicable law or agreed to in writing, software\n    11\t * distributed under the License is distributed on an \"AS IS\" BASIS,\n    12\t * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n    13\t * See the License for the specific language governing permissions and\n    14\t * limitations under the License.\n    15\t */\n    16\tpackage io.micrometer.registry.otlp;\n    17\t\n    18\timport io.micrometer.core.ipc.http.HttpSender;\n    19\t\n    20\t/**\n    21\t * An implementation of {@link OtlpMetricsSender} that uses an {@link HttpSender}.\n    22\t *\n    23\t * @since 1.15.0\n    24\t */\n    25\tpublic class OtlpHttpMetricsSender implements OtlpMetricsSender {\n    26\t\n    27\t    private final HttpSender httpSender;\n    28\t\n    29\t    private final String userAgentHeader;\n    30\t\n    31\t    /**\n    32\t     * Metrics sender using the given {@link HttpSender}.\n    33\t     * @param httpSender client to use to send metrics\n    34\t     */\n    35\t    public OtlpHttpMetricsSender(HttpSender httpSender) {\n    36\t        this.httpSender = httpSender;\n    37\t        this.userAgentHeader = getUserAgentHeader();\n    38\t    }\n    39\t\n    40\t    /**\n    41\t     * Send a batch of OTLP Protobuf format metrics to an OTLP HTTP receiver.\n    42\t     * @param request metrics request to publish\n    43\t     * @throws Exception when there is an exception in sending the metrics; the caller\n    44\t     * should handle this in some way such as logging the exception\n    45\t     */\n    46\t    @Override\n    47\t    public void send(Request request) throws Exception {\n    48\t        if (request.getAddress() == null) {\n    49\t            throw new IllegalArgumentException(\"Address cannot be null\");\n    50\t        }\n    51\t\n    52\t        HttpSender.Request.Builder httpRequest = this.httpSender.post(request.getAddress())\n    53\t            .withHeader(\"User-Agent\", userAgentHeader)\n    54\t            .withContent(\"application/x-protobuf\", request.getMetricsData());\n    55\t        request.getHeaders().forEach(httpRequest::withHeader);\n    56\t        if (request.getCompressionMode() == CompressionMode.GZIP) {\n    57\t            httpRequest.compress();\n    58\t        }\n    59\t        HttpSender.Response response;\n    60\t        try {\n    61\t            response = httpRequest.send();\n    62\t        }\n    63\t        catch (Throwable e) {\n    64\t            throw new Exception(e);\n    65\t        }\n    66\t        if (!response.isSuccessful()) {\n    67\t            throw new OtlpHttpMetricsSendUnsuccessfulException(String\n    68\t                .format(\"Server responded with HTTP status code %d and body %s\", response.code(), response.body()));\n    69\t        }\n    70\t    }\n    71\t\n    72\t    private String getUserAgentHeader() {\n    73\t        String userAgent = \"Micrometer-OTLP-Exporter-Java\";\n    74\t        String version = getClass().getPackage().getImplementationVersion();\n    75\t        if (version != null) {\n    76\t            userAgent += \"/\" + version;\n    77\t        }\n    78\t        return userAgent;\n    79\t    }\n    80\t\n    81\t    private static class OtlpHttpMetricsSendUnsuccessfulException extends RuntimeException {\n    82\t\n    83\t        private OtlpHttpMetricsSendUnsuccessfulException(String message) {\n    84\t            super(message);\n    85\t        }\n    86\t\n    87\t    }\n    88\t\n    89\t}\n"}], "isError": false, "timestamp": 1786087635003}]}
