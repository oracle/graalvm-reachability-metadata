ter.four\",\n                \"batch.counter.five\");\n    }\n\n    @Test\n    void longTaskTimersAndMeterRemovalAreReflectedAtPublishTime() throws Exception {\n"},{"oldText":"        OtlpMetricsSender.Request singleRequest() {\n            assertThat(requests).hasSize(1);\n            return requests.get(0);\n        }\n","newText":"        OtlpMetricsSender.Request singleRequest() {\n            assertThat(requests).hasSize(1);\n            return requests.get(0);\n        }\n\n        List<OtlpMetricsSender.Request> requests() {\n            return new ArrayList<>(requests);\n        }\n"}]}
