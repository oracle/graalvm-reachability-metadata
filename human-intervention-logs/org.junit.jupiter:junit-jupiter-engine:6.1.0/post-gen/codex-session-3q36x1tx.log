yTest\"\n    },\n    {\n      \"condition\" : {\n        \"typeReached\" : \"org.junit.jupiter.engine.descriptor.LifecycleMethodUtils\"\n      },\n      \"type\" : \"org_junit_jupiter.junit_jupiter_engine.TempDirectoryTest\"\n    },\n    {\n      \"condition\" : {\n        \"typeReached\" : \"org.junit.jupiter.engine.discovery.ClassSelectorResolver\"\n      },\n      \"type\" : \"org_junit_jupiter.junit_jupiter_engine.TempDirectoryTest\"\n    },\n    {\n      \"condition\" : {\n        \"typeReached\" : \"org.junit.jupiter.engine.discovery.predicates.IsTestClassWithTests\"\n      },\n      \"type\" : \"org_junit_jupiter.junit_jupiter_engine.TempDirectoryTest\"\n    },\n    {\n      \"condition\" : {\n        \"typeReached\" : \"org.junit.jupiter.engine.execution.ConstructorInvocation\"\n      },\n      \"type\" : \"org_junit_jupiter.junit_jupiter_engine.TempDirectoryTest\",\n      \"methods\" : [\n        {\n          \"name\" : \"<init>\",\n          \"parameterTypes\" : [ ]\n        }\n      ]\n    },\n    {\n      \"condition\" : {\n        \"typeReached\" : \"org.junit.jupiter.engine.execution.MethodInvocation\"\n      },\n      \"type\" : \"org_junit_jupiter.junit_jupiter_engine.TempDirectoryTest\",\n      \"methods\" : [\n        {\n          \"name\" : \"injectsTempDirAnnotatedFields\",\n          \"parameterTypes\" : [ ]\n        }\n      ]\n    },\n    {\n      \"condition\" : {\n        \"typeReached\" : \"org.junit.jupiter.engine.extension.TempDirectory\"\n      },\n      \"type\" : \"org_junit_jupiter.junit_jupiter_engine.TempDirectoryTest\",\n      \"fields\" : [\n        {\n          \"name\" : \"fileTempDirectory\"\n        },\n        {\n          \"name\" : \"pathTempDirectory\"\n        }\n      ]\n    }\n  ],\n  \"resources\" : [\n    {\n      \"condition\" : {\n        \"typeReached\" : \"org_junit_jupiter.junit_jupiter_engine.TempDirectoryTest\"\n      },\n      \"glob\" : \"META-INF/services/org.assertj.core.configuration.Configuration\"\n    }