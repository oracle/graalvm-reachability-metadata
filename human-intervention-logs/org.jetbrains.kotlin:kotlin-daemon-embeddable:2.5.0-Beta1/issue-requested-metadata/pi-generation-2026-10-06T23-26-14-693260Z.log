          }
  
          private inline fun <T> Iterable<T>.cleanMatching(
              lock: ReentrantReadWriteLock,
              crossinline pred: (T) -> Boolean,
              crossinline clean: (T) -> Unit,
          ): Boolean {
              var anyDead = false
              lock.read {
                  val toRemove = filter(pred)
                  if (toRemove.isNotEmpty()) {
                      anyDead = true
                      lock.write {
                          toRemove.forEach(clean)
                      }
                  }
              }
              return anyDead
          }
  
