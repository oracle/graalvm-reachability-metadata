ytesMessage.java:367:   protected <T> T getBodyInternal(Class<T> c) {\n/home/oracle/oracle/metadata2/graalvm-reachability-metadata/forge/local_repositories/source_context/org.apache.activemq/artemis-jms-client/2.32.0/main/extracted/org/apache/activemq/artemis/jms/client/ActiveMQSession.java:181:   public Message createMessage() throws JMSException {\n/home/oracle/oracle/metadata2/graalvm-reachability-metadata/forge/local_repositories/source_context/org.apache.activemq/artemis-jms-client/2.32.0/main/extracted/org/apache/activemq/artemis/jms/client/ActiveMQMessage.java:130:   public static ActiveMQMessage createMessage(final ClientMessage message, final ClientSession session) {\n/home/oracle/oracle/metadata2/graalvm-reachability-metadata/forge/local_repositories/source_context/org.apache.activemq/artemis-jms-client/2.32.0/main/extracted/org/apache/activemq/artemis/jms/client/ActiveMQMessage.java:131:      return createMessage(message, session, null);\n/home/oracle/oracle/metadata2/graalvm-reachability-metadata/forge/local_repositories/source_context/org.apache.activemq/artemis-jms-client/2.32.0/main/extracted/org/apache/activemq/artemis/jms/client/ActiveMQMessage.java:134:   public static ActiveMQMessage createMessage(final ClientMessage message,\n/home/oracle/oracle/metadata2/graalvm-reachability-metadata/forge/local_repositories/source_context/org.apache.activemq/artemis-jms-client/2.32.0/main/extracted/org/apache/activemq/artemis/jms/client/ActiveMQMessage.java:212:      message = session.createMessage(type, true, 0, System.currentTimeMillis(), (byte) 4);\n/home/oracle/oracle/metadata2/graalvm-reachability-metadata/forge/local_repositories/source_context/org.apache.activemq/artemis-jms-client/2.32.0/main/extracted/org/apache/activemq/artemis/jms/client/ActiveMQMessage.java:732:   public <T> T getBody(Class<T> c) throws JMSException {\n/home/oracle/oracle/metadata2/graalvm-reachability-metadata/forge/local_repositories/source_context/org.apache.activemq/artemis-jms-