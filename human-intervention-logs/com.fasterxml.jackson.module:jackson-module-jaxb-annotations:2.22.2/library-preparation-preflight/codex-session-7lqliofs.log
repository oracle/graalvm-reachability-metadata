\nmetadata/org.hibernate.orm/hibernate-envers/6.1.1.Final/reachability-metadata.json:3967:      \"glob\": \"META-INF/services/jakarta.xml.bind.JAXBContext\"\nmetadata/tools.jackson.jaxrs/jackson-jaxrs-json-provider/index.json:9:    \"description\" : \"Jackson JAX-RS JSON Provider integrates Jackson data binding with JAX-RS implementations so REST endpoints can read and write JSON request and response bodies. It supplies provider classes and service registration for JSON media types, building on the Jackson JAX-RS base module and optional JAXB annotation support.\",\nmetadata/tools.jackson.datatype/jackson-datatype-jsr310/index.json:6:    \"repository-url\" : \"https://github.com/FasterXML/jackson-modules-java8\",\nmetadata/tools.jackson.datatype/jackson-datatype-jsr310/index.json:7:    \"test-code-url\" : \"https://github.com/FasterXML/jackson-modules-java8/tree/jackson-modules-java8-$version$/datetime/src/test/java\",\ntests/src/com.fasterxml.jackson.module/jackson-module-scala_3/2.15.0/settings.gradle:20:rootProject.name = 'com.fasterxml.jackson.module.jackson-module-scala_3_tests'\ntests/src/com.fasterxml.jackson.module/jackson-module-scala_3/2.15.0/build.gradle:17:    testImplementation \"com.fasterxml.jackson.module:jackson-module-scala_3:$libraryVersion\"\nmetadata/org.codehaus.jackson/jackson-xc/index.json:9:    \"description\" : \"Jackson XC adds XML-compatibility extensions to Jackson 1.x data binding, including support for JAXB annotations and XML-related Java types when serializing and deserializing JSON. It lets applications reuse JAXB metadata with Jackson's mapper for JSON interoperability rather than performing XML processing itself.\",\ntests/src/com.fasterxml.jackson.module/jackson-module-scala_3/2.13.2/settings.gradle:20:rootProject.name = 'com.fasterxml.jackson.module.jackson-module-scala_3_tests'\ntests/src/com.fasterxml.jackson.module/jackson-module-scala_3/2.13.2/build.gradle:17:    testImplementation \"com.fasterxml.jackson.module:jackson-module-scala_3:$libraryVersion\"\ntests/src/com.fasterxml.jackson.module/jackson-module-kotlin/2.17.2/settings.gradle:20:rootProject.name = 'com.fasterxml.jackson.module.jackson-module-kotlin_tests'\ntests/src/com.fasterxml.jackson.module/jackson-module-kotlin/2.17.2/build.gradle:16:    testImplementation \"com.fasterxml.jackson.module:jackson-module-kotlin:$libraryVersion\"\nmetadata/org.jvnet.jaxb/jaxb-plugins-runtime/index.json:9:    \"description\" : \"JAXB Plugins Runtime provides runtime support classes used by JAXB-generated Java code and the JAXB Plugins suite. It supplies reusable facilities for generated-object operations such as copying, equality, hashing, merging, string conversion, and XML binding.\",\nmetadata/com.sun.xml.bind.external/rngom/index.json:9:    \"description\" : \"RNGOM provides a Java object model for RELAX NG schemas, analogous to XSOM for XML Schema. It is used by JAXB tooling to parse and work with RELAX NG grammar structures.\",\nmetadata/com.sun.xml.bind.external/relaxng-datatype/index.json:9:    \"description\" : \"RelaxNG Datatype provides Java interfaces and helper classes for RELAX NG datatype libraries used during XML schema validation. This artifact is the JAXB RI repackaging of those datatype APIs and service-loading utilities for Java applications.\",\ntests/src/com.fasterxml.jackson.module/jackson-module-paranamer/2.19.0/settings.gradle:20:rootProject.name = 'com.fasterxml.jackson.module.jackson-module-paranamer_tests'\ntests/src/com.fasterxml.jackson.module/jackson-module-paranamer/2.19.0/build.gradle:14:    testImplementation \"com.fasterxml.jackson.module:jackson-module-paranamer:$libraryVersion\"\nmetadata/org.glassfish.jaxb/codemodel/index.json:9:    \"description\" : \"Codemodel is the core CodeModel library used to programmatically build Java source structures such as packages, classes, methods, fields, annotations, and expressions. It writes those in-memory models as Java source files for code generators such as JAXB to