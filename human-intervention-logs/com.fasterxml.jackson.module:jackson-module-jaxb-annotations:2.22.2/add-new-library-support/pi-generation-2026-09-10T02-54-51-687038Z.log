notationIntrospector(TypeFactory typeFactory, boolean ignoreXmlIDREF)\n/home/mihailo/git/graalvm-reachability-metadata-copy/forge/local_repositories/source_context/com.fasterxml.jackson.module/jackson-module-jaxb-annotations/2.22.2/main/extracted/com/fasterxml/jackson/module/jaxb/JaxbAnnotationIntrospector.java:145:            dataHandlerSerializer = (JsonSerializer<?>) DataHandlerJsonSerializer.class.newInstance();\n/home/mihailo/git/graalvm-reachability-metadata-copy/forge/local_repositories/source_context/com.fasterxml.jackson.module/jackson-module-jaxb-annotations/2.22.2/main/extracted/com/fasterxml/jackson/module/jaxb/JaxbAnnotationIntrospector.java:146:            dataHandlerDeserializer = (JsonDeserializer<?>) DataHandlerJsonDeserializer.class.newInstance();\n/home/mihailo/git/graalvm-reachability-metadata-copy/forge/local_repositories/source_context/com.fasterxml.jackson.module/jackson-module-jaxb-annotations/2.22.2/main/extracted/com/fasterxml/jackson/module/jaxb/JaxbAnnotationIntrospector.java:941:    public String[] findEnumValues(Class<?> enumType, Enum<?>[] enumValues, String[] names) {\n/home/mihailo/git/graalvm-reachability-metadata-copy/forge/local_repositories/source_context/com.fasterxml.jackson.module/jackson-module-jaxb-annotations/2.22.2/main/extracted/com/fasterxml/jackson/module/jaxb/JaxbAnnotationIntrospector.java:974:     * @see JacksonAnnotationIntrospector#findEnumValues(MapperConfig, AnnotatedClass, Enum[], String[])\n/home/mihailo/git/graalvm-reachability-metadata-copy/forge/local_repositories/source_context/com.fasterxml.jackson.module/jackson-module-jaxb-annotations/2.22.2/main/extracted/com/fasterxml/jackson/module/jaxb/JaxbAnnotationIntrospector.java:978:    public String[] findEnumValues(MapperConfig<?> config, AnnotatedClass annotatedClass,\n/home/mihailo/git/graalvm-reachability-metadata-copy/forge/local_repositories/source_context/com.fasterxml.jackson.module/jackson-module-jaxb-annotations/2.22.2/main/extracted/com/fasterxml/jac