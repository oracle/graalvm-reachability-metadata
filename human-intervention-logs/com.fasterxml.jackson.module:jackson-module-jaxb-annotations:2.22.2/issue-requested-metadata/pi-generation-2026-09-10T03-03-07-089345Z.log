tests/src/com.fasterxml.jackson.module/jackson-module-jaxb-annotations/2.22.2/build/test-results/test/TEST-com_fasterxml_jackson_module.jackson_module_jaxb_annotations.JaxbAnnotationIntrospectorTest.xml\ntests/src/com.fasterxml.jackson.module/jackson-module-jaxb-annotations/2.22.2/build/test-results/test/testlist/junit-platform-unique-ids-7557523362207943193.txt\ntests/src/com.fasterxml.jackson.module/jackson-module-jaxb-annotations/2.22.2/build/tmp/.cache/expanded/zip_9892ccb804f78c0637616b68610d363f/about.html\ntests/src/com.fasterxml.jackson.module/jackson-module-jaxb-annotations/2.22.2/build/tmp/.cache/expanded/zip_9892ccb804f78c0637616b68610d363f/jacocoagent.jar\ntests/src/com.fasterxml.jackson.module/jackson-module-jaxb-annotations/2.22.2/build/tmp/.cache/expanded/zip_9892ccb804f78c0637616b68610d363f/META-INF/MANIFEST.MF\ntests/src/com.fasterxml.jackson.module/jackson-module-jaxb-annotations/2.22.2/build/tmp/compileTestJava/compileTransaction/stash-dir/Jackson_module_jaxb_annotationsTest.class.uniqueId0\ntests/src/com.fasterxml.jackson.module/jackson-module-jaxb-annotations/2.22.2/build/tmp/compileTestJava/previous-compilation-data.bin\ntests/src/com.fasterxml.jackson.module/jackson-module-jaxb-annotations/2.22.2/build/tmp/jar/MANIFEST.MF\ntests/src/com.fasterxml.jackson.module/jackson-module-jaxb-annotations/2.22.2/.gitignore\ntests/src/com.fasterxml.jackson.module/jackson-module-jaxb-annotations/2.22.2/.gradle/9.1.0/checksums/checksums.lock\ntests/src/com.fasterxml.jackson.module/jackson-module-jaxb-annotations/2.22.2/.gradle/9.1.0/checksums/md5-checksums.bin\ntests/src/com.fasterxml.jackson.module/jackson-module-jaxb-annotations/2.22.2/.gradle/9.1.0/checksums/sha1-checksums.bin\ntests/src/com.fasterxml.jackson.module/jackson-module-jaxb-annotations/2.22.2/.gradle/9.1.0/executionHistory/executionHistory.bin\ntests/src/com.fasterxml.jackson.module/jackson-module-jaxb-annotations/2.22.2/.gradle/9.1.0/executionHistory/executionHistory.lock\ntests/src/com.faster