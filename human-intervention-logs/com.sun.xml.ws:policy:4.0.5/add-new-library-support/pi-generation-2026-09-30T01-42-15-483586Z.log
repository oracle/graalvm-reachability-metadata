del.getRootNode().getType()).isEqualTo(ModelNode.Type.POLICY);\n            assertThat(exactlyOne.getType()).isEqualTo(ModelNode.Type.EXACTLY_ONE);\n            assertThat(all.getType()).isEqualTo(ModelNode.Type.ALL);\n            assertThat(assertion.getNodeData().getName()).isEqualTo(assertionName);\n        } finally {\n            reader.close();\n        }\n    }","newText":"    @Test\n    void mergesPoliciesIntoACombinedAlternative() {\n        Policy first = Policy.createEmptyPolicy(\"first\", \"first-id\");\n        Policy second = Policy.createEmptyPolicy(\"second\", \"second-id\");\n\n        Policy merged = PolicyMerger.getMerger().merge(List.of(first, second));\n\n        assertThat(merged.isEmpty()).isTrue();\n        assertThat(merged.getNumberOfAssertionSets()).isEqualTo(1);\n        assertThat(merged.getId()).isEqualTo(\"first-id-second-id\");\n    }"}]}
