marshaller;\nimport com.sun.xml.ws.policy.sourcemodel.PolicySourceModel;\nimport java.io.StringReader;\nimport java.io.StringWriter;\nimport java.util.List;\nimport javax.xml.namespace.QName;\nimport javax.xml.stream.XMLOutputFactory;\nimport javax.xml.stream.XMLStreamWriter;\n", "newText": "import com.sun.xml.ws.policy.sourcemodel.AssertionData;\nimport com.sun.xml.ws.policy.sourcemodel.ModelNode;\nimport com.sun.xml.ws.policy.sourcemodel.PolicyModelTranslator;\nimport com.sun.xml.ws.policy.sourcemodel.PolicySourceModel;\nimport com.sun.xml.ws.policy.sourcemodel.wspolicy.NamespaceVersion;\nimport java.util.List;\nimport java.util.Map;\nimport javax.xml.namespace.QName;\n"}, {"oldText": "    void unmarshalsAndTranslatesXmlPolicyModel() throws Exception {\n        PolicySourceModel model = unmarshalPolicy();\n        Policy policy = PolicyModelTranslator.getTranslator().translate(model);\n\n        assertThat(model.getPolicyName()).isEqualTo(\"sample-policy\");\n        assertThat(model.getRootNode().hasChildren()).isTrue();\n        assertThat(policy.getName()).isEqualTo(\"sample-policy\");\n        assertThat(policy.getNumberOfAssertionSets()).isEqualTo(1);\n        assertThat(policy.contains(ASSERTION_NAME)).isTrue();\n        assertThat(policy.getVocabulary()).containsExactly(ASSERTION_NAME);\n\n        AssertionSet assertions = policy.iterator().next();\n        PolicyAssertion assertion = assertions.iterator().next();\n        assertThat(assertion.getName()).isEqualTo(ASSERTION_NAME);\n        assertThat(assertion.getValue()).isEqualTo(\"enabled\");\n    }\n\n    @Test\n    void marshalsPolicyModelAndReadsItBack() throws Exception {\n        PolicySourceModel original = unmarshalPolicy();\n        StringWriter output = new StringWriter();\n        XMLStreamWriter writer = XMLOutputFactory.newFactory().createXMLStreamWriter(output);\n        PolicyModelMarshaller.getXmlMarshaller(true).marshal(original, writer);\n        writer.close();\n\n        PolicySourceModel roundTripped = unmarshal(output.toString());\n        assertThat(roundTripped.getPolicyName()).isEqualTo(original.getPolicyName());\n        assertThat(roundTripped.getRootNode()).isEqualTo(original.getRootNode());\n    }\n", "newText": "    void createsAndTranslatesSourceModel() throws Exception {\n        PolicySourceModel model = createPolicyModel();\n        Policy policy = PolicyModelTranslator.getTranslator().translate(model);\n\n        assertThat(model.getPolicyName()).isEqualTo(\"sample-policy\");\n        assertThat(model.getRootNode().hasChildren()).isTrue();\n        assertThat(policy.getName()).isEqualTo(\"sample-policy\");\n        assertThat(policy.getNumberOfAssertionSets()).isEqualTo(1);\n        assertThat(policy.contains(ASSERTION_NAME)).isTrue();\n        assertThat(policy.getVocabulary()).containsExactly(ASSERTION_NAME);\n\n        AssertionSet assertions = policy.iterator().next();\n        PolicyAssertion assertion = assertions.iterator().next();\n        assertThat(assertion.getName()).isEqualTo(ASSERTION_NAME);\n        assertThat(assertion.getValue()).isEqualTo(\"enabled\");\n    }\n"}, {"oldText": "    private static PolicySourceModel unmarshalPolicy() throws Exception {\n        return unmarshal(\n                \"<wsp:Policy xmlns:wsp=\\\"\" + POLICY_NAMESPACE\n                        + \"\\\" xmlns:t=\\\"urn:example:policy\\\" Name=\\\"sample-policy\\\">\"\n                        + \"<wsp:ExactlyOne><wsp:All><t:Trace>enabled</t:Trace>\"\n                        + \"</wsp:All></wsp:ExactlyOne></wsp:Policy>\");\n    }\n\n    private static PolicySourceModel unmarshal(String xml) throws Exception {\n        return PolicyModelUnmarshaller.getXmlUnmarshaller().unmarshalModel(new StringReader(xml));\n    }\n", "newText": "    private static PolicySourceModel createPolicyModel() {\n        PolicySourceModel model = PolicySourceModel.createPolicySourceModel(\n                NamespaceVersion.v1_5, \"sample-policy\", null);\n        ModelNode exactlyOne = model.getRootNode().createChildExactlyOneNode();\n        ModelNode all = exactlyOne.createChildAllNode();\n        all.createChildAssertionNode(AssertionData.createAssertionData(\n                ASSERTION_NAME, \"enabled\", Map.of(), false, false));\n        return model;\n    }\n"}]}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-luna", "usage": {"input": 15950, "output": 1623, "cacheRead": 53760, "cacheWrite": 0, "reasoning": 534, "totalTokens": 71333, "cost": {"input": 0.00319, "output": 0.0019475999999999999, "cacheRead": 0.0010752000000000001, "cacheWrite": 0, "total": 0.0062128}}, "stopReason": "toolUse", "timestamp": 1790732752482, "responseId": "resp_014c22a286c8a7be016abc69d1570087d29cef049384c75836", "rawStopReason": "completed"}}
