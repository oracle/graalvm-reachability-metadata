 String POLICY_NAMESPACE = \"http://www.w3.org/ns/ws-policy\";\n    private static final QName ASSERTION_NAME = new QName(\"urn:example:policy\", \"Trace\");\n\n    @Test\n    void createsAndCombinesPoliciesThroughPublicFactories() {\n        Policy empty = Policy.createEmptyPolicy(\"empty\", \"empty-policy\");\n        Policy nullPolicy = Policy.createNullPolicy(\"null\", \"null-policy\");\n\n        assertThat(empty.isEmpty()).isTrue();\n        assertThat(empty.isNull()).isFalse();\n        assertThat(nullPolicy.isNull()).isTrue();\n        assertThat(PolicyMerger.getMerger().merge(List.of(empty, empty))).isEqualTo(empty);\n        assertThat(PolicyIntersector.createStrictPolicyIntersector().intersect(empty, empty))\n                .isEqualTo(empty);\n    }\n\n    @Test\n    void unmarshalsAndTranslatesXmlPolicyModel() throws Exception {\n        PolicySourceModel model = unmarshalPolicy();\n        Policy policy = PolicyModelTranslator.getTranslator().translate(model);\n\n        assertThat(model.getPolicyName()).isEqualTo(\"sample-policy\");\n        assertThat(model.getRootNode().hasChildren()).isTrue();\n        assertThat(policy.getName()).isEqualTo(\"sample-policy\");\n        assertThat(policy.getNumberOfAssertionSets()).isEqualTo(1);\n        assertThat(policy.contains(ASSERTION_NAME)).isTrue();\n        assertThat(policy.getVocabulary()).containsExactly(ASSERTION_NAME);\n\n        AssertionSet assertions = policy.iterator().next();\n        PolicyAssertion assertion = assertions.iterator().next();\n        assertThat(assertion.getName()).isEqualTo(ASSERTION_NAME);\n        assertThat(assertion.getValue()).isEqualTo(\"enabled\");\n    }\n\n    @Test\n    void marshalsPolicyModelAndReadsItBack() throws Exception {\n        PolicySourceModel original = unmarshalPolicy();\n        StringWriter output = new StringWriter();\n        XMLStreamWriter writer = XMLOutputFactory.newFactory().createXMLStreamWriter(output);\n        PolicyModelMarshaller.getXmlMarshaller(true).marshal(original, writer);\n        writer.close();\n\n        PolicySourceModel roundTripped = unmarshal(output.toString());\n        assertThat(roundTripped.getPolicyName()).isEqualTo(original.getPolicyName());\n        assertThat(roundTripped.getRootNode()).isEqualTo(original.getRootNode());\n    }\n\n    @Test\n    void storesSubjectsInEachPolicyMapScope() throws Exception {\n        Policy policy = Policy.createEmptyPolicy(\"map-policy\", \"map-policy\");\n        PolicySubject subject = new PolicySubject(\"endpoint\", policy);\n        PolicyMapExtender extender = PolicyMapExtender.createPolicyMapExtender();\n        PolicyMap map = PolicyMap.createPolicyMap(List.of(extender));\n        PolicyMapKey key = PolicyMap.createWsdlEndpointScopeKey(\n                new QName(\"urn:example\", \"Service\"), new QName(\"urn:example\", \"Port\"));\n        extender.putEndpointSubject(key, subject);\n\n        assertThat(map.isEmpty()).isFalse();\n        assertThat(map.getEndpointEffectivePolicy(key)).isEqualTo(policy);\n        assertThat(map.getAllEndpointScopeKeys()).containsExactly(key);\n        assertThat(map.getPolicySubjects()).contains(subject);\n        assertThat(map).contains(policy);\n    }\n\n    private static PolicySourceModel unmarshalPolicy() throws Exception {\n        return unmarshal(\n                \"<wsp:Policy xmlns:wsp=\\\"\" + POLICY_NAMESPACE\n                        + \"\\\" xmlns:t=\\\"urn:example:policy\\\" Name=\\\"sample-policy\\\">\"\n                        + \"<wsp:ExactlyOne><wsp:All><t:Trace>enabled</t:Trace>\"\n                        + \"</wsp:All></wsp:ExactlyOne></wsp:Policy>\");\n    }\n\n    private static PolicySourceModel unmarshal(String xml) throws Exception {\n        return PolicyModelUnmarshaller.getXmlUnmarshaller().unmarshalModel(new StringReader(xml));\n    }\n}\n"}], "isError": false, "timestamp": 1790732785904}]}
