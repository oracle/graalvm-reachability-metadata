[tool-call] delta {"path":"tests/src/com.sun.xml.ws/policy/4.0.5/src/test/java/com_sun_xml_ws/policy/PolicyTest.java","edits":[{"oldText":"import com.sun.xml.ws.policy.PolicyMerger;\nimport java.util.List;","newText":"import com.sun.xml.ws.policy.PolicyMerger;\nimport com.sun.xml.ws.policy.sourcemodel.wspolicy.NamespaceVersion;\nimport java.util.List;"},{"oldText":"    @Test\n    void mergesPoliciesIntoACombinedAlternative() {\n        Policy first = Policy.createEmptyPolicy(\"first\", \"first-id\");\n        Policy second = Policy.createEmptyPolicy(\"second\", \"second-id\");\n\n        Policy merged = PolicyMerger.getMerger().merge(List.of(first, second));\n\n        assertThat(merged.isEmpty()).isTrue();\n        assertThat(merged.getNumberOfAssertionSets()).isEqualTo(1);\n        assertThat(merged.getId()).isEqualTo(\"first-id-second-id\");\n    }","newText":"    @Test\n    void preservesExplicitPolicyNamespaceThroughTheMerger() {\n        Policy policy =\n                Policy.createPolicy(\n                        NamespaceVersion.v1_2,\n                        \"service-policy\",\n                        \"service-id\",\n                        List.of(AssertionSet.emptyAssertionSet()));\n\n        Policy merged = PolicyMerger.getMerger().merge(List.of(policy));\n\n        assertThat(merged).isSameAs(policy);\n        assertThat(merged.getNamespaceVersion()).isEqualTo(NamespaceVersion.v1_2);\n    }"}]}
