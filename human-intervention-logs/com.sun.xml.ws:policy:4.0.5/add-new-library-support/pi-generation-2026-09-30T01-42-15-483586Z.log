  package com_sun_xml_ws.policy;
  
  import static org.assertj.core.api.Assertions.assertThat;
  
  import com.sun.xml.ws.policy.AssertionSet;
  import com.sun.xml.ws.policy.Policy;
  import com.sun.xml.ws.policy.PolicyMerger;
  import java.util.List;
  import org.junit.jupiter.api.Test;
  
  public class PolicyTest {
      @Test
      void createsAndCombinesPoliciesThroughPublicFactories() {
          Policy empty = Policy.createEmptyPolicy("empty", "empty-policy");
          Policy nullPolicy = Policy.createNullPolicy("null", "null-policy");
          Policy explicit = Policy.createPolicy(List.of(AssertionSet.emptyAssertionSet()));
  
          assertThat(empty.isEmpty()).isTrue();
          assertThat(empty.isNull()).isFalse();
          assertThat(nullPolicy.isNull()).isTrue();
          assertThat(explicit.getNumberOfAssertionSets()).isEqualTo(1);
      }
  
      @Test
      void mergesPoliciesIntoCombinedAlternatives() {
          Policy first =
                  Policy.createPolicy("first", "first-id", List.of(AssertionSet.emptyAssertionSet()));
          Policy second =
                  Policy.createPolicy("second", "second-id", List.of(AssertionSet.emptyAssertionSet()));
  
          Policy merged = PolicyMerger.getMerger().merge(List.of(first, second));
  
          assertThat(merged.getNumberOfAssertionSets()).isEqualTo(1);
          assertThat(merged.iterator().next().isEmpty()).isTrue();
          assertThat(merged.getId()).isEqualTo("first-id-second-id");
      }
  }
