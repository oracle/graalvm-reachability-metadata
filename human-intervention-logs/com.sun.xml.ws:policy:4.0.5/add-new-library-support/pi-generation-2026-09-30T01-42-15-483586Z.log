SourceModel createPolicyModel() {\n        PolicySourceModel model = PolicySourceModel.createPolicySourceModel(\n                NamespaceVersion.v1_5, \"sample-policy\", null);\n        ModelNode exactlyOne = model.getRootNode().createChildExactlyOneNode();\n        ModelNode all = exactlyOne.createChildAllNode();\n        all.createChildAssertionNode(AssertionData.createAssertionData(\n                ASSERTION_NAME, \"enabled\", Map.of(), false, false));\n        return model;\n    }\n", "newText": "        assertThat(PolicyMerger.getMerger().merge(List.of(empty, empty))).isEqualTo(empty);\n    }\n"}]}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-luna", "usage": {"input": 1320, "output": 972, "cacheRead": 75264, "cacheWrite": 0, "reasoning": 186, "totalTokens": 77556, "cost": {"input": 0.000264, "output": 0.0011664, "cacheRead": 0.0015052800000000001, "cacheWrite": 0, "total": 0.0029356800000000004}}, "stopReason": "toolUse", "timestamp": 1790732852551, "responseId": "resp_014c22a286c8a7be016abc6a34bd4087d2b0c783a072250dbe", "rawStopReason": "completed"}}
