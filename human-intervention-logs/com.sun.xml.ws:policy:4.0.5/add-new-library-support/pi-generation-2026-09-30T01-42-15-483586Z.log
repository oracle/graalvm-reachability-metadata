[tool-call] delta {"path":"tests/src/com.sun.xml.ws/policy/4.0.5/src/test/java/com_sun_xml_ws/policy/PolicyTest.java","edits":[{"oldText":"import com.sun.xml.ws.policy.PolicyIntersector;\nimport com.sun.xml.ws.policy.PolicyMap;\nimport com.sun.xml.ws.policy.PolicyMapExtender;\nimport com.sun.xml.ws.policy.PolicyMapKey;\nimport com.sun.xml.ws.policy.PolicyMerger;\nimport com.sun.xml.ws.policy.PolicySubject;\nimport com.sun.xml.ws.policy.sourcemodel.AssertionData;\nimport com.sun.xml.ws.policy.sourcemodel.ModelNode;\nimport com.sun.xml.ws.policy.sourcemodel.PolicySourceModel;\nimport com.sun.xml.ws.policy.sourcemodel.wspolicy.NamespaceVersion;\n","newText":"import com.sun.xml.ws.policy.PolicyMerger;\n"},{"oldText":"        assertThat(PolicyMerger.getMerger().merge(List.of(empty, empty))).isEqualTo(empty);\n        assertThat(PolicyIntersector.createStrictPolicyIntersector().intersect(empty, empty))\n                .isEqualTo(empty);\n    }\n\n    @Test\n    void createsSourceModelThroughPublicFactories() {\n        PolicySourceModel model = createPolicyModel();\n        ModelNode exactlyOne = model.getRootNode().iterator().next();\n        ModelNode all = exactlyOne.iterator().next();\n        AssertionData assertion = all.iterator().next().getNodeData();\n\n        assertThat(model.getPolicyName()).isEqualTo(\"sample-policy\");\n        assertThat(model.getRootNode().hasChildren()).isTrue();\n        assertThat(model.getRootNode().childrenSize()).isEqualTo(1);\n        assertThat(exactlyOne.childrenSize()).isEqualTo(1);\n        assertThat(assertion.getName()).isEqualTo(ASSERTION_NAME);\n        assertThat(assertion.getValue()).isEqualTo(\"enabled\");\n    }\n\n    @Test\n    void storesSubjectsInEachPolicyMapScope() throws Exception {\n        Policy policy = Policy.createEmptyPolicy(\"map-policy\", \"map-policy\");\n        PolicySubject subject = new PolicySubject(\"endpoint\", policy);\n        PolicyMapExtender extender = PolicyMapExtender.createPolicyMapExtender();\n        PolicyMap map = PolicyMap.createPolicyMap(List.of(extender));\n        PolicyMapKey key = PolicyMap.createWsdlEndpointScopeKey(\n                new QName(\"urn:example\", \"Service\"), new QName(\"urn:example\", \"Port\"));\n        extender.putEndpointSubject(key, subject);\n\n        assertThat(map.isEmpty()).isFalse();\n        assertThat(map.getEndpointEffectivePolicy(key)).isEqualTo(policy);\n        assertThat(map.getAllEndpointScopeKeys()).containsExactly(key);\n        assertThat(map.getPolicySubjects()).contains(subject);\n        assertThat(map).contains(policy);\n    }\n\n    private static PolicySourceModel createPolicyModel() {\n        PolicySourceModel model = PolicySourceModel.createPolicySourceModel(\n                NamespaceVersion.v1_5, \"sample-policy\", null);\n        ModelNode exactlyOne = model.getRootNode().createChildExactlyOneNode();\n        ModelNode all = exactlyOne.createChildAllNode();\n        all.createChildAssertionNode(AssertionData.createAssertionData(\n                ASSERTION_NAME, \"enabled\", Map.of(), false, false));\n        return model;\n    }\n","newText":"        assertThat(PolicyMerger.getMerger().merge(List.of(empty, empty))).isEqualTo(empty);\n    }\n"}]}
