lass<T> c) {\r\n        ServiceLoader<T> loader = ServiceLoader.load(c, getServiceLoaderClassLoader());\r\n        Iterator<T> it = loader.iterator();\r\n        if (it.hasNext())\r\n            return it.next();\r\n        return null;\r\n    }\r\n\r\n}\r\n"}], "isError": false, "timestamp": 1791289562035}}
