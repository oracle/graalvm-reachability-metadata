  diff --git a/tests/src/ch.qos.logback/logback-classic/1.2.11/src/test/java/org/graalvm/logback/ContextSelectorStaticBinderTest.java b/tests/src/ch.qos.logback/logback-classic/1.2.11/src/test/java/org/graalvm/logback/ContextSelectorStaticBinderTest.java
  new file mode 100644
  index 00000000000..a7abb919d17
  --- /dev/null
