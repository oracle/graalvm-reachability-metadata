  +    protected void append(ILoggingEvent value) {
  +      event.set(value);
  +      received.countDown();
  +    }
  +
  +    ILoggingEvent awaitEvent() throws InterruptedException {
  +      assertThat(received.await(TIMEOUT_MILLIS, TimeUnit.MILLISECONDS)).isTrue();
  +      return event.get();
  +    }
  +  }
