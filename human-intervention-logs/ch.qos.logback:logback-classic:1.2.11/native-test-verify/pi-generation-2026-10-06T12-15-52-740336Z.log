y()).containsExactly(\"alpha\", null);\n      assertThat(restored.getFormattedMessage()).isEqualTo(\"request alpha returned null\");\n    } finally {\n      context.stop();\n    }\n  }\n}\n"}], "isError": false, "timestamp": 1791289017351}}
