              case 21:
                  return JRE.JAVA_21;
              case 22:
                  return JRE.JAVA_22;
              case 23:
                  return JRE.JAVA_23;
              case 24:
                  return JRE.JAVA_24;
              case 25:
                  return JRE.JAVA_25;
              default:
                  return JRE.OTHER;
          }
      }
  }
