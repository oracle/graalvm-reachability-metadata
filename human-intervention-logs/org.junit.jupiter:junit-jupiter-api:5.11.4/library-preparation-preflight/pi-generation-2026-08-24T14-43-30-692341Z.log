he\n// regular-suite baseline, so the extension delta is the difference.\ntasks.register(\"jacocoCodeCoverageReport\", org.gradle.testing.jacoco.tasks.JacocoReport) {\n    description = \"Generates the combined JaCoCo report for the regular and code-coverage-improvement suites\"\n\n[148 more lines in file. Use offset=935 to continue.]"}], "isError": false, "timestamp": 1787582601099}}
