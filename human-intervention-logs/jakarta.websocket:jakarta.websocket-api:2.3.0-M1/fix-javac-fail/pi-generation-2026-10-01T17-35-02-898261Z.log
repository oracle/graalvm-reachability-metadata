  plugins {
      id 'org.graalvm.internal.tck-base'
      id 'checkstyle'
      id 'java-library'
      id 'org.graalvm.buildtools.native'
      id 'jacoco'
  }
  
  // The per-coordinate test project the harness drives through its lanes: §FS-tests.3
  
  
  // §forge/AR-code-coverage-improvement.4.1
  
  // Coverage-improvement tests are a tracked extension suite in
  // code-coverage-improvement/, kept out of the metadata-generation test source
  // set. Native lanes opt in with -PincludeCodeCoverageSuite=true because the
  // plugin-managed test binary is derived from the test source set.
  File codeCoverageSuiteDir = new File(projectDir, "code-coverage-improvement")
  boolean includeCodeCoverageSuite = providers.gradleProperty("includeCodeCoverageSuite")
          .map { it.toBoolean() }.getOrElse(false)
  
  sourceSets {
      codeCoverage {
          java.srcDir(new File(codeCoverageSuiteDir, "src/test/java"))
          resources.srcDir(new File(codeCoverageSuiteDir, "src/test/resources"))
      }
  }
  
  configurations {
      codeCoverageImplementation.extendsFrom(testImplementation)
      codeCoverageRuntimeOnly.extendsFrom(testRuntimeOnly)
  }
  
  if (includeCodeCoverageSuite) {
      // Widen the test source set for this invocation only, so the native test
      // image executes the regular suite plus the extension suite.
      sourceSets.test.java.srcDir(new File(codeCoverageSuiteDir, "src/test/java"))
      sourceSets.test.resources.srcDir(new File(codeCoverageSuiteDir, "src/test/resources"))
  }
  def skipJacoco = providers.gradleProperty("skipJacoco").map { it.toBoolean() }.getOrElse(false)
  
  repositories {
      mavenLocal()
      mavenCentral()
      maven {
          name = "Confluent"
          url = uri("https://packages.confluent.io/maven/")
      }
  }
  
  Integer explicitTestJvmVersion(File buildFile) {
      if (!buildFile.isFile()) {
          return null
      }
  
      String buildScript = buildFile.getText("UTF-8")
      List<Pattern> explicitVersionPatterns = [
              ~/JavaLanguageVersion\.of\((\d+)\)/,
              ~/jvmToolchain\((\d+)\)/,
              ~/kotlinOptions\.jvmTarget\s*=\s*["'](\d+)["']/,
              ~/options\.release\s*=\s*(\d+)/
      ]
  
      for (Pattern pattern : explicitVersionPatterns) {
          Matcher matcher = pattern.matcher(buildScript)
          if (matcher.find()) {
              return Integer.parseInt(matcher.group(1))
          }
      }
  
      null
  }
  
  int testJvmVersion = explicitTestJvmVersion(project.buildFile) ?: 25
  
