          .getOrElse(false)
  File baseLayerFile = layeredNativeImage ? file(baseLayerFilePath) : null
  if (dedicatedLayer && !layeredNativeImage) {
      throw new GradleException("Property 'tck.dedicatedLayer=true' requires 'tck.baseLayerFile'.")
