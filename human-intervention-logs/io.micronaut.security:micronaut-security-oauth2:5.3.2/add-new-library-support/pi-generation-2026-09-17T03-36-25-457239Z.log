src/io.micronaut.security/micronaut-security-oauth2/5.3.2/build/test-results/test/binary/output.bin\ntests/src/io.micronaut.security/micronaut-security-oauth2/5.3.2/build/test-results/test/binary/output.bin.idx\ntests/src/io.micronaut.security/micronaut-security-oauth2/5.3.2/build/test-results/test/testlist/junit-platform-unique-ids-4821557558790778217.txt\ntests/src/io.micronaut.security/micronaut-security-oauth2/5.3.2/build/libs/io.micronaut.security.micronaut-security-oauth2_tests.jar\ntests/src/io.micronaut.security/micronaut-security-oauth2/5.3.2/build/native/generated/generateTestResourcesConfigFile/resource-config.json\ntests/src/io.micronaut.security/micronaut-security-oauth2/5.3.2/build/native/nativeTestCompile/io.micronaut.security.micronaut-security-oauth2_tests-tests\ntests/src/io.micronaut.security/micronaut-security-oauth2/5.3.2/build/native/nativeTestCompile/libmanagement_ext.so\ntests/src/io.micronaut.security/micronaut-security-oauth2/5.3.2/build/jacoco/test.exec\ntests/src/io.micronaut.security/micronaut-security-oauth2/5.3.2/build/tmp/jar/MANIFEST.MF\ntests/src/io.micronaut.security/micronaut-security-oauth2/5.3.2/build/tmp/compileTestJava/previous-compilation-data.bin\ntests/src/io.micronaut.security/micronaut-security-oauth2/5.3.2/build/reports/jacoco/jacocoCodeCoverageReport/jacocoCodeCoverageReport.xml\ntests/src/io.micronaut.security/micronaut-security-oauth2/5.3.2/build/reports/problems/problems-report.html\ntests/src/io.micronaut.security/micronaut-security-oauth2/5.3.2/build/reports/tests/test/index.html\ntests/src/io.micronaut.security/micronaut-security-oauth2/5.3.2/user-code-filter.json\ntests/src/io.micronaut.security/micronaut-security-oauth2/5.3.2/settings.gradle\ntests/src/io.micronaut.security/micronaut-security-oauth2/5.3.2/gradle.properties\nmetadata/io.micronaut.security/micronaut-security-oauth2/index.json\nmetadata/io.micronaut.security/micronaut-security-oauth2/5.3.2/reachability-metadata.json\n?? metadata/io.micronaut.securi