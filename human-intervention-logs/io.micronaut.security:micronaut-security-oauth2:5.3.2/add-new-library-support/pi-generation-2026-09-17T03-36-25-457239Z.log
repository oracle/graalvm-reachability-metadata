      GrantType(String grantTypeName) {
          this.grantTypeName = grantTypeName;
      }
  
      /**
       *
       * @return The OAuth 2.0. Grant Type
       */
      @Override
      public String toString() {
          return this.grantTypeName;
      }
  }
