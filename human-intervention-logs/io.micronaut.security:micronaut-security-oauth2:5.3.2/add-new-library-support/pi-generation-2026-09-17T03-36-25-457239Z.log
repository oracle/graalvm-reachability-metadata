      @Test
      void programmaticClientConfigurationPreservesEndpointsAndGrantPolicy() {
          OauthClientConfiguration client = OauthClientConfiguration.builder()
                  .name("company")
                  .clientId("client-id")
                  .clientSecret("client-secret")
