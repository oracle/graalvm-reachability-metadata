       */
      public void setProxyWellKnownOauthAuthorizationServer(boolean proxyWellKnownOauthAuthorizationServer) {
          this.proxyWellKnownOauthAuthorizationServer = proxyWellKnownOauthAuthorizationServer;
      }
  
      @Override
