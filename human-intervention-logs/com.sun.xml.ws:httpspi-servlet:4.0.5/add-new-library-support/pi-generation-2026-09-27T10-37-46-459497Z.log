");\n        assertThat(context.getAttribute(\"tenant\")).isNull();\n        assertThat(context.getAttributeNames()).isNull();\n    }\n\n    private static UnsupportedOperationException unsupported() {\n        return new UnsupportedOperationException(\"Not used by this servlet resource test\");\n    }\n\n    private static final class RecordingServletContext implements ServletContext {\n        private final Map<String, URL> resources;\n        private final java.util.List<String> requestedResources = new java.util.ArrayList<>();\n\n        private RecordingServletContext(final Map<String, URL> resources) {\n            this.resources = resources;\n        }\n\n        @Override\n        public URL getResource(final String path) {\n            requestedResources.add(path);\n            return resources.get(path);\n        }\n\n        @Override\n        public Set<String> getResourcePaths(final String path) {\n            return Set.of(\"/WEB-INF/wsdl/greeting.xsd\");\n        }\n\n        @Override\n        public String getContextPath() {\n            throw unsupported();\n        }\n\n        @Override\n        public ServletContext getContext(final String uripath) {\n            throw unsupported();\n        }\n\n        @Override\n        public int getMajorVersion() {\n            throw unsupported();\n        }\n\n        @Override\n        public int getMinorVersion() {\n            throw unsupported();\n        }\n\n        @Override\n        public int getEffectiveMajorVersion() {\n            throw unsupported();\n        }\n\n        @Override\n        public int getEffectiveMinorVersion() {\n            throw unsupported();\n        }\n\n        @Override\n        public String getMimeType(final String file) {\n            throw unsupported();\n        }\n\n        @Override\n        public InputStream getResourceAsStream(final String path) {\n            throw unsupported();\n        }\n\n        @Override\n        public RequestDispatcher getRequestD