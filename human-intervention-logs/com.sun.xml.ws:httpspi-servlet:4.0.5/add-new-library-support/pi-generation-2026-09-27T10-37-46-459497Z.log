  + * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.
  + */
  +package com_sun_xml_ws.httpspi_servlet;
  +
  +import static org.assertj.core.api.Assertions.assertThat;
  +
  +import java.io.ByteArrayInputStream;
  +import java.io.IOException;
  +import java.net.MalformedURLException;
  +import java.net.URL;
  +import java.nio.charset.StandardCharsets;
  +import java.util.List;
  +import java.util.Set;
  +
  +import javax.xml.namespace.QName;
  +
  +import com.sun.xml.ws.transport.httpspi.servlet.DeploymentDescriptorParser;
  +import com.sun.xml.ws.transport.httpspi.servlet.EndpointAdapter;
  +import com.sun.xml.ws.transport.httpspi.servlet.EndpointAdapterFactory;
  +import com.sun.xml.ws.transport.httpspi.servlet.ResourceLoader;
  +import jakarta.jws.WebMethod;
  +import jakarta.jws.WebService;
  +import jakarta.xml.ws.Endpoint;
  +import jakarta.xml.ws.soap.MTOMFeature;
  +import jakarta.xml.ws.soap.SOAPBinding;
  +import org.junit.jupiter.api.Test;
  +
  +@WebService(
  +        serviceName = "GreetingService",
  +        portName = "GreetingPort",
  +        targetNamespace = HttpspiServletTest.NAMESPACE)
  +public class HttpspiServletTest {
  +    static final String NAMESPACE = "urn:httpspi-servlet-test";
  +
  +    @Test
  +    void createsAndPublishesEndpointFromDeploymentDescriptor() throws IOException {
  +        String descriptor = """
  +                <?xml version="1.0" encoding="UTF-8"?>
  +                <endpoints xmlns="http://java.sun.com/xml/ns/jax-ws/ri/runtime" version="2.0">
  +                  <endpoint name="greeting"
  +                            implementation="%s"
  +                            service="{%s}GreetingService"
  +                            port="{%s}GreetingPort"
  +                            binding="##SOAP11_HTTP"
  +                            enable-mtom="true"
  +                            mtom-threshold-value="512"
  +                            url-pattern="/greetings/*"/>
  +                </endpoints>
  +                """.formatted(getClass().getName(), NAMESPACE, NAMESPACE);
  +        DeploymentDescriptorParser<EndpointAdapter> parser = new DeploymentDescriptorParser<>(
  +                getClass().getClassLoader(), new EmptyResourceLoader(), new EndpointAdapterFactory());
  +
  +        List<EndpointAdapter> adapters = parser.parse(
  +                "memory:/WEB-INF/sun-jaxws.xml",
  +                new ByteArrayInputStream(descriptor.getBytes(StandardCharsets.UTF_8)));
  +
  +        assertThat(adapters).hasSize(1);
  +        EndpointAdapter adapter = adapters.get(0);
  +        Endpoint endpoint = adapter.getEndpoint();
  +        assertThat(adapter.getUrlPattern()).isEqualTo("/greetings/*");
  +        assertThat(adapter.getValidPath()).isEqualTo("/greetings");
  +        assertThat(adapter.getContext().getPath()).isEqualTo("/greetings/*");
  +        assertThat(endpoint.getProperties())
  +                .containsEntry(Endpoint.WSDL_SERVICE, new QName(NAMESPACE, "GreetingService"))
