  package com_sun_xml_ws.httpspi_servlet;
  
  import static org.assertj.core.api.Assertions.assertThat;
  
  import javax.xml.namespace.QName;
  import javax.xml.transform.Source;
  
  import com.sun.xml.ws.transport.httpspi.servlet.EndpointAdapter;
  import com.sun.xml.ws.transport.httpspi.servlet.EndpointAdapterFactory;
  import jakarta.xml.ws.BindingType;
  import jakarta.xml.ws.Endpoint;
  import jakarta.xml.ws.Provider;
  import jakarta.xml.ws.WebServiceProvider;
  import jakarta.xml.ws.http.HTTPBinding;
  import org.junit.jupiter.api.Test;
  
  public class EndpointAdapterFactoryTest {
      private static final String NAMESPACE = "https://example.test/greetings";
  
      @Test
      void createsAndPublishesXmlHttpEndpointOnServletHttpContext() {
          GreetingEndpoint.instances = 0;
          QName serviceName = new QName(NAMESPACE, "GreetingService");
          QName portName = new QName(NAMESPACE, "GreetingPort");
          EndpointAdapter adapter = new EndpointAdapterFactory()
                  .createAdapter(
                          "greeting",
                          "/services/greeting/*",
                          GreetingEndpoint.class,
                          serviceName,
                          portName,
                          HTTPBinding.HTTP_BINDING,
                          null);
          Endpoint endpoint = adapter.getEndpoint();
  
          assertThat(GreetingEndpoint.instances).isOne();
          assertThat(adapter.getUrlPattern()).isEqualTo("/services/greeting/*");
          assertThat(adapter.getValidPath()).isEqualTo("/services/greeting");
          assertThat(adapter.getContext().getPath()).isEqualTo("/services/greeting/*");
          assertThat(endpoint.getBinding().getBindingID()).isEqualTo(HTTPBinding.HTTP_BINDING);
          assertThat(endpoint.getProperties())
                  .containsEntry(Endpoint.WSDL_SERVICE, serviceName)
                  .containsEntry(Endpoint.WSDL_PORT, portName);
          assertThat(endpoint.isPublished()).isFalse();
  
          try {
              adapter.publish();
              assertThat(endpoint.isPublished()).isTrue();
          } finally {
              if (endpoint.isPublished()) {
                  adapter.dispose();
              }
          }
  
          assertThat(endpoint.isPublished()).isFalse();
      }
  
      @WebServiceProvider(
              serviceName = "GreetingService",
              portName = "GreetingPort",
              targetNamespace = NAMESPACE)
      @BindingType(HTTPBinding.HTTP_BINDING)
      public static class GreetingEndpoint implements Provider<Source> {
          private static int instances;
  
          public GreetingEndpoint() {
              instances++;
          }
  
          @Override
          public Source invoke(final Source request) {
              return request;
          }
      }
  }
