VfNosgzf4L9DFUr2qW5qLV|fc_0a19a31c301a8172016ab8f52c353c87d28ae367f31b49c9d6", "name": "write", "arguments": {"path": "tests/src/com.sun.xml.ws/httpspi-servlet/4.0.5/src/test/java/com_sun_xml_ws/httpspi_servlet/EndpointAdapterFactoryTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage com_sun_xml_ws.httpspi_servlet;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport javax.xml.namespace.QName;\n\nimport com.sun.xml.ws.transport.httpspi.servlet.EndpointAdapter;\nimport com.sun.xml.ws.transport.httpspi.servlet.EndpointAdapterFactory;\nimport jakarta.jws.WebMethod;\nimport jakarta.jws.WebParam;\nimport jakarta.jws.WebService;\nimport jakarta.xml.ws.Endpoint;\nimport jakarta.xml.ws.soap.SOAPBinding;\nimport org.junit.jupiter.api.Test;\n\npublic class EndpointAdapterFactoryTest {\n    private static final String NAMESPACE = \"https://example.test/greetings\";\n\n    @Test\n    void createsAndPublishesSoapEndpointOnServletHttpContext() {\n        QName serviceName = new QName(NAMESPACE, \"GreetingService\");\n        QName portName = new QName(NAMESPACE, \"GreetingPort\");\n        EndpointAdapter adapter = new EndpointAdapterFactory()\n                .createAdapter(\n                        \"greeting\",\n                        \"/services/greeting/*\",\n                        GreetingEndpoint.class,\n                        serviceName,\n                        portName,\n                        SOAPBinding.SOAP11HTTP_BINDING,\n                        null);\n        Endpoint endpoint = adapter.getEndpoint();\n\n        assertThat(adapter.getUrlPattern()).isEqualTo(\"/services/greeting/*\");\n        assertThat(adapter.getValidPath()).isEqualTo(\"/services/greeting\");\n        assertThat(adapter.getContext().getPath()).isEqualTo(\"/services/greeting/*\");\n        assertThat(endpoint.getProperties())\n                .containsEntry(Endpoint.WSDL_SERVICE, serviceName)\n                .containsEntry(Endpoint.WSDL_PORT, portName);\n        assertThat(endpoint.isPublished()).isFalse();\n\n        try {\n            adapter.publish();\n            assertThat(endpoint.isPublished()).isTrue();\n        } finally {\n            if (endpoint.isPublished()) {\n                adapter.dispose();\n            }\n        }\n\n        assertThat(endpoint.isPublished()).isFalse();\n    }\n\n    @WebService(\n            serviceName = \"GreetingService\",\n            portName = \"GreetingPort\",\n            targetNamespace = NAMESPACE)\n    public static class GreetingEndpoint {\n        @WebMethod\n        public String greet(@WebParam(name = \"name\") final String name) {\n            return \"Hello, \" + name;\n        }\n    }\n}\n"}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-sol", "usage": {"input": 735, "output": 1160, "cacheRead": 62848, "cacheWrite": 0, "reasoning": 516, "totalTokens": 64743, "cost": {"input": 0.00294, "output": 0.023200000000000002, "cacheRead": 0.025139200000000004, "cacheWrite": 0, "total": 0.05127920000000001}}, "stopReason": "toolUse", "timestamp": 1790506268763, "responseId": "resp_0a19a31c301a8172016ab8f51cee3487d29ea8175d7880a54c", "rawStopReason": "completed"}, "toolResults": [{"role": "toolResult", "toolCallId": "call_1XVfNosgzf4L9DFUr2qW5qLV|fc_0a19a31c301a8172016ab8f52c353c87d28ae367f31b49c9d6", "toolName": "write", "content": [{"type": "text", "text": "Successfully wrote to tests/src/com.sun.xml.ws/httpspi-servlet/4.0.5/src/test/java/com_sun_xml_ws/httpspi_servlet/EndpointAdapterFactoryTest.java"}], "isError": false, "timestamp": 1790506292013}]}
