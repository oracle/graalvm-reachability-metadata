lidPath()).isEqualTo(\"/health\");\n        assertThat(adapter.getContext().getPath()).isEqualTo(\"/health\");\n    }\n\n    private static final class RecordingEndpoint extends Endpoint {\n        private HttpContext publishedContext;\n        private boolean published;\n\n        @Override\n        public Binding getBinding() {\n            throw unsupported();\n        }\n\n        @Override\n        public Object getImplementor() {\n            throw unsupported();\n        }\n\n        @Override\n        public void publish(final String address) {\n            throw unsupported();\n        }\n\n        @Override\n        public void publish(final Object serverContext) {\n            throw unsupported();\n        }\n\n        @Override\n        public void publish(final HttpContext serverContext) {\n            publishedContext = serverContext;\n            published = true;\n        }\n\n        @Override\n        public void stop() {\n            published = false;\n        }\n\n        @Override\n        public boolean isPublished() {\n            return published;\n        }\n\n        @Override\n        public List<Source> getMetadata() {\n            throw unsupported();\n        }\n\n        @Override\n        public void setMetadata(final List<Source> metadata) {\n            throw unsupported();\n        }\n\n        @Override\n        public Executor getExecutor() {\n            throw unsupported();\n        }\n\n        @Override\n        public void setExecutor(final Executor executor) {\n            throw unsupported();\n        }\n\n        @Override\n        public Map<String, Object> getProperties() {\n            throw unsupported();\n        }\n\n        @Override\n        public void setProperties(final Map<String, Object> properties) {\n            throw unsupported();\n        }\n\n        @Override\n        public EndpointReference getEndpointReference(final Element... referenceParameters) {\n            throw unsupported();\n        }\n\n        @Override\n        public <T extends EndpointReference> T getEndpointReference(\n                final Class<T> clazz, final Element... referenceParameters) {\n            throw unsupported();\n        }\n    }\n\n    private static UnsupportedOperationException unsupported() {\n        return new UnsupportedOperationException(\"Not used by this HTTP SPI adapter test\");\n    }\n}\n"}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-sol", "usage": {"input": 857, "output": 996, "cacheRead": 112256, "cacheWrite": 0, "reasoning": 34, "totalTokens": 114109, "cost": {"input": 0.003428, "output": 0.01992, "cacheRead": 0.0449024, "cacheWrite": 0, "total": 0.0682504}}, "stopReason": "toolUse", "timestamp": 1790505826917, "responseId": "resp_08823abdfe6d22c6016ab8f3631b7c87d2ba594c49ab7933dc", "rawStopReason": "completed"}, "toolResults": [{"role": "toolResult", "toolCallId": "call_Ho48v0HjG2Wfs3QS3isw6fGC|fc_08823abdfe6d22c6016ab8f3669f3887d2acb305a40f02c42a", "toolName": "write", "content": [{"type": "text", "text": "Successfully wrote to tests/src/com.sun.xml.ws/httpspi-servlet/4.0.5/src/test/java/com_sun_xml_ws/httpspi_servlet/HttpspiServletTest.java"}], "isError": false, "timestamp": 1790505847553}]}
