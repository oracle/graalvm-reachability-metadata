ebService;\nimport jakarta.xml.ws.Endpoint;\nimport jakarta.xml.ws.soap.SOAPBinding;\nimport jakarta.xml.ws.spi.http.HttpContext;\nimport org.junit.jupiter.api.Test;\n\npublic class Httpspi_servletTest {\n    @Test\n    void supportsCaseInsensitiveMultiValueHeaders() {\n        Headers headers = new Headers();\n\n        headers.add(\"x-request-ID\", \"first\");\n        headers.add(\"X-Request-id\", \"second\");\n\n        assertThat(headers).containsKey(\"X-REQUEST-ID\");\n        assertThat(headers.getFirst(\"x-request-id\")).isEqualTo(\"first\");\n        assertThat(headers.get(\"X-Request-ID\")).containsExactly(\"first\", \"second\");\n\n        headers.set(\"X-Request-ID\", \"replacement\");\n        assertThat(headers.get(\"x-request-id\")).containsExactly(\"replacement\");\n\n        headers.put(\"Content-Type\", List.of(\"text/plain\"));\n        assertThat(headers.entrySet()).hasSize(2);\n        assertThat(headers.remove(\"CONTENT-TYPE\")).containsExactly(\"text/plain\");\n    }\n\n    @Test\n    void exposesEndpointContextAndValidUrlMapping() {\n        EndpointAdapter adapter = new EndpointAdapter(null, \"/echo/*\");\n        HttpContext context = adapter.getContext();\n\n        assertThat(adapter.getEndpoint()).isNull();\n        assertThat(adapter.getUrlPattern()).isEqualTo(\"/echo/*\");\n        assertThat(adapter.getValidPath()).isEqualTo(\"/echo\");\n        assertThat(context).isInstanceOf(EndpointHttpContext.class);\n        assertThat(context.getPath()).isEqualTo(\"/echo/*\");\n        assertThat(context.getAttribute(\"missing\")).isNull();\n        assertThat(context.getAttributeNames()).isNull();\n\n        EndpointAdapter exactMapping = new EndpointAdapter(null, \"/exact\");\n        assertThat(exactMapping.getValidPath()).isEqualTo(\"/exact\");\n    }\n\n    @Test\n    void createsPublishesAndDisposesEndpointAdapter() {\n        EndpointAdapter adapter = new EndpointAdapterFactory().createAdapter(\n                \"echo\", \"/echo/*\", EchoEndpoint.class, new QName(\"urn:echo\", \"EchoService\"),\n                new QName(\"urn:echo\", \"EchoPort\"), SOAPBinding.SOAP11HTTP_BINDING, List.of());\n        Endpoint endpoint = adapter.getEndpoint();\n\n        try {\n            assertThat(endpoint.getEndpointContext().getEndpoints()).containsExactly(endpoint);\n            assertThat(endpoint.isPublished()).isFalse();\n\n            adapter.publish();\n\n            assertThat(endpoint.isPublished()).isTrue();\n        } finally {\n            adapter.dispose();\n        }\n\n        assertThat(endpoint.isPublished()).isFalse();\n    }\n\n    @WebService\n    public static class EchoEndpoint {\n        @WebMethod\n        public String echo(String message) {\n            return message;\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1790964623411}, {"role": "toolResult", "toolCallId": "call_Dm2umCdaEbBTyEdO4qwyUXNc|fc_052048e484730eb7016abff38f182c87d18d9e948ed8210726", "toolName": "bash", "content": [{"type": "text", "text": "diff --git a/tests/src/com.sun.xml.ws/httpspi-servlet/4.0.5/src/test/java/com_sun_xml_ws/httpspi_servlet/Httpspi_servletTest.java b/tests/src/com.sun.xml.ws/httpspi-servlet/4.0.5/src/test/java/com_sun_xml_ws/httpspi_servlet/Httpspi_servletTest.java\nindex 9d917edafa..21ab124239 100644\n--- a/tests/src/com.sun.xml.ws/httpspi-servlet/4.0.5/src/test/java/com_sun_xml_ws/httpspi_servlet/Httpspi_servletTest.java\n+++ b/tests/src/com.sun.xml.ws/httpspi-servlet/4.0.5/src/test/java/com_sun_xml_ws/httpspi_servlet/Httpspi_servletTest.java\n@@ -10,9 +10,16 @@ import static org.assertj.core.api.Assertions.assertThat;\n \n import java.util.List;\n \n+import javax.xml.namespace.QName;\n+\n import com.sun.xml.ws.transport.httpspi.servlet.EndpointAdapter;\n+import com.sun.xml.ws.transport.httpspi.servlet.EndpointAdapterFactory;\n import com.sun.xml.ws.transport.httpspi.servlet.EndpointHttpContext;\n import com.sun.xml.ws.transport.httpspi.servlet.Headers;\n+import jakarta.jws.WebMethod;