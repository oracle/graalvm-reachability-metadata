irk5jkMMjeZCMFkxHS|fc_0dd31ada8d0a3c86016abff09f630487d1a7d8ae3fe808c91b", "name": "read", "arguments": {"path": ".agents/fissile.toml"}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-luna", "usage": {"input": 1417, "output": 673, "cacheRead": 107008, "cacheWrite": 0, "reasoning": 648, "totalTokens": 109098, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1790963858098, "responseId": "resp_0dd31ada8d0a3c86016abff092a71c87d19a709a93f51c572a", "rawStopReason": "completed"}, "toolResults": [{"role": "toolResult", "toolCallId": "call_ok83cQirk5jkMMjeZCMFkxHS|fc_0dd31ada8d0a3c86016abff09f630487d1a7d8ae3fe808c91b", "toolName": "read", "content": [{"type": "text", "text": "# fissile configuration.\n#\n# Scoped to the hand-written infrastructure only: forge/ (Python automation),\n# tests/tck-build-logic/ (Java/Groovy/Gradle harness build logic), and the\n# repository docs. Everything else — shipped metadata, per-library test\n# projects, generated stats — is deliberately outside the budget system.\n\nfissile_config_version = 1\n\n[scan]\n# `audit` walks these roots; `check --staged` ignores them and takes its file\n# set from git. Both honor `exclude` and `.gitignore`. The default walks the\n# whole repository so adoption needs no layout guess; narrow it to specific\n# roots once you know which directories are worth auditing.\ninclude = [\"forge\", \"tests/tck-build-logic\", \"docs\"]\nexclude = [\n  # Transient agent-run workspaces and their generated reports live under\n  # forge/ but are outputs, not hand-written infrastructure.\n  \"forge/code-coverage-*/**\",\n  \"forge/local_repositories/**\",\n  \"target/**\",\n  \"node_modules/**\",\n  \".git/**\",\n  \"dist/**\",\n  \"build/**\",\n  \"vendor/**\",\n  \"**/*.lock\",\n  \"**/*.min.*\",\n  \"**/*.png\",\n  \"**/*.jpg\",\n  \"**/*.jpeg\",\n  \"**/*.gif\",\n  \"**/*.webp\",\n  \"**/*.pdf\",\n]\nrespect_gitignore = true\n\n[output]\nformat = \"text\" # text | json\ncolor = \"auto\"  # auto | always | never\nsuccess = \"ok\"\n\n[exceptions]\nsoft_registry = \"docs/file-size-agent-exceptions.toml\"\nhard_registry = \"docs/file-size-human-exceptions.toml\"\n# What to do about an exception entry that has outlived its file. Both `check`\n# and `audit --stale-exceptions` report under this key, so `error` fails a\n# commit as well as a CI audit.\nstale = \"warn\" # warn | error | ignore\n\n# A ceiling written by `exception add` or `exception retune` is rounded up to\n# this step, so it reads as a decision rather than as whatever the file measured\n# that day. The same step is the slack `audit --stale-exceptions` tolerates\n# before calling a ceiling loose. Set a unit to 1 to record exact measurements.\n[exceptions.bump]\nlines = 100\nbytes = 4096\ntokens = 1000\n\n[tokens]\n# Token budgets are opt-in; bytes and lines work without external tooling.\nenabled = false\ncommand = [\"token-counter\", \"--count\", \"{path}\"]\n\n# Messages are the part of this file worth rewriting first: they are what the\n# check teaches when it fires. The defaults below are deliberately generic —\n# they know nothing about this repository's layout. Replace them with guidance\n# that names real destinations (\"move transport code under src/api/\"), and, if\n# this project keeps architecture docs with stable IDs, point at the one that\n# decides where extracted code belongs. Cite only IDs declared in *this*\n# repository; an ID borrowed from another project resolves nowhere here.\n#\n# Soft and hard are separate messages on purpose: a warning asks for a split\n# next time the file is touched, a block has to say what to do when no safe\n# split exists. Keep both escape hatches in the text — a rule that only ever\n# says \"split this\" gets satisfied by bad splits.\n#\n# Where a message names the exception route, keep it saying what the reason has\n# to establish, not merely that a reason is required: \"record the debt\" reads as\n# satisfied by any sentence, and what comes back is a description of the file.\n#\n# `{path}` and `{actual}` differ per file, so a message using either is printed\n# once per file instead of once per group. `{rule}`, `{severity}`, `{limit}`,\n# and `{unit}` are constant within a group and stay grouped.\n\n[[messages]]\nid = \"split-source-soft\"\ntext = \"\"\"\nShould split, next time you are in one of these files: move a cohesive group of items into a sibling module. Split along a responsibility seam, never at the line count, and never break apart code that belongs together. Never split a class into mixin bases sharing self — a boundary that exists only on disk is not a split.\nIf no split leaves the design better than it is now, record why instead of forcing one — not what the file contains, which is what this finding already said. Name the constraint that makes splitting illegal (--kind structural), or the boundary that is missing and what must exist first (--kind deferred, --until naming what retires it):\nfissile exception add <path> --severity soft --rule {rule} --kind <kind>\n\"\"\"\n\n[[messages]]\nid = \"split-source-hard\"\ntext = \"\"\"\nMust split before more code lands here: move cohesive groups of items into sibling modules along seams that already exist. Do not invent an abstraction, flatten a boundary, or shuffle lines to get under the limit — a worse design under budget is not the goal. Never split a class into mixin bases sharing self, and never carve out a helper module that only its parent imports back wholesale.\nIf you cannot see a split that leaves the architecture intact, stop and ask a human. The only other way past this gate is a human-reviewed exception, whose reason names the constraint that makes splitting illegal (--kind structural) or the boundary that is missing and what must exist first (--kind deferred):\nfissile exception add <path> --severity hard --rule {rule} --kind <kind>\n\"\"\"\n\n[[messages]]\nid = \"split-doc-soft\"\ntext = \"\"\"\nShould split, next time you edit one of these documents: keep one focused subject per file and move secondary detail into a child document the parent links.\nIf the document has to be read whole, record it rather than cutting it up — naming what makes it indivisible (--kind structural), or the child document that does not exist yet (--kind deferred, --until naming what retires it):\nfissile exception add <path> --severity soft --rule {rule} --kind <kind>\n\"\"\"\n\n[[messages]]\nid = \"split-doc-hard\"\ntext = \"\"\"\nMust split before adding more: move secondary detail into child documents the parent links, leaving one focused subject per file.\nIf no split keeps the document coherent, ask a human rather than cutting at an arbitrary heading; a human-reviewed exception is the alternative:\nfissile exception add <path> --severity hard --rule {rule}\n\"\"\"\n\n[[messages]]\nid = \"large-file-soft\"\ntext = \"\"\"\nLarge for a hand-written file. If it is generated, vendored, or binary, add it to [scan].exclude — the budget system should not reason about it at all. If it is real content, give it a rule of its own with a limit and guidance that fit it.\n\"\"\"\n\n[[messages]]\nid = \"large-file-hard\"\ntext = \"\"\"\nVery large file. Exclude it in [scan].exclude if it is generated, vendored, or binary; give it its own rule if this file type is simply bigger than the catch-all assumes.\nIf it is hand-written content that has to stay this size, that is a human's call, and the exception names what makes it indivisible (--kind structural) or what must exist before it can be split (--kind deferred):\nfissile exception add <path> --severity hard --rule {rule} --kind <kind>\n\"\"\"\n\n[[rules]]\nid = \"large-file-default\"\ninclude = [\"forge/**/*\", \"tests/tck-build-logic/**/*\", \"docs/**/*\"]\nunit = \"bytes\"\nsoft = 524288\nhard = 1048576\nsoft_message = \"large-file-soft\"\nhard_message = \"large-file-hard\"\n\n# Hand-written source in the two infrastructure roots: Forge's Python\n# automation and the TCK harness's Java/Groovy/Gradle build logic. Data and\n# generated formats (.json, .yaml, .csv) are deliberately absent — they fall\n# to the byte catch-all, because a large generated file is not the same\n# problem as a large hand-written module.\n[[rules]]\nid = \"source\"\ninclude = [\n  \"forge/**/*.py\",\n  \"tests/tck-build-logic/**/*.java\",\n  \"tests/tck-build-logic/**/*.groovy\",\n  \"tests/tck-build-logic/**/*.gradle\",\n]\nunit = \"lines\"\nsoft = 450\nhard = 700\ncount_blank_lines = false\ncount_comment_lines = true\nsoft_message = \"split-source-soft\"\nhard_message = \"split-source-hard\"\n\n[[rules]]\nid = \"markdown-docs\"\ninclude = [\"docs/**/*.md\", \"forge/**/*.md\", \"tests/tck-build-logic/**/*.md\"]\nunit = \"lines\"\nsoft = 250\nhard = 500\ncount_blank_lines = false\ncount_comment_lines = true\nsoft_message = \"split-doc-soft\"\nhard_message = \"split-doc-hard\"\n"}], "isError": false, "timestamp": 1790963871654}]}
