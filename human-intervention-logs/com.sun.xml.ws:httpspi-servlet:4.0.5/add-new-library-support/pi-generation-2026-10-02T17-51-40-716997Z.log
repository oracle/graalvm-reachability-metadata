EndpointAdapter adapter = new EndpointAdapter(null, \"/echo/*\");\n        HttpContext context = adapter.getContext();\n\n        assertThat(adapter.getEndpoint()).isNull();\n        assertThat(adapter.getUrlPattern()).isEqualTo(\"/echo/*\");\n        assertThat(adapter.getValidPath()).isEqualTo(\"/echo\");\n        assertThat(context).isInstanceOf(EndpointHttpContext.class);\n        assertThat(context.getPath()).isEqualTo(\"/echo/*\");\n        assertThat(context.getAttribute(\"missing\")).isNull();\n        assertThat(context.getAttributeNames()).isNull();\n\n        EndpointAdapter exactMapping = new EndpointAdapter(null, \"/exact\");\n        assertThat(exactMapping.getValidPath()).isEqualTo(\"/exact\");\n    }\n\n    @Test\n    void createsPublishesAndDisposesEndpointAdapter() {\n        EndpointAdapter adapter = new EndpointAdapterFactory().createAdapter(\n                \"echo\", \"/echo/*\", EchoEndpoint.class, new QName(\"urn:echo\", \"EchoService\"),\n                new QName(\"urn:echo\", \"EchoPort\"), SOAPBinding.SOAP11HTTP_BINDING, List.of());\n        Endpoint endpoint = adapter.getEndpoint();\n\n        try {\n            assertThat(endpoint.getEndpointContext().getEndpoints()).containsExactly(endpoint);\n            assertThat(endpoint.isPublished()).isFalse();\n\n            adapter.publish();\n\n            assertThat(endpoint.isPublished()).isTrue();\n        } finally {\n            adapter.dispose();\n        }\n\n        assertThat(endpoint.isPublished()).isFalse();\n    }\n\n    @WebService\n    public static class EchoEndpoint {\n        @WebMethod\n        public String echo(String message) {\n            return message;\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1790964623411}}
