[tool-call] delta {"path":"tests/src/com.sun.xml.ws/httpspi-servlet/4.0.5/src/test/java/com_sun_xml_ws/httpspi_servlet/Httpspi_servletTest.java","edits":[{"oldText":"import java.util.List;\n\nimport com.sun.xml.ws.transport.httpspi.servlet.EndpointAdapter;\nimport com.sun.xml.ws.transport.httpspi.servlet.EndpointHttpContext;\nimport com.sun.xml.ws.transport.httpspi.servlet.Headers;\nimport jakarta.xml.ws.spi.http.HttpContext;\nimport org.junit.jupiter.api.Test;\n","newText":"import java.util.List;\n\nimport javax.xml.namespace.QName;\n\nimport com.sun.xml.ws.transport.httpspi.servlet.EndpointAdapter;\nimport com.sun.xml.ws.transport.httpspi.servlet.EndpointAdapterFactory;\nimport com.sun.xml.ws.transport.httpspi.servlet.EndpointHttpContext;\nimport com.sun.xml.ws.transport.httpspi.servlet.Headers;\nimport jakarta.jws.WebMethod;\nimport jakarta.jws.WebService;\nimport jakarta.xml.ws.Endpoint;\nimport jakarta.xml.ws.soap.SOAPBinding;\nimport jakarta.xml.ws.spi.http.HttpContext;\nimport org.junit.jupiter.api.Test;\n"},{"oldText":"    @Test\n    void exposesEndpointContextAndValidUrlMapping() {\n        EndpointAdapter adapter = new EndpointAdapter(null, \"/echo/*\");\n        HttpContext context = adapter.getContext();\n\n        assertThat(adapter.getEndpoint()).isNull();\n        assertThat(adapter.getUrlPattern()).isEqualTo(\"/echo/*\");\n        assertThat(adapter.getValidPath()).isEqualTo(\"/echo\");\n        assertThat(context).isInstanceOf(EndpointHttpContext.class);\n        assertThat(context.getPath()).isEqualTo(\"/echo/*\");\n        assertThat(context.getAttribute(\"missing\")).isNull();\n        assertThat(context.getAttributeNames()).isNull();\n\n        EndpointAdapter exactMapping = new EndpointAdapter(null, \"/exact\");\n        assertThat(exactMapping.getValidPath()).isEqualTo(\"/exact\");\n    }\n}","newText":"    @Test\n    void exposesEndpointContextAndValidUrlMapping() {\n        EndpointAdapter adapter = new EndpointAdapter(null, \"/echo/*\");\n        HttpContext context = adapter.getContext();\n\n        assertThat(adapter.getEndpoint()).isNull();\n        assertThat(adapter.getUrlPattern()).isEqualTo(\"/echo/*\");\n        assertThat(adapter.getValidPath()).isEqualTo(\"/echo\");\n        assertThat(context).isInstanceOf(EndpointHttpContext.class);\n        assertThat(context.getPath()).isEqualTo(\"/echo/*\");\n        assertThat(context.getAttribute(\"missing\")).isNull();\n        assertThat(context.getAttributeNames()).isNull();\n\n        EndpointAdapter exactMapping = new EndpointAdapter(null, \"/exact\");\n        assertThat(exactMapping.getValidPath()).isEqualTo(\"/exact\");\n    }\n\n    @Test\n    void createsPublishesAndDisposesEndpointAdapter() {\n        EndpointAdapter adapter = new EndpointAdapterFactory().createAdapter(\n                \"echo\", \"/echo/*\", EchoEndpoint.class, new QName(\"urn:echo\", \"EchoService\"),\n                new QName(\"urn:echo\", \"EchoPort\"), SOAPBinding.SOAP11HTTP_BINDING, List.of());\n        Endpoint endpoint = adapter.getEndpoint();\n\n        try {\n            assertThat(endpoint.getEndpointContext().getEndpoints()).containsExactly(endpoint);\n            assertThat(endpoint.isPublished()).isFalse();\n\n            adapter.publish();\n\n            assertThat(endpoint.isPublished()).isTrue();\n        } finally {\n            adapter.dispose();\n        }\n\n        assertThat(endpoint.isPublished()).isFalse();\n    }\n\n    @WebService\n    public static class EchoEndpoint {\n        @WebMethod\n        public String echo(String message) {\n            return message;\n        }\n    }\n}"}]}
[tool-call] end id=call_8gsNnk4dsyX9A2q28rkq5Fgz|fc_052048e484730eb7016abff37609ec87d1b5638716b8b85ff4 name=edit args={"path": "tests/src/com.sun.xml.ws/httpspi-servlet/4.0.5/src/test/java/com_sun_xml_ws/httpspi_servlet/Httpspi_servletTest.java", "edits": [{"oldText": "import java.util.List;\n\nimport com.sun.xml.ws.transport.httpspi.servlet.EndpointAdapter;\nimport com.sun.xml.ws.transport.httpspi.servlet.EndpointHttpContext;\nimport com.sun.xml.ws.transport.httpspi.servlet.Headers;\nimport jakarta.xml.ws.spi.http.HttpContext;\nimport org.junit.jupiter.api.Test;\n", "newText": "import java.util.List;\n\nimport javax.xml.namespace.QName;\n\nimport com.sun.xml.ws.transport.httpspi.servlet.EndpointAdapter;\nimport com.sun.xml.ws.transport.httpspi.servlet.EndpointAdapterFactory;\nimport com.sun.xml.ws.transport.httpspi.servlet.EndpointHttpContext;\nimport com.sun.xml.ws.transport.httpspi.servlet.Headers;\nimport jakarta.jws.WebMethod;\nimport jakarta.jws.WebService;\nimport jakarta.xml.ws.Endpoint;\nimport jakarta.xml.ws.soap.SOAPBinding;\nimport jakarta.xml.ws.spi.http.HttpContext;\nimport org.junit.jupiter.api.Test;\n"}, {"oldText": "    @Test\n    void exposesEndpointContextAndValidUrlMapping() {\n        EndpointAdapter adapter = new EndpointAdapter(null, \"/echo/*\");\n        HttpContext context = adapter.getContext();\n\n        assertThat(adapter.getEndpoint()).isNull();\n        assertThat(adapter.getUrlPattern()).isEqualTo(\"/echo/*\");\n        assertThat(adapter.getValidPath()).isEqualTo(\"/echo\");\n        assertThat(context).isInstanceOf(EndpointHttpContext.class);\n        assertThat(context.getPath()).isEqualTo(\"/echo/*\");\n        assertThat(context.getAttribute(\"missing\")).isNull();\n        assertThat(context.getAttributeNames()).isNull();\n\n        EndpointAdapter exactMapping = new EndpointAdapter(null, \"/exact\");\n        assertThat(exactMapping.getValidPath()).isEqualTo(\"/exact\");\n    }\n}", "newText": "    @Test\n    void exposesEndpointContextAndValidUrlMapping() {\n        EndpointAdapter adapter = new EndpointAdapter(null, \"/echo/*\");\n        HttpContext context = adapter.getContext();\n\n        assertThat(adapter.getEndpoint()).isNull();\n        assertThat(adapter.getUrlPattern()).isEqualTo(\"/echo/*\");\n        assertThat(adapter.getValidPath()).isEqualTo(\"/echo\");\n        assertThat(context).isInstanceOf(EndpointHttpContext.class);\n        assertThat(context.getPath()).isEqualTo(\"/echo/*\");\n        assertThat(context.getAttribute(\"missing\")).isNull();\n        assertThat(context.getAttributeNames()).isNull();\n\n        EndpointAdapter exactMapping = new EndpointAdapter(null, \"/exact\");\n        assertThat(exactMapping.getValidPath()).isEqualTo(\"/exact\");\n    }\n\n    @Test\n    void createsPublishesAndDisposesEndpointAdapter() {\n        EndpointAdapter adapter = new EndpointAdapterFactory().createAdapter(\n                \"echo\", \"/echo/*\", EchoEndpoint.class, new QName(\"urn:echo\", \"EchoService\"),\n                new QName(\"urn:echo\", \"EchoPort\"), SOAPBinding.SOAP11HTTP_BINDING, List.of());\n        Endpoint endpoint = adapter.getEndpoint();\n\n        try {\n            assertThat(endpoint.getEndpointContext().getEndpoints()).containsExactly(endpoint);\n            assertThat(endpoint.isPublished()).isFalse();\n\n            adapter.publish();\n\n            assertThat(endpoint.isPublished()).isTrue();\n        } finally {\n            adapter.dispose();\n        }\n\n        assertThat(endpoint.isPublished()).isFalse();\n    }\n\n    @WebService\n    public static class EchoEndpoint {\n        @WebMethod\n        public String echo(String message) {\n            return message;\n        }\n    }\n}"}]}
