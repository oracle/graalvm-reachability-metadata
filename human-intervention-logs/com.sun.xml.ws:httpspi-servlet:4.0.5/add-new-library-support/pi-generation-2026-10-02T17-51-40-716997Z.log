YvzAPQbUxs1I9im985cmGft8PYKgCw8lhdSdW8LWs5y4Wl9m3MAihosnfyBNwJzoPZ8K1TyxQKjw6gxN6zddWKva38RNDN06OzyGD8bjgptPOP2YQ2ZOLTpzGHVIVcHb237sPWjiYaa-zu81FhfjID5YP5cLauIFRsrvy7j1wfxqr4NInHyiF1zNPn6iwPYAhKFw=\",\"summary\":[{\"type\":\"summary_text\",\"text\":\"**Refining getEndpointReference implementations**\"},{\"type\":\"summary_text\",\"text\":\"**Preparing to write full test file**\"}]}"}, {"type": "toolCall", "id": "call_Cn698x0eFqzoetTdidcAotRQ|fc_0dd31ada8d0a3c86016abff009f7d487d18895464582a73e2c", "name": "write", "arguments": {"path": "tests/src/com.sun.xml.ws/httpspi-servlet/4.0.5/src/test/java/com_sun_xml_ws/httpspi_servlet/Httpspi_servletTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage com_sun_xml_ws.httpspi_servlet;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.io.ByteArrayInputStream;\nimport java.io.ByteArrayOutputStream;\nimport java.io.IOException;\nimport java.io.InputStream;\nimport java.io.PrintWriter;\nimport java.io.UnsupportedEncodingException;\nimport java.nio.charset.StandardCharsets;\nimport java.security.Principal;\nimport java.util.Collections;\nimport java.util.Enumeration;\nimport java.util.HashMap;\nimport java.util.LinkedHashMap;\nimport java.util.List;\nimport java.util.Locale;\nimport java.util.Map;\nimport java.util.Set;\n\nimport javax.xml.namespace.QName;\nimport javax.xml.transform.Source;\n\nimport com.sun.xml.ws.transport.httpspi.servlet.DeploymentDescriptorParser;\nimport com.sun.xml.ws.transport.httpspi.servlet.EndpointAdapter;\nimport com.sun.xml.ws.transport.httpspi.servlet.EndpointHttpContext;\nimport com.sun.xml.ws.transport.httpspi.servlet.Headers;\nimport com.sun.xml.ws.transport.httpspi.servlet.ResourceLoader;\nimport jakarta.servlet.AsyncContext;\nimport jakarta.servlet.DispatcherType;\nimport jakarta.servlet.ReadListener;\nimport jakarta.servlet.RequestDispatcher;\nimport jakarta.servlet.ServletConnection;\nimport jakarta.servlet.ServletContext;\nimport jakarta.servlet.ServletException;\nimport jakarta.servlet.ServletInputStream;\nimport jakarta.servlet.ServletOutputStream;\nimport jakarta.servlet.ServletRequest;\nimport jakarta.servlet.ServletResponse;\nimport jakarta.servlet.http.Cookie;\nimport jakarta.servlet.http.HttpServletRequest;\nimport jakarta.servlet.http.HttpServletResponse;\nimport jakarta.servlet.http.HttpSession;\nimport jakarta.servlet.http.HttpUpgradeHandler;\nimport jakarta.servlet.http.Part;\nimport jakarta.xml.ws.Binding;\nimport jakarta.xml.ws.Endpoint;\nimport jakarta.xml.ws.EndpointReference;\nimport jakarta.xml.ws.WebServiceFeature;\nimport jakarta.xml.ws.handler.MessageContext;\nimport jakarta.xml.ws.http.HTTPBinding;\nimport jakarta.xml.ws.soap.MTOMFeature;\nimport jakarta.xml.ws.soap.SOAPBinding;\nimport jakarta.xml.ws.spi.http.HttpContext;\nimport jakarta.xml.ws.spi.http.HttpExchange;\nimport jakarta.xml.ws.spi.http.HttpHandler;\nimport org.junit.jupiter.api.Test;\n\npublic class Httpspi_servletTest {\n    @Test\n    void supportsCaseInsensitiveMultiValueHeaders() {\n        Headers headers = new Headers();\n\n        headers.add(\"x-request-ID\", \"first\");\n        headers.add(\"X-Request-id\", \"second\");\n\n        assertThat(headers).containsKey(\"X-REQUEST-ID\");\n        assertThat(headers.getFirst(\"x-request-id\")).isEqualTo(\"first\");\n        assertThat(headers.get(\"X-Request-ID\")).containsExactly(\"first\", \"second\");\n\n        headers.set(\"X-Request-ID\", \"replacement\");\n        assertThat(headers.get(\"x-request-id\")).containsExactly(\"replacement\");\n\n        headers.put(\"Content-Type\", List.of(\"text/plain\"));\n        assertThat(headers.entrySet()).hasSize(2);\n        assertThat(headers.remove(\"CONTENT-TYPE\")).containsExactly(\"text/plain\");\n    }\n\n    @Test\n    void parsesRuntimeDeploymentDescriptor() {\n        RecordingAdapterFactory factory = new RecordingAdapterFactory();\n        DeploymentDescriptorParser<ParsedEndpoint> parser = new DeploymentDescriptorParser<>(\n                String.class.getClassLoader(), new EmptyResourceLoader(), factory);\n        String descriptor = \"\"\"\n                <endpoints xmlns=\"http://java.sun.com/xml/ns/jax-ws/ri/runtime\" version=\"2.0\">\n                    <endpoint name=\"echo\" implementation=\"java.lang.String\"\n                        service=\"{urn:test}EchoService\" port=\"{urn:test}EchoPort\"\n                        url-pattern=\"/echo/*\" enable-mtom=\"true\"\n                        mtom-threshold-value=\"256\" binding=\"##SOAP12_HTTP\"/>\n                </endpoints>\n                \"\"\";\n\n        List<ParsedEndpoint> endpoints = parser.parse(\n                \"memory:/WEB-INF/sun-jaxws.xml\",\n                new ByteArrayInputStream(descriptor.getBytes(StandardCharsets.UTF_8)));\n\n        assertThat(endpoints).hasSize(1);\n        ParsedEndpoint endpoint = endpoints.get(0);\n        assertThat(endpoint.name).isEqualTo(\"echo\");\n        assertThat(endpoint.urlPattern).isEqualTo(\"/echo/*\");\n        assertThat(endpoint.implementation).isEqualTo(String.class);\n        assertThat(endpoint.serviceName).isEqualTo(new QName(\"urn:test\", \"EchoService\"));\n        assertThat(endpoint.portName).isEqualTo(new QName(\"urn:test\", \"EchoPort\"));\n        assertThat(endpoint.bindingId).isEqualTo(SOAPBinding.SOAP12HTTP_BINDING);\n        assertThat(endpoint.metadata).isEmpty();\n        assertThat(endpoint.features).hasSize(1);\n        assertThat(endpoint.features[0]).isInstanceOf(MTOMFeature.class);\n        MTOMFeature mtom = (MTOMFeature) endpoint.features[0];\n        assertThat(mtom.isEnabled()).isTrue();\n        assertThat(mtom.getThreshold()).isEqualTo(256);\n    }\n\n    @Test\n    void publishesEndpointAndTranslatesServletExchange() throws IOException {\n        RecordingEndpoint endpoint = new RecordingEndpoint();\n        EndpointAdapter adapter = new EndpointAdapter(endpoint, \"/echo/*\");\n\n        assertThat(adapter.getEndpoint()).isSameAs(endpoint);\n        assertThat(adapter.getContext()).isInstanceOf(EndpointHttpContext.class);\n        assertThat(adapter.getContext().getPath()).isEqualTo(\"/echo/*\");\n        assertThat(adapter.getValidPath()).isEqualTo(\"/echo\");\n        assertThat(new EndpointAdapter(endpoint, \"/exact\").getValidPath()).isEqualTo(\"/exact\");\n\n        adapter.publish();\n        TestHttpServletRequest request = new TestHttpServletRequest();\n        request.headers.put(\"X-Request-ID\", List.of(\"request-1\", \"request-2\"));\n        TestHttpServletResponse response = new TestHttpServletResponse();\n\n        adapter.handle(null, request, response);\n\n        assertThat(endpoint.exchange.requestHeader).isEqualTo(\"request-1\");\n        assertThat(endpoint.exchange.requestHeaders).containsExactly(\"request-1\", \"request-2\");\n        assertThat(endpoint.exchange.requestUri).isEqualTo(\"/context/echo?value=1\");\n        assertThat(endpoint.exchange.contextPath).isEqualTo(\"/context\");\n        assertThat(endpoint.exchange.method).isEqualTo(\"POST\");\n        assertThat(endpoint.exchange.protocol).isEqualTo(\"HTTP/1.1\");\n        assertThat(endpoint.exchange.scheme).isEqualTo(\"https\");\n        assertThat(endpoint.exchange.pathInfo).isEqualTo(\"/echo\");\n        assertThat(endpoint.exchange.queryString).isEqualTo(\"value=1\");\n        assertThat(endpoint.exchange.localAddress).isEqualTo(\"localhost\");\n        assertThat(endpoint.exchange.userPrincipal.getName()).isEqualTo(\"alice\");\n        assertThat(endpoint.exchange.servletRequest).isSameAs(request);\n        assertThat(endpoint.exchange.httpContext.getPath()).isEqualTo(\"/echo/*\");\n        assertThat(endpoint.exchange.userInRole).isTrue();\n        assertThat(response.status).isEqualTo(202);\n        assertThat(response.headers.get(\"X-Re