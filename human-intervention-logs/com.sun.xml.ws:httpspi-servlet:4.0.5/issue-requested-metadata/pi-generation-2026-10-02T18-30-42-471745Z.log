arta.xml.ws.spi.http.HttpContext;\nimport org.junit.jupiter.api.Test;\n\npublic class Httpspi_servletTest {\n    @Test\n    void supportsCaseInsensitiveMultiValueHeaders() {\n        Headers headers = new Headers();\n\n        headers.add(\"x-request-ID\", \"first\");\n        headers.add(\"X-Request-id\", \"second\");\n\n        assertThat(headers).containsKey(\"X-REQUEST-ID\");\n        assertThat(headers.getFirst(\"x-request-id\")).isEqualTo(\"first\");\n        assertThat(headers.get(\"X-Request-ID\")).containsExactly(\"first\", \"second\");\n\n        headers.set(\"X-Request-ID\", \"replacement\");\n        assertThat(headers.get(\"x-request-id\")).containsExactly(\"replacement\");\n\n        headers.put(\"Content-Type\", List.of(\"text/plain\"));\n        assertThat(headers.entrySet()).hasSize(2);\n        assertThat(headers.remove(\"CONTENT-TYPE\")).containsExactly(\"text/plain\");\n    }\n\n    @Test\n"}], "isError": false, "timestamp": 1790965925131}, {"role": "toolResult", "toolCallId": "call_SOf6yKcEDk7nxGHRyLYTv9iy|fc_0549e007eb69ea1e016abff886d85487d19a44a664e8f936ee", "toolName": "bash", "content": [{"type": "text", "text": "tests/src/com.sun.xml.ws/httpspi-servlet/4.0.5/build/native/agent-output/test/reachability-metadata.json\ntests/src/com.sun.xml.ws/httpspi-servlet/4.0.5/build/native/generated/generateTestResourcesConfigFile/resource-config.json\ntests/src/com.sun.xml.ws/httpspi-servlet/4.0.5/build/natively-collected/_global_/agent/reachability-metadata.json\ntests/src/com.sun.xml.ws/httpspi-servlet/4.0.5/build/test-results/test/testlist/junit-platform-unique-ids-7871645642975573530.txt\n"}], "isError": false, "timestamp": 1790965925131}]}
