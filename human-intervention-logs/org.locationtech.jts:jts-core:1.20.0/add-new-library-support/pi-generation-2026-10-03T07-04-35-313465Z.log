{"path": "tests/src/org.locationtech.jts/jts-core/1.20.0/src/test/java/org_locationtech_jts_jts_core/TestBuilderProxyTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_locationtech_jts_jts_core;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.awt.Color;\n\nimport org.junit.jupiter.api.Test;\nimport org.locationtech.jts.geom.Coordinate;\nimport org.locationtech.jts.geom.Geometry;\nimport org.locationtech.jts.geom.GeometryFactory;\nimport org.locationtech.jts.util.TestBuilderProxy;\n\npublic class TestBuilderProxyTest {\n    @Test\n    void handlesIndicatorRequestsWhenTestBuilderIsUnavailable() {\n        Geometry geometry = new GeometryFactory().createPoint(new Coordinate(12, 34));\n\n        TestBuilderProxy.showIndicator(geometry);\n        TestBuilderProxy.showIndicator(geometry, Color.BLUE);\n\n        assertThat(TestBuilderProxy.isActive()).isFalse();\n        assertThat(geometry.getCoordinate()).isEqualTo(new Coordinate(12, 34));\n    }\n}\n"}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-luna", "usage": {"input": 472, "output": 1264, "cacheRead": 72192, "cacheWrite": 0, "reasoning": 958, "totalTokens": 73928, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1791011403121, "responseId": "resp_00406bc9d664d081016ac0aa4c4c3887d181c9e9665e427590", "rawStopReason": "completed"}}
