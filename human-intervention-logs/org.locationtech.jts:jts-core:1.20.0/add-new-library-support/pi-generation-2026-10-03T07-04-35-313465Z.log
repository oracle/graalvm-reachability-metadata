           <configuration>\n                    <descriptorRefs>\n                        <descriptorRef>jar-with-dependencies</descriptorRef>\n                    </descriptorRefs>\n                    <archive>\n                        <manifest>\n                            <mainClass>org.locationtech.jtstest.testbuilder.JTSTestBuilder</mainClass>\n                        </manifest>\n                    </archive>\n                    <finalName>JTSTestBuilder</finalName>\n                    <appendAssemblyId>false</appendAssemblyId>\n                </configuration>\n                <executions>\n                    <execution>\n                        <id>make-assembly</id>\n                        <phase>package</phase>\n                        <goals>\n                            <goal>single</goal>\n                        </goals>\n                    </execution>\n                </executions>\n            </plugin>\n        </plugins>\n    </build>\n</project>\n\n\nURL https://raw.githubusercontent.com/locationtech/jts/master/pom.xml\n<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<project xmlns=\"http://maven.apache.org/POM/4.0.0\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xsi:schemaLocation=\"http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd\">\n    <modelVersion>4.0.0</modelVersion>\n    <groupId>org.locationtech.jts</groupId>\n    <artifactId>jts</artifactId>\n    <version>1.21.0-SNAPSHOT</version>\n    <packaging>pom</packaging>\n\n    <name>JTS Topology Suite</name>\n    <url>https://www.locationtech.org/projects/technology.jts</url>\n    <description>The JTS Topology Suite is an API for 2D linear geometry predicates and functions.</description>\n\n    <!--\n\n    Build JTS Topology Suite and install in local repository:\n       mvn install\n\n    Build everything and skip tests:\n       mvn clean install -DskipTests\n\n    Setup for eclipse development:\n       mvn eclipse:eclipse\n\n    To build with jts-ora:\n       mvn install -Poracle\n\n    To build with jts-sde:\n       mvn install -Parcsde\n\n    To build the release (for Maven Central; committers only)\n       mvn install -Drelease\n    -->\n\n    <properties>\n        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>\n        <junit-version>4.13.1</junit-version>\n        <jdom-version>2.0.6.1</jdom-version>\n        <jump.version>1.2</jump.version>\n        <json-simple-version>1.1.1</json-simple-version>\n        <sde-version>9.1</sde-version>\n\n        <!-- build environment target versions -->\n        <maven.compiler.source>1.8</maven.compiler.source>\n        <maven.compiler.target>1.8</maven.compiler.target>\n        <pmd.version>7.22.0</pmd.version>\n        <checkstyle.version>8.44</checkstyle.version>\n        <!--cast, deprecation, divzero, empty, fallthrough, finally, overrides, path, serial, and unchecked -->\n        <lint>unchecked</lint>\n        <!-- none, accessibility, html, missing, reference, syntax, all -->\n        <doclint>none</doclint>\n    </properties>\n\n    <!-- PROJECT INFORMATION -->\n    <licenses>\n        <license>\n            <name>Eclipse Public License, Version 2.0</name>\n            <url>https://github.com/locationtech/jts/blob/master/LICENSE_EPLv2.txt</url>\n        </license>\n        <license>\n            <name>Eclipse Distribution License - v 1.0</name>\n            <url>https://github.com/locationtech/jts/blob/master/LICENSE_EDLv1.txt</url>\n        </license>\n    </licenses>\n    <developers>\n        <developer>\n            <name>Martin Davis</name>\n            <email>mbdavis@VividSolutions.com</email>\n            <organization>Vivid Solutions Inc.</organization>\n            <organizationUrl>https://www.vividsolutions.com/</organizationUrl>\n        </developer>\n        <developer>\n            <name>Martin Davis</name>\n            <email>mtnclimb@gmail.com</email>\n            <organization>Individual</organization>\n            <organizationUrl>https://tsusiatsoftware.net</organizationUrl>\n        </developer>\n    </developers>\n\n    <scm>\n        <connection>scm:git::git@github.com:locationtech/jts.git</connection>\n        <developerConnection>scm:git:git@github.com:locationtech/jts.git</developerConnection>\n        <url>https://github.com/locationtech/jts</url>\n        <tag>HEAD</tag>\n    </scm>\n\n    <distributionManagement>\n        <snapshotRepository>\n            <id>repo.eclipse.org</id>\n            <name>JTS Repository - Snapshots</name>\n            <url>https://repo.eclipse.org/content/repositories/jts-snapshots/</url>\n        </snapshotRepository>\n        <repository>\n            <id>ossrh</id>\n            <url>https://oss.sonatype.org/service/local/staging/deploy/maven2/</url>\n        </repository>\n        <site>\n          <id>jts</id>\n          <url>https://locationtech.github.io/jts</url>\n        </site>\n    </distributionManagement>\n\n    <dependencyManagement>\n        <dependencies>\n            <dependency>\n                <groupId>junit</groupId>\n                <artifactId>junit</artifactId>\n                <version>${junit-version}</version>\n            </dependency>\n            <dependency>\n                <groupId>org.jdom</groupId>\n                <artifactId>jdom2</artifactId>\n                <version>${jdom-version}</version>\n            </dependency>\n            <dependency>\n                <groupId>com.googlecode.json-simple</groupId>\n                <artifactId>json-simple</artifactId>\n                <version>${json-simple-version}</version>\n                <exclusions>\n                  <exclusion>\n                    <groupId>junit</groupId>\n                    <artifactId>junit</artifactId>\n                  </exclusion>\n                </exclusions>\n            </dependency>\n            <dependency>\n                <groupId>org.apache.commons</groupId>\n                <artifactId>commons-lang3</artifactId>\n                <version>3.18.0</version>\n            </dependency>\n            <dependency>\n                <groupId>com.oracle.database.jdbc</groupId>\n                <artifactId>ojdbc8</artifactId>\n                <version>19.10.0.0</version>\n            </dependency>\n            <dependency>\n                <groupId>org.apache.commons</groupId>\n                <artifactId>commons-csv</artifactId>\n                <version>1.7</version>\n                <scope>test</scope>\n            </dependency>\n        </dependencies>\n    </dependencyManagement>\n\n    <!-- Repositories for Dependencies -->\n    <repositories>\n        <repository>\n            <id>central.maven.org</id>\n            <name>Central Maven repository</name>\n            <url>https://central.maven.org/maven2</url>\n            <snapshots>\n                <enabled>false</enabled>\n            </snapshots>\n        </repository>\n    </repositories>\n\n    <profiles>\n        <profile>\n            <id>release</id>\n            <activation>\n                <property>\n                    <name>release</name>\n                </property>\n            </activation>\n\n            <distributionManagement>\n                <snapshotRepository>\n                    <id>ossrh</id>\n                    <url>https://oss.sonatype.org/content/repositories/snapshots</url>\n                </snapshotRepository>\n            </distributionManagement>\n\n            <build>\n                <plugins>\n                    <plugin>\n                        <groupId>org.sonatype.plugins</groupId>\n                        <artifactId>nexus-staging-maven-plugin</artifactId>\n                        <extensions>true</extensions>\n                        <configuration>\n                            <serverId>ossrh</serverId>\n                            <nexusUrl>https://oss.sonatype.org/</nexusUrl>\n                            <autoReleaseAfterClose>true</autoReleaseAfterClose>\n                        </configuration>\n                    </plugin>\n\n                    <plugin>\n                        <artifactId>maven-gpg-plugin</artifactId>\n                        <executions>\n                            <execution>\n                                <id>sign-artifacts</id>\n                                <phase>verify</phase>\n                                <goals>\n                                    <goal>sign</goal>\n                                </goals>\n                            </execution>\n                        </executions>\n                    </plugin>\n\n                </plugins>\n            </build>\n        </profile>\n\n    </profiles>\n\n    <!-- =========================================================== -->\n    <!--     Build Configuration                                     -->\n    <!-- =========================================================== -->\n    <build>\n        <pluginManagement>\n            <plugins>\n                <plugin>\n                    <artifactId>maven-assembly-plugin</artifactId>\n                    <version>3.3.0</version> <!-- 3.3.0 -->\n                </plugin>\n                <plugin>\n                  <artifactId>maven-checkstyle-plugin</artifactId>\n                  <version>3.1.2</version>\n                </plugin>\n                <plugin>\n                    <artifactId>maven-compiler-plugin</artifactId>\n                    <version>3.8.1</version>\n                </plugin>\n                <plugin>\n                    <artifactId>maven-deploy-plugin</artifactId>\n                    <version>3.0.0-M1</version>\n                </plugin>\n                <plugin>\n                    <artifactId>maven-gpg-plugin</artifactId>\n                    <version>1.5</version>\n                </plugin>\n                <plugin>\n                    <artifactId>maven-jar-plugin</artifactId>\n                    <version>3.0.2</version>\n                </plugin>\n                <plugin>\n                    <artifactId>maven-javadoc-plugin</artifactId>\n                    <version>3.3.0</version>\n                </plugin>\n                <plugin>\n                    <artifactId>maven-jxr-plugin</artifactId>\n                    <version>3.1.1</version>\n                </plugin>\n                <plugin>\n                  <artifactId>maven-pmd-plugin</artifactId>\n                  <version>3.28.0</version>\n                </plugin>\n                <plugin>\n                  <artifactId>maven-project-info-reports-plugin</artifactId>\n                  <version>3.1.2</version>\n                </plugin>\n                <plugin>\n                    <artifactId>maven-release-plugin</artifactId>\n                    <version>2.5.3</version> <!-- 3.0.0-M4 -->\n                </plugin>\n                <plugin>\n                  <artifactId>maven-site-plugin</artifactId>\n                  <version>3.9.1</version>\n                </plugin>\n                <plugin>\n                    <artifactId>maven-source-plugin</artifactId>\n                    <version>2.2.1</version> <!-- 3.2.0 -->\n                </plugin>\n                <plugin>\n                    <artifactId>maven-surefire-plugin</artifactId>\n                    <version>2.15</version> <!-- 3.0.0-M5 -->\n                </plugin>\n          \n"}], "isError": false, "timestamp": 1791011289158}]}
