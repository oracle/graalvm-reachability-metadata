  	/**
  	 * Dump Set Field Code
  	 * 
  	 * @param mv
  	 * @param acc
  	 */
  	private void internalSetFiled(MethodVisitor mv, Accessor acc) {
  		/**
  		 * FNC params
  		 * 
  		 * 1 -> object to alter
  		 * 
  		 * 2 -> id of field
  		 * 
  		 * 3 -> new value
  		 */
  		mv.visitVarInsn(ALOAD, 1);
  		mv.visitTypeInsn(CHECKCAST, classNameInternal);
  		// get VALUE
  		mv.visitVarInsn(ALOAD, 3);
