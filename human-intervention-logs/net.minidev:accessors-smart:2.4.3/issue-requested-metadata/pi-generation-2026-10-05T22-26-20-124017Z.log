  		String destClsName = Type.getInternalName(type);
  
  		Method conMtd = convMtds.get(type);
  		if (conMtd != null) {
  			// external conversion
  			String clsSig = Type.getInternalName(conMtd.getDeclaringClass());
  			String mtdName = conMtd.getName();
