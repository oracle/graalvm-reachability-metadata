[tool-call] delta {"path":"tests/src/net.minidev/accessors-smart/2.4.3/build.gradle","edits":[{"oldText":"String libraryVersion = tck.testedLibraryVersion.get()\n\ndependencies {\n    testImplementation \"net.minidev:accessors-smart:$libraryVersion\"\n    testImplementation 'org.assertj:assertj-core:3.22.0'\n}\n","newText":"String libraryVersion = tck.testedLibraryVersion.get()\nProvider<Directory> generatedSourcesDir = layout.buildDirectory.dir(\"generated/accessors-smart-sources\")\nProvider<Directory> compiledClassesDir = layout.buildDirectory.dir(\"classes/accessors-smart\")\n\nconfigurations {\n    accessorsSmartSources {\n        transitive = false\n    }\n    accessorsSmartCompileClasspath\n}\n\ndef unpackAccessorsSmartSources = tasks.register(\"unpackAccessorsSmartSources\", Sync) {\n    from({ zipTree(configurations.accessorsSmartSources.singleFile) })\n    into generatedSourcesDir\n}\n\ndef compileAccessorsSmartSources = tasks.register(\"compileAccessorsSmartSources\", JavaCompile) {\n    dependsOn unpackAccessorsSmartSources\n    source generatedSourcesDir\n    classpath = configurations.accessorsSmartCompileClasspath\n    destinationDirectory = compiledClassesDir\n    options.release = 8\n}\n\ndef accessorsSmartJar = tasks.register(\"accessorsSmartJar\", Jar) {\n    dependsOn compileAccessorsSmartSources\n    from compiledClassesDir\n    archiveClassifier = \"accessors-smart\"\n}\n\nFileCollection accessorsSmartJarFiles = files(accessorsSmartJar.flatMap { it.archiveFile })\naccessorsSmartJarFiles.builtBy accessorsSmartJar\n\ndependencies {\n    // Version 2.4.3 was published without a main JAR, so compile its published sources.\n    accessorsSmartSources \"net.minidev:accessors-smart:$libraryVersion:sources\"\n    accessorsSmartCompileClasspath 'org.ow2.asm:asm:8.0.1'\n    testImplementation accessorsSmartJarFiles\n    testImplementation 'org.ow2.asm:asm:8.0.1'\n    testImplementation 'org.assertj:assertj-core:3.22.0'\n}\n"}]}
