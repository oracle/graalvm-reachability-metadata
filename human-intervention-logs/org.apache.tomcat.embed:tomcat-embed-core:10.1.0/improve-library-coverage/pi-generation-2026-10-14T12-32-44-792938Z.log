                  if (log.isDebugEnabled()) {
                      log.info(sm.getString("catalina.noLoader", loaderClassName), e);
                  } else {
                      log.info(sm.getString("catalina.noLoader", loaderClassName));
                  }
                  // No loader so don't use generated code
                  useGeneratedCode = false;
