              m.invoke(con.getProtocolHandler(), new Object[] {ex});
          }else {
              log.warn(sm.getString("connector.noSetExecutor", con));
          }
      }
  
      private static void setSSLImplementationName(Connector con, String sslImplementationName) throws Exception {
