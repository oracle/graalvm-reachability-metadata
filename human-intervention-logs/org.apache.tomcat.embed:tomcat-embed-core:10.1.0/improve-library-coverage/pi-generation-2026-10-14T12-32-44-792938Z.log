      private Object invokeMethod(ApplicationContext appContext,
                                  final String methodName,
                                  Object[] params)
          throws Throwable{
  
          try{
              Method method = objectCache.get(methodName);
              if (method == null){
                  method = appContext.getClass()
                      .getMethod(methodName, classCache.get(methodName));
