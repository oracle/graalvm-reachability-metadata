  +    private Path temporaryDirectory;
  +
  +    @Test
  +    void createsDefaultEngineAndHostLifecycleListenersFromServerXml() throws Exception {
  +        Catalina catalina = loadCatalina();
  +        Server server = catalina.getServer();
  +        try {
