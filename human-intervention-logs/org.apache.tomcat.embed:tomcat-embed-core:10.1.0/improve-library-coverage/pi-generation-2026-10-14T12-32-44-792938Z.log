    lifecycle.start();\n            assertThat(Bootstrap.getCatalinaBaseFile()).isDirectory();\n            assertThat(Bootstrap.getCatalinaHomeFile()).isDirectory();\n        } finally {\n            lifecycle.stop();\n        }\n\n        Bootstrap stopWithArguments = new Bootstrap();\n        stopWithArguments.init(startArguments);\n        stopWithArguments.stopServer(new String[] {\"stop\"});\n\n        Bootstrap stopWithoutArguments = new Bootstrap();\n        stopWithoutArguments.init(startArguments);\n        stopWithoutArguments.stopServer();\n\n        Bootstrap.main(startArguments);\n        assertThat(System.getProperty(\"catalina.useNaming\")).isEqualTo(\"false\");\n    }\n\n    private Path createServerXml() throws Exception {\n        Path serverXml = temporaryDirectory.resolve(\"server.xml\");\n        Files.writeString(serverXml, \"\"\"\n                <?xml version=\"1.0\" encoding=\"UTF-8\"?>\n                <Server port=\"-2\" shutdown=\"SHUTDOWN\">\n                  <Service name=\"Catalina\">\n                    <Engine name=\"Catalina\" defaultHost=\"localhost\">\n                      <Host name=\"localhost\" appBase=\"webapps\" autoDeploy=\"false\" deployOnStartup=\"false\" />\n                    </Engine>\n                  </Service>\n                </Server>\n                \"\"\");\n        return serverXml;\n    }\n}\n"}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-sol", "usage": {"input": 1021, "output": 2453, "cacheRead": 58240, "cacheWrite": 0, "reasoning": 1761, "totalTokens": 61714, "cost": {"input": 0.004084, "output": 0.049060000000000006, "cacheRead": 0.023296, "cacheWrite": 0, "total": 0.07644000000000001}}, "stopReason": "toolUse", "timestamp": 1791995109656, "responseId": "resp_03403b8a2bf97b94016acface615a087d0bf15c8e77811c1c6", "rawStopReason": "completed"}, "toolResults": [{"role": "toolResult", "toolCallId": "call_EeT6HvTA4DkzcxnCWwDVviFD|fc_03403b8a2bf97b94016acfad15b36087d0a7a