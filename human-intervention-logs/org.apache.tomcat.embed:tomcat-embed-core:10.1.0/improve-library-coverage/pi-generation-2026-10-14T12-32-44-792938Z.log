.api.Assertions.assertThat;\n\npublic class AprLifecycleListenerTest {\n\n    @Test\n    void managesAprWithTheServerLifecycle() throws Exception {\n        AprLifecycleListener listener = new AprLifecycleListener();\n        listener.setSSLEngine(\"on\");\n        listener.setSSLRandomSeed(\"builtin\");\n        listener.setFIPSMode(\"off\");\n\n        StandardServer server = new StandardServer();\n        server.addLifecycleListener(listener);\n        try {\n            server.init();\n\n            assertThat(server.getState()).isEqualTo(LifecycleState.INITIALIZED);\n            assertThat(server.findLifecycleListeners()).contains(listener);\n            assertThat(AprLifecycleListener.isInstanceCreated()).isTrue();\n            assertThat(listener.getSSLEngine()).isEqualTo(\"on\");\n            assertThat(listener.getSSLRandomSeed()).isEqualTo(\"builtin\");\n            assertThat(listener.getFIPSMode()).isEqualTo(\"off\");\n        } finally {\n            server.destroy();\n        }\n\n        assertThat(server.getState()).isEqualTo(LifecycleState.DESTROYED);\n    }\n}\n"}], "isError": false, "timestamp": 1791996551363}, {"role": "toolResult", "toolCallId": "call_5qufXMXq52ccB020YxxccJUT|fc_0c03fc2c6f173596016acfb286a92087d0b7837a192ca2792b", "toolName": "bash", "content": [{"type": "text", "text": " M metadata/org.apache.tomcat.embed/tomcat-embed-core/10.1.0/reachability-metadata.json\n?? tests/src/org.apache.tomcat.embed/tomcat-embed-core/10.1.0/src/test/java/org_apache_tomcat_embed/tomcat_embed_core/AprLifecycleListenerTest.java\n"}], "isError": false, "timestamp": 1791996551363}]}
