at;\n\n@Order(1)\npublic class NamingContextTest {\n\n    private static final String IMAGE_CODE_PROPERTY = \"org.graalvm.nativeimage.imagecode\";\n    private static String previousImageCode;\n\n    @BeforeAll\n    static void selectNativeImageReferenceResolution() {\n        previousImageCode = System.getProperty(IMAGE_CODE_PROPERTY);\n        System.setProperty(IMAGE_CODE_PROPERTY, \"runtime\");\n    }\n\n    @AfterAll\n    static void restoreImageCodeProperty() {\n        if (previousImageCode == null) {\n            System.clearProperty(IMAGE_CODE_PROPERTY);\n        } else {\n            System.setProperty(IMAGE_CODE_PROPERTY, previousImageCode);\n        }\n    }\n\n    @Test\n    void resolvesReferenceWithConfiguredObjectFactory() throws Exception {\n        NamingContext context = new NamingContext(null, \"reference-context\");\n        Reference reference = new Reference(String.class.getName(), TextFactory.class.getName(), null);\n        context.bind(\"message\", reference);\n\n        assertThat(context.lookup(\"message\")).isEqualTo(\"resolved-message\");\n    }\n\n    public static final class TextFactory implements ObjectFactory {\n        @Override\n        public Object getObjectInstance(Object object, Name name, Context nameContext, Hashtable<?, ?> environment) {\n            return \"resolved-\" + name;\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_Cg1jT2xFsSfSYyDIR8kjUl8F|fc_01e4c8c1df22e8b0016acf8e31f70887d0aafd0f4869c73120", "name": "write", "arguments": {"path": "tests/src/org.apache.tomcat.embed/tomcat-embed-core/10.1.0/src/test/java/org_apache_tomcat_embed/tomcat_embed_core/BootstrapTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_tomcat_embed.tomcat_embed_core;\n\nimport java.nio.file.Files;\nimport java.nio.file.Path;\n\nimport org.apache.catalina.startup.Bootstrap;\nimport org.junit.jupiter.api.Order;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.io.TempDir;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\n@Order(2)\npublic class BootstrapTest {\n\n    @TempDir\n    private Path temporaryDirectory;\n\n    @Test\n    void initializesLoadsStartsAndStopsCatalinaDaemon() throws Exception {\n        Path serverXml = temporaryDirectory.resolve(\"server.xml\");\n        Files.writeString(serverXml, \"\"\"\n                <?xml version=\"1.0\" encoding=\"UTF-8\"?>\n                <Server port=\"-2\" shutdown=\"SHUTDOWN\">\n                  <Service name=\"Catalina\">\n                    <Engine name=\"Catalina\" defaultHost=\"localhost\">\n                      <Host name=\"localhost\" appBase=\"webapps\" autoDeploy=\"false\" deployOnStartup=\"false\" />\n                    </Engine>\n                  </Service>\n                </Server>\n                \"\"\");\n\n        System.setProperty(\"catalina.base\", Path.of(\"\").toAbsolutePath().toString());\n        Bootstrap bootstrap = new Bootstrap();\n        bootstrap.init(new String[] {\"-config\", serverXml.toString(), \"-nonaming\", \"start\"});\n        bootstrap.setAwait(false);\n\n        bootstrap.start();\n        assertThat(Bootstrap.getCatalinaBaseFile()).isDirectory();\n\n        bootstrap.stop();\n    }\n}\n"}}, {"type": "toolCall", "id": "call_KJHQYmhXKOftymGOjN1KBbaE|fc_01e4c8c1df22e8b0016acf8e31f71087d0994739f2212017ee", "name": "write", "arguments": {"path": "tests/src/org.apache.tomcat.embed/tomcat-embed-core/10.1.0/src/test/java/org_apache_tomcat_embed/tomcat_embed_core/LifecycleListenerRuleTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_tomcat_embed.tomcat_embed_core;\n\nimport java