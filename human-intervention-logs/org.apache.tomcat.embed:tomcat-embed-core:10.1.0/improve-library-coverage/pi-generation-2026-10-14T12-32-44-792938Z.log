e/10.1.0/build/test-results/test/TEST-org_apache_tomcat_embed.tomcat_embed_core.WebappClassLoaderBaseTest.xml\ntests/src/org.apache.tomcat.embed/tomcat-embed-core/10.1.0/build/test-results/test/TEST-org_apache_tomcat_embed.tomcat_embed_core.WebappLoaderTest.xml\ntests/src/org.apache.tomcat.embed/tomcat-embed-core/10.1.0/build/test-results/test/TEST-org_apache_tomcat_embed.tomcat_embed_core.WebappServiceLoaderTest.xml\ntests/src/org.apache.tomcat.embed/tomcat-embed-core/10.1.0/build/test-results/test/TEST-tomcat.TomcatTests.xml\ntests/src/org.apache.tomcat.embed/tomcat-embed-core/10.1.0/build/tmp/compileTestJava/previous-compilation-data.bin\ntests/src/org.apache.tomcat.embed/tomcat-embed-core/10.1.0/build/tmp/jar/MANIFEST.MF\ntests/src/org.apache.tomcat.embed/tomcat-embed-core/10.1.0/dynamic-access-exhaust-report.json\ntests/src/org.apache.tomcat.embed/tomcat-embed-core/10.1.0/.gitignore\ntests/src/org.apache.tomcat.embed/tomcat-embed-core/10.1.0/.gradle/9.1.0/checksums/checksums.lock\ntests/src/org.apache.tomcat.embed/tomcat-embed-core/10.1.0/.gradle/9.1.0/checksums/md5-checksums.bin\ntests/src/org.apache.tomcat.embed/tomcat-embed-core/10.1.0/.gradle/9.1.0/checksums/sha1-checksums.bin\ntests/src/org.apache.tomcat.embed/tomcat-embed-core/10.1.0/.gradle/9.1.0/executionHistory/executionHistory.bin\ntests/src/org.apache.tomcat.embed/tomcat-embed-core/10.1.0/.gradle/9.1.0/executionHistory/executionHistory.lock\ntests/src/org.apache.tomcat.embed/tomcat-embed-core/10.1.0/.gradle/9.1.0/expanded/expanded.lock\ntests/src/org.apache.tomcat.embed/tomcat-embed-core/10.1.0/.gradle/9.1.0/fileChanges/last-build.bin\ntests/src/org.apache.tomcat.embed/tomcat-embed-core/10.1.0/.gradle/9.1.0/fileHashes/fileHashes.bin\ntests/src/org.apache.tomcat.embed/tomcat-embed-core/10.1.0/.gradle/9.1.0/fileHashes/fileHashes.lock\ntests/src/org.apache.tomcat.embed/tomcat-embed-core/10.1.0/.gradle/9.1.0/fileHashes/resourceHashesCache.bin\ntests/src/org.apache.tomcat.embed/tomcat-embed-core/10.1.0/.g