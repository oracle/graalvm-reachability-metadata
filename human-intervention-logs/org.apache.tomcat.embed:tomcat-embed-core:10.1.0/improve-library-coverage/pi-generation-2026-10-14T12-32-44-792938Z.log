t_embed/tomcat_embed_core/BaseCatalinaMBeanTest.java\ntests/src/org.apache.tomcat.embed/tomcat-embed-core/11.0.18/src/test/java/org_apache_tomcat_embed/tomcat_embed_core/BaseModelMBeanTest.java\ntests/src/org.apache.tomcat.embed/tomcat-embed-core/11.0.18/src/test/java/org_apache_tomcat_embed/tomcat_embed_core/BeanFactoryTest.java\ntests/src/org.apache.tomcat.embed/tomcat-embed-core/11.0.18/src/test/java/org_apache_tomcat_embed/tomcat_embed_core/BootstrapTest.java\ntests/src/org.apache.tomcat.embed/tomcat-embed-core/11.0.18/src/test/java/org_apache_tomcat_embed/tomcat_embed_core/ByteBufferUtilsUnsafeTest.java\ntests/src/org.apache.tomcat.embed/tomcat-embed-core/11.0.18/src/test/java/org_apache_tomcat_embed/tomcat_embed_core/CatalinaBaseConfigurationSourceTest.java\ntests/src/org.apache.tomcat.embed/tomcat-embed-core/11.0.18/src/test/java/org_apache_tomcat_embed/tomcat_embed_core/CatalinaTest.java\ntests/src/org.apache.tomcat.embed/tomcat-embed-core/11.0.18/src/test/java/org_apache_tomcat_embed/tomcat_embed_core/ClassLoaderLogManagerTest.java\ntests/src/org.apache.tomcat.embed/tomcat-embed-core/11.0.18/src/test/java/org_apache_tomcat_embed/tomcat_embed_core/ClasspathURLStreamHandlerTest.java\ntests/src/org.apache.tomcat.embed/tomcat-embed-core/11.0.18/src/test/java/org_apache_tomcat_embed/tomcat_embed_core/ConnectorCreateRuleTest.java\ntests/src/org.apache.tomcat.embed/tomcat-embed-core/11.0.18/src/test/java/org_apache_tomcat_embed/tomcat_embed_core/ConnectorProtocolIntrospectionTest.java\ntests/src/org.apache.tomcat.embed/tomcat-embed-core/11.0.18/src/test/java/org_apache_tomcat_embed/tomcat_embed_core/ContextConfigTest.java\ntests/src/org.apache.tomcat.embed/tomcat-embed-core/11.0.18/src/test/java/org_apache_tomcat_embed/tomcat_embed_core/CookieNameValidatorTest.java\ntests/src/org.apache.tomcat.embed/tomcat-embed-core/11.0.18/src/test/java/org_apache_tomcat_embed/tomcat_embed_core/CookieTest.java\n\nStatus:\n M metadata/org.apache.tomcat.embed/tomcat-embed-core/10.