[tool-call] delta {"path":"tests/src/org.apache.tomcat.embed/tomcat-embed-core/10.1.0/src/test/java/org_apache_tomcat_embed/tomcat_embed_core/Jre16CompatTest.java","content":"/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_tomcat_embed.tomcat_embed_core;\n\nimport java.net.SocketAddress;\nimport java.nio.channels.ServerSocketChannel;\nimport java.nio.channels.SocketChannel;\nimport java.nio.file.Path;\n\nimport org.apache.tomcat.util.compat.JreCompat;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.io.TempDir;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\npublic class Jre16CompatTest {\n\n    @Test\n    void createsUnixDomainAddressesAndChannels(@TempDir Path directory) throws Exception {\n        JreCompat compatibility = JreCompat.getInstance();\n        SocketAddress address = compatibility.getUnixDomainSocketAddress(directory.resolve(\"tomcat.sock\").toString());\n\n        assertThat(address).hasToString(directory.resolve(\"tomcat.sock\").toString());\n        try (ServerSocketChannel server = compatibility.openUnixDomainServerSocketChannel();\n                SocketChannel client = compatibility.openUnixDomainSocketChannel()) {\n            assertThat(server.isOpen()).isTrue();\n            assertThat(client.isOpen()).isTrue();\n        }\n    }\n}\n"}
