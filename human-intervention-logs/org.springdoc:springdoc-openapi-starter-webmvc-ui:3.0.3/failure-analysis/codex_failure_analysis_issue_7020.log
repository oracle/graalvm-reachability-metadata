est\\n    void servesTransformedSwaggerUiIndexPage() throws Exception {\\n        String page = mockMvc.perform(get(\\\"/swagger-ui/index.html\\\"))\\n                .andExpect(status().isOk())\\n                .andExpect(content().contentTypeCompatibleWith(MediaType.TEXT_HTML))\\n                .andReturn()\\n                .getResponse()\\n                .getContentAsString();\\n\\n        assertThat(page).contains(\\\"Swagger UI\\\");\\n    }\\n\\n    @SpringBootConfiguration\\n    @EnableAutoConfiguration\\n    @Import(GreetingController.class)\\n    public static class Application {\\n    }\\n\\n    @RestController\\n    public static class GreetingController {\\n        @GetMapping(\\\"/greeting\\\")\\n        public String greeting() {\\n            return \\\"hello\\\";\\n        }\\n    }\\n\\n}\\n\"}], \"isError\": false, \"timestamp\": 1787679023972}, {\"role\": \"toolResult\", \"toolCallId\": \"call_YMNzyhEBD30SKXClP8txnCHb|fc_0416ad5f046e4384016a8dd12fc5d087d2860b81c504bd8a1a\", \"toolName\": \"bash\", \"content\": [{\"type\": \"text\", \"text\": \"diff --git a/tests/src/org.springdoc/springdoc-openapi-starter-webmvc-ui/3.0.3/src/test/java/org_springdoc/springdoc_openapi_starter_webmvc_ui/Springdoc_openapi_starter_webmvc_uiTest.java b/tests/src/org.springdoc/springdoc-openapi-starter-webmvc-ui/3.0.3/src/test/java/org_springdoc/springdoc_openapi_starter_webmvc_ui/Springdoc_openapi_starter_webmvc_uiTest.java\\nindex d3a9e51522..b11a67663b 100644\\n--- a/tests/src/org.springdoc/springdoc-openapi-starter-webmvc-ui/3.0.3/src/test/java/org_springdoc/springdoc_openapi_starter_webmvc_ui/Springdoc_openapi_starter_webmvc_uiTest.java\\n+++ b/tests/src/org.springdoc/springdoc-openapi-starter-webmvc-ui/3.0.3/src/test/java/org_springdoc/springdoc_openapi_starter_webmvc_ui/Springdoc_openapi_starter_webmvc_uiTest.java\\n@@ -44,6 +44,18 @@ public class Springdoc_openapi_starter_webmvc_uiTest {\\n                 .andExpect(jsonPath(\\\"$.paths['/greeting'].get\\\")