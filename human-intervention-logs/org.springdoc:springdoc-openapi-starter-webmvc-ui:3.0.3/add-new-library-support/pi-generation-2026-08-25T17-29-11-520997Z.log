tory_status/README.md\nbuild.gradle\ntests/src/org.jline/jline/3.21.0/build.gradle\nforge/docs/functional-spec/README.md\ntests/src/javax.interceptor/javax.interceptor-api/1.2/build.gradle\nforge/docs/architecture/README.md\nforge/docs/README.md\ntests/src/org.jline/jline-reader/3.19.0/build.gradle\ntests/src/com.googlecode.juniversalchardet/juniversalchardet/1.0.3/build.gradle\ntests/src/jakarta.mail/jakarta.mail-api/2.1.0/build.gradle\ntests/src/org.jline/jline-console/3.28.0/build.gradle\ntests/src/org.mapstruct/mapstruct/1.6.3/build.gradle\ntests/src/org.glassfish.web/javax.el/2.2.4/build.gradle\ntests/src/org.snakeyaml/snakeyaml-engine/3.0.1/build.gradle\nforge/examples/code-coverage-improvement-example/README.md\ntests/src/com.github.ben-manes.caffeine/caffeine/3.1.8/build.gradle\ntests/src/org.jline/jline-console/3.21.0/build.gradle\ntests/src/tools.jackson.jaxrs/jackson-jaxrs-base/3.1.2/build.gradle\ntests/src/jakarta.el/jakarta.el-api/3.0.2/build.gradle\ntests/src/org.jline/jline-console/3.22.0/build.gradle\ntests/src/tools.jackson.jaxrs/jackson-jaxrs-json-provider/3.1.2/build.gradle\ntests/src/com.github.ben-manes.caffeine/caffeine/3.1.2/build.gradle\nforge/README.md\nforge/DEVELOPING.md\ntests/src/com.softwaremill.magnolia1_3/magnolia_3/1.3.16/build.gradle\ntests/src/net.thauvin.erik.urlencoder/urlencoder-lib-jvm/1.6.0/build.gradle\ntests/src/com.sksamuel.hoplite/hoplite-core/2.9.0/build.gradle\ntests/src/org.jline/jline-terminal-jna/3.20.0/build.gradle\ntests/src/com.github.ben-manes.caffeine/caffeine/2.9.3/build.gradle\ntests/src/io.netty/netty-codec-memcache/4.1.74.Final/build.gradle\ntests/src/io.vertx/vertx-web-common/4.5.24/build.gradle\ntests/src/org.jline/jline-terminal-jni/3.30.7/build.gradle\ntests/src/org.jboss.arquillian.junit/arquillian-junit-core/1.1.10.Final/build.gradle\ntests/src/io.netty/netty-transport-classes-epoll/4.1.99.Final/build.gradle\ntests/src/org.apache.directory.api/api-ldap-model/1.0.0-M20/build.gradle\ntests/src/org.jline/j