me = \"service-account\", appendRoles = false)\n    public static final class SecuredOperations {\n        @Executable\n        @Secured(\"ROLE_AUDITOR\")\n        @RunAs(roles = \"ROLE_AUDITOR\")\n        public String audit() {\n            return \"audit-complete\";\n        }\n    }\n\n    @Introspected\n    public static final class AuditedRecord {\n        private String creator;\n        private String updater;\n\n        @CreatedBy\n        public String getCreator() {\n            return creator;\n        }\n\n        public void setCreator(String creator) {\n            this.creator = creator;\n        }\n\n        public String getUpdater() {\n            return updater;\n        }\n\n        @UpdatedBy\n        public void setUpdater(String updater) {\n            this.updater = updater;\n        }\n    }\n}\n"}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-sol", "usage": {"input": 985, "output": 1081, "cacheRead": 77568, "cacheWrite": 0, "reasoning": 0, "totalTokens": 79634, "cost": {"input": 0.0049250000000000006, "output": 0.03243, "cacheRead": 0.038784, "cacheWrite": 0, "total": 0.076139}}, "stopReason": "toolUse", "timestamp": 1789733310911, "responseId": "resp_0a6c79a327590997016aad29bf0e6c87d2bfcbbd1e7804b53c", "rawStopReason": "completed"}, "toolResults": [{"role": "toolResult", "toolCallId": "call_2b2NqY8nlBbJnlxC1Pcq3Cey|fc_0a6c79a327590997016aad29c42ac887d29b867112eecf905d", "toolName": "write", "content": [{"type": "text", "text": "Successfully wrote to tests/src/io.micronaut.security/micronaut-security-annotations/5.3.2/src/test/java/io_micronaut_security/micronaut_security_annotations/MicronautSecurityAnnotationsTest.java"}], "isError": false, "timestamp": 1789733336086}]}
