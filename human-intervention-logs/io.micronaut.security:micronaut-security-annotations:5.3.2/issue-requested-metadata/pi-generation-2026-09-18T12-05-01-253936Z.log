ut-security-annotations/5.3.2/.gradle/9.1.0/fileChanges/last-build.bin\ntests/src/io.micronaut.security/micronaut-security-annotations/5.3.2/test-results-native/test/TEST-junit-jupiter.xml\ntests/src/io.micronaut.security/micronaut-security-annotations/5.3.2/test-results-native/test/TEST-junit-vintage.xml\ntests/src/io.micronaut.security/micronaut-security-annotations/5.3.2/.gitignore\ntests/src/io.micronaut.security/micronaut-security-annotations/5.3.2/build/test-results/test/TEST-io_micronaut_security.micronaut_security_annotations.SecuredEvaluationContextRegistrarTest.xml\ntests/src/io.micronaut.security/micronaut-security-annotations/5.3.2/build/test-results/test/binary/results.bin\ntests/src/io.micronaut.security/micronaut-security-annotations/5.3.2/build/test-results/test/binary/output.bin\ntests/src/io.micronaut.security/micronaut-security-annotations/5.3.2/build/test-results/test/binary/output.bin.idx\ntests/src/io.micronaut.security/micronaut-security-annotations/5.3.2/build/test-results/test/testlist/junit-platform-unique-ids-4549039012469564725.txt\ntests/src/io.micronaut.security/micronaut-security-annotations/5.3.2/build/test-results/test/TEST-io_micronaut_security.micronaut_security_annotations.MicronautSecurityAnnotationsTest.xml\ntests/src/io.micronaut.security/micronaut-security-annotations/5.3.2/build/libs/io.micronaut.security.micronaut-security-annotations_tests.jar\ntests/src/io.micronaut.security/micronaut-security-annotations/5.3.2/build/native/agent-output/test/reachability-metadata.json\ntests/src/io.micronaut.security/micronaut-security-annotations/5.3.2/build/native/generated/generateTestResourcesConfigFile/resource-config.json\ntests/src/io.micronaut.security/micronaut-security-annotations/5.3.2/build/native/nativeTestCompile/io.micronaut.security.micronaut-security-annotations_tests-tests\ntests/src/io.micronaut.security/micronaut-security-annotations/5.3.2/build/native/nativeTestCompile/libmanagement_ext.so\ntests/src/io.micronaut.secur