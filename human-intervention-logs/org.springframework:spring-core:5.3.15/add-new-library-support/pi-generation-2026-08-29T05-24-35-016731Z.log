  						getDeclaredAnnotations(methods[i], false).length == 0) {
  					methods[i] = null;
  					cleared++;
  				}
  			}
  			if (cleared == methods.length) {
  				methods = NO_METHODS;
  			}
  			baseTypeMethodsCache.put(baseType, methods);
  		}
  		return methods;
  	}
  
