[tool-exec] start id=call_RaKWbhXgKSMwQzn21kARC6bi|fc_06b84dc180b0b95d016a926afb6d3487d2b5c3a025467bf2ba name=write args={"path": "tests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/MethodInvokerTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_springframework.spring_core;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.junit.jupiter.api.Test;\nimport org.springframework.util.MethodInvoker;\n\n/** Verifies preparation and reflective invocation of a public method. */\npublic class MethodInvokerTest {\n    @Test\n    void invokesConfiguredTargetMethod() throws Exception {\n        MethodInvoker invoker = new MethodInvoker();\n        invoker.setTargetObject(new GreetingService());\n        invoker.setTargetMethod(\"greet\");\n        invoker.setArguments(\"Spring\");\n\n        invoker.prepare();\n\n        assertThat(invoker.invoke()).isEqualTo(\"Hello Spring\");\n    }\n\n    public static final class GreetingService {\n        public String greet(String name) {\n            return \"Hello \" + name;\n        }\n    }\n}\n"}
[tool-exec] start id=call_HsKsk9nT6iIhWcsX80DZxETY|fc_06b84dc180b0b95d016a926afb6d3c87d286f7ca147e64e293 name=write args={"path": "tests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/ObjectUtilsTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_springframework.spring_core;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.junit.jupiter.api.Test;\nimport org.springframework.util.ObjectUtils;\n\n/** Verifies reflective array adaptation utilities. */\npublic class ObjectUtilsTest {\n    @Test\n    void extendsObjectArrayAndBoxesPrimitiveArray() {\n        String[] extended = ObjectUtils.addObjectToArray(new String[] {\"spring\"}, \"core\");\n        Object[] boxed = ObjectUtils.toObjectArray(new int[] {3, 5, 15});\n\n        assertThat(extended).containsExactly(\"spring\", \"core\");\n        assertThat(boxed).containsExactly(3, 5, 15);\n    }\n}\n"}
[tool-exec] start id=call_rxbZgAdfajjjKmFkKdiTE8nw|fc_06b84dc180b0b95d016a926afb6d4487d2b5644186808b5e3b name=write args={"path": "tests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/SerializationUtilsTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_springframework.spring_core;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.ArrayList;\nimport java.util.List;\n\nimport org.junit.jupiter.api.Test;\nimport org.springframework.util.SerializationUtils;\n\n/** Verifies Spring's byte-array serialization round trip. */\npublic class SerializationUtilsTest {\n    @Test\n    void serializesAndDeserializesValue() {\n        List<String> original = new ArrayList<>();\n        original.add(\"spring\");\n        original.add(\"core\");\n\n        byte[] serialized = SerializationUtils.serialize(original);\n\n        assertThat(SerializationUtils.deserialize(serialized)).isEqualTo(original);\n    }\n}\n"}
[tool-exec] start id=call_Upf2xK2KIZu2FMell7vK6ptA|fc_06b84dc180b0b95d016a926afb6d4c87d2a8b328f92b633ae4 name=write args={"path": "tests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/ClassReaderTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_springframework.spring_core;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.junit.jupiter.api.Test;\nimport org.springframework.asm.ClassReader;\n\n/** Verifies ASM class lookup through the system class loader. */\npublic class ClassReaderTest {\n    @Test\n    void readsClassByBinaryName() throws Exception {\n        ClassReader reader = new ClassReader(\"java.lang.String\");\n\n        assertThat(reader.getClassName()).isEqualTo(\"java/lang/String\");\n        assertThat(reader.getSuperName()).isEqualTo(\"java/lang/Object\");\n    }\n}\n"}
[tool-exec] start id=call_PIettJ4GJ4FSggW9i5CLKl5X|fc_06b84dc180b0b95d016a926afb6d5087d285be68b433ee8910 name=write args={"path": "tests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/SpringPropertiesTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_springframework.spring_core;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.junit.jupiter.api.Test;\nimport org.springframework.core.SpringProperties;\n\n/** Verifies Spring's local property registry. */\npublic class SpringPropertiesTest {\n    @Test\n    void storesAndReadsLocalProperty() {\n        SpringProperties.setProperty(\"spring.core.coverage\", \"enabled\");\n        try {\n            assertThat(SpringProperties.getProperty(\"spring.core.coverage\")).isEqualTo(\"enabled\");\n            assertThat(SpringProperties.getFlag(\"spring.core.coverage\")).isTrue();\n        } finally {\n            SpringProperties.setProperty(\"spring.core.coverage\", null);\n        }\n    }\n}\n"}
[tool-exec] start id=call_cGRcYghBFUoNjfW9I6oew41x|fc_06b84dc180b0b95d016a926afb6d5887d2be458c860f995298 name=write args={"path": "tests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/AutoPopulatingListInnerReflectiveElementFactoryTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_springframework.spring_core;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.junit.jupiter.api.Test;\nimport org.springframework.util.AutoPopulatingList;\n\n/** Verifies reflective element creation by an auto-populating list. */\npublic class AutoPopulatingListInnerReflectiveElementFactoryTest {\n    @Test\n    void createsMissingElementUsingDefaultConstructor() {\n        AutoPopulatingList<Element> elements = new AutoPopulatingList<>(Element.class);\n\n        Element element = elements.get(2);\n\n        assertThat(element.created).isTrue();\n        assertThat(elements).hasSize(3);\n        assertThat(elements.get(2)).isSameAs(element);\n    }\n\n    public static final class Element {\n        private final boolean created;\n\n        public Element() {\n            this.created = true;\n        }\n    }\n}\n"}
