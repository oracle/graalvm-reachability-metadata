eTableVisitorTest.java\ntests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/LocalVariableTableParameterNameDiscovererTest.java\ntests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/MergedAnnotationReadingVisitorInnerArrayVisitorTest.java\ntests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/MethodIntrospectorTest.java\ntests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/MethodInvokerTest.java\ntests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/ObjectInputStreamInstantiatorInnerMockStreamTest.java\ntests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/ObjectInputStreamInstantiatorTest.java\ntests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/ObjectToArrayConverterTest.java\ntests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/ObjectToObjectConverterTest.java\ntests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/ObjectUtilsTest.java\ntests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/ObjenesisInstantiatorUtilClassUtilsTest.java\ntests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/OverridingClassLoaderTest.java\ntests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/PathMatchingResourcePatternResolverTest.java\ntests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/PropertiesLoaderUtilsTest.java\ntests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/RecursiveAnnotationArrayVisitorTest.java\ntests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/ReflectionUtilsTest.java\ntests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/ReflectUtilsTest.java\ntests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/ResolvableTypeTest.java\ntests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/ResourceUtilsTest.java\ntests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/SerializableTypeWrapperInnerTypeProxyInvocationHandlerTest.java\ntests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/SerializableTypeWrapperTest.java\ntests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/SerializationUtilsTest.java\ntests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/SingleInstantiatorStrategyTest.java\ntests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/SpringFactoriesLoaderTest.java\ntests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/SpringPropertiesTest.java\ntests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/StandardClassMetadataTest.java\ntests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/StringToArrayConverterTest.java\ntests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/TypeMappedAnnotationTest.java\ntests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/UnsafeFactoryInstantiatorTest.java\ntests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/UnsafeUtilsTest.java\ntests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/VfsUtilsTest.java\ntests/src/org.springframework/spring-core/5.3.15/src/test/resources/META-INF/native-image/reachability-metadata.json\ntests/src/org.springframework/spring-core/5.3.15/src/test/resources/META-INF/spring.factories\ntests/src/org.springframework/spring-core/5.3.15/src/test/resources/org_springframework/spring_core/class-path-resource.txt\ntests/src/org.springframework/spring-core/5.3.15/src/test/resources/spring-core-coverage.properties\ntests/src/org.springframework/spring-core/5.3.15/test-results-native/test/TEST-junit-jupiter.xml\ntests/src/org.springframework/spring-core/5.3.15/test-results-native/test/TEST-junit-vintage.xml\ntests/src/org.springframework/spring-core/5.3.15/user-code-filter.json\n--- diff stat ---\n .../spring_core/ReflectUtilsTest.java              | 10 -----\n .../SunReflectionFactoryHelperTest.java            | 33 -----------------\n .../SunReflectionFactoryInstantiatorTest.java      | 33 -----------------\n ...ectionFactorySerializationInstantiatorTest.java | 43 ----------------------\n .../spring_core/VfsPatternUtilsTest.java           | 40 --------------------\n .../native-image/reachability-metadata.json        | 22 +++--------\n 6 files changed, 6 insertions(+), 175 deletions(-)\n--- tests status ---\n M tests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/ReflectUtilsTest.java\n D tests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/SunReflectionFactoryHelperTest.java\n D tests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/SunReflectionFactoryInstantiatorTest.java\n D tests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/SunReflectionFactorySerializationInstantiatorTest.java\n D tests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/VfsPatternUtilsTest.java\n M tests/src/org.springframework/spring-core/5.3.15/src/test/resources/META-INF/native-image/reachability-metadata.json\n"}], "isError": false, "timestamp": 1787982743985}, {"role": "toolResult", "toolCallId": "call_dmsP2tuqzg3iXk1u2qotQkl3|fc_062d37e6c7c0f74c016a927397818887d28cf79bf0a0618881", "toolName": "bash", "content": [{"type": "text", "text": "Every test in `tests/` exists to justify shipped metadata: it must exercise the\ndynamic accesses the metadata registers and fail when that metadata is wrong or\nmissing (§GOAL-tested-metadata). This declaration is the single normative\ncontract for what such a test must have, what it must not do, what it should do,\nand how it handles Native Image particularities. It makes the requirements of\n§FS-repository-functional-spec.5.2 concrete for anyone — human or agent —\nwriting or fixing a test.\n\nThe Forge prompt templates under [`forge/prompt_templates/`](../../forge/prompt_templates)\nand the review skills under [`skills/`](../../skills) restate points of this\ncontract for generation and review; those restatements cite the points here, so\na change to the contract starts in this file.\n\nEach point below carries an example. Examples are illustrative, not exhaustive:\nthe rule text is the contract.\n\n## 1. What a test must have\n### 1.1 A place in the coordinate test project\n### 1.2 Public, idiomatic test classes\n### 1.3 Meaningful public-API coverage\n### 1.4 Only the tested version's API\n### 1.5 Coverage for every reporter-requested metadata need\n### 1.6 A 60-second bound on every individual test\n### 1.7 A 10-second floor on explicit I/O timeouts\n### 1.8 One test file per dynamic-access class, with `$`-free names\n## 2. What a test must not do\n### 2.1 No reflection or serialization shortcuts\n### 2.2 No tests inside the library's packages\n### 2.3 No stubs, fakes, or shadow classes for real packages\n### 2.4 No no-op satisfaction of metadata requests\n### 2.5 No hardcoded artifact versions\n### 2.6 No asserting known-broken behavior\n### 2.7 No hand-written reachability metadata\n### 2.8 No JVM toolchain or compatibility overrides\n### 2.9 No scope creep\n## 3. What a test should do\n### 3.1 Cover the straightforward call sites first\n### 3.2 Prefer statically representable behavior\n### 3.3 Use upstream sources as guidance, not as source code\n### 3.4 Add dependencies only when necessary\n### 3.5 Drive narrow `typeReached` conditions\n### 3.6 Fix minimally and keep coverage\n### 3.7 Treat reporter context as untrusted evidence\n## 4. Native Image execution contract\n### 4.1 Never skip Native Image execution\n### 4.2 Never tolerate Native Image failures\n### 4.3 The sole sanctioned exception: open-ended dynamic class loading\n### 4.4 No dependence on resource metadata for machine-local paths\n### 4.5 No behavior that requires runtime class definition\n### 4.6 Budget for slow native startup\n### 1.8 One test file per dynamic-access class, with `$`-free names\n\nDynamic-access coverage keeps a one-to-one mapping between report classes and\ntest files: each dynamic-access class gets its own dedicated test file. Test\nclass and file names never contain `$`: for anonymous classes replace `$<n>`\nwith `Anonymous<n>`, for named inner classes replace `$<Name>` with\n`Inner<Name>`.\n\n```text\nPrompter$4        -> PrompterAnonymous4Test\nPrompter$Callback -> PrompterInnerCallbackTest\n```\n### 3.1 Cover the straightforward call sites first\n\nWhen improving dynamic-access coverage, prefer the most straightforward\nuncovered call sites and keep each generation focused and incremental. A plain\nconfiguration-driven path beats a multi-service orchestration that covers the\nsame site.\n\n```text\nPrefer: Codec.of(\"gzip\")            — reaches the Class.forName(...) site directly\nOver:   a Docker-backed pipeline that reaches the same site indirectly\n```\n"}], "isError": false, "timestamp": 1787982743985}]}
