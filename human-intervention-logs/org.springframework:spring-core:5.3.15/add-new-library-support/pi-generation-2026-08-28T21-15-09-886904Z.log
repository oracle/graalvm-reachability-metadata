  import org.junit.jupiter.api.Test;
  import org.springframework.cglib.proxy.InterfaceMaker;
  import org.springframework.core.io.Resource;
  
  /** Verifies collection of public methods from an interface definition. */
  public class InterfaceMakerTest {
      @Test
      void acceptsMethodsFromSpringResourceInterface() {
          InterfaceMaker interfaceMaker = new InterfaceMaker();
  
          assertThatCode(() -> interfaceMaker.add(Resource.class)).doesNotThrowAnyException();
      }
  }
