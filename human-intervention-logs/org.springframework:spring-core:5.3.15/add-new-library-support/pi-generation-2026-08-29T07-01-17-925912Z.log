or.newInstance();\n\n        assertThat(value.text).isEqualTo(\"delegated\");\n    }\n\n    public static final class NamedInstantiator<T> extends DelegatingToExoticInstantiator<T> {\n        public NamedInstantiator(Class<T> type) {\n            super(FixtureInstantiator.class.getName(), type);\n        }\n    }\n\n    public static final class FixtureInstantiator<T> implements ObjectInstantiator<T> {\n        private final Class<T> type;\n\n        public FixtureInstantiator(Class<T> type) {\n            this.type = type;\n        }\n\n        @Override\n        public T newInstance() {\n            return this.type.cast(new SampleValue(\"delegated\"));\n        }\n    }\n\n    public static final class SampleValue {\n        private final String text;\n\n        public SampleValue(String text) {\n            this.text = text;\n        }\n    }\n}\n"}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-sol", "usage": {"input": 3418, "output": 986, "cacheRead": 108032, "cacheWrite": 0, "reasoning": 267, "totalTokens": 112436, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1787986809693, "responseId": "resp_09e6c22d14f3ec97016a928379f14c87d2abba4fb45aa6c208", "rawStopReason": "completed"}, "toolResults": [{"role": "toolResult", "toolCallId": "call_45KBfH92m3PY478MFz8xPldl|fc_09e6c22d14f3ec97016a92838cc50487d2a4f2d75c0802534d", "toolName": "write", "content": [{"type": "text", "text": "Successfully wrote 782 bytes to tests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/InterfaceMakerTest.java"}], "isError": false, "timestamp": 1787986828928}, {"role": "toolResult", "toolCallId": "call_FTVsP3UgUWF7Z5DQAu6XaczY|fc_09e6c22d14f3ec97016a92838cc51487d28de9fe057002bae5", "toolName": "write", "content": [{"type": "text", "text": "Successfully wrote 1660 bytes to tests/src/org.springframework/spring-core/5.3.15/src/test/java/org_sprin