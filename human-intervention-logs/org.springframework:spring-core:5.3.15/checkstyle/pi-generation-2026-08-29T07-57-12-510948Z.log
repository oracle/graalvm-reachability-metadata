ation;\n    16\t\n    17\t/** Verifies typed enum-array access from merged annotations. */\n    18\tpublic class AbstractMergedAnnotationTest {\n    19\t    @Test\n    20\t    void returnsTypedEnumArray() {\n    21\t        Modes annotation = Annotated.class.getAnnotation(Modes.class);\n    22\t        MergedAnnotation<Modes> merged = MergedAnnotation.from(annotation);\n    23\t\n    24\t        assertThat(merged.getEnumArray(\"value\", Mode.class)).containsExactly(Mode.FAST, Mode.SAFE);\n    25\t    }\n    26\t\n    27\t    public enum Mode {\n    28\t        FAST,\n    29\t        SAFE\n    30\t    }\n    31\t\n    32\t    @Retention(RetentionPolicy.RUNTIME)\n    33\t    public @interface Modes {\n    34\t        Mode[] value();\n    35\t    }\n    36\t\n    37\t    @Modes({Mode.FAST, Mode.SAFE})\n    38\t    private static final class Annotated {}\n    39\t}\n===== tests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/ConstantsTest.java\n     1\t/*\n     2\t * Copyright and related rights waived via CC0\n     3\t *\n     4\t * You should have received a copy of the CC0 legalcode along with this\n     5\t * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n     6\t */\n     7\tpackage org_springframework.spring_core;\n     8\t\n     9\timport static org.assertj.core.api.Assertions.assertThat;\n    10\t\n    11\timport org.junit.jupiter.api.Test;\n    12\timport org.springframework.core.Constants;\n    13\t\n    14\t/** Verifies reflective discovery of public constants. */\n    15\tpublic class ConstantsTest {\n    16\t    @Test\n    17\t    void exposesPublicStaticFinalFields() {\n    18\t        Constants constants = new Constants(FixtureConstants.class);\n    19\t\n    20\t        assertThat(constants.getSize()).isEqualTo(2);\n    21\t        assertThat(constants.asString(\"MODE_FAST\")).isEqualTo(\"fast\");\n    22\t        assertThat(constants.asNumber(\"RETRY_COUNT\")).isEqualTo(3);\n    23\t    }\n    24\t\n    25\t    public static final class FixtureConstants {\n    26\t        public static final String MODE_FAST = \"fast\";\n    27\t        public static final int RETRY_COUNT = 3;\n    28\t\n    29\t        private FixtureConstants() {}\n    30\t    }\n    31\t}\n===== tests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/AnnotationAttributesTest.java\n     1\t/*\n     2\t * Copyright and related rights waived via CC0\n     3\t *\n     4\t * You should have received a copy of the CC0 legalcode along with this\n     5\t * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n     6\t */\n     7\tpackage org_springframework.spring_core;\n     8\t\n     9\timport static org.assertj.core.api.Assertions.assertThat;\n    10\t\n    11\timport java.lang.annotation.Retention;\n    12\timport java.lang.annotation.RetentionPolicy;\n    13\t\n    14\timport org.junit.jupiter.api.Test;\n    15\timport org.springframework.core.annotation.AnnotationAttributes;\n    16\t\n    17\t/** Verifies annotation type loading and scalar-to-array adaptation. */\n    18\tpublic class AnnotationAttributesTest {\n    19\t    @Test\n    20\t    void loadsAnnotationTypeAndAdaptsSingleAnnotationToArray() {\n    21\t        AnnotationAttributes attributes = new AnnotationAttributes(\n    22\t                Marker.class.getName(), Marker.class.getClassLoader());\n    23\t        Marker marker = Annotated.class.getAnnotation(Marker.class);\n    24\t        attributes.put(\"markers\", marker);\n    25\t\n    26\t        assertThat(attributes.annotationType()).isEqualTo(Marker.class);\n    27\t        assertThat(attributes.getAnnotationArray(\"markers\", Marker.class)).containsExactly(marker);\n    28\t    }\n    29\t\n    30\t    @Retention(RetentionPolicy.RUNTIME)\n    31\t    public @interface Marker {\n    32\t        String value();\n    33\t    }\n    34\t\n    35\t    @Marker(\"spring\")\n    36\t    private static final cla