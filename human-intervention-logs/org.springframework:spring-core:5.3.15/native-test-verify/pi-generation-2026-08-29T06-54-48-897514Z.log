d field = GenericFields.class.getDeclaredField(\"names\");\n    23\t        ResolvableType original = ResolvableType.forField(field);\n    24\t\n    25\t        ResolvableType restored = roundTrip(original);\n    26\t\n    27\t        assertThat(restored.resolve()).isEqualTo(List.class);\n    28\t        assertThat(restored.resolveGeneric()).isEqualTo(String.class);\n    29\t    }\n    30\t\n    31\t    private static ResolvableType roundTrip(ResolvableType type) {\n    32\t        return (ResolvableType) SerializationUtils.deserialize(SerializationUtils.serialize(type));\n    33\t    }\n    34\t\n    35\t    private static final class GenericFields {\n    36\t        private List<String> names;\n    37\t    }\n    38\t}\n\n===== tests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/SerializableTypeWrapperInnerMethodParameterTypeProviderTest.java =====\n     1\t/*\n     2\t * Copyright and related rights waived via CC0\n     3\t *\n     4\t * You should have received a copy of the CC0 legalcode along with this\n     5\t * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n     6\t */\n     7\tpackage org_springframework.spring_core;\n     8\t\n     9\timport static org.assertj.core.api.Assertions.assertThat;\n    10\t\n    11\timport java.lang.reflect.Constructor;\n    12\timport java.lang.reflect.Method;\n    13\timport java.util.List;\n    14\t\n    15\timport org.junit.jupiter.api.Test;\n    16\timport org.springframework.core.MethodParameter;\n    17\timport org.springframework.core.ResolvableType;\n    18\timport org.springframework.util.SerializationUtils;\n    19\t\n    20\t/** Verifies restoration of generic method and constructor parameter types. */\n    21\tpublic class SerializableTypeWrapperInnerMethodParameterTypeProviderTest {\n    22\t    @Test\n    23\t    void restoresGenericMethodParameter() throws Exception {\n    24\t        Method method = GenericParameters.class.getDeclaredMethod(\"accept\", List.class);\n    25\t        ResolvableType original =\n    26\t                ResolvableType.forMethodParameter(new MethodParameter(method, 0));\n    27\t\n    28\t        ResolvableType restored = roundTrip(original);\n    29\t\n    30\t        assertThat(restored.resolve()).isEqualTo(List.class);\n    31\t        assertThat(restored.resolveGeneric()).isEqualTo(String.class);\n    32\t    }\n    33\t\n    34\t    @Test\n    35\t    void restoresGenericConstructorParameter() throws Exception {\n    36\t        Constructor<GenericParameters> constructor =\n    37\t                GenericParameters.class.getDeclaredConstructor(List.class);\n    38\t        ResolvableType original =\n    39\t                ResolvableType.forMethodParameter(new MethodParameter(constructor, 0));\n    40\t\n    41\t        ResolvableType restored = roundTrip(original);\n    42\t\n    43\t        assertThat(restored.resolve()).isEqualTo(List.class);\n    44\t        assertThat(restored.resolveGeneric()).isEqualTo(Integer.class);\n    45\t    }\n    46\t\n    47\t    private static ResolvableType roundTrip(ResolvableType type) {\n    48\t        return (ResolvableType) SerializationUtils.deserialize(SerializationUtils.serialize(type));\n    49\t    }\n    50\t\n    51\t    public static final class GenericParameters {\n    52\t        public GenericParameters(List<Integer> values) {}\n    53\t\n    54\t        public void accept(List<String> values) {}\n    55\t    }\n    56\t}\n\n===== tests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/SerializableTypeWrapperInnerTypeProxyInvocationHandlerTest.java =====\n     1\t/*\n     2\t * Copyright and related rights waived via CC0\n     3\t *\n     4\t * You should have received a copy of the CC0 legalcode along with this\n     5\t * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n     6\t */\n     7\tpackage org_springframework.spring_core;\n     8\t\n     9\timport static org.assertj.core.api.Assertions.assertThat;\n    10\t\n    11\timport java.lang.reflect.Field;\n    12\timport java.util.Map;\n    13\t\n    14\timport org.junit.jupiter.api.Test;\n    15\timport org.springframework.core.ResolvableType;\n    16\t\n    17\t/** Verifies delegated operations on wrapped generic types. */\n    18\tpublic class SerializableTypeWrapperInnerTypeProxyInvocationHandlerTest {\n    19\t    @Test\n    20\t    void delegatesGenericTypeArrayAndStringOperations() throws Exception {\n    21\t        Field field = GenericFields.class.getDeclaredField(\"entries\");\n    22\t        ResolvableType type = ResolvableType.forField(field);\n    23\t\n    24\t        ResolvableType[] generics = type.getGenerics();\n    25\t\n    26\t        assertThat(generics).extracting(ResolvableType::resolve)\n    27\t                .containsExactly(String.class, Integer.class);\n    28\t        assertThat(type.toString()).contains(\"java.util.Map\", \"java.lang.String\", \"java.lang.Integer\");\n    29\t    }\n    30\t\n    31\t    private static final class GenericFields {\n    32\t        private Map<String, Integer> entries;\n    33\t    }\n    34\t}\n\n===== tests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/SerializableTypeWrapperTest.java =====\n     1\t/*\n     2\t * Copyright and related rights waived via CC0\n     3\t *\n     4\t * You should have received a copy of the CC0 legalcode along with this\n     5\t * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n     6\t */\n     7\tpackage org_springframework.spring_core;\n     8\t\n     9\timport static org.assertj.core.api.Assertions.assertThat;\n    10\t\n    11\timport java.lang.reflect.Field;\n    12\timport java.util.List;\n    13\t\n    14\timport org.junit.jupiter.api.Test;\n    15\timport org.springframework.core.ResolvableType;\n    16\t\n    17\t/** Verifies serializable wrapping of generic field types. */\n    18\tpublic class SerializableTypeWrapperTest {\n    19\t    @Test\n    20\t    void resolvesGenericFieldThroughSerializableTypeWrapper() throws Exception {\n    21\t        Field field = GenericFields.class.getDeclaredField(\"names\");\n    22\t\n    23\t        ResolvableType type = ResolvableType.forField(field);\n    24\t\n    25\t        assertThat(type.resolve()).isEqualTo(List.class);\n    26\t        assertThat(type.resolveGeneric()).isEqualTo(String.class);\n    27\t    }\n    28\t\n    29\t    private static final class GenericFields {\n    30\t        private List<String> names;\n    31\t    }\n    32\t}\n"}], "isError": false, "timestamp": 1787986378035}]}
