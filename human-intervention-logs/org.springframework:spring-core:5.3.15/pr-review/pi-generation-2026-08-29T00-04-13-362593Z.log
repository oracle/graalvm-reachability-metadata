  +    @Target(ElementType.TYPE)
  +    public @interface EmptyArrays {
  +        String[] names();
  +
  +        Nested[] nested();
  +    }
  +
  +    @Retention(RetentionPolicy.RUNTIME)
  +    public @interface Nested {
  +        String value() default "";
  +    }
  +
  +    @EmptyArrays(names = {}, nested = {})
  +    private static final class EmptyArraysFixture {
  +    }
  +}
