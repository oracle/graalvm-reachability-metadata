  +import static org.assertj.core.api.Assertions.assertThat;
  +
  +import java.io.Serializable;
  +
  +import org.junit.jupiter.api.Test;
  +import org.springframework.objenesis.instantiator.basic.ObjectInputStreamInstantiator;
  +
  +/** Verifies constructor-free instantiation through an object input stream. */
  +public class ObjectInputStreamInstantiatorTest {
  +    @Test
  +    void readsSyntheticSerializedInstance() {
  +        ObjectInputStreamInstantiator<Fixture> instantiator =
  +                new ObjectInputStreamInstantiator<>(Fixture.class);
  +
  +        Fixture fixture = instantiator.newInstance();
  +
  +        assertThat(fixture.value).isNull();
  +    }
  +
  +    public static final class Fixture implements Serializable {
  +        private static final long serialVersionUID = 1L;
  +
  +        private final String value;
  +
  +        public Fixture() {
  +            this.value = "constructed";
  +        }
  +    }
  +}
  diff --git a/tests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/ObjectStreamClassInstantiatorTest.java b/tests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/ObjectStreamClassInstantiatorTest.java
  new file mode 100644
