. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n+ */\n+package org_springframework.spring_core;\n+\n+import static org.assertj.core.api.Assertions.assertThat;\n+\n+import java.io.ByteArrayInputStream;\n+import java.io.ByteArrayOutputStream;\n+import java.util.Arrays;\n+\n+import org.junit.jupiter.api.Test;\n+import org.springframework.core.serializer.DefaultDeserializer;\n+import org.springframework.core.serializer.DefaultSerializer;\n+\n+/** Verifies deserialization from an input stream. */\n+public class DefaultDeserializerTest {\n+    @Test\n+    void readsSerializedObject() throws Exception {\n+        ByteArrayOutputStream output = new ByteArrayOutputStream();\n+        new DefaultSerializer().serialize(Arrays.asList(\"spring\", \"core\"), output);\n+\n+        Object restored = new DefaultDeserializer().deserialize(\n+                new ByteArrayInputStream(output.toByteArray()));\n+\n+        assertThat(restored).isEqualTo(Arrays.asList(\"spring\", \"core\"));\n+    }\n+}\ndiff --git a/tests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/DefaultSerializerTest.java b/tests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/DefaultSerializerTest.java\nnew file mode 100644\nindex 0000000000..c9ad4c3324\n--- /dev/null\n+++ b/tests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/DefaultSerializerTest.java\n@@ -0,0 +1,27 @@\n+/*\n+ * Copyright and related rights waived via CC0\n+ *\n+ * You should have received a copy of the CC0 legalcode along with this\n+ * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n+ */\n+package org_springframework.spring_core;\n+\n+import static org.assertj.core.api.Assertions.assertThat;\n+\n+import java.io.ByteArrayOutputStream;\n+import java.util.Arrays;\n+\n+import org.junit.jupiter.api.Test;\n+import org.springframework.core.serializer.DefaultSerializer;\n+\n+/** Verifies serialization to an output stream. */\n+public class DefaultSerializerTest {\n+    @Test\n+    void writesSerializableObject() throws Exception {\n+        ByteArrayOutputStream output = new ByteArrayOutputStream();\n+\n+        new DefaultSerializer().serialize(Arrays.asList(\"spring\", \"core\"), output);\n+\n+        assertThat(output.toByteArray()).isNotEmpty();\n+    }\n+}\ndiff --git a/tests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/DelegatingToExoticInstantiatorTest.java b/tests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/DelegatingToExoticInstantiatorTest.java\nnew file mode 100644\nindex 0000000000..1935232111\n--- /dev/null\n+++ b/tests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/DelegatingToExoticInstantiatorTest.java\n@@ -0,0 +1,61 @@\n+/*\n+ * Copyright and related rights waived via CC0\n+ *\n+ * You should have received a copy of the CC0 legalcode along with this\n+ * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n+ */\n+package org_springframework.spring_core;\n+\n+import static org.assertj.core.api.Assertions.assertThat;\n+\n+import org.junit.jupiter.api.Test;\n+import org.springframework.objenesis.instantiator.ObjectInstantiator;\n+import org.springframework.objenesis.instantiator.basic.DelegatingToExoticInstantiator;\n+\n+/** Verifies delegation to an instantiator selected by its public class name. */\n+public class DelegatingToExoticInstantiatorTest {\n+    @Test\n+    void constructsAndUsesNamedInstantiator() {\n+        FixtureInstantiator.constructedType = null;\n+        NamedInstantiator<SampleValue> instantiator = new NamedInstantiator<>(SampleValue.class);\n+\n+        SampleValue value = instantiator.newInstance();\n+\n+        assertThat(FixtureInstantiator.constructedType).isEqualTo(SampleValue.class);\n+        assertThat(value.getText()).isEqualTo(\"created by delegated instantiator\");\n+    }\n+\n+    public static final class NamedInstantiator<T> extends DelegatingToExoticInstantiator<T> {\n+        public NamedInstantiator(Class<T> type) {\n+            super(FixtureInstantiator.class.getName(), type);\n+        }\n+    }\n+\n+    public static final class FixtureInstantiator<T> implements ObjectInstantiator<T> {\n+        private static Class<?> constructedType;\n+\n+        private final Class<T> type;\n+\n+        public FixtureInstantiator(Class<T> type) {\n+            this.type = type;\n+            constructedType = type;\n+        }\n+\n+        @Override\n+        public T newInstance() {\n+            return this.type.cast(new SampleValue(\"created by delegated instantiator\"));\n+        }\n+    }\n+\n+    public static final class SampleValue {\n+        private final String text;\n+\n+        public SampleValue(String text) {\n+            this.text = text;\n+        }\n+\n+        public String getText() {\n+            return this.text;\n+        }\n+    }\n+}\ndiff --git a/tests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/ObjectInputStreamInstantiatorInnerMockStreamTest.java b/tests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/ObjectInputStreamInstantiatorInnerMockStreamTest.java\nnew file mode 100644\nindex 0000000000..44d0c127cf\n--- /dev/null\n+++ b/tests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/ObjectInputStreamInstantiatorInnerMockStreamTest.java\n@@ -0,0 +1,40 @@\n+/*\n+ * Copyright and related rights waived via CC0\n+ *\n+ * You should have received a copy of the CC0 legalcode along with this\n+ * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n+ */\n+package org_springframework.spring_core;\n+\n+import static org.assertj.core.api.Assertions.assertThat;\n+\n+import java.io.Serializable;\n+\n+import org.junit.jupiter.api.Test;\n+import org.springframework.objenesis.instantiator.basic.ObjectInputStreamInstantiator;\n+\n+/** Verifies serial class descriptor setup in Objenesis' synthetic object stream. */\n+public class ObjectInputStreamInstantiatorInnerMockStreamTest {\n+    @Test\n+    void preparesStreamForSerializableType() {\n+        ObjectInputStreamInstantiator<Fixture> instantiator =\n+                new ObjectInputStreamInstantiator<>(Fixture.class);\n+\n+        Fixture first = instantiator.newInstance();\n+        Fixture second = instantiator.newInstance();\n+\n+        assertThat(first).isNotSameAs(second);\n+        assertThat(first.initialized).isFalse();\n+        assertThat(second.initialized).isFalse();\n+    }\n+\n+    public static final class Fixture implements Serializable {\n+        private static final long serialVersionUID = 1L;\n+\n+        private final boolean initialized;\n+\n+        public Fixture() {\n+            this.initialized = true;\n+        }\n+    }\n+}\ndiff --git a/tests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/SingleInstantiatorStrategyTest.java b/tests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/SingleInstantiatorStrategyTest.java\nnew file mode 100644\nindex 0000000000..6e7fcbe12e\n--- /dev/null\n+++ b/tests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/SingleInstantiatorStrategyTest.java\n@@ -0,0 +1,37 @@\n+/*\n+ * Copyright and related rights waived via CC0\n+ *\n+ * You should have received a copy of the CC0 legalcode along with this\n+ * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n+ */\n+package org_springframework.spring_core;\n+\n+import static org.assertj.core.api.Assertions.assertThat;\n+\n+import org.junit.jupiter.api.Test;\n+import org.springframework.objenesis.instantiator.ObjectInstantiator;\n+import org.springframework.objenesis.instantiator.basic.ConstructorInstantiator;\n+import org.springframework.objenesis.strategy.SingleInstantiatorStrategy;\n+\n+/** Verifies reflective construction of the configured object instantiator. */\n+public class SingleInstantiatorStrategyTest {\n+    @Test\n+    void createsConfiguredInstantiatorForRequestedType() {\n+        SingleInstantiatorStrategy strategy =\n+                new SingleInstantiatorStrategy(ConstructorInstantiator.class);\n+\n+        ObjectInstantiator<Fixture> instantiator = strategy.newInstantiatorOf(Fixture.class);\n+        Fixture fixture = instantiator.newInstance();\n+\n+        assertThat(instantiator).isInstanceOf(ConstructorInstantiator.class);\n+        assertThat(fixture.value).isEqualTo(\"constructed\");\n+    }\n+\n+    public static final class Fixture {\n+        private final String value;\n+\n+        public Fixture() {\n+            this.value = \"constructed\";\n+        }\n+    }\n+}\ndiff --git a/tests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/SunReflectionFactoryHelperTest.java b/tests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/SunReflectionFactoryHelperTest.java\nnew file mode 100644\nindex 0000000000..c309c031aa\n--- /dev/null\n+++ b/tests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/SunReflectionFactoryHelperTest.java\n@@ -0,0 +1,37 @@\n+/*\n+ * Copyright and related rights waived via CC0\n+ *\n+ * You should have received a copy of the CC0 legalcode along with this\n+ * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n+ */\n+package org_springframework.spring_core;\n+\n+import static org.assertj.core.api.Assertions.assertThat;\n+\n+import java.io.Serializable;\n+\n+import org.junit.jupiter.api.Test;\n+import org.springframework.objenesis.instantiator.sun.SunReflectionFactoryInstantiator;\n+\n+/** Verifies serialization-constructor creation through Objenesis' reflection factory helper. */\n+public class SunReflectionFac