  diff --git a/tests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/ObjectStreamClassInstantiatorTest.java b/tests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/ObjectStreamClassInstantiatorTest.java
