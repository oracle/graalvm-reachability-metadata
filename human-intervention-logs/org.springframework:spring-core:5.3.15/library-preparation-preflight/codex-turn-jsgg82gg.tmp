tionAttributes\"\n      },\n      \"type\" : \"org_springframework.spring_core.AnnotationUtilsTest$NestedAnnotation[]\"\n    },\n    {\n      \"condition\" : {\n        \"typeReached\" : \"org.springframework.core.annotation.AnnotationUtils\"\n      },\n      \"type\" : \"org_springframework.spring_core.AnnotationUtilsTest$NestedAnnotation[]\"\n    },\n    {\n      \"condition\" : {\n        \"typeReached\" : \"org.springframework.core.annotation.AnnotationUtils\"\n      },\n      \"type\" : \"org_springframework.spring_core.AnnotationUtilsTest$ValueAnnotation\",\n      \"methods\" : [\n        {\n          \"name\" : \"value\",\n          \"parameterTypes\" : [ ]\n        }\n      ]\n    },\n    {\n      \"condition\" : {\n        \"typeReached\" : \"org.springframework.core.annotation.AbstractMergedAnnotation\"\n      },\n      \"type\" : \"org_springframework.spring_core.TypeMappedAnnotationTest$NestedAnnotation[]\"\n    },\n    {\n      \"condition\" : {\n        \"typeReached\" : \"org.springframework.core.annotation.TypeMappedAnnotation\"\n      },\n      \"type\" : \"org_springframework.spring_core.TypeMappedAnnotationTest$NestedAnnotation[]\"\n    },\n    {\n      \"condition\" : {\n        \"typeReached\" : \"org.springframework.core.annotation.SynthesizedMergedAnnotationInvocationHandler\"\n      },\n      \"type\" : {\n        \"proxy\" : [\n          \"org_springframework.spring_core.TypeMappedAnnotationTest$NestedAnnotation\",\n          \"org.springframework.core.annotation.SynthesizedAnnotation\"\n        ]\n      }\n    }\n  ],\n  \"resources\" : [\n    {\n      \"condition\" : {\n        \"typeReached\" : \"org_springframework.spring_core.AbstractClassLoaderTest\"\n      },\n      \"glob\" : \"org_springframework/spring_core/AbsentTransformedType.class\"\n    },\n    {\n      \"condition\" : {\n        \"typeReached\" : \"org.springframework.core.io.ClassPathResource\"\n      },\n      \"glob\" : \"org_springframework/spring_core/class-path-resource