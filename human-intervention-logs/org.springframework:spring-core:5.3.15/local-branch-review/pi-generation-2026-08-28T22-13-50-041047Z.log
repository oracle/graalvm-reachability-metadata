  diff --git a/tests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/ConfigurableObjectInputStreamTest.java b/tests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/ConfigurableObjectInputStreamTest.java
  new file mode 100644
  index 0000000000..7c8a3506f5
