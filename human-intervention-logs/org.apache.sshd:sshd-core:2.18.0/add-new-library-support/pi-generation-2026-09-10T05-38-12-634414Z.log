", "id": "call_f4tYrzJtwONNWrswZXvFQALk|fc_05f5225cd512b660016aa246d1276087d288b3d7db993808e6", "name": "write", "arguments": {"path": "tests/src/org.apache.sshd/sshd-core/2.18.0/src/test/java/org_apache_sshd/sshd_core/SshClientConfigFileReaderTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_sshd.sshd_core;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.time.Duration;\nimport java.util.HashMap;\nimport java.util.Map;\n\nimport org.apache.sshd.client.SshClient;\nimport org.apache.sshd.client.config.SshClientConfigFileReader;\nimport org.apache.sshd.core.CoreModuleProperties;\nimport org.junit.jupiter.api.Test;\n\npublic class SshClientConfigFileReaderTest {\n    @Test\n    void appliesConfiguredHeartbeatIntervalsToClient() {\n        Duration interval = Duration.ofSeconds(10);\n        Duration replyWait = Duration.ofSeconds(10);\n        Map<String, Object> options = new HashMap<>();\n        options.put(\"ClientAliveInterval\", interval);\n        options.put(\"ClientAliveReplyWait\", replyWait);\n\n        SshClient client = new SshClient();\n        try {\n            SshClientConfigFileReader.setupClientHeartbeat(client, options);\n\n            assertThat(CoreModuleProperties.HEARTBEAT_INTERVAL.getRequired(client)).isEqualTo(interval);\n            assertThat(CoreModuleProperties.HEARTBEAT_REPLY_WAIT.getRequired(client)).isEqualTo(replyWait);\n        } finally {\n            client.close(true);\n        }\n    }\n}\n"}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-terra", "usage": {"input": 2532, "output": 1635, "cacheRead": 230912, "cacheWrite": 0, "reasoning": 1237, "totalTokens": 235079, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "t