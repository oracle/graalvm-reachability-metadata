, "text": "sshd-common/src/main/java/org/apache/sshd/server/ExitCallback.java\npublic interface ExitCallback {\n\n    /**\n     * Informs the SSH server that the shell has exited\n     *\n--\n    default void onExit(int exitValue) {\n        onExit(exitValue, false);\n    }\n\n    /**\n--\n    default void onExit(int exitValue, boolean closeImmediately) {\n        onExit(exitValue, \"\", closeImmediately);\n    }\n\n    /**\n--\n    default void onExit(int exitValue, String exitMessage) {\n        onExit(exitValue, exitMessage, false);\n    }\n\n    /**\n--\n    void onExit(int exitValue, String exitMessage, boolean closeImmediately);\n\n}\nsshd-core/src/main/java/org/apache/sshd/server/ExitCallback.java\n    private ServerSession serverSession;\n\n    protected AbstractCommandSupport(String command, CloseableExecutorService executorService) {\n        this.command = command;\n\n        if (executorService == null) {\n            String poolName = GenericUtils.isEmpty(command)\n                    ? getClass().getSimpleName()\n                    : command.replace(' ', '_').replace('/', ':');\n            this.executorService = ThreadUtils.newSingleThreadExecutor(\n                    poolName + \"-\" + Math.abs(System.nanoTime() & 0xFFFF));\n        } else {\n            this.executorService = executorService;\n        }\n    }\n\n    public String getCommand() {\n"}], "isError": false, "timestamp": 1789018868233}]}
