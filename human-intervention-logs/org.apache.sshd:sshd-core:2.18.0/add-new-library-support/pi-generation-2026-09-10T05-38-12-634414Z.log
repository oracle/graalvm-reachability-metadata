ty();\n        } finally {\n            client.stop();\n        }\n    }\n}\n"}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-terra", "usage": {"input": 677, "output": 2212, "cacheRead": 200192, "cacheWrite": 0, "reasoning": 1882, "totalTokens": 203081, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1789019610751, "responseId": "resp_05f5225cd512b660016aa245daff2087d2845a95dee1013f72", "rawStopReason": "completed"}, "toolResults": [{"role": "toolResult", "toolCallId": "call_egPZE8FUL7JunE4VVkkvrmjh|fc_05f5225cd512b660016aa245fe1c6c87d2b96b5a124be57cc7", "toolName": "write", "content": [{"type": "text", "text": "Successfully wrote 1093 bytes to tests/src/org.apache.sshd/sshd-core/2.18.0/src/test/java/org_apache_sshd/sshd_core/Sshd_coreTest.java"}], "isError": false, "timestamp": 1789019651850}]}
