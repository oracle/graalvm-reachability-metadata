[tool-call] delta {"path":"tests/src/org.apache.sshd/sshd-core/2.18.0/src/test/java/org_apache_sshd/sshd_core/SshClientConfigFileReaderTest.java","content":"/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_sshd.sshd_core;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.time.Duration;\nimport java.util.HashMap;\nimport java.util.Map;\n\nimport org.apache.sshd.client.config.SshClientConfigFileReader;\nimport org.apache.sshd.common.PropertyResolver;\nimport org.apache.sshd.common.PropertyResolverUtils;\nimport org.junit.jupiter.api.Test;\n\npublic class SshClientConfigFileReaderTest {\n    @Test\n    void readsConfiguredHeartbeatIntervals() {\n        Duration interval = Duration.ofSeconds(10);\n        Duration replyWait = Duration.ofSeconds(10);\n        Map<String, Object> options = new HashMap<>();\n        options.put(\"ClientAliveInterval\", interval.toMillis());\n        options.put(\"ClientAliveReplyWait\", replyWait.toMillis());\n\n        PropertyResolver properties = PropertyResolverUtils.toPropertyResolver(options);\n\n        assertThat(SshClientConfigFileReader.CLIENT_LIVECHECK_INTERVAL_PROP.getRequired(properties))\n                .isEqualTo(interval);\n        assertThat(SshClientConfigFileReader.CLIENT_LIVECHECK_REPLIES_WAIT.getRequired(properties))\n                .isEqualTo(replyWait);\n    }\n}\n"}
