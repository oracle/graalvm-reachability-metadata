[tool-call] delta {"path":"tests/src/org.apache.sshd/sshd-core/2.18.0/src/test/java/org_apache_sshd/sshd_core/Sshd_coreTest.java","content":"/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_sshd.sshd_core;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.List;\n\nimport org.apache.sshd.client.config.hosts.HostConfigEntry;\nimport org.junit.jupiter.api.Test;\n\npublic class Sshd_coreTest {\n    @Test\n    void collatesMatchingSshHostConfigurationEntries() {\n        HostConfigEntry defaults = new HostConfigEntry(\"*.example.test\", \"ssh.example.test\", 2222, \"default-user\");\n        HostConfigEntry override = new HostConfigEntry(\"build.example.test\", null, 0, \"build-user\");\n\n        override.collate(defaults);\n        List<HostConfigEntry> matches = HostConfigEntry.findMatchingEntries(\"build.example.test\", defaults, override);\n\n        assertThat(override.getHostName()).isEqualTo(\"ssh.example.test\");\n        assertThat(override.getPort()).isEqualTo(2222);\n        assertThat(override.getUsername()).isEqualTo(\"build-user\");\n        assertThat(matches).containsExactly(defaults, override);\n    }\n}\n"}
[tool-call] end id=call_cpKB1ayajIdsXvziEdKc5l8K|fc_05f5225cd512b660016aa24665441887d29ff88defff60db0f name=write args={"path": "tests/src/org.apache.sshd/sshd-core/2.18.0/src/test/java/org_apache_sshd/sshd_core/Sshd_coreTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_sshd.sshd_core;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.List;\n\nimport org.apache.sshd.client.config.hosts.HostConfigEntry;\nimport org.junit.jupiter.api.Test;\n\npublic class Sshd_coreTest {\n    @Test\n    void collatesMatchingSshHostConfigurationEntries() {\n        HostConfigEntry defaults = new HostConfigEntry(\"*.example.test\", \"ssh.example.test\", 2222, \"default-user\");\n        HostConfigEntry override = new HostConfigEntry(\"build.example.test\", null, 0, \"build-user\");\n\n        override.collate(defaults);\n        List<HostConfigEntry> matches = HostConfigEntry.findMatchingEntries(\"build.example.test\", defaults, override);\n\n        assertThat(override.getHostName()).isEqualTo(\"ssh.example.test\");\n        assertThat(override.getPort()).isEqualTo(2222);\n        assertThat(override.getUsername()).isEqualTo(\"build-user\");\n        assertThat(matches).containsExactly(defaults, override);\n    }\n}\n"}
