      /**
       * A {@link KeyPairProvider} that has no keys
       */
      KeyPairProvider EMPTY_KEYPAIR_PROVIDER = new KeyPairProvider() {
          @Override
          public KeyPair loadKey(SessionContext session, String type) {
              return null;
          }
  
          @Override
