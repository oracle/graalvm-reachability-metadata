[tool-call] delta {"path":"tests/src/org.apache.sshd/sshd-core/2.18.0/src/test/java/org_apache_sshd/sshd_core/BuiltinUserAuthFactoriesTest.java","content":"/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_sshd.sshd_core;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.sshd.client.auth.BuiltinUserAuthFactories;\nimport org.junit.jupiter.api.Test;\n\npublic class BuiltinUserAuthFactoriesTest {\n    @Test\n    void parsesSupportedAndUnsupportedAuthenticationFactories() {\n        BuiltinUserAuthFactories.ParseResult result =\n                BuiltinUserAuthFactories.parseFactoriesList(\"password,publickey,unsupported\");\n\n        assertThat(result.getParsedFactories()).hasSize(2);\n        assertThat(result.getParsedFactories().get(0).getName()).isEqualTo(\"password\");\n        assertThat(result.getParsedFactories().get(1).getName()).isEqualTo(\"publickey\");\n        assertThat(result.getUnsupportedFactories()).containsExactly(\"unsupported\");\n    }\n}\n"}
