d-core/index.json:9:    \"description\" : \"Apache MINA SSHD is a pure-Java implementation of the SSH protocols for client and server applications. The sshd-core module provides the core SSH client and server functionality used by Java applications.\",\nmetadata/org.apache.sshd/sshd-core/index.json:14:      \"org.apache.sshd\"\ntests/src/com.github.mwiede/jsch/2.27.7/src/test/java/com_github_mwiede/jsch/KeyExchangeTest.java:57:    void verifySshDssLoadsConfiguredSignature() throws Exception {\ntests/src/org.apache.sshd/sshd-core/2.18.0/settings.gradle:20:rootProject.name = 'org.apache.sshd.sshd-core_tests'\ntests/src/org.apache.sshd/sshd-core/2.18.0/gradle.properties:4:library.coordinates = org.apache.sshd:sshd-core:2.18.0\ntests/src/org.apache.sshd/sshd-core/2.18.0/gradle.properties:6:metadata.dir = org.apache.sshd/sshd-core/2.18.0/\ntests/src/org.apache.sshd/sshd-core/2.18.0/build.gradle:14:    testImplementation \"org.apache.sshd:sshd-core:$libraryVersion\"\ntests/src/org.apache.sshd/sshd-core/2.18.0/src/test/java/org_apache_sshd/sshd_core/Sshd_coreTest.java:7:package org_apache_sshd.sshd_core;\ntests/src/org.apache.sshd/sshd-core/2.18.0/src/test/java/org_apache_sshd/sshd_core/Sshd_coreTest.java:11:class Sshd_coreTest {\ntests/src/org.apache.sshd/sshd-core/2.18.0/user-code-filter.json:7:      \"includeClasses\": \"org.apache.sshd.**\"", "truncated": true, "truncatedBy": "bytes", "totalLines": 710, "totalBytes": 93990, "outputLines": 390, "outputBytes": 51080, "lastLinePartial": false, "firstLineExceedsLimit": false, "maxLines": 2000, "maxBytes": 51200}, "fullOutputPath": "/tmp/pi-bash-239891601d31b3dc.log"}, "isError": false, "timestamp": 1789018699728}}
