     SshServer server = SshServer.setUpDefaultServer();\n        server.setHost(\"127.0.0.1\");\n        server.setPort(0);\n        server.setKeyPairProvider(new SimpleGeneratorHostKeyProvider());\n        server.setPasswordAuthenticator(new CredentialsAuthenticator());\n        server.setCommandFactory(new GreetingCommandFactory());\n        server.start();\n\n        SshClient client = SshClient.setUpDefaultClient();\n        client.setServerKeyVerifier(AcceptAllServerKeyVerifier.INSTANCE);\n        client.start();\n        try {\n            try (ClientSession session = client.connect(USERNAME, \"127.0.0.1\", server.getPort())\n                    .verify(TIMEOUT_SECONDS, TimeUnit.SECONDS)\n                    .getSession()) {\n                session.addPasswordIdentity(PASSWORD);\n                session.auth().verify(TIMEOUT_SECONDS, TimeUnit.SECONDS);\n\n                assertThat(session.isAuthenticated()).isTrue();\n\n                try (ByteArrayOutputStream output = new ByteArrayOutputStream();\n                        ClientChannel channel = session.createExecChannel(COMMAND)) {\n                    channel.setOut(output);\n                    channel.open().verify(TIMEOUT_SECONDS, TimeUnit.SECONDS);\n\n                    assertThat(channel.waitFor(EnumSet.of(ClientChannelEvent.CLOSED),\n                            TimeUnit.SECONDS.toMillis(TIMEOUT_SECONDS)))\n                            .contains(ClientChannelEvent.CLOSED, ClientChannelEvent.EXIT_STATUS);\n                    assertThat(channel.getExitStatus()).isZero();\n                    assertThat(new String(output.toByteArray(), StandardCharsets.UTF_8)).isEqualTo(RESPONSE);\n                }\n            }\n        } finally {\n            try {\n                client.stop();\n            } finally {\n                server.stop(true);\n            }\n        }\n    }\n\n    private static final class CredentialsAuthenticator implements PasswordAuthenticator {\n        @Override\n        public boolean authenticate(String username, String password, ServerSession session) {\n            return USERNAME.equals(username) && PASSWORD.equals(password);\n        }\n    }\n\n    private static final class GreetingCommandFactory implements CommandFactory {\n        @Override\n        public Command createCommand(ChannelSession channel, String command) {\n            return new GreetingCommand();\n        }\n    }\n\n    private static final class GreetingCommand extends AbstractCommandSupport {\n        private GreetingCommand() {\n            super(COMMAND, null);\n        }\n\n        @Override\n        public void run() {\n            try {\n                getOutputStream().write(RESPONSE.getBytes(StandardCharsets.UTF_8));\n                getOutputStream().flush();\n                onExit(0);\n            } catch (IOException exception) {\n                onExit(-1, exception.getMessage());\n            }\n        }\n    }\n}\n"}
