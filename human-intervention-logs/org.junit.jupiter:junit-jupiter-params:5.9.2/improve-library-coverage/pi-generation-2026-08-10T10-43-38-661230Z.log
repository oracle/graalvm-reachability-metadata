rt static org.assertj.core.api.Assertions.assertThat;\n\nimport java.io.StringReader;\nimport java.lang.annotation.ElementType;\nimport java.lang.annotation.Retention;\nimport java.lang.annotation.RetentionPolicy;\nimport java.lang.annotation.Target;\nimport java.lang.reflect.Field;\nimport java.math.BigDecimal;\nimport java.util.List;\n\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.params.shadow.com.univocity.parsers.annotations.Copy;\nimport org.junit.jupiter.params.shadow.com.univocity.parsers.annotations.Format;\nimport org.junit.jupiter.params.shadow.com.univocity.parsers.annotations.HeaderTransformer;\nimport org.junit.jupiter.params.shadow.com.univocity.parsers.annotations.Nested;\nimport org.junit.jupiter.params.shadow.com.univocity.parsers.annotations.Parsed;\nimport org.junit.jupiter.params.shadow.com.univocity.parsers.annotations.helpers.AnnotationHelper;\nimport org.junit.jupiter.params.shadow.com.univocity.parsers.csv.CsvRoutines;\n\npublic class AnnotationHelperTest {\n\n    @Test\n    void parsesBeansUsingFieldsSettersAndComposedAnnotations() {\n        CsvRoutines routines = new CsvRoutines();\n\n        List<FormattedRecord> records = routines.parseAll(\n                FormattedRecord.class, new StringReader(\"Ada,12.50,active\\n\"));\n\n        assertThat(records).singleElement().satisfies(record -> {\n            assertThat(record.name).isEqualTo(\"Ada\");\n            assertThat(record.amount).isEqualByComparingTo(\"12.50\");\n            assertThat(record.status).isEqualTo(\"active\");\n        });\n        assertThat(AnnotationHelper.getAnnotatedFields(FormattedRecord.class))\n                .extracting(field -> field.getName())\n                .contains(\"amount\");\n    }\n\n    @Test\n    void parsesNestedBeansWithCustomHeaderTransformers() {\n        CsvRoutines routines = new CsvRoutines();\n\n        List<ArgumentTransformerRecord> argumentRecords = routines.parseAll(\n                ArgumentTransformerRecord.class, new StringReader(\"Ada\\n\"));\n        List<DefaultTransformerRecord> defaultRecords = routines.parseAll(\n                DefaultTransformerRecord.class, new StringReader(\"Grace\\n\"));\n\n        assertThat(argumentRecords).singleElement().satisfies(record ->\n                assertThat(record.person.name).isEqualTo(\"Ada\"));\n        assertThat(defaultRecords).singleElement().satisfies(record ->\n                assertThat(record.person.name).isEqualTo(\"Grace\"));\n    }\n\n    @Retention(RetentionPolicy.RUNTIME)\n    @Target({ElementType.FIELD, ElementType.METHOD})\n    @Parsed\n    public @interface CopiedParsed {\n\n        @Copy(to = Parsed.class)\n        String field() default \"\";\n\n        @Copy(to = Parsed.class, property = \"index\")\n        int column() default -1;\n    }\n\n    public static class FormattedRecord {\n\n        @CopiedParsed(field = \"name\", column = 0)\n        String name;\n\n        @Parsed(index = 1)\n        @Format(formats = \"#0.00\", options = \"decimalSeparator=.\")\n        BigDecimal amount;\n\n        String status;\n\n        @Parsed(index = 2)\n        public void setStatus(String status) {\n            this.status = status;\n        }\n    }\n\n    public static class ArgumentTransformerRecord {\n\n        @Nested(type = Person.class, headerTransformer = PrefixTransformer.class, args = \"person_\")\n        Person person;\n    }\n\n    public static class DefaultTransformerRecord {\n\n        @Nested(type = Person.class, headerTransformer = DefaultTransformer.class)\n        Person person;\n    }\n\n    public static class Person {\n\n        @Parsed(index = 0)\n        String name;\n    }\n\n    public static class PrefixTransformer extends HeaderTransformer {\n\n        private final String prefix;\n\n        public PrefixTransformer(String[] args) {\n            this.prefix = args[0];\n        }\n\n        @Override\n        public String transformName(Field field, String name) {\n            return prefix + name;\n        }\n    }\n\n    public static class DefaultTransformer extends HeaderTransformer {\n    }\n}\n"}], "isError": false, "timestamp": 1786358541878}, {"role": "toolResult", "toolCallId": "call_K4oSKZ6mLRMwL4fXaQFG71vy|fc_02828811d816c694016a79ab0d5a0081918907e2d142c7d37c", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_junit_jupiter.junit_jupiter_params;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.util.stream.Stream;\n\nimport org.junit.jupiter.api.extension.ExtensionContext;\nimport org.junit.jupiter.params.ParameterizedTest;\nimport org.junit.jupiter.params.provider.Arguments;\nimport org.junit.jupiter.params.provider.ArgumentsProvider;\nimport org.junit.jupiter.params.provider.ArgumentsSource;\nimport org.junit.jupiter.params.provider.ValueSource;\n\nclass JunitJupiterParamsTest {\n\n    @ParameterizedTest\n    @ValueSource(strings = {\"alpha\", \"beta\"})\n    void providesArgumentsFromValueSource(String value) {\n        assertThat(value).isNotBlank();\n    }\n\n    @ParameterizedTest\n    @ArgumentsSource(WordArgumentsProvider.class)\n    void providesArgumentsFromCustomSource(String value, int length) {\n        assertThat(value).hasSize(length);\n    }\n\n    public static class WordArgumentsProvider implements ArgumentsProvider {\n\n        @Override\n        public Stream<? extends Arguments> provideArguments(ExtensionContext context) {\n            return Stream.of(\n                    Arguments.of(\"jupiter\", 7),\n                    Arguments.of(\"params\", 6));\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1786358541878}, {"role": "toolResult", "toolCallId": "call_fOU8kB0mwP9cObi6ULcPIdBC|fc_02828811d816c694016a79ab0d5a0881919fc6719ef88371ea", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_junit_jupiter.junit_jupiter_params;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.params.shadow.com.univocity.parsers.conversions.EnumConversion;\nimport org.junit.jupiter.params.shadow.com.univocity.parsers.conversions.EnumSelector;\n\npublic class EnumConversionTest {\n\n    @Test\n    void convertsEnumsUsingCustomFields() {\n        EnumConversion<FieldValue> conversion = new EnumConversion<>(\n                FieldValue.class, \"code\", EnumSelector.CUSTOM_FIELD);\n\n        assertThat(conversion.execute(\"first-code\")).isEqualTo(FieldValue.FIRST);\n        assertThat(conversion.revert(FieldValue.SECOND)).isEqualTo(\"second-code\");\n    }\n\n    @Test\n    void convertsEnumsUsingCustomMethodsWithInput() {\n        EnumConversion<MethodValue> conversion = new EnumConversion<>(\n                MethodValue.class, \"fromCode\", EnumSelector.CUSTOM_METHOD);\n\n        assertThat(conversion.execute(\"second-code\")).isEqualTo(MethodValue.SECOND);\n    }\n\n    @Test\n    void convertsEnumsUsingCustomMethodsWithoutInput() {\n        EnumConversion<SingletonMethodValue> conversion = new EnumConversion<>(\n                SingletonMethodValue.class, \"selected\", EnumSelector.CUSTOM_METHOD);\n\n        assertThat(conversion.execute(\"ONLY\")).isEqualTo(SingletonMethodValue.ONLY);\n        assertThat(conversion.revert(SingletonMethodValue.ONLY)).isEqualTo(\"ONLY\");\n    }\n\n    private enum FieldValue {\n        FIRST(\"first-code\"),\n        SECOND(\"second-code\");\n\n        private final String code;\n\n        FieldValue(String code) {\n            this.code = code;\n        }\n    }\n\n    private enum MethodValue {\n        FIRST,\n        SECOND;\n\n        public static MethodValue fromCode(String code) {\n            return \"first-code\".equals(code) ? FIRST : SECOND;\n        }\n    }\n\n    private enum SingletonMethodValue {\n        ONLY;\n\n        public static SingletonMethodValue selected() {\n            return ONLY;\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1786358541878}, {"role": "toolResult", "toolCallId": "call_eReXuq0hHocyxuW7quzHMK5Y|fc_02828811d816c694016a79ab0d5a0c81919060ee064afab9ee", "toolName": "bash", "content": [{"type": "text", "text": "/home/mihailo/git/graalvm-reachability-metadata-copy/forge/local_repositories/source_context/org.junit.jupiter/junit-jupiter-params/5.9.2/main/junit-jupiter-params-5.9.2-sources.jar\n/home/mihailo/git/graalvm-reachability-metadata-copy/forge/local_repositories/source_context/org.junit.jupiter/junit-jupiter-params/5.9.2/main/extracted/META-INF/MANIFEST.MF\n/home/mihailo/git/graalvm-reachability-metadata-copy/forge/local_repositories/source_context/org.junit.jupiter/junit-jupiter-params/5.9.2/main/extracted/META-INF/LICENSE.md\n/home/mihailo/git/graalvm-reachability-metadata-copy/forge/local_repositories/source_context/org.junit.jupiter/junit-jupiter-params/5.9.2/main/extracted/META-INF/LICENSE-notice.md\n/home/mihailo/git/graalvm-reachability-metadata-copy/forge/local_repositories/source_context/org.junit.jupiter/junit-jupiter-params/5.9.2/main/extracted/org/junit/jupiter/params/support/AnnotationConsumer.java\n/home/mihailo/git/graalvm-reachability-metadata-copy/forge/local_repositories/source_context/org.junit.jupiter/junit-jupiter-params/5.9.2/main/extracted/org/junit/jupiter/params/support/package-info.java\n/home/mihailo/git/graalvm-reachability-metadata-copy/forge/local_repositories/source_context/org.junit.jupiter/junit-jupiter-params/5.9.2/main/extracted/org/junit/jupiter/params/support/AnnotationConsumerInitializer.java\n/home/mihailo/git/graalvm-reachability-metadata-copy/forge/local_repositories/source_context/