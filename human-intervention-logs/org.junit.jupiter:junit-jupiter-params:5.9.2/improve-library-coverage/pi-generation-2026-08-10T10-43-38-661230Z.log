          @Format(formats = "#0.00", options = "decimalSeparator=.")
          BigDecimal amount;
  
          String status;
  
          @Parsed(index = 2)
          public void setStatus(String status) {
              this.status = status;
          }
      }
  
      public static class ArgumentTransformerRecord {
  
          @Nested(type = Person.class, headerTransformer = PrefixTransformer.class, args = "person_")
          Person person;
      }
  
      public static class DefaultTransformerRecord {
  
          @Nested(type = Person.class, headerTransformer = DefaultTransformer.class)
          Person person;
      }
  
      public static class Person {
  
          @Parsed(index = 0)
          String name;
      }
  
      public static class PrefixTransformer extends HeaderTransformer {
  
          private final String prefix;
  
          public PrefixTransformer(String[] args) {
              this.prefix = args[0];
          }
  
          @Override
          public String transformName(Field field, String name) {
              return prefix + name;
          }
      }
  
      public static class DefaultTransformer extends HeaderTransformer {
      }
  }
