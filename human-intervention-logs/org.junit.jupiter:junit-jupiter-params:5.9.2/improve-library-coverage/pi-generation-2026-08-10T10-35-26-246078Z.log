     699		static String describeElement(AnnotatedElement element) {
     700			String description;
     701			if (element instanceof Field) {
     702				description = "attribute '" + ((Field) element).getName() + "'";
     703			} else {
     704				description = "method '" + ((Method) element).getName() + "'";
     705			}
     706			return description + " of class " + getDeclaringClass(element).getName();
     707		}
