     344			} else if (fieldType == Short.class || fieldType == short.class) {
     345				conversion = Conversions.toShort();
     346				valueIfStringIsNull = nullRead == null ? null : Short.valueOf(nullRead);
     347			} else if (fieldType == Integer.class || fieldType == int.class) {
     348				conversion = Conversions.toInteger();
     349				valueIfStringIsNull = nullRead == null ? null : Integer.valueOf(nullRead);
     350			} else if (fieldType == Long.class || fieldType == long.class) {
     351				conversion = Conversions.toLong();
     352				valueIfStringIsNull = nullRead == null ? null : Long.valueOf(nullRead);
     353			} else if (fieldType == Float.class || fieldType == float.class) {
     354				conversion = Conversions.toFloat();
     355				valueIfStringIsNull = nullRead == null ? null : Float.valueOf(nullRead);
     356			} else if (fieldType == Double.class || fieldType == double.class) {
     357				conversion = Conversions.toDouble();
     358				valueIfStringIsNull = nullRead == null ? null : Double.valueOf(nullRead);
     359			} else if (fieldType == BigInteger.class) {
     360				conversion = Conversions.toBigInteger();
     361				valueIfStringIsNull = nullRead == null ? null : new BigInteger(nullRead);
     362			} else if (fieldType == BigDecimal.class) {
     363				conversion = Conversions.toBigDecimal();
     364				valueIfStringIsNull = nullRead == null ? null : new BigDecimal(nullRead);
     365			} else if (Enum.class.isAssignableFrom(fieldType)) {
     366				conversion = Conversions.toEnum(fieldType);
     367			}
