     910		/**
     911		 * Returns all methods available from a given class
     912		 *
     913		 * @param beanClass a class whose methods will be returned.
     914		 * @param filter    filter to apply over annotated methods when the class is being used for reading data from beans (to write values to an output)
     915		 *                  or when writing values into beans (while parsing). It is used to choose either a "get" or a "set"
     916		 *                  method annotated with {@link Parsed}, when both methods target the same field.
     917		 *
     918		 * @return a list of {@link Method}s that conform to the given filter.
     919		 */
     920		public static List<Method> getAllMethods(Class<?> beanClass, MethodFilter filter) {
     921			return getAnnotatedMethods(beanClass, filter, NO_ANNOTATIONS.class);
