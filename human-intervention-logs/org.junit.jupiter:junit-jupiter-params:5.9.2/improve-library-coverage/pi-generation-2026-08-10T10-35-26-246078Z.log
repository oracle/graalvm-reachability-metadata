     390		/**
     391		 * Applied the configuration of a formatter object ({@link SimpleDateFormat}, {@link NumberFormat} and others).
     392		 *
     393		 * @param formatter           the formatter instance
     394		 * @param propertiesAndValues a sequence of key-value pairs, where the key is a property of the formatter
     395		 *                            object to be set to the following value via reflection
     396		 */
     397		public static void applyFormatSettings(Object formatter, String[] propertiesAndValues) {
     398			if (propertiesAndValues.length == 0) {
     399				return;
     400			}
     401	
     402			Map<String, String> values = new HashMap<String, String>();
     403			for (String setting : propertiesAndValues) {
     404				if (setting == null) {
     405					continue;
     406				}
     407				String[] pair = setting.split("=");
     408				if (pair.length != 2) {
     409					throw new DataProcessingException("Illegal format setting '" + setting + "' among: " + Arrays.toString(propertiesAndValues));
     410				}
     411	
     412				values.put(pair[0], pair[1]);
     413			}
     414	
     415			try {
     416				for (PropertyWrapper property : BeanHelper.getPropertyDescriptors(formatter.getClass())) {
     417					String name = property.getName();
     418					String value = values.remove(name);
     419					if (value != null) {
     420						invokeSetter(formatter, property, value);
     421					}
     422	
     423					if ("decimalFormatSymbols".equals(property.getName())) {
     424						DecimalFormatSymbols modifiedDecimalSymbols = new DecimalFormatSymbols();
     425						boolean modified = false;
     426						try {
     427							for (PropertyWrapper prop : BeanHelper.getPropertyDescriptors(modifiedDecimalSymbols.getClass())) {
     428								value = values.remove(prop.getName());
     429								if (value != null) {
     430									invokeSetter(modifiedDecimalSymbols, prop, value);
     431									modified = true;
     432								}
     433							}
     434	
     435							if (modified) {
     436								Method writeMethod = property.getWriteMethod();
     437								if (writeMethod != null) {
     438									writeMethod.invoke(formatter, modifiedDecimalSymbols);
     439								} else {
     440									throw new IllegalStateException("No write method defined for property " + property.getName());
     441								}
     442							}
     443						} catch (Throwable ex) {
     444							throw new DataProcessingException("Error trying to configure decimal symbols of formatter '" + formatter.getClass() + '.', ex);
     445						}
     446					}
     447				}
     448			} catch (Exception e) {
     449				//ignore and proceed
     450			}
     451	
     452			if (!values.isEmpty()) {
     453				throw new DataProcessingException("Cannot find properties in formatter of type '" + formatter.getClass() + "': " + values);
     454			}
     455		}
