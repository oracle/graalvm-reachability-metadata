     664		public static Class<?> getType(AnnotatedElement element) {
     665			if (element instanceof Field) {
     666				return ((Field) element).getType();
     667			}
     668			Method method = (Method) element;
     669			Class<?>[] params = method.getParameterTypes();
     670			if (params.length == 1) {
     671				return params[0];
     672			} else if (params.length > 1) {
     673				throw new IllegalArgumentException("Method " + describeElement(element) + " cannot have multiple parameters");
     674			}
     675	
     676			Class<?> returnType = method.getReturnType();
     677			if (returnType != void.class) {
     678				return returnType;
     679			}
     680			throw new IllegalArgumentException("Method " + describeElement(element) + " must return a value if it has no input parameter");
     681		}
     682	
     683		public static Class<?> getDeclaringClass(AnnotatedElement element) {
     684			if (element instanceof Field) {
     685				return ((Field) element).getDeclaringClass();
     686			} else {
     687				return ((Method) element).getDeclaringClass();
     688			}
     689		}
     690	
     691		public static String getName(AnnotatedElement element) {
     692			if (element instanceof Field) {
     693				return ((Field) element).getName();
     694			} else {
     695				return ((Method) element).getName();
     696			}
     697		}
     698	
     699		static String describeElement(AnnotatedElement element) {
     700			String description;
     701			if (element instanceof Field) {
     702				description = "attribute '" + ((Field) element).getName() + "'";
     703			} else {
     704				description = "method '" + ((Method) element).getName() + "'";
     705			}
     706			return description + " of class " + getDeclaringClass(element).getName();
     707		}
