     572		/**
     573		 * Runs through all {@link Parsed} annotations of a given class to identify all indexes associated with its fields
     574		 *
     575		 * @param beanClass a class whose {@link Parsed} annotations will be processed.
     576		 * @param filter    filter to apply over annotated methods when the class is being used for reading data from beans (to write values to an output)
     577		 *                  or when writing values into beans (while parsing). It is used to choose either a "get" or a "set"
     578		 *                  method annotated with {@link Parsed}, when both methods target the same field.
     579		 *
     580		 * @return an array of column indexes used by the given class
     581		 */
     582		public static Integer[] getSelectedIndexes(Class<?> beanClass, MethodFilter filter) {
     583			List<Integer> indexes = new ArrayList<Integer>();
     584			for (TransformedHeader header : getFieldSequence(beanClass, true, null, filter)) {
     585				if (header == null) {
     586					continue;
     587				}
     588				int index = header.getHeaderIndex();
     589	
     590				if (index != -1) {
     591					if (filter == MethodFilter.ONLY_GETTERS && indexes.contains(index)) { //allows the same column to be mapped to multiple fields when parsing, but not when writing.
     592						throw new IllegalArgumentException("Duplicate field index '" + index + "' found in attribute '" + header.getTargetName() + "' of class " + beanClass.getName());
     593					}
     594					indexes.add(index);
     595				}
     596			}
     597			return indexes.toArray(new Integer[indexes.size()]);
     598		}
