press or implied.\n    13\t * See the License for the specific language governing permissions and\n    14\t * limitations under the License.\n    15\t ******************************************************************************/\n    16\tpackage com.univocity.parsers.annotations.helpers;\n    17\t\n    18\timport com.univocity.parsers.annotations.*;\n    19\timport com.univocity.parsers.annotations.Format;\n    20\timport com.univocity.parsers.common.*;\n    21\timport com.univocity.parsers.common.beans.*;\n    22\timport com.univocity.parsers.common.input.*;\n    23\timport com.univocity.parsers.conversions.*;\n    24\t\n    25\timport java.lang.annotation.Annotation;\n    26\timport java.lang.reflect.*;\n    27\timport java.math.*;\n    28\timport java.text.*;\n    29\timport java.util.*;\n    30\t\n    31\t/**\n    32\t * Helper class to process fields annotated with {@link Parsed}\n    33\t *\n    34\t * @author Univocity Software Pty Ltd - <a href=\"mailto:parsers@univocity.com\">parsers@univocity.com</a>\n    35\t */\n    36\tpublic class AnnotationHelper {\n    37\t\n    38\t\tprivate static AnnotatedElement lastProcessedElement;\n    39\t\tprivate static Class<? extends Annotation> lastProcessedAnnotationType;\n    40\t\tprivate static Annotation lastAnnotationFound;\n    41\t\n    42\t\tprivate AnnotationHelper() {\n    43\t\n    44\t\t}\n    45\t\n    46\t\t/**\n    47\t\t * Converts the special \"null\" strings that might be provided by {@link Parsed#defaultNullRead() and  Parsed#defaultNullWrite()}\n    48\t\t *\n    49\t\t * @param defaultValue The string returned by {@link Parsed#defaultNullRead() and  Parsed#defaultNullWrite()}\n    50\t\t *\n    51\t\t * @return the default value if it is not the String literal \"null\" or \"'null'\".\n    52\t\t * <p> If \"null\" was provided, then null will be returned.\n    53\t\t * <p> If \"'null'\" was provided, then \"null\" will be returned.\n    54\t\t */\n    55\t\tprivate static String getNullValue(String defaultValue) {\n    56\t\t\tif (\"null\".equals(defaultValue)) {\n    57\t\t\t\treturn null;\n    58\t\t\t}\n    59\t\t\tif (\"'null'\".equals(defaultValue)) {\n    60\t\t\t\treturn \"null\";\n    61\t\t\t}\n    62\t\n    63\t\t\treturn defaultValue;\n    64\t\t}\n    65\t\n    66\t\tpublic static String getNullWriteValue(AnnotatedElement target, Parsed parsed) {\n    67\t\t\tif (parsed == null) {\n    68\t\t\t\treturn null;\n    69\t\t\t}\n    70\t\t\treturn getNullValue(AnnotationRegistry.getValue(target, parsed, \"defaultNullWrite\", parsed.defaultNullWrite()));\n    71\t\t}\n    72\t\n    73\t\tpublic static String getNullReadValue(AnnotatedElement target, Parsed parsed) {\n    74\t\t\tif (parsed == null) {\n    75\t\t\t\treturn null;\n    76\t\t\t}\n    77\t\t\treturn getNullValue(AnnotationRegistry.getValue(target, parsed, \"defaultNullRead\", parsed.defaultNullRead()));\n    78\t\t}\n    79\t\n    80\t\t/**\n    81\t\t * Identifies the proper conversion for a given type and an annotation from the package {@link com.univocity.parsers.annotations}\n    82\t\t *\n    83\t\t * @param classType  the type to have conversions applied to\n    84\t\t * @param annotation the annotation from {@link com.univocity.parsers.annotations} that identifies a {@link Conversion} instance.\n    85\t\t *\n    86\t\t * @return The {@link Conversion} that should be applied to the type\n    87\t\t */\n    88\t\t@SuppressWarnings(\"rawtypes\")\n    89\t\tpublic static Conversion getConversion(Class classType, Annotation annotation) {\n    90\t\t\treturn getConversion(classType, null, annotation, null, null);\n    91\t\t}\n    92\t\n    93\t\tpublic static EnumConversion createDefaultEnumConversion(Class fieldType, String nullRead, String nullWrite){\n    94\t\t\tEnum nullReadValue = nullRead == null ? null : Enum.valueOf(fieldType, nullRead);\n    95\t\t\treturn new EnumConversion(fieldType, nullReadValue, nullWrite, null, EnumSelector.NAME, EnumSelector.ORDINAL, EnumSelector.STRING);\n    96\t\t}\n    97\t\n    98\t\t@SuppressWarnings({\"rawtypes\", \"unchecked\"})\n    99\t\tpublic static Conversion getConversion(Class fieldType, AnnotatedElement target, Annotation annotation, String nullRead, String nullWrite) {\n   100\t\t\ttry {\n   101\t\t\t\tClass annType = annotation.annotationType();\n   102\t\n   103\t\t\t\tif (annType == NullString.class) {\n   104\t\t\t\t\tNullString nullString = (NullString) annotation;\n   105\t\t\t\t\tString[] nulls = AnnotationRegistry.getValue(target, nullString, \"nulls\", nullString.nulls());\n   106\t\t\t\t\treturn Conversions.toNull(nulls);\n   107\t\t\t\t} else if (annType == Validate.class) {\n   108\t\t\t\t\tValidate validate = (Validate) annotation;\n   109\t\n   110\t\t\t\t\tboolean nullable = AnnotationRegistry.getValue(target, validate, \"nullable\", validate.nullable());\n   111\t\t\t\t\tboolean allowBlanks = AnnotationRegistry.getValue(target, validate, \"allowBlanks\", validate.allowBlanks());\n   112\t\t\t\t\tString[] oneOf = AnnotationRegistry.getValue(target, validate, \"oneOf\", validate.oneOf());\n   113\t\t\t\t\tString[] noneOf = AnnotationRegistry.getValue(target, validate, \"noneOf\", validate.noneOf());\n   114\t\t\t\t\tString matches = AnnotationRegistry.getValue(target, validate, \"matches\", validate.matches());\n   115\t\n   116\t\t\t\t\tClass[] validators = AnnotationRegistry.getValue(target, validate, \"validators\", validate.validators());\n   117\t\t\t\t\treturn new ValidatedConversion(nullable, allowBlanks, oneOf, noneOf, matches, validators);\n   118\t\t\t\t} else if (annType == EnumOptions.class) {\n   119\t\t\t\t\tif (!fieldType.isEnum()) {\n   120\t\t\t\t\t\tif (target == null) {\n   121\t\t\t\t\t\t\tthrow new IllegalStateException(\"Invalid \" + EnumOptions.class.getName() + \" instance for converting class \" + fieldType.getName() + \". Not an enum type.\");\n   122\t\t\t\t\t\t} else {\n   123\t\t\t\t\t\t\tthrow new IllegalStateException(\"Invalid \" + EnumOptions.class.getName() + \" annotation on \" + describeElement(target) + \". Attribute must be an enum type.\");\n   124\t\t\t\t\t\t}\n   125\t\t\t\t\t}\n   126\t\t\t\t\tEnumOptions enumOptions = ((EnumOptions) annotation);\n   127\t\t\t\t\tString customElement = AnnotationRegistry.getValue(target, enumOptions, \"customElement\", enumOptions.customElement());\n   128\t\t\t\t\tString element = customElement.trim();\n   129\t\t\t\t\tif (element.isEmpty()) {\n   130\t\t\t\t\t\telement = null;\n   131\t\t\t\t\t}\n   132\t\n   133\t\t\t\t\tEnum nullReadValue = nullRead == null ? null : Enum.valueOf(fieldType, nullRead);\n   134\t\t\t\t\tEnumSelector[] selectors = AnnotationRegistry.getValue(target, enumOptions, \"selectors\", enumOptions.selectors());\n   135\t\t\t\t\treturn new EnumConversion(fieldType, nullReadValue, nullWrite, element, selectors);\n   136\t\t\t\t} else if (annType == Trim.class) {\n   137\t\t\t\t\tTrim trim = ((Trim) annotation);\n   138\t\t\t\t\tint length = AnnotationRegistry.getValue(target, trim, \"length\", trim.length());\n   139\t\t\t\t\tif (length == -1) {\n   140\t\t\t\t\t\treturn Conversions.trim();\n   141\t\t\t\t\t} else {\n   142\t\t\t\t\t\treturn Conversions.trim(length);\n   143\t\t\t\t\t}\n   144\t\t\t\t} else if (annType == LowerCase.class) {\n   145\t\t\t\t\treturn Conversions.toLowerCase();\n   146\t\t\t\t} else if (annType == UpperCase.class) {\n   147\t\t\t\t\treturn Conversions.toUpperCase();\n   148\t\t\t\t} else if (annType == Replace.class) {\n   149\t\t\t\t\tReplace replace = ((Replace) annotation);\n   150\t\t\t\t\tString expression = AnnotationRegistry.getValue(target, replace, \"expression\", replace.expression());\n   151\t\t\t\t\tString replacement = AnnotationRegistry.getValue(target, replace, \"replacement\", replace.replacement());\n   152\t\t\t\t\treturn Conversions.replace(expression, replacement);\n   153\t\t\t\t} else if (annType == BooleanString.class) {\n   154\t\t\t\t\tif (fieldType != boolean.class && fieldType != Boolean.class) {\n   155\t\t\t\t\t\tif (target == null) {\n   156\t\t\t\t\t\t\tthrow new DataProcessingException(\"Invalid  usage of \" + BooleanString.class.getName() + \". Got type \" + fieldType.getName() + \" instead of boolean.\");\n   157\t\t\t\t\t\t} else {\n   158\t\t\t\t\t\t\tthrow new DataProcessingException(\"Invalid annotation: \" + describeElement(target) + \" has type \" + fieldType.getName() + \" instead of boolean.\");\n   159\t\t\t\t\t\t}\n   160\t\t\t\t\t}\n   161\t\t\t\t\tBooleanString boolString = ((BooleanString) annotation);\n   162\t\t\t\t\tString[] falseStrings = AnnotationRegistry.getValue(target, boolString, \"falseStrings\", boolString.falseStrings());\n   163\t\t\t\t\tString[] trueStrings = AnnotationRegistry.getValue(target, boolString, \"trueStrings\", boolString.trueStrings());\n   164\t\t\t\t\tBoolean valueForNull = nullRead == null ? null : BooleanConversion.getBoolean(nullRead, trueStrings, falseStrings);\n   165\t\n   166\t\t\t\t\tif (valueForNull == null && fieldType == boolean.class) {\n   167\t\t\t\t\t\tvalueForNull = Boolean.FALSE;\n   168\t\t\t\t\t}\n   169\t\n   170\t\t\t\t\treturn Conversions.toBoolean(valueForNull, nullWrite, trueStrings, falseStrings);\n   171\t\t\t\t} else if (annType == Format.class) {\n   172\t\t\t\t\tFormat format = ((Format) annotation);\n   173\t\t\t\t\tString[] formats = AnnotationRegistry.getValue(target, format, \"formats\", format.formats());\n   174\t\t\t\t\tString[] options = AnnotationRegistry.getValue(target, format, \"options\", format.options());\n   175\t\n   176\t\t\t\t\tLocale locale = extractLocale(options);\n   177\t\t\t\t\tTimeZone timezone = extractTimeZone(options);\n   178\t\n   179\t\t\t\t\tConversion conversion = null;\n   180\t\n   181\t\t\t\t\tif (fieldType == BigDecimal.class) {\n   182\t\t\t\t\t\tBigDecimal defaultForNull = nullRead == null ? null : new BigDecimal(nullRead);\n   183\t\t\t\t\t\tconversion = Conversions.formatToBigDecimal(defaultForNull, nullWrite, formats);\n   184\t\t\t\t\t} else if (Number.class.isAssignableFrom(fieldType) || (fieldType.isPrimitive()) && fieldType != boolean.class && fieldType != char.class) {\n   185\t\t\t\t\t\tconversion = Conversions.formatToNumber(formats);\n   186\t\t\t\t\t\t((NumericConversion) conversion).setNumberType(fieldType);\n   187\t\t\t\t\t} else {\n   188\t\t\t\t\t\tDate dateIfNull = null;\n   189\t\t\t\t\t\tif (nullRead != null) {\n   190\t\t\t\t\t\t\tif (\"now\".equalsIgnoreCase(nullRead)) {\n   191\t\t\t\t\t\t\t\tdateIfNull = new Date();\n   192\t\t\t\t\t\t\t} else {\n   193\t\t\t\t\t\t\t\tif (formats.length == 0) {\n   194\t\t\t\t\t\t\t\t\tthrow new DataProcessingException(\"No format defined\");\n   195\t\t\t\t\t\t\t\t}\n   196\t\t\t\t\t\t\t\tSimpleDateFormat sdf = new SimpleDateFormat(formats[0], locale);\n   197\t\t\t\t\t\t\t\tsdf.setTimeZone(timezone);\n   198\t\t\t\t\t\t\t\tdateIfNull = sdf.parse(nullRead);\n   199\t\t\t\t\t\t\t}\n   200\t\t\t\t\t\t}\n   201\t\n   202\t\t\t\t\t\tif (Date.class == fieldType) {\n   203\t\t\t\t\t\t\tconversion = Conversions.toDate(timezone, locale, dateIfNull, nullWrite, formats);\n   204\t\t\t\t\t\t} else if (Calendar.class == fieldType) {\n   205\t\t\t\t\t\t\tCalendar calendarIfNull = null;\n   206\t\t\t\t\t\t\tif (dateIfNull != null) {\n   207\t\t\t\t\t\t\t\tcalendarIfNull = Calendar.getInstance();\n   208\t\t\t\t\t\t\t\tcalendarIfNull.setTime(dateIfNull);\n   209\t\t\t\t\t\t\t\tcalendarIfNull.setTimeZone(timezone);\n   210\t\t\t\t\t\t\t}\n   211\t\t\t\t\t\t\tconversion = Conversions.toCalendar(timezone, locale, calendarIfNull, nullWrite, formats);\n   212\t\t\t\t\t\t}\n   213\t\t\t\t\t}\n   214\t\n   215\t\t\t\t\tif (conversion != null) {\n   216\t\t\t\t\t\tif (options.length > 0) {\n   217\t\t\t\t\t\t\tif (conversion instanceof FormattedConversion) {\n   218\t\t\t\t\t\t\t\tObject[] formatters = ((FormattedConversion) conversion).getFormatterObjects();\n   219\t\t\t\t\t\t\t\tfor (Object formatter : formatters) {\n   220\t\t\t\t\t\t\t\t\tapplyFormatSettings(formatter, options);\n   221\t\t\t\t\t\t\t\t}\n   222\t\t\t\t\t\t\t} else {\n   223\t\t\t\t\t\t\t\tthrow new DataProcessingException(\"Options '\" + Arrays.toString(options) + \"' not supported by conversion of type '\" + conversion.getClass() + \"'. It must implement \" + FormattedConversion.class);\n   224\t\t\t\t\t\t\t}\n   225\t\t\t\t\t\t}\n   226\t\t\t\t\t\treturn conversion;\n   227\t\t\t\t\t}\n   228\t\n   229\t\t\t\t} else if (annType == Convert.class) {\n   230\t\t\t\t\tConvert convert = ((Convert) annotation);\n   231\t\t\t\t\tString[] args = AnnotationRegistry.getValue(target, convert, \"args\", convert.args());\n   232\t\t\t\t\tClass conversionClass = AnnotationRegistry.getValue(target, convert, \"conversionClass\", convert.conversionClass());\n   233\t\t\t\t\treturn (Conversion) newInstance(Conversion.class, conversionClass, args);\n   234\t\t\t\t}\n   235\t\n   236\t\t\t\tif (fieldType == String.class && (nullRead != null || nullWrite != null)) {\n   237\t\t\t\t\treturn new ToStringConversion(nullRead, nullWrite);\n   238\t\t\t\t}\n   239\t\n   240\t\t\t\treturn null;\n   241\t\t\t} catch (DataProcessingException ex) {\n   242\t\t\t\tthrow ex;\n   243\t\t\t} catch (Throwable ex) {\n   244\t\t\t\tif (target == null) {\n   245\t\t\t\t\tthrow new DataProcessingException(\"Unexpected error identifying conversions to apply over type \" + fieldType, ex);\n   246\t\t\t\t} else {\n   247\t\t\t\t\tthrow new DataProcessingException(\"Unexpected error identifying conversions to apply over \" + describeElement(target), ex);\n   248\t\t\t\t}\n   249\t\t\t}\n   250\t\t}\n   251\t\n   252\t\tprivate static String extractOption(String[] options, String key) {\n   253\t\t\tfor (int i = 0; i < options.length; i++) {\n   254\t\t\t\tif (options[i] != null && options[i].trim().toLowerCase().startsWith(key)) {\n   255\t\t\t\t\tString out = options[i].split(\"=\")[1].trim();\n   256\t\t\t\t\toptions[i] = null;\n   257\t\t\t\t\treturn out;\n   258\t\t\t\t}\n   259\t\t\t}\n   260\t\t\treturn null;\n   261\t\t}\n   262\t\n   263\t\tprivate static TimeZone extractTimeZone(String[] options) {\n   264\t\t\tString code = extractOption(options, \"timezone=\");\n   265\t\t\tif (code != null) {\n   266\t\t\t\treturn TimeZone.getTimeZone(code);\n   267\t\t\t}\n   268\t\t\treturn TimeZone.getDefault();\n   269\t\t}\n   270\t\n   271\t\tprivate static Locale extractLocale(String[] options) {\n   272\t\t\tString locale = extractOption(options, \"locale=\");\n   273\t\t\tif (locale != null) {\n   274\t\t\t\tString languageCode;\n   275\t\t\t\tString countryCode;\n   276\t\t\t\tString variant;\n   277\t\n   278\t\t\t\tCharAppender appender = new DefaultCharAppender(100, \"\", 0);\n   279\t\t\t\tint j = 0;\n   280\t\t\t\tchar ch;\n  1098\t\n  1099\t\tprivate static final Set<Class> javaLangAnnotationTypes = new HashSet<Class>();\n  1100\t\tprivate static final Set<Class> customAnnotationTypes = new HashSet<Class>();\n  1101\t\n  1102\t\tprivate static boolean isCustomAnnotation(Annotation annotation) {\n  1103\t\t\tClass annotationType = annotation.annotationType();\n  1104\t\t\tif (customAnnotationTypes.contains(annotationType)) {\n  1105\t\t\t\treturn true;\n  1106\t\t\t}\n  1107\t\t\tif (javaLangAnnotationTypes.contains(annotationType)) {\n  1108\t\t\t\treturn false;\n  1109\t\t\t}\n  1110\t\t\tif (annotationType.getName().startsWith(\"java.lang.annotation\")) {\n  1111\t\t\t\tjavaLangAnnotationTypes.add(annotationType);\n  1112\t\t\t\treturn false;\n  1113\t\t\t} else {\n  1114\t\t\t\tcustomAnnotationTypes.add(annotationType);\n  1115\t\t\t\treturn true;\n  1116\t\t\t}\n  1117\t\t}\n  1118\t\n  1119\t\t/**\n  1120\t\t * Returns all annotations applied to an element, excluding the ones not in a given package.\n  1121\t\t *\n  1122\t\t * @param annotatedElement the element (method, field, etc) whose annotations will be extracted\n  1123\t\t * @param aPackage         the package of the annotations that should be returned\n  1124\t\t *\n  1125\t\t *