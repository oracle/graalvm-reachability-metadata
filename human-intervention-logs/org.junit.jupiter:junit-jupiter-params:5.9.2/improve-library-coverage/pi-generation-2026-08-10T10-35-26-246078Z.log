     743		/**
     744		 * Returns a list of fields with {@link Parsed} annotations in the sequence they should be processed for parsing
     745		 * or writing. The sequence is ordered taking into account their original order in the annotated class, unless
     746		 * {@link Parsed#index()} is set to a non-negative number.
     747		 *
     748		 * @param beanClass     the class whose field sequence will be returned.
     749		 * @param processNested flag indicating whether {@link Nested} annotations should be processed
     750		 * @param transformer   a {@link HeaderTransformer} instance to be used for transforming headers of a given {@link Nested} attribute.
     751		 * @param filter        filter to apply over annotated methods when the class is being used for reading data from beans (to write values to an output)
     752		 *                      or when writing values into beans (while parsing). It is used to choose either a "get" or a "set"
     753		 *                      method annotated with {@link Parsed}, when both methods target the same field.
     754		 *
     755		 * @return a list of fields ordered by their processing sequence
     756		 */
     757		public static List<TransformedHeader> getFieldSequence(Class beanClass, boolean processNested, HeaderTransformer transformer, MethodFilter filter) {
     758			List<Integer> indexes = new ArrayList<Integer>();
     759			List<TransformedHeader> tmp = getFieldSequence(beanClass, processNested, indexes, transformer, filter);
     760	
     761			Collections.sort(tmp, new Comparator<TransformedHeader>() {
     762				@Override
     763				public int compare(TransformedHeader t1, TransformedHeader t2) {
     764					int i1 = t1.getHeaderIndex();
     765					int i2 = t2.getHeaderIndex();
     766					return i1 < i2 ? -1 : (i1 == i2 ? 0 : 1);
     767				}
     768			});
     769			Collections.sort(indexes);
     770	
     771			int col = -1;
     772			for (int i : indexes) {
     773				col++;
     774				if (i < 0) {
     775					continue;
     776				}
     777				if (i != col) {
     778					while (i >= tmp.size()) {
     779						tmp.add(null);
     780					}
     781					Collections.swap(tmp, i, col);
     782				}
     783			}
     784	
     785			return tmp;
     786		}
