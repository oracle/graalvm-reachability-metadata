     497		private static boolean allFieldsIndexOrNameBased(boolean searchName, Class<?> beanClass, MethodFilter filter) {
     498			boolean hasAnnotation = false;
     499	
     500			for (TransformedHeader header : getFieldSequence(beanClass, true, null, filter)) {
     501				if (header == null || header.getTarget() == null) {
     502					continue;
     503				}
     504				AnnotatedElement element = header.getTarget();
     505				if (element instanceof Method && filter.reject((Method) element)) {
     506					continue;
     507				}
     508	
     509				Parsed annotation = findAnnotation(element, Parsed.class);
     510				if (annotation != null) {
     511					hasAnnotation = true;
     512	
     513					int index = AnnotationRegistry.getValue(element, annotation, "index", annotation.index());
     514	
     515					if ((index != -1 && searchName) || (index == -1 && !searchName)) {
     516						return false;
     517					}
     518				}
     519			}
     520			return hasAnnotation;
     521		}
