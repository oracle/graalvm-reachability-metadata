th a String[] parameter in custom \" + parent.getSimpleName() + \" class '\" + type.getSimpleName() + \"' (\" + type.getName() + ')', e);\n   312\t\t\t} catch (Exception e) {\n   313\t\t\t\tthrow new DataProcessingException(\"Unexpected error instantiating custom \" + parent.getSimpleName() + \" class '\" + type.getSimpleName() + \"' (\" + type.getName() + ')', e);\n   314\t\t\t}\n   315\t\t}\n   316\t\n   317\t\t/**\n   318\t\t * Identifies the proper conversion for a given type\n   319\t\t *\n   320\t\t * @param fieldType The type of field to have conversions applied to.\n   321\t\t * @param target    the annotated attribute of method that has the annotation\n   322\t\t * @param parsed    the {@link Parsed} annotation from {@link com.univocity.parsers.annotations}.\n   323\t\t *\n   324\t\t * @return The {@link Conversion} that should be applied to the field type\n   325\t\t */\n   326\t\t@SuppressWarnings({\"rawtypes\", \"unchecked\"})\n   327\t\tpublic static Conversion getDefaultConversion(Class fieldType, AnnotatedElement target, Parsed parsed) {\n   328\t\t\tString nullRead = getNullReadValue(target, parsed);\n   329\t\t\tObject valueIfStringIsNull = null;\n   330\t\n   331\t\t\tObjectConversion conversion = null;\n   332\t\t\tif (fieldType == Boolean.class || fieldType == boolean.class) {\n   333\t\t\t\tconversion = Conversions.toBoolean();\n   334\t\t\t\tvalueIfStringIsNull = nullRead == null ? null : Boolean.valueOf(nullRead);\n   335\t\t\t} else if (fieldType == Character.class || fieldType == char.class) {\n   336\t\t\t\tconversion = Conversions.toChar();\n   337\t\t\t\tif (nullRead != null && nullRead.length() > 1) {\n   338\t\t\t\t\tthrow new DataProcessingException(\"Invalid default value for character '\" + nullRead + \"'. It should contain one character only.\");\n   339\t\t\t\t}\n   340\t\t\t\tvalueIfStringIsNull = nullRead == null ? null : nullRead.charAt(0);\n   341\t\t\t} else if (fieldType == Byte.class || fieldType == byte.class) {\n   342\t\t\t\tconversion = Conversions.toByte();\n   343\t\t\t\tvalueIfStringIsNull = nullRead == null ? null : Byte.valueOf(nullRead);\n   344\t\t\t} else if (fieldType == Short.class || fieldType == short.class) {\n   345\t\t\t\tconversion = Conversions.toShort();\n   346\t\t\t\tvalueIfStringIsNull = nullRead == null ? null : Short.valueOf(nullRead);\n   347\t\t\t} else if (fieldType == Integer.class || fieldType == int.class) {\n   348\t\t\t\tconversion = Conversions.toInteger();\n   349\t\t\t\tvalueIfStringIsNull = nullRead == null ? null : Integer.valueOf(nullRead);\n   350\t\t\t} else if (fieldType == Long.class || fieldType == long.class) {\n   351\t\t\t\tconversion = Conversions.toLong();\n   352\t\t\t\tvalueIfStringIsNull = nullRead == null ? null : Long.valueOf(nullRead);\n   353\t\t\t} else if (fieldType == Float.class || fieldType == float.class) {\n   354\t\t\t\tconversion = Conversions.toFloat();\n   355\t\t\t\tvalueIfStringIsNull = nullRead == null ? null : Float.valueOf(nullRead);\n   356\t\t\t} else if (fieldType == Double.class || fieldType == double.class) {\n   357\t\t\t\tconversion = Conversions.toDouble();\n   358\t\t\t\tvalueIfStringIsNull = nullRead == null ? null : Double.valueOf(nullRead);\n   359\t\t\t} else if (fieldType == BigInteger.class) {\n   360\t\t\t\tconversion = Conversions.toBigInteger();\n   361\t\t\t\tvalueIfStringIsNull = nullRead == null ? null : new BigInteger(nullRead);\n   362\t\t\t} else if (fieldType == BigDecimal.class) {\n   363\t\t\t\tconversion = Conversions.toBigDecimal();\n   364\t\t\t\tvalueIfStringIsNull = nullRead == null ? null : new BigDecimal(nullRead);\n   365\t\t\t} else if (Enum.class.isAssignableFrom(fieldType)) {\n   366\t\t\t\tconversion = Conversions.toEnum(fieldType);\n   367\t\t\t}\n   368\t\n   369\t\t\tif (conversion != null) {\n   370\t\t\t\tconversion.setValueIfStringIsNull(valueIfStringIsNull);\n   371\t\t\t\tconversion.setValueIfObjectIsNull(getNullWriteValue(target, parsed));\n   372\t\t\t}\n   373\t\n   374\t\t\treturn conversion;\n   375\t\t}\n   376\t\n   377\t\t/**\n   378\t\t * Returns the default {@link Conversion} that should be applied to the field based on its type.\n   379\t\t *\n   380\t\t * @param target The field or method whose values must be converted from a given parsed String.\n   381\t\t *\n   382\t\t * @return The default {@link Conversion} applied to the given field.\n   383\t\t */\n   384\t\t@SuppressWarnings(\"rawtypes\")\n   385\t\tpublic static Conversion getDefaultConversion(AnnotatedElement target) {\n   386\t\t\tParsed parsed = findAnnotation(target, Parsed.class);\n   387\t\t\treturn getDefaultConversion(getType(target), target, parsed);\n   388\t\t}\n   389\t\n   390\t\t/**\n   391\t\t * Applied the configuration of a formatter object ({@link SimpleDateFormat}, {@link NumberFormat} and others).\n   392\t\t *\n   393\t\t * @param formatter           the formatter instance\n   394\t\t * @param propertiesAndValues a sequence of key-value pairs, where the key is a property of the formatter\n   395\t\t *                            object to be set to the following value via reflection\n   396\t\t */\n   397\t\tpublic static void applyFormatSettings(Object formatter, String[] propertiesAndValues) {\n   398\t\t\tif (propertiesAndValues.length == 0) {\n   399\t\t\t\treturn;\n   400\t\t\t}\n   401\t\n   402\t\t\tMap<String, String> values = new HashMap<String, String>();\n   403\t\t\tfor (String setting : propertiesAndValues) {\n   404\t\t\t\tif (setting == null) {\n   405\t\t\t\t\tcontinue;\n   406\t\t\t\t}\n   407\t\t\t\tString[] pair = setting.split(\"=\");\n   408\t\t\t\tif (pair.length != 2) {\n   409\t\t\t\t\tthrow new DataProcessingException(\"Illegal format setting '\" + setting + \"' among: \" + Arrays.toString(propertiesAndValues));\n   410\t\t\t\t}\n   411\t\n   412\t\t\t\tvalues.put(pair[0], pair[1]);\n   413\t\t\t}\n   414\t\n   415\t\t\ttry {\n   416\t\t\t\tfor (PropertyWrapper property : BeanHelper.getPropertyDescriptors(formatter.getClass())) {\n   417\t\t\t\t\tString name = property.getName();\n   418\t\t\t\t\tString value = values.remove(name);\n   419\t\t\t\t\tif (value != null) {\n   420\t\t\t\t\t\tinvokeSetter(formatter, property, value);\n   421\t\t\t\t\t}\n   422\t\n   423\t\t\t\t\tif (\"decimalFormatSymbols\".equals(property.getName())) {\n   424\t\t\t\t\t\tDecimalFormatSymbols modifiedDecimalSymbols = new DecimalFormatSymbols();\n   425\t\t\t\t\t\tboolean modified = false;\n   426\t\t\t\t\t\ttry {\n   427\t\t\t\t\t\t\tfor (PropertyWrapper prop : BeanHelper.getPropertyDescriptors(modifiedDecimalSymbols.getClass())) {\n   428\t\t\t\t\t\t\t\tvalue = values.remove(prop.getName());\n   429\t\t\t\t\t\t\t\tif (value != null) {\n   430\t\t\t\t\t\t\t\t\tinvokeSetter(modifiedDecimalSymbols, prop, value);\n   431\t\t\t\t\t\t\t\t\tmodified = true;\n   432\t\t\t\t\t\t\t\t}\n   433\t\t\t\t\t\t\t}\n   434\t\n   435\t\t\t\t\t\t\tif (modified) {\n   436\t\t\t\t\t\t\t\tMethod writeMethod = property.getWriteMethod();\n   437\t\t\t\t\t\t\t\tif (writeMethod != null) {\n   438\t\t\t\t\t\t\t\t\twriteMethod.invoke(formatter, modifiedDecimalSymbols);\n   439\t\t\t\t\t\t\t\t} else {\n   440\t\t\t\t\t\t\t\t\tthrow new IllegalStateException(\"No write method defined for property \" + property.getName());\n   441\t\t\t\t\t\t\t\t}\n   442\t\t\t\t\t\t\t}\n   443\t\t\t\t\t\t} catch (Throwable ex) {\n   444\t\t\t\t\t\t\tthrow new DataProcessingException(\"Error trying to configure decimal symbols of formatter '\" + formatter.getClass() + '.', ex);\n   445\t\t\t\t\t\t}\n   446\t\t\t\t\t}\n   447\t\t\t\t}\n   448\t\t\t} catch (Exception e) {\n   449\t\t\t\t//ignore and proceed\n   450\t\t\t}\n   451\t\n   452\t\t\tif (!values.isEmpty()) {\n   453\t\t\t\tthrow new DataProcessingException(\"Cannot find properties in formatter of type '\" + formatter.getClass() + \"': \" + values);\n   454\t\t\t}\n   455\t\t}\n   456\t\n   457\t\tprivate static void invokeSetter(Object formatter, PropertyWrapper property, final String value) {\n   458\t\t\tMethod writeMethod = property.getWriteMethod();\n   459\t\t\tif (writeMethod == null) {\n   460\t\t\t\tDataProcessingException exception = new DataProcessingException(\"Cannot set property '\" + property.getName() + \"' of formatter '\" + formatter.getClass() + \"' to '{value}'. No setter defined\");\n   461\t\t\t\texception.setValue(value);\n   462\t\t\t\tthrow exception;\n   463\t\t\t}\n   464\t\t\tClass<?> parameterType = writeMethod.getParameterTypes()[0];\n   465\t\t\tObject parameterValue = null;\n   466\t\t\tif (parameterType == String.class) {\n   467\t\t\t\tparameterValue = value;\n   468\t\t\t} else if (parameterType == Integer.class || parameterType == int.class) {\n   469\t\t\t\tparameterValue = Integer.parseInt(value);\n   470\t\t\t} else if (parameterType == Character.class || parameterType == char.class) {\n   471\t\t\t\tparameterValue = value.charAt(0);\n   472\t\t\t} else if (parameterType == Currency.class) {\n   473\t\t\t\tparameterValue = Currency.getInstance(value);\n   474\t\t\t} else if (parameterType == Boolean.class || parameterType == boolean.class) {\n   475\t\t\t\tparameterValue = Boolean.valueOf(value);\n   476\t\t\t} else if (parameterType == TimeZone.class) {\n   477\t\t\t\tparameterValue = TimeZone.getTimeZone(value);\n   478\t\t\t} else if (parameterType == DateFormatSymbols.class) {\n   479\t\t\t\tparameterValue = DateFormatSymbols.getInstance(new Locale(value));\n   480\t\t\t}\n   481\t\t\tif (parameterValue == null) {\n   482\t\t\t\tDataProcessingException exception = new DataProcessingException(\"Cannot set property '\" + property.getName() + \"' of formatter '\" + formatter.getClass() + \". Cannot convert '{value}' to instance of \" + parameterType);\n   483\t\t\t\texception.setValue(value);\n   484\t\t\t\tthrow exception;\n   485\t\t\t}\n   486\t\n   487\t\t\ttry {\n   488\t\t\t\twriteMethod.invoke(formatter, parameterValue);\n   489\t\t\t} catch (Throwable e) {\n   490\t\t\t\tDataProcessingException exception = new DataProcessingException(\"Error setting property '\" + property.getName() + \"' of formatter '\" + formatter.getClass() + \", with '{parameterValue}' (converted from '{value}')\", e);\n   491\t\t\t\texception.setValue(\"parameterValue\", parameterValue);\n   492\t\t\t\texception.setValue(value);\n   493\t\t\t\tthrow exception;\n   494\t\t\t}\n   495\t\t}\n   496\t\n   497\t\tprivate static boolean allFieldsIndexOrNameBased(boolean searchName, Class<?> beanClass, MethodFilter filter) {\n   498\t\t\tboolean hasAnnotation = false;\n   499\t\n   500\t\t\tfor (TransformedHeader header : getFieldSequence(beanClass, true, null, filter)) {\n   501\t\t\t\tif (header == null || header.getTarget() == null) {\n   502\t\t\t\t\tcontinue;\n   503\t\t\t\t}\n   504\t\t\t\tAnnotatedElement element = header.getTarget();\n   505\t\t\t\tif (element instanceof Method && filter.reject((Method) element)) {\n   506\t\t\t\t\tcontinue;\n   507\t\t\t\t}\n   508\t\n   509\t\t\t\tParsed annotation = findAnnotation(element, Parsed.class);\n   510\t\t\t\tif (annotation != null) {\n   511\t\t\t\t\thasAnnotation = true;\n   512\t\n   513\t\t\t\t\tint index = AnnotationRegistry.getValue(element, annotation, \"index\", annotation.index());\n   514\t\n   515\t\t\t\t\tif ((index != -1 && searchName) || (index == -1 && !searchName)) {\n   516\t\t\t\t\t\treturn false;\n   517\t\t\t\t\t}\n   518\t\t\t\t}\n   519\t\t\t}\n   520\t\t\treturn hasAnnotation;\n   521\t\t}\n   522\t\n   523\t\t/**\n   524\t\t * Runs through all annotations of a given class to identify whether all annotated fields and methods\n   525\t\t * (with the {@link Parsed} annotation) are mapped to a column by index.\n   526\t\t *\n   527\t\t * @param beanClass a class whose {@link Parsed} annotations will be processed.\n   528\t\t *\n   529\t\t * @return {@code true} if every field and method annotated with {@link Parsed} in the given class maps to an index, otherwise {@code false}.\n   530\t\t */\n   531\t\tpublic static boolean allFieldsIndexBasedForParsing(Class<?> beanClass) {\n   532\t\t\treturn allFieldsIndexOrNameBased(false, beanClass, MethodFilter.ONLY_SETTERS);\n   533\t\t}\n   534\t\n   535\t\t/**\n   536\t\t * Runs through all annotations of a given class to identify whether all annotated fields and methods\n   537\t\t * (with the {@link Parsed} annotation) are mapped to a column by name.\n   538\t\t *\n   539\t\t * @param beanClass a class whose {@link Parsed} annotations will be processed.\n   540\t\t *\n   541\t\t * @return {@code true} if every field and method annotated with {@link Parsed} in the given class maps to a header name, otherwise {@code false}.\n   542\t\t */\n   543\t\tpublic static boolean allFieldsNameBasedForParsing(Class<?> beanClass) {\n   544\t\t\treturn allFieldsIndexOrNameBased(true, beanClass, MethodFilter.ONLY_SETTERS);\n   545\t\t}\n   546\t\n   547\t\n   548\t\t/**\n   549\t\t * Runs through all annotations of a given class to identify whether all annotated fields and methods\n   550\t\t * (with the {@link Parsed} annotation) are mapped to a column by index.\n   551\t\t *\n   552\t\t * @param beanClass a class whose {@link Parsed} annotations will be processed.\n   553\t\t *\n   554\t\t * @return {@code true} if every field and method annotated with {@link Parsed} in the given class maps to an index, otherwise {@code false}.\n   555\t\t */\n   556\t\tpublic static boolean allFieldsIndexBasedForWriting(Class<?> beanClass) {\n   557\t\t\treturn allFieldsIndexOrNameBased(false, beanClass, MethodFilter.ONLY_GETTERS);\n   558\t\t}\n   559\t\n   560\t\t/**\n   561\t\t * Runs through all annotations of a given class to identify whether all annotated fields and methods\n   562\t\t * (with the {@link Parsed} annotation) are mapped to a column by name.\n   563\t\t *\n   564\t\t * @param beanClass a class whose {@link Parsed} annotations will be processed.\n   565\t\t *\n   566\t\t * @return {@code true} if every field and method annotated with {@link Parsed} in the given class maps to a header name, otherwise {@code false}.\n   567\t\t */\n   568\t\tpublic static boolean allFieldsNameBasedForWriting(Class<?> beanClass) {\n   569\t\t\treturn allFieldsIndexOrNameBased(true, beanClass, MethodFilter.ONLY_GETTERS);\n   570\t\t}\n   571\t\n   572\t\t/**\n   573\t\t * Runs through all {@link Parsed} annotations of a given class to identify all indexes associated with its fields\n   574\t\t *\n   575\t\t * @param beanClass a class whose {@link Parsed} annotations will be processed.\n   576\t\t * @param filter    filter to apply over annotated methods when the class is being used for reading data from beans (to write values to an output)\n   577\t\t *                  or when writing values into beans (while parsing). It is used to choose either a \"get\" or a \"set\"\n   578\t\t *                  method annotated with {@link Parsed}, when both methods target the same field.\n   579\t\t *\n   580\t\t * @return an array of column indexes used by the given class\n   581\t\t */\n   582\t\tpublic static Integer[] getSelectedIndexes(Class<?> beanClass, MethodFilter filter) {\n   583\t\t\tList<Integer> indexes = new ArrayList<Integer>();\n   584\t\t\tfor (TransformedHeader header : getFieldSequence(beanClass, true, null, filter)) {\n   585\t\t\t\tif (header == null) {\n   586\t\t\t\t\tcontinue;\n   587\t\t\t\t}\n   588\t\t\t\tint index = header.getHeaderIndex();\n   589\t\n   590\t\t\t\tif (index != -1) {\n   591\t\t\t\t\tif (filter == MethodFilter.ONLY_GETTERS && indexes.contains(index)) { //allows the same column to be mapped to multiple fields when parsing, but not when writing.\n   592\t\t\t\t\t\tthrow new IllegalArgumentException(\"Duplicate field index '\" + index + \"' found in attribute '\" + header.getTargetName() + \"' of class \" + beanClass.getName());\n   593\t\t\t\t\t}\n   594\t\t\t\t\tindexes.add(index);\n   595\t\t\t\t}\n   596\t\t\t}\n   597\t\t\treturn indexes.toArray(new Integer[indexes.size()]);\n   598\t\t}\n   599\t\n   600\t\t/**\n   601\t\t * Runs through all {@link Parsed} annotations of a given class to identify all header names associated with its fields\n   602\t\t *\n   603\t\t * @param beanClass a class whose {@link Parsed} annotations will be processed.\n   604\t\t * @param filter    a filter to exclude annotated methods that won't be used for parsing or writing\n   605\t\t *\n   606\t\t * @return an array of column names used by the given class\n   607\t\t */\n   608\t\tpublic static String[] deriveHeaderNamesFromFields(Class<?> beanClass, MethodFilter filter) {\n   609\t\t\tList<TransformedHeader> sequence = getFieldSequence(beanClass, true, null, filter);\n   610\t\t\tList<String> out = new ArrayList<String>(sequence.size());\n   611\t\n   612\t\t\tfor (TransformedHeader field : sequence) {\n   613\t\t\t\tif (field == null) {\n   614\t\t\t\t\treturn ArgumentUtils.EMPTY_STRING_ARRAY;  // some field has an index that goes beyond list of header names, can't derive.\n   615\t\t\t\t}\n   616\t\t\t\tout.add(field.getHeaderName());\n   617\t\t\t}\n   618\t\t\treturn out.toArray(new String[out.size()]);\n   619\t\t}\n   620\t\n   621\t\t/**\n   622\t\t * Searches for a given annotation in the hierarchy of a class\n   623\t\t *\n   624\t\t * @param beanClass the class whose hierarchy will be searched\n   625\t\t * @param annotation the annotation to locate\n   626\t\t * @param <T> the type of the annotation to return\n   627\t\t * @return the annotation of the given class or its most immediate parent, or {@code null} if not found.\n   628\t\t */\n   629\t\tpublic static <T extends Annotation> T findAnnotationInClass(Class<?> beanClass, Class<T> annotation) {\n   630\t\t\tT out;\n   631\t\n   632\t\t\tClass<?> parent = beanClass;\n   633\t\t\tdo {\n   634\t\t\t\tout = parent.getAnnotation(annotation);\n   635\t\n   636\t\t\t\tif (out != null) {\n   637\t\t\t\t\treturn out;\n   638\t\t\t\t} else {\n   639\t\t\t\t\tfor (Class<?> iface : parent.getInterfaces()) {\n   640\t\t\t\t\t\tout = findAnnotationInClass(iface, annotation);\n   641\t\t\t\t\t\tif (out != null) {\n   642\t\t\t\t\t\t\treturn out;\n   643\t\t\t\t\t\t}\n   644\t\t\t\t\t}\n   645\t\t\t\t}\n   646\t\n   647\t\t\t\tparent = parent.getSuperclass();\n   648\t\t\t} while (parent != null);\n   649\t\n   650\t\t\treturn null;\n   651\t\t}\n   652\t\n   653\t\t/**\n   654\t\t * Searches for the {@link Headers} annotation in the hierarchy of a class\n   655\t\t *\n   656\t\t * @param beanClass the class whose hierarchy will be searched\n   657\t\t *\n   658\t\t * @return the {@link Headers} annotation of the given class or its most immediate parent, or {@code null} if not found.\n   659\t\t */\n   660\t\tpublic static Headers findHeadersAnnotation(Class<?> beanClass) {\n   661\t\t\treturn findAnnotationInClass(beanClass, Headers.class);\n   662\t\t}\n   663\t\n   664\t\tpublic static Class<?> getType(AnnotatedElement element) {\n   665\t\t\tif (element instanceof Field) {\n   666\t\t\t\treturn ((Field) element).getType();\n   667\t\t\t}\n   668\t\t\tMethod method = (Method) element;\n   669\t\t\tClass<?>[] params = method.getParameterTypes();\n   670\t\t\tif (params.length == 1) {\n   671\t\t\t\treturn params[0];\n   672\t\t\t} else if (params.length > 1) {\n   673\t\t\t\tthrow new IllegalArgumentException(\"Method \" + describeElement(element) + \" cannot have multiple parameters\");\n   674\t\t\t}\n   675\t\n   676\t\t\tClass<?> returnType = method.getReturnType();\n   677\t\t\tif (returnType != void.class) {\n   678\t\t\t\treturn returnType;\n   679\t\t\t}\n   680\t\t\tthrow new IllegalArgumentException(\"Method \" + describeElement(element) + \" must return a value if it has no input parameter\");\n   681\t\t}\n   682\t\n   683\t\tpublic static Class<?> getDeclaringClass(AnnotatedElement element) {\n   684\t\t\tif (element instanceof Field) {\n   685\t\t\t\treturn ((Field) element).getDeclaringClass();\n   686\t\t\t} else {\n   687\t\t\t\treturn ((Method) element).getDeclaringClass();\n   688\t\t\t}\n   689\t\t}\n   690\t\n   691\t\tpublic static String getName(AnnotatedElement element) {\n   692\t\t\tif (element instanceof Field) {\n   693\t\t\t\treturn ((Field) element).getName();\n   694\t\t\t} else {\n   695\t\t\t\treturn ((Method) element).getName();\n   696\t\t\t}\n   697\t\t}\n   698\t\n   699\t\tstatic String describeElement(AnnotatedElement element) {\n   700\t\t\tString description;\n   701\t\t\tif (element instanceof Field) {\n   702\t\t\t\tdescription = \"attribute '\" + ((Field) element).getName() + \"'\";\n   703\t\t\t} else {\n   704\t\t\t\tdescription = \"method '\" + ((Method) element).getName() + \"'\";\n   705\t\t\t}\n   706\t\t\treturn description + \" of class \" + getDeclaringClass(element).getName();\n   707\t\t}\n   708\t\n   709\t\tprivate static void processAnnotations(AnnotatedElement element, boolean processNested, List<Integer> indexes, List<TransformedHeader> tmp, Map<AnnotatedElement, List<TransformedHeader>> nestedReplacements, HeaderTransformer transformer, MethodFilter filter) {\n   710\t\t\tParsed annotation = findAnnotation(element, Parsed.class);\n   711\t\t\tif (annotation != null) {\n   712\t\t\t\tTransformedHeader header = new TransformedHeader(element, transformer);\n   713\t\n   714\t\t\t\tif (filter == MethodFilter.ONLY_GETTERS && header.getHeaderIndex() >= 0 && indexes.contains(header.getHeaderIndex())) {\n   715\t\t\t\t\t//allows the same column to be mapped to multiple fields when parsing, but not when writing.\n   716\t\t\t\t\tthrow new IllegalArgumentException(\"Duplicate field index '\" + header.getHeaderIndex() + \"' found in \" + describeElement(element));\n   717\t\t\t\t}\n   718\t\t\t\ttmp.add(header);\n   719\t\t\t\tindexes.add(header.getHeaderIndex());\n   720\t\t\t}\n   721\t\n   722\t\t\tif (processNested) {\n   723\t\t\t\tNested nested = findAnnotation(element, Nested.class);\n   724\t\t\t\tif (nested != null) {\n   725\t\t\t\t\ttmp.add(new TransformedHeader(element, null));\n   726\t\t\t\t\tClass nestedBeanType = AnnotationRegistry.getValue(element, nested, \"type\", nested.type());\n   727\t\t\t\t\tif (nestedBeanType == Object.class) {\n   728\t\t\t\t\t\tnestedBeanType = getType(element);\n   729\t\t\t\t\t}\n   730\t\n   731\t\t\t\t\tClass<? extends HeaderTransformer> transformerType = AnnotationRegistry.getValue(element, nested, \"headerTransformer\", nested.headerTransformer());\n   732\t\t\t\t\tif (transformerType != HeaderTransformer.class) {\n   733\t\t\t\t\t\tString[] args = AnnotationRegistry.getValue(element, nested, \"args\", nested.args());\n   734\t\t\t\t\t\tHeaderTransformer innerTransformer = AnnotationHelper.newInstance(HeaderTransformer.class, transformerType, args);\n   735\t\t\t\t\t\tnestedReplacements.put(element, getFieldSequence(nestedBeanType, true, indexes, innerTransformer, filter));\n   736\t\t\t\t\t} else {\n   737\t\t\t\t\t\tnestedReplacements.put(element, getFieldSequence(nestedBeanType, true, indexes, transformer, filter));\n   738\t\t\t\t\t}\n   739\t\t\t\t}\n   740\t\t\t}\n   741\t\t}\n   742\t\n   743\t\t/**\n   744\t\t * Returns a list of fields with {@link Parsed} annotations in the sequence they should be processed for parsing\n   745\t\t * or writing. The sequence is ordered taking into account their original order in the annotated class, unless\n   746\t\t * {@link Parsed#index()} is set to a non-negative number.\n   747\t\t *\n   748\t\t * @param beanClass     the class whose field sequence will be returned.\n   749\t\t * @param processNested flag indicating whether {@link Nested} annotations should be processed\n   750\t\t * @param transformer   a {@link HeaderTransformer} instance to be used for transforming headers of a given {@link Nested} attribute.\n   751\t\t * @param filter        filter to apply over annotated methods when the class is being used for reading data from beans (to write values to an output)\n   752\t\t *                      or when writing values into beans (while parsing). It is used to choose either a \"get\" or a \"set\"\n   753\t\t *                      method annotated with {@link Parsed}, when both methods target the same field.\n   754\t\t *\n   755\t\t * @return a list of fields ordered by their processing sequence\n   756\t\t */\n   757\t\tpublic static List<TransformedHeader> getFieldSequence(Class beanClass, boolean processNested, HeaderTransformer transformer, MethodFilter filter) {\n   758\t\t\tList<Integer> indexes = new ArrayList<Integer>();\n   759\t\t\tList<TransformedHeader> tmp = getFieldSequence(beanClass, processNested, indexes, transformer, filter);\n   760\t\n   761\t\t\tCollections.sort(tmp, new Comparator<TransformedHeader>() {\n   762\t\t\t\t@Override\n   763\t\t\t\tpublic int compare(TransformedHeader t1, TransformedHeader t2) {\n   764\t\t\t\t\tint i1 = t1.getHeaderIndex();\n   765\t\t\t\t\tint i2 = t2.getHeaderIndex();\n   766\t\t\t\t\treturn i1 < i2 ? -1 : (i1 == i2 ? 0 : 1);\n   767\t\t\t\t}\n   768\t\t\t});\n   769\t\t\tCollections.sort(indexes);\n   770\t\n   771\t\t\tint col = -1;\n   772\t\t\tfor (int i : indexes) {\n   773\t\t\t\tcol++;\n   774\t\t\t\tif (i < 0) {\n   775\t\t\t\t\tcontinue;\n   776\t\t\t\t}\n   777\t\t\t\tif (i != col) {\n   778\t\t\t\t\twhile (i >= tmp.size()) {\n   779\t\t\t\t\t\ttmp.add(null);\n   780\t\t\t\t\t}\n   781\t\t\t\t\tCollections.swap(tmp, i, col);\n   782\t\t\t\t}\n   783\t\t\t}\n   784\t\n   785\t\t\treturn tmp;\n   786\t\t}\n   787\t\n   788\t\tprivate static List<TransformedHeader> getFieldSequence(Class beanClass, boolean processNested, List<Integer> indexes, HeaderTransformer transformer, MethodFilter filter) {\n   789\t\t\tList<TransformedHeader> tmp = new ArrayList<TransformedHeader>();\n   790\t\n   791\t\t\tMap<AnnotatedElement, List<TransformedHeader>> nestedReplacements = new LinkedHashMap<AnnotatedElement, List<TransformedHeader>>();\n   792\t\n   793\t\t\tfor (Field field : getAllFields(beanClass).keySet()) {\n   794\t\t\t\tprocessAnnotations(field, processNested, indexes, tmp, nestedReplacements, transformer, filter);\n   795\t\t\t}\n   796\t\n   797\t\t\tfor (Method method : getAnnotatedMethods(beanClass, filter)) {\n   798\t\t\t\tprocessAnnotations(method, processNested, indexes, tmp, nestedReplacements, transformer, filter);\n   799\t\t\t}\n   800\t\n   801\t\t\tif (!nestedReplacements.isEmpty()) {\n   802\t\t\t\tint size = tmp.size();\n   803\t\t\t\tfor (int i = size - 1; i >= 0; i--) {\n   804\t\t\t\t\tTransformedHeader field = tmp.get(i);\n   805\t\t\t\t\tList<TransformedHeader> nestedFields = nestedReplacements.remove(field.getTarget());\n   806\t\t\t\t\tif (nestedFields != null) {\n   807\t\t\t\t\t\ttmp.remove(i);\n   808\t\t\t\t\t\ttmp.addAll(i, nestedFields);\n   809\t\n   810\t\t\t\t\t\tif (nestedReplacements.isEmpty()) {\n   811\t\t\t\t\t\t\tbreak;\n   812\t\t\t\t\t\t}\n   813\t\t\t\t\t}\n   814\t\t\t\t}\n   815\t\t\t}\n   816\t\t\treturn tmp;\n   817\t\t}\n   818\t\n   819\t\t/**\n   820\t\t * Returns all fields available from a given class.\n   821\t\t *\n   822\t\t * @param beanClass a class whose fields will be returned.\n   823\t\t *\n   824\t\t * @return a map of {@link Field} and the corresponding {@link PropertyWrapper}\n   825\t\t */\n   826\t\tpublic static Map<Field, PropertyWrapper> getAllFields(Class<?> beanClass) {\n   827\t\n   828\t\t\tMap<String, PropertyWrapper> properties = new LinkedHashMap<String, PropertyWrapper>();\n   829\t\t\ttry {\n   830\t\t\t\tfor (PropertyWrapper property : BeanHelper.getPropertyDescriptors(beanClass)) {\n   831\t\t\t\t\tString name = property.getName();\n   832\t\t\t\t\tif (name != null) {\n   833\t\t\t\t\t\tproperties.put(name, property);\n   834\t\t\t\t\t}\n   835\t\t\t\t}\n   836\t\t\t} catch (Exception e) {\n   837\t\t\t\t//ignore and proceed to get fields directly\n   838\t\t\t}\n   839\t\n   840\t\t\tSet<String> used = new HashSet<String>();\n   841\t\t\tClass<?> clazz = beanClass;\n   842\t\n   843\t\t\tMap<Field, PropertyWrapper> out = new LinkedHashMap<Field, PropertyWrapper>();\n   844\t\n   845\t\t\tdo {\n   846\t\t\t\tField[] declared = clazz.getDeclaredFields();\n   847\t\t\t\tfor (Field field : declared) {\n   848\t\t\t\t\tif (used.contains(field.getName())) {\n   849\t\t\t\t\t\tcontinue;\n   850\t\t\t\t\t}\n   851\t\t\t\t\tused.add(field.getName());\n   852\t\t\t\t\tout.put(field, properties.get(field.getName()));\n   853\t\t\t\t}\n   854\t\t\t\tclazz = clazz.getSuperclass();\n   855\t\t\t} while (clazz != null && clazz != Object.class);\n   856\t\t\treturn out;\n   857\t\t}\n   858\t\n   859\t\t/**\n   860\t\t * Returns all methods available from a given class that have a specific annotation.\n   861\t\t *\n   862\t\t * @param beanClass a class whose methods will be returned.\n   863\t\t * @param filter    filter to apply over annotated methods when the class is being used for reading data from beans (to write values to an output)\n   864\t\t *                  or when writing values into beans (while parsing). It is used to choose either a \"get\" or a \"set\"\n   865\t\t *                  method annotated with {@link Parsed}, when both methods target the same field.\n   866\t\t * @param annotationType the annotation type to consider\n   867\t\t *\n   868\t\t * @param <A> the expected annotation type\n   869\t\t *\n   870\t\t * @return a list of {@link Method} with at least one annotation\n   871\t\t */\n   872\t\tpublic static <A extends Annotation> List<Method> getAnnotatedMethods(Class<?> beanClass, MethodFilter filter, Class<A> annotationType) {\n   873\t\t\tList<Method> out = new ArrayList<Method>();\n   874\t\n   875\t\t\tClass clazz = beanClass;\n   876\t\n   877\t\t\tdo {\n   878\t\t\t\tMethod[] declared = clazz.getDeclaredMethods();\n   879\t\t\t\touter:\n   880\t\t\t\tfor (Method method : declared) {\n   881\t\t\t\t\tif (!method.isSynthetic() && annotationType == NO_ANNOTATIONS.class) {\n   882\t\t\t\t\t\tif (!filter.reject(method)) {\n   883\t\t\t\t\t\t\tout.add(method);\n   884\t\t\t\t\t\t}\n   885\t\t\t\t\t} else {\n   886\t\t\t\t\t\tAnnotation[] annotations = method.getDeclaredAnnotations();\n   887\t\t\t\t\t\tfor (Annotation annotation : annotations) {\n   888\t\t\t\t\t\t\tif ((annotationType == null && isCustomAnnotation(annotation)) || annotationType == annotation.annotationType()) {\n   889\t\t\t\t\t\t\t\tif (filter.reject(method)) {\n   890\t\t\t\t\t\t\t\t\tcontinue outer;\n   891\t\t\t\t\t\t\t\t}\n   892\t\t\t\t\t\t\t\tout.add(method);\n   893\t\t\t\t\t\t\t\tcontinue outer;\n   894\t\t\t\t\t\t\t}\n   895\t\t\t\t\t\t}\n   896\t\t\t\t\t}\n   897\t\t\t\t}\n   898\t\t\t\tclazz = clazz.getSuperclass();\n   899\t\t\t} while (clazz != null && clazz != Object.class);\n   900\t\t\treturn out;\n   901\t\t}\n   902\t\n   903\t\tprivate static final class NO_ANNOTATIONS implements Annotation {\n   904\t\t\t@Override\n   905\t\t\tpublic Class<? extends Annotation> annotationType() {\n   906\t\t\t\treturn NO_ANNOTATIONS.class;\n   907\t\t\t}\n   908\t\t}\n   909\t\n   910\t\t/**\n   911\t\t * Returns all methods available from a given class\n   912\t\t *\n   913\t\t * @param beanClass a class whose methods will be returned.\n   914\t\t * @param filter    filter to apply over annotated methods when the class is being used for reading data from beans (to write values to an output)\n   915\t\t *                  or when writing values into beans (while parsing). It is used to choose either a \"get\" or a \"set\"\n   916\t\t *                  method annotated with {@link Parsed}, when both methods target the same field.\n   917\t\t *\n   918\t\t * @return a list of {@link Method}s that conform to the given filter.\n   919\t\t */\n   920\t\tpublic static List<Method> getAllMethods(Class<?> beanClass, MethodFilter filter) {\n   921\t\t\treturn getAnnotatedMethods(beanClass, filter, NO_ANNOTATIONS.class);\n   922\t\t}\n   923\t\n   924\t\t/**\n   925\t\t * Returns all methods available from a given class that have an annotation.\n   926\t\t *\n   927\t\t * @param beanClass a class whose methods will be returned.\n   928\t\t * @param filter    filter to apply over annotated methods when the class is being used for reading data from beans (to write values to an output)\n   929\t\t *                  or when writing values into beans (while parsing). It is used to choose either a \"get\" or a \"set\"\n   930\t\t *                  method annotated with {@link Parsed}, when both methods target the same field.\n   931\t\t *\n   932\t\t * @return a list of {@link Method} with at least one annotation\n   933\t\t */\n   934\t\tpublic static List<Method> getAnnotatedMethods(Class<?> beanClass, MethodFilter filter) {\n   935\t\t\treturn getAnnotatedMethods(beanClass, filter, null);\n   936\t\t}\n   937\t\n   938\t\t/**\n   939\t\t * Returns all attributes available from a given class that have an annotation.\n   940\t\t *\n   941\t\t * @param beanClass a class whose methods will be returned.\n   942\t\t *\n   943\t\t * @return a list of {@link Field} with at least one annotation\n   944\t\t */\n   945\t\tpublic static List<Field> getAnnotatedFields(Class<?> beanClass) {\n   946\t\t\treturn getAnnotatedFields(beanClass, null);\n   947\t\t}\n   948\t\n   949\t\t/**\n   950\t\t * Returns all attributes available from a given class that have an annotation.\n   951\t\t *\n   952\t\t * @param beanClass a class whose methods will be returned.\n   953\t\t * @param annotationType the type of annotation to consider\n   954\t\t * @param <A> the expected annotation type\n   955\t\t *\n   956\t\t * @return a list of {@link Field} with at least one annotation\n   957\t\t */\n   958\t\tpublic static <A extends Annotation> List<Field> getAnnotatedFields(Class<?> beanClass, Class<A> annotationType) {\n   959\t\t\tList<Field> out = new ArrayList<Field>();\n   960\t\n   961\t\t\tClass clazz = beanClass;\n   962\t\n   963\t\t\tdo {\n   964\t\t\t\tField[] declared = clazz.getDeclaredFields();\n   965\t\t\t\touter:\n   966\t\t\t\tfor (Field field : declared) {\n   967\t\t\t\t\tAnnotation[] annotations = field.getDeclaredAnnotations();\n   968\t\t\t\t\tfor (Annotation annotation : annotations) {\n   969\t\t\t\t\t\tif ((annotationType == null && isCustomAnnotation(annotation)) || annotationType == annotation.annotationType()) {\n   970\t\t\t\t\t\t\tout.add(field);\n   971\t\t\t\t\t\t\tcontinue outer;\n   972\t\t\t\t\t\t}\n   973\t\t\t\t\t}\n   974\t\t\t\t}\n   975\t\t\t\tclazz = clazz.getSuperclass();\n   976\t\t\t} while (clazz != null && clazz != Object.class);\n   977\t\t\treturn out;\n   978\t\t}\n   979\t\n   980\t\t/**\n   981\t\t * Searches for an annotation of a given type that's been applied to an element either directly (as a regular annotation)\n   982\t\t * or indirectly (as a meta-annotations, i.e. an annotation that has annotations).\n   983\t\t *\n   984\t\t * @param annotatedElement the element whose annotations will be searched\n   985\t\t * @param annotationType   the type of annotation to search for\n   986\t\t * @param <A>              the type of the annotation being searched for\n   987\t\t *\n   988\t\t * @return the annotation associated with the given element, or {@code null} if not found.\n   989\t\t */\n   990\t\tpublic synchronized static <A extends Annotation> A findAnnotation(AnnotatedElement annotatedElement, Class<A> annotationType) {\n   991\t\t\tif (annotatedElement == null || annotationType == null) {\n   992\t\t\t\treturn null;\n   993\t\t\t}\n   994\t\n   995\t\t\tif (annotatedElement.equals(lastProcessedElement) && annotationType == lastProcessedAnnotationType) {\n   996\t\t\t\treturn (A) lastAnnotationFound;\n   997\t\t\t}\n   998\t\n   999\t\t\tlastProcessedElement = annotatedElement;\n  1000\t\t\tlastProcessedAnnotationType = annotationType;\n  1001\t\n  1002\t\t\tStack<Annotation> path = new Stack<Annotation>();\n  1003\t\n  1004\t\t\tA annotation = findAnnotation(annotatedElement, annotationType, new HashSet<Annotation>(), path);\n  1005\t\t\tif (annotation == null || path.isEmpty()) {\n  1006\t\t\t\tlastAnnotationFound = annotation;\n  1007\t\t\t\treturn annotation;\n  1008\t\t\t}\n  1009\t\n  1010\t\t\twhile (!path.isEmpty()) {\n  1011\t\t\t\tAnnotation parent = path.pop();\n  1012\t\t\t\tAnnotation target = path.isEmpty() ? annotation : path.peek();\n  1013\t\n  1014\t\t\t\tfor (Method method : parent.annotationType().getDeclaredMethods()) {\n  1015\t\t\t\t\tCopy copy = method.getAnnotation(Copy.class);\n  1016\t\t\t\t\tif (copy != null) {\n  1017\t\t\t\t\t\tClass targetClass = copy.to();\n  1018\t\n  1019\t\t\t\t\t\tString targetProperty = copy.property();\n  1020\t\t\t\t\t\tif (targetProperty.trim().isEmpty()) {\n  1021\t\t\t\t\t\t\ttargetProperty = method.getName();\n  1022\t\t\t\t\t\t}\n  1023\t\n  1024\t\t\t\t\t\tObject value;\n  1025\t\n  1026\t\t\t\t\t\tObject existingValue = AnnotationRegistry.getValue(annotatedElement, target, method.getName());\n  1027\t\t\t\t\t\tif (existingValue != null) {\n  1028\t\t\t\t\t\t\tvalue = existingValue;\n  1029\t\t\t\t\t\t} else {\n  1030\t\t\t\t\t\t\tvalue = invoke(parent, method);\n  1031\t\t\t\t\t\t}\n  1032\t\n  1033\t\t\t\t\t\tClass sourceValueType = method.getReturnType();\n  1034\t\t\t\t\t\tClass<?> targetPropertyType = findAnnotationMethodType(targetClass, targetProperty);\n  1035\t\t\t\t\t\tif (targetPropertyType != null && targetPropertyType.isArray() && !value.getClass().isArray()) {\n  1036\t\t\t\t\t\t\tObject array = Array.newInstance(sourceValueType, 1);\n  1037\t\t\t\t\t\t\tArray.set(array, 0, value);\n  1038\t\t\t\t\t\t\tvalue = array;\n  1039\t\t\t\t\t\t}\n  1040\t\n  1041\t\t\t\t\t\tif (targetClass == target.annotationType()) {\n  1042\t\t\t\t\t\t\tAnnotationRegistry.setValue(annotatedElement, annotation, targetProperty, value);\n  1043\t\t\t\t\t\t} else {\n  1044\t\t\t\t\t\t\tA ann = (A) findAnnotation(annotatedElement, targetClass, new HashSet<Annotation>(), new Stack<Annotation>());\n  1045\t\t\t\t\t\t\tif (ann != null) {\n  1046\t\t\t\t\t\t\t\tAnnotationRegistry.setValue(annotatedElement, ann, targetProperty, value);\n  1047\t\t\t\t\t\t\t} else {\n  1048\t\t\t\t\t\t\t\tthrow new IllegalStateException(\"Can't process @Copy annotation on '\" + method + \"'. \" +\n  1049\t\t\t\t\t\t\t\t\t\t\"Annotation '\" + targetClass.getName() + \"' not used in \" + parent.annotationType().getName() + \". Unable to process field \" + annotatedElement + \"'\");\n  1050\t\t\t\t\t\t\t}\n  1051\t\t\t\t\t\t}\n  1052\t\n  1053\t\t\t\t\t}\n  1054\t\t\t\t}\n  1055\t\t\t}\n  1056\t\t\tlastAnnotationFound = annotation;\n  1057\t\t\treturn annotation;\n  1058\t\t}\n  1059\t\n  1060\t\tprivate static Class<?> findAnnotationMethodType(Class<? extends Annotation> type, String methodName) {\n  1061\t\t\tfor (Method method : type.getDeclaredMethods()) {\n  1062\t\t\t\tif (method.getName().equals(methodName)) {\n  1063\t\t\t\t\treturn method.getReturnType();\n  1064\t\t\t\t}\n  1065\t\t\t}\n  1066\t\t\treturn null;\n  1067\t\t}\n  1068\t\n  1069\t\tprivate static Object invoke(Annotation annotation, Method method) {\n  1070\t\t\ttry {\n  1071\t\t\t\treturn method.invoke(annotation, (Object[]) null);\n  1072\t\t\t} catch (Exception e) {\n  1073\t\t\t\tthrow new IllegalStateException(\"Can't read value from annotation \" + annotation, e);\n  1074\t\t\t}\n  1075\t\t}\n  1076\t\n  1077\t\tprivate static <A> A findAnnotation(AnnotatedElement annotatedElement, Class<A> annotationType, Set<Annotation> visited, Stack<Annotation> path) {\n  1078\t\t\tAnnotation[] declaredAnnotations = annotatedElement.getDeclaredAnnotations();\n  1079\t\t\tfor (int i = 0; i < declaredAnnotations.length; i++) {\n  1080\t\t\t\tAnnotation ann = declaredAnnotations[i];\n  1081\t\t\t\tif (ann.annotationType() == annotationType) {\n  1082\t\t\t\t\treturn (A) ann;\n  1083\t\t\t\t}\n  1084\t\t\t}\n  1085\t\t\tfor (int i = 0; i < declaredAnnotations.length; i++) {\n  1086\t\t\t\tAnnotation ann = declaredAnnotations[i];\n  1087\t\t\t\tif (isCustomAnnotation(ann) && visited.add(ann)) {\n  1088\t\t\t\t\tA annotation = findAnnotation(ann.annotationType(), annotationType, visited, path);\n  1089\t\t\t\t\tpath.push(ann);\n  1090\t\t\t\t\tif (annotation != null) {\n  1091\t\t\t\t\t\treturn annotation;\n  1092\t\t\t\t\t}\n  1093\t\t\t\t}\n  1094\t\t\t}\n  1095\t\t\treturn null;\n  1096\t\t}\n  1097\t\n  1098\t\n  1099\t\tprivate static final Set<Class> javaLangAnnotationTypes = new HashSet<Class>();\n  1100\t\tprivate static final Set<Class> customAnnotationTypes = new HashSet<Class>();\n"}], "isError": false, "timestamp": 1786358014373}}
[recv] {"type": "message_end", "message": {"role": "toolResult", "toolCallId": "call_a2vLOGOXRCxUECNekiY5HX3e|fc_06b6ce514efb2029016a79a8fc168c8191a748d852353b05f8", "toolName": "bash", "content": [{"type": "text", "text": "   280\t\t\t\tchar ch;\n   281\t\t\t\tfor (; j < locale.length() && Character.isLetterOrDigit((ch = locale.charAt(j))); j++, appender.append(ch))\n   282\t\t\t\t\t;\n   283\t\t\t\tlanguageCode = appender.getAndReset();\n   284\t\t\t\tfor (++j; j < locale.length() && Character.isLetterOrDigit((ch = locale.charAt(j))); j++, appender.append(ch))\n   285\t\t\t\t\t;\n   286\t\t\t\tcountryCode = appender.getAndReset();\n   287\t\t\t\tfor (++j; j < locale.length() && Character.isLetterOrDigit((ch = locale.charAt(j))); j++, appender.append(ch))\n   288\t\t\t\t\t;\n   289\t\t\t\tvariant = appender.getAndReset();\n   290\t\n   291\t\t\t\treturn new Locale(languageCode, countryCode, variant);\n   292\t\t\t}\n   293\t\t\treturn Locale.getDefault();\n   294\t\t}\n   295\t\n   296\t\tpublic static <T> T newInstance(Class parent, Class<T> type, String[] args) {\n   297\t\t\tif (!parent.isAssignableFrom(type)) {\n   298\t\t\t\tthrow new DataProcessingException(\"Not a valid \" + parent.getSimpleName() + \" class: '\" + type.getSimpleName() + \"' (\" + type.getName() + ')');\n   299\t\t\t}\n   300\t\t\ttry {\n   301\t\t\t\tConstructor constructor = type.getConstructor(String[].class);\n   302\t\t\t\treturn (T) constructor.newInstance((Object) args);\n   303\t\t\t} catch (NoSuchMethodException e) {\n   304\t\t\t\tif (args.length == 0) {\n   305\t\t\t\t\ttry {\n   306\t\t\t\t\t\treturn type.newInstance();\n   307\t\t\t\t\t} catch (Exception ex) {\n   308\t\t\t\t\t\tthrow new DataProcessingException(\"Unexpected error instantiating custom \" + parent.getSimpleName() + \" class '\" + type.getSimpleName() + \"' (\" + type.getName() + ')', e);\n   309\t\t\t\t\t}\n   310\t\t\t\t}\n   311\t\t\t\tthrow new DataProcessingException(\"Could not find a public constructor with a String[] parameter in custom \" + parent.getSimpleName() + \" class '\" + type.getSimpleName() + \"' (\" + type.getName() + ')', e);\n   312\t\t\t} catch (Exception e) {\n   313\t\t\t\tthrow new DataProcessingException(\"Unexpected error instantiating custom \" + parent.getSimpleName() + \" class '\" + type.getSimpleName() + \"' (\" + type.getName() + ')', e);\n   314\t\t\t}\n   315\t\t}\n   316\t\n   317\t\t/**\n   318\t\t * Identifies the proper conversion for a given type\n   319\t\t *\n   320\t\t * @param fieldType The type of field to have conversions applied to.\n   321\t\t * @param target    the annotated attribute of method that has the annotation\n   322\t\t * @param parsed    the {@link Parsed} annotation from {@link com.univocity.parsers.annotations}.\n   323\t\t *\n   324\t\t * @return The {@link Conversion} that should be applied to the field type\n   325\t\t */\n   326\t\t@SuppressWarnings({\"rawtypes\", \"unchecked\"})\n   327\t\tpublic static Conversion getDefaultConversion(Class fieldType, AnnotatedElement target, Parsed parsed) {\n   328\t\t\tString nullRead = getNullReadValue(target, parsed);\n   329\t\t\tObject valueIfStringIsNull = null;\n   330\t\n   331\t\t\tObjectConversion conversion = null;\n   332\t\t\tif (fieldType == Boolean.class || fieldType == boolean.class) {\n   333\t\t\t\tconversion = Conversions.toBoolean();\n   334\t\t\t\tvalueIfStringIsNull = nullRead == null ? null : Boolean.valueOf(nullRead);\n   335\t\t\t} else if (fieldType == Character.class || fieldType == char.class) {\n   336\t\t\t\tconversion = Conversions.toChar();\n   337\t\t\t\tif (nullRead != null && nullRead.length() > 1) {\n   338\t\t\t\t\tthrow new DataProcessingException(\"Invalid default value for character '\" + nullRead + \"'. It should contain one character only.\");\n   339\t\t\t\t}\n   340\t\t\t\tvalueIfStringIsNull = nullRead == null ? null : nullRead.charAt(0);\n   341\t\t\t} else if (fieldType == Byte.class || fieldType == byte.class) {\n   342\t\t\t\tconversion = Conversions.toByte();\n   343\t\t\t\tvalueIfStringIsNull = nullRead == null ? null : Byte.valueOf(nullRead);\n   344\t\t\t} else if (fieldType == Short.class || fieldType == short.class) {\n   345\t\t\t\tconversion = Conversions.toShort();\n   346\t\t\t\tvalueIfStringIsNull = nullRead == null ? null : Short.valueOf(nullRead);\n   347\t\t\t} else if (fieldType == Integer.class || fieldType == int.class) {\n   348\t\t\t\tconversion = Conversions.toInteger();\n   349\t\t\t\tvalueIfStringIsNull = nullRead == null ? null : Integer.valueOf(nullRead);\n   350\t\t\t} else if (fieldType == Long.class || fieldType == long.class) {\n   351\t\t\t\tconversion = Conversions.toLong();\n   352\t\t\t\tvalueIfStringIsNull = nullRead == null ? null : Long.valueOf(nullRead);\n   353\t\t\t} else if (fieldType == Float.class || fieldType == float.class) {\n   354\t\t\t\tconversion = Conversions.toFloat();\n   355\t\t\t\tvalueIfStringIsNull = nullRead == null ? null : Float.valueOf(nullRead);\n   356\t\t\t} else if (fieldType == Double.class || fieldType == double.class) {\n   357\t\t\t\tconversion = Conversions.toDouble();\n   358\t\t\t\tvalueIfStringIsNull = nullRead == null ? null : Double.valueOf(nullRead);\n   359\t\t\t} else if (fieldType == BigInteger.class) {\n   360\t\t\t\tconversion = Conversions.toBigInteger();\n   361\t\t\t\tvalueIfStringIsNull = nullRead == null ? null : new BigInteger(nullRead);\n   362\t\t\t} else if (fieldType == BigDecimal.class) {\n   363\t\t\t\tconversion = Conversions.toBigDecimal();\n   364\t\t\t\tvalueIfStringIsNull = nullRead == null ? null : new BigDecimal(nullRead);\n   365\t\t\t} else if (Enum.class.isAssignableFrom(fieldType)) {\n   366\t\t\t\tconversion = Conversions.toEnum(fieldType);\n   367\t\t\t}\n   368\t\n   369\t\t\tif (conversion != null) {\n   370\t\t\t\tconversion.setValueIfStringIsNull(valueIfStringIsNull);\n   371\t\t\t\tconversion.setValueIfObjectIsNull(getNullWriteValue(target, parsed));\n   372\t\t\t}\n   373\t\n   374\t\t\treturn conversion;\n   375\t\t}\n   376\t\n   377\t\t/**\n   378\t\t * Returns the default {@link Conversion} that should be applied to the field based on its type.\n   379\t\t *\n   380\t\t * @param target The field or method whose values must be converted from a given parsed String.\n   381\t\t *\n   382\t\t * @return The default {@link Conversion} applied to the given field.\n   383\t\t */\n   384\t\t@SuppressWarnings(\"rawtypes\")\n   385\t\tpublic static Conversion getDefaultConversion(AnnotatedElement target) {\n   386\t\t\tParsed parsed = findAnnotation(target, Parsed.class);\n   387\t\t\treturn getDefaultConversion(getType(target), target, parsed);\n   388\t\t}\n   389\t\n   390\t\t/**\n   391\t\t * Applied the configuration of a formatter object ({@link SimpleDateFormat}, {@link NumberFormat} and others).\n   392\t\t *\n   393\t\t * @param formatter           the formatter instance\n   394\t\t * @param propertiesAndValues a sequence of key-value pairs, where the key is a property of the formatter\n   395\t\t *                            object to be set to the following value via reflection\n   396\t\t */\n   397\t\tpublic static void applyFormatSettings(Object formatter, String[] propertiesAndValues) {\n   398\t\t\tif (propertiesAndValues.length == 0) {\n   399\t\t\t\treturn;\n   400\t\t\t}\n   401\t\n   402\t\t\tMap<String, String> values = new HashMap<String, String>();\n   403\t\t\tfor (String setting : propertiesAndValues) {\n   404\t\t\t\tif (setting == null) {\n   405\t\t\t\t\tcontinue;\n   406\t\t\t\t}\n   407\t\t\t\tString[] pair = setting.split(\"=\");\n   408\t\t\t\tif (pair.length != 2) {\n   409\t\t\t\t\tthrow new DataProcessingException(\"Illegal format setting '\" + setting + \"' among: \" + Arrays.toString(propertiesAndValues));\n   410\t\t\t\t}\n   411\t\n   412\t\t\t\tvalues.put(pair[0], pair[1]);\n   413\t\t\t}\n   414\t\n   415\t\t\ttry {\n   416\t\t\t\tfor (PropertyWrapper property : BeanHelper.getPropertyDescriptors(formatter.getClass())) {\n   417\t\t\t\t\tString name = property.getName();\n   418\t\t\t\t\tString value = values.remove(name);\n   419\t\t\t\t\tif (value != null) {\n   420\t\t\t\t\t\tinvokeSetter(formatter, property, value);\n   421\t\t\t\t\t}\n   422\t\n   423\t\t\t\t\tif (\"decimalFormatSymbols\".equals(property.getName())) {\n   424\t\t\t\t\t\tDecimalFormatSymbols modifiedDecimalSymbols = new DecimalFormatSymbols();\n   425\t\t\t\t\t\tboolean modified = false;\n   426\t\t\t\t\t\ttry {\n   427\t\t\t\t\t\t\tfor (PropertyWrapper prop : BeanHelper.getPropertyDescriptors(modifiedDecimalSymbols.getClass())) {\n   428\t\t\t\t\t\t\t\tvalue = values.remove(prop.getName());\n   429\t\t\t\t\t\t\t\tif (value != null) {\n   430\t\t\t\t\t\t\t\t\tinvokeSetter(modifiedDecimalSymbols, prop, value);\n   431\t\t\t\t\t\t\t\t\tmodified = true;\n   432\t\t\t\t\t\t\t\t}\n   433\t\t\t\t\t\t\t}\n   434\t\n   435\t\t\t\t\t\t\tif (modified) {\n   436\t\t\t\t\t\t\t\tMethod writeMethod = property.getWriteMethod();\n   437\t\t\t\t\t\t\t\tif (writeMethod != null) {\n   438\t\t\t\t\t\t\t\t\twriteMethod.invoke(formatter, modifiedDecimalSymbols);\n   439\t\t\t\t\t\t\t\t} else {\n   440\t\t\t\t\t\t\t\t\tthrow new IllegalStateException(\"No write method defined for property \" + property.getName());\n   441\t\t\t\t\t\t\t\t}\n   442\t\t\t\t\t\t\t}\n   443\t\t\t\t\t\t} catch (Throwable ex) {\n   444\t\t\t\t\t\t\tthrow new DataProcessingException(\"Error trying to configure decimal symbols of formatter '\" + formatter.getClass() + '.', ex);\n   445\t\t\t\t\t\t}\n   446\t\t\t\t\t}\n   447\t\t\t\t}\n   448\t\t\t} catch (Exception e) {\n   449\t\t\t\t//ignore and proceed\n   450\t\t\t}\n   451\t\n   452\t\t\tif (!values.isEmpty()) {\n   453\t\t\t\tthrow new DataProcessingException(\"Cannot find properties in formatter of type '\" + formatter.getClass() + \"': \" + values);\n   454\t\t\t}\n   455\t\t}\n   456\t\n   457\t\tprivate static void invokeSetter(Object formatter, PropertyWrapper property, final String value) {\n   458\t\t\tMethod writeMethod = property.getWriteMethod();\n   459\t\t\tif (writeMethod == null) {\n   460\t\t\t\tDataProcessingException exception = new DataProcessingException(\"Cannot set property '\" + property.getName() + \"' of formatter '\" + formatter.getClass() + \"' to '{value}'. No setter defined\");\n   461\t\t\t\texception.setValue(value);\n   462\t\t\t\tthrow exception;\n   463\t\t\t}\n   464\t\t\tClass<?> parameterType = writeMethod.getParameterTypes()[0];\n   465\t\t\tObject parameterValue = null;\n   466\t\t\tif (parameterType == String.class) {\n   467\t\t\t\tparameterValue = value;\n   468\t\t\t} else if (parameterType == Integer.class || parameterType == int.class) {\n   469\t\t\t\tparameterValue = Integer.parseInt(value);\n   470\t\t\t} else if (parameterType == Character.class || parameterType == char.class) {\n   471\t\t\t\tparameterValue = value.charAt(0);\n   472\t\t\t} else if (parameterType == Currency.class) {\n   473\t\t\t\tparameterValue = Currency.getInstance(value);\n   474\t\t\t} else if (parameterType == Boolean.class || parameterType == boolean.class) {\n   475\t\t\t\tparameterValue = Boolean.valueOf(value);\n   476\t\t\t} else if (parameterType == TimeZone.class) {\n   477\t\t\t\tparameterValue = TimeZone.getTimeZone(value);\n   478\t\t\t} else if (parameterType == DateFormatSymbols.class) {\n   479\t\t\t\tparameterValue = DateFormatSymbols.getInstance(new Locale(value));\n   480\t\t\t}\n   481\t\t\tif (parameterValue == null) {\n   482\t\t\t\tDataProcessingException exception = new DataProcessingException(\"Cannot set property '\" + property.getName() + \"' of formatter '\" + formatter.getClass() + \". Cannot convert '{value}' to instance of \" + parameterType);\n   483\t\t\t\texception.setValue(value);\n   484\t\t\t\tthrow exception;\n   485\t\t\t}\n   486\t\n   487\t\t\ttry {\n   488\t\t\t\twriteMethod.invoke(formatter, parameterValue);\n   489\t\t\t} catch (Throwable e) {\n   490\t\t\t\tDataProcessingException exception = new DataProcessingException(\"Error setting property '\" + property.getName() + \"' of formatter '\" + formatter.getClass() + \", with '{parameterValue}' (converted from '{value}')\", e);\n   491\t\t\t\texception.setValue(\"parameterValue\", parameterValue);\n   492\t\t\t\texception.setValue(value);\n   493\t\t\t\tthrow exception;\n   494\t\t\t}\n   495\t\t}\n   496\t\n   497\t\tprivate static boolean allFieldsIndexOrNameBased(boolean searchName, Class<?> beanClass, MethodFilter filter) {\n   498\t\t\tboolean hasAnnotation = false;\n   499\t\n   500\t\t\tfor (TransformedHeader header : getFieldSequence(beanClass, true, null, filter)) {\n   501\t\t\t\tif (header == null || header.getTarget() == null) {\n   502\t\t\t\t\tcontinue;\n   503\t\t\t\t}\n   504\t\t\t\tAnnotatedElement element = header.getTarget();\n   505\t\t\t\tif (element instanceof Method && filter.reject((Method) element)) {\n   506\t\t\t\t\tcontinue;\n   507\t\t\t\t}\n   508\t\n   509\t\t\t\tParsed annotation = findAnnotation(element, Parsed.class);\n   510\t\t\t\tif (annotation != null) {\n   511\t\t\t\t\thasAnnotation = true;\n   512\t\n   513\t\t\t\t\tint index = AnnotationRegistry.getValue(element, annotation, \"index\", annotation.index());\n   514\t\n   515\t\t\t\t\tif ((index != -1 && searchName) || (index == -1 && !searchName)) {\n   516\t\t\t\t\t\treturn false;\n   517\t\t\t\t\t}\n   518\t\t\t\t}\n   519\t\t\t}\n   520\t\t\treturn hasAnnotation;\n   521\t\t}\n   522\t\n   523\t\t/**\n   524\t\t * Runs through all annotations of a given class to identify whether all annotated fields and methods\n   525\t\t * (with the {@link Parsed} annotation) are mapped to a column by index.\n   526\t\t *\n   527\t\t * @param beanClass a class whose {@link Parsed} annotations will be processed.\n   528\t\t *\n   529\t\t * @return {@code true} if every field and method annotated with {@link Parsed} in the given class maps to an index, otherwise {@code false}.\n   530\t\t */\n   531\t\tpublic static boolean allFieldsIndexBasedForParsing(Class<?> beanClass) {\n   532\t\t\treturn allFieldsIndexOrNameBased(false, beanClass, MethodFilter.ONLY_SETTERS);\n   533\t\t}\n   534\t\n   535\t\t/**\n   536\t\t * Runs through all annotations of a given class to identify whether all annotated fields and methods\n   537\t\t * (with the {@link Parsed} annotation) are mapped to a column by name.\n   538\t\t *\n   539\t\t * @param beanClass a class whose {@link Parsed} annotations will be processed.\n   540\t\t *\n   541\t\t * @return {@code true} if every field and method annotated with {@link Parsed} in the given class maps to a header name, otherwise {@code false}.\n   542\t\t */\n   543\t\tpublic static boolean allFieldsNameBasedForParsing(Class<?> beanClass) {\n   544\t\t\treturn allFieldsIndexOrNameBased(true, beanClass, MethodFilter.ONLY_SETTERS);\n   545\t\t}\n   546\t\n   547\t\n   548\t\t/**\n   549\t\t * Runs through all annotations of a given class to identify whether all annotated fields and methods\n   550\t\t * (with the {@link Parsed} annotation) are mapped to a column by index.\n   551\t\t *\n   552\t\t * @param beanClass a class whose {@link Parsed} annotations will be processed.\n   553\t\t *\n   554\t\t * @return {@code true} if every field and method annotated with {@link Parsed} in the given class maps to an index, otherwise {@code false}.\n   555\t\t */\n   556\t\tpublic static boolean allFieldsIndexBasedForWriting(Class<?> beanClass) {\n   557\t\t\treturn allFieldsIndexOrNameBased(false, beanClass, MethodFilter.ONLY_GETTERS);\n   558\t\t}\n   559\t\n   560\t\t/**\n   561\t\t * Runs through all annotations of a given class to identify whether all annotated fields and methods\n   562\t\t * (with the {@link Parsed} annotation) are mapped to a column by name.\n   563\t\t *\n   564\t\t * @param beanClass a class whose {@link Parsed} annotations will be processed.\n   565\t\t *\n   566\t\t * @return {@code true} if every field and method annotated with {@link Parsed} in the given class maps to a header name, otherwise {@code false}.\n   567\t\t */\n   568\t\tpublic static boolean allFieldsNameBasedForWriting(Class<?> beanClass) {\n   569\t\t\treturn allFieldsIndexOrNameBased(true, beanClass, MethodFilter.ONLY_GETTERS);\n   570\t\t}\n   571\t\n   572\t\t/**\n   573\t\t * Runs through all {@link Parsed} annotations of a given class to identify all indexes associated with its fields\n   574\t\t *\n   575\t\t * @param beanClass a class whose {@link Parsed} annotations will be processed.\n   576\t\t * @param filter    filter to apply over annotated methods when the class is being used for reading data from beans (to write values to an output)\n   577\t\t *                  or when writing values into beans (while parsing). It is used to choose either a \"get\" or a \"set\"\n   578\t\t *                  method annotated with {@link Parsed}, when both methods target the same field.\n   579\t\t *\n   580\t\t * @return an array of column indexes used by the given class\n   581\t\t */\n   582\t\tpublic static Integer[] getSelectedIndexes(Class<?> beanClass, MethodFilter filter) {\n   583\t\t\tList<Integer> indexes = new ArrayList<Integer>();\n   584\t\t\tfor (TransformedHeader header : getFieldSequence(beanClass, true, null, filter)) {\n   585\t\t\t\tif (header == null) {\n   586\t\t\t\t\tcontinue;\n   587\t\t\t\t}\n   588\t\t\t\tint index = header.getHeaderIndex();\n   589\t\n   590\t\t\t\tif (index != -1) {\n   591\t\t\t\t\tif (filter == MethodFilter.ONLY_GETTERS && indexes.contains(index)) { //allows the same column to be mapped to multiple fields when parsing, but not when writing.\n   592\t\t\t\t\t\tthrow new IllegalArgumentException(\"Duplicate field index '\" + index + \"' found in attribute '\" + header.getTargetName() + \"' of class \" + beanClass.getName());\n   593\t\t\t\t\t}\n   594\t\t\t\t\tindexes.add(index);\n   595\t\t\t\t}\n   596\t\t\t}\n   597\t\t\treturn indexes.toArray(new Integer[indexes.size()]);\n   598\t\t}\n   599\t\n   600\t\t/**\n   601\t\t * Runs through all {@link Parsed} annotations of a given class to identify all header names associated with its fields\n   602\t\t *\n   603\t\t * @param beanClass a class whose {@link Parsed} annotations will be processed.\n   604\t\t * @param filter    a filter to exclude annotated methods that won't be used for parsing or writing\n   605\t\t *\n   606\t\t * @return an array of column names used by the given class\n   607\t\t */\n   608\t\tpublic static String[] deriveHeaderNamesFromFields(Class<?> beanClass, MethodFilter filter) {\n   609\t\t\tList<TransformedHeader> sequence = getFieldSequence(beanClass, true, null, filter);\n   610\t\t\tList<String> out = new ArrayList<String>(sequence.size());\n   611\t\n   612\t\t\tfor (TransformedHeader field : sequence) {\n   613\t\t\t\tif (field == null) {\n   614\t\t\t\t\treturn ArgumentUtils.EMPTY_STRING_ARRAY;  // some field has an index that goes beyond list of header names, can't derive.\n   615\t\t\t\t}\n   616\t\t\t\tout.add(field.getHeaderName());\n   617\t\t\t}\n   618\t\t\treturn out.toArray(new String[out.size()]);\n   619\t\t}\n   620\t\n   621\t\t/**\n   622\t\t * Searches for a given annotation in the hierarchy of a class\n   623\t\t *\n   624\t\t * @param beanClass the class whose hierarchy will be searched\n   625\t\t * @param annotation the annotation to locate\n   626\t\t * @param <T> the type of the annotation to return\n   627\t\t * @return the annotation of the given class or its most immediate parent, or {@code null} if not found.\n   628\t\t */\n   629\t\tpublic static <T extends Annotation> T findAnnotationInClass(Class<?> beanClass, Class<T> annotation) {\n   630\t\t\tT out;\n   631\t\n   632\t\t\tClass<?> parent = beanClass;\n   633\t\t\tdo {\n   634\t\t\t\tout = parent.getAnnotation(annotation);\n   635\t\n   636\t\t\t\tif (out != null) {\n   637\t\t\t\t\treturn out;\n   638\t\t\t\t} else {\n   639\t\t\t\t\tfor (Class<?> iface : parent.getInterfaces()) {\n   640\t\t\t\t\t\tout = findAnnotationInClass(iface, annotation);\n   641\t\t\t\t\t\tif (out != null) {\n   642\t\t\t\t\t\t\treturn out;\n   643\t\t\t\t\t\t}\n   644\t\t\t\t\t}\n   645\t\t\t\t}\n   646\t\n   647\t\t\t\tparent = parent.getSuperclass();\n   648\t\t\t} while (parent != null);\n   649\t\n   650\t\t\treturn null;\n   651\t\t}\n   652\t\n   653\t\t/**\n   654\t\t * Searches for the {@link Headers} annotation in the hierarchy of a class\n   655\t\t *\n   656\t\t * @param beanClass the class whose hierarchy will be searched\n   657\t\t *\n   658\t\t * @return the {@link Headers} annotation of the given class or its most immediate parent, or {@code null} if not found.\n   659\t\t */\n   660\t\tpublic static Headers findHeadersAnnotation(Class<?> beanClass) {\n   661\t\t\treturn findAnnotationInClass(beanClass, Headers.class);\n   662\t\t}\n   663\t\n   664\t\tpublic static Class<?> getType(AnnotatedElement element) {\n   665\t\t\tif (element instanceof Field) {\n   666\t\t\t\treturn ((Field) element).getType();\n   667\t\t\t}\n   668\t\t\tMethod method = (Method) element;\n   669\t\t\tClass<?>[] params = method.getParameterTypes();\n   670\t\t\tif (params.length == 1) {\n   671\t\t\t\treturn params[0];\n   672\t\t\t} else if (params.length > 1) {\n   673\t\t\t\tthrow new IllegalArgumentException(\"Method \" + describeElement(element) + \" cannot have multiple parameters\");\n   674\t\t\t}\n   675\t\n   676\t\t\tClass<?> returnType = method.getReturnType();\n   677\t\t\tif (returnType != void.class) {\n   678\t\t\t\treturn returnType;\n   679\t\t\t}\n   680\t\t\tthrow new IllegalArgumentException(\"Method \" + describeElement(element) + \" must return a value if it has no input parameter\");\n   681\t\t}\n   682\t\n   683\t\tpublic static Class<?> getDeclaringClass(AnnotatedElement element) {\n   684\t\t\tif (element instanceof Field) {\n   685\t\t\t\treturn ((Field) element).getDeclaringClass();\n   686\t\t\t} else {\n   687\t\t\t\treturn ((Method) element).getDeclaringClass();\n   688\t\t\t}\n   689\t\t}\n   690\t\n   691\t\tpublic static String getName(AnnotatedElement element) {\n   692\t\t\tif (element instanceof Field) {\n   693\t\t\t\treturn ((Field) element).getName();\n   694\t\t\t} else {\n   695\t\t\t\treturn ((Method) element).getName();\n   696\t\t\t}\n   697\t\t}\n   698\t\n   699\t\tstatic String describeElement(AnnotatedElement element) {\n   700\t\t\tString description;\n   701\t\t\tif (element instanceof Field) {\n   702\t\t\t\tdescription = \"attribute '\" + ((Field) element).getName() + \"'\";\n   703\t\t\t} else {\n   704\t\t\t\tdescription = \"method '\" + ((Method) element).getName() + \"'\";\n   705\t\t\t}\n   706\t\t\treturn description + \" of class \" + getDeclaringClass(element).getName();\n   707\t\t}\n   708\t\n   709\t\tprivate static void processAnnotations(AnnotatedElement element, boolean processNested, List<Integer> indexes, List<TransformedHeader> tmp, Map<AnnotatedElement, List<TransformedHeader>> nestedReplacements, HeaderTransformer transformer, MethodFilter filter) {\n   710\t\t\tParsed annotation = findAnnotation(element, Parsed.class);\n   711\t\t\tif (annotation != null) {\n   712\t\t\t\tTransformedHeader header = new TransformedHeader(element, transformer);\n   713\t\n   714\t\t\t\tif (filter == MethodFilter.ONLY_GETTERS && header.getHeaderIndex() >= 0 && indexes.contains(header.getHeaderIndex())) {\n   715\t\t\t\t\t//allows the same column to be mapped to multiple fields when parsing, but not when writing.\n   716\t\t\t\t\tthrow new IllegalArgumentException(\"Duplicate field index '\" + header.getHeaderIndex() + \"' found in \" + describeElement(element));\n   717\t\t\t\t}\n   718\t\t\t\ttmp.add(header);\n   719\t\t\t\tindexes.add(header.getHeaderIndex());\n   720\t\t\t}\n   721\t\n   722\t\t\tif (processNested) {\n   723\t\t\t\tNested nested = findAnnotation(element, Nested.class);\n   724\t\t\t\tif (nested != null) {\n   725\t\t\t\t\ttmp.add(new TransformedHeader(element, null));\n   726\t\t\t\t\tClass nestedBeanType = AnnotationRegistry.getValue(element, nested, \"type\", nested.type());\n   727\t\t\t\t\tif (nestedBeanType == Object.class) {\n   728\t\t\t\t\t\tnestedBeanType = getType(element);\n   729\t\t\t\t\t}\n   730\t\n   731\t\t\t\t\tClass<? extends HeaderTransformer> transformerType = AnnotationRegistry.getValue(element, nested, \"headerTransformer\", nested.headerTransformer());\n   732\t\t\t\t\tif (transformerType != HeaderTransformer.class) {\n   733\t\t\t\t\t\tString[] args = AnnotationRegistry.getValue(element, nested, \"args\", nested.args());\n   734\t\t\t\t\t\tHeaderTransformer innerTransformer = AnnotationHelper.newInstance(HeaderTransformer.class, transformerType, args);\n   735\t\t\t\t\t\tnestedReplacements.put(element, getFieldSequence(nestedBeanType, true, indexes, innerTransformer, filter));\n   736\t\t\t\t\t} else {\n   737\t\t\t\t\t\tnestedReplacements.put(element, getFieldSequence(nestedBeanType, true, indexes, transformer, filter));\n   738\t\t\t\t\t}\n   739\t\t\t\t}\n   740\t\t\t}\n   741\t\t}\n   742\t\n   743\t\t/**\n   744\t\t * Returns a list of fields with {@link Parsed} annotations in the sequence they should be processed for parsing\n   745\t\t * or writing. The sequence is ordered taking into account their original order in the annotated class, unless\n   746\t\t * {@link Parsed#index()} is set to a non-negative number.\n   747\t\t *\n   748\t\t * @param beanClass     the class whose field sequence will be returned.\n   749\t\t * @param processNested flag indicating whether {@link Nested} annotations should be processed\n   750\t\t * @param transformer   a {@link HeaderTransformer} instance to be used for transforming headers of a given {@link Nested} attribute.\n   751\t\t * @param filter        filter to apply over annotated methods when the class is being used for reading data from beans (to write values to an output)\n   752\t\t *                      or when writing values into beans (while parsing). It is used to choose either a \"get\" or a \"set\"\n   753\t\t *                      method annotated with {@link Parsed}, when both methods target the same field.\n   754\t\t *\n   755\t\t * @return a list of fields ordered by their processing sequence\n   756\t\t */\n   757\t\tpublic static List<TransformedHeader> getFieldSequence(Class beanClass, boolean processNested, HeaderTransformer transformer, MethodFilter filter) {\n   758\t\t\tList<Integer> indexes = new ArrayList<Integer>();\n   759\t\t\tList<TransformedHeader> tmp = getFieldSequence(beanClass, processNested, indexes, transformer, filter);\n   760\t\n   761\t\t\tCollections.sort(tmp, new Comparator<TransformedHeader>() {\n   762\t\t\t\t@Override\n   763\t\t\t\tpublic int compare(TransformedHeader t1, TransformedHeader t2) {\n   764\t\t\t\t\tint i1 = t1.getHeaderIndex();\n   765\t\t\t\t\tint i2 = t2.getHeaderIndex();\n   766\t\t\t\t\treturn i1 < i2 ? -1 : (i1 == i2 ? 0 : 1);\n   767\t\t\t\t}\n   768\t\t\t});\n   769\t\t\tCollections.sort(indexes);\n   770\t\n   771\t\t\tint col = -1;\n   772\t\t\tfor (int i : indexes) {\n   773\t\t\t\tcol++;\n   774\t\t\t\tif (i < 0) {\n   775\t\t\t\t\tcontinue;\n   776\t\t\t\t}\n   777\t\t\t\tif (i != col) {\n   778\t\t\t\t\twhile (i >= tmp.size()) {\n   779\t\t\t\t\t\ttmp.add(null);\n   780\t\t\t\t\t}\n   781\t\t\t\t\tCollections.swap(tmp, i, col);\n   782\t\t\t\t}\n   783\t\t\t}\n   784\t\n   785\t\t\treturn tmp;\n   786\t\t}\n   787\t\n   788\t\tprivate static List<TransformedHeader> getFieldSequence(Class beanClass, boolean processNested, List<Integer> indexes, HeaderTransformer transformer, MethodFilter filter) {\n   789\t\t\tList<TransformedHeader> tmp = new ArrayList<TransformedHeader>();\n   790\t\n   791\t\t\tMap<AnnotatedElement, List<TransformedHeader>> nestedReplacements = new LinkedHashMap<AnnotatedElement, List<TransformedHeader>>();\n   792\t\n   793\t\t\tfor (Field field : getAllFields(beanClass).keySet()) {\n   794\t\t\t\tprocessAnnotations(field, processNested, indexes, tmp, nestedReplacements, transformer, filter);\n   795\t\t\t}\n   796\t\n   797\t\t\tfor (Method method : getAnnotatedMethods(beanClass, filter)) {\n   798\t\t\t\tprocessAnnotations(method, processNested, indexes, tmp, nestedReplacements, transformer, filter);\n   799\t\t\t}\n   800\t\n   801\t\t\tif (!nestedReplacements.isEmpty()) {\n   802\t\t\t\tint size = tmp.size();\n   803\t\t\t\tfor (int i = size - 1; i >= 0; i--) {\n   804\t\t\t\t\tTransformedHeader field = tmp.get(i);\n   805\t\t\t\t\tList<TransformedHeader> nestedFields = nestedReplacements.remove(field.getTarget());\n   806\t\t\t\t\tif (nestedFields != null) {\n   807\t\t\t\t\t\ttmp.remove(i);\n   808\t\t\t\t\t\ttmp.addAll(i, nestedFields);\n   809\t\n   810\t\t\t\t\t\tif (nestedReplacements.isEmpty()) {\n   811\t\t\t\t\t\t\tbreak;\n   812\t\t\t\t\t\t}\n   813\t\t\t\t\t}\n   814\t\t\t\t}\n   815\t\t\t}\n   816\t\t\treturn tmp;\n   817\t\t}\n   818\t\n   819\t\t/**\n   820\t\t * Returns all fields available from a given class.\n   821\t\t *\n   822\t\t * @param beanClass a class whose fields will be returned.\n   823\t\t *\n   824\t\t * @return a map of {@link Field} and the corresponding {@link PropertyWrapper}\n   825\t\t */\n   826\t\tpublic static Map<Field, PropertyWrapper> getAllFields(Class<?> beanClass) {\n   827\t\n   828\t\t\tMap<String, PropertyWrapper> properties = new LinkedHashMap<String, PropertyWrapper>();\n   829\t\t\ttry {\n   830\t\t\t\tfor (PropertyWrapper property : BeanHelper.getPropertyDescriptors(beanClass)) {\n   831\t\t\t\t\tString name = property.getName();\n   832\t\t\t\t\tif (name != null) {\n   833\t\t\t\t\t\tproperties.put(name, property);\n   834\t\t\t\t\t}\n   835\t\t\t\t}\n   836\t\t\t} catch (Exception e) {\n   837\t\t\t\t//ignore and proceed to get fields directly\n   838\t\t\t}\n   839\t\n   840\t\t\tSet<String> used = new HashSet<String>();\n   841\t\t\tClass<?> clazz = beanClass;\n   842\t\n   843\t\t\tMap<Field, PropertyWrapper> out = new LinkedHashMap<Field, PropertyWrapper>();\n   844\t\n   845\t\t\tdo {\n   846\t\t\t\tField[] declared = clazz.getDeclaredFields();\n   847\t\t\t\tfor (Field field : declared) {\n   848\t\t\t\t\tif (used.contains(field.getName())) {\n   849\t\t\t\t\t\tcontinue;\n   850\t\t\t\t\t}\n   851\t\t\t\t\tused.add(field.getName());\n   852\t\t\t\t\tout.put(field, properties.get(field.getName()));\n   853\t\t\t\t}\n   854\t\t\t\tclazz = clazz.getSuperclass();\n   855\t\t\t} while (clazz != null && clazz != Object.class);\n   856\t\t\treturn out;\n   857\t\t}\n   858\t\n   859\t\t/**\n   860\t\t * Returns all methods available from a given class that have a specific annotation.\n   861\t\t *\n   862\t\t * @param beanClass a class whose methods will be returned.\n   863\t\t * @param filter    filter to apply over annotated methods when the class is being used for reading data from beans (to write values to an output)\n   864\t\t *                  or when writing values into beans (while parsing). It is used to choose either a \"get\" or a \"set\"\n   865\t\t *                  method annotated with {@link Parsed}, when both methods target the same field.\n   866\t\t * @param annotationType the annotation type to consider\n   867\t\t *\n   868\t\t * @param <A> the expected annotation type\n   869\t\t *\n   870\t\t * @return a list of {@link Method} with at least one annotation\n   871\t\t */\n   872\t\tpublic static <A extends Annotation> List<Method> getAnnotatedMethods(Class<?> beanClass, MethodFilter filter, Class<A> annotationType) {\n   873\t\t\tList<Method> out = new ArrayList<Method>();\n   874\t\n   875\t\t\tClass clazz = beanClass;\n   876\t\n   877\t\t\tdo {\n   878\t\t\t\tMethod[] declared = clazz.getDeclaredMethods();\n   879\t\t\t\touter:\n   880\t\t\t\tfor (Method method : declared) {\n   881\t\t\t\t\tif (!method.isSynthetic() && annotationType == NO_ANNOTATIONS.class) {\n   882\t\t\t\t\t\tif (!filter.reject(method)) {\n   883\t\t\t\t\t\t\tout.add(method);\n   884\t\t\t\t\t\t}\n   885\t\t\t\t\t} else {\n   886\t\t\t\t\t\tAnnotation[] annotations = method.getDeclaredAnnotations();\n   887\t\t\t\t\t\tfor (Annotation annotation : annotations) {\n   888\t\t\t\t\t\t\tif ((annotationType == null && isCustomAnnotation(annotation)) || annotationType == annotation.annotationType()) {\n   889\t\t\t\t\t\t\t\tif (filter.reject(method)) {\n   890\t\t\t\t\t\t\t\t\tcontinue outer;\n   891\t\t\t\t\t\t\t\t}\n   892\t\t\t\t\t\t\t\tout.add(method);\n   893\t\t\t\t\t\t\t\tcontinue outer;\n   894\t\t\t\t\t\t\t}\n   895\t\t\t\t\t\t}\n   896\t\t\t\t\t}\n   897\t\t\t\t}\n   898\t\t\t\tclazz = clazz.getSuperclass();\n   899\t\t\t} while (clazz != null && clazz != Object.class);\n   900\t\t\treturn out;\n   901\t\t}\n   902\t\n   903\t\tprivate static final class NO_ANNOTATIONS implements Annotation {\n   904\t\t\t@Override\n   905\t\t\tpublic Class<? extends Annotation> annotationType() {\n   906\t\t\t\treturn NO_ANNOTATIONS.class;\n   907\t\t\t}\n   908\t\t}\n   909\t\n   910\t\t/**\n   911\t\t * Returns all methods available from a given class\n   912\t\t *\n   913\t\t * @param beanClass a class whose methods will be returned.\n   914\t\t * @param filter    filter to apply over annotated methods when the class is being used for reading data from beans (to write values to an output)\n   915\t\t *                  or when writing values into beans (while parsing). It is used to choose either a \"get\" or a \"set\"\n   916\t\t *                  method annotated with {@link Parsed}, when both methods target the same field.\n   917\t\t *\n   918\t\t * @return a list of {@link Method}s that conform to the given filter.\n   919\t\t */\n   920\t\tpublic static List<Method> getAllMethods(Class<?> beanClass, MethodFilter filter) {\n   921\t\t\treturn getAnnotatedMethods(beanClass, filter, NO_ANNOTATIONS.class);\n   922\t\t}\n   923\t\n   924\t\t/**\n   925\t\t * Returns all methods available from a given class that have an annotation.\n   926\t\t *\n   927\t\t * @param beanClass a class whose methods will be returned.\n   928\t\t * @param filter    filter to apply over annotated methods when the class is being used for reading data from beans (to write values to an output)\n   929\t\t *                  or when writing values into beans (while parsing). It is used to choose either a \"get\" or a \"set\"\n   930\t\t *                  method annotated with {@link Parsed}, when both methods target the same field.\n   931\t\t *\n   932\t\t * @return a list of {@link Method} with at least one annotation\n   933\t\t */\n   934\t\tpublic static List<Method> getAnnotatedMethods(Class<?> beanClass, MethodFilter filter) {\n   935\t\t\treturn getAnnotatedMethods(beanClass, filter, null);\n   936\t\t}\n   937\t\n   938\t\t/**\n   939\t\t * Returns all attributes available from a given class that have an annotation.\n   940\t\t *\n   941\t\t * @param beanClass a class whose methods will be returned.\n   942\t\t *\n   943\t\t * @return a list of {@link Field} with at least one annotation\n   944\t\t */\n   945\t\tpublic static List<Field> getAnnotatedFields(Class<?> beanClass) {\n   946\t\t\treturn getAnnotatedFields(beanClass, null);\n   947\t\t}\n   948\t\n   949\t\t/**\n   950\t\t * Returns all attributes available from a given class that have an annotation.\n   951\t\t *\n   952\t\t * @param beanClass a class whose methods will be returned.\n   953\t\t * @param annotationType the type of annotation to consider\n   954\t\t * @param <A> the expected annotation type\n   955\t\t *\n   956\t\t * @return a list of {@link Field} with at least one annotation\n   957\t\t */\n   958\t\tpublic static <A extends Annotation> List<Field> getAnnotatedFields(Class<?> beanClass, Class<A> annotationType) {\n   959\t\t\tList<Field> out = new ArrayList<Field>();\n   960\t\n   961\t\t\tClass clazz = beanClass;\n   962\t\n   963\t\t\tdo {\n   964\t\t\t\tField[] declared = clazz.getDeclaredFields();\n   965\t\t\t\touter:\n   966\t\t\t\tfor (Field field : declared) {\n   967\t\t\t\t\tAnnotation[] annotations = field.getDeclaredAnnotations();\n   968\t\t\t\t\tfor (Annotation annotation : annotations) {\n   969\t\t\t\t\t\tif ((annotationType == null && isCustomAnnotation(annotation)) || annotationType == annotation.annotationType()) {\n   970\t\t\t\t\t\t\tout.add(field);\n   971\t\t\t\t\t\t\tcontinue outer;\n   972\t\t\t\t\t\t}\n   973\t\t\t\t\t}\n   974\t\t\t\t}\n   975\t\t\t\tclazz = clazz.getSuperclass();\n   976\t\t\t} while (clazz != null && clazz != Object.class);\n   977\t\t\treturn out;\n   978\t\t}\n   979\t\n   980\t\t/**\n   981\t\t * Searches for an annotation of a given type that's been applied to an element either directly (as a regular annotation)\n   982\t\t * or indirectly (as a meta-annotations, i.e. an annotation that has annotations).\n   983\t\t *\n   984\t\t * @param annotatedElement the element whose annotations will be searched\n   985\t\t * @param annotationType   the type of annotation to search for\n   986\t\t * @param <A>              the type of the annotation being searched for\n   987\t\t *\n   988\t\t * @return the annotation associated with the given element, or {@code null} if not found.\n   989\t\t */\n   990\t\tpublic synchronized static <A extends Annotation> A findAnnotation(AnnotatedElement annotatedElement, Class<A> annotationType) {\n   991\t\t\tif (annotatedElement == null || annotationType == null) {\n   992\t\t\t\treturn null;\n   993\t\t\t}\n   994\t\n   995\t\t\tif (annotatedElement.equals(lastProcessedElement) && annotationType == lastProcessedAnnotationType) {\n   996\t\t\t\treturn (A) lastAnnotationFound;\n   997\t\t\t}\n   998\t\n   999\t\t\tlastProcessedElement = annotatedElement;\n  1000\t\t\tlastProcessedAnnotationType = annotationType;\n  1001\t\n  1002\t\t\tStack<Annotation> path = new Stack<Annotation>();\n  1003\t\n  1004\t\t\tA annotation = findAnnotation(annotatedElement, annotationType, new HashSet<Annotation>(), path);\n  1005\t\t\tif (annotation == null || path.i