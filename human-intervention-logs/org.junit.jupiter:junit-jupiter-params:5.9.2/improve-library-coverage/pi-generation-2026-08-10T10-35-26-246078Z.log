     819		/**
     820		 * Returns all fields available from a given class.
     821		 *
     822		 * @param beanClass a class whose fields will be returned.
     823		 *
     824		 * @return a map of {@link Field} and the corresponding {@link PropertyWrapper}
     825		 */
     826		public static Map<Field, PropertyWrapper> getAllFields(Class<?> beanClass) {
     827	
     828			Map<String, PropertyWrapper> properties = new LinkedHashMap<String, PropertyWrapper>();
     829			try {
     830				for (PropertyWrapper property : BeanHelper.getPropertyDescriptors(beanClass)) {
     831					String name = property.getName();
     832					if (name != null) {
     833						properties.put(name, property);
     834					}
     835				}
     836			} catch (Exception e) {
     837				//ignore and proceed to get fields directly
     838			}
     839	
     840			Set<String> used = new HashSet<String>();
     841			Class<?> clazz = beanClass;
     842	
     843			Map<Field, PropertyWrapper> out = new LinkedHashMap<Field, PropertyWrapper>();
     844	
     845			do {
     846				Field[] declared = clazz.getDeclaredFields();
     847				for (Field field : declared) {
     848					if (used.contains(field.getName())) {
     849						continue;
     850					}
     851					used.add(field.getName());
     852					out.put(field, properties.get(field.getName()));
     853				}
     854				clazz = clazz.getSuperclass();
     855			} while (clazz != null && clazz != Object.class);
     856			return out;
     857		}
