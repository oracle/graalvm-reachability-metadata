     653		/**
     654		 * Searches for the {@link Headers} annotation in the hierarchy of a class
     655		 *
     656		 * @param beanClass the class whose hierarchy will be searched
     657		 *
     658		 * @return the {@link Headers} annotation of the given class or its most immediate parent, or {@code null} if not found.
     659		 */
     660		public static Headers findHeadersAnnotation(Class<?> beanClass) {
     661			return findAnnotationInClass(beanClass, Headers.class);
     662		}
