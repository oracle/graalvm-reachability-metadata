     621		/**
     622		 * Searches for a given annotation in the hierarchy of a class
     623		 *
     624		 * @param beanClass the class whose hierarchy will be searched
     625		 * @param annotation the annotation to locate
     626		 * @param <T> the type of the annotation to return
     627		 * @return the annotation of the given class or its most immediate parent, or {@code null} if not found.
     628		 */
     629		public static <T extends Annotation> T findAnnotationInClass(Class<?> beanClass, Class<T> annotation) {
     630			T out;
     631	
     632			Class<?> parent = beanClass;
     633			do {
     634				out = parent.getAnnotation(annotation);
     635	
     636				if (out != null) {
     637					return out;
     638				} else {
     639					for (Class<?> iface : parent.getInterfaces()) {
     640						out = findAnnotationInClass(iface, annotation);
     641						if (out != null) {
     642							return out;
     643						}
     644					}
     645				}
     646	
     647				parent = parent.getSuperclass();
     648			} while (parent != null);
     649	
     650			return null;
     651		}
