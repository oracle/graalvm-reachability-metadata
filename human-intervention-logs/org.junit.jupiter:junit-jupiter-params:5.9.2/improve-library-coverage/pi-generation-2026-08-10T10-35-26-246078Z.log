     751		 * @param filter        filter to apply over annotated methods when the class is being used for reading data from beans (to write values to an output)
     752		 *                      or when writing values into beans (while parsing). It is used to choose either a "get" or a "set"
     753		 *                      method annotated with {@link Parsed}, when both methods target the same field.
     754		 *
     755		 * @return a list of fields ordered by their processing sequence
     756		 */
     757		public static List<TransformedHeader> getFieldSequence(Class beanClass, boolean processNested, HeaderTransformer transformer, MethodFilter filter) {
     758			List<Integer> indexes = new ArrayList<Integer>();
     759			List<TransformedHeader> tmp = getFieldSequence(beanClass, processNested, indexes, transformer, filter);
