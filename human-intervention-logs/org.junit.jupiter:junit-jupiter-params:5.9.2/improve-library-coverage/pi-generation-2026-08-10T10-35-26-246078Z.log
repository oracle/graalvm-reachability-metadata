     788		private static List<TransformedHeader> getFieldSequence(Class beanClass, boolean processNested, List<Integer> indexes, HeaderTransformer transformer, MethodFilter filter) {
     789			List<TransformedHeader> tmp = new ArrayList<TransformedHeader>();
     790	
     791			Map<AnnotatedElement, List<TransformedHeader>> nestedReplacements = new LinkedHashMap<AnnotatedElement, List<TransformedHeader>>();
     792	
     793			for (Field field : getAllFields(beanClass).keySet()) {
     794				processAnnotations(field, processNested, indexes, tmp, nestedReplacements, transformer, filter);
     795			}
     796	
     797			for (Method method : getAnnotatedMethods(beanClass, filter)) {
     798				processAnnotations(method, processNested, indexes, tmp, nestedReplacements, transformer, filter);
     799			}
     800	
     801			if (!nestedReplacements.isEmpty()) {
     802				int size = tmp.size();
     803				for (int i = size - 1; i >= 0; i--) {
     804					TransformedHeader field = tmp.get(i);
     805					List<TransformedHeader> nestedFields = nestedReplacements.remove(field.getTarget());
     806					if (nestedFields != null) {
     807						tmp.remove(i);
     808						tmp.addAll(i, nestedFields);
     809	
     810						if (nestedReplacements.isEmpty()) {
     811							break;
     812						}
     813					}
     814				}
     815			}
     816			return tmp;
     817		}
