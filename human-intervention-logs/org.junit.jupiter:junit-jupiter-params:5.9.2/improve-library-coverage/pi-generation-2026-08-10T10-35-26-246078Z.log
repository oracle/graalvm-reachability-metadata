     709		private static void processAnnotations(AnnotatedElement element, boolean processNested, List<Integer> indexes, List<TransformedHeader> tmp, Map<AnnotatedElement, List<TransformedHeader>> nestedReplacements, HeaderTransformer transformer, MethodFilter filter) {
     710			Parsed annotation = findAnnotation(element, Parsed.class);
     711			if (annotation != null) {
     712				TransformedHeader header = new TransformedHeader(element, transformer);
     713	
     714				if (filter == MethodFilter.ONLY_GETTERS && header.getHeaderIndex() >= 0 && indexes.contains(header.getHeaderIndex())) {
     715					//allows the same column to be mapped to multiple fields when parsing, but not when writing.
     716					throw new IllegalArgumentException("Duplicate field index '" + header.getHeaderIndex() + "' found in " + describeElement(element));
     717				}
     718				tmp.add(header);
     719				indexes.add(header.getHeaderIndex());
     720			}
     721	
     722			if (processNested) {
     723				Nested nested = findAnnotation(element, Nested.class);
     724				if (nested != null) {
     725					tmp.add(new TransformedHeader(element, null));
     726					Class nestedBeanType = AnnotationRegistry.getValue(element, nested, "type", nested.type());
     727					if (nestedBeanType == Object.class) {
     728						nestedBeanType = getType(element);
     729					}
     730	
     731					Class<? extends HeaderTransformer> transformerType = AnnotationRegistry.getValue(element, nested, "headerTransformer", nested.headerTransformer());
     732					if (transformerType != HeaderTransformer.class) {
     733						String[] args = AnnotationRegistry.getValue(element, nested, "args", nested.args());
     734						HeaderTransformer innerTransformer = AnnotationHelper.newInstance(HeaderTransformer.class, transformerType, args);
     735						nestedReplacements.put(element, getFieldSequence(nestedBeanType, true, indexes, innerTransformer, filter));
     736					} else {
     737						nestedReplacements.put(element, getFieldSequence(nestedBeanType, true, indexes, transformer, filter));
     738					}
     739				}
     740			}
     741		}
     742	
     743		/**
     744		 * Returns a list of fields with {@link Parsed} annotations in the sequence they should be processed for parsing
     745		 * or writing. The sequence is ordered taking into account their original order in the annotated class, unless
     746		 * {@link Parsed#index()} is set to a non-negative number.
     747		 *
     748		 * @param beanClass     the class whose field sequence will be returned.
     749		 * @param processNested flag indicating whether {@link Nested} annotations should be processed
     750		 * @param transformer   a {@link HeaderTransformer} instance to be used for transforming headers of a given {@link Nested} attribute.
     751		 * @param filter        filter to apply over annotated methods when the class is being used for reading data from beans (to write values to an output)
     752		 *                      or when writing values into beans (while parsing). It is used to choose either a "get" or a "set"
     753		 *                      method annotated with {@link Parsed}, when both methods target the same field.
     754		 *
     755		 * @return a list of fields ordered by their processing sequence
     756		 */
     757		public static List<TransformedHeader> getFieldSequence(Class beanClass, boolean processNested, HeaderTransformer transformer, MethodFilter filter) {
     758			List<Integer> indexes = new ArrayList<Integer>();
     759			List<TransformedHeader> tmp = getFieldSequence(beanClass, processNested, indexes, transformer, filter);
     760	
     761			Collections.sort(tmp, new Comparator<TransformedHeader>() {
     762				@Override
     763				public int compare(TransformedHeader t1, TransformedHeader t2) {
     764					int i1 = t1.getHeaderIndex();
     765					int i2 = t2.getHeaderIndex();
     766					return i1 < i2 ? -1 : (i1 == i2 ? 0 : 1);
     767				}
     768			});
     769			Collections.sort(indexes);
     770	
     771			int col = -1;
     772			for (int i : indexes) {
     773				col++;
     774				if (i < 0) {
     775					continue;
     776				}
     777				if (i != col) {
     778					while (i >= tmp.size()) {
     779						tmp.add(null);
     780					}
     781					Collections.swap(tmp, i, col);
     782				}
     783			}
     784	
     785			return tmp;
     786		}
     787	
     788		private static List<TransformedHeader> getFieldSequence(Class beanClass, boolean processNested, List<Integer> indexes, HeaderTransformer transformer, MethodFilter filter) {
     789			List<TransformedHeader> tmp = new ArrayList<TransformedHeader>();
     790	
     791			Map<AnnotatedElement, List<TransformedHeader>> nestedReplacements = new LinkedHashMap<AnnotatedElement, List<TransformedHeader>>();
     792	
     793			for (Field field : getAllFields(beanClass).keySet()) {
     794				processAnnotations(field, processNested, indexes, tmp, nestedReplacements, transformer, filter);
     795			}
     796	
     797			for (Method method : getAnnotatedMethods(beanClass, filter)) {
     798				processAnnotations(method, processNested, indexes, tmp, nestedReplacements, transformer, filter);
     799			}
     800	
     801			if (!nestedReplacements.isEmpty()) {
     802				int size = tmp.size();
     803				for (int i = size - 1; i >= 0; i--) {
     804					TransformedHeader field = tmp.get(i);
     805					List<TransformedHeader> nestedFields = nestedReplacements.remove(field.getTarget());
     806					if (nestedFields != null) {
     807						tmp.remove(i);
     808						tmp.addAll(i, nestedFields);
     809	
     810						if (nestedReplacements.isEmpty()) {
     811							break;
     812						}
     813					}
     814				}
     815			}
     816			return tmp;
     817		}
