     709		private static void processAnnotations(AnnotatedElement element, boolean processNested, List<Integer> indexes, List<TransformedHeader> tmp, Map<AnnotatedElement, List<TransformedHeader>> nestedReplacements, HeaderTransformer transformer, MethodFilter filter) {
     710			Parsed annotation = findAnnotation(element, Parsed.class);
     711			if (annotation != null) {
     712				TransformedHeader header = new TransformedHeader(element, transformer);
     713	
     714				if (filter == MethodFilter.ONLY_GETTERS && header.getHeaderIndex() >= 0 && indexes.contains(header.getHeaderIndex())) {
     715					//allows the same column to be mapped to multiple fields when parsing, but not when writing.
     716					throw new IllegalArgumentException("Duplicate field index '" + header.getHeaderIndex() + "' found in " + describeElement(element));
     717				}
     718				tmp.add(header);
     719				indexes.add(header.getHeaderIndex());
     720			}
     721	
     722			if (processNested) {
     723				Nested nested = findAnnotation(element, Nested.class);
     724				if (nested != null) {
     725					tmp.add(new TransformedHeader(element, null));
     726					Class nestedBeanType = AnnotationRegistry.getValue(element, nested, "type", nested.type());
     727					if (nestedBeanType == Object.class) {
     728						nestedBeanType = getType(element);
     729					}
     730	
     731					Class<? extends HeaderTransformer> transformerType = AnnotationRegistry.getValue(element, nested, "headerTransformer", nested.headerTransformer());
     732					if (transformerType != HeaderTransformer.class) {
     733						String[] args = AnnotationRegistry.getValue(element, nested, "args", nested.args());
     734						HeaderTransformer innerTransformer = AnnotationHelper.newInstance(HeaderTransformer.class, transformerType, args);
     735						nestedReplacements.put(element, getFieldSequence(nestedBeanType, true, indexes, innerTransformer, filter));
     736					} else {
     737						nestedReplacements.put(element, getFieldSequence(nestedBeanType, true, indexes, transformer, filter));
     738					}
     739				}
     740			}
     741		}
