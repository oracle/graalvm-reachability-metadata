     664		public static Class<?> getType(AnnotatedElement element) {
     665			if (element instanceof Field) {
     666				return ((Field) element).getType();
     667			}
     668			Method method = (Method) element;
     669			Class<?>[] params = method.getParameterTypes();
     670			if (params.length == 1) {
     671				return params[0];
     672			} else if (params.length > 1) {
     673				throw new IllegalArgumentException("Method " + describeElement(element) + " cannot have multiple parameters");
     674			}
