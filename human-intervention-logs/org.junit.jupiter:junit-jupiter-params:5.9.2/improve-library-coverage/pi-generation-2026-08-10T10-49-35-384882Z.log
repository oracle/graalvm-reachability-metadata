  package org_junit_jupiter.junit_jupiter_params;
  
  import static org.assertj.core.api.Assertions.assertThat;
  
  import java.io.StringReader;
  import java.lang.annotation.ElementType;
  import java.lang.annotation.Retention;
  import java.lang.annotation.RetentionPolicy;
  import java.lang.annotation.Target;
  import java.lang.reflect.Field;
  import java.math.BigDecimal;
  import java.util.List;
  
  import org.junit.jupiter.api.Test;
  import org.junit.jupiter.params.shadow.com.univocity.parsers.annotations.Copy;
  import org.junit.jupiter.params.shadow.com.univocity.parsers.annotations.Format;
  import org.junit.jupiter.params.shadow.com.univocity.parsers.annotations.HeaderTransformer;
  import org.junit.jupiter.params.shadow.com.univocity.parsers.annotations.Nested;
  import org.junit.jupiter.params.shadow.com.univocity.parsers.annotations.Parsed;
  import org.junit.jupiter.params.shadow.com.univocity.parsers.annotations.helpers.AnnotationHelper;
  import org.junit.jupiter.params.shadow.com.univocity.parsers.csv.CsvRoutines;
  
  public class AnnotationHelperTest {
  
      @Test
      void parsesBeansUsingFieldsSettersAndComposedAnnotations() {
          CsvRoutines routines = new CsvRoutines();
  
          List<FormattedRecord> records = routines.parseAll(
                  FormattedRecord.class, new StringReader("Ada,12.50,active\n"));
  
          assertThat(records).singleElement().satisfies(record -> {
              assertThat(record.name).isEqualTo("Ada");
              assertThat(record.amount).isEqualByComparingTo("12.50");
              assertThat(record.status).isEqualTo("active");
          });
          assertThat(AnnotationHelper.getAnnotatedFields(FormattedRecord.class))
                  .extracting(field -> field.getName())
                  .contains("amount");
      }
  
      @Test
      void parsesNestedBeansWithCustomHeaderTransformers() {
          CsvRoutines routines = new CsvRoutines();
  
          List<ArgumentTransformerRecord> argumentRecords = routines.parseAll(
                  ArgumentTransformerRecord.class, new StringReader("Ada\n"));
          List<DefaultTransformerRecord> defaultRecords = routines.parseAll(
                  DefaultTransformerRecord.class, new StringReader("Grace\n"));
  
          assertThat(argumentRecords).singleElement().satisfies(record ->
                  assertThat(record.person.name).isEqualTo("Ada"));
          assertThat(defaultRecords).singleElement().satisfies(record ->
                  assertThat(record.person.name).isEqualTo("Grace"));
      }
  
      @Retention(RetentionPolicy.RUNTIME)
      @Target({ElementType.FIELD, ElementType.METHOD})
      @Parsed
      public @interface CopiedParsed {
  
          @Copy(to = Parsed.class)
          String field() default "";
  
          @Copy(to = Parsed.class, property = "index")
          int column() default -1;
      }
  
      public static class FormattedRecord {
  
          @CopiedParsed(field = "name", column = 0)
          String name;
  
          @Parsed(index = 1)
          @Format(formats = "#0.00", options = "decimalSeparator=.")
          BigDecimal amount;
  
          String status;
  
          @Parsed(index = 2)
          public void setStatus(String status) {
              this.status = status;
          }
      }
  
      public static class ArgumentTransformerRecord {
  
          @Nested(type = Person.class, headerTransformer = PrefixTransformer.class, args = "person_")
          Person person;
      }
  
      public static class DefaultTransformerRecord {
  
          @Nested(type = Person.class, headerTransformer = DefaultTransformer.class)
          Person person;
      }
  
      public static class Person {
  
          @Parsed(index = 0)
          String name;
      }
  
      public static class PrefixTransformer extends HeaderTransformer {
  
          private final String prefix;
  
          public PrefixTransformer(String[] args) {
              this.prefix = args[0];
          }
  
          @Override
          public String transformName(Field field, String name) {
              return prefix + name;
          }
      }
  
      public static class DefaultTransformer extends HeaderTransformer {
      }
  }
