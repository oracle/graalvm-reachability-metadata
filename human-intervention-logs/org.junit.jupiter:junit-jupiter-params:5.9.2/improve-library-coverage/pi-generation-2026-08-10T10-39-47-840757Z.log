nivocity.parsers.csv.CsvRoutines;\n\npublic class AnnotationHelperTest {\n\n    @Test\n    void parsesBeansUsingFieldsSettersAndComposedAnnotations() {\n        CsvRoutines routines = new CsvRoutines();\n\n        List<FormattedRecord> records = routines.parseAll(\n                FormattedRecord.class, new StringReader(\"Ada,12.50,active\\n\"));\n\n        assertThat(records).singleElement().satisfies(record -> {\n            assertThat(record.name).isEqualTo(\"Ada\");\n            assertThat(record.amount).isEqualByComparingTo(\"12.50\");\n            assertThat(record.status).isEqualTo(\"active\");\n        });\n        assertThat(AnnotationHelper.getAnnotatedFields(FormattedRecord.class))\n                .extracting(field -> field.getName())\n                .contains(\"amount\");\n    }\n\n    @Test\n    void parsesNestedBeansWithCustomHeaderTransformers() {\n        CsvRoutines routines = new CsvRoutines();\n\n        List<ArgumentTransformerRecord> argumentRecords = routines.parseAll(\n                ArgumentTransformerRecord.class, new StringReader(\"Ada\\n\"));\n        List<DefaultTransformerRecord> defaultRecords = routines.parseAll(\n                DefaultTransformerRecord.class, new StringReader(\"Grace\\n\"));\n\n        assertThat(argumentRecords).singleElement().satisfies(record ->\n                assertThat(record.person.name).isEqualTo(\"Ada\"));\n        assertThat(defaultRecords).singleElement().satisfies(record ->\n                assertThat(record.person.name).isEqualTo(\"Grace\"));\n    }\n\n    @Retention(RetentionPolicy.RUNTIME)\n    @Target({ElementType.FIELD, ElementType.METHOD})\n    @Parsed\n    public @interface CopiedParsed {\n\n        @Copy(to = Parsed.class)\n        String field() default \"\";\n\n        @Copy(to = Parsed.class, property = \"index\")\n        int column() default -1;\n    }\n\n    public static class FormattedRecord {\n\n        @CopiedParsed(field = \"name\", column = 0)\n        String name;\n\n        @Parsed(index = 1)\n        @Format(formats = \"#0.00\", options = \"decimalSeparator=.\")\n        BigDecimal amount;\n\n        String status;\n\n        @Parsed(index = 2)\n        public void setStatus(String status) {\n            this.status = status;\n        }\n    }\n\n    public static class ArgumentTransformerRecord {\n\n        @Nested(type = Person.class, headerTransformer = PrefixTransformer.class, args = \"person_\")\n        Person person;\n    }\n\n    public static class DefaultTransformerRecord {\n\n        @Nested(type = Person.class, headerTransformer = DefaultTransformer.class)\n        Person person;\n    }\n\n    public static class Person {\n\n        @Parsed(index = 0)\n        String name;\n    }\n\n    public static class PrefixTransformer extends HeaderTransformer {\n\n        private final String prefix;\n\n        public PrefixTransformer(String[] args) {\n            this.prefix = args[0];\n        }\n\n        @Override\n        public String transformName(Field field, String name) {\n            return prefix + name;\n        }\n    }\n\n    public static class DefaultTransformer extends HeaderTransformer {\n    }\n}\n"}], "isError": false, "timestamp": 1786358323196}, {"role": "toolResult", "toolCallId": "call_Ymt6f0GaUv4Bd6lvHymKSCJn|fc_0ca108e7b356816c016a79aa1496048191ba85d08272f81b37", "toolName": "bash", "content": [{"type": "text", "text": "/home/mihailo/.gradle/caches/modules-2/files-2.1/org.junit.jupiter/junit-jupiter-params/5.9.2/bc2765afb7b85b583c710dd259a11c6b8c39e912/junit-jupiter-params-5.9.2.jar\n\n\nCommand timed out after 30 seconds"}], "details": {}, "isError": true, "timestamp": 1786358323196}]}
