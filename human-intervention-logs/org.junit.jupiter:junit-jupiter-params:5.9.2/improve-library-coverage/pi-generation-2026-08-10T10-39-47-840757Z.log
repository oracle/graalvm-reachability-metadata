vocity.parsers.conversions.EnumSelector;\n\npublic class EnumConversionTest {\n\n    @Test\n    void convertsEnumsUsingCustomFields() {\n        EnumConversion<FieldValue> conversion = new EnumConversion<>(\n                FieldValue.class, \"code\", EnumSelector.CUSTOM_FIELD);\n\n        assertThat(conversion.execute(\"first-code\")).isEqualTo(FieldValue.FIRST);\n        assertThat(conversion.revert(FieldValue.SECOND)).isEqualTo(\"second-code\");\n    }\n\n    @Test\n    void convertsEnumsUsingCustomMethodsWithInput() {\n        EnumConversion<MethodValue> conversion = new EnumConversion<>(\n                MethodValue.class, \"fromCode\", EnumSelector.CUSTOM_METHOD);\n\n        assertThat(conversion.execute(\"second-code\")).isEqualTo(MethodValue.SECOND);\n    }\n\n    @Test\n    void convertsEnumsUsingCustomMethodsWithoutInput() {\n        EnumConversion<SingletonMethodValue> conversion = new EnumConversion<>(\n                SingletonMethodValue.class, \"selected\", EnumSelector.CUSTOM_METHOD);\n\n        assertThat(conversion.execute(\"ONLY\")).isEqualTo(SingletonMethodValue.ONLY);\n        assertThat(conversion.revert(SingletonMethodValue.ONLY)).isEqualTo(\"ONLY\");\n    }\n\n    private enum FieldValue {\n        FIRST(\"first-code\"),\n        SECOND(\"second-code\");\n\n        private final String code;\n\n        FieldValue(String code) {\n            this.code = code;\n        }\n    }\n\n    private enum MethodValue {\n        FIRST,\n        SECOND;\n\n        public static MethodValue fromCode(String code) {\n            return \"first-code\".equals(code) ? FIRST : SECOND;\n        }\n    }\n\n    private enum SingletonMethodValue {\n        ONLY;\n\n        public static SingletonMethodValue selected() {\n            return ONLY;\n        }\n    }\n}\n"}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-terra", "usage": {"input": 3980, "output": 1493, "cacheRead": 33280, "cacheWrite": 0, "totalTokens": 38753, "cost":