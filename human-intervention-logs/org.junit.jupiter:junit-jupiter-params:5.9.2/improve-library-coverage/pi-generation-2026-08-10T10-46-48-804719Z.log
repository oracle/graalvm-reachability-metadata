e).hasSize(length);\n    }\n\n    public static class WordArgumentsProvider implements ArgumentsProvider {\n\n        @Override\n        public Stream<? extends Arguments> provideArguments(ExtensionContext context) {\n            return Stream.of(\n                    Arguments.of(\"jupiter\", 7),\n                    Arguments.of(\"params\", 6));\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1786358771015}, {"role": "toolResult", "toolCallId": "call_IPtWsia1LNPHEMM3g8BkbzRz|fc_0bd7f837ec26a7d4016a79abf256708191aa9569f39000b96b", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_junit_jupiter.junit_jupiter_params;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.io.StringReader;\nimport java.lang.annotation.ElementType;\nimport java.lang.annotation.Retention;\nimport java.lang.annotation.RetentionPolicy;\nimport java.lang.annotation.Target;\nimport java.lang.reflect.Field;\nimport java.math.BigDecimal;\nimport java.util.List;\n\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.params.shadow.com.univocity.parsers.annotations.Copy;\nimport org.junit.jupiter.params.shadow.com.univocity.parsers.annotations.Format;\nimport org.junit.jupiter.params.shadow.com.univocity.parsers.annotations.HeaderTransformer;\nimport org.junit.jupiter.params.shadow.com.univocity.parsers.annotations.Nested;\nimport org.junit.jupiter.params.shadow.com.univocity.parsers.annotations.Parsed;\nimport org.junit.jupiter.params.shadow.com.univocity.parsers.annotations.helpers.AnnotationHelper;\nimport org.junit.jupiter.params.shadow.com.univocity.parsers.csv.CsvRoutines;\n\npublic class AnnotationHelperTest {\n\n    @Test\n    void parsesBeansUsingFieldsSettersAndComposedAnnotations() {\n        CsvRoutines routines = new CsvRoutines();\n\n        List<FormattedRecord> records = routines.parseAll(\n                FormattedRecord.class, new StringReader(\"Ada,12.50,active\\n\"));\n\n        assertThat(records).singleElement().satisfies(record -> {\n            assertThat(record.name).isEqualTo(\"Ada\");\n            assertThat(record.amount).isEqualByComparingTo(\"12.50\");\n            assertThat(record.status).isEqualTo(\"active\");\n        });\n        assertThat(AnnotationHelper.getAnnotatedFields(FormattedRecord.class))\n                .extracting(field -> field.getName())\n                .contains(\"amount\");\n    }\n\n    @Test\n    void parsesNestedBeansWithCustomHeaderTransformers() {\n        CsvRoutines routines = new CsvRoutines();\n\n        List<ArgumentTransformerRecord> argumentRecords = routines.parseAll(\n                ArgumentTransformerRecord.class, new StringReader(\"Ada\\n\"));\n        List<DefaultTransformerRecord> defaultRecords = routines.parseAll(\n                DefaultTransformerRecord.class, new StringReader(\"Grace\\n\"));\n\n        assertThat(argumentRecords).singleElement().satisfies(record ->\n                assertThat(record.person.name).isEqualTo(\"Ada\"));\n        assertThat(defaultRecords).singleElement().satisfies(record ->\n                assertThat(record.person.name).isEqualTo(\"Grace\"));\n    }\n\n    @Retention(RetentionPolicy.RUNTIME)\n    @Target({ElementType.FIELD, ElementType.METHOD})\n    @Parsed\n    public @interface CopiedParsed {\n\n        @Copy(to = Parsed.class)\n        String field() default \"\";\n\n        @Copy(to = Parsed.class, property = \"index\")\n        int column() default -1;\n    }\n\n    public static class FormattedRecord {\n\n        @CopiedParsed(field = \"name\", column = 0)\n        String name;\n\n        @Parsed(index = 1)\n        @Format(formats = \"#0.00\", options = \"decimalSeparator=.\")\n        BigDecimal amount;\n\n        String status;\n\n        @Parsed(index = 2)\n        public void setStatus(String status) {\n            this.status = status;\n        }\n    }\n\n    public static class ArgumentTransformerRecord {\n\n        @Nested(type = Person.class, headerTransformer = PrefixTransformer.class, args = \"person_\")\n        Person person;\n    }\n\n    public static class DefaultTransformerRecord {\n\n        @Nested(type = Person.class, headerTransformer = DefaultTransformer.class)\n        Person person;\n    }\n\n    public static class Person {\n\n        @Parsed(index = 0)\n        String name;\n    }\n\n    public static class PrefixTransformer extends HeaderTransformer {\n\n        private final String prefix;\n\n        public PrefixTransformer(String[] args) {\n            this.prefix = args[0];\n        }\n\n        @Override\n        public String transformName(Field field, String name) {\n            return prefix + name;\n        }\n    }\n\n    public static class DefaultTransformer extends HeaderTransformer {\n    }\n}\n"}], "isError": false, "timestamp": 1786358771016}, {"role": "toolResult", "toolCallId": "call_CpIiukRGydXe0AzsjhtJ1ebJ|fc_0bd7f837ec26a7d4016a79abf256788191b869720a50660bf3", "toolName": "bash", "content": [{"type": "text", "text": " M metadata/org.junit.jupiter/junit-jupiter-params/index.json\n?? metadata/org.junit.jupiter/junit-jupiter-params/index.json.orig\n"}], "isError": false, "timestamp": 1786358771016}]}
