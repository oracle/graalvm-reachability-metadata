seId);\n        assertThat(httpClient.requests().get(0).getHeaders().getValue(\"x-ms-lease-duration\"))\n                .isEqualTo(\"15\");\n        assertThat(httpClient.requests().get(0).getHeaders().getValue(\"x-ms-proposed-lease-id\"))\n                .isEqualTo(proposedLeaseId);\n        assertLeaseRequest(httpClient.requests().get(1), \"renew\", proposedLeaseId);\n        assertLeaseRequest(httpClient.requests().get(2), \"change\", proposedLeaseId);\n        assertThat(httpClient.requests().get(2).getHeaders().getValue(\"x-ms-proposed-lease-id\"))\n                .isEqualTo(changedLeaseId);\n        assertLeaseRequest(httpClient.requests().get(3), \"release\", changedLeaseId);\n    }\n\n    @Test\n    void generatesSignedSasAndMapsStorageErrors() {"},{"oldText":"    private static String decodedQuery(HttpRequest request) {\n        String query = request.getUrl().getQuery();\n        return query == null ? \"\" : URLDecoder.decode(query, UTF_8);\n    }\n\n    private static String encodedBlobPath() {","newText":"    private static String decodedQuery(HttpRequest request) {\n        String query = request.getUrl().getQuery();\n        return query == null ? \"\" : URLDecoder.decode(query, UTF_8);\n    }\n\n    private static void assertLeaseRequest(HttpRequest request, String action, String leaseId) {\n        assertRequest(request, HttpMethod.PUT, encodedBlobPath(), \"comp=lease\");\n        assertThat(request.getHeaders().getValue(\"x-ms-lease-action\")).isEqualTo(action);\n        assertThat(request.getHeaders().getValue(\"x-ms-lease-id\")).isEqualTo(leaseId);\n    }\n\n    private static String encodedBlobPath() {"}]}
