ading, and managing blob containers and block, append, and page blobs in Azure Blob Storage. It supports operations such as uploading and downloading data, managing metadata and access tiers, generating SAS tokens, and handling leases and snapshots.\",\ntests/src/com.azure/azure-data-appconfiguration/1.8.4/src/test/java/com_azure/azure_data_appconfiguration/AzureDataAppConfigurationTest.java:116:              \"etag\": \"snapshot-etag\"\ntests/src/com.azure/azure-data-appconfiguration/1.8.4/src/test/java/com_azure/azure_data_appconfiguration/AzureDataAppConfigurationTest.java:188:        SnapshotSelector snapshotSelector = new SnapshotSelector()\ntests/src/com.azure/azure-data-appconfiguration/1.8.4/src/test/java/com_azure/azure_data_appconfiguration/AzureDataAppConfigurationTest.java:197:        List<ConfigurationSnapshot> snapshots = new ArrayList<>();\ntests/src/com.azure/azure-data-appconfiguration/1.8.4/src/test/java/com_azure/azure_data_appconfiguration/AzureDataAppConfigurationTest.java:198:        client.listSnapshots(snapshotSelector).forEach(snapshots::add);\ntests/src/com.azure/azure-data-appconfiguration/1.8.4/src/test/java/com_azure/azure_data_appconfiguration/AzureDataAppConfigurationTest.java:203:        assertThat(snapshots).hasSize(1);\ntests/src/com.azure/azure-data-appconfiguration/1.8.4/src/test/java/com_azure/azure_data_appconfiguration/AzureDataAppConfigurationTest.java:204:        assertSnapshot(snapshots.get(0));\ntests/src/com.azure/azure-data-appconfiguration/1.8.4/src/test/java/com_azure/azure_data_appconfiguration/AzureDataAppConfigurationTest.java:212:        assertThat(httpClient.requests().get(2).getUrl().getPath()).isEqualTo(\"/snapshots\");\ntests/src/com.azure/azure-data-appconfiguration/1.8.4/src/test/java/com_azure/azure_data_appconfiguration/AzureDataAppConfigurationTest.java:275:        assertRequest(httpClient.requests().get(0), HttpMethod.PATCH, \"/snapshots/production-release\");\ntests/src/com.azure/azure-data-appconfiguration/1.8.4/src/test/java/com_azure/azure_data_appconfiguration/AzureDataAppConfigurationTest.java:276:        assertRequest(httpClient.requests().get(1), HttpMethod.PATCH, \"/snapshots/production-release\");\ntests/src/com.azure/azure-data-appconfiguration/1.8.4/src/test/java/com_azure/azure_data_appconfiguration/AzureDataAppConfigurationTest.java:281:        RecordingHttpClient snapshotHttpClient = new RecordingHttpClient(SNAPSHOT_RESPONSE);\ntests/src/com.azure/azure-data-appconfiguration/1.8.4/src/test/java/com_azure/azure_data_appconfiguration/AzureDataAppConfigurationTest.java:282:        ConfigurationClient client = newClient(snapshotHttpClient);\ntests/src/com.azure/azure-data-appconfiguration/1.8.4/src/test/java/com_azure/azure_data_appconfiguration/AzureDataAppConfigurationTest.java:284:        ConfigurationSnapshot snapshot = client.getSnapshot(\"production-release\");\ntests/src/com.azure/azure-data-appconfiguration/1.8.4/src/test/java/com_azure/azure_data_appconfiguration/AzureDataAppConfigurationTest.java:286:        assertSnapshot(snapshot);\ntests/src/com.azure/azure-data-appconfiguration/1.8.4/src/test/java/com_azure/azure_data_appconfiguration/AzureDataAppConfigurationTest.java:287:        assertRequest(snapshotHttpClient.requests().get(0), HttpMethod.GET, \"/snapshots/production-release\");\ntests/src/com.azure/azure-data-appconfiguration/1.8.4/src/test/java/com_azure/azure_data_appconfiguration/AzureDataAppConfigurationTest.java:331:    private static void assertSnapshot(ConfigurationSnapshot snapshot) {\ntests/src/com.azure/azure-data-appconfiguration/1.8.4/src/test/java/com_azure/azure_data_appconfiguration/AzureDataAppConfigurationTest.java:332:        assertThat(snapshot).isNotNull();\ntests/src/com.azure/azure-data-appconfiguration/1.8.4/src/test/java/com_azure/azure_data_appconfiguration/AzureDataAppConfigurationTest.java:333:        assertThat(snapshot.getName()).isEqualTo(\"production-release\");\ntests/src/com.azure/azure-data-appconfiguration/1.8.4/src/test/java/com_azure/azure_data_appconfiguration/AzureDataAppConfigurationTest.java:334:        assertThat(snapshot.getStatus()).isEqualTo(ConfigurationSnapshotStatus.READY);\ntests/src/com.azure/azure-data-appconfiguration/1.8.4/src/test/java/com_azure/azure_data_appconfiguration/AzureDataAppConfigurationTest.java:335:        assertThat(snapshot.getSnapshotComposition()).isEqualTo(SnapshotComposition.KEY_LABEL);\ntests/src/com.azure/azure-data-appconfiguration/1.8.4/src/test/java/com_azure/azure_data_appconfiguration/AzureDataAppConfigurationTest.java:336:        assertThat(snapshot.getRetentionPeriod()).isEqualTo(Duration.ofDays(30));\ntests/src/com.azure/azure-data-appconfiguration/1.8.4/src/test/java/com_azure/azure_data_appconfiguration/AzureDataAppConfigurationTest.java:337:        assertThat(snapshot.getSizeInBytes()).isEqualTo(512L);\ntests/src/com.azure/azure-data-appconfiguration/1.8.4/src/test/java/com_azure/azure_data_appconfiguration/AzureDataAppConfigurationTest.java:338:        assertThat(snapshot.getItemCount()).isEqualTo(2L);\ntests/src/com.azure/azure-data-appconfiguration/1.8.4/src/test/java/com_azure/azure_data_appconfiguration/AzureDataAppConfigurationTest.java:339:        assertThat(snapshot.getFilters()).hasSize(1);\ntests/src/com.azure/azure-data-appconfiguration/1.8.4/src/test/java/com_azure/azure_data_appconfiguration/AzureDataAppConfigurationTest.java:340:        assertThat(snapshot.getFilters().get(0).getKey()).isEqualTo(\"app:*\");\ntests/src/com.azure/azure-data-appconfiguration/1.8.4/src/test/java/com_azure/azure_data_appconfiguration/AzureDataAppConfigurationTest.java:341:        assertThat(snapshot.getTags()).containsEntry(\"release\", \"may\");\n"}], "isError": false, "timestamp": 1791820547917}]}
