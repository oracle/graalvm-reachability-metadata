              }
              """.formatted(asJsonString(FEATURE_FLAG_VALUE));
      private static final String SECRET_REFERENCE_RESPONSE = """
              {
                "key": "database:password",
                "label": "production",
                "content_type": "application/vnd.microsoft.appconfig.keyvaultref+json;charset=utf-8",
                "value": "%s",
