rsedStatementTest {\n    35\t\n    36\t    private static final String USERNAME = \"fred\";\n    37\t\n    38\t    private static final String PASSWORD = \"secret\";\n    39\t\n    40\t    private static final String DATABASE = \"test\";\n    41\t\n    42\t    private static final String JDBC_URL =\n    43\t            \"jdbc:postgresql://localhost/\" + DATABASE + \"?connectTimeout=10&socketTimeout=10\";\n    44\t\n    45\t    private static Process process;\n    46\t\n    47\t    @BeforeAll\n    48\t    static void beforeAll() throws IOException {\n    49\t        System.out.println(\"Starting PostgreSQL ...\");\n    50\t        process = new ProcessBuilder(\n    51\t                \"docker\", \"run\", \"--rm\", \"-p\", \"5432:5432\", \"-e\", \"POSTGRES_DB=\" + DATABASE, \"-e\", \"POSTGRES_USER=\" + USERNAME,\n    52\t                \"-e\", \"POSTGRES_PASSWORD=\" + PASSWORD, \"postgres:18-alpine\").redirectOutput(new File(\"postgres-stdout.txt\"))\n    53\t                .redirectError(new File(\"postgres-stderr.txt\")).start();\n    54\t\n    55\t        // Wait until connection can be established\n    56\t        Awaitility.await().atMost(Duration.ofSeconds(50)).ignoreExceptions().until(() -> {\n    57\t            getDataSource().getConnection().close();\n    58\t            return true;\n    59\t        });\n    60\t        System.out.println(\"PostgreSQL started\");\n    61\t    }\n    62\t\n    63\t    @AfterAll\n    64\t    static void tearDown() throws InterruptedException {\n    65\t        if (process != null && process.isAlive()) {\n    66\t            System.out.println(\"Shutting down PostgreSQL\");\n    67\t            process.destroy();\n    68\t            if (!process.waitFor(10, TimeUnit.SECONDS)) {\n    69\t                process.destroyForcibly();\n    70\t                assertThat(process.waitFor(10, TimeUnit.SECONDS)).isTrue();\n    71\t            }\n    72\t        }\n    73\t    }\n    74\t\n    75\t    @Test\n    76\t    @Timeout(55)\n    77\t    void migratesCopyFromStdinData() throws SQLException {\n    78\t        DataSource dataSource = getDataSource();\n    79\t\n    80\t        Configuration configuration = new FluentConfiguration()\n    81\t                .dataSource(dataSource)\n    82\t                .encoding(StandardCharsets.UTF_8)\n    83\t                .resourceProvider(new FixedResourceProvider());\n    84\t        configuration.getPluginRegister()\n    85\t                .getPlugin(PostgreSQLConfigurationExtension.class)\n    86\t                .setTransactionalLock(false);\n    87\t\n    88\t        Flyway flyway = new Flyway(configuration);\n    89\t        PostgreSQLConfigurationExtension copiedExtension = flyway.getConfiguration()\n    90\t                .getPluginRegister()\n    91\t                .getPlugin(PostgreSQLConfigurationExtension.class);\n    92\t        assertThat(copiedExtension.isTransactionalLock()).isFalse();\n    93\t\n    94\t        MigrateResult migration = flyway.migrate();\n    95\t\n    96\t        assertThat(migration.success).isTrue();\n    97\t        assertThat(migration.migrationsExecuted).isEqualTo(2);\n    98\t        try (Connection connection = dataSource.getConnection();\n    99\t                Statement statement = connection.createStatement();\n   100\t                ResultSet rows = statement.executeQuery(\"SELECT id, title, name FROM test ORDER BY id\")) {\n   101\t            assertThat(rows.next()).isTrue();\n   102\t            assertThat(rows.getInt(\"id\")).isEqualTo(1);\n   103\t            assertThat(rows.getString(\"title\")).isEqualTo(\"first\");\n   104\t            assertThat(rows.getInt(\"name\")).isEqualTo(10);\n   105\t\n   106\t            assertThat(rows.next()).isTrue();\n   107\t            assertThat(rows.getInt(\"id\")).isEqualTo(2);\n   108\t            assertThat(rows.getString(\"title\")).isEqualTo(\"second\");\n   109\t            assertThat(rows.getInt(\"name\")).isEqualTo(20);\n   110\t            assertThat(rows.next()).isFalse();\n   111\t        }\n   112\t    }\n   113\t\n   114\t    private static DataSource getDataSource() {\n   115\t        PGSimpleDataSource dataSource = new PGSimpleDataSource();\n   116\t        dataSource.setUrl(JDBC_URL);\n   117\t        dataSource.setUser(USERNAME);\n   118\t        dataSource.setPassword(PASSWORD);\n   119\t        dataSource.setDatabaseName(DATABASE);\n   120\t        return dataSource;\n\nCurrent same hash?\n32397900e365d088a67fe0c104f1c6ec34a89a0f\n32397900e365d088a67fe0c104f1c6ec34a89a0f\n"}], "isError": false, "timestamp": 1791375404965}]}
