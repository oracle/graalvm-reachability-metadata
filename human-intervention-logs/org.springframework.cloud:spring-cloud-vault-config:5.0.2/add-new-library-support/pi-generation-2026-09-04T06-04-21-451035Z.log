enAuthentication\",\n   135\t\t\t\t\t\tclientAuthentication));\n   136\t\t\t}\n   137\t\n   138\t\t\tthrow new IllegalStateException(\n   139\t\t\t\t\t\"Cannot construct VaultTokenSupplier. Please configure VaultTokenSupplier bean named vaultTokenSupplier.\");\n   140\t\t}\n   141\t\n   142\t\tprivate VaultTokenSupplier createAuthenticationStepsOperator(AuthenticationStepsFactory factory,\n   143\t\t\t\tWebClientFactory webClientFactory) {\n   144\t\t\tWebClient webClient = webClientFactory.create();\n   145\t\t\treturn new AuthenticationStepsOperator(factory.getAuthenticationSteps(), webClient);\n   146\t\t}\n   147\t\n   148\t\tSessionManager createSessionManager(ReactiveSessionManager sessionManager) {\n   149\t\t\treturn sessionManager instanceof AuthenticationEventMulticaster\n   150\t\t\t\t\t? new ReactiveMulticastingSessionManagerAdapter(sessionManager)\n   151\t\t\t\t\t: new ReactiveSessionManagerAdapter(sessionManager);\n   152\t\t}\n   153\t\n   154\t\tReactiveSessionManager createReactiveSessionManager(VaultTokenSupplier vaultTokenSupplier,\n   155\t\t\t\tSupplier<TaskScheduler> taskScheduler, WebClientFactory webClientFactory) {\n   156\t\n   157\t\t\tVaultProperties.SessionLifecycle lifecycle = this.vaultProperties.getSession().getLifecycle();\n   158\t\n   159\t\t\tif (lifecycle.isEnabled()) {\n   160\t\t\t\tWebClient webClient = webClientFactory.create();\n   161\t\t\t\tReactiveLifecycleAwareSessionManager.RefreshTrigger trigger = new ReactiveLifecycleAwareSessionManager.FixedTimeoutRefreshTrigger(\n   162\t\t\t\t\t\tlifecycle.getRefreshBeforeExpiry(), lifecycle.getExpiryThreshold());\n   163\t\t\t\treturn new ReactiveLifecycleAwareSessionManager(vaultTokenSupplier, taskScheduler.get(), webClient,\n   164\t\t\t\t\t\ttrigger);\n   165\t\t\t}\n   166\t\n   167\t\t\treturn CachingVaultTokenSupplier.of(vaultTokenSupplier);\n   168\t\t}\n   169\t\n   170\t\t@SuppressWarnings(\"all\")\n"}], "isError": false, "timestamp": 1788503403231}]}
