  				infra.registerVaultSessionManager();
  			}
  
  			registerIfAbsent(bootstrap, "vaultTemplate", VaultTemplate.class,
  					ctx -> new VaultTemplate(bootstrap.get(RestTemplateBuilder.class),
  							bootstrap.get(SessionManager.class)));
  		}
  	}
  
