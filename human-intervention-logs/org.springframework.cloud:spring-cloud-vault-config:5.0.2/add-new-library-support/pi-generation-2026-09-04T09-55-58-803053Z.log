  @ConfigurationProperties(VaultProperties.PREFIX)
  public class VaultProperties implements EnvironmentAware {
  
  	/**
  	 * Configuration prefix for config properties.
  	 */
  	public static final String PREFIX = "spring.cloud.vault";
  
  	/**
