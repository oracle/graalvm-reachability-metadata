   graalvmNative {
  diff --git a/tests/src/org.springframework.cloud/spring-cloud-vault-config/5.0.2/src/test/java/org_springframework_cloud/spring_cloud_vault_config/Spring_cloud_vault_configTest.java b/tests/src/org.springframework.cloud/spring-cloud-vault-config/5.0.2/src/test/java/org_springframework_cloud/spring_cloud_vault_config/Spring_cloud_vault_configTest.java
