eout(IO_TIMEOUT)\n+                .header(\"X-Vault-Token\", ROOT_TOKEN)\n+                .header(\"Content-Type\", \"application/json\")\n+                .POST(HttpRequest.BodyPublishers.ofString(body))\n+                .build();\n+        HttpResponse<Void> response = client.send(request, HttpResponse.BodyHandlers.discarding());\n+        assertThat(response.statusCode()).isEqualTo(200);\n     }\n \n-    @SpringBootConfiguration(proxyBeanMethods = false)\n-    @EnableAutoConfiguration\n-    static class TestApplication {}\n+    private static void removeContainer(String containerName) throws Exception {\n+        Process removeCommand = new ProcessBuilder(\"docker\", \"rm\", \"-f\", containerName)\n+                .redirectErrorStream(true)\n+                .start();\n+        if (!removeCommand.waitFor(IO_TIMEOUT.toSeconds(), TimeUnit.SECONDS)) {\n+            removeCommand.destroyForcibly();\n+            removeCommand.waitFor(IO_TIMEOUT.toSeconds(), TimeUnit.SECONDS);\n+        }\n+    }\n }\ncommit af833a70e6f67fca7d40994fce7be722ee533863\nAuthor: Mihailo Markovic <mihailo.markovic@oracle.com>\nDate:   Fri Sep 4 08:21:55 2026 +0200\n\n    Exercise lifecycle-aware Vault session logging\n\ndiff --git a/tests/src/org.springframework.cloud/spring-cloud-vault-config/5.0.2/src/test/java/org_springframework_cloud/spring_cloud_vault_config/VaultConfigDataLoaderTest.java b/tests/src/org.springframework.cloud/spring-cloud-vault-config/5.0.2/src/test/java/org_springframework_cloud/spring_cloud_vault_config/VaultConfigDataLoaderTest.java\nindex 0722fd8f40..f436d4776a 100644\n--- a/tests/src/org.springframework.cloud/spring-cloud-vault-config/5.0.2/src/test/java/org_springframework_cloud/spring_cloud_vault_config/VaultConfigDataLoaderTest.java\n+++ b/tests/src/org.springframework.cloud/spring-cloud-vault-config/5.0.2/src/test/java/org_springframework_cloud/spring_cloud_vault_config/VaultConfigDataLoaderTest.java\n@@ -28,6 +28,8 @@ import org.springframework.cloud.vau