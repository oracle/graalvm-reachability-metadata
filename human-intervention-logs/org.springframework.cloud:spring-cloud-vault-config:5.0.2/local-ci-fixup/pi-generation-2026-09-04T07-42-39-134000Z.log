  tasks.register("generateNewLibraryVersionCompatibilityMatrix", DefaultTask) { task ->
      task.setDescription("Returns matrix definition populated with newer library versions and CI environments")
      task.setGroup(METADATA_GROUP)
      task.doFirst {
          if (!project.hasProperty("newLibraryVersionCandidates")) {
              throw new GradleException("Missing 'newLibraryVersionCandidates' property! Rerun Gradle with -PnewLibraryVersionCandidates=<json-array>")
