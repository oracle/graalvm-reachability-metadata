          if (noneFound) {
              println "No libraries with newer versions were found!"
          }
  
          writeGithubOutput("matrix", JsonOutput.toJson([include: noneFound ? [] : expandNewLibraryVersionCompatibilityMatrix(libraries)]))
          writeGithubOutput("none-found", noneFound.toString())
      }
  }
  
  tasks.register("addTestedVersion", TestedVersionUpdaterTask.class) { task ->
