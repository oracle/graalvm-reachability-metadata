          return add(buf, buf.readerIndex(), buf.readableBytes());
      }
  
      public boolean add(ByteBuf buf, int offset, int len) {
          if (count == IOV_MAX) {
              // No more room!
              return false;
          }
          if (buf.nioBufferCount() == 1) {
              if (len == 0) {
                  return true;
              }
              if (buf.hasMemoryAddress()) {
                  return add(memoryAddress, buf.memoryAddress() + offset, len);
              } else {
