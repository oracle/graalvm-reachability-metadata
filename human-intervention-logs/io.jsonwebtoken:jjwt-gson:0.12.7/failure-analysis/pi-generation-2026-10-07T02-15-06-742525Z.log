o.jsonwebtoken.Jwts;\"},{\"oldText\":\"    void buildsAndParsesSignedClaimsThroughPublicFactories() throws GeneralSecurityException {\\n        SecretKey firstKey = generateSecretKey(\\\"HmacSHA256\\\");\\n        String secretString = Base64.getEncoder().encodeToString(firstKey.getEncoded());\\n        SecretKey secondKey = new SecretKeySpec(Base64.getDecoder().decode(secretString), \\\"HmacSHA256\\\");\\n\\n        String firstCompactJws = Jwts.builder().subject(\\\"Joe\\\").signWith(firstKey).compact();\\n        String secondCompactJws = Jwts.builder().subject(\\\"Joe\\\").signWith(secondKey).compact();\\n\\n        assertThat(parseSubject(firstCompactJws, firstKey)).isEqualTo(\\\"Joe\\\");\\n        assertThat(parseSubject(secondCompactJws, secondKey)).isEqualTo(\\\"Joe\\\");\\n    }\",\"newText\":\"    void exercisesPublicFactoriesForReflectiveSuppliers() throws GeneralSecurityException {\\n        Header header = Jwts.header().add(\\\"kid\\\", \\\"factory-key\\\").build();\\n        Claims claims = Jwts.claims().subject(\\\"Joe\\\").build();\\n        SecretKey firstKey = generateSecretKey(\\\"HmacSHA256\\\");\\n        String secretString = Base64.getEncoder().encodeToString(firstKey.getEncoded());\\n        SecretKey secondKey = new SecretKeySpec(Base64.getDecoder().decode(secretString), \\\"HmacSHA256\\\");\\n\\n        String firstCompactJws = Jwts.builder().subject(claims.getSubject()).signWith(firstKey).compact();\\n        String secondCompactJws = Jwts.builder().subject(claims.getSubject()).signWith(secondKey).compact();\\n\\n        assertThat(header).containsEntry(\\\"kid\\\", \\\"factory-key\\\");\\n        assertThat(parseSubject(firstCompactJws, firstKey)).isEqualTo(\\\"Joe\\\");\\n        assertThat(parseSubject(secondCompactJws, secondKey)).isEqualTo(\\\"Joe\\\");\\n    }\"}]}\n[tool-call] end id=call_FoM6XFnUHInLTez65GYKsUlB|fc_0e5447b638619c9e016ac5ab06a90887d0a65e2fd7f26f1f59 name=edit args={\"path\": \"tests/src/io.jsonwebtoken/jjwt-gson/0.