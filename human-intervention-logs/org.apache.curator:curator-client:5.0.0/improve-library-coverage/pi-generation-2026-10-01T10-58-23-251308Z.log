.assertj.core.api.Assertions.assertThat;\n\npublic class CustomMultimapSerializationTest {\n    @Test\n    void preservesCustomMultimapImplementationsWhenRoundTripped() throws Exception {\n        Multimap<String, Integer> list = Multimaps.newListMultimap(new HashMap<>(), ArrayList::new);\n        Multimap<String, Integer> custom = Multimaps.newMultimap(new HashMap<>(), ArrayList::new);\n        Multimap<String, Integer> set = Multimaps.newSetMultimap(new HashMap<>(), java.util.HashSet::new);\n        Multimap<String, Integer> sorted = Multimaps.newSortedSetMultimap(new HashMap<>(), TreeSet::new);\n        list.put(\"key\", 1);\n        custom.put(\"key\", 1);\n        set.put(\"key\", 1);\n        sorted.put(\"key\", 1);\n\n        assertThat(roundTrip(list)).isEqualTo(list);\n        assertThat(roundTrip(custom)).isEqualTo(custom);\n        assertThat(roundTrip(set)).isEqualTo(set);\n        assertThat(roundTrip(sorted)).isEqualTo(sorted);\n    }\n\n    @SuppressWarnings(\"unchecked\")\n    private static <T> T roundTrip(T value) throws Exception {\n        ByteArrayOutputStream bytes = new ByteArrayOutputStream();\n        try (ObjectOutputStream output = new ObjectOutputStream(bytes)) {\n            output.writeObject(value);\n        }\n        try (ObjectInputStream input = new ObjectInputStream(new ByteArrayInputStream(bytes.toByteArray()))) {\n            return (T) input.readObject();\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_wPYixdRTvrDERcCwFrhxw0F0|fc_0707421191b3250c016abe3d4d8b5c87d2bf28b0b9cf71e1bb", "name": "write", "arguments": {"path": "tests/src/org.apache.curator/curator-client/5.0.0/src/test/java/org_apache_curator/curator_client/AbstractBiMapInverseTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_curator.curator_client;\n\nimpor