lient/5.0.0/src/test/java/org_apache_curator/curator_client/LinkedHashMultimapTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_curator.curator_client;\n\nimport java.io.ByteArrayInputStream;\nimport java.io.ByteArrayOutputStream;\nimport java.io.ObjectInputStream;\nimport java.io.ObjectOutputStream;\n\nimport org.apache.curator.shaded.com.google.common.collect.LinkedHashMultimap;\nimport org.junit.jupiter.api.Test;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\npublic class LinkedHashMultimapTest {\n    @Test\n    void preservesEntriesWhenRoundTripped() throws Exception {\n        LinkedHashMultimap<String, Integer> original = LinkedHashMultimap.create();\n        original.put(\"one\", 1);\n        original.put(\"two\", 2);\n\n        LinkedHashMultimap<String, Integer> copy = roundTrip(original);\n\n        assertThat(copy.entries()).containsExactlyElementsOf(original.entries());\n    }\n\n    @SuppressWarnings(\"unchecked\")\n    private static <T> T roundTrip(T value) throws Exception {\n        ByteArrayOutputStream bytes = new ByteArrayOutputStream();\n        try (ObjectOutputStream output = new ObjectOutputStream(bytes)) {\n            output.writeObject(value);\n        }\n        try (ObjectInputStream input = new ObjectInputStream(new ByteArrayInputStream(bytes.toByteArray()))) {\n            return (T) input.readObject();\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_CsOiVxLA5cQCM8ZjHvn4p80J|fc_0707421191b3250c016abe3d2628d887d28a85c19374a9136c", "name": "write", "arguments": {"path": "tests/src/org.apache.curator/curator-client/5.0.0/src/test/java/org_apache_curator/curator_client/ImmutableMultimapSerializationTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_curator.curator_client;\n\nimport java.io.ByteArrayInputStream;\nimport java.io.ByteArrayOutputStream;\nimport java.io.ObjectInputStream;\nimport java.io.ObjectOutputStream;\n\nimport org.apache.curator.shaded.com.google.common.collect.ImmutableListMultimap;\nimport org.apache.curator.shaded.com.google.common.collect.ImmutableSetMultimap;\nimport org.junit.jupiter.api.Test;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\npublic class ImmutableMultimapSerializationTest {\n    @Test\n    void preservesImmutableMultimapsWhenRoundTripped() throws Exception {\n        ImmutableListMultimap<String, Integer> list = ImmutableListMultimap.of(\"key\", 1, \"key\", 2);\n        ImmutableSetMultimap<String, Integer> set = ImmutableSetMultimap.of(\"key\", 1, \"key\", 2);\n\n        assertThat(roundTrip(list)).isEqualTo(list);\n        assertThat(roundTrip(set)).isEqualTo(set);\n    }\n\n    @SuppressWarnings(\"unchecked\")\n    private static <T> T roundTrip(T value) throws Exception {\n        ByteArrayOutputStream bytes = new ByteArrayOutputStream();\n        try (ObjectOutputStream output = new ObjectOutputStream(bytes)) {\n            output.writeObject(value);\n        }\n        try (ObjectInputStream input = new ObjectInputStream(new ByteArrayInputStream(bytes.toByteArray()))) {\n            return (T) input.readObject();\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_r2QAmI1osfzP5HECd8LsOWO4|fc_0707421191b3250c016abe3d2628e087d28199b9429229833d", "name": "write", "arguments": {"path": "tests/src/org.apache.curator/curator-client/5.0.0/src/test/java/org_apache_curator/curator_client/TreeCollectionsSerializationTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_curator.curator_client;\n\nimport java.io.ByteArrayInputStream;\nimport java.io.ByteArrayOutputStream;\nimport java.io.ObjectInputStream;\nimport java.io.ObjectOutputStream;\n\nimport org.apache.curator.shaded.com.google.common.collect.TreeMultimap;\nimport org.apache.curator.shaded.com.google.common.collect.TreeMultiset;\nimport org.junit.jupiter.api.Test;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\npublic class TreeCollectionsSerializationTest {\n    @Test\n    void preservesSortedCollectionsWhenRoundTripped() throws Exception {\n        TreeMultimap<String, Integer> multimap = TreeMultimap.create();\n        multimap.put(\"key\", 2);\n        multimap.put(\"key\", 1);\n        TreeMultiset<Integer> multiset = TreeMultiset.create();\n        multiset.add(2);\n        multiset.add(1);\n\n        assertThat(roundTrip(multimap)).isEqualTo(multimap);\n        assertThat(roundTrip(multiset)).isEqualTo(multiset);\n    }\n\n    @SuppressWarnings(\"unchecked\")\n    private static <T> T roundTrip(T value) throws Exception {\n        ByteArrayOutputStream bytes = new ByteArrayOutputStream();\n        try (ObjectOutputStream output = new ObjectOutputStream(bytes)) {\n            output.writeObject(value);\n        }\n        try (ObjectInputStream input = new ObjectInputStream(new ByteArrayInputStream(bytes.toByteArray()))) {\n            return (T) input.readObject();\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_vsWzYERqxqACTR8GUBeP181S|fc_0707421191b3250c016abe3d2628e887d286ac7ab3c0c9bc70", "name": "write", "arguments": {"path": "tests/src/org.apache.curator/curator-client/5.0.0/src/test/java/org_apache_curator/curator_client/EnumCollectionsSerializationTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_curator.curator_client;\n\nimport java.io.ByteArrayInputStream;\nimport java.io.ByteArrayOutputStream;\nimport java.io.ObjectInputStream;\nimport java.io.ObjectOutputStream;\n\nimport org.apache.curator.shaded.com.google.common.collect.EnumBiMap;\nimport org.apache.curator.shaded.com.google.common.collect.EnumHashBiMap;\nimport org.apache.curator.shaded.com.google.common.collect.EnumMultiset;\nimport org.junit.jupiter.api.Test;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\npublic class EnumCollectionsSerializationTest {\n    private enum Key { FIRST, SECOND }\n\n    private enum Value { ONE, TWO }\n\n    @Test\n    void preservesEnumCollectionsWhenRoundTripped() throws Exception {\n        EnumBiMap<Key, Value> biMap = EnumBiMap.create(Key.class, Value.class);\n        biMap.put(Key.FIRST, Value.ONE);\n        EnumHashBiMap<Key, Value> hashBiMap = EnumHashBiMap.create(Key.class, Value.class);\n        hashBiMap.put(Key.SECOND, Value.TWO);\n        EnumMultiset<Key> multiset = EnumMultiset.create(Key.class);\n        multiset.add(Key.FIRST, 2);\n\n        assertThat(roundTrip(biMap)).isEqualTo(biMap);\n        assertThat(roundTrip(hashBiMap)).isEqualTo(hashBiMap);\n        assertThat(roundTrip(multiset)).isEqualTo(multiset);\n    }\n\n    @SuppressWarnings(\"unchecked\")\n    private static <T> T roundTrip(T value) throws Exception {\n        ByteArrayOutputStream bytes = new ByteArrayOutputStream();\n        try (ObjectOutputStream output = new ObjectOutputStream(bytes)) {\n            output.writeObject(value);\n        }\n        try (ObjectInputStream input = new ObjectInputStream(new ByteArrayInputStream(bytes.toByteArray()))) {\n            return (T) input.readObject();\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_2XcIxGNl6zIKAFghYFiCxxU8|fc_0707421191b3250c016abe3d2628fc87d280788ae34b5eff12", "name": "write", "arguments": {"path": "tests/src/org.apache.curator/curator-client/5.0.0/src/test/java/org_apache_curator/curator_client/LinkedListMultimapTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_curator.curator_client;\n\nimport java.io.ByteArrayInputStream;\nimport java.io.ByteArrayOutputStream;\nimport java.io.ObjectInputStream;\nimport java.io.ObjectOutputStream;\n\nimport org.apache.curator.shaded.com.google.common.collect.LinkedListMultimap;\nimport org.junit.jupiter.api.Test;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\npublic class LinkedListMultimapTest {\n    @Test\n    void preservesInsertionOrderWhenRoundTripped() throws Exception {\n        LinkedListMultimap<String, Integer> original = LinkedListMultimap.create();\n        original.put(\"key\", 2);\n        original.put(\"key\", 1);\n\n        assertThat(roundTrip(original).entries()).containsExactlyElementsOf(original.entries());\n    }\n\n    @SuppressWarnings(\"unchecked\")\n    private static <T> T roundTrip(T value) throws Exception {\n        ByteArrayOutputStream bytes = new ByteArrayOutputStream();\n        try (ObjectOutputStream output = new ObjectOutputStream(bytes)) {\n            output.writeObject(value);\n        }\n        try (ObjectInputStream input = new ObjectInputStream(new ByteArrayInputStream(bytes.toByteArray()))) {\n            return (T) input.readObject();\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_WlFwEKsujJTBV8f40AcVHwBS|fc_0707421191b3250c016abe3d26290087d29cb0ad3a07749673", "name": "write", "arguments": {"path": "tests/src/org.apache.curator/curator-client/5.0.0/src/test/java/org_apache_curator/curator_client/ConcurrentHashMultisetTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_curator.curator_client;\n\nimport java.io.ByteArrayInputStream;\nimport java.io.ByteArrayOutputStream;\nimport java.io.ObjectInputStream;\nimport java.io.ObjectOutputStream;\n\nimport org.apache.curator.shaded.com.google.common.collect.ConcurrentHashMultiset;\nimport org.junit.jupiter.api.Test;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\npublic class ConcurrentHashMultisetTest {\n    @Test\n    void preservesCountsWhenRoundTripped() throws Exception {\n        ConcurrentHashMultiset<String> original = ConcurrentHashMultiset.create();\n        original.add(\"item\", 3);\n\n        assertThat(roundTrip(original)).isEqualTo(original);\n    }\n\n    @SuppressWarnings(\"unchecked\")\n    private static <T> T roundTrip(T value) throws Exception {\n        ByteArrayOutputStream bytes = new ByteArrayOutputStream();\n        try (ObjectOutputStream output = new ObjectOutputStream(bytes)) {\n            output.writeObject(value);\n        }\n        try (ObjectInputStream input = new ObjectInputStream(new ByteArrayInputStream(bytes.toByteArray()))) {\n            return (T) input.readObject();\n        }\n    }\n}\n"}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-luna", "usage": {"input": 4224, "output": 3831, "cacheRead": 40448, "cacheWrite": 0, "reasoning": 1212, "totalTokens": 48503, "cost": {"input": 0.0008448, "output": 0.0045972, "cacheRead": 0.0008089600000000001, "cacheWrite": 0, "total": 0.00625096}}, "stopReason": "toolUse", "timestamp": 1790852320300, "responseId": "resp_0707421191b3250c016abe3ce0b46087d2a9697c83e9bebd19", "rawStopReason": "completed"}}
