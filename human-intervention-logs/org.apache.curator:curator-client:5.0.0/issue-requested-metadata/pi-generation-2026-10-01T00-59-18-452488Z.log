      } finally {\n-                serverSocket.close();\n-                serverExecutor.shutdownNow();\n-                assertThat(serverExecutor.awaitTermination(5, TimeUnit.SECONDS)).isTrue();\n-            }\n-        }\n     }\n \n     @Test\n\nExisting curator metadata files:\nmetadata/org.apache.curator/curator-client/2.6.0/reachability-metadata.json\nmetadata/org.apache.curator/curator-client/2.7.1/reachability-metadata.json\nmetadata/org.apache.curator/curator-client/5.0.0/reachability-metadata.json\nmetadata/org.apache.curator/curator-client/index.json\n\nSearch target names and curator metadata:\ntests/src/org.apache.curator/curator-client/5.0.0/src/test/java/org_apache_curator/curator_client/Curator_clientTest.java:24:import org.apache.curator.RetryLoop;\ntests/src/org.apache.curator/curator-client/5.0.0/src/test/java/org_apache_curator/curator_client/Curator_clientTest.java:102:        String result = RetryLoop.callWithRetry(client, () -> {\ntests/src/org.apache.curator/curator-client/5.0.0/src/test/java/org_apache_curator/curator_client/Curator_clientTest.java:112:        RetryLoop loop = client.newRetryLoop();\ntests/src/org.apache.curator/curator-client/5.0.0/src/test/java/org_apache_curator/curator_client/Curator_clientTest.java:116:        assertThatThrownBy(() -> client.newRetryLoop().takeException(KeeperException.create(Code.NONODE)))\nmetadata/org.apache.curator/curator-client/index.json:15:    \"source-code-url\" : \"https://repo.maven.apache.org/maven2/org/apache/curator/curator-client/$version$/curator-client-$version$-sources.jar\",\nmetadata/org.apache.curator/curator-client/index.json:18:    \"documentation-url\" : \"https://repo.maven.apache.org/maven2/org/apache/curator/curator-client/$version$/curator-client-$version$-javadoc.jar\",\nmetadata/org.apache.curator/curator-client/index.json:47:    \"source-code-url\" : \"https://repo.maven.apache.org/maven2/org/apache/curator/curator-client/$version$/curator-client-$version$-sources.jar\