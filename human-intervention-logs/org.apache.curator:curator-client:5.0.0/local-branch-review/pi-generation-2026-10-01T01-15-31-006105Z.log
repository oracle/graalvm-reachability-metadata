\"/has//empty-node\"))\n266:+        assertThatThrownBy(() -> PathUtils.validatePath(\"/ends/with/slash/\"))\n268:+        assertThatThrownBy(() -> PathUtils.validatePath(\"/uses/../relative\"))\n283:+        assertThat(createdThreadLatch.await(5, TimeUnit.SECONDS)).isTrue();\n285:+        assertThat(createdThread.get().getName()).startsWith(\"Curator-curator-worker-\");\n286:+        assertThat(createdThread.get().isDaemon()).isTrue();\n291:+            assertThat(executorThread.getName()).startsWith(\"Curator-curator-single-\");\n292:+            assertThat(executorThread.isDaemon()).isTrue();\n295:+            assertThat(singleThreadExecutor.awaitTermination(5, TimeUnit.SECONDS)).isTrue();\n301:+            assertThat(executorThread.getName()).startsWith(\"Curator-curator-fixed-\");\n302:+            assertThat(executorThread.isDaemon()).isTrue();\n305:+            assertThat(fixedThreadPool.awaitTermination(5, TimeUnit.SECONDS)).isTrue();\n313:+            assertThat(scheduledThread.getName()).startsWith(\"Curator-curator-scheduled-\");\n314:+            assertThat(scheduledThread.isDaemon()).isTrue();\n317:+            assertThat(singleScheduledExecutor.awaitTermination(5, TimeUnit.SECONDS)).isTrue();\n325:+            assertThat(scheduledThread.getName()).startsWith(\"Curator-curator-fixed-scheduled-\");\n326:+            assertThat(scheduledThread.isDaemon()).isTrue();\n329:+            assertThat(fixedScheduledPool.awaitTermination(5, TimeUnit.SECONDS)).isTrue();\n333:+        assertThat(ThreadUtils.getProcessName(Curator_clientTest.class)).isEqualTo(\"Curator_clientTest\");\n334:+        assertThat(ThreadUtils.getProcessName(anonymousInstance.getClass())).isEqualTo(\"Curator_clientTest\");\n346:+        assertThat(submitted.get(5, TimeUnit.SECONDS)).isNull();\n347:+        assertThat(executorResult).hasValue(\"executor-result\");\n349:+        assertThat(closeableExecutor.isShutdown()).isTrue();\n350:+        assertThat(executor.isShutdown()).isTrue();\n351