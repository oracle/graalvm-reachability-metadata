  +        assertThat(value).isEqualTo("privileged value");
  +    }
  +
  +    private static final class ConstantAction implements PrivilegedAction<String> {
  +        @Override
  +        public String run() {
  +            return "privileged value";
  +        }
  +    }
  +}
