o(\"privileged value\");\n\ncommit a0bbf2aa4cf3f45ea911ade97965106958b9c58b\nAuthor: Mihailo Markovic <mihailo.markovic@oracle.com>\nDate:   Wed Sep 2 04:23:29 2026 +0200\n\n    Add Jetty util dynamic access tests\n\ndiff --git a/tests/src/org.eclipse.jetty/jetty-util/12.0.9/src/test/java/org_eclipse_jetty/jetty_util/SecurityUtilsTest.java b/tests/src/org.eclipse.jetty/jetty-util/12.0.9/src/test/java/org_eclipse_jetty/jetty_util/SecurityUtilsTest.java\nnew file mode 100644\nindex 0000000000..07a0c32bb5\n--- /dev/null\n+++ b/tests/src/org.eclipse.jetty/jetty-util/12.0.9/src/test/java/org_eclipse_jetty/jetty_util/SecurityUtilsTest.java\n@@ -0,0 +1,33 @@\n+/*\n+ * Copyright and related rights waived via CC0\n+ *\n+ * You should have received a copy of the CC0 legalcode along with this\n+ * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n+ */\n+package org_eclipse_jetty.jetty_util;\n+\n+import java.security.PrivilegedAction;\n+\n+import org.eclipse.jetty.util.security.SecurityUtils;\n+import org.junit.jupiter.api.Test;\n+\n+import static org.assertj.core.api.Assertions.assertThat;\n+\n+public class SecurityUtilsTest {\n+    @Test\n+    void performsSecurityOperationsWithoutAnInstalledSecurityManager() {\n+        assertThat(SecurityUtils.getSecurityManager()).isNull();\n+\n+        SecurityUtils.checkPermission(new RuntimePermission(\"getClassLoader\"));\n+        String value = SecurityUtils.doPrivileged(new ConstantAction());\n+\n+        assertThat(value).isEqualTo(\"privileged value\");\n+    }\n+\n+    private static final class ConstantAction implements PrivilegedAction<String> {\n+        @Override\n+        public String run() {\n+            return \"privileged value\";\n+        }\n+    }\n+}\n"}], "isError": false, "timestamp": 1788317891788}}
  
