age>\n  </properties>\n\n  <dependencies>\n    <dependency>\n      <groupId>tools.jackson.core</groupId>\n      <artifactId>jackson-core</artifactId>\n    </dependency>\n    <dependency>\n      <groupId>tools.jackson.core</groupId>\n      <artifactId>jackson-databind</artifactId>\n    </dependency>\n\n    <!-- Test dependencies -->\n  </dependencies>\n\n  <build>\n    <plugins>\n      <plugin>\n        <!-- Inherited from oss-base. Generate PackageVersion.java.-->\n        <groupId>com.google.code.maven-replacer-plugin</groupId>\n        <artifactId>replacer</artifactId>\n      </plugin>\n      <!-- 29-Apr-2025, tatu: SBOM generation [JSTEP-14] -->\n      <plugin>\n        <groupId>org.cyclonedx</groupId>\n        <artifactId>cyclonedx-maven-plugin</artifactId>\n      </plugin>\n      <!-- 05-Jul-2020, tatu: Add generation of Gradle Module Metadata -->\n      <!-- 28-Feb-2025, jjohannes: Apply plugin last as it has to be the last of all 'package phase' plugins -->\n      <plugin>\n        <groupId>org.gradlex</groupId>\n        <artifactId>gradle-module-metadata-maven-plugin</artifactId>\n      </plugin>\n    </plugins>\n  </build>\n</project>\n--- JAR CONTENTS ---\njava.util.zip.ZipException: zip file is empty\n\tat java.base/java.util.zip.ZipFile$Source.zerror(ZipFile.java:1831)\n\tat java.base/java.util.zip.ZipFile$Source.findEND(ZipFile.java:1609)\n\tat java.base/java.util.zip.ZipFile$Source.initCEN(ZipFile.java:1701)\n\tat java.base/java.util.zip.ZipFile$Source.<init>(ZipFile.java:1542)\n\tat java.base/java.util.zip.ZipFile$Source.get(ZipFile.java:1506)\n\tat java.base/java.util.zip.ZipFile$CleanableResource.<init>(ZipFile.java:704)\n\tat java.base/java.util.zip.ZipFile.<init>(ZipFile.java:204)\n\tat java.base/java.util.zip.ZipFile.<init>(ZipFile.java:150)\n\tat java.base/java.util.zip.ZipFile.<init>(ZipFile.java:131)\n\tat jdk.jartool/sun.tools.jar.Main.list(Main.java:1553)\n\tat jdk.jartool/sun.tools.jar.Main.run(Main.java:361)\n\tat jdk.jartool/sun.tools.jar