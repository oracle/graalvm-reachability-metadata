nmetadata/tools.jackson.module/jackson-module-blackbird/3.1.5/reachability-metadata.json:215:      \"type\": \"tools_jackson_module.jackson_module_blackbird.ReflectionHackInnerJava8Test$PackageVisibleBean\",\ntests/src/tools.jackson.module/jackson-module-blackbird/3.1.5/settings.gradle:20:rootProject.name = 'tools.jackson.module.jackson-module-blackbird_tests'\ntests/src/tools.jackson.module/jackson-module-blackbird/3.1.5/gradle.properties:4:library.coordinates = tools.jackson.module:jackson-module-blackbird:3.1.5\ntests/src/tools.jackson.module/jackson-module-blackbird/3.1.5/gradle.properties:6:metadata.dir = tools.jackson.module/jackson-module-blackbird/3.1.5/\ntests/src/tools.jackson.module/jackson-module-blackbird/3.1.5/build.gradle:14:    testImplementation \"tools.jackson.module:jackson-module-blackbird:$libraryVersion\"\ntests/src/tools.jackson.module/jackson-module-blackbird/3.1.5/src/test/java/tools_jackson_module/jackson_module_blackbird/CreatorOptimizerTest.java:18:        ConstructorValue value = CrossLoaderAccessTest.MAPPER.readValue(\ntests/src/tools.jackson.module/jackson-module-blackbird/3.1.5/src/test/java/tools_jackson_module/jackson_module_blackbird/CreatorOptimizerTest.java:30:        FactoryValue value = CrossLoaderAccessTest.MAPPER.readValue(\ntests/src/tools.jackson.module/jackson-module-blackbird/3.1.5/src/test/java/tools_jackson_module/jackson_module_blackbird/CrossLoaderAccessTest.java:18:public class CrossLoaderAccessTest {\ntests/src/tools.jackson.module/jackson-module-blackbird/3.1.5/src/test/java/tools_jackson_module/jackson_module_blackbird/BBDeserializerModifierTest.java:16:        MutableBean bean = CrossLoaderAccessTest.MAPPER.readValue(\ntests/src/tools.jackson.module/jackson-module-blackbird/3.1.5/src/test/java/tools_jackson_module/jackson_module_blackbird/ReflectionHackInnerJava8Test.java:14:public class ReflectionHackInnerJava8Test {\ntests/src/tools.jackson.module/jackson-module-blackbird/3.1.5/src/test/java/tools_jackson_modul