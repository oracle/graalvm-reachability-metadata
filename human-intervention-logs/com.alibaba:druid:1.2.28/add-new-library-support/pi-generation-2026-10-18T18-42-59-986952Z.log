uid.support.monitor.dao.MonitorDaoJdbcImpl;\n+import java.util.Date;\n+import java.util.List;\n+import java.util.Map;\n import org.junit.jupiter.api.Test;\n \n+import static org.junit.jupiter.api.Assertions.assertEquals;\n import static org.junit.jupiter.api.Assertions.assertInstanceOf;\n \n public class MonitorDaoJdbcImplTest {\n@@ -19,4 +26,42 @@ public class MonitorDaoJdbcImplTest {\n         MonitorDaoJdbcImpl.BeanInfo beanInfo = new MonitorDaoJdbcImpl.BeanInfo(JdbcSqlStatValue.class);\n         assertInstanceOf(JdbcSqlStatValue.class, dao.createInstance(beanInfo));\n     }\n+\n+    @Test\n+    void persistsAndLoadsSqlStatistics() {\n+        DruidDataSource dataSource = new DruidDataSource();\n+        dataSource.setUrl(\"jdbc:h2:mem:druid_monitor;MODE=MySQL;DB_CLOSE_DELAY=-1\");\n+\n+        try {\n+            MonitorDaoJdbcImpl dao = new MonitorDaoJdbcImpl();\n+            dao.setDataSource(dataSource);\n+            dao.createTables(\"mysql\");\n+\n+            long collectedAt = System.currentTimeMillis();\n+            MonitorContext context = new MonitorContext();\n+            context.setCollectTime(new Date(collectedAt));\n+\n+            JdbcSqlStatValue sqlStat = new JdbcSqlStatValue();\n+            sqlStat.setSqlHash(42L);\n+            sqlStat.setSql(\"select 42\");\n+            sqlStat.setDbType(\"h2\");\n+\n+            DruidDataSourceStatValue dataSourceStat = new DruidDataSourceStatValue();\n+            dataSourceStat.setName(\"monitor-pool\");\n+            dataSourceStat.setDbType(\"h2\");\n+            dataSourceStat.setSqlList(List.of(sqlStat));\n+            dao.saveSql(context, List.of(dataSourceStat));\n+\n+            Map<String, Object> filters = Map.of(\n+                    \"startTime\", collectedAt - 1000L,\n+                    \"endTime\", collectedAt + 1000L);\n+            List<JdbcSqlStatValue> loaded = dao.loadSqlList(filters);\n+\n+            assertEquals(1, loaded.size());\n+            assertEquals(\"select 42\", loaded.get(0).getSql());\n+            assertEquals(42L, loaded.get(0).getSqlHash());\n+        } finally {\n+            dataSource.close();\n+        }\n+    }\n }\ndiff --git a/tests/src/com.alibaba/druid/1.2.28/src/test/java/com_alibaba/druid/ResourcesTest.java b/tests/src/com.alibaba/druid/1.2.28/src/test/java/com_alibaba/druid/ResourcesTest.java\nindex 61c1fa006d..a47fbd1fab 100644\n--- a/tests/src/com.alibaba/druid/1.2.28/src/test/java/com_alibaba/druid/ResourcesTest.java\n+++ b/tests/src/com.alibaba/druid/1.2.28/src/test/java/com_alibaba/druid/ResourcesTest.java\n@@ -14,6 +14,12 @@ import static org.junit.jupiter.api.Assertions.assertEquals;\n public class ResourcesTest {\n     @Test\n     void loadsDruidClassByName() throws Exception {\n-        assertEquals(Resources.class, Resources.classForName(\"com.alibaba.druid.support.logging.Resources\"));\n+        ClassLoader original = Resources.getDefaultClassLoader();\n+        try {\n+            Resources.setDefaultClassLoader(ClassLoader.getPlatformClassLoader());\n+            assertEquals(Resources.class, Resources.classForName(\"com.alibaba.druid.support.logging.Resources\"));\n+        } finally {\n+            Resources.setDefaultClassLoader(original);\n+        }\n     }\n }\ndiff --git a/tests/src/com.alibaba/druid/1.2.28/src/test/java/com_alibaba/druid/UtilsTest.java b/tests/src/com.alibaba/druid/1.2.28/src/test/java/com_alibaba/druid/UtilsTest.java\nindex 2e559804c4..1e4d611440 100644\n--- a/tests/src/com.alibaba/druid/1.2.28/src/test/java/com_alibaba/druid/UtilsTest.java\n+++ b/tests/src/com.alibaba/druid/1.2.28/src/test/java/com_alibaba/druid/UtilsTest.java\n@@ -14,6 +14,7 @@ import org.junit.jupiter.api.Test;\n import static org.junit.jupiter.api.Assertions.assertEquals;\n import static org.junit.jupiter.api.Assertions.assertFalse;\n import static org.junit.jupiter.api.Assertions.assertNotNull;\n+import static org.junit.jupiter.api.Assertions.assertNull;\n import static org.junit.jupiter.api.Assertion