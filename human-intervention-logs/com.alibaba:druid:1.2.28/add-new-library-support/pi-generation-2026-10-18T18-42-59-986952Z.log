[tool-exec] start id=call_us9qPwbtKTFePmD2BdbZwYul|fc_0116eb80ea4959d8016ad51435603087d09735679f53beca69 name=write args={"path": "tests/src/com.alibaba/druid/1.2.28/src/test/java/com_alibaba/druid/UtilsTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage com_alibaba.druid;\n\nimport com.alibaba.druid.util.Utils;\nimport java.util.HashSet;\nimport java.util.Set;\nimport org.junit.jupiter.api.Test;\n\nimport static org.junit.jupiter.api.Assertions.assertEquals;\nimport static org.junit.jupiter.api.Assertions.assertFalse;\nimport static org.junit.jupiter.api.Assertions.assertNotNull;\nimport static org.junit.jupiter.api.Assertions.assertTrue;\n\npublic class UtilsTest {\n    private static final String FILTER_RESOURCE = \"META-INF/druid-filter.properties\";\n\n    @Test\n    void loadsClassesAndBundledResources() throws Exception {\n        assertEquals(Utils.class, Utils.loadClass(\"com.alibaba.druid.util.Utils\"));\n        assertFalse(Utils.loadProperties(FILTER_RESOURCE).isEmpty());\n        assertFalse(Utils.readLines(FILTER_RESOURCE).isEmpty());\n        assertTrue(Utils.readFromResource(FILTER_RESOURCE).contains(\"druid.filters.stat\"));\n        assertTrue(Utils.readByteArrayFromResource(FILTER_RESOURCE).length > 0);\n\n        Set<String> lines = new HashSet<>();\n        Utils.loadFromFile(FILTER_RESOURCE, lines);\n        assertFalse(lines.isEmpty());\n\n        ClassLoader original = Thread.currentThread().getContextClassLoader();\n        try {\n            Thread.currentThread().setContextClassLoader(null);\n            assertNotNull(Utils.readFromResource(\"/META-INF/druid-filter.properties\"));\n        } finally {\n            Thread.currentThread().setContextClassLoader(original);\n        }\n    }\n}\n"}
[tool-exec] start id=call_yBH0G5apSXW84R6I3HHh1cmi|fc_0116eb80ea4959d8016ad51435603887d09348dd712114a139 name=write args={"path": "tests/src/com.alibaba/druid/1.2.28/src/test/java/com_alibaba/druid/DruidAbstractDataSourceTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage com_alibaba.druid;\n\nimport com.alibaba.druid.pool.DruidDataSource;\nimport com.alibaba.druid.pool.DruidDataSourceStatLoggerImpl;\nimport com.alibaba.druid.pool.JDBC4ValidConnectionChecker;\nimport com.alibaba.druid.pool.vendor.MySqlExceptionSorter;\nimport com.alibaba.druid.util.DruidPasswordCallback;\nimport org.junit.jupiter.api.Test;\n\nimport static org.junit.jupiter.api.Assertions.assertInstanceOf;\n\npublic class DruidAbstractDataSourceTest {\n    @Test\n    void configuresExtensionTypesByClassName() throws Exception {\n        DruidDataSource dataSource = new DruidDataSource();\n        try {\n            dataSource.setStatLoggerClassName(DruidDataSourceStatLoggerImpl.class.getName());\n            dataSource.setValidConnectionCheckerClassName(JDBC4ValidConnectionChecker.class.getName());\n            dataSource.setPasswordCallbackClassName(DruidPasswordCallback.class.getName());\n            dataSource.setExceptionSorter(MySqlExceptionSorter.class.getName());\n\n            assertInstanceOf(DruidDataSourceStatLoggerImpl.class, dataSource.getStatLogger());\n            assertInstanceOf(JDBC4ValidConnectionChecker.class, dataSource.getValidConnectionChecker());\n            assertInstanceOf(DruidPasswordCallback.class, dataSource.getPasswordCallback());\n            assertInstanceOf(MySqlExceptionSorter.class, dataSource.getExceptionSorter());\n        } finally {\n            dataSource.close();\n        }\n    }\n}\n"}
[tool-exec] start id=call_fWid151mWHrvfanllCA3QMjd|fc_0116eb80ea4959d8016ad51435604087d0842e8d4dd87a1a5a name=write args={"path": "tests/src/com.alibaba/druid/1.2.28/src/test/java/com_alibaba/druid/LogFactoryTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage com_alibaba.druid;\n\nimport com.alibaba.druid.support.logging.Log;\nimport com.alibaba.druid.support.logging.LogFactory;\nimport com.alibaba.druid.support.logging.SLF4JImpl;\nimport org.junit.jupiter.api.Test;\n\nimport static org.junit.jupiter.api.Assertions.assertInstanceOf;\n\npublic class LogFactoryTest {\n    @Test\n    void selectsSlf4jWhenLogbackIsAvailable() {\n        Log log = LogFactory.getLog(LogFactoryTest.class);\n        assertInstanceOf(SLF4JImpl.class, log);\n    }\n}\n"}
[tool-exec] start id=call_xmamjUXuaVdCsFsNwmgIhGs4|fc_0116eb80ea4959d8016ad51435604887d083fe973951c0a9e1 name=write args={"path": "tests/src/com.alibaba/druid/1.2.28/src/test/java/com_alibaba/druid/JdbcUtilsTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage com_alibaba.druid;\n\nimport com.alibaba.druid.util.JdbcUtils;\nimport java.sql.Driver;\nimport org.junit.jupiter.api.Test;\n\nimport static org.junit.jupiter.api.Assertions.assertEquals;\n\npublic class JdbcUtilsTest {\n    @Test\n    void createsJdbcDriverThroughAvailableClassLoadingPaths() throws Exception {\n        Driver contextual = JdbcUtils.createDriver(null, \"org.h2.Driver\");\n        Driver explicit = JdbcUtils.createDriver(org.h2.Driver.class.getClassLoader(), \"org.h2.Driver\");\n        assertEquals(\"org.h2.Driver\", contextual.getClass().getName());\n        assertEquals(\"org.h2.Driver\", explicit.getClass().getName());\n\n        ClassLoader original = Thread.currentThread().getContextClassLoader();\n        try {\n            Thread.currentThread().setContextClassLoader(null);\n            Driver fallback = JdbcUtils.createDriver(null, \"org.h2.Driver\");\n            assertEquals(\"org.h2.Driver\", fallback.getClass().getName());\n        } finally {\n            Thread.currentThread().setContextClassLoader(original);\n        }\n    }\n}\n"}
[tool-exec] start id=call_JOFkBhKySD12F9aNIMsyn4xV|fc_0116eb80ea4959d8016ad51435605c87d08738c0bc1685cd88 name=write args={"path": "tests/src/com.alibaba/druid/1.2.28/src/test/java/com_alibaba/druid/FilterManagerTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage com_alibaba.druid;\n\nimport com.alibaba.druid.filter.Filter;\nimport com.alibaba.druid.filter.stat.StatFilter;\nimport com.alibaba.druid.pool.DruidDataSource;\nimport java.sql.Connection;\nimport java.sql.Statement;\nimport java.util.List;\nimport org.junit.jupiter.api.Test;\n\nimport static org.junit.jupiter.api.Assertions.assertFalse;\nimport static org.junit.jupiter.api.Assertions.assertTrue;\n\npublic class FilterManagerTest {\n    @Test\n    void resolvesFilterAliasesAndCollectsSqlStatistics() throws Exception {\n        DruidDataSource dataSource = new DruidDataSource();\n        dataSource.setUrl(\"jdbc:h2:mem:druid_filters;DB_CLOSE_DELAY=-1\");\n        dataSource.setFilters(\"stat,mergeStat,wall,encoding,slf4j\");\n\n        try {\n            dataSource.init();\n            try (Connection connection = dataSource.getConnection();\n                    Statement statement = connection.createStatement()) {\n                statement.execute(\"create table filter_item (id integer primary key)\");\n                statement.executeUpdate(\"insert into filter_item values (1)\");\n                assertTrue(statement.executeQuery(\"select id from filter_item\").next());\n            }\n\n            List<Filter> filters = dataSource.getProxyFilters();\n            assertTrue(filters.stream().anyMatch(StatFilter.class::isInstance));\n            assertTrue(filters.size() >= 5);\n            assertFalse(dataSource.getDataSourceStat().getSqlStatMap().isEmpty());\n        } finally {\n            dataSource.close();\n        }\n    }\n}\n"}
[tool-exec] start id=call_cjY5WhPB8g3RTPv8rSXmE3Qk|fc_0116eb80ea4959d8016ad51435606487d0823f105e12720b17 name=write args={"path": "tests/src/com.alibaba/druid/1.2.28/src/test/java/com_alibaba/druid/ConfigFilterTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage com_alibaba.druid;\n\nimport com.alibaba.druid.filter.config.ConfigFilter;\nimport java.util.Properties;\nimport org.junit.jupiter.api.Test;\n\nimport static org.junit.jupiter.api.Assertions.assertEquals;\n\npublic class ConfigFilterTest {\n    @Test\n    void loadsConfigurationFromClasspathForms() {\n        ConfigFilter filter = new ConfigFilter();\n        Properties prefixed = filter.loadConfig(\"classpath:META-INF/druid-filter.properties\");\n        Properties fallback = filter.loadConfig(\"META-INF/druid-filter.properties\");\n\n        assertEquals(\"com.alibaba.druid.filter.stat.StatFilter\", prefixed.getProperty(\"druid.filters.stat\"));\n        assertEquals(prefixed.getProperty(\"druid.filters.stat\"), fallback.getProperty(\"druid.filters.stat\"));\n    }\n}\n"}
