                  Boolean pinGlobTx = (Boolean) method_6_getValue.invoke(
                          method_6_getBooleanReadableProperty.invoke(
                                  method_6_getPropertySet.invoke(physicalConn),
                                  "pinGlobalTxToPhysicalConnection"
                          )
