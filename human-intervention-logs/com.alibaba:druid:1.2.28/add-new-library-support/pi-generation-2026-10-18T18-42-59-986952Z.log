rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\nplugins {\n    id \"org.graalvm.internal.tck\"\n}\n\nString libraryVersion = tck.testedLibraryVersion.get()\n\ndependencies {\n    testImplementation \"com.alibaba:druid:$libraryVersion\"\n    testImplementation 'org.assertj:assertj-core:3.22.0'\n    testImplementation \"com.h2database:h2:2.4.240\"\n    testImplementation \"ch.qos.logback:logback-classic:1.5.20\"\n    testImplementation \"com.mysql:mysql-connector-j:8.0.33\"\n    testImplementation \"org.awaitility:awaitility:4.2.0\"\n}\n\ngraalvmNative {\n    agent {\n        defaultMode = \"conditional\"\n        modes {\n            conditional {\n                userCodeFilterPath = \"user-code-filter.json\"\n            }\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792388963046}, {"role": "toolResult", "toolCallId": "call_bLKGSff2FrL6d0HwFyKO83oF|fc_0dc9bab9baf22fc4016ad5af62555887d09c3cbeb82af01c5c", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage com_alibaba.druid;\n\nimport com.alibaba.druid.util.MySqlUtils;\nimport com.mysql.cj.jdbc.Driver;\nimport java.io.File;\nimport java.io.IOException;\nimport java.sql.Connection;\nimport java.sql.DriverManager;\nimport java.sql.SQLException;\nimport java.time.Duration;\nimport java.util.Properties;\nimport java.util.concurrent.TimeUnit;\nimport javax.sql.XAConnection;\nimport org.awaitility.Awaitility;\nimport org.junit.jupiter.api.AfterAll;\nimport org.junit.jupiter.api.BeforeAll;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.Timeout;\n\nimport static org.junit.jupiter.api.Assertions.assertEquals;\nimport static org.junit.jupiter.api.Assertions.assertNotNull;\nimport static org.junit.jupiter.api.Assertions.assertTrue;\n\npublic class MySqlUtilsTest {\n    private static final String DATABASE = \"druid\";\n    private static final String USERNAME = \"druid\";\n    private static final String PASSWORD = \"secret\";\n    private static final String JDBC_URL = \"jdbc:mysql://localhost:3306/\" + DATABASE\n            + \"?allowPublicKeyRetrieval=true&useSSL=false&connectTimeout=10000&socketTimeout=10000\";\n\n    private static Process mysql;\n\n    @BeforeAll\n    static void startMysql() throws IOException {\n        mysql = new ProcessBuilder(\n                        \"docker\",\n                        \"run\",\n                        \"--rm\",\n                        \"-p\",\n                        \"3306:3306\",\n                        \"-e\",\n                        \"MYSQL_DATABASE=\" + DATABASE,\n                        \"-e\",\n                        \"MYSQL_USER=\" + USERNAME,\n                        \"-e\",\n                        \"MYSQL_PASSWORD=\" + PASSWORD,\n                        \"container-registry.oracle.com/mysql/community-server:26.7.1\")\n                .redirectOutput(new File(\"druid-mysql-stdout.txt\"))\n                .redirectError(new File(\"druid-mysql-stderr.txt\"))\n                .start();\n\n        Awaitility.await().atMost(Duration.ofSeconds(50)).ignoreExceptionsInstanceOf(SQLException.class).until(() -> {\n            try (Connection connection = openConnection(false)) {\n                return connection.isValid(10);\n            }\n        });\n    }\n\n    @AfterAll\n    static void stopMysql() throws InterruptedException {\n        if (mysql != null && mysql.isAlive()) {\n            mysql.destroy();\n            if (!mysql.waitFor(10, TimeUnit.SECONDS)) {\n                mysql.destroyForcibly();\n                mysql.waitFor(10, TimeUnit.SECONDS);\n            }\n        }\n    }\n\n    @Test\n    @Timeout(59)\n    @SuppressWarnings(\"deprecation\")\n    void exposesConnectionStateAndCreatesXaConnections() throws Exception {\n        Driver driver = new Driver();\n        try (Connection physical = openConnection(false)) {\n            Long connectionId = MySqlUtils.getId(physical);\n            assertNotNull(connectionId);\n            assertTrue(connectionId > 0);\n            assertEquals(\"KILL QUERY \" + connectionId, MySqlUtils.buildKillQuerySql(physical, null));\n\n            long lastPacketReceived = MySqlUtils.getLastPacketReceivedTimeMs(physical);\n            assertTrue(lastPacketReceived > 0);\n            assertTrue(lastPacketReceived <= System.currentTimeMillis());\n\n            assertXaConnectionWorks(driver, physical);\n        }\n\n        try (Connection pinnedPhysical = openConnection(true)) {\n            assertXaConnectionWorks(driver, pinnedPhysical);\n        }\n    }\n\n    private static Connection openConnection(boolean pinGlobalTransaction) throws SQLException {\n        Properties properties = new Properties();\n        properties.setProperty(\"user\", USERNAME);\n        properties.setProperty(\"password\", PASSWORD);\n        properties.setProperty(\"pinGlobalTxToPhysicalConnection\", Boolean.toString(pinGlobalTransaction));\n        return DriverManager.getConnection(JDBC_URL, properties);\n    }\n\n    private static void assertXaConnectionWorks(Driver driver, Connection physical) throws Exception {\n        XAConnection xaConnection = MySqlUtils.createXAConnection(driver, physical);\n        try {\n            try (Connection logical = xaConnection.getConnection()) {\n                assertTrue(logical.isValid(10));\n            }\n        } finally {\n            xaConnection.close();\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792388963046}, {"role": "toolResult", "toolCallId": "call_vn721xTZvtPsdy5Sg9whIAKo|fc_0dc9bab9baf22fc4016ad5af62556087d0a537bed745093ba7", "toolName": "read", "content": [{"type": "text", "text": "container-registry.oracle.com/mysql/community-server:26.7.1\n"}], "isError": false, "timestamp": 1792388963047}, {"role": "toolResult", "toolCallId": "call_yTh74d0QEkAdqYHDtaCC1Vsg|fc_0dc9bab9baf22fc4016ad5af62556887d089b9e9575741ce7f", "toolName": "bash", "content": [{"type": "text", "text": "787ea51541 (HEAD -> ai/kimeta/add-lib-support-com.alibaba-druid-1.2.28) Partial dynamic-access coverage for com.alibaba.druid.util.MySqlUtils (12/21)\ncb0f8aafce Cover Druid concrete filter loading\n9b233c2ed0 Fix Druid filter and monitor fixtures\n?? metadata/com.alibaba/druid/1.2.28/\n"}], "isError": false, "timestamp": 1792388963047}]}
