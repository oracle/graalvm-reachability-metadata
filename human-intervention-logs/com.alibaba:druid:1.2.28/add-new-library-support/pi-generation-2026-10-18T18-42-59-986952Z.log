ource);\n            assertNotNull(sqlStats);\n            assertFalse(sqlStats.isEmpty());\n            JdbcSqlStat sqlStat = (JdbcSqlStat) sqlStats.values().iterator().next();\n            assertNotNull(DruidDataSourceUtils.getSqlStat(dataSource, (int) sqlStat.getId()));\n            assertNotNull(DruidDataSourceUtils.getWallStatMap(dataSource));\n            assertNotNull(DruidDataSourceUtils.getPoolingConnectionInfo(dataSource));\n        } finally {\n            dataSource.close();\n        }\n    }\n\n    public static final class DerivedDataSource extends DruidDataSource {\n    }\n}\n"}], "isError": false, "timestamp": 1792349867413}, {"role": "toolResult", "toolCallId": "call_WytmkIQ3mIteyUU3vdYHbXwR|fc_0116eb80ea4959d8016ad516aa053887d0bd26693beaa7623d", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage com_alibaba.druid;\n\nimport com.alibaba.druid.util.Utils;\nimport java.util.HashSet;\nimport java.util.Set;\nimport org.junit.jupiter.api.Test;\n\nimport static org.junit.jupiter.api.Assertions.assertEquals;\nimport static org.junit.jupiter.api.Assertions.assertFalse;\nimport static org.junit.jupiter.api.Assertions.assertNotNull;\nimport static org.junit.jupiter.api.Assertions.assertTrue;\n\npublic class UtilsTest {\n    private static final String FILTER_RESOURCE = \"META-INF/druid-filter.properties\";\n\n    @Test\n    void loadsClassesAndBundledResources() throws Exception {\n        assertEquals(Utils.class, Utils.loadClass(\"com.alibaba.druid.util.Utils\"));\n        assertFalse(Utils.loadProperties(FILTER_RESOURCE).isEmpty());\n        assertFalse(Utils.readLines(FILTER_RESOURCE).isEmpty());\n        assertTrue(Utils.readFromResource(FILTER_RESOURCE).contains(\"druid.filters.stat\"));\n        assertTrue(Utils.readByteArrayFromRes