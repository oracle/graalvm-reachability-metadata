          ClassLoader ctxClassLoader = Thread.currentThread().getContextClassLoader();
          if (ctxClassLoader != null) {
              try {
                  clazz = ctxClassLoader.loadClass(className);
              } catch (ClassNotFoundException e) {
                  // skip
              }
          }
  
          return clazz;
      }
  
