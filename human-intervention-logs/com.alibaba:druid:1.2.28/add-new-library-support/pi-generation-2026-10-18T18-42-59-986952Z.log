ss H2UtilsTest {\n    @Test\n    void createsXaConnectionAroundPhysicalH2Connection() throws Exception {\n        Object factory = H2Utils.createJdbcDataSourceFactory();\n        assertTrue(H2Utils.getNextId(H2Utils.XA_DATA_SOURCE) >= 0);\n\n        try (Connection physical = DriverManager.getConnection(\"jdbc:h2:mem:druid_h2_xa;DB_CLOSE_DELAY=-1\")) {\n            XAConnection xaConnection = H2Utils.createXAConnection(factory, physical);\n            try (Connection logical = xaConnection.getConnection()) {\n                assertTrue(logical.isValid(10));\n            } finally {\n                xaConnection.close();\n            }\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792388176693}, {"role": "toolResult", "toolCallId": "call_dyqdYR7bYqClbDMfGPYV4son|fc_0dc9bab9baf22fc4016ad5ac4fec1087d0ae7f7ce80b66e537", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage com_alibaba.druid;\n\nimport com.alibaba.druid.proxy.DruidDriver;\nimport java.lang.management.ManagementFactory;\nimport java.sql.Driver;\nimport javax.management.MBeanInfo;\nimport javax.management.MBeanServer;\nimport javax.management.ObjectName;\nimport org.junit.jupiter.api.Test;\n\nimport static org.junit.jupiter.api.Assertions.assertEquals;\nimport static org.junit.jupiter.api.Assertions.assertTrue;\n\npublic class DruidDriverTest {\n    @Test\n    void createsWrappedDriverAndPublishesMBean() throws Exception {\n        Driver driver = DruidDriver.createDriver(\"org.h2.Driver\");\n        assertEquals(\"org.h2.Driver\", driver.getClass().getName());\n\n        MBeanServer server = ManagementFactory.getPlatformMBeanServer();\n        MBeanInfo info = server.getMBeanInfo(new ObjectName(\"com.alibaba.druid:type=DruidDriver\"));\n        assertTrue(info.getAttributes().length > 0);\n    }\n}\n"}], "isError": false, "timestamp": 1792388176693}, {"role": "toolResult", "toolCallId": "call_9HiYeZ0kec56ynhkG3toql2o|fc_0dc9bab9baf22fc4016ad5ac4fec1887d09a3393abd1609e47", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage com_alibaba.druid;\n\nimport com.alibaba.druid.mock.MockDriver;\nimport java.lang.management.ManagementFactory;\nimport java.sql.Connection;\nimport java.util.Properties;\nimport javax.management.MBeanInfo;\nimport javax.management.MBeanServer;\nimport javax.management.ObjectName;\nimport org.junit.jupiter.api.Test;\n\nimport static org.junit.jupiter.api.Assertions.assertNotNull;\nimport static org.junit.jupiter.api.Assertions.assertTrue;\n\npublic class MockDriverTest {\n    @Test\n    void opensMockConnectionAndPublishesMBean() throws Exception {\n        try (Connection connection = MockDriver.instance.connect(\"jdbc:mock:test\", new Properties())) {\n            assertNotNull(connection);\n        }\n\n        MBeanServer server = ManagementFactory.getPlatformMBeanServer();\n        MBeanInfo info = server.getMBeanInfo(new ObjectName(\"com.alibaba.druid:type=MockDriver\"));\n        assertTrue(info.getAttributes().length > 0);\n    }\n}\n"}], "isError": false, "timestamp": 1792388176693}]}
