ssNames.split(\",\")) {\n   108\t                if (existsFilter(filters, filterClassName)) {\n   109\t                    continue;\n   110\t                }\n   111\t\n   112\t                Class<?> filterClass = Utils.loadClass(filterClassName);\n   113\t\n   114\t                if (filterClass == null) {\n   115\t                    LOG.error(\"load filter error, filter not found : \" + filterClassName);\n   116\t                    continue;\n   117\t                }\n   118\t\n   119\t                Filter filter;\n   120\t\n   121\t                try {\n   122\t                    filter = (Filter) filterClass.newInstance();\n   123\t                } catch (ClassCastException e) {\n   124\t                    LOG.error(\"load filter error.\", e);\n   125\t                    continue;\n   126\t                } catch (NoSuchFieldError e) {\n   127\t                    LOG.error(\"load filter error.\", e);\n   128\t                    continue;\n   129\t                } catch (InstantiationException e) {\n   130\t                    throw new SQLException(\"load managed jdbc driver event listener error. \" + filterName, e);\n   131\t                } catch (IllegalAccessException e) {\n   132\t                    throw new SQLException(\"load managed jdbc driver event listener error. \" + filterName, e);\n   133\t                } catch (RuntimeException e) {\n   134\t                    throw new SQLException(\"load managed jdbc driver event listener error. \" + filterName, e);\n   135\t                }\n   136\t\n   137\t                filters.add(filter);\n   138\t            }\n   139\t\n   140\t            return;\n   141\t        }\n   142\t\n   143\t        if (existsFilter(filters, filterName)) {\n   144\t            return;\n   145\t        }\n   146\t\n   147\t        Class<?> filterClass = Utils.loadClass(filterName);\n   148\t        if (filterClass == null) {\n   149\t            LOG.error(\"load filter error, filter not found : \" + filterName);\n   150\t            return;\n   151\t        }\n   152\t\n   153\t        try {\n   154\t            Filter filter = (Filter) filterClass.newInstance();\n   155\t            filters.add(filter);\n   156\t        } catch (Exception e) {\n   157\t            throw new SQLException(\"load managed jdbc driver event listener error. \" + filterName, e);\n   158\t        }\n   159\t    }\n   160\t\n   161\t    private static boolean existsFilter(List<Filter> filterList, String filterClassName) {\n   162\t        for (Filter filter : filterList) {\n   163\t            String itemFilterClassName = filter.getClass().getName();\n   164\t            if (itemFilterClassName.equalsIgnoreCase(filterClassName)) {\n   165\t                return true;\n   166\t            }\n   167\t        }\n   168\t        return false;\n   169\t    }\n   170\t}\n"}], "isError": false, "timestamp": 1792384062856}}
