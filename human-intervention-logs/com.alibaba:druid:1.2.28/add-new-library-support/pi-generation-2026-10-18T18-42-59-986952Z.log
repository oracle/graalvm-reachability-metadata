                  if (pinGlobTx != null && pinGlobTx) {
                      try {
                          if (method_6_getInstance == null && !method_6_getInstance_error) {
                              class_6_suspendableXAConnection = Class.forName("com.mysql.cj.jdbc.SuspendableXAConnection");
