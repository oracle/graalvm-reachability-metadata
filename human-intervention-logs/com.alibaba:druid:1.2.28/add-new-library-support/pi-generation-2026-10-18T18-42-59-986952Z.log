.xa_forget(connection, xaConnection.getXAConnectionID(), xid);\n    80\t    }\n    81\t\n    82\t    @Override\n    83\t    public int getTransactionTimeout() throws XAException {\n    84\t        return 0;\n    85\t    }\n    86\t\n    87\t    @Override\n    88\t    public boolean isSameRM(XAResource xares) throws XAException {\n    89\t        if (xares instanceof JtdsXAResource) {\n    90\t            if (((JtdsXAResource) xares).getRmHost().equals(this.rmHost)) {\n    91\t                return true;\n    92\t            }\n    93\t        }\n    94\t        return false;\n    95\t    }\n    96\t\n    97\t    @Override\n    98\t    public int prepare(Xid xid) throws XAException {\n    99\t        return XASupport.xa_prepare(connection, xaConnection.getXAConnectionID(), xid);\n   100\t    }\n   101\t\n   102\t    @Override\n   103\t    public Xid[] recover(int flags) throws XAException {\n   104\t        return XASupport.xa_recover(connection, xaConnection.getXAConnectionID(), flags);\n   105\t    }\n   106\t\n   107\t    @Override\n   108\t    public void rollback(Xid xid) throws XAException {\n   109\t        XASupport.xa_rollback(connection, xaConnection.getXAConnectionID(), xid);\n   110\t    }\n   111\t\n   112\t    @Override\n   113\t    public boolean setTransactionTimeout(int seconds) throws XAException {\n   114\t        return false;\n   115\t    }\n   116\t\n   117\t    @Override\n   118\t    public void start(Xid xid, int flags) throws XAException {\n   119\t        XASupport.xa_start(connection, xaConnection.getXAConnectionID(), xid, flags);\n   120\t    }\n"}], "isError": false, "timestamp": 1792390170320}}
