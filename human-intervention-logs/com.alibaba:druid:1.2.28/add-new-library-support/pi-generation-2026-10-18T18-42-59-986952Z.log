/\npackage com_alibaba.druid;\n\nimport com.alibaba.druid.filter.Filter;\nimport com.alibaba.druid.filter.config.ConfigFilter;\nimport com.alibaba.druid.filter.stat.StatFilter;\nimport com.alibaba.druid.pool.DruidDataSource;\nimport java.sql.Connection;\nimport java.sql.Statement;\nimport java.util.List;\nimport org.junit.jupiter.api.Test;\n\nimport static org.junit.jupiter.api.Assertions.assertFalse;\nimport static org.junit.jupiter.api.Assertions.assertTrue;\n\npublic class FilterManagerTest {\n    @Test\n    void resolvesFilterAliasesAndCollectsSqlStatistics() throws Exception {\n        DruidDataSource dataSource = new DruidDataSource();\n        dataSource.setUrl(\"jdbc:h2:mem:druid_filters;DB_CLOSE_DELAY=-1\");\n        dataSource.setFilters(\"stat,mergeStat,wall,encoding,slf4j,\" + ConfigFilter.class.getName());\n\n        try {\n            dataSource.init();\n            try (Connection connection = dataSource.getConnection();\n                    Statement statement = connection.createStatement()) {\n                statement.execute(\"create table filter_item (id integer primary key)\");\n                statement.executeUpdate(\"insert into filter_item values (1)\");\n                assertTrue(statement.executeQuery(\"select id from filter_item\").next());\n            }\n\n            List<Filter> filters = dataSource.getProxyFilters();\n            assertTrue(filters.stream().anyMatch(StatFilter.class::isInstance));\n            assertTrue(filters.stream().anyMatch(ConfigFilter.class::isInstance));\n            assertTrue(filters.size() >= 6);\n            assertFalse(dataSource.getDataSourceStat().getSqlStatMap().isEmpty());\n        } finally {\n            dataSource.close();\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792384037517}, {"role": "toolResult", "toolCallId": "call_rgFkIXg15PnhaVZNOHqYuKrq|fc_0854bfb75c642b6a016ad59c20a46c87d091bf6c75448c68a2", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage com_alibaba.druid;\n\nimport com.alibaba.druid.support.logging.Jdk14LoggingImpl;\nimport com.alibaba.druid.support.logging.Log;\nimport com.alibaba.druid.support.logging.LogFactory;\nimport com.alibaba.druid.support.logging.SLF4JImpl;\nimport org.junit.jupiter.api.Test;\n\nimport static org.junit.jupiter.api.Assertions.assertInstanceOf;\n\npublic class LogFactoryTest {\n    @Test\n    void selectsAvailableLoggingImplementations() {\n        Log defaultLog = LogFactory.getLog(LogFactoryTest.class);\n        assertInstanceOf(SLF4JImpl.class, defaultLog);\n\n        LogFactory.selectJavaLogging();\n        assertInstanceOf(Jdk14LoggingImpl.class, LogFactory.getLog(LogFactoryTest.class));\n    }\n}\n"}], "isError": false, "timestamp": 1792384037517}, {"role": "toolResult", "toolCallId": "call_yUXQu3tCVf0NzCVj5kD6X6eg|fc_0854bfb75c642b6a016ad59c20a47487d081ab02f89fb03cd4", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage com_alibaba.druid;\n\nimport com.alibaba.druid.pool.DruidDataSource;\nimport com.alibaba.druid.pool.DruidDataSourceStatLoggerImpl;\nimport com.alibaba.druid.pool.JDBC4ValidConnectionChecker;\nimport com.alibaba.druid.pool.vendor.MySqlExceptionSorter;\nimport com.alibaba.druid.util.DruidPasswordCallback;\nimport org.junit.jupiter.api.Test;\n\nimport static org.junit.jupiter.api.Assertions.assertInstanceOf;\n\npublic class DruidAbstractDataSourceTest {\n    @Test\n    void configuresExtensionTypesByClassName() throws Exception {\n        DruidDataSource dataSource = new DruidDataSource();\n        try {\n            dataSource.setStatLoggerClassName(DruidDataSourceStatLoggerImpl.class.getName());\n            dataSource.setValidConnectionCheckerClassName(JDBC4ValidConnectionChecker.class.getName());\n            dataSource.setPasswordCallbackClassName(DruidPasswordCallback.class.getName());\n            dataSource.setExceptionSorter(MySqlExceptionSorter.class.getName());\n\n            assertInstanceOf(DruidDataSourceStatLoggerImpl.class, dataSource.getStatLogger());\n            assertInstanceOf(JDBC4ValidConnectionChecker.class, dataSource.getValidConnectionChecker());\n            assertInstanceOf(DruidPasswordCallback.class, dataSource.getPasswordCallback());\n            assertInstanceOf(MySqlExceptionSorter.class, dataSource.getExceptionSorter());\n        } finally {\n            dataSource.close();\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792384037518}, {"role": "toolResult", "toolCallId": "call_g8TegUqW5ZOOYYfbw4bXKnxc|fc_0854bfb75c642b6a016ad59c20a47c87d0980e6a2fb37b0b94", "toolName": "read", "content": [{"type": "text", "text": "{\n  \"reflection\": [\n    {\n      \"condition\": {\n        \"typeReached\": \"com.alibaba.druid.support.logging.LogFactory\"\n      },\n      \"type\": \"com.alibaba.druid.support.logging.SLF4JImpl\",\n      \"methods\": [\n        {\n          \"name\": \"<init>\",\n          \"parameterTypes\": [\n            \"java.lang.String\"\n          ]\n        }\n      ]\n    },\n    {\n      \"condition\": {\n        \"typeReached\": \"com.alibaba.druid.support.logging.LogFactory\"\n      },\n      \"type\": \"org.slf4j.Logger\"\n    },\n    {\n      \"condition\": {\n        \"typeReached\": \"com.alibaba.druid.support.logging.LogFactory\"\n      },\n      \"type\": \"org.apache.log4j.Logger\"\n    },\n    {\n      \"condition\": {\n        \"typeReached\": \"com.alibaba.druid.support.logging.LogFactory\"\n      },\n      \"type\": \"org.apache.logging.log4j.Logger\"\n    },\n    {\n      \"condition\": {\n        \"typeReached\": \"com.alibaba.druid.