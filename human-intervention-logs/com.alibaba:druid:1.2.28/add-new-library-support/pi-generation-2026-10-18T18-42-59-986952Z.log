7Teo|fc_0993d93647163b2e016ad5bd17967887d0a8f3abf3d1059f25", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage com_alibaba.druid;\n\nimport com.alibaba.druid.util.Utils;\nimport java.util.HashSet;\nimport java.util.Set;\nimport org.junit.jupiter.api.Test;\n\nimport static org.junit.jupiter.api.Assertions.assertEquals;\nimport static org.junit.jupiter.api.Assertions.assertFalse;\nimport static org.junit.jupiter.api.Assertions.assertNotNull;\nimport static org.junit.jupiter.api.Assertions.assertTrue;\n\npublic class UtilsTest {\n    private static final String FILTER_RESOURCE = \"META-INF/druid-filter.properties\";\n\n    @Test\n    void loadsClassesAndBundledResources() throws Exception {\n        assertEquals(Utils.class, Utils.loadClass(\"com.alibaba.druid.util.Utils\"));\n        assertFalse(Utils.loadProperties(FILTER_RESOURCE).isEmpty());\n        assertFalse(Utils.readLines(FILTER_RESOURCE).isEmpty());\n        assertTrue(Utils.readFromResource(FILTER_RESOURCE).contains(\"druid.filters.stat\"));\n        assertTrue(Utils.readByteArrayFromResource(FILTER_RESOURCE).length > 0);\n\n        Set<String> lines = new HashSet<>();\n        Utils.loadFromFile(FILTER_RESOURCE, lines);\n        assertFalse(lines.isEmpty());\n\n        ClassLoader original = Thread.currentThread().getContextClassLoader();\n        try {\n            Thread.currentThread().setContextClassLoader(ClassLoader.getPlatformClassLoader());\n            assertNotNull(Utils.readFromResource(\"/META-INF/druid-filter.properties\"));\n        } finally {\n            Thread.currentThread().setContextClassLoader(original);\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792392471919}, {"role": "toolResult", "toolCallId": "call_msB2W58Yv7Rjvwo5ieikEUjV|fc_0993d93647163b2e016ad5bd17969887d0a74009953db9beb8", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage com_alibaba.druid;\n\nimport com.alibaba.druid.support.logging.Jdk14LoggingImpl;\nimport com.alibaba.druid.support.logging.Log;\nimport com.alibaba.druid.support.logging.LogFactory;\nimport com.alibaba.druid.support.logging.SLF4JImpl;\nimport org.junit.jupiter.api.Test;\n\nimport static org.junit.jupiter.api.Assertions.assertInstanceOf;\n\npublic class LogFactoryTest {\n    @Test\n    void selectsAvailableLoggingImplementations() {\n        Log defaultLog = LogFactory.getLog(LogFactoryTest.class);\n        assertInstanceOf(SLF4JImpl.class, defaultLog);\n\n        LogFactory.selectJavaLogging();\n        assertInstanceOf(Jdk14LoggingImpl.class, LogFactory.getLog(LogFactoryTest.class));\n    }\n}\n"}], "isError": false, "timestamp": 1792392471919}, {"role": "toolResult", "toolCallId": "call_tAhrFAKJv2hFG3JXObH8WGVX|fc_0993d93647163b2e016ad5bd1796a487d08e2e5f2c706ee27e", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage com_alibaba.druid;\n\nimport com.alibaba.druid.filter.Filter;\nimport com.alibaba.druid.filter.FilterManager;\nimport com.alibaba.druid.filter.config.ConfigFilter;\nimport com.alibaba.druid.filter.stat.StatFilter;\nimport com.alibaba.druid.pool.DruidDataSource;\nimport java.sql.Connection;\nimport java.sql.Statement;\nimport java.util.ArrayList;\nimport java.util.List;\nimport org.junit.jupiter.api.Test;\n\nimport static org.junit.jupiter.api.Assertions.assertEquals;\nimport static org.junit.jupiter.api.Assertions.assertFalse;\nimport static org.junit.jupiter.api.Assertions.assertInstanceOf;\nimport static org.junit.jupiter.api.Assertions.assertTrue;\n\npublic class FilterManagerTest {\n    @Test\n    void loadsFilterByConcreteClassName() throws Exception {\n        List<Filter> filters = new ArrayList<>();\n\n        FilterManager.loadFilter(filters, ConfigFilter.class.getName());\n\n        assertEquals(1, filters.size());\n        assertInstanceOf(ConfigFilter.class, filters.get(0));\n    }\n\n    @Test\n    void resolvesFilterAliasesAndCollectsSqlStatistics() throws Exception {\n        DruidDataSource dataSource = new DruidDataSource();\n        dataSource.setUrl(\"jdbc:h2:mem:druid_filters;DB_CLOSE_DELAY=-1\");\n        dataSource.setFilters(\"stat,mergeStat,wall,encoding,slf4j,\" + ConfigFilter.class.getName());\n\n        try {\n            dataSource.init();\n            try (Connection connection = dataSource.getConnection();\n                    Statement statement = connection.createStatement()) {\n                statement.execute(\"create table filter_item (id integer primary key)\");\n                statement.executeUpdate(\"insert into filter_item values (1)\");\n                assertTrue(statement.executeQuery(\"select id from filter_item\").next());\n            }\n\n            List<Filter> filters = dataSource.getProxyFilters();\n            assertTrue(filters.stream().anyMatch(StatFilter.class::isInstance));\n            assertTrue(filters.stream().anyMatch(ConfigFilter.class::isInstance));\n            assertTrue(filters.size() >= 6);\n            assertFalse(dataSource.getDataSourceStat().getSqlStatMap().isEmpty());\n        } finally {\n            dataSource.close();\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792392471919}, {"role": "toolResult", "toolCallId": "call_d4gNNkp0ZaUqT6ydWzKnO58H|fc_0993d93647163b2e016ad5bd1796b087d09134cde491c39c99", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage com_alibaba.druid;\n\nimport com.alibaba.druid.pool.DruidDataSource;\nimport com.alibaba.druid.stat.DruidDataSourceStatManager;\nimport java.lang.management.ManagementFactory;\nimport javax.management.MBeanInfo;\nimport javax.management.MBeanServer;\nimport javax.management.ObjectName;\nimport org.junit.jupiter.api.Test;\n\nimport static org.junit.jupiter.api.Assertions.assertNotNull;\nimport static org.junit.jupiter.api.Assertions.assertTrue;\n\npublic class DruidDataSourceStatManagerTest {\n    @Test\n    void managesDataSourceStatisticsAndPublishesMBeans() throws Exception {\n        DruidDataSource dataSource = new DruidDataSource();\n        dataSource.setName(\"jmx-pool\");\n        dataSource.setUrl(\"jdbc:h2:mem:druid_jmx;DB_CLOSE_DELAY=-1\");\n\n        try {\n            dataSource.init();\n            DruidDataSourceStatManager manager = DruidDataSourceStatManager.getInstance();\n            manager.reset();\n            manager.logAndResetDataSource();\n\n            MBeanServer server = ManagementFactory.getPlatformMBeanServer();\n            assertHasAttributes(server, new ObjectName(\"com.alibaba.druid:type=DruidDataSourceStat\"));\n            assertNotNull(dataSource.getObjectName());\n            assertHasAttributes(server, dataSource.getObjectName());\n        } finally {\n            dataSource.close();\n        }\n    }\n\n    private static void assertHasAttributes(MBeanServer server, ObjectName name) throws Exception {\n        MBeanInfo info = server.getMBeanInfo(name);\n        assertTrue(info.getAttributes().length > 0, name.toString());\n    }\n}\n"}], "isError": false, "timestamp": 1792392471919}, {"role": "toolResult", "toolCallId": "call_w7T836H21nauReeyy2S33wVe|fc_0993d93647163b2e016ad5bd1796c087d0b3fc4fc6863ac30d", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage com_alibaba.druid;\n\nimport com.alibaba.druid.proxy.DruidDriver;\nimport java.lang.management.ManagementFactory;\nimport java.sql.Driver;\nimport javax.management.MBeanInfo;\nimport javax.management.MBeanServer;\nimport javax.management.ObjectName;\nimport org.junit.jupiter.api.Test;\n\nimport static org.junit.jupiter.api.Assertions.assertEquals;\nimport static org.junit.jupiter.api.Assertions.assertTrue;\n\npublic class DruidDriverTest {\n    @Test\n    void createsWrappedDriverAndPublishesMBean() throws Exception {\n        Driver driver = DruidDriver.createDriver(\"org.h2.Driver\");\n        assertEquals(\"org.h2.Driver\", driver.getClass().getName());\n\n        MBeanServer server = ManagementFactory.getPlatformMBeanServer();\n        MBeanInfo info = server.getMBeanInfo(new ObjectName(\"com.alibaba.druid:type=DruidDriver\"));\n        assertTrue(info.getAttributes().length > 0);\n    }\n}\n"}], "isError": false, "timestamp": 1792392471919}, {"role": "toolResult", "toolCallId": "call_149ZzDa6kXpeFeCl62leWuUl|fc_0993d93647163b2e016ad5bd1796cc87d081887919dc0d0cfe", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage com_alibaba.druid;\n\nimport com.alibaba.druid.mock.MockDriver;\nimport java.lang.management.ManagementFactory;\nimport java.sql.Connection;\nimport java.util.Properties;\nimport javax.management.MBeanInfo;\nimport javax.management.MBeanServer;\nimport javax.management.ObjectName;\nimport org.junit.jupiter.api.Test;\n\nimport static org.junit.jupiter.api.Assertions.assertNotNull;\nimport static org.junit.jupiter.api.Assertions.assertTrue;\n\npublic class MockDriverTest {\n    @Test\n    void opensMockConnectionAndPublishesMBean() throws Exception {\n        try (Connection connection = MockDriver.instance.connect(\"jdbc:mock:test\", new Properties())) {\n            assertNotNull(connection);\n        }\n\n        MBeanServer server = ManagementFactory.getPlatformMBeanServer();\n        MBeanInfo info = server.getMBeanInfo(new ObjectName(\"com.alibaba.druid:type=MockDriver\"));\n        assertTrue(info.getAttributes().length > 0);\n    }\n}\n"}], "isError": false, "timestamp": 1792392471919}, {"role": "toolResult", "toolCallId": "call_8zHIdFoZMzPBCF0UADrFzu04|fc_0993d93647163b2e016ad5bd1796d487d09247cce52d3cdc97", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\nplugins {\n    id \"org.graalvm.internal.tck\"\n}\n\nString libraryVersion = tck.testedLibraryVersion.get()\n\ndependencies {\n    testImplementation \"com.alibaba:druid:$libraryVersion\"\n    testImplementation 'org.assertj:assertj-core:3.22.0'\n    testImplementation \"com.h2database:h2:2.4.240\"\n    testImplementation \"ch.qos.logback:logback-classic:1.5.20\"\n    testImplementation \"mysql:mysql-connector-java:5.1.49\"\n    testImplementation \"org.awaitility:awaitility:4.2.0\"\n}\n\ngraalvmNative {\n    agent {\n        defaultMode = \"conditional\"\n        modes {\n            conditional {\n                userCodeFilterPath = \"user-code-filter.json\"\n            }\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792392471920}, {"role": "toolResult", "toolCallId": "call_aq7VJYqEpTf0Pp0aQ1bEWiLB|fc_0993d93647163b2e016ad5bd1796e087d0ae1c32dfbbce4cde", "toolName": "bash", "content": [{"type": "text", "text": "\n--- metadata files/status ---\nmetadata/com.alibaba/druid/1.2.28/reachabi