util.List;\nimport java.util.Map;\nimport org.junit.jupiter.api.Test;\n\nimport static org.junit.jupiter.api.Assertions.assertEquals;\nimport static org.junit.jupiter.api.Assertions.assertInstanceOf;\n\npublic class MonitorDaoJdbcImplTest {\n    @Test\n    void createsMonitoredValueFromBeanDescription() {\n        MonitorDaoJdbcImpl dao = new MonitorDaoJdbcImpl();\n        MonitorDaoJdbcImpl.BeanInfo beanInfo = new MonitorDaoJdbcImpl.BeanInfo(JdbcSqlStatValue.class);\n        assertInstanceOf(JdbcSqlStatValue.class, dao.createInstance(beanInfo));\n    }\n\n    @Test\n    void persistsAndLoadsSqlStatistics() throws Exception {\n        DruidDataSource dataSource = new DruidDataSource();\n        dataSource.setUrl(\"jdbc:h2:mem:druid_monitor;MODE=MySQL;NON_KEYWORDS=VALUE;DB_CLOSE_DELAY=-1\");\n\n        try {\n            MonitorDaoJdbcImpl dao = new MonitorDaoJdbcImpl();\n            dao.setDataSource(dataSource);\n            dao.createTables(\"mysql\");\n            try (Connection connection = dataSource.getConnection();\n                    Statement statement = connection.createStatement()) {\n                statement.execute(\"alter table druid_datasource add keepAliveCheckCount bigint\");\n            }\n\n            long collectedAt = System.currentTimeMillis();\n            MonitorContext context = new MonitorContext();\n            context.setCollectTime(new Date(collectedAt));\n            context.setPID(7);\n\n            JdbcSqlStatValue sqlStat = new JdbcSqlStatValue();\n            sqlStat.setSqlHash(42L);\n            sqlStat.setSql(\"select 42\");\n            sqlStat.setDbType(\"h2\");\n\n            DruidDataSourceStatValue dataSourceStat = new DruidDataSourceStatValue();\n            dataSourceStat.setName(\"monitor-pool\");\n            dataSourceStat.setDbType(\"h2\");\n            dataSourceStat.setSqlList(List.of(sqlStat));\n            dao.saveSql(context, List.of(dataSourceStat));\n\n            Map<String, Object> filters = Map.of(\n                    \"startTime\", collectedAt - 1000L,\n                    \"endTime\", collectedAt + 1000L);\n            List<JdbcSqlStatValue> loaded = dao.loadSqlList(filters);\n\n            assertEquals(1, loaded.size());\n            assertEquals(\"select 42\", loaded.get(0).getSql());\n            assertEquals(42L, loaded.get(0).getSqlHash());\n        } finally {\n            dataSource.close();\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792373155534}, {"role": "toolResult", "toolCallId": "call_okBcGjRadjofIoaZv8V7sgcg|fc_0a44ef908d51306f016ad571a1a07c87d0b164d9f35b130236", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage com_alibaba.druid;\n\nimport com.alibaba.druid.filter.Filter;\nimport com.alibaba.druid.filter.config.ConfigFilter;\nimport com.alibaba.druid.filter.stat.StatFilter;\nimport com.alibaba.druid.pool.DruidDataSource;\nimport java.sql.Connection;\nimport java.sql.Statement;\nimport java.util.List;\nimport org.junit.jupiter.api.Test;\n\nimport static org.junit.jupiter.api.Assertions.assertFalse;\nimport static org.junit.jupiter.api.Assertions.assertTrue;\n\npublic class FilterManagerTest {\n    @Test\n    void resolvesFilterAliasesAndCollectsSqlStatistics() throws Exception {\n        DruidDataSource dataSource = new DruidDataSource();\n        dataSource.setUrl(\"jdbc:h2:mem:druid_filters;DB_CLOSE_DELAY=-1\");\n        dataSource.setFilters(\"stat,mergeStat,wall,encoding,slf4j,\" + ConfigFilter.class.getName());\n\n        try {\n            dataSource.init();\n            try (Connection connection = dataSource.getConnection();\n                    Statement statement = connection.createStatement()) {\n                statement.execute(\"create table filter_item (id integer primary key)\");\n                statement.executeUpdate(\"insert into filter_item values (1)\");\n                assertTrue(statement.executeQuery(\"select id from filter_item\").next());\n            }\n\n            List<Filter> filters = dataSource.getProxyFilters();\n            assertTrue(filters.stream().anyMatch(StatFilter.class::isInstance));\n            assertTrue(filters.stream().anyMatch(ConfigFilter.class::isInstance));\n            assertTrue(filters.size() >= 6);\n            assertFalse(dataSource.getDataSourceStat().getSqlStatMap().isEmpty());\n        } finally {\n            dataSource.close();\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792373155534}]}
