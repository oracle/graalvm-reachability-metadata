          this.domain = domain;
      }
  
      public String getApp() {
          return app;
      }
  
      public void setApp(String app) {
          this.app = app;
      }
  
      public String getCluster() {
          return cluster;
      }
  
      public void setCluster(String cluster) {
          this.cluster = cluster;
      }
  
  }
