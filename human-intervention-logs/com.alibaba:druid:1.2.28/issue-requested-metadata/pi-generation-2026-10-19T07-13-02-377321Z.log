uid:type=MockDriver\"));\n        assertTrue(info.getAttributes().length > 0);\n    }\n"}]}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-sol", "usage": {"input": 660, "output": 1166, "cacheRead": 95104, "cacheWrite": 0, "reasoning": 699, "totalTokens": 96930, "cost": {"input": 0.00264, "output": 0.02332, "cacheRead": 0.0380416, "cacheWrite": 0, "total": 0.0640016}}, "stopReason": "toolUse", "timestamp": 1792394160527, "responseId": "resp_02dd95b875e76f5d016ad5c3b0ffe487d0ab867f2d5ea3c54f", "rawStopReason": "completed"}}
