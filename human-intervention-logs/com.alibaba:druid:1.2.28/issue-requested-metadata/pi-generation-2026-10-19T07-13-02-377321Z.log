nimport com.alibaba.druid.util.DruidPasswordCallback;\nimport org.junit.jupiter.api.Test;\n\nimport static org.junit.jupiter.api.Assertions.assertInstanceOf;\n\npublic class DruidAbstractDataSourceTest {\n    @Test\n    void configuresExtensionTypesByClassName() throws Exception {\n        DruidDataSource dataSource = new DruidDataSource();\n        try {\n            dataSource.setStatLoggerClassName(DruidDataSourceStatLoggerImpl.class.getName());\n            dataSource.setValidConnectionCheckerClassName(JDBC4ValidConnectionChecker.class.getName());\n            dataSource.setPasswordCallbackClassName(DruidPasswordCallback.class.getName());\n            dataSource.setExceptionSorter(MySqlExceptionSorter.class.getName());\n\n            assertInstanceOf(DruidDataSourceStatLoggerImpl.class, dataSource.getStatLogger());\n            assertInstanceOf(JDBC4ValidConnectionChecker.class, dataSource.getValidConnectionChecker());\n            assertInstanceOf(DruidPasswordCallback.class, dataSource.getPasswordCallback());\n            assertInstanceOf(MySqlExceptionSorter.class, dataSource.getExceptionSorter());\n        } finally {\n            dataSource.close();\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792394021141}, {"role": "toolResult", "toolCallId": "call_udSLdYWt1NzEgRv3IKWI1dDI|fc_02dd95b875e76f5d016ad5c324796c87d0969c574128dbd2cd", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage com_alibaba.druid;\n\nimport com.alibaba.druid.stat.JdbcSqlStatValue;\nimport com.alibaba.druid.util.JdbcSqlStatUtils;\nimport java.util.Map;\nimport org.junit.jupiter.api.Test;\n\nimport static org.junit.jupiter.api.Assertions.assertEquals;\nimport static org.junit.jupiter.api.Assertions.assertNotNull;\n\npublic class JdbcSqlStatUtilsTest {\n    @Test\n    void readsStatisticsFromValueObject() {\n        JdbcSqlStatValue stat = new JdbcSqlStatValue();\n        stat.setSql(\"select 1\");\n        stat.setExecuteSuccessCount(1);\n\n        Map<String, Object> data = JdbcSqlStatUtils.getData(stat);\n        assertNotNull(data);\n        assertEquals(\"select 1\", data.get(\"SQL\"));\n    }\n}\n"}], "isError": false, "timestamp": 1792394021141}, {"role": "toolResult", "toolCallId": "call_mKK56LpQ2VPnEpPOF6ENdqZO|fc_02dd95b875e76f5d016ad5c324797487d08f5390b07111ce9f", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage com_alibaba.druid;\n\nimport com.alibaba.druid.util.JdbcUtils;\nimport java.sql.Driver;\nimport org.junit.jupiter.api.Test;\n\nimport static org.junit.jupiter.api.Assertions.assertEquals;\n\npublic class JdbcUtilsTest {\n    @Test\n    void createsJdbcDriverThroughAvailableClassLoadingPaths() throws Exception {\n        Driver contextual = JdbcUtils.createDriver(null, \"org.h2.Driver\");\n        Driver explicit = JdbcUtils.createDriver(org.h2.Driver.class.getClassLoader(), \"org.h2.Driver\");\n        assertEquals(\"org.h2.Driver\", contextual.getClass().getName());\n        assertEquals(\"org.h2.Driver\", explicit.getClass().getName());\n\n        ClassLoader original = Thread.currentThread().getContextClassLoader();\n        try {\n            Thread.currentThread().setContextClassLoader(null);\n            Driver fallback = JdbcUtils.createDriver(null, \"org.h2.Driver\");\n            assertEquals(\"org.h2.Driver\", fallback.getClass().getName());\n        } finally {\n            Thread.currentThread().setContextClassLoader(original);\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1792394021141}, {"role": "toolResult", "toolCallId": "call_zlA6uZNAlGctvwuHJRIfld9x|fc_02dd95b875e76f5d016ad5c324797c87d0bb647b7bdcc5e1c0", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage com_alibaba.druid;\n\nimport com.alibaba.druid.pool.DruidDataSource;\nimport com.alibaba.druid.stat.JdbcSqlStat;\nimport com.alibaba.druid.util.DruidDataSourceUtils;\nimport java.sql.Connection;\nimport java.sql.Statement;\nimport java.util.Map;\nimport org.junit.jupiter.api.Test;\n\nimport static org.junit.jupiter.api.Assertions.assertEquals;\nimport static org.junit.jupiter.api.Assertions.assertFalse;\nimport static org.junit.jupiter.api.Assertions.assertNotNull;\nimport static org.junit.jupiter.api.Assertions.assertTrue;\n\npublic class DruidDataSourceUtilsTest {\n    @Test\n    void readsStatisticsFromDataSourceSubclass() throws Exception {\n        DerivedDataSource dataSource = new DerivedDataSource();\n        dataSource.setName(\"utility-pool\");\n        dataSource.setUrl(\"jdbc:h2:mem:druid_utils;DB_CLOSE_DELAY=-1\");\n        dataSource.setRemoveAbandoned(true);\n        dataSource.setFilters(\"stat,wall\");\n\n        try {\n            dataSource.init();\n            try (Connection connection = dataSource.getConnection();\n                    Statement statement = connection.createStatement()) {\n                statement.execute(\"create table utility_item (id integer primary key, name varchar(40))\");\n                statement.executeUpdate(\"insert into utility_item values (1, 'one')\");\n                assertTrue(statement.executeQuery(\"select * from utility_item\").next());\n                assertNotNull(DruidDataSourceUtils.getActiveConnectionStackTrace(dataSource));\n            }\n\n            assertEquals(dataSource.getUrl(), DruidDataSourceUtils.getUrl(dataSource));\n            assertEquals(dataSource.getID(), DruidDataSourceUtils.getID(dataSource));\n            assertEquals(\"utility-pool\", DruidDataSourceUtils.getName(dataSource));\n            assertNotNull(DruidDataSourceUtils.getObjectName(dataSource));\n            assertTrue(DruidDataSourceUtils.isRemoveAbandoned(dataSource));\n            assertNotNull(DruidDataSourceUtils.getStatDataForMBean(dataSource));\n            assertNotNull(DruidDataSourceUtils.getStatData(dataSource));\n            Map<?, ?> sqlStats = DruidDataSourceUtils.getSqlStatMap(dataSource);\n            assertNotNull(sqlStats);\n            assertFalse(sqlStats.isEmpty());\n            JdbcSqlStat sqlStat = (JdbcSqlStat) sqlStats.values().iterator().next();\n            assertNotNull(DruidDataSourceUtils.getSqlStat(dataSource, (int) sqlStat.getId()));\n            assertNotNull(DruidDataSourceUtils.getWallStatMap(dataSource));\n            assertNotNull(DruidDataSourceUtils.getPoolingConnectionInfo(dataSource));\n        } finally {\n            dataSource.close();\n        }\n    }\n\n    public static final class DerivedDataSource extends DruidDataSource {\n    }\n}\n"}], "isError": false, "timestamp": 1792394021141}, {"role": "toolResult", "toolCallId": "call_obmLBbPKrg5QEm40CsM4XFDP|fc_02dd95b875e76f5d016ad5c3247ab087d0b7b18fe9ace7d18e", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage com_alibaba.druid;\n\nimport com.alibaba.druid.filter.config.ConfigFilter;\nimport java.util.Properties;\nimport org.junit.jupiter.api.Test;\n\nimport static org.junit.jupiter.api.Assertions.assertEquals;\n\npublic class ConfigFilterTest {\n    @Test\n    void loadsConfigurationFromClasspathForms() {\n        ConfigFilter filter = new ConfigFilter();\n        Properties prefixed = filter.loadConfig(\"classpath:META-INF/druid-filter.properties\");\n        Properties fallback = filter.loadConfig(\"META-INF/druid-filter.properties\");\n\n        assertEquals(\"com.alibaba.druid.filter.stat.StatFilter\", prefixed.getProperty(\"druid.filters.stat\"));\n        assertEquals(prefixed.getProperty(\"druid.filters.stat\"), fallback.getProperty(\"druid.filters.stat\"));\n    }\n}\n"}], "isError": false, "timestamp": 1792394021141}]}
