              MBeanServer mbeanServer = ManagementFactory.getPlatformMBeanServer();
              for (Object item : dataSources.entrySet()) {
                  Map.Entry entry = (Map.Entry) item;
                  ObjectName objectName = (ObjectName) entry.getValue();
  
                  if (objectName == null) {
                      continue;
                  }
  
                  try {
