          DataSourceProxyConfig config = DruidDriver.parseConfig(jdbcUrl, null);
          this.driverClass = config.getRawDriverClassName();
  
          LOG.error("error url : '" + sanitizedUrl(jdbcUrl) + "', it should be : '" + config.getRawUrl() + "'");
  
  
