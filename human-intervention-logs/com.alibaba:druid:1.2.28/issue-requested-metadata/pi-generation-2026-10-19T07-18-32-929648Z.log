  Tested on GraalVM CE 25.4.4.1.1 with Native Build Tools 1.1.13 and the metadata repository enabled. The program uses logback because `SLF4JImpl` refuses loggers that are not a `LocationAwareLogger`, and slf4j-simple's are not.
  
  dynamic-datasource ships a copy of Druid's metadata, which we would like to drop once Druid is covered here: https://github.com/baomidou/dynamic-datasource/tree/dfd8caada1a25269abbc379e7cb17d078a619c41/dynamic-datasource-native-metadata/src/main/resources/META-INF/native-image/com.alibaba/druid/1.2.27
  
  Reproducer. `settings.gradle`:
  
  ```groovy
  rootProject.name = 'druid-native-probe'
  ```
  
  `build.gradle`:
  
  ```groovy
  plugins {
      id 'application'
      id 'org.graalvm.buildtools.native' version '1.1.13'
  }
  
  repositories {
      mavenCentral()
  }
  
  dependencies {
      implementation 'com.alibaba:druid:1.2.28'
      implementation 'org.slf4j:slf4j-api:2.0.17'
      implementation 'ch.qos.logback:logback-classic:1.5.20'
      runtimeOnly 'com.h2database:h2:2.4.240'
  }
  
  application {
      mainClass = 'probe.Main'
  }
  
  graalvmNative {
      metadataRepository {
          enabled = true
      }
  }
  ```
  
  `src/main/java/probe/Main.java`:
  
  ```java
  package probe;
  
  import com.alibaba.druid.filter.Filter;
  import com.alibaba.druid.pool.DruidDataSource;
  import com.alibaba.druid.support.logging.LogFactory;
  
  import javax.management.MBeanServer;
  import javax.management.ObjectName;
  import java.lang.management.ManagementFactory;
  import java.sql.Connection;
  import java.sql.DriverManager;
  import java.sql.ResultSet;
  import java.sql.Statement;
  import java.util.ArrayList;
  import java.util.List;
  import java.util.TreeSet;
  
  public class Main {
  
      public static void main(String[] args) throws Exception {
          ((ch.qos.logback.classic.Logger) org.slf4j.LoggerFactory.getLogger(org.slf4j.Logger.ROOT_LOGGER_NAME))
                  .setLevel(ch.qos.logback.classic.Level.INFO);
          System.out.println("log impl: " + LogFactory.getLog(Main.class).getClass().getName());
          System.out.println("drivers: " + new TreeSet<>(DriverManager.drivers().map(d -> d.getClass().getName()).toList()));
          DruidDataSource ds = new DruidDataSource();
          ds.setUrl("jdbc:h2:mem:probe;DB_CLOSE_DELAY=-1");
          ds.setUsername("sa");
          ds.setPassword("");
          ds.setValidationQuery("SELECT 1");
          ds.setFilters("stat");
          ds.init();
          List<String> filters = new ArrayList<>();
          for (Filter filter : ds.getProxyFilters()) {
              filters.add(filter.getClass().getName());
          }
          System.out.println("filters: " + filters);
          try (Connection c = ds.getConnection(); Statement s = c.createStatement()) {
              s.execute("CREATE TABLE t (id INT)");
              s.execute("INSERT INTO t VALUES (1)");
              try (ResultSet rs = s.executeQuery("SELECT COUNT(*) FROM t")) {
                  rs.next();
                  System.out.println("count: " + rs.getInt(1));
              }
          }
          System.out.println("sql stats: " + ds.getDataSourceStat().getSqlStatMap().size());
          MBeanServer server = ManagementFactory.getPlatformMBeanServer();
          for (ObjectName name : new TreeSet<>(server.queryNames(new ObjectName("com.alibaba.druid:*"), null))) {
              String key = name.getKeyProperty("type");
              System.out.println("mbean " + key + ": " + server.getMBeanInfo(name).getAttributes().length + " attributes");
          }
          ds.close();
      }
  }
  ```
  
  `./gradlew run` gives the JVM output and `./gradlew nativeRun` the native one. With the JSON above saved as `src/main/resources/META-INF/native-image/com.alibaba/druid/reachability-metadata.json`, `./gradlew nativeRun` prints the same as the JVM run.
