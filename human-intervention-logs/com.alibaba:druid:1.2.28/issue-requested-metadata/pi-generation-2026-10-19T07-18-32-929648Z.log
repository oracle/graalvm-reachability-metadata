": \"reportMetricsIntervalMillis\"\n        },\n        {\n          \"name\": \"requireSSL\"\n        },\n        {\n          \"name\": \"resourceId\"\n        },\n        {\n          \"name\": \"resultSetSizeThreshold\"\n        },\n        {\n          \"name\": \"retainStatementAfterResultSetClose\"\n        },\n        {\n          \"name\": \"retriesAllDown\"\n        },\n        {\n          \"name\": \"rewriteBatchedStatements\"\n        },\n        {\n          \"name\": \"rollbackOnPooledClose\"\n        },\n        {\n          \"name\": \"roundRobinLoadBalance\"\n        },\n        {\n          \"name\": \"runningCTS13\"\n        },\n        {\n          \"name\": \"secondsBeforeRetryMaster\"\n        },\n        {\n          \"name\": \"selfDestructOnPingMaxOperations\"\n        },\n        {\n          \"name\": \"selfDestructOnPingSecondsLifetime\"\n        },\n        {\n          \"name\": \"sendFractionalSeconds\"\n        },\n        {\n          \"name\": \"serverAffinityOrder\"\n        },\n        {\n          \"name\": \"serverConfigCacheFactory\"\n        },\n        {\n          \"name\": \"serverRSAPublicKeyFile\"\n        },\n        {\n          \"name\": \"serverTimezone\"\n        },\n        {\n          \"name\": \"sessionVariables\"\n        },\n        {\n          \"name\": \"slowQueryThresholdMillis\"\n        },\n        {\n          \"name\": \"slowQueryThresholdNanos\"\n        },\n        {\n          \"name\": \"socketFactoryClassName\"\n        },\n        {\n          \"name\": \"socketTimeout\"\n        },\n        {\n          \"name\": \"socksProxyHost\"\n        },\n        {\n          \"name\": \"socksProxyPort\"\n        },\n        {\n          \"name\": \"statementInterceptors\"\n        },\n        {\n          \"name\": \"strictFloatingPoint\"\n        },\n        {\n          \"name\": \"strictUpdates\"\n        },\n        {\n          \"name\": \"tcpKeepAlive\"\n        },\n        {\n          \"name\": \"tcpNoDelay\"\n        },\n        {\n          \"name\": \"tcpRcvBuf\"\n        },\n        {\n          \"name\": \"tcpSndBuf\"\n        },\n        {\n          \"name\": \"tcpTrafficClass\"\n        },\n        {\n          \"name\": \"tinyInt1isBit\"\n        },\n        {\n          \"name\": \"traceProtocol\"\n        },\n        {\n          \"name\": \"transformedBitIsBoolean\"\n        },\n        {\n          \"name\": \"treatUtilDateAsTimestamp\"\n        },\n        {\n          \"name\": \"trustCertificateKeyStorePassword\"\n        },\n        {\n          \"name\": \"trustCertificateKeyStoreType\"\n        },\n        {\n          \"name\": \"trustCertificateKeyStoreUrl\"\n        },\n        {\n          \"name\": \"useAffectedRows\"\n        },\n        {\n          \"name\": \"useBlobToStoreUTF8OutsideBMP\"\n        },\n        {\n          \"name\": \"useColumnNamesInFindColumn\"\n        },\n        {\n          \"name\": \"useCompression\"\n        },\n        {\n          \"name\": \"useConfigs\"\n        },\n        {\n          \"name\": \"useCursorFetch\"\n        },\n        {\n          \"name\": \"useDirectRowUnpack\"\n        },\n        {\n          \"name\": \"useDynamicCharsetInfo\"\n        },\n        {\n          \"name\": \"useFastDateParsing\"\n        },\n        {\n          \"name\": \"useFastIntParsing\"\n        },\n        {\n          \"name\": \"useGmtMillisForDatetimes\"\n        },\n        {\n          \"name\": \"useHostsInPrivileges\"\n        },\n        {\n          \"name\": \"useInformationSchema\"\n        },\n        {\n          \"name\": \"useJDBCCompliantTimezoneShift\"\n        },\n        {\n          \"name\": \"useJvmCharsetConverters\"\n        },\n        {\n          \"name\": \"useLegacyDatetimeCode\"\n        },\n        {\n          \"name\": \"useLocalSessionState\"\n        },\n        {\n          \"name\": \"useLocalTransactionState\"\n        },\n        {\n          \"name\": \"useNanosForEla