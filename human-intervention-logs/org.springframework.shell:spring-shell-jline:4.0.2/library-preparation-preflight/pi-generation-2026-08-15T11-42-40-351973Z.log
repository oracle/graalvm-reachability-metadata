5\t\n    36\t\t@Bean\n    37\t\tpublic CommandCompleter commandCompleter(CommandRegistry commandRegistry) {\n    38\t\t\treturn new CommandCompleter(commandRegistry);\n    39\t\t}\n    40\t\n    41\t\t@Bean\n    42\t\tpublic Terminal terminal() {\n    43\t\t\ttry {\n    44\t\t\t\treturn TerminalBuilder.builder().build();\n    45\t\t\t}\n    46\t\t\tcatch (IOException e) {\n    47\t\t\t\tthrow new ShellConfigurationException(\"Unable to configure JLine terminal\", e);\n    48\t\t\t}\n    49\t\t}\n    50\t\n    51\t\t@Bean\n    52\t\tpublic Parser parser() {\n    53\t\t\tExtendedDefaultParser parser = new ExtendedDefaultParser();\n    54\t\t\tparser.setEofOnUnclosedQuote(true);\n    55\t\t\tparser.setEofOnEscapedNewLine(true);\n    56\t\t\treturn parser;\n    57\t\t}\n    58\t\n    59\t}\n--- upstream JLine config/tests ---\n/tmp/spring-shell-4.0.2/spring-shell-jline/src/test/java/org/springframework/shell/jline/CommandCompleterTests.java\n/tmp/spring-shell-4.0.2/spring-shell-jline/src/test/java/org/springframework/shell/jline/CommandHighlighterTests.java\n/tmp/spring-shell-4.0.2/spring-shell-jline/src/test/java/org/springframework/shell/jline/tui/component/flow/AbstractShellTests.java\n/tmp/spring-shell-4.0.2/spring-shell-jline/src/test/java/org/springframework/shell/jline/tui/component/flow/ComponentFlowTests.java\n/tmp/spring-shell-4.0.2/spring-shell-jline/src/test/java/org/springframework/shell/jline/tui/component/AbstractShellTests.java\n/tmp/spring-shell-4.0.2/spring-shell-jline/src/test/java/org/springframework/shell/jline/tui/component/ConfirmationInputTests.java\n/tmp/spring-shell-4.0.2/spring-shell-jline/src/test/java/org/springframework/shell/jline/tui/component/MultiItemSelectorTests.java\n/tmp/spring-shell-4.0.2/spring-shell-jline/src/test/java/org/springframework/shell/jline/tui/component/NumberInputTests.java\n/tmp/spring-shell-4.0.2/spring-shell-jline/src/test/java/org/springframework/shell/jline/tui/component/PathInputTests.java\n/tmp/spring-shell-4.0