rg.springframework.shell\n./tests/src/org.springframework.shell/spring-shell-jline/4.0.2/build/jacoco/effective/spring_shell_jline_4_0_2_jar/META-INF/maven/org.springframework.shell/spring-shell-jline\n./tests/src/org.springframework.shell/spring-shell-jline/4.0.2/build/jacoco/effective/spring_shell_jline_4_0_2_jar/org\n./tests/src/org.springframework.shell/spring-shell-jline/4.0.2/build/jacoco/effective/spring_shell_jline_4_0_2_jar/org/springframework\n./tests/src/org.springframework.shell/spring-shell-jline/4.0.2/build/jacoco/effective/spring_shell_jline_4_0_2_jar/org/springframework/shell\n./tests/src/org.springframework.shell/spring-shell-jline/4.0.2/build/jacoco/effective/spring_shell_jline_4_0_2_jar/org/springframework/shell/component\n./tests/src/org.springframework.shell/spring-shell-jline/4.0.2/build/jacoco/effective/spring_shell_jline_4_0_2_jar/org/springframework/shell/jline\n./tests/src/org.springframework.shell/spring-shell-jline/4.0.2/build/jacoco/effective/spring_shell_jline_4_0_2_jar/org/springframework/shell/jline/tui\n./tests/src/org.springframework.shell/spring-shell-jline/4.0.2/build/jacoco/effective/spring_shell_jline_4_0_2_jar/org/springframework/shell/jline/tui/support\n./stats/org.springframework.shell/spring-shell-core/4.0.2/execution-metrics.json:56:        \"Interactive terminal/JLine behavior belongs to the separate spring-shell-jline module; core tests should exercise non-interactive command APIs rather than requiring a real terminal.\"\n./tests/src/org.springframework.shell/spring-shell-jline/4.0.2/settings.gradle:20:rootProject.name = 'org.springframework.shell.spring-shell-jline_tests'\n./tests/src/org.springframework.shell/spring-shell-jline/4.0.2/gradle.properties:4:library.coordinates = org.springframework.shell:spring-shell-jline:4.0.2\n./tests/src/org.springframework.shell/spring-shell-jline/4.0.2/gradle.properties:6:metadata.dir = org.springframework.shell/spring-shell-jline/4.0.2/\n./tests/src/org.springframework.shell/spring-s