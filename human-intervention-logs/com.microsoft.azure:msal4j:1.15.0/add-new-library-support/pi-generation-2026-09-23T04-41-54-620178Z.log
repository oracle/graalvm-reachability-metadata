              supplier = new AcquireTokenByManagedIdentitySupplier((ManagedIdentityApplication) this, (ManagedIdentityRequest) msalRequest);
          } else {
              supplier = new AcquireTokenByAuthorizationGrantSupplier(this, msalRequest, null);
          }
          return supplier;
      }
  
  
