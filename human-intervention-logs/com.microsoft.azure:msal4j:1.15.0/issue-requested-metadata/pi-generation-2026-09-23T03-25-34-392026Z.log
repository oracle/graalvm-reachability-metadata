TokenClient constructor**\"}]}"}, {"type": "toolCall", "id": "call_FOvrorMto3YeIIm9PE72H7o6|fc_03b09da67d7ea2b1016ab3471c254c87d2a69d45694f03ced1", "name": "edit", "arguments": {"path": "tests/src/com.microsoft.azure/msal4j/1.15.0/src/test/java/com_microsoft_azure/msal4j/Msal4jTest.java", "edits": [{"oldText": "import com.microsoft.aad.msal4j.AuthorizationRequestUrlParameters;\nimport com.microsoft.aad.msal4j.ClientCredentialFactory;", "newText": "import com.microsoft.aad.msal4j.AuthorizationCodeParameters;\nimport com.microsoft.aad.msal4j.AuthorizationRequestUrlParameters;\nimport com.microsoft.aad.msal4j.ClientCredentialFactory;"}, {"oldText": "import java.net.URL;\nimport java.net.URLDecoder;\nimport java.util.ArrayList;\nimport java.util.Date;", "newText": "import java.net.URI;\nimport java.net.URL;\nimport java.net.URLDecoder;\nimport java.util.ArrayList;\nimport java.util.Base64;\nimport java.util.Date;"}, {"oldText": "    @Test\n    void createsAuthorizationCodeRequestUrl() throws Exception {", "newText": "    @Test\n    void acquiresAuthorizationCodeTokenAndCreatesAccount() throws Exception {\n        String idToken = unsignedJwt(\"\"\"\n                {\n                  \"sub\": \"subject-id\",\n                  \"oid\": \"object-id\",\n                  \"tid\": \"tenant-id\",\n                  \"name\": \"Ada Lovelace\",\n                  \"preferred_username\": \"ada@example.test\"\n                }\n                \"\"\");\n        String clientInfo = base64Url(\"{\\\"uid\\\":\\\"user-id\\\",\\\"utid\\\":\\\"tenant-id\\\"}\");\n        String tokenResponse = \"\"\"\n                {\n                  \"token_type\": \"Bearer\",\n                  \"scope\": \"api://resource/.default\",\n                  \"expires_in\": 3600,\n                  \"ext_expires_in\": 3600,\n                  \"access_token\": \"user-access-token\",\n                  \"refresh_token\": \"refresh-token\",\n                  \"id_token\": \"%s\",\n                  \"client_info\": \"%s\"\n                }\n                \"\"\".formatted(idToken, clientInfo);\n        RecordingTokenClient httpClient = new RecordingTokenClient(tokenResponse);\n        PublicClientApplication application = PublicClientApplication.builder(\"public-client-id\")\n                .authority(AUTHORITY)\n                .validateAuthority(false)\n                .instanceDiscovery(false)\n                .httpClient(httpClient)\n                .build();\n        AuthorizationCodeParameters parameters = AuthorizationCodeParameters.builder(\n                        \"authorization-code\", URI.create(\"https://application.example.test/callback\"))\n                .scopes(SCOPES)\n                .codeVerifier(\"pkce-verifier\")\n                .build();\n\n        IAuthenticationResult result = application.acquireToken(parameters).get(10, SECONDS);\n\n        assertThat(result.accessToken()).isEqualTo(\"user-access-token\");\n        assertThat(result.refreshToken()).isEqualTo(\"refresh-token\");\n        assertThat(result.account().homeAccountId()).isEqualTo(\"user-id.tenant-id\");\n        assertThat(result.account().username()).isEqualTo(\"ada@example.test\");\n        assertThat(result.tenantProfile().getClaims())\n                .containsEntry(\"name\", \"Ada Lovelace\")\n                .containsEntry(\"tid\", \"tenant-id\");\n        assertThat(application.getAccounts().get(10, SECONDS))\n                .extracting(account -> account.homeAccountId())\n                .containsExactly(\"user-id.tenant-id\");\n        assertThat(application.tokenCache().serialize())\n                .contains(\"Account\")\n                .contains(\"IdToken\")\n                .contains(\"RefreshToken\");\n        assertThat(httpClient.requests).hasSize(1);\n        assertThat(httpClient.requests.get(0).body())\n                .contains(\"grant_type=authorization_code\")\n                .contains(\"code=authorization-code\")\n                .contains(\"