client_info\": \"%s\"\n                }\n                \"\"\".formatted(idToken, clientInfo);\n        RecordingTokenClient httpClient = new RecordingTokenClient(tokenResponse);\n        PublicClientApplication application = PublicClientApplication.builder(\"public-client-id\")\n                .authority(AUTHORITY)\n                .validateAuthority(false)\n                .instanceDiscovery(false)\n                .httpClient(httpClient)\n                .build();\n        AuthorizationCodeParameters parameters = AuthorizationCodeParameters.builder(\n                        \"authorization-code\", URI.create(\"https://application.example.test/callback\"))\n                .scopes(SCOPES)\n                .codeVerifier(\"pkce-verifier\")\n                .build();\n\n        IAuthenticationResult result = application.acquireToken(parameters).get(10, SECONDS);\n\n        assertThat(result.accessToken()).isEqualTo(\"user-access-token\");\n        assertThat(result.refreshToken()).isEqualTo(\"refresh-token\");\n        assertThat(result.account().homeAccountId()).isEqualTo(\"user-id.tenant-id\");\n        assertThat(result.account().username()).isEqualTo(\"ada@example.test\");\n        assertThat(result.tenantProfile().getClaims())\n                .containsEntry(\"name\", \"Ada Lovelace\")\n                .containsEntry(\"tid\", \"tenant-id\");\n        assertThat(application.getAccounts().get(10, SECONDS))\n                .extracting(account -> account.homeAccountId())\n                .containsExactly(\"user-id.tenant-id\");\n        assertThat(application.tokenCache().serialize())\n                .contains(\"Account\")\n                .contains(\"IdToken\")\n                .contains(\"RefreshToken\");\n        assertThat(httpClient.requests).hasSize(1);\n        assertThat(httpClient.requests.get(0).body())\n                .contains(\"grant_type=authorization_code\")\n                .contains(\"code=authorization-code\")\n                .contains(\"code_verifier=pkce-verifier\")\n                .contains(\"redirect_uri=https%3A%2F%2Fapplication.example.test%2Fcallback\");\n    }\n\n    @Test\n    void createsAuthorizationCodeRequestUrl() throws Exception {"}, {"oldText": "    private static ConfidentialClientApplication newConfidentialApplication(IHttpClient httpClient)\n            throws Exception {\n        return ConfidentialClientApplication.builder(\n                        \"client-id\", ClientCredentialFactory.createFromSecret(\"client-secret\"))\n                .authority(AUTHORITY)\n                .validateAuthority(false)\n                .instanceDiscovery(false)\n                .httpClient(httpClient)\n                .applicationName(\"metadata-test\")\n                .applicationVersion(\"test\")\n                .build();\n    }\n\n    private static final class RecordingTokenClient implements IHttpClient {", "newText": "    private static ConfidentialClientApplication newConfidentialApplication(IHttpClient httpClient)\n            throws Exception {\n        return ConfidentialClientApplication.builder(\n                        \"client-id\", ClientCredentialFactory.createFromSecret(\"client-secret\"))\n                .authority(AUTHORITY)\n                .validateAuthority(false)\n                .instanceDiscovery(false)\n                .httpClient(httpClient)\n                .applicationName(\"metadata-test\")\n                .applicationVersion(\"test\")\n                .build();\n    }\n\n    private static String unsignedJwt(String claims) {\n        return base64Url(\"{\\\"alg\\\":\\\"none\\\"}\") + \".\" + base64Url(claims) + \".\";\n    }\n\n    private static String base64Url(String value) {\n        return Base64.getUrlEncoder().withoutPadding().encodeToString(value.getBytes(UTF_8));\n    }\n\n    private static final class RecordingTokenClient implements IHttpClient {"}, {"oldText": "        private final List<HttpRequest> requests = new ArrayList<>();\n\n        @Override\