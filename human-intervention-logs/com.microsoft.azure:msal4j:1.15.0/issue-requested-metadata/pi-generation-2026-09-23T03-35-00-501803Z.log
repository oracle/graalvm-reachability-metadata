ccessToken()).isEqualTo(\"user-access-token\");\n+        assertThat(result.idToken()).isEqualTo(idToken);\n+        assertThat(result.account().homeAccountId()).isEqualTo(\"user-id.tenant-id\");\n+        assertThat(result.account().username()).isEqualTo(\"ada@example.test\");\n+        Map<String, ?> claims = result.tenantProfile().getClaims();\n+        assertThat(claims.get(\"name\")).isEqualTo(\"Ada Lovelace\");\n+        assertThat(claims.get(\"tid\")).isEqualTo(\"tenant-id\");\n+        assertThat(application.getAccounts().get(10, SECONDS))\n+                .extracting(account -> account.homeAccountId())\n+                .containsExactly(\"user-id.tenant-id\");\n+        assertThat(application.tokenCache().serialize())\n+                .contains(\"Account\")\n+                .contains(\"IdToken\")\n+                .contains(\"RefreshToken\")\n+                .contains(\"refresh-token\");\n+        assertThat(httpClient.requests).hasSize(1);\n+        assertThat(httpClient.requests.get(0).body())\n+                .contains(\"grant_type=authorization_code\")\n+                .contains(\"code=authorization-code\")\n+                .contains(\"code_verifier=\" + PKCE_CODE_VERIFIER)\n+                .contains(\"redirect_uri=https%3A%2F%2Fapplication.example.test%2Fcallback\");\n+    }\n+\n     @Test\n     void createsAuthorizationCodeRequestUrl() throws Exception {\n         PublicClientApplication application = PublicClientApplication.builder(\"public-client-id\")\n@@ -130,6 +196,14 @@ public class Msal4jTest {\n                 .build();\n     }\n \n+    private static String unsignedJwt(String claims) {\n+        return base64Url(\"{\\\"alg\\\":\\\"none\\\"}\") + \".\" + base64Url(claims) + \".\";\n+    }\n+\n+    private static String base64Url(String value) {\n+        return Base64.getUrlEncoder().withoutPadding().encodeToString(value.getBytes(UTF_8));\n+    }\n+\n     private static final class RecordingTokenClient implements IHttpClient {\n         private static final String TOKEN_RESPONSE = \"\"\"\n                 {\n@@ -142,11 +216,20 @@ public class Msal4jTest {\n                 \"\"\";\n \n         private final List<HttpRequest> requests = new ArrayList<>();\n+        private final String tokenResponse;\n+\n+        private RecordingTokenClient() {\n+            this(TOKEN_RESPONSE);\n+        }\n+\n+        private RecordingTokenClient(String tokenResponse) {\n+            this.tokenResponse = tokenResponse;\n+        }\n \n         @Override\n         public IHttpResponse send(HttpRequest request) {\n             requests.add(request);\n-            HttpResponse response = new HttpResponse().statusCode(200).body(TOKEN_RESPONSE);\n+            HttpResponse response = new HttpResponse().statusCode(200).body(tokenResponse);\n             response.addHeaders(Map.of(\"Content-Type\", List.of(\"application/json\")));\n             return response;\n         }\ndiff --git a/tests/src/com.microsoft.azure/msal4j/1.15.0/user-code-filter.json b/tests/src/com.microsoft.azure/msal4j/1.15.0/user-code-filter.json\nindex fb237c6875..89e8c4066d 100644\n--- a/tests/src/com.microsoft.azure/msal4j/1.15.0/user-code-filter.json\n+++ b/tests/src/com.microsoft.azure/msal4j/1.15.0/user-code-filter.json\n@@ -1,10 +1,13 @@\n {\n-  \"rules\": [\n+  \"rules\" : [\n     {\n-      \"excludeClasses\": \"**\"\n+      \"excludeClasses\" : \"**\"\n     },\n     {\n-      \"includeClasses\": \"com.microsoft.aad.msal4j.**\"\n+      \"includeClasses\" : \"com.microsoft.aad.msal4j.**\"\n+    },\n+    {\n+      \"includeClasses\" : \"com_microsoft_azure.msal4j.**\"\n     }\n   ]\n }\n"}], "isError": false, "timestamp": 1790134521210}}
