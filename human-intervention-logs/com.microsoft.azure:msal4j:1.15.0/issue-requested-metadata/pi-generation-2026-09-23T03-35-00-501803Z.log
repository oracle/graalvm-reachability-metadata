d.msal4j.ClientCredentialFactory;\n import com.microsoft.aad.msal4j.ClientCredentialParameters;\n@@ -24,9 +25,11 @@ import com.microsoft.aad.msal4j.Prompt;\n import com.microsoft.aad.msal4j.PublicClientApplication;\n import com.microsoft.aad.msal4j.ResponseMode;\n import com.microsoft.aad.msal4j.TokenSource;\n+import java.net.URI;\n import java.net.URL;\n import java.net.URLDecoder;\n import java.util.ArrayList;\n+import java.util.Base64;\n import java.util.Date;\n import java.util.List;\n import java.util.Map;\n@@ -37,6 +40,7 @@ import org.junit.jupiter.api.Timeout;\n @Timeout(60)\n public class Msal4jTest {\n     private static final String AUTHORITY = \"https://login.microsoftonline.com/tenant-id\";\n+    private static final String PKCE_CODE_VERIFIER = \"0123456789012345678901234567890123456789012\";\n     private static final Set<String> SCOPES = Set.of(\"api://resource/.default\");\n \n     @Test\n@@ -81,6 +85,68 @@ public class Msal4jTest {\n         assertThat(restoredHttpClient.requests).isEmpty();\n     }\n \n+    @Test\n+    void acquiresAuthorizationCodeTokenAndCreatesAccount() throws Exception {\n+        String idToken = unsignedJwt(\"\"\"\n+                {\n+                  \"sub\": \"subject-id\",\n+                  \"oid\": \"object-id\",\n+                  \"tid\": \"tenant-id\",\n+                  \"name\": \"Ada Lovelace\",\n+                  \"preferred_username\": \"ada@example.test\"\n+                }\n+                \"\"\");\n+        String clientInfo = base64Url(\"{\\\"uid\\\":\\\"user-id\\\",\\\"utid\\\":\\\"tenant-id\\\"}\");\n+        String tokenResponse = \"\"\"\n+                {\n+                  \"token_type\": \"Bearer\",\n+                  \"scope\": \"api://resource/.default\",\n+                  \"expires_in\": 3600,\n+                  \"ext_expires_in\": 3600,\n+                  \"access_token\": \"user-access-token\",\n+                  \"refresh_token\": \"refresh-token\",\n+                  \"id_token\": \"%s\",\n+                  \"client_info\": \"%s\"\n+                }\n+                \"\"\".formatted(idToken, clientInfo);\n+        RecordingTokenClient httpClient = new RecordingTokenClient(tokenResponse);\n+        PublicClientApplication application = PublicClientApplication.builder(\"public-client-id\")\n+                .authority(AUTHORITY)\n+                .validateAuthority(false)\n+                .instanceDiscovery(false)\n+                .httpClient(httpClient)\n+                .build();\n+        AuthorizationCodeParameters parameters = AuthorizationCodeParameters.builder(\n+                        \"authorization-code\", URI.create(\"https://application.example.test/callback\"))\n+                .scopes(SCOPES)\n+                .codeVerifier(PKCE_CODE_VERIFIER)\n+                .build();\n+\n+        IAuthenticationResult result = application.acquireToken(parameters).get(10, SECONDS);\n+\n+        assertThat(result.accessToken()).isEqualTo(\"user-access-token\");\n+        assertThat(result.idToken()).isEqualTo(idToken);\n+        assertThat(result.account().homeAccountId()).isEqualTo(\"user-id.tenant-id\");\n+        assertThat(result.account().username()).isEqualTo(\"ada@example.test\");\n+        Map<String, ?> claims = result.tenantProfile().getClaims();\n+        assertThat(claims.get(\"name\")).isEqualTo(\"Ada Lovelace\");\n+        assertThat(claims.get(\"tid\")).isEqualTo(\"tenant-id\");\n+        assertThat(application.getAccounts().get(10, SECONDS))\n+                .extracting(account -> account.homeAccountId())\n+                .containsExactly(\"user-id.tenant-id\");\n+        assertThat(application.tokenCache().serialize())\n+                .contains(\"Account\")\n+                .contains(\"IdToken\")\n+                .contains(\"RefreshToken\")\n+                .contains(\"refresh-token\");\n+        assertThat(httpClient.requests).hasSize(1);\n+        assertThat(httpClient.requests.get(0).body())\n+                .