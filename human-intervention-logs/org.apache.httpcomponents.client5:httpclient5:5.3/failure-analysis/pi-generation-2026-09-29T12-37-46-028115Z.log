   \"serializable\": true\n    },\n    {\n      \"condition\": {\n        \"typeReached\": \"org.apache.hc.client5.http.impl.auth.BasicScheme\"\n      },\n      \"type\": \"java.lang.String\",\n      \"serializable\": true\n    },\n    {\n      \"condition\": {\n        \"typeReached\": \"org.apache.hc.client5.http.impl.auth.BasicScheme\"\n      },\n      \"type\": \"java.util.HashMap\",\n      \"serializable\": true\n    },\n    {\n      \"condition\": {\n        \"typeReached\": \"org.apache.hc.client5.http.impl.auth.BasicScheme\"\n      },\n      \"type\": \"org.apache.hc.client5.http.auth.BasicUserPrincipal\",\n      \"serializable\": true\n    },\n    {\n      \"condition\": {\n        \"typeReached\": \"org.apache.hc.client5.http.impl.auth.BasicScheme\"\n      },\n      \"type\": \"org.apache.hc.client5.http.auth.UsernamePasswordCredentials\",\n      \"serializable\": true\n    },\n    {\n      \"condition\": {\n        \"typeReached\": \"org.apache.hc.client5.http.impl.auth.BasicAuthCache\"\n      },\n      \"type\": \"org.apache.hc.client5.http.impl.auth.BasicScheme\",\n      \"serializable\": true\n    },\n    {\n      \"condition\": {\n        \"typeReached\": \"org.apache.hc.client5.http.impl.auth.BasicScheme\"\n      },\n      \"type\": \"sun.security.provider.SHA\",\n      \"methods\": [\n        {\n          \"name\": \"<init>\",\n          \"parameterTypes\": []\n        }\n      ]\n    }\n  ],\n  \"resources\": [\n    {\n      \"condition\": {\n        \"typeReached\": \"org.apache.hc.client5.http.impl.auth.BasicScheme\"\n      },\n      \"glob\": \"org/slf4j/impl/StaticLoggerBinder.class\"\n    }\n  ]\n}"}], "isError": false, "timestamp": 1790685439691}, {"role": "toolResult", "toolCallId": "call_Zdm099zMpDhfbFyWsIGBa73U|fc_0bc00f09f1280e44016abbb0ff7d3c87d2b0708a1f3704de25", "toolName": "bash", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_apache_httpcomponents_client5.httpclient5;\n\nimport java.nio.charset.StandardCharsets;\nimport java.util.Base64;\n\nimport org.apache.hc.client5.http.auth.AuthChallenge;\nimport org.apache.hc.client5.http.auth.AuthScheme;\nimport org.apache.hc.client5.http.auth.ChallengeType;\nimport org.apache.hc.client5.http.auth.StandardAuthScheme;\nimport org.apache.hc.client5.http.auth.UsernamePasswordCredentials;\nimport org.apache.hc.client5.http.impl.auth.BasicAuthCache;\nimport org.apache.hc.client5.http.impl.auth.BasicScheme;\nimport org.apache.hc.core5.http.HttpHost;\nimport org.apache.hc.core5.http.message.BasicNameValuePair;\nimport org.junit.jupiter.api.Test;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\npublic class BasicAuthCacheTest {\n\n    @Test\n    void storesSerializedAuthSchemeAndRestoresItOnLookup() throws Exception {\n        final HttpHost host = new HttpHost(\"https\", \"example.test\", 443);\n        final BasicScheme scheme = new BasicScheme(StandardCharsets.UTF_8);\n        scheme.processChallenge(new AuthChallenge(\n                ChallengeType.TARGET,\n                StandardAuthScheme.BASIC,\n                new BasicNameValuePair(\"realm\", \"cached\")), null);\n        scheme.initPreemptive(new UsernamePasswordCredentials(\"\\u00fcser\", \"p\\u00e4ss\".toCharArray()));\n\n        final BasicAuthCache authCache = new BasicAuthCache();\n        authCache.put(host, \"/secure\", scheme);\n\n        final AuthScheme restored = authCache.get(host, \"/secure\");\n\n        assertThat(restored).isInstanceOf(BasicScheme.class);\n        assertThat(restored).isNotSameAs(scheme);\n        assertThat(restored.getRealm()).isEqualTo(\"cached\");\n        assertThat(restored.isChallengeComplete()).isTrue();\n        final String expectedCredentials = Base64.getEncoder()\n                .encodeToString(\"\\u00fcser:p\\u00e4ss\".getBytes(StandardCharsets.UTF_8));\n        assertThat(restored.generateAuthResponse(host, null, null))\n                .isEqualTo(StandardAuthScheme.BASIC + \" \" + expectedCredentials);\n    }\n}\n\n--- 5.3 metadata history ---\ncommit d023fac60394e497485da37c5983a938dff64f5b\nAuthor: Mihailo Markovic <mihailo.markovic@oracle.com>\nDate:   Tue Sep 29 14:32:44 2026 +0200\n\n    Checkpoint for native-image-run fix of org.apache.httpcomponents.client5:httpclient5:5.3\n\ndiff --git a/metadata/org.apache.httpcomponents.client5/httpclient5/5.3/reachability-metadata.json b/metadata/org.apache.httpcomponents.client5/httpclient5/5.3/reachability-metadata.json\nnew file mode 100644\nindex 00000000000..ac7c34da3e9\n--- /dev/null\n+++ b/metadata/org.apache.httpcomponents.client5/httpclient5/5.3/reachability-metadata.json\n@@ -0,0 +1,66 @@\n+{\n+  \"reflection\": [\n+    {\n+      \"condition\": {\n+        \"typeReached\": \"org.apache.hc.client5.http.impl.auth.BasicScheme\"\n+      },\n+      \"type\": \"char[]\",\n+      \"serializable\": true\n+    },\n+    {\n+      \"condition\": {\n+        \"typeReached\": \"org.apache.hc.client5.http.impl.auth.BasicScheme\"\n+      },\n+      \"type\": \"java.lang.String\",\n+      \"serializable\": true\n+    },\n+    {\n+      \"condition\": {\n+        \"typeReached\": \"org.apache.hc.client5.http.impl.auth.BasicScheme\"\n+      },\n+      \"type\": \"java.util.HashMap\",\n+      \"serializable\": true\n+    },\n+    {\n+      \"condition\": {\n+        \"typeReached\": \"org.apache.hc.client5.http.impl.auth.BasicScheme\"\n+      },\n+      \"type\": \"org.apache.hc.client5.http.auth.BasicUserPrincipal\",\n+      \"serializable\": true\n+    },\n+    {\n+      \"condition\": {\n+        \"typeReached\": \"org.apache.hc.client5.http.impl.auth.BasicScheme\"\n+      },\n+      \"type\": \"org.apache.hc.client5.http.auth.UsernamePasswordCredentials\",\n+      \"serializable\": true\n+    },\n+    {\n+      \"condition\": {\n+        \"typeReached\": \"org.apache.hc.client5.http.impl.auth.BasicAuthCache\"\n+      },\n+      \"type\": \"org.apache.hc.client5.http.impl.auth.BasicScheme\",\n+      \"serializable\": true\n+    },\n+    {\n+      \"condition\": {\n+        \"typeReached\": \"org.apache.hc.client5.http.impl.auth.BasicScheme\"\n+      },\n+      \"type\": \"sun.security.provider.SHA\",\n+      \"methods\": [\n+        {\n+          \"name\": \"<init>\",\n+          \"parameterTypes\": []\n+        }\n+      ]\n+    }\n+  ],\n+  \"resources\": [\n+    {\n+      \"condition\": {\n+        \"typeReached\": \"org.apache.hc.client5.http.impl.auth.BasicScheme\"\n+      },\n+      \"glob\": \"org/slf4j/impl/StaticLoggerBinder.class\"\n+    }\n+  ]\n+}\n\\ No newline at end of file\n"}], "isError": false, "timestamp": 1790685439691}, {"role": "toolResult", "toolCallId": "call_B1yN2u7I51gSo5IYsaPE6ReL|fc_0bc00f09f1280e44016abbb0ff7d4c87d2af4fadd48aacc19c", "toolName": "bash", "content": [{"type": "text", "text": "(no output)"}], "isError": false, "timestamp": 1790685439691}]}
