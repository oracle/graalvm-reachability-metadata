ertj.core.api.Assertions.assertThat;\nefae8615a2b8 (Vojin Jovanovic 2026-05-20 12:23:26 +0200 24) \nefae8615a2b8 (Vojin Jovanovic 2026-05-20 12:23:26 +0200 25) public class BasicAuthCacheTest {\nefae8615a2b8 (Vojin Jovanovic 2026-05-20 12:23:26 +0200 26) \nefae8615a2b8 (Vojin Jovanovic 2026-05-20 12:23:26 +0200 27)     @Test\nefae8615a2b8 (Vojin Jovanovic 2026-05-20 12:23:26 +0200 28)     void storesSerializedAuthSchemeAndRestoresItOnLookup() throws Exception {\nefae8615a2b8 (Vojin Jovanovic 2026-05-20 12:23:26 +0200 29)         final HttpHost host = new HttpHost(\"https\", \"example.test\", 443);\nefae8615a2b8 (Vojin Jovanovic 2026-05-20 12:23:26 +0200 30)         final BasicScheme scheme = new BasicScheme(StandardCharsets.UTF_8);\nefae8615a2b8 (Vojin Jovanovic 2026-05-20 12:23:26 +0200 31)         scheme.processChallenge(new AuthChallenge(\nefae8615a2b8 (Vojin Jovanovic 2026-05-20 12:23:26 +0200 32)                 ChallengeType.TARGET,\nefae8615a2b8 (Vojin Jovanovic 2026-05-20 12:23:26 +0200 33)                 StandardAuthScheme.BASIC,\nefae8615a2b8 (Vojin Jovanovic 2026-05-20 12:23:26 +0200 34)                 new BasicNameValuePair(\"realm\", \"cached\")), null);\nefae8615a2b8 (Vojin Jovanovic 2026-05-20 12:23:26 +0200 35)         scheme.initPreemptive(new UsernamePasswordCredentials(\"\\u00fcser\", \"p\\u00e4ss\".toCharArray()));\nefae8615a2b8 (Vojin Jovanovic 2026-05-20 12:23:26 +0200 36) \nefae8615a2b8 (Vojin Jovanovic 2026-05-20 12:23:26 +0200 37)         final BasicAuthCache authCache = new BasicAuthCache();\nefae8615a2b8 (Vojin Jovanovic 2026-05-20 12:23:26 +0200 38)         authCache.put(host, \"/secure\", scheme);\nefae8615a2b8 (Vojin Jovanovic 2026-05-20 12:23:26 +0200 39) \nefae8615a2b8 (Vojin Jovanovic 2026-05-20 12:23:26 +0200 40)         final AuthScheme restored = authCache.get(host, \"/secure\");\nefae8615a2b8 (Vojin Jovanovic 2026-05-20 12:23:26 +0200 41) \nefae8615a2b8 (Vojin Jovanovic 2026-05-20 12:23:26 +0200 42)         assertThat(restored).isInstanceOf(BasicScheme.class);\nefae8615a2b8 (Vojin Jovanovic 2026-05-20 12:23:26 +0200 43)         assertThat(restored).isNotSameAs(scheme);\nefae8615a2b8 (Vojin Jovanovic 2026-05-20 12:23:26 +0200 44)         assertThat(restored.getRealm()).isEqualTo(\"cached\");\nefae8615a2b8 (Vojin Jovanovic 2026-05-20 12:23:26 +0200 45)         assertThat(restored.isChallengeComplete()).isTrue();\nefae8615a2b8 (Vojin Jovanovic 2026-05-20 12:23:26 +0200 46)         final String expectedCredentials = Base64.getEncoder()\nefae8615a2b8 (Vojin Jovanovic 2026-05-20 12:23:26 +0200 47)                 .encodeToString(\"\\u00fcser:p\\u00e4ss\".getBytes(StandardCharsets.UTF_8));\nefae8615a2b8 (Vojin Jovanovic 2026-05-20 12:23:26 +0200 48)         assertThat(restored.generateAuthResponse(host, null, null))\nefae8615a2b8 (Vojin Jovanovic 2026-05-20 12:23:26 +0200 49)                 .isEqualTo(StandardAuthScheme.BASIC + \" \" + expectedCredentials);\nefae8615a2b8 (Vojin Jovanovic 2026-05-20 12:23:26 +0200 50)     }\nefae8615a2b8 (Vojin Jovanovic 2026-05-20 12:23:26 +0200 51) }\n"}], "isError": false, "timestamp": 1790685359594}, {"role": "toolResult", "toolCallId": "call_BdXpUcoilXYOrHeFSGiZ1GrI|fc_026649242a2f5852016abbb0af111c87d2a1dd0b37fc21e419", "toolName": "read", "content": [{"type": "text", "text": "[\n  {\n    \"latest\" : true,\n    \"auto-update\" : true,\n    \"metadata-version\" : \"5.3\",\n    \"test-version\" : \"5.2.1\",\n    \"tested-versions\" : [\n      \"5.3\"\n    ],\n    \"allowed-packages\" : [\n      \"org.apache.hc.client5.http\"\n    ]\n  },\n  {\n    \"metadata-version\" : \"5.2.1\",\n    \"source-code-url\" : \"https://repo.maven.apache.org/maven2/org/apache/httpcomponents/client5/httpclient5/$version$/httpclient5-$version$-sources.jar\",\n    \"repository-url\" : \"https://github.com/apache/httpcomponents-client\",\n    \"test-code-url\" : \"https://repo.maven.apache.org/maven2/org/apache/httpcomponents/client5/httpclient5/$version$/httpclient5-$version$-tes