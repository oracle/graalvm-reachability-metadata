o(MemoryUnit.MB);\n        }\n    }\n\n    @SuppressWarnings({\"rawtypes\", \"unchecked\"})\n    private static Class<? extends Serializer<MemoryUnit>> plainJavaSerializerClass() {\n        return (Class) PlainJavaSerializer.class;\n    }\n}\n"}
