GenericUtils.EMPTY_BYTE_ARRAY;\n        if (len > 0) {\n            System.arraycopy(data, offset, clone, 0, len);\n        }\n\n        return new ByteArrayBuffer(clone, true);\n    }\n}\n"}], "isError": false, "timestamp": 1789505470225}}
