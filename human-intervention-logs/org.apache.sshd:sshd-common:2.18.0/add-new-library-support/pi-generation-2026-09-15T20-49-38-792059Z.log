      rsaSHA512(KeyUtils.RSA_SHA512_KEY_TYPE_ALIAS) {
          private final AtomicReference<Boolean> supportHolder = new AtomicReference<>();
  
          @Override
          public Signature create() {
              return new SignatureRSASHA512();
