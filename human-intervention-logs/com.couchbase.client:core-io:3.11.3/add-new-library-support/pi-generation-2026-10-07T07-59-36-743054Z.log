blish(T event) {\n    for (Consumer<T> listener : listeners) {\n      try {\n        listener.accept(event);\n      } catch (RuntimeException t) {\n        log.error(\"SynchronousEventBus subscriber threw exception.\", t);\n      }\n    }\n  }\n}\n"}], "isError": false, "timestamp": 1791360599102}}
