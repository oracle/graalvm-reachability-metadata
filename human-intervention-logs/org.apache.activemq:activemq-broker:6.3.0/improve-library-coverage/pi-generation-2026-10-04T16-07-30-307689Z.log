 static int availablePort() throws IOException {\n        try (ServerSocket socket = new ServerSocket(0)) {\n            return socket.getLocalPort();\n        }\n    }\n\n    private static void awaitConnectorStart(ManagementContext context) throws InterruptedException {\n        long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(20L);\n        while (!context.isConnectorStarted() && System.nanoTime() < deadline) {\n            Thread.sleep(10L);\n        }\n    }\n}\nResource refs:\ntests/src/org.apache.activemq/activemq-broker/6.3.0/src/test/java/org_apache_activemq/activemq_broker/Log4JConfigViewTest.java:9:import org.apache.activemq.broker.jmx.Log4JConfigView;\ntests/src/org.apache.activemq/activemq-broker/6.3.0/src/test/java/org_apache_activemq/activemq_broker/Log4JConfigViewTest.java:19:public class Log4JConfigViewTest {\ntests/src/org.apache.activemq/activemq-broker/6.3.0/src/test/java/org_apache_activemq/activemq_broker/Log4JConfigViewTest.java:23:        URL configuration = Log4JConfigViewTest.class.getResource(\"/log4j2.properties\");\ntests/src/org.apache.activemq/activemq-broker/6.3.0/src/test/java/org_apache_activemq/activemq_broker/Log4JConfigViewTest.java:25:        String originalConfiguration = System.setProperty(\"log4j2.configurationFile\", configuration.toExternalForm());\ntests/src/org.apache.activemq/activemq-broker/6.3.0/src/test/java/org_apache_activemq/activemq_broker/Log4JConfigViewTest.java:26:        Log4JConfigView view = new Log4JConfigView();\ntests/src/org.apache.activemq/activemq-broker/6.3.0/src/test/java/org_apache_activemq/activemq_broker/Log4JConfigViewTest.java:29:        assertThat(Log4JConfigView.isLog4JAvailable()).isTrue();\ntests/src/org.apache.activemq/activemq-broker/6.3.0/src/test/java/org_apache_activemq/activemq_broker/Log4JConfigViewTest.java:43:                System.clearProperty(\"log4j2.configurationFile\");\ntests/src/org.apache.activemq/activemq-broker/6.3.0/src/test/java/org_apache_activemq/activemq_