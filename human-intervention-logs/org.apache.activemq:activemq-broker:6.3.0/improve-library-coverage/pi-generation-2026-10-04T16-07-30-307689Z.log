      BrokerService brokerService = new BrokerService();\n        brokerService.addConnector(BROKER_URL_BASE);\n        brokerService.setUseJmx(false);\n        brokerService.getManagementContext().setCreateConnector(false);\n        brokerService.setUseShutdownHook(false);\n        brokerService.setPersistent(false);\n        brokerService.setBrokerName(\"embedded-broker\");\n        try {\n            brokerService.start();\n            brokerService.waitUntilStarted();\n\n            ActiveMQConnectionFactory connectionFactory = new ActiveMQConnectionFactory(BROKER_URL_BASE);\n            try (Connection connection = connectionFactory.createConnection()) {\n                assertThat(connection).isNotNull();\n            }\n        } finally {\n            brokerService.stop();\n            brokerService.waitUntilStopped();\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1791132508171}, {"role": "toolResult", "toolCallId": "call_ffhKAUFpMpJZ4nZCSLaiFSDH|fc_004e4598c2b71136016ac2835baec487d1938a765adb305064", "toolName": "bash", "content": [{"type": "text", "text": "8834\n\n\nCommand exited with code 1"}], "details": {}, "isError": true, "timestamp": 1791132508171}]}
