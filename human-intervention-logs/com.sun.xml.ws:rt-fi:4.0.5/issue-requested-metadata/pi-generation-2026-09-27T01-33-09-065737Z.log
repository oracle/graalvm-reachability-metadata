[recv] {"type": "message_start", "message": {"role": "toolResult", "toolCallId": "call_rTuVqO6Avw75K4qHhpXFpJdU|fc_0a460a593b87f3bf016ab87265225087d2829cacbbd1720230", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage com_sun_xml_ws.rt_fi;\n\nimport com.sun.xml.ws.api.pipe.Codec;\nimport com.sun.xml.ws.encoding.fastinfoset.FastInfosetCodec;\nimport com.sun.xml.ws.encoding.fastinfoset.FastInfosetMIMETypes;\nimport org.junit.jupiter.api.Test;\n\nimport static org.junit.jupiter.api.Assertions.assertEquals;\nimport static org.junit.jupiter.api.Assertions.assertInstanceOf;\nimport static org.junit.jupiter.api.Assertions.assertNotSame;\n\npublic class FastInfosetCodecTest {\n    @Test\n    void copiesCodecsWhilePreservingTheirEncodingMode() {\n        assertIndependentCopy(FastInfosetCodec.create(), FastInfosetMIMETypes.INFOSET);\n        assertIndependentCopy(FastInfosetCodec.create(true), FastInfosetMIMETypes.STATEFUL_INFOSET);\n    }\n\n    private static void assertIndependentCopy(FastInfosetCodec original, String expectedMimeType) {\n        Codec copy = original.copy();\n\n        assertInstanceOf(FastInfosetCodec.class, copy);\n        assertNotSame(original, copy, \"A copied codec must have independent parser and serializer state\");\n        assertEquals(expectedMimeType, original.getMimeType());\n        assertEquals(expectedMimeType, copy.getMimeType());\n    }\n}\n"}], "isError": false, "timestamp": 1790472805572}}
[recv] {"type": "message_end", "message": {"role": "toolResult", "toolCallId": "call_rTuVqO6Avw75K4qHhpXFpJdU|fc_0a460a593b87f3bf016ab87265225087d2829cacbbd1720230", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage com_sun_xml_ws.rt_fi;\n\nimport com.sun.xml.ws.api.pipe.Codec;\nimport com.sun.xml.ws.encoding.fastinfoset.FastInfosetCodec;\nimport com.sun.xml.ws.encoding.fastinfoset.FastInfosetMIMETypes;\nimport org.junit.jupiter.api.Test;\n\nimport static org.junit.jupiter.api.Assertions.assertEquals;\nimport static org.junit.jupiter.api.Assertions.assertInstanceOf;\nimport static org.junit.jupiter.api.Assertions.assertNotSame;\n\npublic class FastInfosetCodecTest {\n    @Test\n    void copiesCodecsWhilePreservingTheirEncodingMode() {\n        assertIndependentCopy(FastInfosetCodec.create(), FastInfosetMIMETypes.INFOSET);\n        assertIndependentCopy(FastInfosetCodec.create(true), FastInfosetMIMETypes.STATEFUL_INFOSET);\n    }\n\n    private static void assertIndependentCopy(FastInfosetCodec original, String expectedMimeType) {\n        Codec copy = original.copy();\n\n        assertInstanceOf(FastInfosetCodec.class, copy);\n        assertNotSame(original, copy, \"A copied codec must have independent parser and serializer state\");\n        assertEquals(expectedMimeType, original.getMimeType());\n        assertEquals(expectedMimeType, copy.getMimeType());\n    }\n}\n"}], "isError": false, "timestamp": 1790472805572}}
[recv] {"type": "message_start", "message": {"role": "toolResult", "toolCallId": "call_rn9RR8euy69rfLtAnI9Cflj7|fc_0a460a593b87f3bf016ab87265225887d2a47aa5fbbe356b9a", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage com_sun_xml_ws.rt_fi;\n\nimport com.sun.xml.ws.encoding.fastinfoset.FastInfosetStreamReaderFactory;\nimport java.io.ByteArrayInputStream;\nimport javax.xml.stream.XMLStreamReader;\nimport org.junit.jupiter.api.Test;\n\nimport static org.junit.jupiter.api.Assertions.assertNotSame;\nimport static org.junit.jupiter.api.Assertions.assertSame;\n\npublic class FastInfosetStreamReaderFactoryTest {\n    @Test\n    void reusesRecycledReadersFromItsThreadLocalPool() throws Exception {\n        FastInfosetStreamReaderFactory factory = FastInfosetStreamReaderFactory.getInstance();\n\n        XMLStreamReader firstReader = factory.doCreate(\n                null, new ByteArrayInputStream(new byte[0]), false);\n        XMLStreamReader secondReader = factory.doCreate(\n                null, new ByteArrayInputStream(new byte[0]), false);\n        assertNotSame(firstReader, secondReader, \"An empty pool must create an independent reader\");\n\n        firstReader.close();\n        factory.doRecycle(firstReader);\n        XMLStreamReader recycledReader = factory.doCreate(\n                null, new ByteArrayInputStream(new byte[0]), false);\n\n        assertSame(firstReader, recycledReader, \"The factory must reuse its thread-local reader\");\n        recycledReader.close();\n        secondReader.close();\n    }\n}\n"}], "isError": false, "timestamp": 1790472805572}}
