tate) {\n        StreamSOAPCodec xmlCodec = Codecs.createSOAPEnvelopeXmlCodec(version);\n        return FastInfosetStreamSOAPCodec.create(xmlCodec, version, retainState);\n    }\n}", "newText": "import com.sun.xml.ws.api.SOAPVersion;\nimport com.sun.xml.ws.api.message.Message;\nimport com.sun.xml.ws.api.message.Messages;\nimport com.sun.xml.ws.api.message.Packet;\nimport com.sun.xml.ws.api.pipe.Codecs;\nimport com.sun.xml.ws.api.pipe.ContentType;\nimport com.sun.xml.ws.api.pipe.StreamSOAPCodec;\nimport com.sun.xml.ws.encoding.fastinfoset.FastInfosetMIMETypes;\nimport com.sun.xml.ws.encoding.fastinfoset.FastInfosetStreamSOAPCodec;\nimport java.io.ByteArrayInputStream;\nimport java.io.ByteArrayOutputStream;\nimport java.io.StringReader;\nimport javax.xml.transform.stream.StreamSource;\nimport org.junit.jupiter.api.Test;\n\nimport static org.junit.jupiter.api.Assertions.assertEquals;\nimport static org.junit.jupiter.api.Assertions.assertTrue;\n\npublic class FastInfosetStreamSOAPCodecTest {\n    private static final String PAYLOAD_NAMESPACE = \"urn:rt-fi:soap:test\";\n\n    @Test\n    void roundTripsStatelessSoapMessagesForBothProtocolVersions() throws Exception {\n        FastInfosetStreamSOAPCodec soap11 = createCodec(SOAPVersion.SOAP_11, false);\n        FastInfosetStreamSOAPCodec soap12 = createCodec(SOAPVersion.SOAP_12, false);\n\n        assertEquals(FastInfosetMIMETypes.SOAP_11, soap11.getMimeType());\n        assertEquals(FastInfosetMIMETypes.SOAP_12, soap12.getMimeType());\n        assertSoapRoundTrip(soap11, SOAPVersion.SOAP_11, \"soap11\");\n        assertSoapRoundTrip(soap12, SOAPVersion.SOAP_12, \"soap12\");\n    }\n\n    @Test\n    void roundTripsRepeatedMessagesWithStatefulVocabulary() throws Exception {\n        FastInfosetStreamSOAPCodec soap11 = createCodec(SOAPVersion.SOAP_11, true);\n        FastInfosetStreamSOAPCodec soap12 = createCodec(SOAPVersion.SOAP_12, true);\n\n        assertEquals(FastInfosetMIMETypes.STATEFUL_SOAP_11, soap11.getMimeType());\n        assertEquals(FastInfosetMIMETypes.STATEFUL_SOAP_12, soap12.getMimeType());\n        assertSoapRoundTrip(soap11, SOAPVersion.SOAP_11, \"first\");\n        assertSoapRoundTrip(soap11, SOAPVersion.SOAP_11, \"second\");\n        assertSoapRoundTrip(soap12, SOAPVersion.SOAP_12, \"first\");\n        assertSoapRoundTrip(soap12, SOAPVersion.SOAP_12, \"second\");\n    }\n\n    private static void assertSoapRoundTrip(\n            FastInfosetStreamSOAPCodec codec, SOAPVersion version, String value) throws Exception {\n        String payload = \"<echo xmlns=\\\"\" + PAYLOAD_NAMESPACE + \"\\\"><value>\" + value + \"</value></echo>\";\n        Message message = Messages.createUsingPayload(\n                new StreamSource(new StringReader(payload)), version);\n        Packet outgoing = new Packet(message);\n        outgoing.soapAction = \"urn:echo\";\n        ByteArrayOutputStream encoded = new ByteArrayOutputStream();\n\n        ContentType contentType = codec.encode(outgoing, encoded);\n\n        assertTrue(\n                contentType.getContentType().startsWith(codec.getMimeType()),\n                \"The encoded SOAP message must use the codec's Fast Infoset MIME type\");\n        assertTrue(encoded.size() > 0, \"Encoding must produce a Fast Infoset SOAP envelope\");\n\n        Packet decoded = new Packet();\n        codec.decode(new ByteArrayInputStream(encoded.toByteArray()), contentType.getContentType(), decoded);\n\n        assertEquals(\"echo\", decoded.getMessage().getPayloadLocalPart());\n        assertEquals(PAYLOAD_NAMESPACE, decoded.getMessage().getPayloadNamespaceURI());\n    }\n\n    private static FastInfosetStreamSOAPCodec createCodec(SOAPVersion version, boolean retainState) {\n        StreamSOAPCodec xmlCodec = Codecs.createSOAPEnvelopeXmlCodec(version);\n        return FastInfosetStreamSOAPCodec.create(xmlCodec, version, retainState);\n    }\n}"}]}
