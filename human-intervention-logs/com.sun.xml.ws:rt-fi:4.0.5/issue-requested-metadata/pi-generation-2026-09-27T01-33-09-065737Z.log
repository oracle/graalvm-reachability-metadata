encoding.fastinfoset.FastInfosetMIMETypes;\nimport org.junit.jupiter.api.Test;\n\nimport static org.junit.jupiter.api.Assertions.assertEquals;\nimport static org.junit.jupiter.api.Assertions.assertInstanceOf;\nimport static org.junit.jupiter.api.Assertions.assertNotSame;\n\npublic class FastInfosetCodecTest {\n    @Test\n    void copiesCodecsWhilePreservingTheirEncodingMode() {\n        assertIndependentCopy(FastInfosetCodec.create(), FastInfosetMIMETypes.INFOSET);\n        assertIndependentCopy(FastInfosetCodec.create(true), FastInfosetMIMETypes.STATEFUL_INFOSET);\n    }\n\n    private static void assertIndependentCopy(FastInfosetCodec original, String expectedMimeType) {\n        Codec copy = original.copy();\n\n        assertInstanceOf(FastInfosetCodec.class, copy);\n        assertNotSame(original, copy, \"A copied codec must have independent parser and serializer state\");\n        assertEquals(expectedMimeType, original.getMimeType());\n        assertEquals(expectedMimeType, copy.getMimeType());\n    }\n}", "newText": "import com.sun.xml.ws.api.SOAPVersion;\nimport com.sun.xml.ws.api.message.Message;\nimport com.sun.xml.ws.api.message.Messages;\nimport com.sun.xml.ws.api.message.Packet;\nimport com.sun.xml.ws.api.pipe.Codec;\nimport com.sun.xml.ws.api.pipe.ContentType;\nimport com.sun.xml.ws.encoding.fastinfoset.FastInfosetCodec;\nimport com.sun.xml.ws.encoding.fastinfoset.FastInfosetMIMETypes;\nimport java.io.ByteArrayInputStream;\nimport java.io.ByteArrayOutputStream;\nimport java.io.StringReader;\nimport javax.xml.transform.stream.StreamSource;\nimport org.junit.jupiter.api.Test;\n\nimport static org.junit.jupiter.api.Assertions.assertEquals;\nimport static org.junit.jupiter.api.Assertions.assertInstanceOf;\nimport static org.junit.jupiter.api.Assertions.assertNotSame;\nimport static org.junit.jupiter.api.Assertions.assertTrue;\n\npublic class FastInfosetCodecTest {\n    private static final String PAYLOAD_NAMESPACE = \"urn:rt-fi:test\";\n\n    @Test\n    void roundTripsPayloadsWithStatelessCodec() throws Exception {\n        FastInfosetCodec codec = FastInfosetCodec.create();\n\n        assertEquals(FastInfosetMIMETypes.INFOSET, codec.getMimeType());\n        assertPayloadRoundTrip(codec, \"first\");\n        assertPayloadRoundTrip(codec, \"second\");\n    }\n\n    @Test\n    void roundTripsPayloadsWithStatefulVocabulary() throws Exception {\n        FastInfosetCodec codec = FastInfosetCodec.create(true);\n\n        assertEquals(FastInfosetMIMETypes.STATEFUL_INFOSET, codec.getMimeType());\n        assertPayloadRoundTrip(codec, \"first\");\n        assertPayloadRoundTrip(codec, \"second\");\n    }\n\n    @Test\n    void copiesCodecsWhilePreservingTheirEncodingMode() {\n        assertIndependentCopy(FastInfosetCodec.create(), FastInfosetMIMETypes.INFOSET);\n        assertIndependentCopy(FastInfosetCodec.create(true), FastInfosetMIMETypes.STATEFUL_INFOSET);\n    }\n\n    private static void assertPayloadRoundTrip(FastInfosetCodec codec, String value) throws Exception {\n        String payload = \"<echo xmlns=\\\"\" + PAYLOAD_NAMESPACE + \"\\\"><value>\" + value + \"</value></echo>\";\n        Message message = Messages.createUsingPayload(\n                new StreamSource(new StringReader(payload)), SOAPVersion.SOAP_11);\n        ByteArrayOutputStream encoded = new ByteArrayOutputStream();\n\n        ContentType contentType = codec.encode(new Packet(message), encoded);\n\n        assertEquals(codec.getMimeType(), contentType.getContentType());\n        assertTrue(encoded.size() > 0, \"Encoding must produce a Fast Infoset document\");\n\n        Packet decoded = new Packet();\n        codec.decode(new ByteArrayInputStream(encoded.toByteArray()), contentType.getContentType(), decoded);\n\n        assertEquals(\"echo\", decoded.getMessage().getPayloadLocalPart());\n        assertEquals(PAYLOAD_NAMESPACE, decoded.getMessage().getPayloadNamespaceURI());\n    }\n\n    private static void assertIndependentCopy(FastInfosetCodec 