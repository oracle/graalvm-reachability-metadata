  +    private static void assertPayloadRoundTrip(FastInfosetCodec codec, String value) throws Exception {
  +        String payload = "<echo xmlns=\"" + PAYLOAD_NAMESPACE + "\"><value>" + value + "</value></echo>";
  +        Message message = Messages.createUsingPayload(
  +                new StreamSource(new StringReader(payload)), SOAPVersion.SOAP_11);
  +        ByteArrayOutputStream encoded = new ByteArrayOutputStream();
  +
  +        ContentType contentType = codec.encode(new Packet(message), encoded);
  +
  +        assertEquals(codec.getMimeType(), contentType.getContentType());
  +        assertTrue(encoded.size() > 0, "Encoding must produce a Fast Infoset document");
  +
  +        Packet decoded = new Packet();
  +        codec.decode(new ByteArrayInputStream(encoded.toByteArray()), contentType.getContentType(), decoded);
  +
  +        assertEquals("echo", decoded.getMessage().getPayloadLocalPart());
  +        assertEquals(PAYLOAD_NAMESPACE, decoded.getMessage().getPayloadNamespaceURI());
  +    }
