d a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage com_sun_xml_ws.rt_fi;\n\nimport com.sun.xml.ws.api.SOAPVersion;\nimport com.sun.xml.ws.api.message.Message;\nimport com.sun.xml.ws.api.message.Messages;\nimport com.sun.xml.ws.api.message.Packet;\nimport com.sun.xml.ws.api.pipe.Codec;\nimport com.sun.xml.ws.api.pipe.Codecs;\nimport com.sun.xml.ws.api.pipe.ContentType;\nimport com.sun.xml.ws.api.pipe.StreamSOAPCodec;\nimport com.sun.xml.ws.encoding.fastinfoset.FastInfosetMIMETypes;\nimport com.sun.xml.ws.encoding.fastinfoset.FastInfosetStreamSOAPCodec;\nimport java.io.ByteArrayInputStream;\nimport java.io.ByteArrayOutputStream;\nimport java.io.StringReader;\nimport javax.xml.stream.XMLStreamConstants;\nimport javax.xml.stream.XMLStreamReader;\nimport javax.xml.transform.stream.StreamSource;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.Timeout;\n\nimport static org.junit.jupiter.api.Assertions.assertEquals;\nimport static org.junit.jupiter.api.Assertions.assertNotNull;\nimport static org.junit.jupiter.api.Assertions.assertNotSame;\nimport static org.junit.jupiter.api.Assertions.assertTrue;\n\n@Timeout(60)\npublic class FastInfosetStreamSOAPCodecTest {\n    private static final String PAYLOAD = \"\"\"\n            <message xmlns=\"urn:rt-fi:test\" id=\"42\">hello SOAP fast infoset</message>\n            \"\"\";\n\n    @Test\n    void roundTripsSoapEnvelopesThroughFastInfoset() throws Exception {\n        assertSoapRoundTrip(SOAPVersion.SOAP_11, FastInfosetMIMETypes.SOAP_11);\n        assertSoapRoundTrip(SOAPVersion.SOAP_12, FastInfosetMIMETypes.SOAP_12);\n    }\n    @Test\n    void createsFastInfosetStreamingSoapCodecs() {\n        StreamSOAPCodec soap11XmlCodec = Codecs.createSOAPEnvelopeXmlCodec(SOAPVersion.SOAP_11);\n        StreamSOAPCodec soap12XmlCodec = Codecs.createSOAPEnvelopeXmlCodec(SOAPVersion.SOAP_12);\n        FastInfosetStreamSOAPCodec soap11Codec =\n                FastInfosetStreamSOAPCodec.create(soap11XmlCodec, SOAPVersion.SOAP_11);\n        FastInfosetStreamSOAPCodec soap12Codec =\n                FastInfosetStreamSOAPCodec.create(soap12XmlCodec, SOAPVersion.SOAP_12);\n        FastInfosetStreamSOAPCodec statefulSoap12Codec =\n                FastInfosetStreamSOAPCodec.create(soap12XmlCodec, SOAPVersion.SOAP_12, true);\n\n        assertEquals(FastInfosetMIMETypes.SOAP_11, soap11Codec.getMimeType());\n        assertEquals(FastInfosetMIMETypes.SOAP_12, soap12Codec.getMimeType());\n        assertEquals(FastInfosetMIMETypes.STATEFUL_SOAP_12, statefulSoap12Codec.getMimeType());\n\n        Codec copy = statefulSoap12Codec.copy();\n        assertNotSame(statefulSoap12Codec, copy);\n        assertEquals(FastInfosetMIMETypes.STATEFUL_SOAP_12, copy.getMimeType());\n    }\n\n    @Test\n    void createsStatefulSoap11Codec() {\n        StreamSOAPCodec soap11XmlCodec = Codecs.createSOAPEnvelopeXmlCodec(SOAPVersion.SOAP_11);\n        FastInfosetStreamSOAPCodec statefulSoap11Codec =\n                FastInfosetStreamSOAPCodec.create(soap11XmlCodec, SOAPVersion.SOAP_11, true);\n\n        assertEquals(FastInfosetMIMETypes.STATEFUL_SOAP_11, statefulSoap11Codec.getMimeType());\n        assertEquals(\n                FastInfosetMIMETypes.STATEFUL_SOAP_11,\n                statefulSoap11Codec.copy().getMimeType());\n    }\n\n    private static void assertSoapRoundTrip(SOAPVersion soapVersion, String expectedMimeType)\n            throws Exception {\n        StreamSOAPCodec xmlCodec = Codecs.createSOAPEnvelopeXmlCodec(soapVersion);\n        FastInfosetStreamSOAPCodec fastInfosetCodec =\n                FastInfosetStreamSOAPCodec.create(xmlCodec, soapVersion);\n        Message message = Messages.createUsingPayload(\n                new StreamSource(new StringReader(PAYLOAD)), soapVersion);\n        ByteArrayOutputStream encoded = new ByteArrayOutputStream();\n\n        ContentType contentType = fastInfosetCodec.encode(new Packet(message), encoded);\n\n        assertEquals(expectedMimeType, contentType.getContentType());\n        assertTrue(encoded.size() > 0);\n\n        Packet decoded = new Packet();\n        fastInfosetCodec.decode(\n                new ByteArrayInputStream(encoded.toByteArray()),\n                contentType.getContentType(),\n                decoded);\n\n        assertEquals(soapVersion, decoded.getMessage().getSOAPVersion());\n        assertPayload(decoded);\n    }\n\n    private static void assertPayload(Packet packet) throws Exception {\n        Message message = packet.getMessage();\n        assertNotNull(message);\n\n        XMLStreamReader reader = message.readPayload();\n        try {\n            assertEquals(XMLStreamConstants.START_ELEMENT, reader.getEventType());\n            assertEquals(\"message\", reader.getLocalName());\n            assertEquals(\"urn:rt-fi:test\", reader.getNamespaceURI());\n            assertEquals(\"42\", reader.getAttributeValue(null, \"id\"));\n            assertEquals(\"hello SOAP fast infoset\", reader.getElementText());\n        } finally {\n            reader.close();\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1790956084893}, {"role": "toolResult", "toolCallId": "call_umdpvEJ7d3vj6HOk92tWn4zf|fc_0e6e06e239d42b3d016abfd233d09087d1912435aedcc1efce", "toolName": "bash", "content": [{"type": "text", "text": "\n--- diff ---\ndiff --git a/tests/src/com.sun.xml.ws/rt-fi/4.0.5/src/test/java/com_sun_xml_ws/rt_fi/FastInfosetCodecCopyTest.java b/tests/src/com.sun.xml.ws/rt-fi/4.0.5/src/test/java/com_sun_xml_ws/rt_fi/FastInfosetCodecCopyTest.java\nindex 347a11ce6a..05a1128028 100644\n--- a/tests/src/com.sun.xml.ws/rt-fi/4.0.5/src/test/java/com_sun_xml_ws/rt_fi/FastInfosetCodecCopyTest.java\n+++ b/tests/src/com.sun.xml.ws/rt-fi/4.0.5/src/test/java/com_sun_xml_ws/rt_fi/FastInfosetCodecCopyTest.java\n@@ -6,16 +6,55 @@\n  */\n package com_sun_xml_ws.rt_fi;\n \n+import com.sun.xml.ws.api.SOAPVersion;\n+import com.sun.xml.ws.api.mess