  package com_sun_xml_ws.rt_fi;
  
  import com.sun.xml.ws.api.SOAPVersion;
  import com.sun.xml.ws.api.message.Message;
  import com.sun.xml.ws.api.message.Messages;
  import com.sun.xml.ws.api.message.Packet;
  import com.sun.xml.ws.api.pipe.Codec;
  import com.sun.xml.ws.api.pipe.ContentType;
  import com.sun.xml.ws.encoding.fastinfoset.FastInfosetCodec;
  import com.sun.xml.ws.encoding.fastinfoset.FastInfosetMIMETypes;
  import java.io.ByteArrayInputStream;
  import java.io.ByteArrayOutputStream;
  import java.io.StringReader;
  import javax.xml.stream.XMLStreamConstants;
  import javax.xml.stream.XMLStreamReader;
  import javax.xml.transform.stream.StreamSource;
  import org.junit.jupiter.api.Test;
  import org.junit.jupiter.api.Timeout;
  
  import static org.junit.jupiter.api.Assertions.assertEquals;
  import static org.junit.jupiter.api.Assertions.assertInstanceOf;
  import static org.junit.jupiter.api.Assertions.assertNotNull;
  import static org.junit.jupiter.api.Assertions.assertNotSame;
  import static org.junit.jupiter.api.Assertions.assertTrue;
  
  @Timeout(60)
  public class FastInfosetCodecCopyTest {
      private static final String PAYLOAD = """
              <message xmlns="urn:rt-fi:test" id="42">hello fast infoset</message>
              """;
  
      @Test
      void roundTripsPayloadThroughFastInfosetCodec() throws Exception {
          FastInfosetCodec codec = FastInfosetCodec.create();
          Message message = Messages.createUsingPayload(
                  new StreamSource(new StringReader(PAYLOAD)), SOAPVersion.SOAP_11);
          ByteArrayOutputStream encoded = new ByteArrayOutputStream();
  
          ContentType contentType = codec.encode(new Packet(message), encoded);
  
          assertEquals(FastInfosetMIMETypes.INFOSET, contentType.getContentType());
          assertTrue(encoded.size() > 0);
  
          Packet decoded = new Packet();
          codec.decode(
                  new ByteArrayInputStream(encoded.toByteArray()),
                  contentType.getContentType(),
                  decoded);
  
          assertPayload(decoded);
      }
      @Test
      void copiesStatelessCodecWithItsEncodingMode() {
          assertCopyPreservesMimeType(FastInfosetCodec.create(), FastInfosetMIMETypes.INFOSET);
      }
  
      @Test
      void copiesStatefulCodecWithItsEncodingMode() {
          assertCopyPreservesMimeType(
                  FastInfosetCodec.create(true), FastInfosetMIMETypes.STATEFUL_INFOSET);
      }
  
      private static void assertCopyPreservesMimeType(
              FastInfosetCodec original, String expectedMimeType) {
          Codec copy = original.copy();
  
          assertInstanceOf(FastInfosetCodec.class, copy);
          assertNotSame(original, copy);
          assertEquals(expectedMimeType, original.getMimeType());
          assertEquals(expectedMimeType, copy.getMimeType());
      }
  
      private static void assertPayload(Packet packet) throws Exception {
          Message message = packet.getMessage();
          assertNotNull(message);
  
          XMLStreamReader reader = message.readPayload();
          try {
              assertEquals(XMLStreamConstants.START_ELEMENT, reader.getEventType());
              assertEquals("message", reader.getLocalName());
              assertEquals("urn:rt-fi:test", reader.getNamespaceURI());
              assertEquals("42", reader.getAttributeValue(null, "id"));
              assertEquals("hello fast infoset", reader.getElementText());
          } finally {
              reader.close();
          }
      }
  }
