yOutputStream encoded = new ByteArrayOutputStream();\n\n        ContentType contentType = codec.encode(new Packet(message), encoded);\n\n        assertEquals(FastInfosetMIMETypes.INFOSET, contentType.getContentType());\n        assertTrue(encoded.size() > 0);\n\n        Packet decoded = new Packet();\n        codec.decode(\n                new ByteArrayInputStream(encoded.toByteArray()),\n                contentType.getContentType(),\n                decoded);\n\n        assertPayload(decoded);\n    }\n    @Test\n    void copiesStatelessCodecWithItsEncodingMode() {\n        assertCopyPreservesMimeType(FastInfosetCodec.create(), FastInfosetMIMETypes.INFOSET);\n    }\n\n    @Test\n    void copiesStatefulCodecWithItsEncodingMode() {\n        assertCopyPreservesMimeType(\n                FastInfosetCodec.create(true), FastInfosetMIMETypes.STATEFUL_INFOSET);\n    }\n\n    private static void assertCopyPreservesMimeType(\n            FastInfosetCodec original, String expectedMimeType) {\n        Codec copy = original.copy();\n\n        assertInstanceOf(FastInfosetCodec.class, copy);\n        assertNotSame(original, copy);\n        assertEquals(expectedMimeType, original.getMimeType());\n        assertEquals(expectedMimeType, copy.getMimeType());\n    }\n\n    private static void assertPayload(Packet packet) throws Exception {\n        Message message = packet.getMessage();\n        assertNotNull(message);\n\n        XMLStreamReader reader = message.readPayload();\n        try {\n            assertEquals(XMLStreamConstants.START_ELEMENT, reader.getEventType());\n            assertEquals(\"message\", reader.getLocalName());\n            assertEquals(\"urn:rt-fi:test\", reader.getNamespaceURI());\n            assertEquals(\"42\", reader.getAttributeValue(null, \"id\"));\n            assertEquals(\"hello fast infoset\", reader.getElementText());\n        } finally {\n            reader.close();\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1790956084892}}
