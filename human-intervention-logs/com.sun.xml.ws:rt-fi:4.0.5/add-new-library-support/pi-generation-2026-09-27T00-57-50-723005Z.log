      assertThat(encoded.toByteArray()).isNotEmpty();\n        assertThat(codec.getMimeType()).isEqualTo(FastInfosetMIMETypes.INFOSET);\n        assertThat(contentType.getContentType()).isEqualTo(FastInfosetMIMETypes.INFOSET);\n        assertThat(codec.getStaticContentType(new Packet()).getContentType())\n                .isEqualTo(FastInfosetMIMETypes.INFOSET);\n\n        Packet response = new Packet();\n        codec.decode(new ByteArrayInputStream(encoded.toByteArray()), contentType.getContentType(), response);\n        assertPayload(response.getMessage(), \"urn:records\", \"record\", \"status\", \"ready\", \"alpha & beta\");\n\n        Codec copy = codec.copy();\n        assertThat(copy).isNotSameAs(codec);\n        assertThat(copy.getMimeType()).isEqualTo(FastInfosetMIMETypes.INFOSET);\n    }\n\n    @Test\n    void payloadCodecHandlesEmptyMessagesAndStatefulMimeType() throws Exception {\n        FastInfosetCodec codec = FastInfosetCodec.create(true);\n        ByteArrayOutputStream encoded = new ByteArrayOutputStream();\n\n        ContentType contentType = codec.encode(new Packet(Messages.createEmpty(SOAPVersion.SOAP_11)), encoded);\n\n        assertThat(encoded.size()).isZero();\n        assertThat(contentType.getContentType()).isEqualTo(FastInfosetMIMETypes.STATEFUL_INFOSET);\n\n        Packet response = new Packet();\n        codec.decode(new ByteArrayInputStream(new byte[0]), contentType.getContentType(), response);\n        assertThat(response.getMessage()).isNotNull();\n        assertThat(response.getMessage().hasPayload()).isFalse();\n    }\n\n    @Test\n    void soap11CodecRoundTripsEnvelopeAndSoapAction() throws Exception {\n        FastInfosetStreamSOAPCodec codec = soapCodec(SOAPVersion.SOAP_11, false);\n        Packet request = payloadPacket(\n                SOAPVersion.SOAP_11,\n                \"<m:request xmlns:m=\\\"urn:service\\\" id=\\\"17\\\">hello</m:request>\");\n        request.soapAction = \"urn:lookup\";\n        ByteArrayOutputStream encoded = new ByteArrayOutputStream();\n\n        ContentType contentType = codec.encode(request, encoded);\n\n        assertThat(codec.getMimeType()).isEqualTo(FastInfosetMIMETypes.SOAP_11);\n        assertThat(contentType.getContentType()).isEqualTo(FastInfosetMIMETypes.SOAP_11);\n        assertThat(contentType.getSOAPActionHeader()).isEqualTo(\"\\\"urn:lookup\\\"\");\n        assertThat(encoded.toByteArray()).isNotEmpty();\n\n        Packet response = new Packet();\n        codec.decode(new ByteArrayInputStream(encoded.toByteArray()), contentType.getContentType(), response);\n        assertPayload(response.getMessage(), \"urn:service\", \"request\", \"id\", \"17\", \"hello\");\n\n        Codec copy = codec.copy();\n        assertThat(copy).isNotSameAs(codec);\n        assertThat(copy.getMimeType()).isEqualTo(FastInfosetMIMETypes.SOAP_11);\n    }\n\n    @Test\n    void statefulSoap12CodecRoundTripsConsecutiveEnvelopes() throws Exception {\n        FastInfosetStreamSOAPCodec codec = soapCodec(SOAPVersion.SOAP_12, true);\n\n        roundTripSoap12(codec, \"first\", \"1\");\n        roundTripSoap12(codec, \"second\", \"2\");\n    }\n\n    private static void roundTripSoap12(FastInfosetStreamSOAPCodec codec, String value, String sequence)\n            throws Exception {\n        Packet request = payloadPacket(\n                SOAPVersion.SOAP_12,\n                \"<m:event xmlns:m=\\\"urn:events\\\" sequence=\\\"\" + sequence + \"\\\">\" + value + \"</m:event>\");\n        request.soapAction = \"urn:publish\";\n        ByteArrayOutputStream encoded = new ByteArrayOutputStream();\n\n        ContentType contentType = codec.encode(request, encoded);\n\n        assertThat(codec.getMimeType()).isEqualTo(FastInfosetMIMETypes.STATEFUL_SOAP_12);\n        assertThat(contentType.getContentType())\n                .isEqualTo(FastInfosetMIMETypes.STATEFUL_SOAP_12 + \";action=\\\"urn:publish\\\"\");\n        assertThat(contentType.getSOAPActionHeader()).isNull();\n        assertThat(encoded.toByteArray()).isNotEmpty();\n\n        Packet response = new Packet();\n        codec.decode(new ByteArrayInputStream(encoded.toByteArray()), contentType.getContentType(), response);\n        assertPayload(response.getMessage(), \"urn:events\", \"event\", \"sequence\", sequence, value);\n    }\n\n    private static FastInfosetStreamSOAPCodec soapCodec(SOAPVersion version, boolean retainState) {\n        StreamSOAPCodec xmlCodec = Codecs.createSOAPEnvelopeXmlCodec(version);\n        return FastInfosetStreamSOAPCodec.create(xmlCodec, version, retainState);\n    }\n\n    private static Packet payloadPacket(SOAPVersion version, String payload) {\n        Source source = new StreamSource(new StringReader(payload));\n        return new Packet(Messages.createUsingPayload(source, version));\n    }\n\n    private static void assertPayload(\n            Message message,\n            String namespace,\n            String localName,\n            String attributeName,\n            String attributeValue,\n            String text)\n            throws Exception {\n        assertThat(message).isNotNull();\n        assertThat(message.hasPayload()).isTrue();\n        assertThat(message.getPayloadNamespaceURI()).isEqualTo(namespace);\n        assertThat(message.getPayloadLocalPart()).isEqualTo(localName);\n\n        DOMResult result = new DOMResult();\n        TransformerFactory.newInstance().newTransformer().transform(message.readPayloadAsSource(), result);\n        Document document = (Document) result.getNode();\n        Element payload = document.getDocumentElement();\n\n        assertThat(payload.getNamespaceURI()).isEqualTo(namespace);\n        assertThat(payload.getLocalName()).isEqualTo(localName);\n        assertThat(payload.getAttribute(attributeName)).isEqualTo(attributeValue);\n        assertThat(payload.getTextContent()).isEqualTo(text);\n        assertThat(payload.getTextContent().getBytes(StandardCharsets.UTF_8)).isNotEmpty();\n    }\n}\n"}
