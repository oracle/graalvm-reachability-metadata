      //TODO method should be public in some util package?
      private static InputStream hasSomeData(InputStream in) throws IOException {
          if (in != null) {
              if (in.available() < 1) {
                  if (!in.markSupported()) {
                      in = new BufferedInputStream(in);
                  }
                  in.mark(1);
                  if (in.read() != -1) {
