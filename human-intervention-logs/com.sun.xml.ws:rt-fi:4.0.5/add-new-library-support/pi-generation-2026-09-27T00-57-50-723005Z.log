[tool-call] delta {"path":"tests/src/com.sun.xml.ws/rt-fi/4.0.5/src/test/java/com_sun_xml_ws/rt_fi/Rt_fiTest.java","edits":[{"oldText":"import org.junit.jupiter.api.Test;\nimport org.w3c.dom.Document;\nimport org.w3c.dom.Element;\n\nimport javax.xml.transform.Source;\nimport javax.xml.transform.TransformerFactory;\nimport javax.xml.transform.dom.DOMResult;\nimport javax.xml.transform.stream.StreamSource;\nimport java.io.ByteArrayInputStream;\nimport java.io.ByteArrayOutputStream;\nimport java.io.StringReader;\n","newText":"import org.junit.jupiter.api.Test;\nimport org.w3c.dom.Document;\n\nimport javax.xml.parsers.DocumentBuilderFactory;\nimport javax.xml.stream.XMLStreamConstants;\nimport javax.xml.stream.XMLStreamReader;\nimport java.io.ByteArrayInputStream;\nimport java.io.ByteArrayOutputStream;\nimport java.nio.charset.StandardCharsets;\n"},{"oldText":"    private static Packet payloadPacket(SOAPVersion version, String payload) {\n        Source source = new StreamSource(new StringReader(payload));\n        return new Packet(Messages.createUsingPayload(source, version));\n    }\n","newText":"    private static Packet payloadPacket(SOAPVersion version, String payload) throws Exception {\n        DocumentBuilderFactory factory = DocumentBuilderFactory.newInstance();\n        factory.setNamespaceAware(true);\n        Document document = factory.newDocumentBuilder()\n                .parse(new ByteArrayInputStream(payload.getBytes(StandardCharsets.UTF_8)));\n        return new Packet(Messages.createUsingPayload(document.getDocumentElement(), version));\n    }\n"},{"oldText":"        DOMResult result = new DOMResult();\n        TransformerFactory.newInstance().newTransformer().transform(message.readPayloadAsSource(), result);\n        Document document = (Document) result.getNode();\n        Element payload = document.getDocumentElement();\n\n        assertThat(payload.getNamespaceURI()).isEqualTo(namespace);\n        assertThat(payload.getLocalName()).isEqualTo(localName);\n        assertThat(payload.getAttribute(attributeName)).isEqualTo(attributeValue);\n        assertThat(payload.getTextContent()).isEqualTo(text);\n","newText":"        XMLStreamReader payload = message.readPayload();\n        try {\n            assertThat(payload.getEventType()).isEqualTo(XMLStreamConstants.START_ELEMENT);\n            assertThat(payload.getNamespaceURI()).isEqualTo(namespace);\n            assertThat(payload.getLocalName()).isEqualTo(localName);\n            assertThat(payload.getAttributeValue(null, attributeName)).isEqualTo(attributeValue);\n            assertThat(payload.getElementText()).isEqualTo(text);\n        } finally {\n            payload.close();\n        }\n"}]}
