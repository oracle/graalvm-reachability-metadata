[tool-call] delta {"path":"tests/src/com.sun.xml.ws/rt-fi/4.0.5/src/test/java/com_sun_xml_ws/rt_fi/FastInfosetStreamReaderFactoryTest.java","content":"/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage com_sun_xml_ws.rt_fi;\n\nimport java.io.ByteArrayInputStream;\nimport java.io.ByteArrayOutputStream;\n\nimport javax.xml.stream.XMLStreamReader;\n\nimport com.sun.xml.fastinfoset.stax.StAXDocumentSerializer;\nimport com.sun.xml.ws.encoding.fastinfoset.FastInfosetStreamReaderFactory;\nimport org.junit.jupiter.api.Test;\n\nimport static org.junit.jupiter.api.Assertions.assertEquals;\nimport static org.junit.jupiter.api.Assertions.assertSame;\n\npublic class FastInfosetStreamReaderFactoryTest {\n    @Test\n    void recyclesParserForSuccessiveFastInfosetDocuments() throws Exception {\n        FastInfosetStreamReaderFactory factory = FastInfosetStreamReaderFactory.getInstance();\n        XMLStreamReader first = factory.doCreate(null, encodedPayload(\"first\", \"First message\"), false);\n        assertPayload(first, \"first\", \"First message\");\n        first.close();\n        factory.doRecycle(first);\n\n        XMLStreamReader second = factory.doCreate(null, encodedPayload(\"second\", \"Second message\"), false);\n        try {\n            assertSame(first, second, \"The factory must reuse its thread-local Fast Infoset parser\");\n            assertPayload(second, \"second\", \"Second message\");\n        } finally {\n            second.close();\n            factory.doRecycle(second);\n        }\n    }\n\n    private static ByteArrayInputStream encodedPayload(String id, String text) throws Exception {\n        ByteArrayOutputStream output = new ByteArrayOutputStream();\n        StAXDocumentSerializer serializer = new StAXDocumentSerializer(output);\n        serializer.writeStartDocument();\n        serializer.writeStartElement(\"message\");\n        serializer.writeAttribute(\"id\", id);\n        serializer.writeCharacters(text);\n        serializer.writeEndElement();\n        serializer.writeEndDocument();\n        serializer.close();\n        return new ByteArrayInputStream(output.toByteArray());\n    }\n\n    private static void assertPayload(XMLStreamReader reader, String id, String text) throws Exception {\n        assertEquals(XMLStreamReader.START_ELEMENT, reader.nextTag());\n        assertEquals(\"message\", reader.getLocalName());\n        assertEquals(id, reader.getAttributeValue(null, \"id\"));\n        assertEquals(text, reader.getElementText());\n        while (reader.hasNext()) {\n            reader.next();\n        }\n    }\n}\n"}
