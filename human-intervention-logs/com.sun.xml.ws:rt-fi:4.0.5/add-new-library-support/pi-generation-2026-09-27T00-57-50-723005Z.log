a CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage com_sun_xml_ws.rt_fi;\n\nimport com.sun.xml.fastinfoset.stax.StAXDocumentSerializer;\nimport com.sun.xml.ws.api.pipe.Codec;\nimport com.sun.xml.ws.encoding.fastinfoset.FastInfosetCodec;\nimport com.sun.xml.ws.encoding.fastinfoset.FastInfosetMIMETypes;\nimport com.sun.xml.ws.encoding.fastinfoset.FastInfosetStreamReaderFactory;\nimport com.sun.xml.ws.encoding.fastinfoset.FastInfosetStreamReaderRecyclable;\nimport org.junit.jupiter.api.Test;\n\nimport javax.xml.stream.XMLStreamConstants;\nimport javax.xml.stream.XMLStreamReader;\nimport java.io.ByteArrayInputStream;\nimport java.io.ByteArrayOutputStream;\n\nimport static org.junit.jupiter.api.Assertions.assertTrue;\n\npublic class Rt_fiTest {\n    @Test\n    void readerFactoryParsesAndReusesFastInfosetReaders() throws Exception {\n        FastInfosetStreamReaderFactory factory = FastInfosetStreamReaderFactory.getInstance();\n        XMLStreamReader first = factory.doCreate(\n                null,\n                new ByteArrayInputStream(fastInfosetDocument(\"first\", \"1\")),\n                false);\n\n        assertPayload(first, \"first\", \"1\");\n        first.close();\n        factory.doRecycle(first);\n\n        XMLStreamReader second = factory.doCreate(\n                null,\n                new ByteArrayInputStream(fastInfosetDocument(\"second\", \"2\")),\n                false);\n\n        assertTrue(second == first, \"The reader factory must reuse a recycled Fast Infoset parser\");\n        assertPayload(second, \"second\", \"2\");\n        second.close();\n    }\n\n    @Test\n    void recyclableReaderReturnsToTheFactoryPool() throws Exception {\n        FastInfosetStreamReaderFactory factory = FastInfosetStreamReaderFactory.getInstance();\n        FastInfosetStreamReaderRecyclable recyclable = new FastInfosetStreamReaderRecyclable(\n                new ByteArrayInputStream(fastInfosetDocument(\"recyclable\", \"3\")));\n\n        assertPayload(recyclable, \"recyclable\", \"3\");\n        recyclable.close();\n        recyclable.onRecycled();\n\n        XMLStreamReader reused = factory.doCreate(\n                null,\n                new ByteArrayInputStream(fastInfosetDocument(\"reused\", \"4\")),\n                false);\n        assertTrue(reused == recyclable, \"A recyclable reader must return itself to the factory pool\");\n        assertPayload(reused, \"reused\", \"4\");\n        reused.close();\n    }\n\n    @Test\n    void codecCopiesPreserveConfiguredMimeTypes() {\n        FastInfosetCodec stateless = FastInfosetCodec.create();\n        FastInfosetCodec stateful = FastInfosetCodec.create(true);\n        Codec statelessCopy = stateless.copy();\n        Codec statefulCopy = stateful.copy();\n\n        assertTrue(\n                FastInfosetMIMETypes.INFOSET.equals(stateless.getMimeType()),\n                \"A stateless codec must advertise the Fast Infoset MIME type\");\n        assertTrue(\n                FastInfosetMIMETypes.STATEFUL_INFOSET.equals(stateful.getMimeType()),\n                \"A stateful codec must advertise the stateful Fast Infoset MIME type\");\n        assertTrue(statelessCopy != stateless, \"A stateless codec copy must be a distinct instance\");\n        assertTrue(statefulCopy != stateful, \"A stateful codec copy must be a distinct instance\");\n        assertTrue(\n                stateless.getMimeType().equals(statelessCopy.getMimeType()),\n                \"A stateless codec copy must preserve its MIME type\");\n        assertTrue(\n                stateful.getMimeType().equals(statefulCopy.getMimeType()),\n                \"A stateful codec copy must preserve its MIME type\");\n    }\n\n    private static byte[] fastInfosetDocument(String text, String sequence) throws Exception {\n        ByteArrayOutputStream output = new ByteArrayOutputStream();\n        StAXDocumentSerializer serializer = new StAXDocumentSerializer(output);\n        serializer.writeStartDocument();\n        serializer.setPrefix(\"m\", \"urn:messages\");\n        serializer.writeStartElement(\"m\", \"message\", \"urn:messages\");\n        serializer.writeNamespace(\"m\", \"urn:messages\");\n        serializer.writeAttribute(\"sequence\", sequence);\n        serializer.writeCharacters(text);\n        serializer.writeEndElement();\n        serializer.writeEndDocument();\n        serializer.flush();\n        return output.toByteArray();\n    }\n\n    private static void assertPayload(XMLStreamReader reader, String text, String sequence) throws Exception {\n        assertTrue(\n                reader.next() == XMLStreamConstants.START_ELEMENT,\n                \"The Fast Infoset document must start with an element\");\n        assertTrue(\"urn:messages\".equals(reader.getNamespaceURI()), \"The namespace must round-trip\");\n        assertTrue(\"message\".equals(reader.getLocalName()), \"The local name must round-trip\");\n        assertTrue(\n                sequence.equals(reader.getAttributeValue(null, \"sequence\")),\n                \"The sequence attribute must round-trip\");\n        assertTrue(text.equals(reader.getElementText()), \"The text content must round-trip\");\n    }\n}\n"}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-sol", "usage": {"input": 569, "output": 2482, "cacheRead": 141568, "cacheWrite": 0, "reasoning": 1184, "totalTokens": 144619, "cost": {"input": 0.002276, "output": 0.049640000000000004, "cacheRead": 0.0566272, "cacheWrite": 0, "total": 0.1085432}}, "stopReason": "toolUse", "timestamp": 1790471186490, "responseId": "resp_08fd32080f10cb8d016ab86c12ad6887d2a21647a70ee97544", "rawStopReason": "completed"}}
[tool-exec] start id=call_bTqXYNTdXXKEWYgOuolWadQN|fc_08fd32080f10cb8d016ab86c28fb4c87d2aabf322690c03368 name=write args={"path": "tests/src/com.sun.xml.ws/rt-fi/4.0.5/src/test/java/com_sun_xml_ws/rt_fi/Rt_fiTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage com_sun_xml_ws.rt_fi;\n\nimport com.sun.xml.fastinfoset.stax.StAXDocumentSerializer;\nimport com.sun.xml.ws.api.pipe.Codec;\nimport com.sun.xml.ws.encoding.fastinfoset.FastInfosetCodec;\nimport com.sun.xml.ws.encoding.fastinfoset.FastInfosetMIMETypes;\nimport com.sun.xml.ws.encoding.fastinfoset.FastInfosetStreamReaderFactory;\nimport com.sun.xml.ws.encoding.fastinfoset.FastInfosetStreamReaderRecyclable;\nimport org.junit.jupiter.api.Test;\n\nimport javax.xml.stream.XMLStreamConstants;\nimport javax.xml.stream.XMLStreamReader;\nimport java.io.ByteArrayInputStream;\nimport java.io.ByteArrayOutputStream;\n\nimport static org.junit.jupiter.api.Assertions.assertTrue;\n\npublic class Rt_fiTest {\n    @Test\n    void readerFactoryParsesAndReusesFastInfosetReaders() throws Exception {\n        FastInfosetStreamReaderFactory factory = FastInfosetStreamReaderFactory.getInstance();\n        XMLStreamReader first = factory.doCreate(\n                null,\n                new ByteArrayInputStream(fastInfosetDocument(\"first\", \"1\")),\n                false);\n\n        assertPayload(first, \"first\", \"1\");\n        first.close();\n        factory.doRecycle(first);\n\n        XMLStreamReader second = factory.doCreate(\n                null,\n                new ByteArrayInputStream(fastInfosetDocument(\"second\", \"2\")),\n                false);\n\n        assertTrue(second == first, \"The reader factory must reuse a recycled Fast Infoset parser\");\n        assertPayload(second, \"second\", \"2\");\n        second.close();\n    }\n\n    @Test\n    void recyclableReaderReturnsToTheFactoryPool() throws Exception {\n        FastInfosetStreamReaderFactory factory = FastInfosetStreamReaderFactory.getInstance();\n        FastInfosetStreamReaderRecyclable recyclable = new FastInfosetStreamReaderRecyclable(\n                new ByteArrayInputStream(fastInfosetDocument(\"recyclable\", \"3\")));\n\n        assertPayload(recyclable, \"recyclable\", \"3\");\n        recyclable.close();\n        recyclable.onRecycled();\n\n        XMLStreamReader reused = factory.doCreate(\n                null,\n                new ByteArrayInputStream(fastInfosetDocument(\"reused\", \"4\")),\n                false);\n        assertTrue(reused == recyclable, \"A recyclable reader must return itself to the factory pool\");\n        assertPayload(reused, \"reused\", \"4\");\n        reused.close();\n    }\n\n    @Test\n    void codecCopiesPreserveConfiguredMimeTypes() {\n        FastInfosetCodec stateless = FastInfosetCodec.create();\n        FastInfosetCodec stateful = FastInfosetCodec.create(true);\n        Codec statelessCopy = stateless.copy();\n        Codec statefulCopy = stateful.copy();\n\n        assertTrue(\n                FastInfosetMIMETypes.INFOSET.equals(stateless.getMimeType()),\n                \"A stateless codec must advertise the Fast Infoset MIME type\");\n        assertTrue(\n                FastInfosetMIMETypes.STATEFUL_INFOSET.equals(stateful.getMimeType()),\n                \"A stateful codec must advertise the stateful Fast Infoset MIME type\");\n        assertTrue(statelessCopy != stateless, \"A stateless codec copy must be a distinct instance\");\n        assertTrue(statefulCopy != stateful, \"A stateful codec copy must be a distinct instance\");\n        assertTrue(\n                stateless.getMimeType().equals(statelessCopy.getMimeType()),\n                \"A stateless codec copy must preserve its MIME type\");\n        assertTrue(\n                stateful.getMimeType().equals(statefulCopy.getMimeType()),\n                \"A stateful codec copy must preserve its MIME type\");\n    }\n\n    private static byte[] fastInfosetDocument(String text, String sequence) throws Exception {\n        ByteArrayOutputStream output = new ByteArrayOutputStream();\n        StAXDocumentSerializer serializer = new StAXDocumentSerializer(output);\n        serializer.writeStartDocument();\n        serializer.setPrefix(\"m\", \"urn:messages\");\n        serializer.writeStartElement(\"m\", \"message\", \"urn:messages\");\n        serializer.writeNamespace(\"m\", \"urn:messages\");\n        serializer.writeAttribute(\"sequence\", sequence);\n        serializer.writeCharacters(text);\n        serializer.writeEndElement();\n        serializer.writeEndDocument();\n        serializer.flush();\n        return output.toByteArray();\n    }\n\n    private static void assertPayload(XMLStreamReader reader, String text, String sequence) throws Exception {\n        assertTrue(\n                reader.next() == XMLStreamConstants.START_ELEMENT,\n                \"The Fast Infoset document must start with an element\");\n        assertTrue(\"urn:messages\".equals(reader.getNamespaceURI()), \"The namespace must round-trip\");\n        assertTrue(\"message\".equals(reader.getLocalName()), \"The local name must round-trip\");\n        assertTrue(\n                sequence.equals(reader.getAttributeValue(null, \"sequence\")),\n                \"The sequence attribute must round-trip\");\n        assertTrue(text.equals(reader.getElementText()), \"The text content must round-trip\");\n    }\n}\n"}
