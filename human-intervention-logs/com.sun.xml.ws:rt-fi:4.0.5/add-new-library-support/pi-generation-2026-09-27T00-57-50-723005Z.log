wText": "        Codec copy = codec.copy();\n        assertTrue(copy != codec, \"A codec copy must be a distinct instance\");\n        assertTrue(\n                FastInfosetMIMETypes.INFOSET.equals(copy.getMimeType()),\n                \"A codec copy must preserve its MIME type\");\n"}, {"oldText": "        assertThat(encoded.size()).isZero();\n        assertThat(contentType.getContentType()).isEqualTo(FastInfosetMIMETypes.STATEFUL_INFOSET);\n", "newText": "        assertTrue(encoded.size() == 0, \"An empty message must not produce payload bytes\");\n        assertTrue(\n                FastInfosetMIMETypes.STATEFUL_INFOSET.equals(contentType.getContentType()),\n                \"A stateful codec must advertise the stateful MIME type\");\n"}, {"oldText": "        assertThat(codec.getMimeType()).isEqualTo(FastInfosetMIMETypes.SOAP_11);\n        assertThat(contentType.getContentType()).isEqualTo(FastInfosetMIMETypes.SOAP_11);\n        assertThat(contentType.getSOAPActionHeader()).isEqualTo(\"\\\"urn:lookup\\\"\");\n        assertThat(encoded.toByteArray()).isNotEmpty();\n", "newText": "        assertTrue(\n                FastInfosetMIMETypes.SOAP_11.equals(codec.getMimeType()),\n                \"The SOAP 1.1 codec must advertise its Fast Infoset MIME type\");\n        assertTrue(\n                FastInfosetMIMETypes.SOAP_11.equals(contentType.getContentType()),\n                \"SOAP 1.1 encoding must return its Fast Infoset MIME type\");\n        assertTrue(\n                \"\\\"urn:lookup\\\"\".equals(contentType.getSOAPActionHeader()),\n                \"SOAP 1.1 encoding must preserve the quoted action\");\n        assertTrue(encoded.size() > 0, \"SOAP encoding must produce Fast Infoset data\");\n"}, {"oldText": "        Codec copy = codec.copy();\n        assertThat(copy).isNotSameAs(codec);\n        assertThat(copy.getMimeType()).isEqualTo(FastInfosetMIMETypes.SOAP_11);\n", "newText": "        Codec copy = codec.copy();\n        assertTrue(copy != codec, \"A SOAP codec copy must be a distinct instance\");\n        assertTrue(\n                FastInfosetMIMETypes.SOAP_11.equals(copy.getMimeType()),\n                \"A SOAP codec copy must preserve its MIME type\");\n"}, {"oldText": "        assertThat(codec.getMimeType()).isEqualTo(FastInfosetMIMETypes.STATEFUL_SOAP_12);\n        assertThat(contentType.getContentType())\n                .isEqualTo(FastInfosetMIMETypes.STATEFUL_SOAP_12 + \";action=\\\"urn:publish\\\"\");\n        assertThat(encoded.toByteArray()).isNotEmpty();\n", "newText": "        assertTrue(\n                FastInfosetMIMETypes.STATEFUL_SOAP_12.equals(codec.getMimeType()),\n                \"The stateful SOAP 1.2 codec must advertise its MIME type\");\n        assertTrue(\n                (FastInfosetMIMETypes.STATEFUL_SOAP_12 + \";action=\\\"urn:publish\\\"\")\n                        .equals(contentType.getContentType()),\n                \"SOAP 1.2 content type must carry the action\");\n        assertTrue(encoded.size() > 0, \"SOAP encoding must produce Fast Infoset data\");\n"}, {"oldText": "        assertThat(message).isNotNull();\n        assertThat(message.hasPayload()).isTrue();\n        assertThat(message.getPayloadNamespaceURI()).isEqualTo(namespace);\n        assertThat(message.getPayloadLocalPart()).isEqualTo(localName);\n", "newText": "        assertTrue(message != null, \"Decoded message must not be null\");\n        assertTrue(message.hasPayload(), \"Decoded message must have a payload\");\n        assertTrue(namespace.equals(message.getPayloadNamespaceURI()), \"Payload namespace must round-trip\");\n        assertTrue(localName.equals(message.getPayloadLocalPart()), \"Payload local name must round-trip\");\n"}, {"oldText": "        assertThat(payload.getEventType()).isEqualTo(XMLStreamConstants.START_ELEMENT);\n        assertThat(payload.getNamespaceURI()).isEqualTo(namespace);\n        assertThat(payload.getLocalName()).isEqualTo(localName);\n        assertThat(payload.getAttributeValue(null, attributeName)).isEqualTo(attributeValue);\n        assertThat(payload.getElementText()).isEqualTo(text);\n", "newText": "        assertTrue(\n                payload.getEventType() == XMLStreamConstants.START_ELEMENT,\n                \"Payload reader must point to the start element\");\n        assertTrue(namespace.equals(payload.getNamespaceURI()), \"Payload namespace must round-trip\");\n        assertTrue(localName.equals(payload.getLocalName()), \"Payload local name must round-trip\");\n        assertTrue(\n                attributeValue.equals(payload.getAttributeValue(null, attributeName)),\n                \"Payload attribute must round-trip\");\n        assertTrue(text.equals(payload.getElementText()), \"Payload text must round-trip\");\n"}]}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-sol", "usage": {"input": 817, "output": 2445, "cacheRead": 115584, "cacheWrite": 0, "reasoning": 865, "totalTokens": 118846, "cost": {"input": 0.0032679999999999996, "output": 0.048900000000000006, "cacheRead": 0.04623360000000001, "cacheWrite": 0, "total": 0.0984016}}, "stopReason": "toolUse", "timestamp": 1790471067395, "responseId": "resp_08fd32080f10cb8d016ab86b9b9c4c87d2a5008351b5aaeac3", "rawStopReason": "completed"}}
