oapAction == null || soapAction.length() == 0) {\n            return _defaultContentType;\n        } else {\n            return new ContentTypeImpl(_defaultContentType.getContentType(), soapAction);\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1790471471342}}
