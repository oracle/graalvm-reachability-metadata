[tool-call] delta {"path":"tests/src/com.sun.xml.ws/rt-fi/4.0.5/src/test/java/com_sun_xml_ws/rt_fi/FastInfosetCodecTest.java","content":"/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage com_sun_xml_ws.rt_fi;\n\nimport java.io.ByteArrayInputStream;\nimport java.io.ByteArrayOutputStream;\nimport java.io.StringReader;\n\nimport javax.xml.stream.XMLStreamReader;\nimport javax.xml.transform.stream.StreamSource;\n\nimport com.sun.xml.ws.api.SOAPVersion;\nimport com.sun.xml.ws.api.message.Message;\nimport com.sun.xml.ws.api.message.Messages;\nimport com.sun.xml.ws.api.message.Packet;\nimport com.sun.xml.ws.api.pipe.ContentType;\nimport com.sun.xml.ws.encoding.fastinfoset.FastInfosetCodec;\nimport com.sun.xml.ws.encoding.fastinfoset.FastInfosetMIMETypes;\nimport org.junit.jupiter.api.Test;\n\nimport static org.junit.jupiter.api.Assertions.assertEquals;\nimport static org.junit.jupiter.api.Assertions.assertNotNull;\nimport static org.junit.jupiter.api.Assertions.assertTrue;\n\npublic class FastInfosetCodecTest {\n    private static final String NAMESPACE = \"urn:example:messages\";\n\n    @Test\n    void roundTripsXmlPayloadThroughFastInfosetEncoding() throws Exception {\n        FastInfosetCodec codec = FastInfosetCodec.create();\n\n        assertRoundTrip(codec, FastInfosetMIMETypes.INFOSET, \"first\", \"Hello, Fast Infoset!\");\n    }\n\n    @Test\n    void roundTripsSuccessivePayloadsWithRetainedVocabulary() throws Exception {\n        FastInfosetCodec codec = FastInfosetCodec.create(true);\n\n        assertRoundTrip(codec, FastInfosetMIMETypes.STATEFUL_INFOSET, \"first\", \"A repeated vocabulary\");\n        assertRoundTrip(codec, FastInfosetMIMETypes.STATEFUL_INFOSET, \"second\", \"A repeated vocabulary\");\n    }\n\n    private static void assertRoundTrip(FastInfosetCodec codec, String mimeType, String id, String text)\n            throws Exception {\n        String payload = \"<message xmlns=\\\"\" + NAMESPACE + \"\\\" id=\\\"\" + id + \"\\\">\" + text + \"</message>\";\n        Message message = Messages.createUsingPayload(new StreamSource(new StringReader(payload)), SOAPVersion.SOAP_11);\n        ByteArrayOutputStream encoded = new ByteArrayOutputStream();\n\n        ContentType contentType = codec.encode(new Packet(message), encoded);\n\n        assertEquals(mimeType, contentType.getContentType());\n        assertTrue(encoded.size() > 0, \"The codec must produce a Fast Infoset document\");\n\n        Packet decoded = new Packet();\n        codec.decode(new ByteArrayInputStream(encoded.toByteArray()), contentType.getContentType(), decoded);\n\n        assertNotNull(decoded.getMessage());\n        assertTrue(decoded.getMessage().hasPayload());\n        try (XMLStreamReader reader = decoded.getMessage().readPayload()) {\n            assertEquals(\"message\", reader.getLocalName());\n            assertEquals(NAMESPACE, reader.getNamespaceURI());\n            assertEquals(id, reader.getAttributeValue(null, \"id\"));\n            assertEquals(text, reader.getElementText());\n        }\n    }\n}\n"}
