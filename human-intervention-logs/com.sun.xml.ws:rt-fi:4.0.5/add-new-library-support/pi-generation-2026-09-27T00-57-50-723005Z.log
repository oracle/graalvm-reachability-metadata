stinfoset.FastInfosetStreamReaderFactory;\nimport java.io.ByteArrayInputStream;\nimport java.io.ByteArrayOutputStream;\nimport javax.xml.stream.XMLStreamConstants;\nimport javax.xml.stream.XMLStreamReader;\nimport org.junit.jupiter.api.Test;\n\nimport static org.junit.jupiter.api.Assertions.assertEquals;\nimport static org.junit.jupiter.api.Assertions.assertSame;\n\npublic class FastInfosetStreamReaderFactoryTest {\n    @Test\n    void parsesFastInfosetDocumentsAndReusesRecycledReaders() throws Exception {\n        byte[] firstDocument = createFastInfosetDocument(\"first\");\n        byte[] secondDocument = createFastInfosetDocument(\"second\");\n        FastInfosetStreamReaderFactory factory = FastInfosetStreamReaderFactory.getInstance();\n\n        XMLStreamReader firstReader = factory.doCreate(\n                null, new ByteArrayInputStream(firstDocument), false);\n        assertDocument(firstReader, \"first\");\n        firstReader.close();\n        factory.doRecycle(firstReader);\n\n        XMLStreamReader secondReader = factory.doCreate(\n                null, new ByteArrayInputStream(secondDocument), false);\n        assertSame(firstReader, secondReader, \"The factory must reuse its thread-local reader\");\n        assertDocument(secondReader, \"second\");\n        secondReader.close();\n    }\n\n    private static byte[] createFastInfosetDocument(String value) throws Exception {\n        ByteArrayOutputStream output = new ByteArrayOutputStream();\n        StAXDocumentSerializer serializer = new StAXDocumentSerializer(output);\n        serializer.writeStartDocument();\n        serializer.writeEmptyElement(value);\n        serializer.writeEndDocument();\n        serializer.close();\n        return output.toByteArray();\n    }\n\n    private static void assertDocument(XMLStreamReader reader, String expectedValue) throws Exception {\n        reader.nextTag();\n        assertEquals(expectedValue, reader.getLocalName());\n        assertEquals(XMLStreamConstants.END_ELEMENT, reader.nextTag());\n    }\n}\n"}], "isError": false, "timestamp": 1790472381674}, {"role": "toolResult", "toolCallId": "call_L6LHICRVRXocMhtXL13W4X6h|fc_017f6a45c9677fca016ab870bd4a9087d2ab062458bd5393eb", "toolName": "bash", "content": [{"type": "text", "text": "?? metadata/com.sun.xml.ws/rt-fi/4.0.5/\n?? tests/src/com.sun.xml.ws/rt-fi/4.0.5/src/test/java/com_sun_xml_ws/rt_fi/FastInfosetStreamReaderFactoryTest.java\n"}], "isError": false, "timestamp": 1790472381674}]}
