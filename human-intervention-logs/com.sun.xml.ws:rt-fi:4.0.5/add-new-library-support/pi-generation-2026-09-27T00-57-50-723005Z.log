[tool-call] delta {"path":"tests/src/com.sun.xml.ws/rt-fi/4.0.5/src/test/java/com_sun_xml_ws/rt_fi/Rt_fiTest.java","content":"/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage com_sun_xml_ws.rt_fi;\n\nimport com.sun.xml.fastinfoset.stax.StAXDocumentParser;\nimport com.sun.xml.ws.api.pipe.Codec;\nimport com.sun.xml.ws.encoding.fastinfoset.FastInfosetCodec;\nimport com.sun.xml.ws.encoding.fastinfoset.FastInfosetMIMETypes;\nimport com.sun.xml.ws.encoding.fastinfoset.FastInfosetStreamReaderFactory;\nimport com.sun.xml.ws.encoding.fastinfoset.FastInfosetStreamReaderRecyclable;\nimport org.junit.jupiter.api.Test;\n\nimport javax.xml.stream.XMLStreamReader;\nimport java.io.ByteArrayInputStream;\nimport java.io.IOException;\n\nimport static org.junit.jupiter.api.Assertions.assertTrue;\n\npublic class Rt_fiTest {\n    @Test\n    void readerFactoryConfiguresClosesAndReusesReaders() throws Exception {\n        FastInfosetStreamReaderFactory factory = FastInfosetStreamReaderFactory.getInstance();\n        CloseTrackingInputStream firstInput = new CloseTrackingInputStream();\n        XMLStreamReader first = factory.doCreate(null, firstInput, false);\n\n        assertTrue(\n                first instanceof FastInfosetStreamReaderRecyclable,\n                \"The factory must create a recyclable Fast Infoset reader\");\n        StAXDocumentParser parser = (StAXDocumentParser) first;\n        assertTrue(parser.getStringInterning(), \"Factory readers must intern strings\");\n        assertTrue(parser.getForceStreamClose(), \"Factory readers must close their input streams\");\n\n        first.close();\n        assertTrue(firstInput.closed, \"Closing the reader must close its input stream\");\n        factory.doRecycle(first);\n\n        CloseTrackingInputStream secondInput = new CloseTrackingInputStream();\n        XMLStreamReader second = factory.doCreate(null, secondInput, false);\n        assertTrue(second == first, \"The factory must reuse a recycled Fast Infoset reader\");\n        second.close();\n        assertTrue(secondInput.closed, \"A reused reader must close its replacement input stream\");\n    }\n\n    @Test\n    void recyclableReaderReturnsItselfToTheFactoryPool() throws Exception {\n        FastInfosetStreamReaderFactory factory = FastInfosetStreamReaderFactory.getInstance();\n        FastInfosetStreamReaderRecyclable recyclable = new FastInfosetStreamReaderRecyclable();\n\n        recyclable.onRecycled();\n\n        XMLStreamReader reused = factory.doCreate(null, new ByteArrayInputStream(new byte[0]), false);\n        assertTrue(reused == recyclable, \"A recyclable reader must return itself to the factory pool\");\n        reused.close();\n    }\n\n    @Test\n    void codecCopiesPreserveConfiguredMimeTypes() {\n        FastInfosetCodec stateless = FastInfosetCodec.create();\n        FastInfosetCodec stateful = FastInfosetCodec.create(true);\n        Codec statelessCopy = stateless.copy();\n        Codec statefulCopy = stateful.copy();\n\n        assertTrue(\n                FastInfosetMIMETypes.INFOSET.equals(stateless.getMimeType()),\n                \"A stateless codec must advertise the Fast Infoset MIME type\");\n        assertTrue(\n                FastInfosetMIMETypes.STATEFUL_INFOSET.equals(stateful.getMimeType()),\n                \"A stateful codec must advertise the stateful Fast Infoset MIME type\");\n        assertTrue(statelessCopy != stateless, \"A stateless codec copy must be a distinct instance\");\n        assertTrue(statefulCopy != stateful, \"A stateful codec copy must be a distinct instance\");\n        assertTrue(\n                stateless.getMimeType().equals(statelessCopy.getMimeType()),\n                \"A stateless codec copy must preserve its MIME type\");\n        assertTrue(\n                stateful.getMimeType().equals(statefulCopy.getMimeType()),\n                \"A stateful codec copy must preserve its MIME type\");\n    }\n\n    private static final class CloseTrackingInputStream extends ByteArrayInputStream {\n        private boolean closed;\n\n        private CloseTrackingInputStream() {\n            super(new byte[0]);\n        }\n\n        @Override\n        public void close() throws IOException {\n            closed = true;\n            super.close();\n        }\n    }\n}\n"}
