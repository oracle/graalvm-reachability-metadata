[recv] {"type": "message_start", "message": {"role": "toolResult", "toolCallId": "call_JDICUCTXNGFt6k6d2tMY3BW4|fc_017f6a45c9677fca016ab86fffecb087d2929300954619662f", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage com_sun_xml_ws.rt_fi;\n\nimport com.sun.xml.ws.api.SOAPVersion;\nimport com.sun.xml.ws.api.message.Messages;\nimport com.sun.xml.ws.api.message.Packet;\nimport com.sun.xml.ws.api.pipe.Codec;\nimport com.sun.xml.ws.api.pipe.ContentType;\nimport com.sun.xml.ws.encoding.fastinfoset.FastInfosetCodec;\nimport com.sun.xml.ws.encoding.fastinfoset.FastInfosetMIMETypes;\nimport java.io.ByteArrayInputStream;\nimport java.io.ByteArrayOutputStream;\nimport java.io.StringReader;\nimport javax.xml.stream.XMLStreamReader;\nimport javax.xml.transform.stream.StreamSource;\nimport org.junit.jupiter.api.Test;\n\nimport static org.junit.jupiter.api.Assertions.assertEquals;\nimport static org.junit.jupiter.api.Assertions.assertInstanceOf;\nimport static org.junit.jupiter.api.Assertions.assertNotSame;\nimport static org.junit.jupiter.api.Assertions.assertTrue;\n\npublic class FastInfosetCodecTest {\n    @Test\n    void copiesCodecsWhilePreservingTheirEncodingMode() {\n        assertIndependentCopy(FastInfosetCodec.create(), FastInfosetMIMETypes.INFOSET);\n        assertIndependentCopy(FastInfosetCodec.create(true), FastInfosetMIMETypes.STATEFUL_INFOSET);\n    }\n\n    @Test\n    void roundTripsAnXmlPayloadAsFastInfoset() throws Exception {\n        String xml = \"<catalog xmlns=\\\"urn:catalog\\\"><item id=\\\"7\\\">metadata</item></catalog>\";\n        Packet source = new Packet(Messages.createUsingPayload(\n                new StreamSource(new StringReader(xml)), SOAPVersion.SOAP_11));\n        FastInfosetCodec codec = FastInfosetCodec.create();\n        ByteArrayOutputStream encoded = new ByteArrayOutputStream();\n\n        ContentType contentType = codec.encode(source, encoded);\n\n        assertEquals(FastInfosetMIMETypes.INFOSET, contentType.getContentType());\n        assertTrue(encoded.size() > 0, \"Encoding must produce a Fast Infoset document\");\n\n        Packet decoded = new Packet();\n        codec.decode(\n                new ByteArrayInputStream(encoded.toByteArray()), contentType.getContentType(), decoded);\n\n        assertEquals(\"catalog\", decoded.getMessage().getPayloadLocalPart());\n        assertEquals(\"urn:catalog\", decoded.getMessage().getPayloadNamespaceURI());\n        XMLStreamReader payload = decoded.getMessage().readPayload();\n        try {\n            assertEquals(\"catalog\", payload.getLocalName());\n            payload.nextTag();\n            assertEquals(\"item\", payload.getLocalName());\n            assertEquals(\"7\", payload.getAttributeValue(null, \"id\"));\n            assertEquals(\"metadata\", payload.getElementText());\n        } finally {\n            payload.close();\n        }\n    }\n\n    private static void assertIndependentCopy(FastInfosetCodec original, String expectedMimeType) {\n        Codec copy = original.copy();\n\n        assertInstanceOf(FastInfosetCodec.class, copy);\n        assertNotSame(original, copy, \"A copied codec must have independent parser and serializer state\");\n        assertEquals(expectedMimeType, original.getMimeType());\n        assertEquals(expectedMimeType, copy.getMimeType());\n    }\n}\n"}], "isError": false, "timestamp": 1790472192310}}
