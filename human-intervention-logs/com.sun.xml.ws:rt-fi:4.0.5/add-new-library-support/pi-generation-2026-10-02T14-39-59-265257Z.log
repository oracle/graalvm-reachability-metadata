 }\n\n    @Test\n    void roundTripsPayloadWithStatefulFastInfosetCodec() throws Exception {\n        roundTrip(FastInfosetCodec.create(true), SOAPVersion.SOAP_11);\n    }\n\n    @Test\n    void roundTripsSoap11EnvelopeWithFastInfosetCodec() throws Exception {\n        roundTripSoapEnvelope(SOAPVersion.SOAP_11);\n    }\n\n    @Test\n    void roundTripsSoap12EnvelopeWithFastInfosetCodec() throws Exception {\n        roundTripSoapEnvelope(SOAPVersion.SOAP_12);\n    }\n\n    private static void roundTrip(FastInfosetCodec codec, SOAPVersion soapVersion) throws Exception {\n        Packet input = new Packet(createMessage(soapVersion));\n        ByteArrayOutputStream encoded = new ByteArrayOutputStream();\n\n        ContentType contentType = codec.encode(input, encoded);\n\n        require(codec.getMimeType().equals(contentType.getContentType()), \"Unexpected MIME type\");\n        require(encoded.size() > 0, \"Fast Infoset output is empty\");\n        require(encoded.toByteArray()[0] == (byte) 0xe0, \"Missing Fast Infoset header\");\n\n        Packet decoded = new Packet();\n        codec.decode(\n                new ByteArrayInputStream(encoded.toByteArray()), contentType.getContentType(), decoded);\n\n        assertPayload(decoded);\n    }\n\n    private static void roundTripSoapEnvelope(SOAPVersion soapVersion) throws Exception {\n        StreamSOAPCodec xmlCodec = Codecs.createSOAPEnvelopeXmlCodec(soapVersion);\n        FastInfosetStreamSOAPCodec codec = FastInfosetStreamSOAPCodec.create(xmlCodec, soapVersion);\n        Packet input = new Packet(createMessage(soapVersion));\n        ByteArrayOutputStream encoded = new ByteArrayOutputStream();\n\n        ContentType contentType = codec.encode(input, encoded);\n\n        require(codec.getMimeType().equals(contentType.getContentType()), \"Unexpected MIME type\");\n        require(encoded.size() > 0, \"Fast Infoset output is empty\");\n        require(encoded.toByteArray()[0] == (byte) 0xe0, \"Missing Fast Infoset header\");\n\n        Packet decoded = new Packet();\n        codec.decode(\n                new ByteArrayInputStream(encoded.toByteArray()), contentType.getContentType(), decoded);\n\n        assertPayload(decoded);\n    }\n\n    private static Message createMessage(SOAPVersion soapVersion) throws Exception {\n        Document document = DocumentBuilderFactory.newInstance().newDocumentBuilder().newDocument();\n        Element greeting = document.createElementNS(\"urn:example:fastinfoset\", \"greeting\");\n        Element text = document.createElementNS(\"urn:example:fastinfoset\", \"text\");\n        text.setTextContent(\"Hello from Fast Infoset\");\n        greeting.appendChild(text);\n        return Messages.createUsingPayload(greeting, soapVersion);\n    }\n\n    private static void assertPayload(Packet packet) {\n        Message message = packet.getMessage();\n        require(message != null, \"Decoded message is missing\");\n        require(\"urn:example:fastinfoset\".equals(message.getPayloadNamespaceURI()),\n                \"Unexpected payload namespace\");\n        require(\"greeting\".equals(message.getPayloadLocalPart()), \"Unexpected payload element\");\n    }\n\n    private static void require(boolean condition, String message) {\n        if (!condition) {\n            throw new AssertionError(message);\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1790952941505}, {"role": "toolResult", "toolCallId": "call_XXo4v7iQyr3jHG0Pa1Nh3eHp|fc_03a26fd741940b80016abfc5ec6a8087d188690ef51e55e18a", "toolName": "bash", "content": [{"type": "text", "text": " M tests/src/com.sun.xml.ws/rt-fi/4.0.5/src/test/java/com_sun_xml_ws/rt_fi/Rt_fiTest.java\n?? metadata/com.sun.xml.ws/rt-fi/4.0.5/\n"}], "isError": false, "timestamp": 1790952941505}]}
