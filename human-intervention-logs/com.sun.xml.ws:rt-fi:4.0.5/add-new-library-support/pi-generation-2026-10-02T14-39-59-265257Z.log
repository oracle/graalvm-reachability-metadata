   System.out.println(\"This is just a placeholder, implement your test\");\n    }\n}\n", "newText": "package com_sun_xml_ws.rt_fi;\n\nimport com.sun.xml.ws.api.SOAPVersion;\nimport com.sun.xml.ws.api.message.Message;\nimport com.sun.xml.ws.api.message.Messages;\nimport com.sun.xml.ws.api.message.Packet;\nimport com.sun.xml.ws.api.pipe.Codecs;\nimport com.sun.xml.ws.api.pipe.ContentType;\nimport com.sun.xml.ws.api.pipe.StreamSOAPCodec;\nimport com.sun.xml.ws.encoding.fastinfoset.FastInfosetCodec;\nimport com.sun.xml.ws.encoding.fastinfoset.FastInfosetStreamSOAPCodec;\nimport java.io.ByteArrayInputStream;\nimport java.io.ByteArrayOutputStream;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.Timeout;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\n@Timeout(60)\npublic class Rt_fiTest {\n    private static final String PAYLOAD = \"<greeting xmlns=\\\"urn:example:fastinfoset\\\">\"\n            + \"<text>Hello from Fast Infoset</text></greeting>\";\n\n    @Test\n    void roundTripsPayloadWithStatelessFastInfosetCodec() throws Exception {\n        roundTrip(FastInfosetCodec.create(), SOAPVersion.SOAP_11);\n    }\n\n    @Test\n    void roundTripsPayloadWithStatefulFastInfosetCodec() throws Exception {\n        roundTrip(FastInfosetCodec.create(true), SOAPVersion.SOAP_11);\n    }\n\n    @Test\n    void roundTripsSoap11EnvelopeWithFastInfosetCodec() throws Exception {\n        roundTripSoapEnvelope(SOAPVersion.SOAP_11);\n    }\n\n    @Test\n    void roundTripsSoap12EnvelopeWithFastInfosetCodec() throws Exception {\n        roundTripSoapEnvelope(SOAPVersion.SOAP_12);\n    }\n\n    private static void roundTrip(FastInfosetCodec codec, SOAPVersion soapVersion) throws Exception {\n        Packet input = new Packet(createMessage(soapVersion));\n        ByteArrayOutputStream encoded = new ByteArrayOutputStream();\n\n        ContentType contentType = codec.encode(input, encoded);\n\n        assertThat(contentType.getContentType()).isEqualTo(codec.getMimeType());\n        assertThat(encoded.toByteArray()[0]).isEqualTo((byte) 0xe0);\n\n        Packet decoded = new Packet();\n        codec.decode(\n                new ByteArrayInputStream(encoded.toByteArray()), contentType.getContentType(), decoded);\n\n        assertPayload(decoded);\n    }\n\n    private static void roundTripSoapEnvelope(SOAPVersion soapVersion) throws Exception {\n        StreamSOAPCodec xmlCodec = Codecs.createSOAPEnvelopeXmlCodec(soapVersion);\n        FastInfosetStreamSOAPCodec codec = FastInfosetStreamSOAPCodec.create(xmlCodec, soapVersion);\n        Packet input = new Packet(createMessage(soapVersion));\n        ByteArrayOutputStream encoded = new ByteArrayOutputStream();\n\n        ContentType contentType = codec.encode(input, encoded);\n\n        assertThat(contentType.getContentType()).isEqualTo(codec.getMimeType());\n        assertThat(encoded.toByteArray()[0]).isEqualTo((byte) 0xe0);\n\n        Packet decoded = new Packet();\n        codec.decode(\n                new ByteArrayInputStream(encoded.toByteArray()), contentType.getContentType(), decoded);\n\n        assertPayload(decoded);\n    }\n\n    private static Message createMessage(SOAPVersion soapVersion) {\n        return Messages.create(soapVersion, PAYLOAD);\n    }\n\n    private static void assertPayload(Packet packet) {\n        assertThat(packet.getMessage()).isNotNull();\n        assertThat(packet.getMessage().getPayloadNamespaceURI()).isEqualTo(\"urn:example:fastinfoset\");\n        assertThat(packet.getMessage().getPayloadLocalPart()).isEqualTo(\"greeting\");\n    }\n}\n"}]}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-luna", "usage": {"input": 820, "output": 2979, "cacheRead": 103936, "cacheWrite": 0, "reasoning": 2004, "totalTokens": 107735, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1790952281229, "responseId": "resp_03a26fd741940b80016abfc359f89487d197