OAPEnvelopeXmlCodec(SOAPVersion.SOAP_12);\n        FastInfosetStreamSOAPCodec soap11Codec =\n                FastInfosetStreamSOAPCodec.create(soap11XmlCodec, SOAPVersion.SOAP_11);\n        FastInfosetStreamSOAPCodec soap12Codec =\n                FastInfosetStreamSOAPCodec.create(soap12XmlCodec, SOAPVersion.SOAP_12);\n        FastInfosetStreamSOAPCodec statefulSoap12Codec =\n                FastInfosetStreamSOAPCodec.create(soap12XmlCodec, SOAPVersion.SOAP_12, true);\n\n        assertCondition(\n                FastInfosetMIMETypes.SOAP_11.equals(soap11Codec.getMimeType()),\n                \"SOAP 1.1 Fast Infoset MIME type was not returned\");\n        assertCondition(\n                FastInfosetMIMETypes.SOAP_12.equals(soap12Codec.getMimeType()),\n                \"SOAP 1.2 Fast Infoset MIME type was not returned\");\n        assertCondition(\n                FastInfosetMIMETypes.STATEFUL_SOAP_12.equals(statefulSoap12Codec.getMimeType()),\n                \"Stateful SOAP 1.2 Fast Infoset MIME type was not returned\");\n\n        Codec copy = statefulSoap12Codec.copy();\n        assertCondition(copy != statefulSoap12Codec, \"Fast Infoset codec was not copied\");\n        assertCondition(\n                FastInfosetMIMETypes.STATEFUL_SOAP_12.equals(copy.getMimeType()),\n                \"Copied Fast Infoset codec changed its MIME type\");\n    }\n\n    private static void assertCondition(boolean condition, String message) {\n        if (!condition) {\n            throw new AssertionError(message);\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1790954315961}]}
