ecode(\n                new ByteArrayInputStream(encodedBytes.toByteArray()),\n                contentType.getContentType(),\n                decodedPacket);\n\n        Message decodedMessage = decodedPacket.getMessage();\n        assertEquals(\"greeting\", decodedMessage.getPayloadLocalPart());\n        assertEquals(\"urn:example\", decodedMessage.getPayloadNamespaceURI());\n\n        XMLStreamReader payload = decodedMessage.readPayload();\n        assertEquals(XMLStreamConstants.START_ELEMENT, payload.getEventType());\n        assertEquals(\"greeting\", payload.getLocalName());\n        assertEquals(XMLStreamConstants.START_ELEMENT, payload.nextTag());\n        assertEquals(\"text\", payload.getLocalName());\n        assertEquals(\"hello\", payload.getElementText());\n        assertEquals(XMLStreamConstants.END_ELEMENT, payload.nextTag());\n        assertEquals(\"greeting\", payload.getLocalName());\n    }\n}\n"}], "isError": false, "timestamp": 1790953218259}}
