ayOutputStream();\n\n        ContentType contentType = codec.encode(originalPacket, encoded);\n\n        assertTrue(FastInfosetMIMETypes.INFOSET.equals(contentType.getContentType()));\n        assertTrue(encoded.size() > 0);\n\n        Packet decodedPacket = new Packet();\n        codec.decode(\n                new ByteArrayInputStream(encoded.toByteArray()),\n                contentType.getContentType(),\n                decodedPacket);\n\n        Message decodedMessage = decodedPacket.getMessage();\n        assertTrue(decodedMessage.hasPayload());\n        assertTrue(\"greeting\".equals(decodedMessage.getPayloadLocalPart()));\n        assertTrue(\n                \"urn:example:fastinfoset\".equals(decodedMessage.getPayloadNamespaceURI()));\n        assertTrue(\"Hello Fast Infoset\".equals(readText(decodedMessage)));\n    }\n\n    private static String readText(Message message) throws XMLStreamException {\n        XMLStreamReader reader = message.readPayload();\n        StringBuilder text = new StringBuilder();\n        try {\n            while (reader.hasNext()) {\n                if (reader.next() == XMLStreamConstants.CHARACTERS) {\n                    text.append(reader.getText().trim());\n                }\n            }\n            return text.toString();\n        } finally {\n            reader.close();\n        }\n    }\n\n", "newText": "    @Test\n    void reportsStaticContentTypeForEachEncodingMode() {\n        FastInfosetCodec statelessCodec = FastInfosetCodec.create();\n        FastInfosetCodec statefulCodec = FastInfosetCodec.create(true);\n\n        assertEquals(\n                FastInfosetMIMETypes.INFOSET,\n                statelessCodec.getStaticContentType(null).getContentType());\n        assertEquals(\n                FastInfosetMIMETypes.STATEFUL_INFOSET,\n                statefulCodec.getStaticContentType(null).getContentType());\n    }\n\n"}]}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-luna", "usage": 