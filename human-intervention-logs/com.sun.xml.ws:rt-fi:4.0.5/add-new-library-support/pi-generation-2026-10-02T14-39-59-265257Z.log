espaceURI());\n        assertEquals(\"Hello Fast Infoset\", readText(decodedMessage));\n    }\n\n    private static String readText(Message message) throws Exception {\n        XMLStreamReader reader = message.readPayload();\n        StringBuilder text = new StringBuilder();\n        while (reader.hasNext()) {\n            if (reader.next() == XMLStreamConstants.CHARACTERS) {\n                text.append(reader.getText().trim());\n            }\n        }\n        return text.toString();\n    }\n}\n"}], "isError": false, "timestamp": 1790954628839}, {"role": "toolResult", "toolCallId": "call_XGJDHgQlNVKhxMTquAiNLfJ7|fc_024b5c7321bcd142016abfcc83d3d087d181ef4ea53dddc775", "toolName": "bash", "content": [{"type": "text", "text": "tests/src/com.sun.xml.ws/rt-fi/4.0.5/src/test/java/com_sun_xml_ws/rt_fi/FastInfosetCodecRoundTripTest.java:14:import com.sun.xml.ws.encoding.fastinfoset.FastInfosetCodec;\ntests/src/com.sun.xml.ws/rt-fi/4.0.5/src/test/java/com_sun_xml_ws/rt_fi/FastInfosetCodecRoundTripTest.java:28:public class FastInfosetCodecRoundTripTest {\ntests/src/com.sun.xml.ws/rt-fi/4.0.5/src/test/java/com_sun_xml_ws/rt_fi/FastInfosetCodecRoundTripTest.java:31:        Message originalMessage = Messages.createUsingPayload(\ntests/src/com.sun.xml.ws/rt-fi/4.0.5/src/test/java/com_sun_xml_ws/rt_fi/FastInfosetCodecRoundTripTest.java:39:        FastInfosetCodec codec = FastInfosetCodec.create();\ntests/src/com.sun.xml.ws/rt-fi/4.0.5/src/test/java/com_sun_xml_ws/rt_fi/FastInfosetCodecRoundTripTest.java:42:        ContentType contentType = codec.encode(originalPacket, encoded);\ntests/src/com.sun.xml.ws/rt-fi/4.0.5/src/test/java/com_sun_xml_ws/rt_fi/FastInfosetCodecRoundTripTest.java:48:        codec.decode(\ntests/src/com.sun.xml.ws/rt-fi/4.0.5/src/test/java/com_sun_xml_ws/rt_fi/FastInfosetCodecRoundTripTest.java:62:        XMLStreamReader reader = message.readPayload();\ntests/src/com.sun.xml.ws/rt-fi/4.0.5/src/test/java/com_sun_xml_ws/rt_fi/FastInfosetCodecCopyTest.java:10: