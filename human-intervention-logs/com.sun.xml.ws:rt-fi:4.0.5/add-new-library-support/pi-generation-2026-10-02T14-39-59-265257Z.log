[tool-call] delta {"path":"tests/src/com.sun.xml.ws/rt-fi/4.0.5/src/test/java/com_sun_xml_ws/rt_fi/Rt_fiTest.java","edits":[{"oldText":"import com.sun.xml.ws.api.SOAPVersion;\nimport com.sun.xml.ws.api.message.Message;\nimport com.sun.xml.ws.api.message.Messages;\nimport com.sun.xml.ws.api.message.Packet;\nimport com.sun.xml.ws.api.pipe.ContentType;\nimport com.sun.xml.ws.encoding.fastinfoset.FastInfosetCodec;\nimport com.sun.xml.ws.encoding.fastinfoset.FastInfosetMIMETypes;\nimport org.junit.jupiter.api.Test;\nimport org.w3c.dom.Document;\nimport org.w3c.dom.Element;\n\nimport javax.xml.parsers.DocumentBuilderFactory;\nimport java.io.ByteArrayOutputStream;\nimport java.util.Arrays;\n","newText":"import com.sun.xml.ws.api.pipe.ContentType;\nimport com.sun.xml.ws.encoding.fastinfoset.FastInfosetCodec;\nimport com.sun.xml.ws.encoding.fastinfoset.FastInfosetMIMETypes;\nimport org.junit.jupiter.api.Test;\n"},{"oldText":"    void encodesFastInfosetPayload() throws Exception {\n        Document document = DocumentBuilderFactory.newDefaultInstance()\n                .newDocumentBuilder()\n                .newDocument();\n        Element greeting = document.createElementNS(\"urn:example\", \"greeting\");\n        Element text = document.createElementNS(\"urn:example\", \"text\");\n        text.setTextContent(\"hello\");\n        greeting.appendChild(text);\n        Message message = Messages.createUsingPayload(greeting, SOAPVersion.SOAP_11);\n        FastInfosetCodec codec = FastInfosetCodec.create();\n        ByteArrayOutputStream encodedBytes = new ByteArrayOutputStream();\n\n        ContentType contentType = codec.encode(new Packet(message), encodedBytes);\n\n        assertCondition(\n                FastInfosetMIMETypes.INFOSET.equals(contentType.getContentType()),\n                \"Fast Infoset MIME type was not returned\");\n\n        byte[] encodedPayload = encodedBytes.toByteArray();\n        byte[] fastInfosetHeader = {(byte) 0xE0, 0x00, 0x00, 0x01, 0x00};\n        assertCondition(\n                Arrays.equals(fastInfosetHeader, Arrays.copyOf(encodedPayload, 5)),\n                \"Fast Infoset document header was not written\");\n        assertCondition(\n                encodedPayload.length > fastInfosetHeader.length,\n                \"Fast Infoset payload was empty\");\n    }\n","newText":"    void exposesFastInfosetContentTypes() {\n        ContentType statelessContentType = FastInfosetCodec.create().getStaticContentType(null);\n        ContentType statefulContentType = FastInfosetCodec.create(true).getStaticContentType(null);\n\n        assertCondition(\n                FastInfosetMIMETypes.INFOSET.equals(statelessContentType.getContentType()),\n                \"Stateless Fast Infoset MIME type was not returned\");\n        assertCondition(\n                FastInfosetMIMETypes.STATEFUL_INFOSET.equals(statefulContentType.getContentType()),\n                \"Stateful Fast Infoset MIME type was not returned\");\n    }\n"}]}
