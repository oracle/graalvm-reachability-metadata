setCodec;\nimport com.sun.xml.ws.encoding.fastinfoset.FastInfosetMIMETypes;\nimport org.junit.jupiter.api.Test;\n\nimport static org.junit.jupiter.api.Assertions.assertEquals;\nimport static org.junit.jupiter.api.Assertions.assertInstanceOf;\nimport static org.junit.jupiter.api.Assertions.assertNotSame;\n\npublic class FastInfosetCodecCopyTest {\n    @Test\n    void copiesStatelessCodecWithItsEncodingMode() {\n        assertCopyPreservesMimeType(FastInfosetCodec.create(), FastInfosetMIMETypes.INFOSET);\n    }\n\n    @Test\n    void copiesStatefulCodecWithItsEncodingMode() {\n        assertCopyPreservesMimeType(\n                FastInfosetCodec.create(true), FastInfosetMIMETypes.STATEFUL_INFOSET);\n    }\n\n    private static void assertCopyPreservesMimeType(\n            FastInfosetCodec original, String expectedMimeType) {\n        Codec copy = original.copy();\n\n        assertInstanceOf(FastInfosetCodec.class, copy);\n        assertNotSame(original, copy);\n        assertEquals(expectedMimeType, original.getMimeType());\n        assertEquals(expectedMimeType, copy.getMimeType());\n    }\n}\n"}], "isError": false, "timestamp": 1790954487267}, {"role": "toolResult", "toolCallId": "call_Gkxs0Nb50J3P5OFfP8FAnbwi|fc_024b5c7321bcd142016abfcbf5995887d19b0d0a1ef5ea329a", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage com_sun_xml_ws.rt_fi;\n\nimport com.sun.xml.ws.api.SOAPVersion;\nimport com.sun.xml.ws.api.pipe.Codec;\nimport com.sun.xml.ws.api.pipe.Codecs;\nimport com.sun.xml.ws.api.pipe.StreamSOAPCodec;\nimport com.sun.xml.ws.encoding.fastinfoset.FastInfosetMIMETypes;\nimport com.sun.xml.ws.encoding.fastinfoset.FastInfosetStreamSOAPCodec;\nimport org.junit.jupiter.api.Test;\n\nimport static org.junit.jupiter.api.Assertions.assertEquals;\nimport static org.junit.jupiter.api.Assertions.assertNotSame;\n\npublic class FastInfosetStreamSOAPCodecTest {\n    @Test\n    void createsFastInfosetStreamingSoapCodecs() {\n        StreamSOAPCodec soap11XmlCodec = Codecs.createSOAPEnvelopeXmlCodec(SOAPVersion.SOAP_11);\n        StreamSOAPCodec soap12XmlCodec = Codecs.createSOAPEnvelopeXmlCodec(SOAPVersion.SOAP_12);\n        FastInfosetStreamSOAPCodec soap11Codec =\n                FastInfosetStreamSOAPCodec.create(soap11XmlCodec, SOAPVersion.SOAP_11);\n        FastInfosetStreamSOAPCodec soap12Codec =\n                FastInfosetStreamSOAPCodec.create(soap12XmlCodec, SOAPVersion.SOAP_12);\n        FastInfosetStreamSOAPCodec statefulSoap12Codec =\n                FastInfosetStreamSOAPCodec.create(soap12XmlCodec, SOAPVersion.SOAP_12, true);\n\n        assertEquals(FastInfosetMIMETypes.SOAP_11, soap11Codec.getMimeType());\n        assertEquals(FastInfosetMIMETypes.SOAP_12, soap12Codec.getMimeType());\n        assertEquals(FastInfosetMIMETypes.STATEFUL_SOAP_12, statefulSoap12Codec.getMimeType());\n\n        Codec copy = statefulSoap12Codec.copy();\n        assertNotSame(statefulSoap12Codec, copy);\n        assertEquals(FastInfosetMIMETypes.STATEFUL_SOAP_12, copy.getMimeType());\n    }\n}\n"}], "isError": false, "timestamp": 1790954487267}, {"role": "toolResult", "toolCallId": "call_vORZeArvj0qgHt0j2PHYq5nQ|fc_024b5c7321bcd142016abfcbf5996087d195e638f64d3a155b", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\nplugins {\n    id \"org.graalvm.internal.tck\"\n}\n\nString libraryVersion = tck.testedLibraryVersion.get()\n\ndependencies {\n    testImplementation \"com.sun.xml.ws:rt-fi:$libraryVersion\"\n    testImplementation 'org.assertj:assertj-core:3.22.0'\n    testImplementation \"com.sun.xml.ws:rt:4.0.5\"\n}\n\ngraalvmNative {\n    agent {\n        defaultMode = \"conditional\"\n        modes {\n            conditional {\n                userCodeFilterPath = \"user-code-filter.json\"\n            }\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1790954487267}, {"role": "toolResult", "toolCallId": "call_sitiamafn6Gth0mD2DbXzVkC|fc_024b5c7321bcd142016abfcbf5996c87d1b2a74e2e2a4d1477", "toolName": "read", "content": [{"type": "text", "text": "{}\n"}], "isError": false, "timestamp": 1790954487267}, {"role": "toolResult", "toolCallId": "call_azV8OCoOo3NJjvCNC6r5H84R|fc_024b5c7321bcd142016abfcbf5997887d19b46ac5048cc54fb", "toolName": "read", "content": [{"type": "text", "text": "[\n  {\n    \"latest\" : true,\n    \"metadata-version\" : \"4.0.5\",\n    \"tested-versions\" : [\n      \"4.0.5\"\n    ],\n    \"allowed-packages\" : [\n      \"com.sun.xml.ws.encoding.fastinfoset\"\n    ]\n  }\n]\n"}], "isError": false, "timestamp": 1790954487267}]}
