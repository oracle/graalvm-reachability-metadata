  package com_sun_xml_ws.rt_fi;
  
  import com.sun.xml.ws.api.SOAPVersion;
  import com.sun.xml.ws.api.message.Message;
  import com.sun.xml.ws.api.message.Messages;
  import com.sun.xml.ws.api.message.Packet;
  import com.sun.xml.ws.api.pipe.ContentType;
  import com.sun.xml.ws.encoding.fastinfoset.FastInfosetCodec;
  import com.sun.xml.ws.encoding.fastinfoset.FastInfosetMIMETypes;
  import org.junit.jupiter.api.Test;
  
  import javax.xml.parsers.DocumentBuilderFactory;
  import javax.xml.stream.XMLStreamConstants;
  import javax.xml.stream.XMLStreamReader;
  import org.w3c.dom.Document;
  import org.w3c.dom.Element;
  import java.io.ByteArrayInputStream;
  import java.io.ByteArrayOutputStream;
  
  import static org.junit.jupiter.api.Assertions.assertEquals;
  import static org.junit.jupiter.api.Assertions.assertFalse;
  
  public class Rt_fiTest {
      @Test
      void encodesAndDecodesFastInfosetPayload() throws Exception {
          Document document = DocumentBuilderFactory.newDefaultInstance()
                  .newDocumentBuilder()
                  .newDocument();
          Element greeting = document.createElementNS("urn:example", "greeting");
          Element text = document.createElementNS("urn:example", "text");
          text.setTextContent("hello");
          greeting.appendChild(text);
          Message message = Messages.createUsingPayload(greeting, SOAPVersion.SOAP_11);
          FastInfosetCodec codec = FastInfosetCodec.create();
          ByteArrayOutputStream encodedBytes = new ByteArrayOutputStream();
  
          ContentType contentType = codec.encode(new Packet(message), encodedBytes);
  
          assertEquals(FastInfosetMIMETypes.INFOSET, contentType.getContentType());
          assertFalse(encodedBytes.toByteArray().length == 0);
  
          Packet decodedPacket = new Packet();
          codec.decode(
                  new ByteArrayInputStream(encodedBytes.toByteArray()),
                  contentType.getContentType(),
                  decodedPacket);
  
          Message decodedMessage = decodedPacket.getMessage();
          assertEquals("greeting", decodedMessage.getPayloadLocalPart());
          assertEquals("urn:example", decodedMessage.getPayloadNamespaceURI());
  
          XMLStreamReader payload = decodedMessage.readPayload();
          assertEquals(XMLStreamConstants.START_ELEMENT, payload.getEventType());
          assertEquals("greeting", payload.getLocalName());
          assertEquals(XMLStreamConstants.START_ELEMENT, payload.nextTag());
          assertEquals("text", payload.getLocalName());
          assertEquals("hello", payload.getElementText());
          assertEquals(XMLStreamConstants.END_ELEMENT, payload.nextTag());
          assertEquals("greeting", payload.getLocalName());
      }
  }
