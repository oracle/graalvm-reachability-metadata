TEFUL_SOAP_12.equals(statefulSoap12Codec.getMimeType()),\n                \"Stateful SOAP 1.2 Fast Infoset MIME type was not returned\");\n\n        Codec copy = statefulSoap12Codec.copy();\n        assertCondition(copy != statefulSoap12Codec, \"Fast Infoset codec was not copied\");\n        assertCondition(\n                FastInfosetMIMETypes.STATEFUL_SOAP_12.equals(copy.getMimeType()),\n                \"Copied Fast Infoset codec changed its MIME type\");\n    }\n\n    private static void assertCondition(boolean condition, String message) {\n        if (!condition) {\n            throw new AssertionError(message);\n        }\n    }\n}\n"}
