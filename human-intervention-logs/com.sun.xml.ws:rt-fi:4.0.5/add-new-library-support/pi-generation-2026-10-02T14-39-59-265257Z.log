/reachability-metadata.json\n"}], "isError": false, "timestamp": 1790954747306}, {"role": "toolResult", "toolCallId": "call_8s0OJiOrAh8SaD7ieow323Yp|fc_024b5c7321bcd142016abfccfa352487d1a37d68cbe4742a89", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage com_sun_xml_ws.rt_fi;\n\nimport com.sun.xml.ws.api.SOAPVersion;\nimport com.sun.xml.ws.api.message.Message;\nimport com.sun.xml.ws.api.message.Messages;\nimport com.sun.xml.ws.api.message.Packet;\nimport com.sun.xml.ws.api.pipe.Codec;\nimport com.sun.xml.ws.api.pipe.ContentType;\nimport com.sun.xml.ws.encoding.fastinfoset.FastInfosetCodec;\nimport com.sun.xml.ws.encoding.fastinfoset.FastInfosetMIMETypes;\nimport java.io.ByteArrayInputStream;\nimport java.io.ByteArrayOutputStream;\nimport java.io.IOException;\nimport java.io.StringReader;\nimport javax.xml.stream.XMLStreamConstants;\nimport javax.xml.stream.XMLStreamException;\nimport javax.xml.stream.XMLStreamReader;\nimport javax.xml.transform.stream.StreamSource;\nimport org.junit.jupiter.api.Test;\n\nimport static org.junit.jupiter.api.Assertions.assertEquals;\nimport static org.junit.jupiter.api.Assertions.assertInstanceOf;\nimport static org.junit.jupiter.api.Assertions.assertNotSame;\nimport static org.junit.jupiter.api.Assertions.assertTrue;\n\npublic class FastInfosetCodecCopyTest {\n    @Test\n    void copiesStatelessCodecWithItsEncodingMode() {\n        assertCopyPreservesMimeType(FastInfosetCodec.create(), FastInfosetMIMETypes.INFOSET);\n    }\n\n    @Test\n    void copiesStatefulCodecWithItsEncodingMode() {\n        assertCopyPreservesMimeType(\n                FastInfosetCodec.create(true), FastInfosetMIMETypes.STATEFUL_INFOSET);\n    }\n\n    @Test\n    void encodesAndDecodesXmlPayload() throws IOException, XMLStreamException {\n        Message originalMessage = Messages.createUsingPayload(\n                new StreamSource(new StringReader(\"\"\"\n                        <greeting xmlns=\"urn:example:fastinfoset\">\n                            <text>Hello Fast Infoset</text>\n                        </greeting>\n                        \"\"\")),\n                SOAPVersion.SOAP_11);\n        Packet originalPacket = new Packet(originalMessage);\n        FastInfosetCodec codec = FastInfosetCodec.create();\n        ByteArrayOutputStream encoded = new ByteArrayOutputStream();\n\n        ContentType contentType = codec.encode(originalPacket, encoded);\n\n        assertEquals(FastInfosetMIMETypes.INFOSET, contentType.getContentType());\n        assertTrue(encoded.size() > 0);\n\n        Packet decodedPacket = new Packet();\n        codec.decode(\n                new ByteArrayInputStream(encoded.toByteArray()),\n                contentType.getContentType(),\n                decodedPacket);\n\n        Message decodedMessage = decodedPacket.getMessage();\n        assertTrue(decodedMessage.hasPayload());\n        assertEquals(\"greeting\", decodedMessage.getPayloadLocalPart());\n        assertEquals(\n                \"urn:example:fastinfoset\", decodedMessage.getPayloadNamespaceURI());\n        assertEquals(\"Hello Fast Infoset\", readText(decodedMessage));\n    }\n\n    private static String readText(Message message) throws XMLStreamException {\n        XMLStreamReader reader = message.readPayload();\n        StringBuilder text = new StringBuilder();\n        try {\n            while (reader.hasNext()) {\n                if (reader.next() == XMLStreamConstants.CHARACTERS) {\n                    text.append(reader.getText().trim());\n                }\n            }\n            return text.toString();\n        } finally {\n            reader.close();\n        }\n    }\n\n    private static void assertCopyPreservesMimeType(\n            FastInfosetCodec original, String expectedMimeType) {\n        Codec copy = original.copy();\n\n        assertInstanceOf(FastInfosetCodec.class, copy);\n        assertNotSame(original, copy);\n        assertEquals(expectedMimeType, original.getMimeType());\n        assertEquals(expectedMimeType, copy.getMimeType());\n    }\n}\n"}], "isError": false, "timestamp": 1790954747307}, {"role": "toolResult", "toolCallId": "call_pGDNm5YZv9Ty4l4uoGFeT1BB|fc_024b5c7321bcd142016abfccfa352c87d1a5af63c4d0b6354d", "toolName": "bash", "content": [{"type": "text", "text": "(no output)"}], "isError": false, "timestamp": 1790954747307}]}
