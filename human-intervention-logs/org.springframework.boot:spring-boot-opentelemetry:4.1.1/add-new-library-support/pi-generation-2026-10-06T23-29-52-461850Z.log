ctory$OtlpLoggingContainerConnectionDetails.class\n./tests/src/org.springframework.boot/spring-boot-opentelemetry/4.1.1/build/jacoco/effective/spring_boot_opentelemetry_4_1_1_jar/org/springframework/boot/opentelemetry/testcontainers/OtelCollectorOltpLoggingContainerConnectionDetailsFactory$1.class\n./tests/src/org.springframework.boot/spring-boot-opentelemetry/4.1.1/build/jacoco/test.exec\n./tests/src/org.springframework.boot/spring-boot-opentelemetry/4.1.1/build/libs/org.springframework.boot.spring-boot-opentelemetry_tests.jar\n./tests/src/org.springframework.boot/spring-boot-opentelemetry/4.1.1/build/native/nativeTestCompile/libmanagement_ext.so\n./tests/src/org.springframework.boot/spring-boot-opentelemetry/4.1.1/build/native/nativeTestCompile/org.springframework.boot.spring-boot-opentelemetry_tests-tests\n./tests/src/org.springframework.boot/spring-boot-opentelemetry/4.1.1/build/native/generated/generateTestResourcesConfigFile/resource-config.json\n./tests/src/org.springframework.boot/spring-boot-opentelemetry/4.1.1/build/test-results/test/testlist/junit-platform-unique-ids-7690051323446957287.txt\n./tests/src/org.springframework.boot/spring-boot-opentelemetry/4.1.1/build/test-results/test/binary/output.bin.idx\n./tests/src/org.springframework.boot/spring-boot-opentelemetry/4.1.1/build/test-results/test/binary/output.bin\n./tests/src/org.springframework.boot/spring-boot-opentelemetry/4.1.1/build/test-results/test/binary/results.bin\n./tests/src/org.springframework.boot/spring-boot-opentelemetry/4.1.1/build/test-results/test/TEST-org_springframework_boot.spring_boot_opentelemetry.Spring_boot_opentelemetryTest.xml\n./tests/src/org.springframework.boot/spring-boot-opentelemetry/4.1.1/build/tmp/.cache/expanded/zip_9892ccb804f78c0637616b68610d363f/META-INF/MANIFEST.MF\n./tests/src/org.springframework.boot/spring-boot-opentelemetry/4.1.1/build/tmp/.cache/expanded/zip_9892ccb804f78c0637616b68610d363f/META-INF/maven/org.jacoco/org.jacoco.agent/pom.xml\n./tests/src/org.s