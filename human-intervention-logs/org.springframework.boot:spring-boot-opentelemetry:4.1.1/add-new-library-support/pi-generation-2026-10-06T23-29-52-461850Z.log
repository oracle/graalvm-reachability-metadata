  		OnDisabledOpenTelemetryCondition() {
  			super(ConfigurationPhase.PARSE_CONFIGURATION);
  		}
  
  		@ConditionalOnEnabledOpenTelemetry
  		static class EnabledCondition {
  
  		}
  
  	}
  
