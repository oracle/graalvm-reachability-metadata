  +        Map<String, Object> properties = Map.of(
  +                "micronaut.server.port", -1,
  +                "endpoints.health.details-visible", "ANONYMOUS",
  +                "endpoints.health.disk-space.enabled", false,
  +                "endpoints.health.deadlocked-threads.enabled", false,
