  package org_apache_pulsar.pulsar_client_api;
  
  import static org.assertj.core.api.Assertions.assertThat;
  
  import org.apache.pulsar.client.api.PulsarClient;
  import org.junit.jupiter.api.Test;
  
  public class DefaultImplementationTest {
      @Test
      void createsAndClosesClientThroughPublicBuilder() throws Exception {
          final PulsarClient client = PulsarClient.builder().serviceUrl("pulsar://localhost:6650").build();
  
          try {
              assertThat(client.isClosed()).isFalse();
          } finally {
              client.close();
          }
          assertThat(client.isClosed()).isTrue();
      }
  }
