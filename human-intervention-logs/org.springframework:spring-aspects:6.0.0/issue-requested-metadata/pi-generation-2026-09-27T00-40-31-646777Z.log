  Closure<List<File>> resolveJUnitRuntimeJars = {
      Set<File> matched = new LinkedHashSet<>(
              configurations.nativeImageTestClasspath.resolvedConfiguration.resolvedArtifacts.findAll { artifact ->
                  BaseLayerUtils.isJUnitRuntimeArtifact(
                          artifact.moduleVersion.id.group,
                          artifact.moduleVersion.id.name)
              }.collect { artifact ->
                  artifact.file
              })
      if (matched.isEmpty()) {
          throw new GradleException("No JUnit runtime artifacts found on the test runtime classpath.")
      }
      return matched.toList().sort { File file -> file.absolutePath }
  }
  
  Closure<List<File>> resolveDedicatedLayerJars = {
      Set<File> includedJars = new LinkedHashSet<>(resolveTestedLibraryJars())
      includedJars.addAll(resolveJUnitRuntimeJars())
      return includedJars.toList().sort { File file -> file.absolutePath }
  }
  
  File coordinateMetadataDirectory = file(metadataPath).absoluteFile
  String coordinateMetadataArgument = "-H:ConfigurationFileDirectories=${coordinateMetadataDirectory.absolutePath}"
  String junitPlatformFeatureArgument = "--features=org.graalvm.junit.platform.JUnitPlatformFeature"
  TaskProvider<BuildNativeImageTask> nativeTestCompileTask = tasks.named(
          "nativeTestCompile", BuildNativeImageTask)
  Provider<Directory> dedicatedLayerJUnitTestListDirectory = layout.buildDirectory.dir(
          "native/generated/dedicatedLayerJUnitTestList")
  Provider<Directory> dedicatedLayerConfigurationDirectory = layout.buildDirectory.dir(
          "native/generated/dedicatedLayerConfiguration")
  Provider<Directory> dedicatedLayerReachabilityMetadataDirectory = layout.buildDirectory.dir(
          "native/generated/dedicatedLayerReachabilityMetadata")
  
  if (dedicatedLayer) {
      tasks.named("processTestResources").configure { task ->
          task.exclude("META-INF/native-image/**/reachability-metadata.json")
      }
      tasks.named("generateTestResourcesConfigFile").configure { task ->
          task.dependsOn(tasks.named("processTestResources"))
      }
  }
  
  tasks.register("generateDedicatedLayerJUnitTestList") { task ->
      task.setDescription("Generates engine-root JUnit selectors for the dedicated layer")
      task.setGroup("build")
      task.outputs.dir(dedicatedLayerJUnitTestListDirectory)
      task.doLast {
          File outputDirectory = dedicatedLayerJUnitTestListDirectory.get().asFile
          delete(outputDirectory)
          if (!outputDirectory.mkdirs()) {
              throw new GradleException("Failed to create base-layer JUnit test-list directory: " +
                      outputDirectory.absolutePath)
          }
          File selectorsFile = new File(outputDirectory, "junit-platform-unique-ids-base")
          List<String> engineRootSelectors = [
                  "[engine:junit-jupiter]",
                  "[engine:junit-vintage]"
          ]
          selectorsFile.text = engineRootSelectors.join(System.lineSeparator()) + System.lineSeparator()
      }
  }
  
  Closure<List<File>> resolveTestReachabilityMetadataFiles = {
      return sourceSets.test.resources.srcDirs.collectMany { File resourceDirectory ->
          fileTree(resourceDirectory) {
              include("META-INF/native-image/**/reachability-metadata.json")
          }.files
      }.unique().sort { File file -> file.absolutePath }
  }
  
  Closure<Object> withoutReachabilityConditions
  withoutReachabilityConditions = { Object value ->
      if (value instanceof Map) {
          Map<String, Object> result = new LinkedHashMap<>()
          value.each { Object key, Object nestedValue ->
              if (key != "condition") {
                  result.put(key.toString(), withoutReachabilityConditions(nestedValue))
              }
          }
          return result
      }
      if (value instanceof List) {
          return value.collect { Object nestedValue -> withoutReachabilityConditions(nestedValue) }
      }
      return value
  }
  
  tasks.register("prepareDedicatedLayerReachabilityMetadata") { task ->
      task.setDescription("Prepares test-scoped reachability metadata for dedicated-layer builds")
      task.setGroup("build")
      task.inputs.files(providers.provider { resolveTestReachabilityMetadataFiles() })
              .withPropertyName("testReachabilityMetadata")
              .withPathSensitivity(PathSensitivity.RELATIVE)
      task.outputs.dir(dedicatedLayerReachabilityMetadataDirectory)
      task.doLast {
          File outputDirectory = dedicatedLayerReachabilityMetadataDirectory.get().asFile
          delete(outputDirectory)
          if (!outputDirectory.mkdirs()) {
              throw new GradleException("Failed to create dedicated-layer reachability metadata directory: " +
                      outputDirectory.absolutePath)
          }
          resolveTestReachabilityMetadataFiles().eachWithIndex { File metadataFile, int index ->
              File metadataDirectory = new File(outputDirectory, "entry-${index}")
              if (!metadataDirectory.mkdirs()) {
                  throw new GradleException("Failed to create dedicated-layer metadata entry: " +
                          metadataDirectory.absolutePath)
              }
              Object metadata = new JsonSlurper().parse(metadataFile)
              String json = JsonOutput.prettyPrint(JsonOutput.toJson(withoutReachabilityConditions(metadata)))
              new File(metadataDirectory, "reachability-metadata.json").text =
                      json + System.lineSeparator()
          }
      }
  }
  
  Closure<List<File>> resolveDedicatedLayerReachabilityMetadataDirectories = {
      File outputDirectory = dedicatedLayerReachabilityMetadataDirectory.get().asFile
      return resolveTestReachabilityMetadataFiles().indices.collect { int index ->
          new File(outputDirectory, "entry-${index}")
      }
  }
  
  Closure<List<File>> resolveNativeTestConfigurationDirectories = {
      Set<File> directories = new LinkedHashSet<>(nativeTestCompileTask.get()
              .options.get().configurationFileDirectories.files)
      directories.add(coordinateMetadataDirectory)
      directories.addAll(resolveDedicatedLayerReachabilityMetadataDirectories())
      return directories.findAll { File directory -> directory.isDirectory() }
              .toList()
              .sort { File directory -> directory.absolutePath }
  }
  
  tasks.register("prepareDedicatedLayerConfiguration") { task ->
      task.setDescription("Prepares Native Image configuration for the dedicated layer")
      task.setGroup("build")
      task.dependsOn(tasks.named("generateTestResourcesConfigFile"))
      task.dependsOn(tasks.named("prepareDedicatedLayerReachabilityMetadata"))
      task.inputs.dir(dedicatedLayerReachabilityMetadataDirectory)
              .withPropertyName("dedicatedLayerReachabilityMetadata")
              .withPathSensitivity(PathSensitivity.RELATIVE)
      task.outputs.dir(dedicatedLayerConfigurationDirectory)
      task.outputs.upToDateWhen { false }
      task.doLast {
          File outputDirectory = dedicatedLayerConfigurationDirectory.get().asFile
          delete(outputDirectory)
          if (!outputDirectory.mkdirs()) {
              throw new GradleException("Failed to create base-layer configuration directory: " +
                      outputDirectory.absolutePath)
          }
          resolveNativeTestConfigurationDirectories().eachWithIndex { File directory, int index ->
              copy {
                  from(directory)
                  into(new File(outputDirectory, "entry-${index}"))
              }
          }
      }
  }
  
  Closure<List<File>> resolveDedicatedLayerConfigurationDirectories = {
      File outputDirectory = dedicatedLayerConfigurationDirectory.get().asFile
      File[] directories = outputDirectory.listFiles({ File file -> file.isDirectory() } as FileFilter)
      return directories == null ? [] : directories.toList().sort { File file -> file.absolutePath }
  }
  
  Closure<List<String>> resolveDedicatedLayerNativeImageArgs = {
      List<String> arguments = new ArrayList<>(nativeImageArgs)
      arguments.add("-H:ConfigurationFileDirectories=" +
              resolveDedicatedLayerConfigurationDirectories()
                      .collect { File directory -> directory.absolutePath }
                      .join(","))
      arguments.add(junitPlatformFeatureArgument)
      arguments.add("-Djunit.platform.listeners.uid.tracking.output.dir=" +
              dedicatedLayerJUnitTestListDirectory.get().asFile.absolutePath)
      return arguments
  }
  
  Closure<List<File>> resolveDedicatedLayerClasspath = {
      Set<File> classpath = new LinkedHashSet<>(configurations.testRuntimeClasspath
              .resolvedConfiguration.resolvedArtifacts.collect { artifact -> artifact.file })
      classpath.addAll(configurations.nativeImageTestClasspath
              .resolvedConfiguration.resolvedArtifacts.collect { artifact -> artifact.file })
      return classpath
              .findAll { File file -> file.isFile() }
              .toList()
              .sort { File file -> file.absolutePath }
  }
  
  Closure<Void> validateBaseLayer = {
      if (!layeredNativeImage) {
          return
      }
      if (!baseLayerFile.isAbsolute()) {
          throw new GradleException("Property 'tck.baseLayerFile' must contain an absolute path. Got: ${baseLayerFilePath}")
      }
      if (!baseLayerFile.isFile()) {
          throw new GradleException("Native Image base layer does not exist: ${baseLayerFile.absolutePath}")
      }
      if (dedicatedLayer) {
          return
      }
      File manifestFile = new File(baseLayerFile.parentFile, "manifest.json")
      if (!manifestFile.isFile()) {
          throw new GradleException("Native Image base-layer manifest does not exist: ${manifestFile.absolutePath}")
      }
      def currentManifest = new JsonSlurper().parse(manifestFile)
      def expectedManifest = BaseLayerUtils.expectedManifest(
              baseLayerFile,
              providers.exec {
                  commandLine(nativeImageTool("native-image"), "--version")
              }.standardOutput.asText.get().trim(),
              selectedNativeImageMode,
              baseLayerNativeImageArgs
      )
      if (currentManifest != expectedManifest) {
          throw new GradleException("Native Image base-layer manifest does not match the current inputs: ${manifestFile.absolutePath}")
      }
  }
  
  tasks.register("listLibraryJars") { task ->
      task.setDescription("Lists resolved JARs for the tested library (one per line)")
      task.setGroup(JavaBasePlugin.VERIFICATION_GROUP)
      task.doLast {
          resolveTestedLibraryJars().each { File file ->
              println file.absolutePath
          }
      }
  }
  
  tasks.register("listRuntimeDependencyArtifacts") { task ->
      task.setDescription("Lists resolved tested-library dependency artifacts for metadata ownership routing")
      task.setGroup(JavaBasePlugin.VERIFICATION_GROUP)
      task.doLast {
          resolveTestedLibraryDependencyArtifacts().each { Map<String, String> artifact ->
              println "TCK_RUNTIME_DEPENDENCY=${JsonOutput.toJson(artifact)}"
          }
      }
  }
  
  Provider<Directory> dynamicAccessOutputDir = layout.buildDirectory.dir("native/nativeTestCompile/dynamic-access")
  
  tasks.register("generateDynamicAccessReport") { task ->
      task.setDescription("Builds native tests with dynamic-access tracking and reuses Gradle up-to-date checks when inputs and classpath are unchanged")
      task.setGroup(JavaBasePlugin.VERIFICATION_GROUP)
      task.dependsOn(tasks.named("nativeTestCompile"))
      // JARs resolve from the Gradle cache where filenames are content-addressed, so name-only is sufficient.
      task.inputs.files(providers.provider { resolveTestedLibraryJars() })
              .withPropertyName("trackedLibraryJars")
              .withPathSensitivity(PathSensitivity.NAME_ONLY)
      task.inputs.files(sourceSets.test.output)
              .withPropertyName("testOutputs")
              .withPathSensitivity(PathSensitivity.RELATIVE)
      // metadataPath is scoped to the active coordinate via GVM_TCK_MD / -Pmetadata.dir, not the repo-wide metadata root.
      task.inputs.files(fileTree(metadataPath) { include("**/*.json") })
              .withPropertyName("metadataFiles")
              .withPathSensitivity(PathSensitivity.RELATIVE)
      task.inputs.file(ciJsonFile)
              .withPropertyName("ciJsonFile")
              .withPathSensitivity(PathSensitivity.RELATIVE)
      task.inputs.property("nativeImageArgs", providers.provider { nativeImageArgs })
      task.outputs.dir(dynamicAccessOutputDir)
              .withPropertyName("dynamicAccessOutputDir")
  }
  
  Provider<List<String>> nativeTraceBuildArgs = providers.provider {
      List<String> buildArgs = []
      if (nativeTraceImageTaskRequested) {
          buildArgs.add("-H:+UnlockExperimentalVMOptions")
          buildArgs.add("-H:+MetadataTracingSupport")
          buildArgs.add("-H:-UnlockExperimentalVMOptions")
      }
      List<String> metadataConfigDirs = commaSeparatedGradleProperty("metadataConfigDirs")
      boolean metadataConfigDirsRequested = project.hasProperty("metadataConfigDirs") &&
              (nativeTraceImageTaskRequested || nativeTestTaskRequested)
      if (metadataConfigDirsRequested && !metadataConfigDirs.isEmpty()) {
          buildArgs.add("-H:ConfigurationFileDirectories=${metadataConfigDirs.join(",")}")
      }
      if (runNativeTraceImageTaskRequested) {
          // The verification gate runs runNativeTraceImage in its correction
          // loop and routes on the binary's exit code. Bake exact-metadata
          // reporting + Exit-on-missing into the trace binary so the gate can
          // observe ExitStatus.MISSING_METADATA (172) for a metadata gap and
          // distinguish it from other test failures, while still collecting
          // trace metadata in the same run.
          buildArgs.add("--exact-reachability-metadata")
          buildArgs.add("-H:MissingRegistrationReportingMode=Exit")
      }
      return buildArgs
  }
  
  Provider<List<String>> pgoBuildArgs = providers.provider {
      List<String> buildArgs = []
      if (nativeTestPGOSamplingTaskRequested) {
          if (!pgoSamplingPeriodMicros.matches("[1-9][0-9]*")) {
              throw new GradleException(
                      "'pgoSamplingPeriodMicros' must be a positive integer, got '${pgoSamplingPeriodMicros}'."
              )
          }
  
          // Sampled profiles are guidance-only evidence: sampled stacks show where
          // execution already runs; absence never proves non-execution (JaCoCo is
          // the coverage metric). PrintAnalysisCallTreeType=CSV dumps
          // reports/call_tree_{methods,invokes,targets}_*.csv as the static call graph.
          buildArgs.add("--pgo-sampling")
          buildArgs.add("-H:+UnlockExperimentalVMOptions")
          buildArgs.add("-H:PGOSamplingPeriodMicros=${pgoSamplingPeriodMicros}")
          buildArgs.add("-H:+PrintAnalysisCallTree")
          buildArgs.add("-H:PrintAnalysisCallTreeType=CSV")
          buildArgs.add("-H:-UnlockExperimentalVMOptions")
      }
      return buildArgs
  }
  
  tasks.named("nativeTestCompile", BuildNativeImageTask).configure { BuildNativeImageTask task ->
      if (dedicatedLayer) {
          task.dependsOn(tasks.named("nativeLibDedicatedCompile"))
      }
      task.doFirst {
          validateBaseLayer()
          File nativeImageOutputDirectory = task.outputFile.get().asFile.parentFile
          if (!nativeImageOutputDirectory.isDirectory() && !nativeImageOutputDirectory.mkdirs()) {
              throw new GradleException("Failed to create native-image output directory: ${nativeImageOutputDirectory.absolutePath}")
          }
          if (runNativeTraceImageTaskRequested) {
              requiredGradleProperty("traceMetadataPath")
          }
      }
  }
  
