t$ComponentSliceConfiguration.class.uniqueId2\ntests/src/org.springframework.boot/spring-boot-data-couchbase-test/4.1.1/build/tmp/compileTestJava/compileTransaction/stash-dir/Spring_boot_data_couchbase_testTest$ConfiguredDataCouchbaseSlice.class.uniqueId6\ntests/src/org.springframework.boot/spring-boot-data-couchbase-test/4.1.1/build/tmp/compileTestJava/compileTransaction/stash-dir/Spring_boot_data_couchbase_testTest$DataCouchbaseSliceConfiguration.class.uniqueId5\ntests/src/org.springframework.boot/spring-boot-data-couchbase-test/4.1.1/build/tmp/compileTestJava/compileTransaction/stash-dir/Spring_boot_data_couchbase_testTest$FilteredDataCouchbaseSlice.class.uniqueId4\ntests/src/org.springframework.boot/spring-boot-data-couchbase-test/4.1.1/build/tmp/compileTestJava/compileTransaction/stash-dir/Spring_boot_data_couchbase_testTest$IncludedComponent.class.uniqueId1\ntests/src/org.springframework.boot/spring-boot-data-couchbase-test/4.1.1/build/tmp/compileTestJava/compileTransaction/stash-dir/Spring_boot_data_couchbase_testTest$SliceConfiguration.class.uniqueId0\ntests/src/org.springframework.boot/spring-boot-data-couchbase-test/4.1.1/build/tmp/compileTestJava/compileTransaction/stash-dir/Spring_boot_data_couchbase_testTest.class.uniqueId3\ntests/src/org.springframework.boot/spring-boot-data-couchbase-test/4.1.1/build/tmp/compileTestJava/previous-compilation-data.bin\ntests/src/org.springframework.boot/spring-boot-data-couchbase-test/4.1.1/build/tmp/jar/MANIFEST.MF\ntests/src/org.springframework.boot/spring-boot-data-couchbase-test/4.1.1/.gitignore\ntests/src/org.springframework.boot/spring-boot-data-couchbase-test/4.1.1/.gradle/9.1.0/checksums/checksums.lock\ntests/src/org.springframework.boot/spring-boot-data-couchbase-test/4.1.1/.gradle/9.1.0/checksums/md5-checksums.bin\ntests/src/org.springframework.boot/spring-boot-data-couchbase-test/4.1.1/.gradle/9.1.0/checksums/sha1-checksums.bin\ntests/src/org.springframework.boot/spring-boot-data-couchbase-test/4.1.1/.gradle/