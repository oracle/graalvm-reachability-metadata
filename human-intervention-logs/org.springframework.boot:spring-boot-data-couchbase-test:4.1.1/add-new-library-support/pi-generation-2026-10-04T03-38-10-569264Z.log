[tool-call] delta {"path":"tests/src/org.springframework.boot/spring-boot-data-couchbase-test/4.1.1/src/test/java/org_springframework_boot/spring_boot_data_couchbase_test/Spring_boot_data_couchbase_testTest.java","edits":[{"oldText":"import org.junit.jupiter.api.Test;\n\nclass Spring_boot_data_couchbase_testTest {\n    @Test\n    void test() throws Exception {\n        System.out.println(\"This is just a placeholder, implement your test\");\n    }\n}\n","newText":"import org.junit.jupiter.api.Test;\n\nimport org.springframework.boot.data.couchbase.autoconfigure.DataCouchbaseProperties;\nimport org.springframework.boot.data.couchbase.test.autoconfigure.DataCouchbaseTest;\nimport org.springframework.boot.test.context.runner.ApplicationContextRunner;\nimport org.springframework.context.annotation.Configuration;\nimport org.springframework.core.annotation.MergedAnnotations;\nimport org.springframework.data.couchbase.core.convert.CouchbaseCustomConversions;\nimport org.springframework.data.couchbase.core.convert.MappingCouchbaseConverter;\nimport org.springframework.data.couchbase.core.convert.translation.TranslationService;\nimport org.springframework.data.couchbase.core.mapping.CouchbaseMappingContext;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\npublic class Spring_boot_data_couchbase_testTest {\n\n    private final ApplicationContextRunner contextRunner = new ApplicationContextRunner()\n            .withUserConfiguration(DataCouchbaseSliceConfiguration.class)\n            .withPropertyValues(\"spring.data.couchbase.bucket-name=orders\",\n                    \"spring.data.couchbase.scope-name=fulfillment\",\n                    \"spring.data.couchbase.type-key=documentType\");\n\n    @Test\n    void dataCouchbaseTestExposesSliceConfiguration() {\n        DataCouchbaseTest annotation = MergedAnnotations.from(DataCouchbaseSliceConfiguration.class)\n                .get(DataCouchbaseTest.class)\n                .synthesize();\n\n        assertThat(annotation.properties()).containsExactly(\"spring.data.couchbase.bucket-name=orders\",\n                \"spring.data.couchbase.scope-name=fulfillment\");\n        assertThat(annotation.useDefaultFilters()).isFalse();\n        assertThat(MergedAnnotations.from(DataCouchbaseSliceConfiguration.class)\n                .isPresent(org.springframework.boot.data.couchbase.test.autoconfigure.AutoConfigureDataCouchbase.class))\n                .isTrue();\n    }\n\n    @Test\n    void dataCouchbaseTestImportsCouchbaseInfrastructure() {\n        this.contextRunner.run((context) -> {\n            assertThat(context).hasNotFailed();\n            assertThat(context).hasSingleBean(DataCouchbaseProperties.class);\n            assertThat(context).hasSingleBean(CouchbaseCustomConversions.class);\n            assertThat(context).hasSingleBean(CouchbaseMappingContext.class);\n            assertThat(context).hasSingleBean(MappingCouchbaseConverter.class);\n            assertThat(context).hasSingleBean(TranslationService.class);\n\n            DataCouchbaseProperties properties = context.getBean(DataCouchbaseProperties.class);\n            assertThat(properties.getBucketName()).isEqualTo(\"orders\");\n            assertThat(properties.getScopeName()).isEqualTo(\"fulfillment\");\n            assertThat(properties.getTypeKey()).isEqualTo(\"documentType\");\n            assertThat(context.getBean(MappingCouchbaseConverter.class).getTypeKey()).isEqualTo(\"documentType\");\n        });\n    }\n\n    @DataCouchbaseTest(properties = { \"spring.data.couchbase.bucket-name=orders\",\n            \"spring.data.couchbase.scope-name=fulfillment\" }, useDefaultFilters = false)\n    @Configuration(proxyBeanMethods = false)\n    static class DataCouchbaseSliceConfiguration {\n\n    }\n\n}\n"}]}
