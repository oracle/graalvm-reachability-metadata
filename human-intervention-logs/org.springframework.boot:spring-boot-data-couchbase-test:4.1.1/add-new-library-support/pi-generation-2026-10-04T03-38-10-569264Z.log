bility-metadata.json\ntests/src/org.springframework.boot/spring-boot-validation/4.0.6/build.gradle\ntests/src/org.springframework.boot/spring-boot-validation/4.0.6/gradle.properties\ntests/src/org.springframework.boot/spring-boot-validation/4.0.6/.gitignore\ntests/src/org.springframework.boot/spring-boot-validation/4.0.6/settings.gradle\ntests/src/org.springframework.boot/spring-boot-web-server\ntests/src/org.springframework.boot/spring-boot-web-server/4.0.2\ntests/src/org.springframework.boot/spring-boot-web-server/4.0.2/user-code-filter.json\ntests/src/org.springframework.boot/spring-boot-web-server/4.0.2/src\ntests/src/org.springframework.boot/spring-boot-web-server/4.0.2/src/test\ntests/src/org.springframework.boot/spring-boot-web-server/4.0.2/src/test/java\ntests/src/org.springframework.boot/spring-boot-web-server/4.0.2/src/test/java/org_springframework_boot\ntests/src/org.springframework.boot/spring-boot-web-server/4.0.2/src/test/java/org_springframework_boot/spring_boot_web_server\ntests/src/org.springframework.boot/spring-boot-web-server/4.0.2/src/test/java/org_springframework_boot/spring_boot_web_server/Spring_boot_web_serverTest.java\ntests/src/org.springframework.boot/spring-boot-web-server/4.0.2/build.gradle\ntests/src/org.springframework.boot/spring-boot-web-server/4.0.2/gradle.properties\ntests/src/org.springframework.boot/spring-boot-web-server/4.0.2/.gitignore\ntests/src/org.springframework.boot/spring-boot-web-server/4.0.2/settings.gradle\nmetadata/org.springframework.boot/spring-boot-data-couchbase-test\nmetadata/org.springframework.boot/spring-boot-data-couchbase-test/index.json\nmetadata/org.springframework.boot/spring-boot-data-couchbase-test/4.1.1\nmetadata/org.springframework.boot/spring-boot-data-couchbase-test/4.1.1/reachability-metadata.json\nstats/org.springframework.boot/spring-boot-data-couchbase/4.1.1/forge-publication.json:94:        \"when `org.springframework.boot.data.couchbase.autoconfigure.DataCouchbaseConfiguration` is reached, make `com.fasterxml.jackson.databind.deser.Deserializers[]` available for reflection\",\nstats/org.springframework.boot/spring-boot-data-couchbase/4.1.1/forge-publication.json:95:        \"when `org.springframework.boot.data.couchbase.autoconfigure.DataCouchbaseConfiguration` is reached, make `com.fasterxml.jackson.databind.ser.Serializers[]` available for reflection\",\nstats/org.springframework.boot/spring-boot-data-couchbase/4.1.1/forge-publication.json:96:        \"when `org.springframework.boot.data.couchbase.autoconfigure.DataCouchbaseConfiguration` is reached, make `org.springframework.aot.hint.annotation.Reflective` available for reflection\",\nstats/org.springframework.boot/spring-boot-data-couchbase/4.1.1/forge-publication.json:97:        \"when `org.springframework.boot.data.couchbase.autoconfigure.DataCouchbaseConfiguration` is reached, make `org.springframework.data.convert.ReadingConverter` available for reflection\",\nstats/org.springframework.boot/spring-boot-data-couchbase/4.1.1/forge-publication.json:98:        \"when `org.springframework.boot.data.couchbase.autoconfigure.DataCouchbaseConfiguration` is reached, make `org.springframework.data.convert.WritingConverter` available for reflection\",\nstats/org.springframework.boot/spring-boot-data-couchbase/4.1.1/forge-publication.json:99:        \"when `org.springframework.boot.data.couchbase.autoconfigure.DataCouchbaseConfiguration` is reached, make `org.springframework.data.mapping.model.SnakeCaseFieldNamingStrategy.<init>()` available for reflection\",\nstats/org.springframework.boot/spring-boot-data-couchbase/4.1.1/forge-publication.json:100:        \"when `org.springframework.boot.data.couchbase.autoconfigure.DataCouchbaseConfiguration` is reached, make `org.springframework.util.ConcurrentReferenceHashMap$Segment[]` available for reflection\"\nstats/org.springframework.boot/spring-boot-data-couchbase/4.1.1/execution-metrics.json:48:      \"agent_guidance\": \"CouchbaseDataAutoConfiguration is @ConditionalOnBean(Cluster.class), so its beans (CouchbaseTemplate, repositories) only activate when a Cluster bean exists in the context. Follow the spring-boot-amqp/spring-boot-kafka pattern: use ApplicationContextRunner against CouchbaseDataAutoConfiguration, supplying a mocked/stub Cluster (and CouchbaseConnectionDetails/CouchbaseDataProperties as needed) rather than a real connection, to exercise properties binding, conditional activation, and customizer application without requiring network connectivity.\",\nstats/org.springframework.boot/spring-boot-data-couchbase/4.1.1/execution-metrics.json:50:        \"If a later deep-coverage pass needs real repository CRUD execution (not just autoconfiguration wiring), a live Couchbase server would become necessary and no Docker image is currently allow-listed for it.\",\nmetadata/com.couchbase.client/tracing-micrometer-observation/index.json:9:    \"description\" : \"This library integrates the Couchbase JVM SDK with Micrometer Observation by translating Couchbase request lifecycle events into Micrometer observations. It enables applications to collect and export Couchbase tracing and observation data through Micrometer-compatible handlers.\",\nmetadata/com.couchbase.client/metrics-micrometer/index.json:9:    \"description\" : \"Couchbase Metrics Micrometer integrates the Couchbase JVM client’s metrics API with Micrometer’s MeterRegistry. It adapts Couchbase counters and value recorders to Micrometer instruments so applications can export Couchbase client metrics through Micrometer-compatible monitoring systems.\",\nstats/com.couchbase.client/tracing-micrometer-observation/3.11.3/execution-metrics.json:46:      \"summary\": \"Add Micrometer test fixtures so observations and parent/child spans are observable without a live Couchbase server.\",\nstats/com.couchbase.client/tracing-micrometer-observation/3.11.3/execution-metrics.json:61:      \"agent_guidance\": \"Create an ObservationRegistry with a tracing handler backed by SimpleTracer. Exercise ObservationRequestTracer.wrap, null and explicit parent spans, operation names, client kind, attributes, exception recording, and end/stop behavior. No system property or live Couchbase service is required for artifact-level coverage; the Couchbase SDK’s requestTracer environment wiring is optional. [Upstream unit test](https://github.com/couchbase/couchbase-jvm-clients/blob/3.11.3/tracing-micrometer-observation/src/integrationTest/java/com/couchbase/client/tracing/observation/ObservationRequestTracerTests.java)\",\nstats/com.couchbase.client/tracing-micrometer-observation/3.11.3/execution-metrics.json:63:        \"A full end-to-end Couchbase request test would additionally require java-client/test infrastructure and a running Couchbase cluster; local Gradle and Native Image verification remain authoritative.\",\nstats/com.couchbase.client/metrics-micrometer/3.11.3/execution-metrics.json:48:      \"agent_guidance\": \"Use MicrometerMeter.wrap(new SimpleMeterRegistry()) and exercise counters, value recorders, and tag handling. Keep coverage independent of a live Couchbase cluster or Prometheus exporter.\",\nstats/com.couchbase.client/metrics-micrometer/3.11.3/execution-metrics.json:50:        \"Live Cluster integration would require separate Couchbase infrastructure, but is unnecessary for meaningful adapter coverage.\"\nmetadata/org.springframework.boot/spring-boot-data-couchbase/4.1.1/reachability-metadata.json:5:        \"typeReached\" : \"org.springframework.boot.data.couchbase.autoconfigure.DataCouchbaseConfiguration\"\nmetadata/org.springframework.boot/spring-boot-data-couchbase/4.1.1/reachability-metadata.json:11:        \"typeReached\" : \"org.springframework.boot.data.couchbase.autoconfigure.DataCouchbaseConfiguration\"\nmetadata/org.springframework.boot/spring-boot-data-couchbase/4.1.1/reachability-metadata.json:17:        \"typeReached\" : \"org.springframework.boot.data.couchbase.autoconfigure.DataCouchbaseConfiguration\"\nmetadata/or