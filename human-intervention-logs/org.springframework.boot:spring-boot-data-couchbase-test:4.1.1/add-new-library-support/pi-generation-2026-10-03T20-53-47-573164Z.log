.query.QueryScanConsistency;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\n@DataCouchbaseTest(properties = {\n        \"spring.couchbase.env.timeouts.connect=10s\",\n        \"spring.couchbase.env.timeouts.key-value=10s\",\n        \"spring.couchbase.env.timeouts.query=30s\",\n        \"spring.data.couchbase.bucket-name=test-bucket\"\n})\n@Import(Spring_boot_data_couchbase_testTest.CouchbaseConfiguration.class)\npublic class Spring_boot_data_couchbase_testTest {\n\n    @Autowired\n    private CouchbaseTemplate couchbaseTemplate;\n\n    @Test\n    void storesFindsAndQueriesDocumentsThroughTheDataCouchbaseSlice() {\n        Person ada = this.couchbaseTemplate.save(new Person(\"ada\", \"Ada\", \"engineer\"));\n        this.couchbaseTemplate.save(new Person(\"grace\", \"Grace\", \"researcher\"));\n\n        Person found = this.couchbaseTemplate.findById(Person.class).one(ada.getId());\n        assertThat(found).isNotNull();\n        assertThat(found.getName()).isEqualTo(\"Ada\");\n        assertThat(found.getRole()).isEqualTo(\"engineer\");\n\n        List<Person> engineers = this.couchbaseTemplate.findByQuery(Person.class)\n                .matching(Query.query(QueryCriteria.where(\"role\").is(\"engineer\"))\n                        .scanConsistency(QueryScanConsistency.REQUEST_PLUS))\n                .all();\n        assertThat(engineers).extracting(Person::getId).containsExactly(\"ada\");\n    }\n\n    @TestConfiguration(proxyBeanMethods = false)\n    static class CouchbaseConfiguration {\n\n        @Bean(destroyMethod = \"\")\n        @ServiceConnection\n        CouchbaseContainer couchbaseContainer() {\n            return new CouchbaseContainer(\"couchbase/server:7.6.2\")\n                    .withCredentials(\"Administrator\", \"password\")\n                    .withBucket(new BucketDefinition(\"test-bucket\"))\n                    .withStartupTimeout(Duration.ofSeconds(50));\n        }\n\n    }\n\n    @Document\n    public static class Person {\n\n        @Id\n        private String id;\n\n        private String name;\n\n        private String role;\n\n        public Person() {\n        }\n\n        Person(String id, String name, String role) {\n            this.id = id;\n            this.name = name;\n            this.role = role;\n        }\n\n        public String getId() {\n            return this.id;\n        }\n\n        public String getName() {\n            return this.name;\n        }\n\n        public String getRole() {\n            return this.role;\n        }\n\n    }\n\n}\n"}]}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-luna", "usage": {"input": 3390, "output": 1030, "cacheRead": 107008, "cacheWrite": 0, "reasoning": 111, "totalTokens": 111428, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1791061162259, "responseId": "resp_091bc5bc75a1d356016ac16cab00b087d1b7df636265cd56b0", "rawStopReason": "completed"}, "toolResults": [{"role": "toolResult", "toolCallId": "call_B5AsdF0Lx2kT0Lfu0Yns84GK|fc_091bc5bc75a1d356016ac16cb03b6087d19eeac9158c8e50a8", "toolName": "edit", "content": [{"type": "text", "text": "Successfully replaced 1 block(s) in tests/src/org.springframework.boot/spring-boot-data-couchbase-test/4.1.1/src/test/java/org_springframework_boot/spring_boot_data_couchbase_test/Spring_boot_data_couchbase_testTest.java."}], "details": {"diff": "     ...\n   5  * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n   6  */\n   7 package org_springframework_boot.spring_boot_data_couchbase_test;\n   8 \n+  9 import java.time.Duration;\n+ 10 import java.util.List;\n+ 11 \n   9 import org.junit.jupiter.api.Test;\n+ 13 import org.testcontainers.couchbase.BucketDefinition;\n+ 14 import org.testcontainers.couchbase.CouchbaseContainer;\n  10 \n- 11 class Spring_boot_data_couchbase_testTest {\n+ 16 import org.springframework.beans.factory.annotation.Autowired;\n+ 17 import or