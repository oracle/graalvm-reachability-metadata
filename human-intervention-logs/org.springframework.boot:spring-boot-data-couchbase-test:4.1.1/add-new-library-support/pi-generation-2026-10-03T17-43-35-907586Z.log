.ContextConfiguration;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\n@DataCouchbaseTest(\n        properties = \"spring.profiles.active=data-couchbase-slice\",\n        includeFilters = @Filter(type = FilterType.ASSIGNABLE_TYPE, classes = IncludedComponent.class),\n        excludeAutoConfiguration = {\n            CouchbaseAutoConfiguration.class,\n            DataCouchbaseAutoConfiguration.class,\n            DataCouchbaseReactiveAutoConfiguration.class,\n            DataCouchbaseReactiveRepositoriesAutoConfiguration.class,\n            DataCouchbaseRepositoriesAutoConfiguration.class\n        })\n@ContextConfiguration(classes = TestApplication.class)\npublic class Spring_boot_data_couchbase_testTest {\n\n    @Autowired\n    private ApplicationContext applicationContext;\n\n    @Autowired\n    private Environment environment;\n\n    @Test\n    void dataCouchbaseTestAppliesPropertiesAndIncludeFilters() {\n        assertThat(this.environment.getActiveProfiles()).containsExactly(\"data-couchbase-slice\");\n        assertThat(this.applicationContext).hasSingleBean(IncludedComponent.class);\n        assertThat(this.applicationContext).doesNotHaveBean(ExcludedComponent.class);\n    }\n\n    @Test\n    void dataCouchbaseTestExposesItsConfigurationAttributes() {\n        DataCouchbaseTest annotation = MergedAnnotations.from(Spring_boot_data_couchbase_testTest.class)\n                .get(DataCouchbaseTest.class)\n                .synthesize();\n\n        assertThat(annotation.properties()).containsExactly(\"spring.profiles.active=data-couchbase-slice\");\n        assertThat(annotation.useDefaultFilters()).isTrue();\n        assertThat(annotation.includeFilters()).hasSize(1);\n        assertThat(annotation.excludeFilters()).isEmpty();\n        assertThat(annotation.excludeAutoConfiguration()).containsExactly(\n                CouchbaseAutoConfiguration.class,\n                DataCouchbaseAutoConfiguration.class,\n                DataCouchbaseReactiveAutoConfiguration.class,\n                DataCouchbaseReactiveRepositoriesAutoConfiguration.class,\n                DataCouchbaseRepositoriesAutoConfiguration.class);\n    }\n\n    @Test\n    void autoConfigureDataCouchbaseIsAvailableAsAComposableAnnotation() {\n        MergedAnnotations annotations = MergedAnnotations.from(AutoConfiguredComponent.class);\n\n        assertThat(annotations.isPresent(AutoConfigureDataCouchbase.class)).isTrue();\n        assertThat(annotations.isPresent(SpringBootConfiguration.class)).isTrue();\n    }\n\n    @SpringBootApplication(scanBasePackageClasses = IncludedComponent.class)\n    static class TestApplication {\n\n    }\n\n    @Service\n    static class IncludedComponent {\n\n    }\n\n    @Service\n    static class ExcludedComponent {\n\n    }\n\n    @SpringBootConfiguration\n    @AutoConfigureDataCouchbase\n    static class AutoConfiguredComponent {\n\n    }\n\n}\n"}]}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-luna", "usage": {"input": 3179, "output": 5443, "cacheRead": 67072, "cacheWrite": 0, "reasoning": 4449, "totalTokens": 75694, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1791049620349, "responseId": "resp_0273947afc876966016ac13f94e6a087d1b948574057c82901", "rawStopReason": "completed"}}
