  14589:[tool-call] end id=call_bTPxysDl77R6Z9lMW3bL2CLN|fc_0d5899082be2c4e6016ac1431d173887d193e6be6d9f24ac48 name=edit args={"path": "tests/src/org.springframework.boot/spring-boot-data-couchbase-test/4.1.1/src/test/java/org_springframework_boot/spring_boot_data_couchbase_test/Spring_boot_data_couchbase_testTest.java", "edits": [{"oldText": "import org.junit.jupiter.api.Nested;\nimport org.junit.jupiter.api.Test;\n\nimport org.springframework.beans.factory.annotation.Autowired;\nimport org.springframework.boot.autoconfigure.ImportAutoConfiguration;\nimport org.springframework.boot.context.TypeExcludeFilter;", "newText": "import org.junit.jupiter.api.Test;\n\nimport org.springframework.boot.autoconfigure.ImportAutoConfiguration;"}, {"oldText": "import org.springframework.context.ApplicationContext;\nimport org.springframework.context.annotation.ComponentScan;\nimport org.springframework.context.annotation.ComponentScan.Filter;\nimport org.springframework.context.annotation.Configuration;\nimport org.springframework.context.annotation.FilterType;\nimport org.springframework.core.annotation.MergedAnnotations;\nimport org.springframework.stereotype.Component;\nimport org.springframework.test.context.ContextConfiguration;", "newText": "import org.springframework.context.annotation.ComponentScan.Filter;\nimport org.springframework.context.annotation.FilterType;\nimport org.springframework.core.annotation.MergedAnnotations;"}, {"oldText": "    @Test\n    void autoConfigureDataCouchbaseIsAvailableAsAComposableAnnotation() {\n        MergedAnnotations annotations = MergedAnnotations.from(AutoConfiguredComponent.class);\n\n        assertThat(annotations.isPresent(AutoConfigureDataCouchbase.class)).isTrue();\n        assertThat(annotations.isPresent(ImportAutoConfiguration.class)).isTrue();\n    }\n\n    @Nested\n    @DataCouchbaseTest(\n            useDefaultFilters = false,\n            includeFilters = @Filter(type = FilterType.ASSIGNABLE_TYPE, classes = IncludedComponent.class),\n            excludeAutoConfiguration = {\n                CouchbaseAutoConfiguration.class,\n                DataCouchbaseAutoConfiguration.class,\n                DataCouchbaseReactiveAutoConfiguration.class,\n                DataCouchbaseReactiveRepositoriesAutoConfiguration.class,\n                DataCouchbaseRepositoriesAutoConfiguration.class\n            })\n    @ContextConfiguration(classes = ComponentScanConfiguration.class)\n    class DataCouchbaseSliceContextTest {\n\n        @Autowired\n        private ApplicationContext applicationContext;\n\n        @Test\n        void dataCouchbaseTestAppliesComponentIncludeFilters() {\n            assertThat(applicationContext.getBeansOfType(IncludedComponent.class)).hasSize(1);\n            assertThat(applicationContext.getBeansOfType(ExcludedComponent.class)).isEmpty();\n        }\n\n    }\n\n}\n\n@Configuration(proxyBeanMethods = false)\n@ComponentScan(basePackageClasses = IncludedComponent.class,\n        excludeFilters = @Filter(type = FilterType.CUSTOM, classes = TypeExcludeFilter.class))\nclass ComponentScanConfiguration {\n\n}", "newText": "    @Test\n    void autoConfigureDataCouchbaseIsAvailableAsAComposableAnnotation() {\n        MergedAnnotations annotations = MergedAnnotations.from(AutoConfiguredComponent.class);\n\n        assertThat(annotations.isPresent(AutoConfigureDataCouchbase.class)).isTrue();\n        assertThat(annotations.isPresent(ImportAutoConfiguration.class)).isTrue();\n    }\n\n    @Test\n    void dataCouchbaseTestPropagatesAutoConfigurationExclusions() {\n        ImportAutoConfiguration annotation = MergedAnnotations.from(DataCouchbaseSlice.class)\n                .get(ImportAutoConfiguration.class)\n                .synthesize();\n\n        assertThat(annotation.exclude()).containsExactly(\n                CouchbaseAutoConfiguration.class,\n                DataCouchbaseAutoConfiguration.class,\n                DataCouchbaseReactiveAutoConfiguration.class,\n                DataC