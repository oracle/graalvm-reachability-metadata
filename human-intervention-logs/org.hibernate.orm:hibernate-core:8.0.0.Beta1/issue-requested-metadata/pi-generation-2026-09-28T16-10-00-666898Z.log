nsaction().commit();\n            }\n\n            assertThat(event.getCreatedAt()).isNotNull();\n\n            try (Session session = sessionFactory.openSession()) {\n                TimestampedEvent loaded = session.find(TimestampedEvent.class, event.getId());\n                assertThat(loaded).isNotNull();\n                assertThat(loaded.getName()).isEqualTo(\"created by Hibernate\");\n                assertThat(loaded.getCreatedAt()).isEqualTo(event.getCreatedAt());\n            }\n        } finally {\n            StandardServiceRegistryBuilder.destroy(registry);\n        }\n    }\n\n    @Entity(name = \"TimestampedEvent\")\n    @Table(name = \"TIMESTAMPED_EVENT\")\n    public static final class TimestampedEvent {\n\n        @Id\n        @GeneratedValue\n        private Long id;\n\n        private String name;\n\n        @CreationTimestamp\n        private Instant createdAt;\n\n        public TimestampedEvent() {\n        }\n\n        public TimestampedEvent(String name) {\n            this.name = name;\n        }\n\n        public Long getId() {\n            return id;\n        }\n\n        public String getName() {\n            return name;\n        }\n\n        public Instant getCreatedAt() {\n            return createdAt;\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1790611826001}}
