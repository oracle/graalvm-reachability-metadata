ory()) {\n            LoadedEvent event = new LoadedEvent(\"metadata test\");\n            try (Session session = sessionFactory.openSession()) {\n                session.beginTransaction();\n                session.persist(event);\n                session.getTransaction().commit();\n            }\n\n            try (Session session = sessionFactory.openSession()) {\n                LoadedEvent loaded = session.find(LoadedEvent.class, event.getId());\n                assertThat(loaded).isNotNull();\n                assertThat(loaded.getName()).isEqualTo(\"metadata test\");\n            }\n        } finally {\n            StandardServiceRegistryBuilder.destroy(registry);\n        }\n    }\n\n    @Test\n    public void jaxbLogger() {\n        assertThat(JaxbLogger.JAXB_LOGGER.isTraceEnabled()).isFalse();\n    }\n\n    @Test\n    public void jdbcLogger() {\n        assertThat(JdbcLogging.JDBC_LOGGER.isTraceEnabled()).isFalse();\n    }\n\n    @Test\n    public void secondLevelCacheLogger() {\n        assertThat(SecondLevelCacheLogger.L2CACHE_LOGGER.isTraceEnabled()).isFalse();\n    }\n\n    @Test\n    public void urlMessageBundleLogger() throws Exception {\n        UrlMessageBundle.URL_MESSAGE_LOGGER.logFileIsNotDirectory(new URL(\"file:\"));\n    }\n\n    @Entity(name = \"LoadedEvent\")\n    @Table(name = \"LOADED_EVENT\")\n    public static final class LoadedEvent {\n\n        @Id\n        @GeneratedValue\n        private Long id;\n\n        private String name;\n\n        public LoadedEvent() {\n        }\n\n        public LoadedEvent(String name) {\n            this.name = name;\n        }\n\n        public Long getId() {\n            return id;\n        }\n\n        public String getName() {\n            return name;\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1790611826001}}
