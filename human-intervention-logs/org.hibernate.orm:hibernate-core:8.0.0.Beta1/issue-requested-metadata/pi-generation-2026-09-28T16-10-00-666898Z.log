nimport org.hibernate.Session;\nimport org.hibernate.SessionFactory;\nimport org.hibernate.boot.MetadataSources;\nimport org.hibernate.boot.jaxb.JaxbLogger;\nimport org.hibernate.boot.registry.StandardServiceRegistry;\nimport org.hibernate.boot.registry.StandardServiceRegistryBuilder;\nimport org.hibernate.cache.spi.SecondLevelCacheLogger;\nimport org.hibernate.cfg.AvailableSettings;\nimport org.hibernate.engine.jdbc.JdbcLogging;\nimport org.hibernate.internal.log.UrlMessageBundle;\nimport org.hibernate.resource.beans.internal.BeansMessageLogger;\nimport org.junit.jupiter.api.Test;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\npublic class LoggerTest {\n\n    @Test\n    public void beansMessageLogger() {\n        assertThat(BeansMessageLogger.BEANS_MSG_LOGGER).isNotNull();\n    }\n\n    @Test\n    public void persistAndLoadEntity() {\n        StandardServiceRegistry registry = new StandardServiceRegistryBuilder()\n                .applySetting(AvailableSettings.JAKARTA_JDBC_URL, \"jdbc:h2:mem:loading_logger\")\n                .applySetting(AvailableSettings.HBM2DDL_AUTO, \"create-drop\")\n                .build();\n\n        try (SessionFactory sessionFactory = new MetadataSources(registry)\n                .addAnnotatedClass(LoadedEvent.class)\n                .buildMetadata()\n                .buildSessionFactory()) {\n            LoadedEvent event = new LoadedEvent(\"metadata test\");\n            try (Session session = sessionFactory.openSession()) {\n                session.beginTransaction();\n                session.persist(event);\n                session.getTransaction().commit();\n            }\n\n            try (Session session = sessionFactory.openSession()) {\n                LoadedEvent loaded = session.find(LoadedEvent.class, event.getId());\n                assertThat(loaded).isNotNull();\n                assertThat(loaded.getName()).isEqualTo(\"metadata test\");\n            }\n        } finally {\n            StandardServiceRegistryBuilder.destroy(registry);\n        }\n    }\n\n    @Test\n    public void jaxbLogger() {\n        assertThat(JaxbLogger.JAXB_LOGGER.isTraceEnabled()).isFalse();\n    }\n\n    @Test\n    public void jdbcLogger() {\n        assertThat(JdbcLogging.JDBC_LOGGER.isTraceEnabled()).isFalse();\n    }\n\n    @Test\n    public void secondLevelCacheLogger() {\n        assertThat(SecondLevelCacheLogger.L2CACHE_LOGGER.isTraceEnabled()).isFalse();\n    }\n\n    @Test\n    public void urlMessageBundleLogger() throws Exception {\n        UrlMessageBundle.URL_MESSAGE_LOGGER.logFileIsNotDirectory(new URL(\"file:\"));\n    }\n\n    @Entity(name = \"LoadedEvent\")\n    @Table(name = \"LOADED_EVENT\")\n    public static final class LoadedEvent {\n\n        @Id\n        @GeneratedValue\n        private Long id;\n\n        private String name;\n\n        public LoadedEvent() {\n        }\n\n        public LoadedEvent(String name) {\n            this.name = name;\n        }\n\n        public Long getId() {\n            return id;\n        }\n\n        public String getName() {\n            return name;\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1790611826001}, {"role": "toolResult", "toolCallId": "call_7ACXOoeNmwy6IygfjnFoaZOI|fc_0520688b77d62468016aba9171db9c87d2b18011bb805a0b48", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_hibernate_orm.hibernate_core;\n\nimport java.time.Instant;\n\nimport jakarta.persistence.Entity;\nimport jakarta.persistence.GeneratedValue;\nimport jakarta.persistence.Id;\nimport jakarta.persistence.Table;\nimport org.hibernate.Session;\nimport org.hibernate.SessionFactory;\nimport org.hibernate.annotations.CreationTimestamp;\nimport org.hibernate.boot.MetadataSources;\nimport org.hibernate.boot.registry.StandardServiceRegistry;\nimport org.hibernate.boot.registry.StandardServiceRegistryBuilder;\nimport org.hibernate.cfg.AvailableSettings;\nimport org.junit.jupiter.api.Test;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\npublic class CurrentTimestampGenerationTest {\n\n    @Test\n    public void generatesCreationTimestampWhenEntityIsPersisted() {\n        StandardServiceRegistry registry = new StandardServiceRegistryBuilder()\n                .applySetting(AvailableSettings.JAKARTA_JDBC_URL, \"jdbc:h2:mem:timestamp_generation\")\n                .applySetting(AvailableSettings.HBM2DDL_AUTO, \"create-drop\")\n                .build();\n\n        try (SessionFactory sessionFactory = new MetadataSources(registry)\n                .addAnnotatedClass(TimestampedEvent.class)\n                .buildMetadata()\n                .buildSessionFactory()) {\n            TimestampedEvent event = new TimestampedEvent(\"created by Hibernate\");\n            try (Session session = sessionFactory.openSession()) {\n                session.beginTransaction();\n                session.persist(event);\n                session.getTransaction().commit();\n            }\n\n            assertThat(event.getCreatedAt()).isNotNull();\n\n            try (Session session = sessionFactory.openSession()) {\n                TimestampedEvent loaded = session.find(TimestampedEvent.class, event.getId());\n                assertThat(loaded).isNotNull();\n                assertThat(loaded.getName()).isEqualTo(\"created by Hibernate\");\n                assertThat(loaded.getCreatedAt()).isEqualTo(event.getCreatedAt());\n            }\n        } finally {\n            StandardServiceRegistryBuilder.destroy(registry);\n        }\n    }\n\n    @Entity(name = \"TimestampedEvent\")\n    @Table(name = \"TIMESTAMPED_EVENT\")\n    public static final class TimestampedEvent {\n\n        @Id\n        @GeneratedValue\n        private Long id;\n\n        private String name;\n\n        @CreationTimestamp\n        private Instant createdAt;\n\n        public TimestampedEvent() {\n        }\n\n        public TimestampedEvent(String name) {\n            this.name = name;\n        }\n\n        public Long getId() {\n            return id;\n        }\n\n        public String getName() {\n            return name;\n        }\n\n        public Instant getCreatedAt() {\n            return createdAt;\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1790611826001}]}
