ibernate_orm/hibernate_core/LoggerTest.java\n@@ -8,12 +8,21 @@ package org_hibernate_orm.hibernate_core;\n \n import java.net.URL;\n \n+import jakarta.persistence.Entity;\n+import jakarta.persistence.GeneratedValue;\n+import jakarta.persistence.Id;\n+import jakarta.persistence.Table;\n+import org.hibernate.Session;\n+import org.hibernate.SessionFactory;\n+import org.hibernate.boot.MetadataSources;\n import org.hibernate.boot.jaxb.JaxbLogger;\n+import org.hibernate.boot.registry.StandardServiceRegistry;\n+import org.hibernate.boot.registry.StandardServiceRegistryBuilder;\n import org.hibernate.cache.spi.SecondLevelCacheLogger;\n+import org.hibernate.cfg.AvailableSettings;\n import org.hibernate.engine.jdbc.JdbcLogging;\n import org.hibernate.internal.log.UrlMessageBundle;\n import org.hibernate.resource.beans.internal.BeansMessageLogger;\n-import org.hibernate.sql.results.graph.embeddable.EmbeddableLoadingLogger;\n import org.junit.jupiter.api.Test;\n \n import static org.assertj.core.api.Assertions.assertThat;\n@@ -26,8 +35,31 @@ public class LoggerTest {\n     }\n \n     @Test\n-    public void embeddableLoadingLogger() {\n-        assertThat(EmbeddableLoadingLogger.EMBEDDED_LOAD_LOGGER.isTraceEnabled()).isFalse();\n+    public void persistAndLoadEntity() {\n+        StandardServiceRegistry registry = new StandardServiceRegistryBuilder()\n+                .applySetting(AvailableSettings.JAKARTA_JDBC_URL, \"jdbc:h2:mem:loading_logger\")\n+                .applySetting(AvailableSettings.HBM2DDL_AUTO, \"create-drop\")\n+                .build();\n+\n+        try (SessionFactory sessionFactory = new MetadataSources(registry)\n+                .addAnnotatedClass(LoadedEvent.class)\n+                .buildMetadata()\n+                .buildSessionFactory()) {\n+            LoadedEvent event = new LoadedEvent(\"metadata test\");\n+            try (Session session = sessionFactory.openSession()) {\n+                session.beginTransaction();\n+                session.persist(event);\n+                session.getTransaction().commit();\n+            }\n+\n+            try (Session session = sessionFactory.openSession()) {\n+                LoadedEvent loaded = session.find(LoadedEvent.class, event.getId());\n+                assertThat(loaded).isNotNull();\n+                assertThat(loaded.getName()).isEqualTo(\"metadata test\");\n+            }\n+        } finally {\n+            StandardServiceRegistryBuilder.destroy(registry);\n+        }\n     }\n \n     @Test\n@@ -50,4 +82,29 @@ public class LoggerTest {\n         UrlMessageBundle.URL_MESSAGE_LOGGER.logFileIsNotDirectory(new URL(\"file:\"));\n     }\n \n+    @Entity(name = \"LoadedEvent\")\n+    @Table(name = \"LOADED_EVENT\")\n+    public static final class LoadedEvent {\n+\n+        @Id\n+        @GeneratedValue\n+        private Long id;\n+\n+        private String name;\n+\n+        public LoadedEvent() {\n+        }\n+\n+        public LoadedEvent(String name) {\n+            this.name = name;\n+        }\n+\n+        public Long getId() {\n+            return id;\n+        }\n+\n+        public String getName() {\n+            return name;\n+        }\n+    }\n }\ndiff --git a/tests/src/org.hibernate.orm/hibernate-core/8.0.0.Beta1/src/test/java/org_hibernate_orm/hibernate_core/CurrentTimestampGenerationTest.java b/tests/src/org.hibernate.orm/hibernate-core/8.0.0.Beta1/src/test/java/org_hibernate_orm/hibernate_core/CurrentTimestampGenerationTest.java\nnew file mode 100644\nindex 0000000000..85d31d8f71\n--- /dev/null\n+++ b/tests/src/org.hibernate.orm/hibernate-core/8.0.0.Beta1/src/test/java/org_hibernate_orm/hibernate_core/CurrentTimestampGenerationTest.java\n@@ -0,0 +1,91 @@\n+/*\n+ * Copyright and related rights waived via CC0\n+ *\n+ * You should have received a copy of the CC0 legalcode along with this\n+ * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n+ */\n+package org_hibernate_orm.hibernate_core;\n+\n+import java.time.Instant;\n+\n+import jakarta.persistence.Entity;\n+import jakarta.persistence.GeneratedValue;\n+import jakarta.persistence.Id;\n+import jakarta.persistence.Table;\n+import org.hibernate.Session;\n+import org.hibernate.SessionFactory;\n+import org.hibernate.annotations.CreationTimestamp;\n+import org.hibernate.boot.MetadataSources;\n+import org.hibernate.boot.registry.StandardServiceRegistry;\n+import org.hibernate.boot.registry.StandardServiceRegistryBuilder;\n+import org.hibernate.cfg.AvailableSettings;\n+import org.junit.jupiter.api.Test;\n+\n+import static org.assertj.core.api.Assertions.assertThat;\n+\n+public class CurrentTimestampGenerationTest {\n+\n+    @Test\n+    public void generatesCreationTimestampWhenEntityIsPersisted() {\n+        StandardServiceRegistry registry = new StandardServiceRegistryBuilder()\n+                .applySetting(AvailableSettings.JAKARTA_JDBC_URL, \"jdbc:h2:mem:timestamp_generation\")\n+                .applySetting(AvailableSettings.HBM2DDL_AUTO, \"create-drop\")\n+                .build();\n+\n+        try (SessionFactory sessionFactory = new MetadataSources(registry)\n+                .addAnnotatedClass(TimestampedEvent.class)\n+                .buildMetadata()\n+                .buildSessionFactory()) {\n+            TimestampedEvent event = new TimestampedEvent(\"created by Hibernate\");\n+            try (Session session = sessionFactory.openSession()) {\n+                session.beginTransaction();\n+                session.persist(event);\n+                session.getTransaction().commit();\n+            }\n+\n+            assertThat(event.getCreatedAt()).isNotNull();\n+\n+            try (Session session = sessionFactory.openSession()) {\n+                TimestampedEvent loaded = session.find(TimestampedEvent.class, event.getId());\n+                assertThat(loaded).isNotNull();\n+                assertThat(loaded.getName()).isEqualTo(\"created by Hibernate\");\n+                assertThat(loaded.getCreatedAt()).isEqualTo(event.getCreatedAt());\n+            }\n+        } finally {\n+            StandardServiceRegistryBuilder.destroy(registry);\n+        }\n+    }\n+\n+    @Entity(name = \"TimestampedEvent\")\n+    @Table(name = \"TIMESTAMPED_EVENT\")\n+    public static final class TimestampedEvent {\n+\n+        @Id\n+        @GeneratedValue\n+        private Long id;\n+\n+        private String name;\n+\n+        @CreationTimestamp\n+        private Instant createdAt;\n+\n+        public TimestampedEvent() {\n+        }\n+\n+        public TimestampedEvent(String name) {\n+            this.name = name;\n+        }\n+\n+        public Long getId() {\n+            return id;\n+        }\n+\n+        public String getName() {\n+            return name;\n+        }\n+\n+        public Instant getCreatedAt() {\n+            return createdAt;\n+        }\n+    }\n+}\n"}], "isError": false, "timestamp": 1790611715651}]}
