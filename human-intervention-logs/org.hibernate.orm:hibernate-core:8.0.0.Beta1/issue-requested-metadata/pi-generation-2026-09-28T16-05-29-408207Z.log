ata-extra-filter.json\"\n            }\n        }\n        metadataCopy {\n            inputTaskNames.add(\"test\")\n            outputDirectories.add(\"generated-metadata\")\n            mergeWithExisting = true\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1790611546383}}
