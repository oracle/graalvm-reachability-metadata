-jni/1.5.2-5/build/natively-collected/runs/cycle-1/reachability-metadata.json\ntests/src/com.github.luben/zstd-jni/1.5.2-5/build/natively-collected/runs/cycle-1/binary-exit-code\ntests/src/com.github.luben/zstd-jni/1.5.2-5/build/natively-collected/runs/cycle-0/reachability-metadata.json\ntests/src/com.github.luben/zstd-jni/1.5.2-5/build/natively-collected/runs/cycle-0/binary-exit-code\ntests/src/com.github.luben/zstd-jni/1.5.2-5/build/resources/test/compressTest.zs\ntests/src/com.github.luben/zstd-jni/1.5.2-5/build/resources/test/originTest.txt\ntests/src/com.github.luben/zstd-jni/1.5.2-5/build/reports/dynamic-access/dynamic-access-coverage.json\ntests/src/com.github.luben/zstd-jni/1.5.2-5/build/reports/jacoco/jacocoCodeCoverageReport/jacocoCodeCoverageReport.xml\ntests/src/com.github.luben/zstd-jni/1.5.2-5/build/reports/problems/problems-report.html\ntests/src/com.github.luben/zstd-jni/1.5.2-5/build/reports/tests/test/classes/com_github_luben.zstd_jni.Zstd_jniTest.html\ntests/src/com.github.luben/zstd-jni/1.5.2-5/build/reports/tests/test/index.html\ntests/src/com.github.luben/zstd-jni/1.5.2-5/build/reports/tests/test/js/report.js\ntests/src/com.github.luben/zstd-jni/1.5.2-5/build/reports/tests/test/packages/com_github_luben.zstd_jni.html\ntests/src/com.github.luben/zstd-jni/1.5.2-5/build/reports/tests/test/css/style.css\ntests/src/com.github.luben/zstd-jni/1.5.2-5/build/reports/tests/test/css/base-style.css\ntests/src/com.github.luben/zstd-jni/1.5.2-5/user-code-filter.json\ntests/src/com.github.luben/zstd-jni/1.5.2-5/settings.gradle\ntests/src/com.github.luben/zstd-jni/1.5.2-5/gradle.properties\n\nRelevant status:\n"}], "isError": false, "timestamp": 1791332579361}]}
