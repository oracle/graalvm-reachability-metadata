derType.getElementDecls().get(1).getName()).isEqualTo(\"quantity\");\n        assertThat(orderType.getElementDecls().get(1).getType().getName()).isEqualTo(\"int\");\n        assertThat(parser.getDocuments()).hasSize(1);\n    }\n\n    private static Path writeSchema(Path directory) throws IOException {\n"}]}
