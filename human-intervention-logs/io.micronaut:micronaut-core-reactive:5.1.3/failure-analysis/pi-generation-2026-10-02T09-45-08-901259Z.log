  14717:[tool-exec] start id=call_tryAqJ3jQg2VCddFOAO7URZt|fc_0909587d805e6a37016abf78daee7487d19f6a9ea91e25a996 name=edit args={"path": "tests/src/io.micronaut/micronaut-core-reactive/5.1.3/src/test/java/io_micronaut/micronaut_core_reactive/Micronaut_core_reactiveTest.java", "edits": [{"oldText": "package io_micronaut.micronaut_core_reactive;\n\nimport org.junit.jupiter.api.Test;\n\nclass Micronaut_core_reactiveTest {\n    @Test\n    void test() throws Exception {\n        System.out.println(\"This is just a placeholder, implement your test\");\n    }\n}\n", "newText": "package io_micronaut.micronaut_core_reactive;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport io.micronaut.core.async.ReactiveStreamsTypeInformationProvider;\nimport io.micronaut.core.async.publisher.AsyncSingleResultPublisher;\nimport io.micronaut.core.async.publisher.Publishers;\nimport io.micronaut.core.async.processor.SingleSubscriberProcessor;\nimport io.micronaut.core.async.subscriber.CompletionAwareSubscriber;\nimport io.micronaut.core.convert.ConversionService;\nimport java.util.ArrayList;\nimport java.util.List;\nimport java.util.concurrent.CompletableFuture;\nimport java.util.concurrent.CountDownLatch;\nimport java.util.concurrent.ExecutorService;\nimport java.util.concurrent.Executors;\nimport java.util.concurrent.TimeUnit;\nimport java.util.concurrent.atomic.AtomicBoolean;\nimport java.util.concurrent.atomic.AtomicInteger;\nimport java.util.concurrent.atomic.AtomicReference;\nimport java.util.function.Supplier;\nimport org.junit.jupiter.api.Test;\nimport org.reactivestreams.Publisher;\nimport org.reactivestreams.Subscriber;\nimport org.reactivestreams.Subscription;\n\npublic class Micronaut_core_reactiveTest {\n    @Test\n    void createsAndTransformsPublishers() {\n        AtomicInteger observed = new AtomicInteger();\n        Publisher<String> transformed = Publishers.onComplete(\n                Publishers.then(\n                        Publishers.map(Publishers.just(4), value -> \"value-\" + value),\n                        value -> observed.set(value.length())),\n                () -> CompletableFuture.completedFuture(null));\n\n        Collected<String> result = collect(transformed);\n\n        assertThat(result.values).containsExactly(\"value-4\");\n        assertThat(result.error).isNull();\n        assertThat(result.completed).isTrue();\n        assertThat(observed).hasValue(7);\n    }\n\n    @Test\n    void suppliesAValueForAnEmptyPublisherAndPropagatesErrors() {\n        Publisher<String> fallback = Publishers.mapOrSupplyEmpty(\n                Publishers.<Integer>empty(), new Publishers.MapOrSupplyEmpty<>() {\n                    @Override\n                    public String map(Integer value) {\n                        return \"mapped-\" + value;\n                    }\n\n                    @Override\n                    public String supplyEmpty() {\n                        return \"fallback\";\n                    }\n                });\n        IllegalStateException expected = new IllegalStateException(\"publisher-error\");\n\n        Collected<String> emptyResult = collect(fallback);\n        Collected<String> errorResult = collect(Publishers.just(expected));\n\n        assertThat(emptyResult.values).containsExactly(\"fallback\");\n        assertThat(emptyResult.error).isNull();\n        assertThat(emptyResult.completed).isTrue();\n        assertThat(errorResult.values).isEmpty();\n        assertThat(errorResult.error).isSameAs(expected);\n        assertThat(errorResult.completed).isFalse();\n    }\n\n    @Test\n    void publishesCompletedAndFailedCompletableFutures() {\n        AtomicBoolean supplierCalled = new AtomicBoolean();\n        Supplier<CompletableFuture<String>> supplier = () -> {\n            supplierCalled.set(true);\n            return CompletableFuture.completedFuture(\"future-value\");\n        };\n        Publisher<String> lazyPublisher = Publishers.fromCompletableFuture(supplier);\n\n        assertThat(supplierCalled).isFalse();\n        Collected<String> lazyResult = collect(lazyPublisher);\n\n        RuntimeException expected = new RuntimeException(\"future-error\");\n        Collected<String> failedResult = collect(\n                Publishers.fromCompletableFuture(CompletableFuture.failedFuture(expected)));\n\n        assertThat(supplierCalled).isTrue();\n        assertThat(lazyResult.values).containsExactly(\"future-value\");\n        assertThat(lazyResult.error).isNull();\n        assertThat(lazyResult.completed).isTrue();\n        assertThat(failedResult.values).isEmpty();\n        assertThat(failedResult.error).isSameAs(expected);\n    }\n\n    @Test\n    void runsAnAsyncSingleResultOnTheConfiguredExecutor() throws Exception {\n        ExecutorService executor = Executors.newSingleThreadExecutor();\n        try {\n            Publisher<String> publisher = new AsyncSingleResultPublisher<>(executor, () -> \"async-value\");\n            Collected<String> result = collect(publisher);\n\n            assertThat(result.values).containsExactly(\"async-value\");\n            assertThat(result.error).isNull();\n            assertThat(result.completed).isTrue();\n        } finally {\n            executor.shutdownNow();\n            assertThat(executor.awaitTermination(10, TimeUnit.SECONDS)).isTrue();\n        }\n    }\n\n    @Test\n    void identifiesAndRegistersReactiveTypes() {\n        List<String> reactiveTypeNames = Publishers.getReactiveTypeNames();\n        Publishers.registerReactiveSingle(RegisteredSingle.class);\n        Publishers.registerReactiveCompletable(RegisteredCompletable.class);\n\n        assertThat(reactiveTypeNames).contains(\"org.reactivestreams.Publisher\");\n        assertThat(Publishers.getKnownReactiveTypes()).contains(RegisteredSingle.class,\n                RegisteredCompletable.class);\n        assertThat(Publishers.getKnownSingleTypes()).contains(RegisteredSingle.class);\n        assertThat(Publishers.getKnownCompletableTypes()).contains(RegisteredCompletable.class);\n        assertThat(Publishers.isSingle(RegisteredSingle.class)).isTrue();\n        assertThat(Publishers.isCompletable(RegisteredCompletable.class)).isTrue();\n        assertThat(Publishers.isConvertibleToPublisher(RegisteredSingle.class)).isTrue();\n        assertThat(Publishers.isConvertibleToPublisher(String.class)).isFalse();\n    }\n\n    @Test\n    void convertsPublisherValuesAndRecognizesReactiveStreamTypes() {\n        Publisher<String> source = Publishers.just(\"source\");\n\n        assertThat(Publishers.isConvertibleToPublisher(source)).isTrue();\n        assertThat(Publishers.convertPublisher(source, Publisher.class)).isSameAs(source);\n        assertThat(Publishers.convertToPublisher(ConversionService.SHARED,\n                CompletableFuture.completedFuture(\"converted\")))\n                .satisfies(publisher -> assertThat(collect(publisher).values)\n                        .containsExactly(\"converted\"));\n\n        ReactiveStreamsTypeInformationProvider provider =\n                new ReactiveStreamsTypeInformationProvider();\n        assertThat(provider.isReactive(Publisher.class)).isTrue();\n        assertThat(provider.isSingle(Publisher.class)).isFalse();\n        assertThat(provider.isCompletable(Publisher.class)).isFalse();\n    }\n\n    @Test\n    void allowsOnlyOneSubscriberToSubscribeToAPublisher() {\n        ForwardingPublisher publisher = new ForwardingPublisher();\n        Collected<String> first = collect(publisher);\n        Collected<String> second = collect(publisher);\n\n        assertThat(first.values).containsExactly(\"forwarded\");\n        assertThat(first.error).isNull();\n        assertThat(first.completed).isTrue();\n        assertThat(publisher.hasSubscriber()).isTrue();\n        assertThat(second.values).isEmpty();\n        assertThat(second.error).isInstanceOf(IllegalStateException.class)\n                .hasMessage(\"Only one subscriber allowed\");\n    }\n\n    @Test\n    void forwardsValuesThroughASingleSubscriberProcessor() {\n        UpperCaseProcessor processor = new UpperCaseProcessor();\n        Collected<String> result = collectFromProcessor(processor);\n\n        Publishers.just(\"micronaut\").subscribe(processor);\n\n        assertThat(result.values).containsExactly(\"MICRONAUT\");\n        assertThat(result.error).isNull();\n        assertThat(result.completed).isTrue();\n    }\n\n    @Test\n    void reportsCompletionThroughCompletionAwareSubscriber() {\n        CompletionRecordingSubscriber subscriber = new CompletionRecordingSubscriber();\n        Publishers.just(\"value\").subscribe(subscriber);\n\n        assertThat(subscriber.values).containsExactly(\"value\");\n        assertThat(subscriber.isComplete()).isTrue();\n        assertThat(subscriber.error).isNull();\n    }\n\n    private static <T> Collected<T> collect(Publisher<T> publisher) {\n        Collected<T> result = new Collected<>();\n        publisher.subscribe(result);\n        result.await();\n        return result;\n    }\n\n    private static Collected<String> collectFromProcessor(UpperCaseProcessor processor) {\n        Collected<String> result = new Collected<>();\n        processor.subscribe(result);\n        return result;\n    }\n\n    private static final class Collected<T> implements Subscriber<T> {\n        private final List<T> values = new ArrayList<>();\n        private final CountDownLatch finished = new CountDownLatch(1);\n        private Throwable error;\n        private boolean completed;\n\n        @Override\n        public void onSubscribe(Subscription subscription) {\n            subscription.request(Long.MAX_VALUE);\n        }\n\n        @Override\n        public void onNext(T value) {\n            values.add(value);\n        }\n\n        @Override\n        public void onError(Throwable throwable) {\n            error = throwable;\n            finished.countDown();\n        }\n\n        @Override\n        public void onComplete() {\n            completed = true;\n            finished.countDown();\n        }\n\n        private void await() {\n            try {\n                assertThat(finished.await(10, TimeUnit.SECONDS)).isTrue();\n            } catch (InterruptedException exception) {\n                Thread.currentThread().interrupt();\n                throw new AssertionError(\"Interrupted while waiting for publisher\", exception);\n            }\n        }\n    }\n\n    private static final class ForwardingPublisher\n            extends io.micronaut.core.async.publisher.SingleSubscriberPublisher<String> {\n        @Override\n        protected void doSubscribe(Subscriber<? super String> subscriber) {\n            subscriber.onSubscribe(new Subscription() {\n                private boolean cancelled;\n\n                @Override\n                public void request(long count) {\n                    if (!cancelled && count > 0) {\n                        subscriber.onNext(\"forwarded\");\n                        subscriber.onComplete();\n                    }\n                }\n\n                @Override\n                public void cancel() {\n                    cancelled = true;\n                }\n            });\n        }\n\n        private boolean hasSubscriber() {\n            return currentSubscriber().isPresent();\n        }\n    }\n\n    private static final class UpperCaseProcessor\n            extends SingleSubscriberProcessor<String, String> {\n        @Override\n        protected void doSubscribe(Subscriber<? super String> subscriber) {\n        }\n\n        @Override\n        protected void doOnNext(String value) {\n            getSubscriber().onNext(value.toUpperCase());\n        }\n\n        @Override\n        protected void doOnError(Throwable throwable) {\n            getSubscriber().onError(throwable);\n        }\n\n        @Override\n        protected void doOnComplete() {\n            getSubscriber().onComplete();\n        }\n    }\n\n    private static final class CompletionRecordingSubscriber\n            extends CompletionAwareSubscriber<String> {\n        private final List<String> values = new ArrayList<>();\n        private Throwable error;\n\n        @Override\n        protected void doOnSubscribe(Subscription subscription) {\n            subscription.request(Long.MAX_VALUE);\n        }\n\n        @Override\n        protected void doOnNext(String value) {\n            values.add(value);\n        }\n\n        @Override\n        protected void doOnError(Throwable throwable) {\n            error = throwable;\n        }\n\n        @Override\n        protected void doOnComplete() {\n        }\n    }\n\n    private static final class RegisteredSingle {\n    }\n\n    private static final class RegisteredCompletable {\n    }\n}\n"}]}
