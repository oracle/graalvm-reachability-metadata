st/java/io_micronaut/micronaut_core_reactive/TypedSubscriberTest.java\", \"content\": \"/*\\n * Copyright and related rights waived via CC0\\n *\\n * You should have received a copy of the CC0 legalcode along with this\\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\\n */\\npackage io_micronaut.micronaut_core_reactive;\\n\\nimport static org.assertj.core.api.Assertions.assertThat;\\n\\nimport io.micronaut.core.async.publisher.Publishers;\\nimport io.micronaut.core.async.subscriber.TypedSubscriber;\\nimport io.micronaut.core.type.Argument;\\nimport java.util.ArrayList;\\nimport java.util.List;\\nimport org.junit.jupiter.api.Test;\\nimport org.reactivestreams.Subscription;\\n\\npublic class TypedSubscriberTest {\\n    @Test\\n    void receivesValuesWhileRetainingItsDeclaredType() {\\n        RecordingSubscriber subscriber = new RecordingSubscriber();\\n\\n        Publishers.just(\\\"reactive-value\\\").subscribe(subscriber);\\n\\n        assertThat(subscriber.getTypeArgument().getType()).isEqualTo(String.class);\\n        assertThat(subscriber.values).containsExactly(\\\"reactive-value\\\");\\n        assertThat(subscriber.error).isNull();\\n        assertThat(subscriber.complete).isTrue();\\n    }\\n\\n    private static final class RecordingSubscriber extends TypedSubscriber<String> {\\n        private final List<String> values = new ArrayList<>();\\n        private Throwable error;\\n        private boolean complete;\\n\\n        private RecordingSubscriber() {\\n            super(Argument.of(String.class));\\n        }\\n\\n        @Override\\n        protected void doOnSubscribe(Subscription subscription) {\\n            subscription.request(Long.MAX_VALUE);\\n        }\\n\\n        @Override\\n        protected void doOnNext(String value) {\\n            values.add(value);\\n        }\\n\\n        @Override\\n        protected void doOnError(Throwable throwable) {\\n            error = throwable;\\n        }\\n\\n        @Override\\n        protected void doOnComplete() {\\n            complete = true;\\n        }\\n    }\\n}\\n\"}\n24934:[tool-exec] start id=call_F2NafQclmz6feoPXBoKWN8qF|fc_0909587d805e6a37016abf7bdf174887d1bd2ffe1d8190e14b name=read args={\"path\": \"tests/src/io.micronaut/micronaut-core-reactive/5.1.3/src/test/java/io_micronaut/micronaut_core_reactive/TypedSubscriberTest.java\"}\n24935:[tool-exec] start id=call_4paeeVrbBUezv41WLhsE1d9s|fc_0909587d805e6a37016abf7bdf175887d1aa8ab345ccdd78b6 name=bash args={\"command\": \"git status --short && git diff -- tests/src/io.micronaut/micronaut-core-reactive/5.1.3/src/test/java/io_micronaut/micronaut_core_reactive/Micronaut_core_reactiveTest.java\"}\n24936:[tool-exec] start id=call_YJolDHszrkgedJslzg0QvicN|fc_0909587d805e6a37016abf7bdf176087d1bb64b662f709c675 name=bash args={\"command\": \"awk 'length($0) > 100 {print NR \\\":\\\" length($0)}' tests/src/io.micronaut/micronaut-core-reactive/5.1.3/src/test/java/io_micronaut/micronaut_core_reactive/TypedSubscriberTest.java\"}\n26544:[tool-exec] start id=call_fX23OEMweXjrpR3CrLJsFJLU|fc_0909587d805e6a37016abf7c5b316887d1af74e33bde4a9ac5 name=bash args={\"command\": \"git status --short && git diff -- tests/src/io.micronaut/micronaut-core-reactive/5.1.3/src/test/java/io_micronaut/micronaut_core_reactive/Micronaut_core_reactiveTest.java tests/src/io.micronaut/micronaut-core-reactive/5.1.3/src/test/java/io_micronaut/micronaut_core_reactive/TypedSubscriberTest.java metadata/io.micronaut/micronaut-core-reactive/5.1.3/reachability-metadata.json\", \"timeout\": 10}\n26545:[tool-exec] start id=call_BmbEeNtpwFKlBmOh30aWhxHY|fc_0909587d805e6a37016abf7c5b318087d180c791b1b292dac2 name=read args={\"path\": \"docs/functional-spec/test-contract.md\", \"offset\": 1, \"limit\": 2000}\n26546:[tool-exec] start id=call_lTAonGkwPPFsMTeJ2OIdi7tF|fc_0909587d805e6a37016abf7c5b319087d18b86015b46fe3ba1 name=read args={\"path\": \"tests/src/io.micronaut/micronaut-core-reactive/5.1.3/src/test/java/io_micronaut/micron