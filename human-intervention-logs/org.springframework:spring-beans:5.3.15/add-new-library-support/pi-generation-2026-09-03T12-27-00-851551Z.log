  +
  +public class AutowireUtilsTest {
  +    @Test
  +    void createsInterfaceProxyForObjectFactory() {
  +        ObjectFactory<Greeting> factory = new GreetingFactory();
  +
  +        Object value = AutowireUtils.resolveAutowiringValue(factory, Greeting.class);
