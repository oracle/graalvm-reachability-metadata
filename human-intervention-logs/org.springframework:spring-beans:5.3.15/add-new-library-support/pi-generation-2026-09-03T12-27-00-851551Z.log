              if ((JavaVersion.current().majorVersion as int) < 24) {
                  buildArgs.addAll(securityManagerArgs)
              }
          }
      }
  
      agent {
          defaultMode = "conditional"
          modes {
              conditional {
                  userCodeFilterPath = "user-code-filter.json"
              }
          }
      }
  }
  
  tasks.withType(JavaCompile).configureEach {
      options.release = 21
  }
  
