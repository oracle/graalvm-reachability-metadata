  		if (!CollectionUtils.isEmpty(processors)) {
  			filteredPostProcessors = new ArrayList<>(processors.size());
  			for (DestructionAwareBeanPostProcessor processor : processors) {
  				if (processor.requiresDestruction(bean)) {
