rtj.core.api.Assertions.assertThat;\n\nimport java.util.ArrayList;\nimport java.util.List;\n\nimport org.junit.jupiter.api.Test;\nimport org.springframework.util.SerializationUtils;\n\n/** Verifies Spring's serialization round trip. */\n@SuppressWarnings(\"deprecation\")\npublic class SerializationUtilsTest {\n    @Test\n    void serializesAndDeserializesSerializableValue() {\n        List<String> original = new ArrayList<>();\n        original.add(\"spring\");\n        original.add(\"core\");\n\n        byte[] bytes = SerializationUtils.serialize(original);\n        Object restored = SerializationUtils.deserialize(bytes);\n\n        assertThat(bytes).isNotEmpty();\n        assertThat(restored).isEqualTo(original);\n    }\n}\n=== tests/src/org.springframework/spring-core/5.3.15/src/test/java/org_springframework/spring_core/SunReflectionFactoryHelperTest.java\n/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_springframework.spring_core;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.io.Serializable;\n\nimport org.junit.jupiter.api.Test;\nimport org.springframework.objenesis.instantiator.sun.SunReflectionFactoryInstantiator;\n\n/** Verifies serialization-constructor creation through Objenesis' reflection factory helper. */\npublic class SunReflectionFactoryHelperTest {\n    @Test\n    void createsInstanceWithoutCallingConstructor() {\n        SunReflectionFactoryInstantiator<Fixture> instantiator =\n                new SunReflectionFactoryInstantiator<>(Fixture.class);\n\n        Fixture fixture = instantiator.newInstance();\n\n        assertThat(fixture.value).isNull();\n    }\n\n    public static final class Fixture implements Serializable {\n        private static final long serialVersionUID = 1L;\n\n        private final String value;\n\n        public Fixture() {\n 