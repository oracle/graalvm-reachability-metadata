                      self._print_dynamic_access_message("Coverage not improved. Keeping generated tests by request.")
                      self._mark_continuation_explore_completed(
                          prompt_iterations,
                          exhausted_classes,
                          len(terminal_classes_this_part),
                      )
                      return True, prompt_iterations
  
