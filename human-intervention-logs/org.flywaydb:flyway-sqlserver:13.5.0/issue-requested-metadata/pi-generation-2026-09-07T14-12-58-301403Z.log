n        // Wait until connection can be established\n        Awaitility.await().atMost(Duration.ofMinutes(1)).ignoreExceptions().until(() -> {\n            getDataSource().getConnection().close();\n            return true;\n        });\n        System.out.println(\"MSSQL started\");\n    }\n\n    @AfterAll\n    static void tearDown() {\n        if (process != null && process.isAlive()) {\n            System.out.println(\"Shutting down MSSQL\");\n            process.destroy();\n        }\n    }\n\n    @Test\n    void migrate() {\n        DataSource dataSource = getDataSource();\n\n        Flyway flyway = Flyway.configure()\n                .configuration(Map.of(\n                        \"flyway.sqlserver.kerberos.login.file\", KERBEROS_LOGIN_FILE))\n                .dataSource(dataSource)\n                .encoding(StandardCharsets.UTF_8)\n                .resourceProvider(new FixedResourceProvider())\n                .load();\n        SQLServerConfigurationExtension sqlServerConfiguration =\n                flyway.getConfigurationExtension(SQLServerConfigurationExtension.class);\n\n        assertThat(sqlServerConfiguration.getKerberos().getLogin().getFile())\n                .isEqualTo(KERBEROS_LOGIN_FILE);\n        assertThat(flyway.getConfiguration().getDryRunOutput()).isNull();\n\n        MigrateResult migration = flyway.migrate();\n\n        assertThat(migration.success).isTrue();\n        assertThat(migration.migrationsExecuted).isEqualTo(2);\n    }\n\n    private static DataSource getDataSource() {\n        SQLServerDataSource dataSource = new SQLServerDataSource();\n        dataSource.setURL(JDBC_URL);\n        dataSource.setUser(USERNAME);\n        dataSource.setPassword(PASSWORD);\n        return dataSource;\n    }\n\n}\n"}], "isError": false, "timestamp": 1788790725509}}
