  package flyway.sqlserver;
  
  import java.util.Map;
  
  import org.flywaydb.core.Flyway;
  import org.flywaydb.core.api.configuration.FluentConfiguration;
  import org.flywaydb.database.sqlserver.SQLServerConfigurationExtension;
  import org.junit.jupiter.api.Test;
  
  import static org.assertj.core.api.Assertions.assertThat;
  
  public class FlywaySqlServerConfigurationTests {
  
      @Test
      void loadCopiesNestedSqlServerConfiguration() {
          FluentConfiguration configuration = Flyway.configure()
                  .configuration(Map.of(
                          "flyway.sqlserver.kerberos.login.file",
                          "sqlserver-login.conf"))
                  .table("custom_schema_history");
  
          Flyway flyway = configuration.load();
          SQLServerConfigurationExtension sqlServerConfiguration =
                  flyway.getConfigurationExtension(SQLServerConfigurationExtension.class);
  
          assertThat(flyway.getConfiguration().getTable()).isEqualTo("custom_schema_history");
          assertThat(sqlServerConfiguration.getKerberos().getLogin().getFile())
                  .isEqualTo("sqlserver-login.conf");
      }
  }
