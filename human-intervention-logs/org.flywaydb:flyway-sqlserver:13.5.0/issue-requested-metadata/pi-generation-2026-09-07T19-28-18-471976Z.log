  diff --git a/tests/src/org.flywaydb/flyway-core/13.5.0/src/test/java/flyway/EncryptionUtilsTest.java b/tests/src/org.flywaydb/flyway-core/13.5.0/src/test/java/flyway/EncryptionUtilsTest.java
  new file mode 100644
