/function/Supplier;\n        35: invokestatic  #136                // Method org/springframework/util/Assert.state:(ZLjava/util/function/Supplier;)V\n        38: aload_0\n        39: getfield      #113                // Field chmod:Ljava/lang/Integer;\n        42: ifnull        68\n        45: aload_0\n        46: invokevirtual #100                // Method isChmodCapable:()Z\n        49: ifeq          68\n        52: aload_0\n        53: aload_0\n        54: getfield      #20                 // Field remoteFileTemplate:Lorg/springframework/integration/file/remote/RemoteFileTemplate;\n        57: aload_2\n        58: aload_0\n        59: getfield      #113                // Field chmod:Ljava/lang/Integer;\n        62: invokevirtual #140                // Method java/lang/Integer.intValue:()I\n        65: invokevirtual #144                // Method doChmod:(Lorg/springframework/integration/file/remote/RemoteFileTemplate;Ljava/lang/String;I)V\n        68: return\n\n  protected void doChmod(org.springframework.integration.file.remote.RemoteFileTemplate<F>, java.lang.String, int);\n    Code:\n         0: return\n\n  private static java.lang.String lambda$handleMessageInternal$0(org.springframework.messaging.Message);\n    Code:\n         0: aload_0\n         1: invokestatic  #148                // Method java/lang/String.valueOf:(Ljava/lang/Object;)Ljava/lang/String;\n         4: invokedynamic #153,  0            // InvokeDynamic #1:makeConcatWithConstants:(Ljava/lang/String;)Ljava/lang/String;\n         9: areturn\n}\n"}], "isError": false, "timestamp": 1788982389854}, {"role": "toolResult", "toolCallId": "call_nw8XH4aqokPAfOBZEQc4qnVT|fc_04d6f84bcd30c640016aa1b475004c87d281cf07fb61f37ca1", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_springframework_integration.spring_integration_sftp;\n\nimport java.io.ByteArrayOutputStream;\nimport java.io.IOException;\nimport java.nio.charset.StandardCharsets;\nimport java.nio.file.Path;\nimport java.util.List;\n\nimport org.apache.sshd.common.file.virtualfs.VirtualFileSystemFactory;\nimport org.apache.sshd.server.SshServer;\nimport org.apache.sshd.server.keyprovider.SimpleGeneratorHostKeyProvider;\nimport org.apache.sshd.sftp.client.SftpClient.DirEntry;\nimport org.apache.sshd.sftp.server.SftpSubsystemFactory;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.io.TempDir;\nimport org.springframework.expression.common.LiteralExpression;\nimport org.springframework.integration.file.FileHeaders;\nimport org.springframework.integration.file.support.FileExistsMode;\nimport org.springframework.integration.sftp.filters.SftpRegexPatternFileListFilter;\nimport org.springframework.integration.sftp.filters.SftpSimplePatternFileListFilter;\nimport org.springframework.integration.sftp.outbound.SftpMessageHandler;\nimport org.springframework.integration.sftp.session.DefaultSftpSessionFactory;\nimport org.springframework.integration.sftp.session.SftpFileInfo;\nimport org.springframework.integration.sftp.session.SftpRemoteFileTemplate;\nimport org.springframework.messaging.support.MessageBuilder;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\npublic class Spring_integration_sftpTest {\n\n    private static final String USERNAME = \"sftp-user\";\n\n    private static final String PASSWORD = \"sftp-password\";\n\n    @Test\n    void remoteFileTemplateTransfersAppendsListsRenamesAndRemovesFiles(@TempDir Path sftpRoot) throws Exception {\n        SshServer server = startServer(sftpRoot);\n        DefaultSftpSessionFactory sessionFactory = sessionFactory(server);\n        try {\n            SftpRemoteFileTemplate template = remoteFileTemplate(sessionFactory);\n            String remotePath = \"/outgoing/report.txt\";\n\n            String uploaded = template.send(MessageBuilder.withPayload(\"first\".getBytes(StandardCharsets.UTF_8))\n                    .setHeader(FileHeaders.FILENAME, \"report.txt\")\n                    .build(), \"outgoing\", FileExistsMode.REPLACE);\n            template.append(MessageBuilder.withPayload(\" second\".getBytes(StandardCharsets.UTF_8)).build(), remotePath);\n\n            ByteArrayOutputStream downloaded = new ByteArrayOutputStream();\n            assertThat(template.get(remotePath, input -> downloaded.writeBytes(input.readAllBytes()))).isTrue();\n            assertThat(downloaded.toString(StandardCharsets.UTF_8)).isEqualTo(\"first second\");\n            assertThat(uploaded).endsWith(\"outgoing/report.txt\");\n\n            DirEntry[] entries = template.list(\"/outgoing\");\n            List<DirEntry> textFiles = new SftpSimplePatternFileListFilter(\"*.txt\").filterFiles(entries);\n            List<DirEntry> reportFiles = new SftpRegexPatternFileListFilter(\"report\\\\.txt\").filterFiles(entries);\n            SftpFileInfo fileInfo = new SftpFileInfo(textFiles.get(0));\n\n            assertThat(textFiles).extracting(DirEntry::getFilename).containsExactly(\"report.txt\");\n            assertThat(reportFiles).extracting(DirEntry::getFilename).containsExactly(\"report.txt\");\n            assertThat(fileInfo.getFilename()).isEqualTo(\"report.txt\");\n            assertThat(fileInfo.getSize()).isEqualTo(\"first second\".getBytes(StandardCharsets.UTF_8).length);\n            assertThat(fileInfo.getModified()).isPositive();\n            assertThat(fileInfo.isDirectory()).isFalse();\n\n            template.rename(remotePath, \"/outgoing/archive.txt\");\n            assertThat(template.exists(\"/outgoing/archive.txt\")).isTrue();\n            assertThat(template.remove(\"/outgoing/archive.txt\")).isTrue();\n            assertThat(template.exists(\"/outgoing/archive.txt\")).isFalse();\n        } finally {\n            sessionFactory.destroy();\n            server.stop(true);\n        }\n    }\n\n    @Test\n    void outboundMessageHandlerCreatesDirectoryAndWritesMessagePayload(@TempDir Path sftpRoot) throws Exception {\n        SshServer server = startServer(sftpRoot);\n        DefaultSftpSessionFactory sessionFactory = sessionFactory(server);\n        try {\n            SftpMessageHandler handler = new SftpMessageHandler(sessionFactory);\n            handler.setAutoCreateDirectory(true);\n            handler.setRemoteDirectoryExpression(new LiteralExpression(\"/adapter\"));\n            handler.setFileNameGenerator(message -> \"handled.txt\");\n            handler.afterPropertiesSet();\n\n            handler.handleMessage(MessageBuilder.withPayload(\"handled\".getBytes(StandardCharsets.UTF_8)).build());\n\n            SftpRemoteFileTemplate template = remoteFileTemplate(sessionFactory);\n            ByteArrayOutputStream downloaded = new ByteArrayOutputStream();\n            assertThat(template.get(\"/adapter/handled.txt\", input -> downloaded.writeBytes(input.readAllBytes())))\n                    .isTrue();\n            assertThat(downloaded.toString(StandardCharsets.UTF_8)).isEqualTo(\"handled\");\n            assertThat(handler.getComponentType()).isEqualTo(\"sftp:outbound-channel-adapter\");\n        } finally {\n            sessionFactory.destroy();\n            server.stop(true);\n        }\n    }\n\n    private static SshServer startServer(Path sftpRoot) throws IOException {\n        SshServer server = SshServer.setUpDefaultServer();\n        server.setHost(\"127.0.0.1\");\n        server.setPort(0);\n        server.setKeyPairProvider(new SimpleGeneratorHostKeyProvider(sftpRoot.resolve(\"host-key\")));\n        server.setPasswordAuthenticator((username, password, session) -> USERNAME.equals(username)\n                && PASSWORD.equals(password));\n        server.setFileSystemFactory(new VirtualFileSystemFactory(sftpRoot));\n        server.setSubsystemFactories(List.of(new SftpSubsystemFactory.Builder().build()));\n        server.start();\n        return server;\n    }\n\n    private static DefaultSftpSessionFactory sessionFactory(SshServer server) {\n        DefaultSftpSessionFactory sessionFactory = new DefaultSftpSessionFactory();\n        sessionFactory.setHost(\"127.0.0.1\");\n        sessionFactory.setPort(server.getPort());\n        sessionFactory.setUser(USERNAME);\n        sessionFactory.setPassword(PASSWORD);\n        sessionFactory.setAllowUnknownKeys(true);\n        sessionFactory.setTimeout(10_000);\n        return sessionFactory;\n    }\n\n    private static SftpRemoteFileTemplate remoteFileTemplate(DefaultSftpSessionFactory sessionFactory) {\n        SftpRemoteFileTemplate template = new SftpRemoteFileTemplate(sessionFactory);\n        template.setAutoCreateDirectory(true);\n        template.setRemoteDirectoryExpression(new LiteralExpression(\"/\"));\n        template.afterPropertiesSet();\n        return template;\n    }\n}\n"}], "isError": false, "timestamp": 1788982389854}]}
