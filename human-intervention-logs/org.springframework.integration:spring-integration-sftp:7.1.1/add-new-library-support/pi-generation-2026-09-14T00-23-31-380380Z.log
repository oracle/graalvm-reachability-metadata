  +        List<E> matchingEvents = events.stream()
  +                .filter(eventType::isInstance)
  +                .map(eventType::cast)
  +                .toList();
  +        assertThat(matchingEvents).hasSize(1);
  +        return matchingEvents.get(0);
  +    }
