     269	    private static void withSftpServer(
     270	            Path testDirectory, SftpSubsystemFactory subsystemFactory, SftpScenario scenario) throws Exception {
     271	        Path remoteRoot = Files.createDirectories(testDirectory.resolve("remote-root"));
     272	        SimpleGeneratorHostKeyProvider hostKeyProvider =
     273	                new SimpleGeneratorHostKeyProvider(testDirectory.resolve("host-key.pem"));
     274	        hostKeyProvider.setAlgorithm(KeyUtils.RSA_ALGORITHM);
     275	        hostKeyProvider.setKeySize(2048);
     276	
     277	        SshServer server = SshServer.setUpDefaultServer();
     278	        server.setHost("127.0.0.1");
     279	        server.setPort(0);
     280	        server.setKeyPairProvider(hostKeyProvider);
     281	        server.setPasswordAuthenticator(
     282	                (username, password, session) -> USERNAME.equals(username) && PASSWORD.equals(password));
     283	        server.setSubsystemFactories(List.of(subsystemFactory));
     284	        server.setFileSystemFactory(new VirtualFileSystemFactory(remoteRoot));
     285	
     286	        DefaultSftpSessionFactory sessionFactory = null;
     287	        try {
     288	            server.start();
     289	            sessionFactory = new DefaultSftpSessionFactory();
     290	            sessionFactory.setHost("127.0.0.1");
     291	            sessionFactory.setPort(server.getPort());
     292	            sessionFactory.setUser(USERNAME);
     293	            sessionFactory.setPassword(PASSWORD);
     294	            sessionFactory.setAllowUnknownKeys(true);
     295	            sessionFactory.setTimeout(IO_TIMEOUT_MILLIS);
     296	            scenario.run(remoteRoot, sessionFactory);
     297	        } finally {
     298	            if (sessionFactory != null) {
     299	                sessionFactory.destroy();
     300	            }
     301	            if (server.isStarted()) {
     302	                server.stop(true);
     303	            }
     304	        }
     305	    }
