> events = new CopyOnWriteArrayList<>();\n   181\t        ApacheMinaSftpEventListener eventListener = new ApacheMinaSftpEventListener();\n   182\t        eventListener.setApplicationEventPublisher(event -> events.add((ApacheMinaSftpEvent) event));\n   183\t        eventListener.afterPropertiesSet();\n   184\t\n   185\t        SftpSubsystemFactory subsystemFactory = new SftpSubsystemFactory();\n   186\t        subsystemFactory.addSftpEventListener(eventListener);\n   187\t        byte[] payload = \"event payload\".getBytes(StandardCharsets.UTF_8);\n   188\t\n   189\t        withSftpServer(testDirectory, subsystemFactory, (remoteRoot, sessionFactory) -> {\n   190\t            try (Session<SftpClient.DirEntry> session = sessionFactory.getSession()) {\n   191\t                assertThat(session.mkdir(\"/events\")).isTrue();\n   192\t                session.write(new ByteArrayInputStream(payload), \"/events/original.txt\");\n   193\t                session.rename(\"/events/original.txt\", \"/events/renamed.txt\");\n   194\t                assertThat(session.remove(\"/events/renamed.txt\")).isTrue();\n   195\t                assertThat(session.rmdir(\"/events\")).isTrue();\n   196\t            }\n   197\t        });\n   198\t\n   199\t        SessionOpenedEvent openedEvent = onlyEvent(events, SessionOpenedEvent.class);\n   200\t        assertThat(openedEvent.getClientVersion()).isGreaterThanOrEqualTo(3);\n   201\t        DirectoryCreatedEvent createdEvent = onlyEvent(events, DirectoryCreatedEvent.class);\n   202\t        assertThat(createdEvent.getPath().getFileName().toString()).isEqualTo(\"events\");\n   203\t\n   204\t        List<FileWrittenEvent> writtenEvents = events.stream()\n   205\t                .filter(FileWrittenEvent.class::isInstance)\n   206\t                .map(FileWrittenEvent.class::cast)\n   207\t                .toList();\n   208\t        assertThat(writtenEvents).isNotEmpty();\n   209\t        assertThat(writtenEvents).allSatisfy(event ->\n   210\t                assertThat(event.getFile().getFileName().toString()).isEqualTo(\"original.txt\"));\n   211\t        assertThat(writtenEvents.stream().mapToInt(FileWrittenEvent::getDataLen).sum()).isEqualTo(payload.length);\n   212\t\n   213\t        PathMovedEvent movedEvent = onlyEvent(events, PathMovedEvent.class);\n   214\t        assertThat(movedEvent.getSrcPath().getFileName().toString()).isEqualTo(\"original.txt\");\n   215\t        assertThat(movedEvent.getDstPath().getFileName().toString()).isEqualTo(\"renamed.txt\");\n   216\t\n   217\t        List<PathRemovedEvent> removedEvents = events.stream()\n   218\t                .filter(PathRemovedEvent.class::isInstance)\n   219\t                .map(PathRemovedEvent.class::cast)\n   220\t                .toList();\n   221\t        PathRemovedEvent removedFile = removedEvents.stream()\n   222\t                .filter(event -> !event.isDirectory())\n   223\t                .findFirst()\n   224\t                .orElseThrow();\n   225\t        assertThat(removedFile.getPath().getFileName().toString()).isEqualTo(\"renamed.txt\");\n   226\t        PathRemovedEvent removedDirectory = removedEvents.stream()\n   227\t                .filter(PathRemovedEvent::isDirectory)\n   228\t                .findFirst()\n   229\t                .orElseThrow();\n   230\t        assertThat(removedDirectory.getPath().getFileName().toString()).isEqualTo(\"events\");\n   231\t\n   232\t        SessionClosedEvent closedEvent = onlyEvent(events, SessionClosedEvent.class);\n   233\t        assertThat(closedEvent.getSession()).isSameAs(openedEvent.getSession());\n   234\t    }\n   235\t\n   236\t    private static <E extends ApacheMinaSftpEvent> E onlyEvent(\n   237\t            List<ApacheMinaSftpEvent> events, Class<E> eventType) {\n   238\t        List<E> matchingEvents = events.stream()\n   239\t                .filter(eventType::isInstance)\n   240\t                .map(eventType::cast)\n   241\t                .toList();\n   242\t        assertThat(matchingEvents).hasSize(1);\n   243\t        return matchingEvents.get(0);\n   244\t    }\n   245\t\n   246\t    private static void initialize(SftpMessageHandler handler, String beanName) {\n   247\t        handler.setBeanName(beanName);\n   248\t        handler.setBeanFactory(integrationBeanFactory());\n   249\t        handler.afterPropertiesSet();\n   250\t    }\n   251\t\n   252\t    private static void initialize(SftpOutboundGateway gateway, String beanName) {\n   253\t        gateway.setBeanName(beanName);\n   254\t        gateway.setBeanFactory(integrationBeanFactory());\n   255\t        gateway.afterPropertiesSet();\n   256\t    }\n   257\t\n   258\t    private static DefaultListableBeanFactory integrationBeanFactory() {\n   259\t        DefaultListableBeanFactory beanFactory = new DefaultListableBeanFactory();\n   260\t        beanFactory.registerSingleton(\n   261\t                IntegrationContextUtils.INTEGRATION_EVALUATION_CONTEXT_BEAN_NAME, new StandardEvaluationContext());\n   262\t        return beanFactory;\n   263\t    }\n   264\t\n   265\t    private static void withSftpServer(Path testDirectory, SftpScenario scenario) throws Exception {\n   266\t        withSftpServer(testDirectory, new SftpSubsystemFactory(), scenario);\n   267\t    }\n   268\t\n   269\t    private static void withSftpServer(\n   270\t            Path testDirectory, SftpSubsystemFactory subsystemFactory, SftpScenario scenario) throws Exception {\n   271\t        Path remoteRoot = Files.createDirectories(testDirectory.resolve(\"remote-root\"));\n   272\t        SimpleGeneratorHostKeyProvider hostKeyProvider =\n   273\t                new SimpleGeneratorHostKeyProvider(testDirectory.resolve(\"host-key.pem\"));\n   274\t        hostKeyProvider.setAlgorithm(KeyUtils.RSA_ALGORITHM);\n   275\t        hostKeyProvider.setKeySize(2048);\n   276\t\n   277\t        SshServer server = SshServer.setUpDefaultServer();\n   278\t        server.setHost(\"127.0.0.1\");\n   279\t        server.setPort(0);\n   280\t        server.setKeyPairProvider(hostKeyProvider);\n   281\t        server.setPasswordAuthenticator(\n   282\t                (username, password, session) -> USERNAME.equals(username) && PASSWORD.equals(password));\n   283\t        server.setSubsystemFactories(List.of(subsystemFactory));\n   284\t        server.setFileSystemFactory(new VirtualFileSystemFactory(remoteRoot));\n   285\t\n   286\t        DefaultSftpSessionFactory sessionFactory = null;\n   287\t        try {\n   288\t            server.start();\n   289\t            sessionFactory = new DefaultSftpSessionFactory();\n   290\t            sessionFactory.setHost(\"127.0.0.1\");\n   291\t            sessionFactory.setPort(server.getPort());\n   292\t            sessionFactory.setUser(USERNAME);\n   293\t            sessionFactory.setPassword(PASSWORD);\n   294\t            sessionFactory.setAllowUnknownKeys(true);\n   295\t            sessionFactory.setTimeout(IO_TIMEOUT_MILLIS);\n   296\t            scenario.run(remoteRoot, sessionFactory);\n   297\t        } finally {\n   298\t            if (sessionFactory != null) {\n   299\t                sessionFactory.destroy();\n   300\t            }\n   301\t            if (server.isStarted()) {\n   302\t                server.stop(true);\n   303\t            }\n   304\t        }\n   305\t    }\n   306\t\n   307\t    @FunctionalInterface\n   308\t    private interface SftpScenario {\n   309\t\n   310\t        void run(Path remoteRoot, DefaultSftpSessionFactory sessionFactory) throws Exception;\n"}], "isError": false, "timestamp": 1789346619089}, {"role": "toolResult", "toolCallId": "call_AOmsnEi71F9HNJ6tMs4T8tDU|fc_02552d28c6ca754f016aa7433a737c87d2a37db9edc3b2e2c7", "toolName": "bash", "content": [{"type": "text", "text": "(no output)"}], "isError": false, "timestamp": 1789346619089}]}
