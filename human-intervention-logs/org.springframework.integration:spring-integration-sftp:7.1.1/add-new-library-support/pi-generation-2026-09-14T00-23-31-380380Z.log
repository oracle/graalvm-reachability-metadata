  	}
  
  	void connect() {
  		try {
  			if (!this.sftpClient.isOpen()) {
  				Duration initializationTimeout =
  						SftpModuleProperties.SFTP_CHANNEL_OPEN_TIMEOUT.getRequired(this.sftpClient.getSession());
