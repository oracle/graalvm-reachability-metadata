  		}
  		else if (!directoryPath.endsWith(this.remoteFileSeparator)) {
  			return directoryPath + this.remoteFileSeparator;
  		}
  		else {
  			return directoryPath;
  		}
  	}
  
  	private record StreamHolder(InputStream stream, String name) {
  
  	}
  
