  plugins {
      id "org.graalvm.internal.tck"
  }
  
  String libraryVersion = tck.testedLibraryVersion.get()
  
  dependencies {
      testImplementation "org.springframework.integration:spring-integration-sftp:$libraryVersion"
      testImplementation 'org.assertj:assertj-core:3.22.0'
  }
  
  graalvmNative {
      binaries {
          test {
              buildArgs("--initialize-at-build-time=org.apache.sshd.common.file.root.RootedFileSystemProvider")
              buildArgs("--initialize-at-build-time=org.apache.sshd.sftp.client.fs.SftpFileSystemProviderFacade")
              buildArgs("--initialize-at-build-time=org.slf4j.helpers.NOPLogger")
          }
      }
      agent {
          defaultMode = "conditional"
          modes {
              conditional {
                  userCodeFilterPath = "user-code-filter.json"
              }
          }
      }
  }
