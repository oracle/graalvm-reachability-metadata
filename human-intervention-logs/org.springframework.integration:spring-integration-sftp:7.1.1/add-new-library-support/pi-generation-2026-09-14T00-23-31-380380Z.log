     177	    @Test
     178	    @Timeout(59)
     179	    void sftpServerEventsArePublishedAsSpringApplicationEvents(@TempDir Path testDirectory) throws Exception {
     180	        List<ApacheMinaSftpEvent> events = new CopyOnWriteArrayList<>();
     181	        ApacheMinaSftpEventListener eventListener = new ApacheMinaSftpEventListener();
     182	        eventListener.setApplicationEventPublisher(event -> events.add((ApacheMinaSftpEvent) event));
     183	        eventListener.afterPropertiesSet();
     184	
     185	        SftpSubsystemFactory subsystemFactory = new SftpSubsystemFactory();
     186	        subsystemFactory.addSftpEventListener(eventListener);
     187	        byte[] payload = "event payload".getBytes(StandardCharsets.UTF_8);
     188	
     189	        withSftpServer(testDirectory, subsystemFactory, (remoteRoot, sessionFactory) -> {
     190	            try (Session<SftpClient.DirEntry> session = sessionFactory.getSession()) {
     191	                assertThat(session.mkdir("/events")).isTrue();
     192	                session.write(new ByteArrayInputStream(payload), "/events/original.txt");
     193	                session.rename("/events/original.txt", "/events/renamed.txt");
     194	                assertThat(session.remove("/events/renamed.txt")).isTrue();
     195	                assertThat(session.rmdir("/events")).isTrue();
     196	            }
     197	        });
     198	
     199	        SessionOpenedEvent openedEvent = onlyEvent(events, SessionOpenedEvent.class);
     200	        assertThat(openedEvent.getClientVersion()).isGreaterThanOrEqualTo(3);
     201	        DirectoryCreatedEvent createdEvent = onlyEvent(events, DirectoryCreatedEvent.class);
     202	        assertThat(createdEvent.getPath().getFileName().toString()).isEqualTo("events");
     203	
     204	        List<FileWrittenEvent> writtenEvents = events.stream()
     205	                .filter(FileWrittenEvent.class::isInstance)
     206	                .map(FileWrittenEvent.class::cast)
     207	                .toList();
     208	        assertThat(writtenEvents).isNotEmpty();
     209	        assertThat(writtenEvents).allSatisfy(event ->
     210	                assertThat(event.getFile().getFileName().toString()).isEqualTo("original.txt"));
     211	        assertThat(writtenEvents.stream().mapToInt(FileWrittenEvent::getDataLen).sum()).isEqualTo(payload.length);
     212	
     213	        PathMovedEvent movedEvent = onlyEvent(events, PathMovedEvent.class);
     214	        assertThat(movedEvent.getSrcPath().getFileName().toString()).isEqualTo("original.txt");
     215	        assertThat(movedEvent.getDstPath().getFileName().toString()).isEqualTo("renamed.txt");
     216	
     217	        List<PathRemovedEvent> removedEvents = events.stream()
     218	                .filter(PathRemovedEvent.class::isInstance)
     219	                .map(PathRemovedEvent.class::cast)
     220	                .toList();
     221	        PathRemovedEvent removedFile = removedEvents.stream()
     222	                .filter(event -> !event.isDirectory())
     223	                .findFirst()
     224	                .orElseThrow();
     225	        assertThat(removedFile.getPath().getFileName().toString()).isEqualTo("renamed.txt");
     226	        PathRemovedEvent removedDirectory = removedEvents.stream()
     227	                .filter(PathRemovedEvent::isDirectory)
     228	                .findFirst()
     229	                .orElseThrow();
     230	        assertThat(removedDirectory.getPath().getFileName().toString()).isEqualTo("events");
     231	
     232	        SessionClosedEvent closedEvent = onlyEvent(events, SessionClosedEvent.class);
     233	        assertThat(closedEvent.getSession()).isSameAs(openedEvent.getSession());
     234	    }
     235	
     236	    private static <E extends ApacheMinaSftpEvent> E onlyEvent(
     237	            List<ApacheMinaSftpEvent> events, Class<E> eventType) {
     238	        List<E> matchingEvents = events.stream()
     239	                .filter(eventType::isInstance)
     240	                .map(eventType::cast)
     241	                .toList();
     242	        assertThat(matchingEvents).hasSize(1);
     243	        return matchingEvents.get(0);
     244	    }
