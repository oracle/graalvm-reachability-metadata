  package org_springframework_integration.spring_integration_sftp;
  
  import static org.assertj.core.api.Assertions.assertThat;
  
  import java.nio.charset.StandardCharsets;
  
  import org.junit.jupiter.api.Test;
  import org.springframework.beans.factory.support.DefaultListableBeanFactory;
  import org.springframework.beans.factory.xml.XmlBeanDefinitionReader;
  import org.springframework.core.io.ByteArrayResource;
  
  public class SftpNamespaceHandlerTest {
  
      @Test
      void parsesOutboundChannelAdapterNamespaceConfiguration() {
          String configuration = """
                  <beans xmlns="http://www.springframework.org/schema/beans"
                         xmlns:int="http://www.springframework.org/schema/integration"
                         xmlns:int-sftp="http://www.springframework.org/schema/integration/sftp">
                      <int:channel id="input"/>
                      <bean id="sessionFactory"
                            class="org.springframework.integration.sftp.session.DefaultSftpSessionFactory"/>
                      <int-sftp:outbound-channel-adapter id="sftpAdapter" channel="input"
                              session-factory="sessionFactory" remote-directory="outbound"/>
                  </beans>
                  """;
          DefaultListableBeanFactory beanFactory = new DefaultListableBeanFactory();
          XmlBeanDefinitionReader reader = new XmlBeanDefinitionReader(beanFactory);
          reader.setValidationMode(XmlBeanDefinitionReader.VALIDATION_NONE);
  
          reader.loadBeanDefinitions(new ByteArrayResource(configuration.getBytes(StandardCharsets.UTF_8)));
  
          assertThat(beanFactory.containsBean("input")).isTrue();
          assertThat(beanFactory.containsBean("sessionFactory")).isTrue();
          assertThat(beanFactory.containsBean("sftpAdapter")).isTrue();
      }
  }
[tool-exec] end id=call_b5znxPcWpHVfdnrKlX4akF9J|fc_01881cf312bc784b016aa421ff66f887d2ab2035a6b25e078e name=read status=success
          try {
              assertThat(session.isOpen()).isTrue();
              assertThat(session.listNames("inbound")).contains("inbound.txt");
          }
          finally {
              session.close();
          }
      }
  
      private void receiveInboundFile(DefaultSftpSessionFactory sessionFactory, Path localDirectory) throws IOException {
          SftpInboundFileSynchronizer synchronizer = new SftpInboundFileSynchronizer(sessionFactory);
          synchronizer.setBeanName("inboundSynchronizer");
          synchronizer.setRemoteDirectory("inbound");
  
          SftpInboundFileSynchronizingMessageSource inboundAdapter =
                  new SftpInboundFileSynchronizingMessageSource(synchronizer);
          inboundAdapter.setComponentName("sftpInboundAdapter");
          inboundAdapter.setLocalDirectory(localDirectory.toFile());
          inboundAdapter.afterPropertiesSet();
          try {
              Message<?> message = inboundAdapter.receive();
  
              assertThat(message).isNotNull();
              assertThat(Files.readString(((File) message.getPayload()).toPath(), StandardCharsets.UTF_8))
                      .isEqualTo(INBOUND_CONTENT);
          }
          finally {
              inboundAdapter.stop();
          }
