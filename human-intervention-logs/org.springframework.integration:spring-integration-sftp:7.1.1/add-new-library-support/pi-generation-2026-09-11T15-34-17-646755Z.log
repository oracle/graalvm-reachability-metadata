integration_sftpTest.java", "edits": [{"oldText": "import org.springframework.expression.common.LiteralExpression;\n", "newText": "import org.springframework.beans.factory.BeanFactory;\nimport org.springframework.context.annotation.AnnotationConfigApplicationContext;\nimport org.springframework.context.annotation.Configuration;\nimport org.springframework.expression.common.LiteralExpression;\n"}, {"oldText": "import org.springframework.integration.channel.QueueChannel;\n", "newText": "import org.springframework.integration.channel.QueueChannel;\nimport org.springframework.integration.config.EnableIntegration;\n"}, {"oldText": "            DefaultSftpSessionFactory sessionFactory = createSessionFactory(server.getPort());\n            try {\n                verifySessionCreation(sessionFactory);\n                receiveInboundFile(sessionFactory, temporaryDirectory.resolve(\"downloaded\"));\n                sendOutboundFile(sessionFactory);\n                removeOutboundFileWithGateway(sessionFactory);\n            }\n            finally {\n                sessionFactory.destroy();\n            }\n", "newText": "            try (AnnotationConfigApplicationContext applicationContext =\n                    new AnnotationConfigApplicationContext(IntegrationConfiguration.class)) {\n                DefaultSftpSessionFactory sessionFactory = createSessionFactory(server.getPort());\n                try {\n                    BeanFactory beanFactory = applicationContext.getBeanFactory();\n                    verifySessionCreation(sessionFactory);\n                    receiveInboundFile(sessionFactory, temporaryDirectory.resolve(\"downloaded\"), beanFactory);\n                    sendOutboundFile(sessionFactory, beanFactory);\n                    removeOutboundFileWithGateway(sessionFactory, beanFactory);\n                }\n                finally {\n                    sessionFactory.destroy();\n                }\n            }\n"}, {"oldText": "    private void receiveInbo