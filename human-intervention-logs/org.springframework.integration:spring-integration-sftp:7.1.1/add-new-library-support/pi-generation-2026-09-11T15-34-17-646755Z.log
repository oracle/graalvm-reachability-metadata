ion.sftp.inbound.SftpInboundFileSynchronizingMessageSource;\nimport org.springframework.integration.sftp.outbound.SftpMessageHandler;\nimport org.springframework.integration.sftp.outbound.SftpOutboundGateway;\nimport org.springframework.integration.sftp.session.DefaultSftpSessionFactory;\nimport org.springframework.integration.sftp.session.SftpRemoteFileTemplate;\nimport org.springframework.messaging.Message;\nimport org.springframework.messaging.support.GenericMessage;\n\npublic class Spring_integration_sftpTest {\n\n    private static final String USERNAME = \"sftp-user\";\n\n    private static final String PASSWORD = \"sftp-password\";\n\n    private static final String INBOUND_CONTENT = \"content received from the SFTP server\";\n\n    private static final String OUTBOUND_CONTENT = \"content sent to the SFTP server\";\n\n    @Test\n    void transfersFilesThroughSftpAdaptersAndGateway(@TempDir Path temporaryDirectory) throws Exception {\n        Path remoteRoot = Files.createDirectories(temporaryDirectory.resolve(\"remote-root\"));\n        Path inboundDirectory = Files.createDirectories(remoteRoot.resolve(\"inbound\"));\n        Files.writeString(inboundDirectory.resolve(\"inbound.txt\"), INBOUND_CONTENT, StandardCharsets.UTF_8);\n\n        SshServer server = createServer(remoteRoot, temporaryDirectory.resolve(\"host-key\"));\n        server.start();\n        try {\n            DefaultSftpSessionFactory sessionFactory = createSessionFactory(server.getPort());\n            try {\n                verifySessionCreation(sessionFactory);\n                receiveInboundFile(sessionFactory, temporaryDirectory.resolve(\"downloaded\"));\n                sendOutboundFile(sessionFactory);\n                removeOutboundFileWithGateway(sessionFactory);\n            }\n            finally {\n                sessionFactory.destroy();\n            }\n        }\n        finally {\n            server.stop(true);\n        }\n    }\n\n    private void verifySessionCreation(DefaultSftpSessionFactory sessionFactory) throws IOException {\n        Session<SftpClient.DirEntry> session = sessionFactory.getSession();\n        try {\n            assertThat(session.isOpen()).isTrue();\n            assertThat(session.listNames(\"inbound\")).contains(\"inbound.txt\");\n        }\n        finally {\n            session.close();\n        }\n    }\n\n    private void receiveInboundFile(DefaultSftpSessionFactory sessionFactory, Path localDirectory) throws IOException {\n        DefaultListableBeanFactory beanFactory = new DefaultListableBeanFactory();\n        SftpInboundFileSynchronizer synchronizer = new SftpInboundFileSynchronizer(sessionFactory);\n        synchronizer.setBeanFactory(beanFactory);\n        synchronizer.setBeanName(\"inboundSynchronizer\");\n        synchronizer.setRemoteDirectory(\"inbound\");\n\n        SftpInboundFileSynchronizingMessageSource inboundAdapter =\n                new SftpInboundFileSynchronizingMessageSource(synchronizer);\n        inboundAdapter.setBeanFactory(beanFactory);\n        inboundAdapter.setLocalDirectory(localDirectory.toFile());\n        inboundAdapter.afterPropertiesSet();\n        try {\n            Message<?> message = inboundAdapter.receive();\n\n            assertThat(message).isNotNull();\n            assertThat(Files.readString(((java.io.File) message.getPayload()).toPath(), StandardCharsets.UTF_8))\n                    .isEqualTo(INBOUND_CONTENT);\n        }\n        finally {\n            inboundAdapter.stop();\n        }\n    }\n\n    private void sendOutboundFile(DefaultSftpSessionFactory sessionFactory) {\n        DefaultListableBeanFactory beanFactory = new DefaultListableBeanFactory();\n        SftpMessageHandler outboundAdapter = new SftpMessageHandler(sessionFactory);\n        outboundAdapter.setBeanFactory(beanFactory);\n        outboundAdapter.setAutoCreateDirectory(true);\n        outboundAdapter.setRemoteDirectoryExpression(new LiteralExpression(\"outbound\"));\n        outboundAdapter.setFileNameGenerator(new FileNameGenerator() {\n            @Override\n            public String generateFileName(Message<?> message) {\n                return \"outbound.txt\";\n            }\n        });\n        outboundAdapter.afterPropertiesSet();\n        outboundAdapter.handleMessage(new GenericMessage<>(OUTBOUND_CONTENT));\n\n        SftpRemoteFileTemplate remoteFileTemplate = new SftpRemoteFileTemplate(sessionFactory);\n        ByteArrayOutputStream downloadedContent = new ByteArrayOutputStream();\n        assertThat(remoteFileTemplate.get(\"outbound/outbound.txt\", new InputStreamCallback() {\n            @Override\n            public void doWithInputStream(InputStream inputStream) throws IOException {\n                inputStream.transferTo(downloadedContent);\n            }\n        })).isTrue();\n        assertThat(new String(downloadedContent.toByteArray(), StandardCharsets.UTF_8)).isEqualTo(OUTBOUND_CONTENT);\n    }\n\n    private void removeOutboundFileWithGateway(DefaultSftpSessionFactory sessionFactory) {\n        DefaultListableBeanFactory beanFactory = new DefaultListableBeanFactory();\n        QueueChannel replies = new QueueChannel();\n        SftpOutboundGateway gateway = new SftpOutboundGateway(sessionFactory, \"rm\", null);\n        gateway.setBeanFactory(beanFactory);\n        gateway.setOutputChannel(replies);\n        gateway.afterPropertiesSet();\n        gateway.handleMessage(new GenericMessage<>(\"outbound/outbound.txt\"));\n\n        Message<?> reply = replies.receive(10_000);\n        assertThat(reply).isNotNull();\n        assertThat(reply.getPayload()).isEqualTo(true);\n        assertThat(new SftpRemoteFileTemplate(sessionFactory).exists(\"outbound/outbound.txt\")).isFalse();\n    }\n\n    private SshServer createServer(Path remoteRoot, Path hostKeyPath) {\n        SshServer server = SshServer.setUpDefaultServer();\n        server.setHost(\"127.0.0.1\");\n        server.setPort(0);\n        server.setKeyPairProvider(new SimpleGeneratorHostKeyProvider(hostKeyPath));\n        server.setFileSystemFactory(new VirtualFileSystemFactory(remoteRoot));\n        server.setPasswordAuthenticator(new PasswordAuthenticator() {\n            @Override\n            public boolean authenticate(String username, String password, ServerSession session) {\n                return USERNAME.equals(username) && PASSWORD.equals(password);\n            }\n        });\n        server.setSubsystemFactories(List.of(new SftpSubsystemFactory.Builder().build()));\n        return server;\n    }\n\n    private DefaultSftpSessionFactory createSessionFactory(int port) {\n        DefaultSftpSessionFactory sessionFactory = new DefaultSftpSessionFactory(true);\n        sessionFactory.setHost(\"127.0.0.1\");\n        sessionFactory.setPort(port);\n        sessionFactory.setUser(USERNAME);\n        sessionFactory.setPassword(PASSWORD);\n        sessionFactory.setAllowUnknownKeys(true);\n        sessionFactory.setTimeout(10_000);\n        return sessionFactory;\n    }\n}\n"}]}
