  	public AbstractRemoteFileOutboundGateway(RemoteFileTemplate<F> remoteFileTemplate,
  			MessageSessionCallback<F, ?> messageSessionCallback) {
  
  		Assert.notNull(remoteFileTemplate, "'remoteFileTemplate' cannot be null");
