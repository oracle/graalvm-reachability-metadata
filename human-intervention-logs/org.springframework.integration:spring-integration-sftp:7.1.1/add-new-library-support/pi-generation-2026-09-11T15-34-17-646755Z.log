n clientSession =\n354-\t\t\t\tthis.sshClient.connect(config)\n355-\t\t\t\t\t\t.verify(verifyTimeout)\n356:\t\t\t\t\t\t.getSession();\n357-\n358-\t\ttry {\n359-\t\t\tclientSession.auth().verify(verifyTimeout);\n360-\t\t}\n361-\t\tcatch (IOException ex) {\n362-\t\t\tclientSession.close();\n363-\t\t\tthrow ex;\n364-\t\t}\n365-\n366-\t\treturn clientSession;\n367-\t}\n368-\n369-\tprivate void initClient() throws IOException {\n370-\t\tif (!this.initialized) {\n371-\t\t\tthis.lock.lock();\n372-\t\t\ttry {\n373-\t\t\t\tif (!this.initialized) {\n374-\t\t\t\t\tdoInitClient();\n--\n434-\n435-\t@Override\n436-\tpublic void resetSharedSession() {\n437-\t\tAssert.state(this.isSharedSession, \"Shared sessions are not being used\");\n438-\t\tthis.sharedSftpClient = null;\n439-\t}\n440-\n441-\t/**\n442:\t * Can be overridden to provide a custom {@link SftpClient} to {@link #getSession()}.\n443-\t * @param clientSession the {@link ClientSession}\n444-\t * @param initialVersionSelector the initial {@link SftpVersionSelector}\n445-\t * @param errorDataHandler the {@link SftpErrorDataHandler} to handle incoming data\n446-\t *                         through the error stream.\n447-\t * @return {@link SftpClient}\n448-\t * @throws IOException if failed to initialize\n449-\t * @since 6.1.3\n450-\t */\n451-\tprotected SftpClient createSftpClient(\n452-\t\t\tClientSession clientSession, SftpVersionSelector initialVersionSelector,\n453-\t\t\tSftpErrorDataHandler errorDataHandler) throws IOException {\n"}], "isError": false, "timestamp": 1789141146511}]}
