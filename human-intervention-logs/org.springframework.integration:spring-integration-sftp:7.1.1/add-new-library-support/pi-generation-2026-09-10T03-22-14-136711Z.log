gframework.org/schema/integration/sftp/spring-integration-sftp.xsd\">\n                    <int:channel id=\"inboundChannel\">\n                        <int:queue />\n                    </int:channel>\n                    <bean id=\"sessionFactory\" class=\"java.lang.Object\" />\n                    <int-sftp:inbound-streaming-channel-adapter id=\"sftpInbound\"\n                            channel=\"inboundChannel\"\n                            session-factory=\"sessionFactory\"\n                            auto-startup=\"false\"\n                            filename-pattern=\"*.csv\"\n                            remote-directory-expression=\"'/inbound'\">\n                        <int:poller fixed-delay=\"10000\" />\n                    </int-sftp:inbound-streaming-channel-adapter>\n                </beans>\n                \"\"\";\n        DefaultListableBeanFactory beanFactory = new DefaultListableBeanFactory();\n        XmlBeanDefinitionReader reader = new XmlBeanDefinitionReader(beanFactory);\n\n        int definitions = reader.loadBeanDefinitions(\n                new ByteArrayResource(configuration.getBytes(StandardCharsets.UTF_8)));\n\n        assertThat(definitions).isPositive();\n        assertThat(beanFactory.containsBeanDefinition(\"sftpInbound\")).isTrue();\n    }\n\n}\n"}
