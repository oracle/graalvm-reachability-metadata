[tool-call] delta {"path":"tests/src/org.springframework.integration/spring-integration-sftp/7.1.1/src/test/java/org_springframework_integration/spring_integration_sftp/Spring_integration_sftpTest.java","edits":[{"oldText":"import java.io.ByteArrayOutputStream;\nimport java.io.IOException;\nimport java.io.InputStream;\nimport java.nio.charset.StandardCharsets;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.util.Arrays;\nimport java.util.stream.Stream;\n","newText":"import java.io.ByteArrayOutputStream;\nimport java.io.File;\nimport java.io.FileInputStream;\nimport java.io.IOException;\nimport java.io.InputStream;\nimport java.nio.charset.StandardCharsets;\nimport java.util.Arrays;\n"},{"oldText":"import org.junit.jupiter.api.io.TempDir;\n","newText":""},{"oldText":"    private static Path serverRoot;","newText":"    private static File serverRoot;"},{"oldText":"        serverRoot = Files.createTempDirectory(\"spring-integration-sftp-server\");\n        server = SshServer.setUpDefaultServer();\n        server.setPort(0);\n        server.setPasswordAuthenticator(AcceptAllPasswordAuthenticator.INSTANCE);\n        server.setKeyPairProvider(new SimpleGeneratorHostKeyProvider(serverRoot.resolve(\"hostkey.ser\")));\n        server.setSubsystemFactories(Arrays.asList(new SftpSubsystemFactory()));\n        server.setFileSystemFactory(new VirtualFileSystemFactory(serverRoot));","newText":"        serverRoot = createTemporaryDirectory(\"spring-integration-sftp-server\");\n        server = SshServer.setUpDefaultServer();\n        server.setPort(0);\n        server.setPasswordAuthenticator(AcceptAllPasswordAuthenticator.INSTANCE);\n        server.setKeyPairProvider(new SimpleGeneratorHostKeyProvider(new File(serverRoot, \"hostkey.ser\").toPath()));\n        server.setSubsystemFactories(Arrays.asList(new SftpSubsystemFactory()));\n        server.setFileSystemFactory(new VirtualFileSystemFactory(serverRoot.toPath()));"},{"oldText":"            deleteRecursively(serverRoot);","newText":"            deleteRecursively(serverRoot);"},{"oldText":"    void synchronizesRemoteFileToLocalDirectoryAndDeletesSource(@TempDir Path localDirectory) throws Exception {\n        DefaultSftpSessionFactory sessionFactory = newSessionFactory();\n        try {\n            SftpRemoteFileTemplate template = newRemoteFileTemplate(sessionFactory, \"/inbound\");\n            String remotePath = template.send(MessageBuilder.withPayload(\"invoice contents\")\n                    .setHeader(FileHeaders.FILENAME, \"invoice.txt\")\n                    .build());\n\n            SftpInboundFileSynchronizer synchronizer = new SftpInboundFileSynchronizer(sessionFactory);\n            synchronizer.setRemoteDirectory(\"/inbound\");\n            synchronizer.setDeleteRemoteFiles(true);\n            synchronizer.afterPropertiesSet();\n            synchronizer.synchronizeToLocalDirectory(localDirectory.toFile());\n            synchronizer.close();\n\n            assertThat(Files.readString(localDirectory.resolve(\"invoice.txt\")))\n                    .isEqualTo(\"invoice contents\");\n            assertThat(template.exists(remotePath)).isFalse();\n        }\n        finally {\n            sessionFactory.destroy();\n        }\n    }","newText":"    void synchronizesRemoteFileToLocalDirectoryAndDeletesSource() throws Exception {\n        File localDirectory = createTemporaryDirectory(\"spring-integration-sftp-client\");\n        DefaultSftpSessionFactory sessionFactory = newSessionFactory();\n        try {\n            SftpRemoteFileTemplate template = newRemoteFileTemplate(sessionFactory, \"/inbound\");\n            String remotePath = template.send(MessageBuilder.withPayload(\"invoice contents\")\n                    .setHeader(FileHeaders.FILENAME, \"invoice.txt\")\n                    .build());\n\n            SftpInboundFileSynchronizer synchronizer = new SftpInboundFileSynchronizer(sessionFactory);\n            synchronizer.setRemoteDirectory(\"/inbound\");\n            synchronizer.setDeleteRemoteFiles(true);\n            synchronizer.afterPropertiesSet();\n            try {\n                synchronizer.synchronizeToLocalDirectory(localDirectory);\n            }\n            finally {\n                synchronizer.close();\n            }\n\n            assertThat(readFile(new File(localDirectory, \"invoice.txt\"))).isEqualTo(\"invoice contents\");\n            assertThat(template.exists(remotePath)).isFalse();\n        }\n        finally {\n            sessionFactory.destroy();\n            deleteRecursively(localDirectory);\n        }\n    }"},{"oldText":"    private static void deleteRecursively(Path directory) throws IOException {\n        try (Stream<Path> entries = Files.list(directory)) {\n            for (Path entry : entries.toList()) {\n                if (Files.isDirectory(entry)) {\n                    deleteRecursively(entry);\n                }\n                else {\n                    Files.deleteIfExists(entry);\n                }\n            }\n        }\n        Files.deleteIfExists(directory);\n    }\n","newText":"    private static File createTemporaryDirectory(String prefix) throws IOException {\n        File directory = File.createTempFile(prefix, \"\");\n        if (!directory.delete() || !directory.mkdir()) {\n            throw new IOException(\"Could not create temporary directory \" + directory);\n        }\n        return directory;\n    }\n\n    private static void deleteRecursively(File directory) throws IOException {\n        File[] entries = directory.listFiles();\n        if (entries != null) {\n            for (File entry : entries) {\n                if (entry.isDirectory()) {\n                    deleteRecursively(entry);\n                }\n                else if (!entry.delete()) {\n                    throw new IOException(\"Could not delete \" + entry);\n                }\n            }\n        }\n        if (!directory.delete()) {\n            throw new IOException(\"Could not delete \" + directory);\n        }\n    }\n\n    private static String readFile(File file) throws IOException {\n        try (InputStream inputStream = new FileInputStream(file)) {\n            return new String(inputStream.readAllBytes(), StandardCharsets.UTF_8);\n        }\n    }\n"}]}
