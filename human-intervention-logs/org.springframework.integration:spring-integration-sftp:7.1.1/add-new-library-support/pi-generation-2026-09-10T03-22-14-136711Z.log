If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_springframework_integration.spring_integration_sftp;\n\nimport java.io.ByteArrayOutputStream;\nimport java.io.IOException;\nimport java.io.InputStream;\nimport java.nio.charset.StandardCharsets;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.util.Arrays;\nimport java.util.stream.Stream;\n\nimport org.apache.sshd.common.file.virtualfs.VirtualFileSystemFactory;\nimport org.apache.sshd.server.SshServer;\nimport org.apache.sshd.server.auth.password.AcceptAllPasswordAuthenticator;\nimport org.apache.sshd.server.keyprovider.SimpleGeneratorHostKeyProvider;\nimport org.apache.sshd.sftp.client.SftpClient;\nimport org.apache.sshd.sftp.server.SftpSubsystemFactory;\nimport org.junit.jupiter.api.AfterAll;\nimport org.junit.jupiter.api.BeforeAll;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.io.TempDir;\n\nimport org.springframework.beans.factory.support.DefaultListableBeanFactory;\nimport org.springframework.expression.common.LiteralExpression;\nimport org.springframework.integration.file.FileHeaders;\nimport org.springframework.integration.file.remote.InputStreamCallback;\nimport org.springframework.integration.sftp.inbound.SftpInboundFileSynchronizer;\nimport org.springframework.integration.sftp.session.DefaultSftpSessionFactory;\nimport org.springframework.integration.sftp.session.SftpRemoteFileTemplate;\nimport org.springframework.messaging.support.MessageBuilder;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\npublic class Spring_integration_sftpTest {\n\n    private static SshServer server;\n\n    private static Path serverRoot;\n\n    @BeforeAll\n    static void startServer() throws Exception {\n        serverRoot = Files.createTempDirectory(\"spring-integration-sftp-server\");\n        server = SshServer.setUpDefaultServer();\n        server.setPort(0);\n        server.setPasswordAuthenticator(AcceptAllPasswordAuthenticator.INSTANCE);\n        server.setKeyPairProvider(new SimpleGeneratorHostKeyProvider(serverRoot.resolve(\"hostkey.ser\")));\n        server.setSubsystemFactories(Arrays.asList(new SftpSubsystemFactory()));\n        server.setFileSystemFactory(new VirtualFileSystemFactory(serverRoot));\n        server.start();\n    }\n\n    @AfterAll\n    static void stopServer() throws Exception {\n        if (server != null) {\n            server.stop();\n        }\n        if (serverRoot != null) {\n            deleteRecursively(serverRoot);\n        }\n    }\n\n    @Test\n    void uploadsRetrievesRenamesAndRemovesRemoteFile() {\n        DefaultSftpSessionFactory sessionFactory = newSessionFactory();\n        try {\n            SftpRemoteFileTemplate template = newRemoteFileTemplate(sessionFactory, \"/outbound\");\n            String remotePath = template.send(MessageBuilder.withPayload(\"quarterly report\")\n                    .setHeader(FileHeaders.FILENAME, \"report.txt\")\n                    .build());\n\n            assertThat(remotePath).isEqualTo(\"/outbound/report.txt\");\n            assertThat(template.exists(remotePath)).isTrue();\n            assertThat(Arrays.stream(template.list(\"/outbound\"))\n                    .map(SftpClient.DirEntry::getFilename))\n                    .contains(\"report.txt\");\n\n            ByteArrayOutputStream downloaded = new ByteArrayOutputStream();\n            assertThat(template.get(remotePath, new CopyingInputStreamCallback(downloaded))).isTrue();\n            assertThat(downloaded.toString(StandardCharsets.UTF_8)).isEqualTo(\"quarterly report\");\n\n            template.rename(remotePath, \"/outbound/archive/report.txt\");\n            assertThat(template.exists(\"/outbound/archive/report.txt\")).isTrue();\n            assertThat(template.remove(\"/outbound/archive/report.txt\")).isTrue();\n            assertThat(template.exists(\"/outbound/archive/report.txt\")).isFalse();\n        }\n        finally {\n            sessionFactory.destroy();\n        }\n    }\n\n    @Test\n    void synchronizesRemoteFileToLocalDirectoryAndDeletesSource(@TempDir Path localDirectory) {\n        DefaultSftpSessionFactory sessionFactory = newSessionFactory();\n        try {\n            SftpRemoteFileTemplate template = newRemoteFileTemplate(sessionFactory, \"/inbound\");\n            String remotePath = template.send(MessageBuilder.withPayload(\"invoice contents\")\n                    .setHeader(FileHeaders.FILENAME, \"invoice.txt\")\n                    .build());\n\n            SftpInboundFileSynchronizer synchronizer = new SftpInboundFileSynchronizer(sessionFactory);\n            synchronizer.setRemoteDirectory(\"/inbound\");\n            synchronizer.setDeleteRemoteFiles(true);\n            synchronizer.setBeanFactory(new DefaultListableBeanFactory());\n            synchronizer.afterPropertiesSet();\n            synchronizer.synchronizeToLocalDirectory(localDirectory.toFile());\n            synchronizer.close();\n\n            assertThat(Files.readString(localDirectory.resolve(\"invoice.txt\")))\n                    .isEqualTo(\"invoice contents\");\n            assertThat(template.exists(remotePath)).isFalse();\n        }\n        finally {\n            sessionFactory.destroy();\n        }\n    }\n\n    private static DefaultSftpSessionFactory newSessionFactory() {\n        DefaultSftpSessionFactory sessionFactory = new DefaultSftpSessionFactory(false);\n        sessionFactory.setHost(\"127.0.0.1\");\n        sessionFactory.setPort(server.getPort());\n        sessionFactory.setUser(\"test-user\");\n        sessionFactory.setPassword(\"test-password\");\n        sessionFactory.setAllowUnknownKeys(true);\n        sessionFactory.setTimeout(10_000);\n        return sessionFactory;\n    }\n\n    private static SftpRemoteFileTemplate newRemoteFileTemplate(DefaultSftpSessionFactory sessionFactory,\n            String remoteDirectory) {\n\n        SftpRemoteFileTemplate template = new SftpRemoteFileTemplate(sessionFactory);\n        template.setRemoteDirectoryExpression(new LiteralExpression(remoteDirectory));\n        template.setAutoCreateDirectory(true);\n        template.setBeanFactory(new DefaultListableBeanFactory());\n        template.afterPropertiesSet();\n        return template;\n    }\n\n    private static void deleteRecursively(Path directory) throws IOException {\n        try (Stream<Path> entries = Files.list(directory)) {\n            for (Path entry : entries.toList()) {\n                if (Files.isDirectory(entry)) {\n                    deleteRecursively(entry);\n                }\n                else {\n                    Files.deleteIfExists(entry);\n                }\n            }\n        }\n        Files.deleteIfExists(directory);\n    }\n\n    private static final class CopyingInputStreamCallback implements InputStreamCallback {\n\n        private final ByteArrayOutputStream destination;\n\n        private CopyingInputStreamCallback(ByteArrayOutputStream destination) {\n            this.destination = destination;\n        }\n\n        @Override\n        public void doWithInputStream(InputStream inputStream) throws IOException {\n            inputStream.transferTo(destination);\n        }\n\n    }\n\n}\n"}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-terra", "usage": {"input": 2272, "output": 3431, "cacheRead": 54784, "cacheWrite": 0, "reasoning": 1790, "totalTokens": 60487, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1789010688011, "responseId": "resp_0df12a75a25775e3016aa2230077c487d29ad24a34a3c8392e", "rawStopReason": "completed"}, "toolResults": [{"role": "toolResult", "toolCallId": "call_kBmF711GYAZ5tWAizRU77K5B|fc_0df12a75a25775e3016aa22321fedc87d2b11e4504081fc635", "toolName": "write", "content": [{"type": "text", "text": "Successfully wrote 7151 bytes to tests/src/org.springframework.integration/spring-integration-sftp/7.1.1/src/test/java/o