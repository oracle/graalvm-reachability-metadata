gration.sftp.outbound.SftpMessageHandler;\nimport org.springframework.integration.sftp.outbound.SftpOutboundGateway;\nimport org.springframework.integration.sftp.session.DefaultSftpSessionFactory;\nimport org.springframework.integration.sftp.session.SftpRemoteFileTemplate;\nimport org.springframework.messaging.Message;\nimport org.springframework.messaging.support.GenericMessage;\n\npublic class Spring_integration_sftpTest {\n\n    @TempDir\n    Path temporaryDirectory;\n\n    private SshServer server;\n\n    private DefaultSftpSessionFactory sessionFactory;\n\n    private Path serverRoot;\n\n    @BeforeEach\n    void startServer() throws Exception {\n        this.serverRoot = Files.createDirectory(this.temporaryDirectory.resolve(\"sftp-root\"));\n        this.server = SshServer.setUpDefaultServer();\n        this.server.setHost(\"127.0.0.1\");\n        this.server.setPort(0);\n        this.server.setKeyPairProvider(KeyPairProvider.wrap(createHostKey()));\n        this.server.setPasswordAuthenticator((username, password, session) ->\n                \"user\".equals(username) && \"password\".equals(password));\n        this.server.setFileSystemFactory(new VirtualFileSystemFactory(this.serverRoot));\n        this.server.setSubsystemFactories(List.of(new SftpSubsystemFactory()));\n        this.server.start();\n\n        this.sessionFactory = new DefaultSftpSessionFactory();\n        this.sessionFactory.setHost(\"127.0.0.1\");\n        this.sessionFactory.setPort(this.server.getPort());\n        this.sessionFactory.setUser(\"user\");\n        this.sessionFactory.setPassword(\"password\");\n        this.sessionFactory.setAllowUnknownKeys(true);\n        this.sessionFactory.setTimeout(10_000);\n    }\n\n    @AfterEach\n    void stopServer() throws Exception {\n        if (this.sessionFactory != null) {\n            this.sessionFactory.destroy();\n        }\n        if (this.server != null) {\n            this.server.stop(true);\n        }\n    }\n\n    @Test\n    @Timeout(30)\n    void remoteFileTemplateTransfersReadsAndRemovesFiles() throws Exception {\n        SftpRemoteFileTemplate template = new SftpRemoteFileTemplate(this.sessionFactory);\n        template.setAutoCreateDirectory(true);\n        template.setRemoteDirectoryExpression(new LiteralExpression(\"template\"));\n        template.setFileNameExpression(new LiteralExpression(\"remote.txt\"));\n        template.afterPropertiesSet();\n\n        assertThat(template.send(new GenericMessage<>(\"template payload\"))).isNotNull();\n        assertThat(Files.readString(this.serverRoot.resolve(\"template/remote.txt\")))\n                .isEqualTo(\"template payload\");\n\n        AtomicReference<String> downloaded = new AtomicReference<>();\n        assertThat(template.get(\"template/remote.txt\", input ->\n                downloaded.set(new String(input.readAllBytes(), StandardCharsets.UTF_8)))).isTrue();\n        assertThat(downloaded.get()).isEqualTo(\"template payload\");\n        assertThat(template.list(\"template\")).hasSize(1);\n        assertThat(template.remove(\"template/remote.txt\")).isTrue();\n        assertThat(template.exists(\"template/remote.txt\")).isFalse();\n    }\n\n    @Test\n    @Timeout(30)\n    void outboundAdapterUploadsAndGatewayListsFiles() throws Exception {\n        Path outboundFile = Files.writeString(this.temporaryDirectory.resolve(\"outbound.txt\"), \"outbound payload\");\n        SftpMessageHandler handler = new SftpMessageHandler(this.sessionFactory);\n        handler.setAutoCreateDirectory(true);\n        handler.setRemoteDirectoryExpression(new LiteralExpression(\"outbound\"));\n        handler.setFileNameGenerator(message -> \"adapter.txt\");\n        handler.setUseTemporaryFileName(false);\n        handler.afterPropertiesSet();\n\n        handler.handleMessage(new GenericMessage<>(outboundFile.toFile()));\n        assertThat(Files.readString(this.serverRoot.resolve(\"outbound/adapter.txt\")))\n                .isEqualTo(\"outbound payload\");\n\n        QueueChannel replies = new QueueChannel();\n        SftpOutboundGateway gateway = new SftpOutboundGateway(this.sessionFactory, \"nlst\", \"'outbound'\");\n        gateway.setOutputChannel(replies);\n        gateway.afterPropertiesSet();\n        gateway.handleMessage(new GenericMessage<>(\"list outbound files\"));\n\n        Message<?> reply = replies.receive(10_000);\n        assertThat(reply).isNotNull();\n        assertThat((List<?>) reply.getPayload()).contains(\"adapter.txt\");\n    }\n\n    @Test\n    @Timeout(30)\n    void inboundSynchronizerDownloadsMatchingRemoteFiles() throws Exception {\n        Path incoming = Files.createDirectory(this.serverRoot.resolve(\"incoming\"));\n        Files.writeString(incoming.resolve(\"download.txt\"), \"inbound payload\");\n        Files.writeString(incoming.resolve(\"ignore.dat\"), \"not selected\");\n        Path localDirectory = Files.createDirectory(this.temporaryDirectory.resolve(\"local\"));\n\n        SftpInboundFileSynchronizer synchronizer = new SftpInboundFileSynchronizer(this.sessionFactory);\n        synchronizer.setRemoteDirectory(\"incoming\");\n        synchronizer.setFilter(new SftpSimplePatternFileListFilter(\"*.txt\"));\n        synchronizer.afterPropertiesSet();\n        try {\n            synchronizer.synchronizeToLocalDirectory(localDirectory.toFile());\n        }\n        finally {\n            synchronizer.close();\n        }\n\n        assertThat(Files.readString(localDirectory.resolve(\"download.txt\"))).isEqualTo(\"inbound payload\");\n        assertThat(localDirectory.resolve(\"ignore.dat\")).doesNotExist();\n    }\n\n    private static java.security.KeyPair createHostKey() throws Exception {\n        KeyPairGenerator keyPairGenerator = KeyPairGenerator.getInstance(\"RSA\");\n        keyPairGenerator.initialize(2048);\n        return keyPairGenerator.generateKeyPair();\n    }\n}\n"}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-terra", "usage": {"i