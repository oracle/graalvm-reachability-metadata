     607		private void setupLocalDirectory() {
     608			File localDirectory =
     609					ExpressionUtils.expressionToFile(this.localDirectoryExpression,
     610							this.standardEvaluationContext, null,
     611							"localDirectoryExpression");
     612			if (!localDirectory.exists()) {
     613				try {
     614					if (this.autoCreateLocalDirectory) {
     615						logger.debug(() -> "The '" + localDirectory + "' directory doesn't exist; Will create.");
     616						if (!localDirectory.mkdirs()) {
     617							throw new IOException("Failed to make local directory: " + localDirectory);
     618						}
     619					}
     620					else {
     621						throw new FileNotFoundException(localDirectory.getName());
     622					}
     623				}
     624				catch (IOException ex) {
     625					throw new UncheckedIOException(ex);
     626				}
     627			}
     628		}
