[tool-call] delta {"path":"tests/src/org.springframework.integration/spring-integration-sftp/7.1.1/src/test/java/org_springframework_integration/spring_integration_sftp/ApacheMinaSftpEventListenerTest.java","content":"/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_springframework_integration.spring_integration_sftp;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.nio.file.Path;\nimport java.util.ArrayList;\nimport java.util.List;\nimport java.util.Map;\n\nimport org.junit.jupiter.api.Test;\nimport org.springframework.integration.sftp.server.ApacheMinaSftpEventListener;\nimport org.springframework.integration.sftp.server.DirectoryCreatedEvent;\nimport org.springframework.integration.sftp.server.PathMovedEvent;\n\npublic class ApacheMinaSftpEventListenerTest {\n\n    @Test\n    void publishesDirectoryAndPathMoveEvents() {\n        List<Object> events = new ArrayList<>();\n        ApacheMinaSftpEventListener listener = new ApacheMinaSftpEventListener();\n        listener.setApplicationEventPublisher(events::add);\n        listener.setBeanName(\"sftpEvents\");\n        listener.afterPropertiesSet();\n\n        Path directory = Path.of(\"incoming\");\n        Path source = Path.of(\"incoming/report.txt\");\n        Path target = Path.of(\"archive/report.txt\");\n        listener.created(null, directory, Map.of(\"owner\", \"sftp-user\"), null);\n        listener.moved(null, source, target, List.of(), null);\n\n        assertThat(listener.getBeanName()).isEqualTo(\"sftpEvents\");\n        assertThat(events).hasSize(2);\n        DirectoryCreatedEvent created = (DirectoryCreatedEvent) events.get(0);\n        assertThat(created.getPath()).isEqualTo(directory);\n        assertThat(created.getAttrs()).containsEntry(\"owner\", \"sftp-user\");\n        PathMovedEvent moved = (PathMovedEvent) events.get(1);\n        assertThat(moved.getSrcPath()).isEqualTo(source);\n        assertThat(moved.getDstPath()).isEqualTo(target);\n    }\n}\n"}
