[tool-call] delta {"path":"tests/src/org.springframework.integration/spring-integration-sftp/7.1.1/src/test/java/org_springframework_integration/spring_integration_sftp/SftpSimplePatternFileListFilterTest.java","content":"/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_springframework_integration.spring_integration_sftp;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport org.apache.sshd.sftp.client.SftpClient;\nimport org.apache.sshd.sftp.common.SftpConstants;\nimport org.junit.jupiter.api.Test;\nimport org.springframework.integration.sftp.filters.SftpSimplePatternFileListFilter;\n\npublic class SftpSimplePatternFileListFilterTest {\n\n    @Test\n    void acceptsMatchingFilesAndDirectories() {\n        SftpSimplePatternFileListFilter filter = new SftpSimplePatternFileListFilter(\"*.txt\");\n\n        assertThat(filter.accept(entry(\"report.txt\", SftpConstants.SSH_FILEXFER_TYPE_REGULAR))).isTrue();\n        assertThat(filter.accept(entry(\"report.csv\", SftpConstants.SSH_FILEXFER_TYPE_REGULAR))).isFalse();\n        assertThat(filter.accept(entry(\"archive\", SftpConstants.SSH_FILEXFER_TYPE_DIRECTORY))).isTrue();\n    }\n\n    private static SftpClient.DirEntry entry(String name, int type) {\n        SftpClient.Attributes attributes = new SftpClient.Attributes();\n        attributes.setType(type);\n        return new SftpClient.DirEntry(name, name, attributes);\n    }\n}\n"}
