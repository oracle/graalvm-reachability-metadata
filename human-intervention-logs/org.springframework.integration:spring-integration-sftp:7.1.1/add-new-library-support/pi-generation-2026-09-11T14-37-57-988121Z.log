     651		private @Nullable Object doLs(Message<?> requestMessage) {
     652			String dir = obtainRemoteDir(requestMessage);
     653			return this.remoteFileTemplate.execute(session -> {
     654				List<?> payload = ls(requestMessage, session, dir);
     655				return getMessageBuilderFactory()
     656						.withPayload(payload)
     657						.setHeader(FileHeaders.REMOTE_DIRECTORY, dir)
     658						.setHeader(FileHeaders.REMOTE_HOST_PORT, session.getHostPort());
     659			});
     660	
     661		}
