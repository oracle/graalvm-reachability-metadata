     789		private Object doMv(Message<?> requestMessage) {
     790			String remoteFilePath = obtainRemoteFilePath(requestMessage);
     791			String remoteFilename = getRemoteFilename(remoteFilePath);
     792			String remoteDir = getRemoteDirectory(remoteFilePath, remoteFilename);
     793			if (remoteDir == null) {
     794				MessageProcessor<String> directoryExpressionProcessor =
     795						this.remoteFileTemplate.getDirectoryExpressionProcessor();
     796				if (directoryExpressionProcessor != null) {
     797					remoteDir = directoryExpressionProcessor.processMessage(requestMessage);
     798					if (remoteDir != null) {
     799						remoteFilePath = remoteDir + this.remoteFileTemplate.getRemoteFileSeparator() + remoteFilename;
     800					}
     801				}
     802			}
     803	
     804			String remoteFileNewPath = buildRemoteFileNewPath(requestMessage, remoteDir);
     805			Assert.hasLength(remoteFileNewPath, "New filename cannot be empty");
     806	
     807			return executeMv(requestMessage, remoteFilename, remoteDir, remoteFilePath, remoteFileNewPath);
     808		}
