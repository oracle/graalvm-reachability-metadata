     630		@Override
     631		protected @Nullable Object handleRequestMessage(final Message<?> requestMessage) {
     632			if (this.command != null) {
     633				return switch (this.command) {
     634					case LS -> doLs(requestMessage);
     635					case NLST -> doNlst(requestMessage);
     636					case GET -> doGet(requestMessage);
     637					case MGET -> doMget(requestMessage);
     638					case RM -> doRm(requestMessage);
     639					case MV -> doMv(requestMessage);
     640					case PUT -> doPut(requestMessage);
     641					case MPUT -> doMput(requestMessage);
     642				};
     643			}
     644	
     645			Assert.state(AbstractRemoteFileOutboundGateway.this.messageSessionCallback != null,
     646					"'messageSessionCallback' must not be null");
     647			return this.remoteFileTemplate.execute(session ->
     648					AbstractRemoteFileOutboundGateway.this.messageSessionCallback.doInSession(session, requestMessage));
     649		}
