     675		private @Nullable String obtainRemoteDir(Message<?> requestMessage) {
     676			String dir = this.fileNameProcessor != null
     677					? this.fileNameProcessor.processMessage(requestMessage)
     678					: null;
     679			if (dir != null && !dir.endsWith(this.remoteFileTemplate.getRemoteFileSeparator())) {
     680				dir += this.remoteFileTemplate.getRemoteFileSeparator();
