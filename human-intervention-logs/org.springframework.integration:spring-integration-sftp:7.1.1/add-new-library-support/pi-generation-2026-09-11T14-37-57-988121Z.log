text/IntegrationObjectSupport.java\n   180\t\n   181\t\t@Override\n   182\t\tpublic void setBeanFactory(BeanFactory beanFactory) {\n   183\t\t\tAssert.notNull(beanFactory, \"'beanFactory' must not be null\");\n   184\t\t\tthis.beanFactory = beanFactory;\n   185\t\t}\n   186\t\n   187\t\t@Override\n   188\t\tpublic void setApplicationContext(ApplicationContext applicationContext) throws BeansException {\n   189\t\t\tAssert.notNull(applicationContext, \"'applicationContext' must not be null\");\n   190\t\t\tthis.applicationContext = applicationContext;\n   191\t\t}\n   192\t\n   193\t\t/**\n   194\t\t * Specify the {@link DestinationResolver} strategy to use.\n   195\t\t * The default is a BeanFactoryChannelResolver.\n   196\t\t * @param channelResolver The channel resolver.\n   197\t\t */\n   198\t\tpublic void setChannelResolver(DestinationResolver<MessageChannel> channelResolver) {\n   199\t\t\tAssert.notNull(channelResolver, \"'channelResolver' must not be null\");\n   200\t\t\tthis.channelResolver = channelResolver;\n   201\t\t}\n   202\t\n   203\t\t@Override\n   204\t\tpublic @Nullable Expression getExpression() {\n   205\t\t\treturn this.expression;\n   206\t\t}\n   207\t\n   208\t\t/**\n   209\t\t * For expression-based components, set the primary expression.\n   210\t\t * @param expression the expression.\n   211\t\t * @since 4.3\n   212\t\t */\n   213\t\tpublic final void setPrimaryExpression(Expression expression) {\n   214\t\t\tthis.expression = expression;\n   215\t\t}\n   216\t\n   217\t\t@Override\n   218\t\tpublic final void afterPropertiesSet() {\n   219\t\t\tthis.integrationProperties = IntegrationContextUtils.getIntegrationProperties(this.beanFactory);\n   220\t\t\tif (!this.messageBuilderFactoryExplicitlySet) {\n   221\t\t\t\tthis.messageBuilderFactory = IntegrationUtils.getMessageBuilderFactory(this.beanFactory);\n   222\t\t\t}\n   223\t\t\tif (this.beanSource == null && this.beanName != null\n   224\t\t\t\t\t&& this.beanFactory instanceof ConfigurableListableBeanFactory configurableListableBeanFactory\n   225\t\t\t\t\t&& configurableListableBeanFactory.containsBeanDefinition(this.beanName)) {\n   226\t\t\t\tBeanDefinition beanDefinition = configurableListableBeanFactory.getBeanDefinition(this.beanName);\n   227\t\t\t\tthis.beanSource = beanDefinition.getSource();\n   228\t\t\t\tif (this.beanDescription == null) {\n   229\t\t\t\t\tthis.beanDescription = beanDefinition.getResourceDescription();\n   230\t\t\t\t}\n   231\t\t\t}\n   232\t\t\tonInit();\n   233\t\t\tthis.initialized = true;\n   234\t\t}\n   235\t\n   236\t\t/**\n   237\t\t * Subclasses may implement this for initialization logic.\n   238\t\t */\n   239\t\tprotected void onInit() {\n   240\t\t}\n   241\t\n   242\t\t/**\n   243\t\t * Return the status of this component if it has been initialized already.\n   244\t\t * @return the flag if this component has been initialized already.\n   245\t\t */\n   246\t\tprotected boolean isInitialized() {\n   247\t\t\treturn this.initialized;\n   248\t\t}\n   249\t\n   250\t\tprotected BeanFactory getBeanFactory() {\n---spring-integration-core/src/main/java/org/springframework/integration/context/IntegrationContextUtils.java\n   180\t\t\t\t\tSimpleEvaluationContext.class);\n   181\t\t\tAssert.state(simpleEvaluationContext != null, \"No such bean '\" + INTEGRATION_SIMPLE_EVALUATION_CONTEXT_BEAN_NAME + \"'\");\n   182\t\n   183\t\t\treturn simpleEvaluationContext;\n   184\t\t}\n   185\t\n   186\t\t@Nullable\n   187\t\tprivate static <T> T getBeanOfType(BeanFactory beanFactory, String beanName, Class<T> type) {\n   188\t\t\tAssert.notNull(beanFactory, \"BeanFactory must not be null\");\n   189\t\t\tif (!beanFactory.containsBean(beanName)) {\n   190\t\t\t\treturn null;\n   191\t\t\t}\n   192\t\t\treturn beanFactory.getBean(beanName, type);\n   193\t\t}\n   194\t\n   195\t\t/**\n   196\t\t * @param beanFactory The bean factory.\n   197\t\t * @return the global {@link IntegrationContextUtils#INTEGRATION_GLOBAL_PROPERTIES_BEAN_NAME}\n   198\t\t *         bean from provided {@code #beanFactory}, which represents the merged\n   199\t\t *         properties values from all 'META-INF/spring.integration.properties'.\n   200\t\t *         Or user-defined {@link IntegrationProperties} bean.\n   201\t\t *         May return only {@link IntegrationProperties#defaults()} if there is no\n   202\t\t *         {@link IntegrationContextUtils#INTEGRATION_GLOBAL_PROPERTIES_BEAN_NAME} bean in the\n   203\t\t *         provided {@code #beanFactory}.\n   204\t\t * @throws IllegalArgumentException if provided {@code beanFactory} is {@code null}.\n   205\t\t */\n   206\t\tpublic static IntegrationProperties getIntegrationProperties(BeanFactory beanFactory) {\n   207\t\t\tIntegrationProperties integrationProperties =\n   208\t\t\t\t\t\tgetBeanOfType(beanFactory, INTEGRATION_GLOBAL_PROPERTIES_BEAN_NAME, IntegrationProperties.class);\n   209\t\t\tif (integrationProperties == null) {\n   210\t\t\t\tintegrationProperties = IntegrationProperties.DEFAULT_INSTANCE;\n   211\t\t\t}\n   212\t\t\treturn integrationProperties;\n   213\t\t}\n   214\t\n   215\t\t/**\n   216\t\t * Return a {@link BeanDefinition} with the given name,\n   217\t\t * obtained from the given {@link BeanFactory} or one of its parents.\n   218\t\t * @param name the bean name to return\n   219\t\t * @param beanFactory the {@link ConfigurableListableBeanFactory} to travers.\n   220\t\t * @return the {@link BeanDefinition} for a given name\n   221\t\t * @throws NoSuchBeanDefinitionException if a {@link BeanDefinition} is not found\n   222\t\t * @since 5.1.10\n   223\t\t */\n   224\t\tpublic static BeanDefinition getBeanDefinition(String name, ConfigurableListableBeanFactory beanFactory) {\n   225\t\t\ttry {\n   226\t\t\t\treturn beanFactory.getBeanDefinition(name);\n   227\t\t\t}\n   228\t\t\tcatch (NoSuchBeanDefinitionException ex) {\n   229\t\t\t\tBeanFactory parentBeanFactory = beanFactory.getParentBeanFactory();\n   230\t\t\t\tif (parentBeanFactory instanceof ConfigurableListableBeanFactory) {\n   231\t\t\t\t\treturn getBeanDefinition(name, (ConfigurableListableBeanFactory) parentBeanFactory);\n   232\t\t\t\t}\n   233\t\t\t\tthrow ex;\n   234\t\t\t}\n   235\t\t}\n   236\t\n   237\t}\n"}], "isError": false, "timestamp": 1789137861902}, {"role": "toolResult", "toolCallId": "call_c253G1dkX2dO6Zz5xdWXY9a2|fc_0cabc31087450e99016aa413c5186c87d2aae75497abe23eac", "toolName": "bash", "content": [{"type": "text", "text": "   270\t\t\tif (this.autoCreateDirectory) {\n   271\t\t\t\tAssert.hasText(this.remoteFileSeparator,\n   272\t\t\t\t\t\t\"'remoteFileSeparator' must not be empty when 'autoCreateDirectory' is set to 'true'\");\n   273\t\t\t}\n   274\t\t\tif (this.hasExplicitlySetSuffix && !this.useTemporaryFileName) {\n   275\t\t\t\tthis.logger.warn(\"Since 'use-temporary-file-name' is set to 'false' \" +\n   276\t\t\t\t\t\t\"the value of 'temporary-file-suffix' has no effect\");\n   277\t\t\t}\n   278\t\t}\n   279\t\n   280\t\t@Override\n   281\t\tpublic @Nullable String append(Message<?> message) {\n   282\t\t\treturn append(message, null);\n   283\t\t}\n   284\t\n   285\t\t@Override\n   286\t\tpublic @Nullable String append(Message<?> message, @Nullable String subDirectory) {\n   287\t\t\treturn send(message, subDirectory, FileExistsMode.APPEND);\n   288\t\t}\n   289\t\n   290\t\t@Override\n   291\t\tpublic @Nullable String send(Message<?> message, FileExistsMode... mode) {\n   292\t\t\treturn send(message, null, mode);\n   293\t\t}\n   294\t\n   295\t\t@Override\n   296\t\tpublic @Nullable String send(Message<?> message, @Nullable String subDirectory,\n   297\t\t\t\t@Nullable FileExistsMode @Nullable ... mode) {\n   298\t\n   299\t\t\tFileExistsMode modeToUse = mode == null || mode.length < 1 || mode[0] == null\n   300\t\t\t\t\t? FileExistsMode.REPLACE\n   301\t\t\t\t\t: mode[0];\n   302\t\t\treturn send(message, subDirectory, modeToUse);\n   303\t\t}\n   304\t\n   305\t\tprivate @Nullable String send(Message<?> message, @Nullable String subDirectory, FileExistsMode mode) {\n   306\t\t\tAssert.isTrue(!FileExistsMode.REPLACE_IF_MODIFIED.equals(mode),\n   307\t\t\t\t\t\"FilExistsMode.REPLACE_IF_MODIFIED can only be used for local files\");\n   308\t\t\tfinal StreamHolder inputStreamHolder = payloadToInputStream(message);\n   309\t\t\tif (inputStreamHolder != null) {\n   310\t\t\t\ttry {\n   311\t\t\t\t\treturn execute(session -> doSend(message, subDirectory, mode, inputStreamHolder, session));\n   312\t\t\t\t}\n   313\t\t\t\tfinally {\n   314\t\t\t\t\ttry {\n   315\t\t\t\t\t\tinputStreamHolder.stream.close();\n   316\t\t\t\t\t}\n   317\t\t\t\t\tcatch (@SuppressWarnings(\"unused\") IOException e) {\n   318\t\t\t\t\t}\n   319\t\t\t\t}\n   320\t\t\t}\n   321\t\t\telse {\n   322\t\t\t\t// A null holder means a File payload that does not exist.\n   323\t\t\t\tif (this.logger.isWarnEnabled()) {\n   324\t\t\t\t\tthis.logger.warn(\"File \" + message.getPayload() + \" does not exist\");\n   325\t\t\t\t}\n   326\t\t\t\treturn null;\n   327\t\t\t}\n   328\t\t}\n   329\t\n   330\t\tprivate String doSend(Message<?> message, @Nullable String subDirectory, FileExistsMode mode,\n   331\t\t\t\tStreamHolder inputStreamHolder, Session<F> session) {\n   332\t\n   333\t\t\tString fileName = inputStreamHolder.name;\n   334\t\t\ttry {\n   335\t\t\t\tAssert.notNull(this.directoryExpressionProcessor, \"'remoteDirectoryExpression' is required\");\n   336\t\t\t\tString remoteDirectory = this.directoryExpressionProcessor.processMessage(message);\n   337\t\t\t\tremoteDirectory = normalizeDirectoryPath(remoteDirectory);\n   338\t\t\t\tif (StringUtils.hasText(subDirectory)) {\n   339\t\t\t\t\tif (subDirectory.startsWith(this.remoteFileSeparator)) {\n   340\t\t\t\t\t\tremoteDirectory += subDirectory.substring(1);\n   341\t\t\t\t\t}\n   342\t\t\t\t\telse {\n   343\t\t\t\t\t\tremoteDirectory += normalizeDirectoryPath(subDirectory);\n   344\t\t\t\t\t}\n   345\t\t\t\t}\n   346\t\t\t\tString temporaryRemoteDirectory = remoteDirectory;\n   347\t\t\t\tif (this.temporaryDirectoryExpressionProcessor != null) {\n   348\t\t\t\t\ttemporaryRemoteDirectory = this.temporaryDirectoryExpressionProcessor.processMessage(message);\n   349\t\t\t\t}\n   350\t\t\t\tfileName = this.fileNameGenerator.generateFileName(message);\n   351\t\t\t\tsendFileToRemoteDirectory(inputStreamHolder.stream, temporaryRemoteDirectory, remoteDirectory, fileName,\n   352\t\t\t\t\t\tsession, mode);\n   353\t\t\t\treturn remoteDirectory + fileName;\n   354\t\t\t}\n   355\t\t\tcatch (FileNotFoundException e) {\n   356\t\t\t\tthrow new MessageDeliveryException(message, \"File [\" + inputStreamHolder.name\n   357\t\t\t\t\t\t+ \"] not found in local working directory; it was moved or deleted unexpectedly.\", e);\n   358\t\t\t}\n   359\t\t\tcatch (IOException e) {\n   360\t\t\t\tthrow new MessageDeliveryException(message, \"Failed to transfer file [\"\n   361\t\t\t\t\t\t+ inputStreamHolder.name + \" -> \" + fileName\n   362\t\t\t\t\t\t+ \"] from local directory to remote directory.\", e);\n   363\t\t\t}\n   364\t\t\tcatch (Exception e) {\n   365\t\t\t\tthrow new MessageDeliveryException(message, \"Error handling message for file [\"\n   366\t\t\t\t\t\t+ inputStreamHolder.name + \" -> \" + fileName + \"]\", e);\n   367\t\t\t}\n   368\t\t}\n   369\t\n   370\t\t@Override\ncurl: (22) The requested URL returned error: 404\n"}], "isError": false, "timestamp": 1789137861903}, {"role": "toolResult", "toolCallId": "call_cQzboZQNjSqeDbx5ElmfAuTz|fc_0cabc31087450e99016aa413c5187887d2906b26d50830800f", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_springframework_integration.spring_integration_sftp;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport java.nio.charset.StandardCharsets;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.security.KeyPair;\nimport java.security.KeyPairGenerator;\nimport java.util.List;\nimport java.util.concurrent.atomic.AtomicReference;\n\nimport org.apache.sshd.common.file.virtualfs.VirtualFileSystemFactory;\nimport org.apache.sshd.common.keyprovider.KeyPairProvider;\nimport org.apache.sshd.server.SshServer;\nimport org.apache.sshd.sftp.server.SftpSubsystemFactory;\nimport org.junit.jupiter.api.AfterEach;\nimport org.junit.jupiter.api.BeforeEach;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.Timeout;\nimport org.junit.jupiter.api.io.TempDir;\nimport org.springframework.expression.common.LiteralExpression;\nimport org.springframework.integration.channel.QueueChannel;\nimport org.springframework.integration.sftp.filters.SftpSimplePatternFileListFilter;\nimport org.springframework.integration.sftp.inbound.SftpInboundFileSynchronizer;\nimport org.springframework.integration.sftp.outbound.SftpMessageHandler;\nimport org.springframework.integration.sftp.outbound.SftpOutboundGateway;\nimport org.springframework.integration.sftp.session.DefaultSftpSessionFactory;\nimport org.springframework.integration.sftp.session.SftpRemoteFileTemplate;\nimport org.springframework.messaging.Message;\nimport org.springframework.messaging.support.GenericMessage;\n\npublic class Spring_integration_sftpTest {\n\n    @TempDir\n    Path temporaryDirectory;\n\n    private SshServer server;\n\n    private DefaultSftpSessionFactory sessionFactory;\n\n    private Path serverRoot;\n\n    @BeforeEach\n    void startServer() throws Exception {\n        this.serverRoot = Files.createDirectory(this.temporaryDirectory.resolve(\"sftp-root\"));\n        this.server = SshServer.setUpDefaultServer();\n        this.server.setHost(\"127.0.0.1\");\n        this.server.setPort(0);\n        this.server.setKeyPairProvider(KeyPairProvider.wrap(createHostKey()));\n        this.server.setPasswordAuthenticator((username, password, session) ->\n                \"user\".equals(username) && \"password\".equals(password));\n        this.server.setFileSystemFactory(new VirtualFileSystemFactory(this.serverRoot));\n        this.server.setSubsystemFactories(List.of(new SftpSubsystemFactory()));\n        this.server.start();\n\n        this.sessionFactory = new DefaultSftpSessionFactory();\n        this.sessionFactory.setHost(\"127.0.0.1\");\n        this.sessionFactory.setPort(this.server.getPort());\n        this.sessionFactory.setUser(\"user\");\n        this.sessionFactory.setPassword(\"password\");\n        this.sessionFactory.setAllowUnknownKeys(true);\n        this.sessionFactory.setTimeout(10_000);\n    }\n\n    @AfterEach\n    void stopServer() throws Exception {\n        if (this.sessionFactory != null) {\n            this.sessionFactory.destroy();\n        }\n        if (this.server != null) {\n            this.server.stop(true);\n        }\n    }\n\n    @Test\n    @Timeout(30)\n    void remoteFileTemplateTransfersReadsAndRemovesFiles() throws Exception {\n        SftpRemoteFileTemplate template = new SftpRemoteFileTemplate(this.sessionFactory);\n        template.setAutoCreateDirectory(true);\n        template.setRemoteDirectoryExpression(new LiteralExpression(\"template\"));\n        template.setFileNameExpression(new LiteralExpression(\"remote.txt\"));\n        template.afterPropertiesSet();\n\n        assertThat(template.send(new GenericMessage<>(\"template payload\"))).isNotNull();\n        assertThat(Files.readString(this.serverRoot.resolve(\"template/remote.txt\")))\n                .isEqualTo(\"template payload\");\n\n        AtomicReference<String> downloaded = new AtomicReference<>();\n        assertThat(template.get(\"template/remote.txt\", input ->\n                downloaded.set(new String(input.readAllBytes(), StandardCharsets.UTF_8)))).isTrue();\n        assertThat(downloaded.get()).isEqualTo(\"template payload\");\n        assertThat(template.list(\"template\")).hasSize(1);\n        assertThat(template.remove(\"template/remote.txt\")).isTrue();\n        assertThat(template.exists(\"template/remote.txt\")).isFalse();\n    }\n\n    @Test\n    @Timeout(30)\n    void outboundAdapterUploadsAndGatewayListsFiles() throws Exception {\n        Path outboundFile = Files.writeString(this.temporaryDirectory.resolve(\"outbound.txt\"),\n                \"outbound payload\");\n        SftpMessageHandler handler = new SftpMessageHandler(this.sessionFactory);\n        handler.setAutoCreateDirectory(true);\n        handler.setRemoteDirectoryExpression(new LiteralExpression(\"outbound\"));\n        handler.setFileNameGenerator(message -> \"adapter.txt\");\n        handler.setUseTemporaryFileName(false);\n        handler.afterPropertiesSet();\n\n        handler.handleMessage(new GenericMessage<>(outboundFile.toFile()));\n        assertThat(Files.readString(this.serverRoot.resolve(\"outbound/adapter.txt\")))\n                .isEqualTo(\"outbound payload\");\n\n        QueueChannel replies = new QueueChannel();\n        SftpOutboundGateway gateway = new SftpOutboundGateway(this.sessionFactory, \"nlst\",\n                \"'outbound'\");\n        gateway.setOutputChannel(replies);\n        gateway.afterPropertiesSet();\n        gateway.handleMessage(new GenericMessage<>(\"list outbound files\"));\n\n        Message<?> reply = replies.receive(10_000);\n        assertThat(reply).isNotNull();\n        assertThat(reply.getPayload()).isInstanceOf(List.class);\n        assertThat(((List<?>) reply.getPayload()).contains(\"adapter.txt\")).isTrue();\n    }\n\n    @Test\n    @Timeout(30)\n    void inboundSynchronizerDownloadsMatchingRemoteFiles() throws Exception {\n        Path incoming = Files.createDirectory(this.serverRoot.resolve(\"incoming\"));\n        Files.writeString(incoming.resolve(\"download.txt\"), \"inbound payload\");\n        Files.writeString(incoming.resolve(\"ignore.dat\"), \"not selected\");\n        Path localDirectory = Files.createDirectory(this.temporaryDirectory.resolve(\"local\"));\n\n        SftpInboundFileSynchronizer synchronizer = new SftpInboundFileSynchronizer(this.sessionFactory);\n        synchronizer.setRemoteDirectory(\"incoming\");\n        synchronizer.setFilter(new SftpSimplePatternFileListFilter(\"*.txt\"));\n        synchronizer.afterPropertiesSet();\n        try {\n            synchronizer.synchronizeToLocalDirectory(localDirectory.toFile());\n        }\n        finally {\n            synchronizer.close();\n        }\n\n        assertThat(Files.readString(localDirectory.resolve(\"download.txt\"))).isEqualTo(\"inbound payload\");\n        assertThat(localDirectory.resolve(\"ignore.dat\")).doesNotExist();\n    }\n\n    private static KeyPair createHostKey() throws Exception {\n        KeyPairGenerator keyPairGenerator = KeyPairGenerator.getInstance(\"RSA\");\n        keyPairGenerator.initialize(2048);\n        return keyPairGenerator.generateKeyPair();\n    }\n}\n"}], "isError": false, "timestamp": 1789137861903}]}
