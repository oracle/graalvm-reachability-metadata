ng getBeanName() {\n    69\t\t\treturn this.beanName;\n    70\t\t}\n    71\t\n    72\t\t@Override\n    73\t\tpublic void afterPropertiesSet() {\n    74\t\t\tAssert.state(this.applicationEventPublisher != null, \"An ApplicationEventPublisher is required\");\n    75\t\t}\n    76\t\n    77\t\t@Override\n    78\t\tpublic void initialized(ServerSession session, int version) {\n    79\t\t\tthis.applicationEventPublisher.publishEvent(new SessionOpenedEvent(session, version));\n    80\t\t}\n    81\t\n    82\t\t@Override\n    83\t\tpublic void destroying(ServerSession session) {\n    84\t\t\tthis.applicationEventPublisher.publishEvent(new SessionClosedEvent(session));\n    85\t\t}\n    86\t\n    87\t\t@Override\n    88\t\tpublic void created(ServerSession session, Path path, Map<String, ?> attrs, Throwable thrown) {\n    89\t\t\tthis.applicationEventPublisher.publishEvent(new DirectoryCreatedEvent(session, path, attrs));\n    90\t\t}\n    91\t\n    92\t\t@Override\n    93\t\tpublic void removed(ServerSession session, Path path, boolean isDirectory, Throwable thrown) {\n    94\t\t\tthis.applicationEventPublisher.publishEvent(new PathRemovedEvent(session, path, isDirectory, thrown));\n    95\t\t}\n    96\t\n    97\t\t@Override\n    98\t\tpublic void written(ServerSession session, String remoteHandle, FileHandle localHandle, long offset, byte[] data,\n    99\t\t\t\tint dataOffset, int dataLen, Throwable thrown) {\n   100\t\n   101\t\t\tthis.applicationEventPublisher.publishEvent(new FileWrittenEvent(session, remoteHandle, localHandle.getFile(),\n   102\t\t\t\t\tdataLen, thrown));\n   103\t\t}\n   104\t\n   105\t\t@Override\n   106\t\tpublic void moved(ServerSession session, Path srcPath, Path dstPath, Collection<CopyOption> opts,\n   107\t\t\t\tThrowable thrown) {\n   108\t\n   109\t\t\tthis.applicationEventPublisher.publishEvent(new PathMovedEvent(session, srcPath, dstPath, thrown));\n   110\t\t}\n   111\t\n   112\t\t@Override\n   113\t\tpublic String toString() {\n   114\t\t\treturn \"ApacheMinaSftpEventListener [beanName=\" + this.beanName + \"]\";\n   115\t\t}\n   116\t\n   117\t}\n    25\t * @author Gary Russell\n    26\t * @author Jooyoung Pyoung\n    27\t * @since 5.2\n    28\t *\n    29\t */\n    30\tpublic class DirectoryCreatedEvent extends ApacheMinaSftpEvent {\n    31\t\n    32\t\tprivate static final long serialVersionUID = 1L;\n    33\t\n    34\t\tprivate transient Path path;\n    35\t\n    36\t\tprivate final transient Map<String, ?> attrs;\n    37\t\n    38\t\tpublic DirectoryCreatedEvent(Object source, Path path, Map<String, ?> attrs) {\n    39\t\t\tsuper(source);\n    40\t\t\tthis.path = path;\n    41\t\t\tthis.attrs = attrs;\n    42\t\t}\n    43\t\n    44\t\tpublic Path getPath() {\n    45\t\t\treturn this.path;\n    46\t\t}\n    47\t\n    48\t\tpublic Map<String, ?> getAttrs() {\n    49\t\t\treturn this.attrs;\n    50\t\t}\n    51\t\n    52\t\t@Override\n    53\t\tpublic String toString() {\n    54\t\t\treturn \"DirectoryCreatedEvent [path=\" + this.path\n    55\t\t\t\t\t+ \", attrs=\" + this.attrs\n    56\t\t\t\t\t+ \", clientAddress=\" + getSession().getClientAddress() + \"]\";\n    57\t\t}\n    58\t\n    59\t}\n    25\t * @author Gary Russell\n    26\t *\n    27\t * @since 5.2\n    28\t *\n    29\t */\n    30\tpublic class PathMovedEvent extends ApacheMinaSftpEvent {\n    31\t\n    32\t\tprivate static final long serialVersionUID = 1L;\n    33\t\n    34\t\tprivate transient Path srcPath;\n    35\t\n    36\t\tprivate transient Path dstPath;\n    37\t\n    38\t\tpublic PathMovedEvent(Object source, Path srcPath, Path dstPath, @Nullable Throwable thrown) {\n    39\t\t\tsuper(source, thrown);\n    40\t\t\tthis.srcPath = srcPath;\n    41\t\t\tthis.dstPath = dstPath;\n    42\t\t}\n    43\t\n    44\t\tpublic Path getSrcPath() {\n    45\t\t\treturn this.srcPath;\n    46\t\t}\n    47\t\n    48\t\tpublic Path getDstPath() {\n    49\t\t\treturn this.dstPath;\n    50\t\t}\n    51\t\n    52\t\t@Override\n    53\t\tpublic String toString() {\n    54\t\t\treturn \"PathMovedEvent [srcPath=\" + this.srcPath\n    55\t\t\t\t\t+ \", dstPath=\" + this.dstPath\n    56\t\t\t\t\t+ (this.cause == null ? \"\" : \", cause=\" + this.cause)\n    57\t\t\t\t\t+ \", clientAddress=\" + getSession().getClientAddress() + \"]\";\n    58\t\t}\n    59\t\n    60\t}\n"}], "isError": false, "timestamp": 1789138574169}]}
