      20	
      21	/**
      22	 * Provides namespace support for using SFTP.
      23	 * This is largely based on the FTP support by Iwein Fuld.
      24	 *
      25	 * @author Josh Long
      26	 * @author Mark Fisher
      27	 * @author Oleg ZHurakousky
      28	 * @since 2.0
      29	 */
      30	public class SftpNamespaceHandler extends AbstractIntegrationNamespaceHandler {
      31	
      32		@Override
      33		public void init() {
      34			registerBeanDefinitionParser("inbound-channel-adapter", new SftpInboundChannelAdapterParser());
      35			registerBeanDefinitionParser("inbound-streaming-channel-adapter", new SftpStreamingInboundChannelAdapterParser());
      36			registerBeanDefinitionParser("outbound-channel-adapter", new SftpOutboundChannelAdapterParser());
      37			registerBeanDefinitionParser("outbound-gateway", new SftpOutboundGatewayParser());
      38		}
      39	
