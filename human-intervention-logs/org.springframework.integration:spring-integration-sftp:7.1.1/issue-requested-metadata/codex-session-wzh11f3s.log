/Spring_integration_sftpTest.java:290:            sessionFactory.setHost(\"127.0.0.1\");\ntests/src/org.springframework.integration/spring-integration-sftp/7.1.1/src/test/java/org_springframework_integration/spring_integration_sftp/Spring_integration_sftpTest.java:291:            sessionFactory.setPort(server.getPort());\ntests/src/org.springframework.integration/spring-integration-sftp/7.1.1/src/test/java/org_springframework_integration/spring_integration_sftp/Spring_integration_sftpTest.java:292:            sessionFactory.setUser(USERNAME);\ntests/src/org.springframework.integration/spring-integration-sftp/7.1.1/src/test/java/org_springframework_integration/spring_integration_sftp/Spring_integration_sftpTest.java:293:            sessionFactory.setPassword(PASSWORD);\ntests/src/org.springframework.integration/spring-integration-sftp/7.1.1/src/test/java/org_springframework_integration/spring_integration_sftp/Spring_integration_sftpTest.java:294:            sessionFactory.setAllowUnknownKeys(true);\ntests/src/org.springframework.integration/spring-integration-sftp/7.1.1/src/test/java/org_springframework_integration/spring_integration_sftp/Spring_integration_sftpTest.java:295:            sessionFactory.setTimeout(IO_TIMEOUT_MILLIS);\ntests/src/org.springframework.integration/spring-integration-sftp/7.1.1/src/test/java/org_springframework_integration/spring_integration_sftp/Spring_integration_sftpTest.java:296:            scenario.run(remoteRoot, sessionFactory);\ntests/src/org.springframework.integration/spring-integration-sftp/7.1.1/src/test/java/org_springframework_integration/spring_integration_sftp/Spring_integration_sftpTest.java:297:        } finally {\ntests/src/org.springframework.integration/spring-integration-sftp/7.1.1/src/test/java/org_springframework_integration/spring_integration_sftp/Spring_integration_sftpTest.java:298:            if (sessionFactory != null) {\ntests/src/org.springframework.integration/spring-integration-sftp/7.1.1/src/test/java/org_springframework_integration/spring_integration_sftp/Spring_integration_sftpTest.java:299:                sessionFactory.destroy();\ntests/src/org.springframework.integration/spring-integration-sftp/7.1.1/src/test/java/org_springframework_integration/spring_integration_sftp/Spring_integration_sftpTest.java:300:            }\ntests/src/org.springframework.integration/spring-integration-sftp/7.1.1/src/test/java/org_springframework_integration/spring_integration_sftp/Spring_integration_sftpTest.java:301:            if (server.isStarted()) {\ntests/src/org.springframework.integration/spring-integration-sftp/7.1.1/src/test/java/org_springframework_integration/spring_integration_sftp/Spring_integration_sftpTest.java:302:                server.stop(true);\ntests/src/org.springframework.integration/spring-integration-sftp/7.1.1/src/test/java/org_springframework_integration/spring_integration_sftp/Spring_integration_sftpTest.java:303:            }\ntests/src/org.springframework.integration/spring-integration-sftp/7.1.1/src/test/java/org_springframework_integration/spring_integration_sftp/Spring_integration_sftpTest.java:304:        }\ntests/src/org.springframework.integration/spring-integration-sftp/7.1.1/src/test/java/org_springframework_integration/spring_integration_sftp/Spring_integration_sftpTest.java:305:    }\ntests/src/org.springframework.integration/spring-integration-sftp/7.1.1/src/test/java/org_springframework_integration/spring_integration_sftp/Spring_integration_sftpTest.java:306:\ntests/src/org.springframework.integration/spring-integration-sftp/7.1.1/src/test/java/org_springframework_integration/spring_integration_sftp/Spring_integration_sftpTest.java:307:    @FunctionalInterface\ntests/src/org.springframework.integration/spring-integration-sftp/7.1.1/src/test/java/org_springframework_integration/spring_integration_sftp/Spring_integration_sftpTest.java:308:    private interface SftpScenario {\ntests/src/org.springframework.integration/spring-integration-sftp/7.1.