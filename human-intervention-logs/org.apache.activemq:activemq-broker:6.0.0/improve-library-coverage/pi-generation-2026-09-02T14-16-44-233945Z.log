dds a JAAS based authentication security plugin\n * \n * @org.apache.xbean.XBean description=\"Provides a JAAS based authentication plugin\"\n * \n * \n */\npublic class JaasAuthenticationPlugin implements BrokerPlugin {\n    protected String configuration = \"activemq-domain\";\n    protected boolean discoverLoginConfig = true;\n\n    public Broker installPlugin(Broker broker) {\n        initialiseJaas();\n        return new JaasAuthenticationBroker(broker, configuration);\n    }\n\n\n    // Properties\n    // -------------------------------------------------------------------------\n    public String getConfiguration() {\n        return configuration;\n    }\n\n    /**\n     * Sets the JAAS configuration domain name used\n     */\n    public void setConfiguration(String jaasConfiguration) {\n        this.configuration = jaasConfiguration;\n    }\n\n\n    public boolean isDiscoverLoginConfig() {\n        return discoverLoginConfig;\n    }\n\n    /**\n     * Enables or disables the auto-discovery of the login.config file for JAAS to initialize itself. \n     * This flag is enabled by default such that if the <b>java.security.auth.login.config</b> system property\n     * is not defined then it is set to the location of the <b>login.config</b> file on the classpath.\n     */\n    public void setDiscoverLoginConfig(boolean discoverLoginConfig) {\n        this.discoverLoginConfig = discoverLoginConfig;\n    }\n\n    // Implementation methods\n    // -------------------------------------------------------------------------\n    protected void initialiseJaas() {\n        if (discoverLoginConfig) {\n            String path = System.getProperty(\"java.security.auth.login.config\");\n            if (path == null) {\n                //URL resource = Thread.currentThread().getContextClassLoader().getResource(\"login.config\");\n                URL resource = null;\n                if (resource == null) {\n                    resource = getClass().getClassLoader().getResource(\"login.config\");\n                }\n                if (resource != null) {\n                    path = resource.getFile();\n                    System.setProperty(\"java.security.auth.login.config\", path);\n                }\n            }\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1788358671410}, {"role": "toolResult", "toolCallId": "call_y8SesiT9pmDz1n3tiqGLHEPt|fc_0a3fbbb746b27c42016a98300f1dec87d2b7c9b4b92669f06d", "toolName": "bash", "content": [{"type": "text", "text": "67:public class ManagementContext implements Service {\n101:    private int connectorPort = 1099;\n105:    private String lookupName = DEFAULT_LOOKUP_NAME;\n116:    private Remote serverStub;\n128:    public void start() throws Exception {\n166:                                    serverStub = server.toStub();\n199:    public void stop() throws Exception {\n543:                LOG.debug(\"Creating RMIRegistry on port {}\", connectorPort);\n544:                registry = jmxRegistry(connectorPort);\n555:            Attribute attr = new Attribute(\"Port\", connectorPort);\n570:        server = new RMIJRMPServerImpl(connectorPort, null, null, environment);\n572:        final String serviceURL = \"service:jmx:rmi://\" + rmiServer + \"/jndi/rmi://\" +getConnectorHost()+\":\" + connectorPort + connectorPath;\n587:            this.lookupName = DEFAULT_LOOKUP_NAME;\n589:            this.lookupName = connectorPath.replaceAll(\"^/+\", \"\").replaceAll(\"/+$\", \"\");\n594:        return connectorPort;\n600:    public void setConnectorPort(int connectorPort) {\n601:        this.connectorPort = connectorPort;\n674:    private Registry jmxRegistry(final int port) throws RemoteException {\n684:                        return lookupName.equals(args[0]) ? serverStub : null;\n692:                            return new String[] {lookupName};\n"}], "isError": false, "timestamp": 1788358671410}, {"role": "toolResult", "toolCallId": "call_iOPopGy5DVkMuBDMjiqvoWQM|fc_0a3fbbb746b27c42016a98300f1df487