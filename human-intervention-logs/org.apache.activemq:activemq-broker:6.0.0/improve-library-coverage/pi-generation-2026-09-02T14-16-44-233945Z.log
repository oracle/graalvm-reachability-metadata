Log();\n        auditLogService.setFactory(new RecordingAuditLogFactory(recordingAuditLog));\n\n        try {\n            Echo implementation = new Echo();\n            AnnotatedMBean mBean = new AnnotatedMBean(\n                    implementation,\n                    EchoMBean.class,\n                    new ObjectName(\"org.example:type=Echo,name=standard\"));\n\n            MBeanOperationInfo operation = mBean.getMBeanInfo().getOperations()[0];\n            Object result = mBean.invoke(\n                    \"echo\", new Object[] {\"message\"}, new String[] {String.class.getName()});\n\n            assertThat(operation.getDescription()).isEqualTo(\"Echoes a value\");\n            assertThat(operation.getSignature()[0].getName()).isEqualTo(\"value\");\n            assertThat(result).isEqualTo(\"echo:message\");\n            assertThat(recordingAuditLog.entries).hasSize(1);\n            AuditLogEntry entry = recordingAuditLog.entries.get(0);\n            assertThat(entry.getOperation()).endsWith(\".echo\");\n            assertThat((Object[]) entry.getParameters().get(\"arguments\")).containsExactly(\"****\");\n        } finally {\n            auditLogService.setFactory(new DefaultAuditLogFactory());\n        }\n    }\n\n    public interface EchoMBean {\n        @MBeanInfo(\"Echoes a value\")\n        String echo(@MBeanInfo(\"value\") String value);\n    }\n\n    public static final class Echo implements EchoMBean {\n        @Override\n        public String echo(@Sensitive String value) {\n            return \"echo:\" + value;\n        }\n    }\n\n    private static final class RecordingAuditLog implements AuditLog {\n        private final List<AuditLogEntry> entries = new ArrayList<>();\n\n        @Override\n        public void log(AuditLogEntry entry) {\n            entries.add(entry);\n        }\n    }\n\n    private static final class RecordingAuditLogFactory implements AuditLogFactory {\n        private final AuditLog auditLog;\n\n        private RecordingAuditLogFactory(AuditLog auditLog) {\n            this.auditLog = auditLog;\n        }\n\n        @Override\n        public List<AuditLog> getAuditLogs() {\n            return Collections.singletonList(auditLog);\n        }\n    }\n}\n"}], "isError": false, "timestamp": 1788372343266}, {"role": "toolResult", "toolCallId": "call_KSQmoBKtu6hdRO5Kmo20D0ry|fc_037f1b8e4e572eef016a9865769f7487d2aba6b000ef5eda00", "toolName": "read", "content": [{"type": "text", "text": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\nplugins {\n    id \"org.graalvm.internal.tck\"\n}\n\nString libraryVersion = tck.testedLibraryVersion.get()\n\ndependencies {\n    testImplementation \"org.apache.activemq:activemq-broker:$libraryVersion\"\n    testImplementation \"org.apache.activemq:activemq-jaas:$libraryVersion\"\n    testImplementation \"org.apache.activemq:activemq-kahadb-store:$libraryVersion\"\n    testImplementation 'org.apache.logging.log4j:log4j-core:2.20.0'\n    testImplementation 'org.bouncycastle:bcprov-jdk18on:1.77'\n    testImplementation 'org.assertj:assertj-core:3.22.0'\n}\n\nString auditProperty = \"org.apache.activemq.audit\"\n\ntasks.withType(Test).configureEach {\n    systemProperty auditProperty, \"entry\"\n}\n\ntasks.named(\"nativeTest\") {\n    runtimeArgs.add(\"-D$auditProperty=entry\")\n}\n\ngraalvmNative {\n    agent {\n        defaultMode = \"conditional\"\n        modes {\n            conditional {\n                userCodeFilterPath = \"metadata-user-code-filter.json\"\n                extraFilterPath = \"metadata-extra-filter.json\"\n            }\n        }\n    }\n}\n\ngraalvmNative {\n    agent {\n        defaultMode = \"conditional\"\n        modes {\n            conditional {\n                userCodeFilterPath = \"user-code-filter.json\"\n            }\n        }\n    }\n}\n"}], "isError": false, "tim