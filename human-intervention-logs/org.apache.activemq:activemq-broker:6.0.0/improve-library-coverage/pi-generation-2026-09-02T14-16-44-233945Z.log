          if (jobSchedulerStore == null && !hasStartException()) {
  
              if (!isPersistent()) {
                  this.jobSchedulerStore = new InMemoryJobSchedulerStore();
                  configureService(jobSchedulerStore);
                  return this.jobSchedulerStore;
              }
  
