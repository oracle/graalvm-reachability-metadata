 {\n\n    @Test\n    @ResourceLock(\"log4j-configuration\")\n    void readsAndUpdatesLog4jConfiguration() throws Exception {\n        Log4JConfigView view = new Log4JConfigView();\n        String loggerName = Log4JConfigViewTest.class.getName();\n        String originalRootLevel = view.getRootLogLevel();\n        String originalLoggerLevel = view.getLogLevel(loggerName);\n\n        try {\n            view.setRootLogLevel(\"WARN\");\n            view.setLogLevel(loggerName, \"DEBUG\");\n\n            assertThat(view.getRootLogLevel()).isEqualTo(\"WARN\");\n            assertThat(view.getLogLevel(loggerName)).isEqualTo(\"DEBUG\");\n            assertThat(view.getLoggers()).contains(loggerName);\n        } finally {\n            view.setLogLevel(loggerName, originalLoggerLevel);\n            view.setRootLogLevel(originalRootLevel);\n        }\n    }\n}\n\n--- DIFF TARGET PROJECT ---\ndiff --git a/tests/src/org.apache.activemq/activemq-broker/6.0.0/src/test/java/org_apache_activemq/activemq_broker/DefaultAuthorizationMapTest.java b/tests/src/org.apache.activemq/activemq-broker/6.0.0/src/test/java/org_apache_activemq/activemq_broker/DefaultAuthorizationMapTest.java\nindex e25311059d..3e81835a26 100644\n--- a/tests/src/org.apache.activemq/activemq-broker/6.0.0/src/test/java/org_apache_activemq/activemq_broker/DefaultAuthorizationMapTest.java\n+++ b/tests/src/org.apache.activemq/activemq-broker/6.0.0/src/test/java/org_apache_activemq/activemq_broker/DefaultAuthorizationMapTest.java\n@@ -31,7 +31,7 @@ public class DefaultAuthorizationMapTest {\n     public static final class SetterPrincipal implements Principal {\n         private String name;\n \n-        public SetterPrincipal() {}\n+        public SetterPrincipal() { }\n \n         @Override\n         public String getName() {\ndiff --git a/tests/src/org.apache.activemq/activemq-broker/6.0.0/src/test/java/org_apache_activemq/activemq_broker/DestinationsViewFilterAnonymous2Test.java b/tests/src/org.apache.activemq/activem