          this.connectorPath = connectorPath;
  
          if (connectorPath == null || connectorPath.length() == 0) {
              this.lookupName = DEFAULT_LOOKUP_NAME;
          } else {
              this.lookupName = connectorPath.replaceAll("^/+", "").replaceAll("/+$", "");
          }
      }
  
