/local_repositories/source_context/org.apache.activemq/activemq-broker/6.0.0/main/extracted/org/apache/activemq/broker/jmx/AnnotatedMBean.java:227:                  Method m = getMBeanMethod(this.getImplementationClass(), s, strings);\n/home/mihailo/git/graalvm-reachability-metadata-copy/forge/local_repositories/source_context/org.apache.activemq/activemq-broker/6.0.0/main/extracted/org/apache/activemq/broker/jmx/AnnotatedMBean.java:269:    private Method getMBeanMethod(Class clazz, String methodName, String[] signature) throws ReflectiveOperationException {\n/home/mihailo/git/graalvm-reachability-metadata-copy/forge/local_repositories/source_context/org.apache.activemq/activemq-broker/6.0.0/main/extracted/org/apache/activemq/broker/util/DefaultAuditLog.java:24:    private static final Logger LOG = LoggerFactory.getLogger(\"org.apache.activemq.audit\");\n/home/mihailo/git/graalvm-reachability-metadata-copy/forge/local_repositories/source_context/org.apache.activemq/activemq-broker/6.0.0/main/extracted/org/apache/activemq/broker/jmx/ManagedRegionBroker.java:377:            if (AsyncAnnotatedMBean.registerMBean(asyncInvokeService, mbeanTimeout, managementContext, view, key) != null) {\n/home/mihailo/git/graalvm-reachability-metadata-copy/forge/local_repositories/source_context/org.apache.activemq/activemq-broker/6.0.0/main/extracted/org/apache/activemq/broker/jmx/ManagedRegionBroker.java:434:            if (AsyncAnnotatedMBean.registerMBean(asyncInvokeService, mbeanTimeout, managementContext, view, key) != null) {\n/home/mihailo/git/graalvm-reachability-metadata-copy/forge/local_repositories/source_context/org.apache.activemq/activemq-broker/6.0.0/main/extracted/org/apache/activemq/broker/jmx/ManagedRegionBroker.java:499:            if (AsyncAnnotatedMBean.registerMBean(asyncInvokeService, mbeanTimeout, managementContext, view, key) != null) {\n/home/mihailo/git/graalvm-reachability-metadata-copy/forge/local_repositories/source_context/org.apache.activemq/activemq-bro