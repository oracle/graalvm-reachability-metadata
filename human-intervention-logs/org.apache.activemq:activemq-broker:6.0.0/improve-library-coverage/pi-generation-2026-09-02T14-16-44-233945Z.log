                  if (pa != null) {
                      this.jobSchedulerStore = pa.createJobSchedulerStore();
                      jobSchedulerStore.setDirectory(getSchedulerDirectoryFile());
                      configureService(jobSchedulerStore);
                      return this.jobSchedulerStore;
