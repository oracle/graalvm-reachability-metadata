      42	
      43	/**
      44	 * MBean that looks for method/parameter descriptions in the Info annotation.
      45	 */
      46	public class AnnotatedMBean extends StandardMBean {
      47	
      48	    private static final Map<String, Class<?>> primitives = new HashMap<String, Class<?>>();
      49	
      50	    private static final Logger LOG = LoggerFactory.getLogger("org.apache.activemq.audit");
      51	
      52	    private static final byte OFF = 0b00;
      53	    private static final byte ENTRY = 0b01;
      54	    private static final byte EXIT = 0b10;
      55	    private static final byte ALL = 0b11;
      56	
      57	    private static byte audit = OFF;
      58	    private static AuditLogService auditLog;
      59	
      60	    static {
      61	        Class<?>[] p = { byte.class, short.class, int.class, long.class, float.class, double.class, char.class, boolean.class, };
      62	        for (Class<?> c : p) {
      63	            primitives.put(c.getName(), c);
      64	        }
      65	        audit = byteFromProperty("org.apache.activemq.audit");
      66	        if (audit != OFF) {
      67	            auditLog = AuditLogService.getAuditLog();
      68	        }
      69	    }
      70	
      71	    private final ObjectName objectName;
      72	
      73	    private static byte byteFromProperty(String s) {
      74	        byte val = OFF;
      75	        String config = System.getProperty(s, "").toLowerCase(Locale.ENGLISH);
      76	        if ("true".equals(config) || "entry".equals(config)) {
      77	            val = ENTRY;
      78	        } else if ("exit".equals(config)) {
      79	            val = EXIT;
      80	        } else if ("all".equals(config)) {
      81	            val = ALL;
      82	        }
      83	        return val;
      84	    }
      85	
      86	    @SuppressWarnings({ "unchecked", "rawtypes" })
      87	    public static void registerMBean(ManagementContext context, Object object, ObjectName objectName) throws Exception {
      88	
      89	        String mbeanName = object.getClass().getName() + "MBean";
      90	
      91	        for (Class c : object.getClass().getInterfaces()) {
      92	            if (mbeanName.equals(c.getName())) {
      93	                context.registerMBean(new AnnotatedMBean(object, c, objectName), objectName);
      94	                return;
      95	            }
