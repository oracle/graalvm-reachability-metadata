\"value\");\n        assertThat(result).isEqualTo(\"echo:message\");\n    }\n", "newText": "    @Test\n    void describesAndAuditsOperationWithReferenceParameter() throws Exception {\n        RecordingAuditLog recordingAuditLog = new RecordingAuditLog();\n        AuditLogService auditLogService = AuditLogService.getAuditLog();\n        auditLogService.setFactory(new RecordingAuditLogFactory(recordingAuditLog));\n\n        try {\n            Echo implementation = new Echo();\n            AnnotatedMBean mBean = new AnnotatedMBean(\n                    implementation,\n                    EchoMBean.class,\n                    new ObjectName(\"org.example:type=Echo,name=standard\"));\n\n            MBeanOperationInfo operation = mBean.getMBeanInfo().getOperations()[0];\n            Object result = mBean.invoke(\n                    \"echo\", new Object[] {\"message\"}, new String[] {String.class.getName()});\n\n            assertThat(operation.getDescription()).isEqualTo(\"Echoes a value\");\n            assertThat(operation.getSignature()[0].getName()).isEqualTo(\"value\");\n            assertThat(result).isEqualTo(\"echo:message\");\n            assertThat(recordingAuditLog.entries).hasSize(1);\n            AuditLogEntry entry = recordingAuditLog.entries.get(0);\n            assertThat(entry.getOperation()).endsWith(\".echo\");\n            assertThat((Object[]) entry.getParameters().get(\"arguments\")).containsExactly(\"****\");\n        } finally {\n            auditLogService.setFactory(new DefaultAuditLogFactory());\n        }\n    }\n"}, {"oldText": "    public static final class Echo implements EchoMBean {\n        @Override\n        public String echo(String value) {\n            return \"echo:\" + value;\n        }\n    }\n", "newText": "    public static final class Echo implements EchoMBean {\n        @Override\n        public String echo(@Sensitive String value) {\n            return \"echo:\" + value;\n        }\n    }\n\n    private static final class RecordingAuditLog implements AuditLog {\n        private final List<AuditLogEntry> entries = new ArrayList<>();\n\n        @Override\n        public void log(AuditLogEntry entry) {\n            entries.add(entry);\n        }\n    }\n\n    private static final class RecordingAuditLogFactory implements AuditLogFactory {\n        private final AuditLog auditLog;\n\n        private RecordingAuditLogFactory(AuditLog auditLog) {\n            this.auditLog = auditLog;\n        }\n\n        @Override\n        public List<AuditLog> getAuditLogs() {\n            return Collections.singletonList(auditLog);\n        }\n    }\n"}]}
