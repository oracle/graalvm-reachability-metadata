  17:public class AntTypeDefinitionTest {
  19:    @Test
  20:    void createsRegisteredDataTypesUsingNoArgumentAndProjectConstructors() {
  21:        Project project = new Project();
  22:        ComponentHelper componentHelper = ComponentHelper.getComponentHelper(project);
  24:        AntTypeDefinition noArgumentDefinition = newDefinition("noArgumentDataType", NoArgumentDataType.class);
  25:        componentHelper.addDataTypeDefinition(noArgumentDefinition);
  27:        NoArgumentDataType noArgumentDataType =
  28:                (NoArgumentDataType) componentHelper.createDataType(noArgumentDefinition.getName());
  30:        assertThat(noArgumentDataType.getProject()).isSameAs(project);
  32:        AntTypeDefinition projectConstructorDefinition =
  33:                newDefinition("projectConstructorDataType", ProjectConstructorDataType.class);
  34:        projectConstructorDefinition.setClassLoader(ClassLoader.getSystemClassLoader());
  35:        componentHelper.addDataTypeDefinition(projectConstructorDefinition);
  37:        ProjectConstructorDataType projectConstructorDataType =
  38:                (ProjectConstructorDataType) componentHelper.createDataType(projectConstructorDefinition.getName());
  40:        assertThat(projectConstructorDataType.constructorProject).isSameAs(project);
  41:        assertThat(projectConstructorDataType.getProject()).isSameAs(project);
  42:    }
  44:    private static AntTypeDefinition newDefinition(String name, Class<?> type) {
  45:        AntTypeDefinition definition = new AntTypeDefinition();
  46:        definition.setName(name);
  47:        definition.setClassName(type.getName());
  48:        return definition;
  49:    }
  51:    public static final class NoArgumentDataType extends ProjectComponent {
  52:        public NoArgumentDataType() {
  53:        }
  54:    }
  56:    public static final class ProjectConstructorDataType extends ProjectComponent {
  57:        private final Project constructorProject;
  59:        public ProjectConstructorDataType(Project constructorProject) {
  60:            this.constructorProject = constructorProject;
  61:        }
  62:    }
  63:}
