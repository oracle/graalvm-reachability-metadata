  7:package ant.ant;
  9:import static org.assertj.core.api.Assertions.assertThat;
  10:import static org.assertj.core.api.Assertions.assertThatCode;
  12:import java.io.IOException;
  13:import java.io.InputStream;
  14:import java.net.URL;
  15:import org.apache.tools.ant.AntClassLoader;
  16:import org.apache.tools.ant.Project;
  17:import org.junit.jupiter.api.Test;
  19:public class AntClassLoaderTest {
  20:    private static final String TASK_DEFAULTS = "org/apache/tools/ant/taskdefs/defaults.properties";
  22:    @Test
  23:    void delegatesClassesAndStandardTaskResourcesToItsParent() throws IOException, ClassNotFoundException {
  24:        ClassLoader parent = AntClassLoader.class.getClassLoader();
  25:        AntClassLoader loader = new AntClassLoader(parent, true);
  27:        assertThat(loader.loadClass(Project.class.getName())).isSameAs(Project.class);
  28:        assertThat(loader.forceLoadSystemClass(String.class.getName())).isSameAs(String.class);
  30:        URL parentFirstResource = loader.getResource(TASK_DEFAULTS);
  31:        assertThat(parentFirstResource).isNotNull();
  33:        loader.setParentFirst(false);
  34:        URL loaderFirstResource = loader.getResource(TASK_DEFAULTS);
  35:        assertThat(loaderFirstResource).isEqualTo(parentFirstResource);
  37:        try (InputStream stream = loader.getResourceAsStream(TASK_DEFAULTS)) {
  38:            assertThat(stream).isNotNull();
  39:            assertThat(new String(stream.readAllBytes())).contains("echo=org.apache.tools.ant.taskdefs.Echo");
  40:        }
  41:    }
  43:    @Test
  44:    void initializesAClassThroughTheLoaderUtility() {
  45:        assertThatCode(() -> AntClassLoader.initializeClass(Project.class)).doesNotThrowAnyException();
  46:    }
  47:}
