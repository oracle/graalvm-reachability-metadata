  7:package ant.ant;
  9:import static org.assertj.core.api.Assertions.assertThat;
  11:import java.io.InputStream;
  12:import java.nio.charset.StandardCharsets;
  13:import java.nio.file.Files;
  14:import java.nio.file.Path;
  15:import javax.xml.transform.Source;
  16:import javax.xml.transform.sax.SAXSource;
  17:import org.apache.tools.ant.Project;
  18:import org.apache.tools.ant.types.Path.PathElement;
  19:import org.apache.tools.ant.types.ResourceLocation;
  20:import org.apache.tools.ant.types.XMLCatalog;
  21:import org.junit.jupiter.api.Test;
  22:import org.junit.jupiter.api.io.TempDir;
  23:import org.xml.sax.InputSource;
  25:public class XMLCatalogInnerExternalResolverTest {
  26:    private static final String EXTERNAL_PUBLIC_ID = "-//Example//DTD External Catalog//EN";
  27:    private static final String INLINE_PUBLIC_ID = "-//Example//DTD Missing Inline Catalog//EN";
  28:    private static final String UNMATCHED_PUBLIC_ID = "-//Example//DTD Unmatched Catalog//EN";
  29:    private static final String INLINE_URI = "https://example.test/missing-inline-catalog.xml";
  30:    private static final String UNMATCHED_URI = "https://example.test/unmatched-catalog.xml";
  32:    @Test
  33:    void resolvesEntriesParsedFromAnExternalCatalog(@TempDir Path temporaryDirectory) throws Exception {
  34:        Path dtdFile = Files.writeString(
  35:                temporaryDirectory.resolve("external-catalog.dtd"),
  36:                "<!ELEMENT example EMPTY>",
  37:                StandardCharsets.UTF_8);
  38:        Path catalogFile = Files.writeString(
  39:                temporaryDirectory.resolve("external-catalog.cat"),
  40:                "PUBLIC \"" + EXTERNAL_PUBLIC_ID + "\" \"" + dtdFile.getFileName() + "\"\n",
  41:                StandardCharsets.UTF_8);
  42:        XMLCatalog catalog = newCatalog(temporaryDirectory);
  43:        PathElement catalogPath = catalog.createCatalogPath().createPathElement();
  44:        catalogPath.setLocation(catalogFile.toFile());
  46:        InputSource source = catalog.resolveEntity(EXTERNAL_PUBLIC_ID, "missing.dtd");
  48:        assertThat(source).isNotNull();
  49:        try (InputStream stream = source.getByteStream()) {
  50:            assertThat(stream).isNotNull();
  51:            assertThat(new String(stream.readAllBytes(), StandardCharsets.UTF_8)).contains("example");
  52:        }
  53:    }
  55:    @Test
  56:    void delegatesUnresolvableEntityEntriesToTheExternalCatalogResolver(@TempDir Path temporaryDirectory)
  57:            throws Exception {
  58:        XMLCatalog catalog = newCatalog(temporaryDirectory);
  59:        catalog.addDTD(resourceLocation(INLINE_PUBLIC_ID, "missing-inline.dtd"));
  61:        InputSource inlineSource = catalog.resolveEntity(INLINE_PUBLIC_ID, "missing-inline.dtd");
  62:        InputSource unmatchedSource = catalog.resolveEntity(UNMATCHED_PUBLIC_ID, "unmatched.dtd");
  64:        assertThat(inlineSource).isNull();
  65:        assertThat(unmatchedSource).isNull();
  66:    }
  68:    @Test
  69:    void delegatesUnresolvableUriEntriesToTheExternalCatalogResolver(@TempDir Path temporaryDirectory)
  70:            throws Exception {
  71:        XMLCatalog catalog = newCatalog(temporaryDirectory);
  72:        catalog.addEntity(resourceLocation(INLINE_URI, "missing-inline.xml"));
  74:        Source inlineSource = catalog.resolve(INLINE_URI, temporaryDirectory.toUri().toString());
  75:        Source unmatchedSource = catalog.resolve(UNMATCHED_URI, temporaryDirectory.toUri().toString());
  77:        assertThat(inlineSource).isInstanceOf(SAXSource.class);
  78:        assertThat(((SAXSource) inlineSource).getInputSource()).isNotNull();
  79:        assertThat(unmatchedSource).isInstanceOf(SAXSource.class);
  80:        assertThat(((SAXSource) unmatchedSource).getInputSource()).isNotNull();
  81:    }
  83:    private static XMLCatalog newCatalog(Path baseDirectory) {
  84:        Project project = new Project();
  85:        project.setBaseDir(baseDirectory.toFile());
  87:        XMLCatalog catalog = new XMLCatalog();
  88:        catalog.setProject(project);
  89:        return catalog;
  90:    }
  92:    private static ResourceLocation resourceLocation(String publicId, String location) {
  93:        ResourceLocation resourceLocation = new ResourceLocation();
  94:        resourceLocation.setPublicId(publicId);
  95:        resourceLocation.setLocation(location);
  96:        return resourceLocation;
  97:    }
  98:}
