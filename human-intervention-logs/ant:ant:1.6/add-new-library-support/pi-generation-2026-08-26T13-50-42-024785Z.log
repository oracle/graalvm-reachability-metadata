  14:import org.apache.tools.ant.TaskAdapter;
  15:import org.junit.jupiter.api.Test;
  17:public class TaskAdapterTest {
  19:    @Test
  20:    void adaptsAndExecutesAPlainTaskObject() {
  21:        Project project = new Project();
  22:        AntTypeDefinition definition = new AntTypeDefinition();
  23:        definition.setName("adaptedTask");
  24:        definition.setClass(AdaptedTask.class);
  25:        definition.setAdapterClass(TaskAdapter.class);
  26:        definition.setAdaptToClass(Task.class);
  28:        definition.checkClass(project);
  29:        TaskAdapter adapter = (TaskAdapter) definition.create(project);
  30:        adapter.execute();
  32:        AdaptedTask adaptedTask = (AdaptedTask) adapter.getProxy();
  33:        assertThat(adaptedTask.project).isSameAs(project);
  34:        assertThat(adaptedTask.executed).isTrue();
  35:    }
  37:    public static final class AdaptedTask {
  38:        private Project project;
  39:        private boolean executed;
  41:        public void setProject(Project project) {
  42:            this.project = project;
  43:        }
  45:        public void execute() {
  46:            executed = true;
  47:        }
  48:    }
  49:}
