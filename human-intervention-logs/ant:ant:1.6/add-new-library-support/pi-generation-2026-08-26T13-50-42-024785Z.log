va/metadata_tests\n./tests/src/antlr/antlr/2.7.6/src/test/java/metadata_tests/antlr\n./tests/src/antlr/antlr/2.7.6/src/test/java/metadata_tests/antlr/antlr\n./tests/src/antlr/antlr/2.7.6/src/test/java/metadata_tests/antlr/antlr/LLkDebuggingParserTest.java\n./tests/src/antlr/antlr/2.7.6/src/test/java/metadata_tests/antlr/antlr/CharScannerTest.java\n./tests/src/antlr/antlr/2.7.6/src/test/java/metadata_tests/antlr/antlr/ASTFactoryTest.java\n./tests/src/antlr/antlr/2.7.6/src/test/java/metadata_tests/antlr/antlr/ToolTest.java\n./tests/src/antlr/antlr/2.7.6/src/test/java/metadata_tests/antlr/antlr/UtilsTest.java\n./tests/src/antlr/antlr/2.7.6/src/test/resources\n./tests/src/antlr/antlr/2.7.6/src/test/resources/META-INF\n./tests/src/antlr/antlr/2.7.6/src/test/resources/META-INF/native-image\n./tests/src/antlr/antlr/2.7.6/src/test/resources/META-INF/native-image/reachability-metadata.json\n./tests/src/antlr/antlr/2.7.6/user-code-filter.json\n./tests/src/antlr/antlr/2.7.6/gradle.properties\n./tests/src/antlr/antlr/2.7.6/settings.gradle\n./tests/src/antlr/antlr/2.7.6/build.gradle\n./tests/src/antlr/antlr/2.7.6/.gitignore\n./tests/src/org.objenesis/objenesis/3.2/src/test/java/org_objenesis/objenesis/GCJSerializationInstantiatorTest.java\n\n--- status ---\n\n--- test roots ---\n./tests/src/com.sun.xml.bind.external/rngom/4.0.6/src/test/java\n./tests/src/com.sun.xml.bind.external/relaxng-datatype/4.0.6/src/test/java\n./tests/src/com.ongres.stringprep/saslprep/1.1/src/test/java\n./tests/src/com.ongres.stringprep/saslprep/2.0/src/test/java\n./tests/src/com.ongres.stringprep/stringprep/1.1/src/test/java\n./tests/src/com.google.re2j/re2j/1.1/src/test/java\n./tests/src/org.jboss.arquillian.junit/arquillian-junit-container/1.1.10.Final/src/test/java\n./tests/src/org.jboss.arquillian.junit/arquillian-junit-core/1.1.10.Final/src/test/java\n./tests/src/com.github.ben-manes.caffeine/caffeine/2.9.3/src/test/java\n./tests/src/com.github.ben-manes.caffeine/caffeine/3.1.2/src/test/java\n./tests/src/com.github.ben-manes.caffeine/caffeine/3.1.8/src/test/java\n./tests/src/org.mapstruct/mapstruct/1.6.3/src/test/java\n./tests/src/com.googlecode.juniversalchardet/juniversalchardet/1.0.3/src/test/java\n./tests/src/findbugs/annotations/1.0.0/src/test/java\n./tests/src/io.opentelemetry.instrumentation/opentelemetry-kafka-clients-2.6/2.28.1-alpha/src/test/java\n./tests/src/io.opentelemetry.instrumentation/opentelemetry-spring-web-3.1/2.28.1-alpha/src/test/java\n./tests/src/io.opentelemetry.instrumentation/opentelemetry-logback-appender-1.0/2.28.1-alpha/src/test/java\n./tests/src/io.opentelemetry.instrumentation/opentelemetry-instrumentation-api-incubator/2.1.0-alpha/src/test/java\n./tests/src/io.opentelemetry.instrumentation/opentelemetry-instrumentation-annotations-support/2.28.1-alpha/src/test/java\n./tests/src/io.opentelemetry.instrumentation/opentelemetry-sdk-autoconfigure-support/2.28.1-alpha/src/test/java\n./tests/src/io.opentelemetry.instrumentation/opentelemetry-log4j-context-data-2.17-autoconfigure/2.28.1-alpha/src/test/java\n./tests/src/io.opentelemetry.instrumentation/opentelemetry-instrumentation-annotations/2.28.1/src/test/java\n./tests/src/io.opentelemetry.instrumentation/opentelemetry-resources/2.28.1-alpha/src/test/java\n./tests/src/io.opentelemetry.instrumentation/opentelemetry-mongo-3.1/2.28.1-alpha/src/test/java\n./tests/src/io.opentelemetry.instrumentation/opentelemetry-spring-webmvc-5.3/2.28.1-alpha/src/test/java\n./tests/src/io.opentelemetry.instrumentation/opentelemetry-jdbc/2.28.1-alpha/src/test/java\n./tests/src/io.opentelemetry.instrumentation/opentelemetry-declarative-config-bridge/2.28.1-alpha/src/test/java\n./tests/src/io.opentelemetry.instrumentation/opentelemetry-spring-webflux-5.3/2.28.1-alpha/src/test/java\n./tests/src/io.opentelemetry.instrumentation/opentelemetry-logback-mdc-1.0/2.28.1-alpha/src/test/java\n./tests/src/io.opentelemetry.instrumentation/opentelemetry-runtime-telemetry/2.28.1-alpha/src/test/java\n./tests/src/io.open