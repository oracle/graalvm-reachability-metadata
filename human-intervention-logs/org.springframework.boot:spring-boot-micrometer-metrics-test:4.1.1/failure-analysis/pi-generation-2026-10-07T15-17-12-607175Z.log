nablesMetricsExportWhenAnnotationIsAbsent() {\\n\"}, {\"oldText\": \"    @AutoConfigureMetrics(export = false)\\n    static class MetricsExportDisabled {\\n    }\\n\\n    @AutoConfigureMetrics\\n    static class MetricsExportEnabled {\\n\", \"newText\": \"    @AutoConfigureMetrics(export = false)\\n    static class MetricsExportDisabled {\\n    }\\n\\n    @Target(ElementType.TYPE)\\n    @Retention(RetentionPolicy.RUNTIME)\\n    @AutoConfigureMetrics(export = false)\\n    @interface MetricsExportDisabledComposed {\\n    }\\n\\n    @AutoConfigureMetrics\\n    static class MetricsExportEnabled {\\n\"}]}}], \"api\": \"openai-codex-responses\", \"provider\": \"openai-codex\", \"model\": \"gpt-5.6-luna\", \"usage\": {\"input\": 2897, \"output\": 1440, \"cacheRead\": 72192, \"cacheWrite\": 0, \"reasoning\": 973, \"totalTokens\": 76529, \"cost\": {\"input\": 0, \"output\": 0, \"cacheRead\": 0, \"cacheWrite\": 0, \"total\": 0}}, \"stopReason\": \"toolUse\", \"timestamp\": 1791382065730, \"responseId\": \"resp_0704189c6db48a12016ac65232534887d1ae1bf4b07921e1a6\", \"rawStopReason\": \"completed\"}}", "truncated": true, "truncatedBy": "bytes", "totalLines": 367, "totalBytes": 120059, "outputLines": 154, "outputBytes": 50123, "lastLinePartial": false, "firstLineExceedsLimit": false, "maxLines": 2000, "maxBytes": 51200}}, "isError": false, "timestamp": 1791386309771}, {"role": "toolResult", "toolCallId": "call_aP3Hz6W8Lm9P4fQZOF4S4ywq|fc_0c2692b267c0a834016ac662c2d7a887d19a14145eb956333c", "toolName": "read", "content": [{"type": "text", "text": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<testsuite name=\"org_springframework_boot.spring_boot_micrometer_metrics_test.Spring_boot_micrometer_metrics_testTest\" tests=\"10\" skipped=\"0\" failures=\"0\" errors=\"0\" timestamp=\"2026-10-07T15:11:12.745Z\" hostname=\"mihailo-Precision-5690\" time=\"9.248\">\n  <properties/>\n  <testcase name=\"annotationSettingTakesPrecedenceOverExportProperty()\" classname=\"org_springframework_boot.s