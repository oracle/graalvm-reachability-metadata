    \"typeReached\": \"org_springframework_boot.spring_boot_micrometer_metrics_test.Spring_boot_micrometer_metrics_testTest\"\n      },\n      \"type\": \"org.springframework.test.context.support.DefaultTestContext\",\n      \"methods\": [\n        {\n          \"name\": \"<init>\",\n          \"parameterTypes\": [\n            \"org.springframework.test.context.support.DefaultTestContext\"\n          ]\n        }\n      ]\n    },\n    {\n      \"condition\": {\n        \"typeReached\": \"org_springframework_boot.spring_boot_micrometer_metrics_test.Spring_boot_micrometer_metrics_testTest\"\n      },\n      \"type\": \"org.springframework.test.context.support.DefaultTestContextBootstrapper\",\n      \"methods\": [\n        {\n          \"name\": \"<init>\",\n          \"parameterTypes\": []\n        }\n      ]\n    },\n    {\n      \"condition\": {\n        \"typeReached\": \"org_springframework_boot.spring_boot_micrometer_metrics_test.Spring_boot_micrometer_metrics_testTest\"\n      },\n      \"type\": \"org.springframework.test.context.support.DelegatingSmartContextLoader\",\n      \"methods\": [\n        {\n          \"name\": \"<init>\",\n          \"parameterTypes\": []\n        }\n      ]\n    },\n    {\n      \"condition\": {\n        \"typeReached\": \"org_springframework_boot.spring_boot_micrometer_metrics_test.Spring_boot_micrometer_metrics_testTest\"\n      },\n      \"type\": \"org.springframework.test.context.support.DependencyInjectionTestExecutionListener\",\n      \"methods\": [\n        {\n          \"name\": \"<init>\",\n          \"parameterTypes\": []\n        }\n      ]\n    },\n    {\n      \"condition\": {\n        \"typeReached\": \"org_springframework_boot.spring_boot_micrometer_metrics_test.Spring_boot_micrometer_metrics_testTest\"\n      },\n      \"type\": \"org.springframework.test.context.support.DirtiesContextBeforeModesTestExecutionListener\",\n      \"methods\": [\n        {\n          \"name\": \"<init>\",\n          \"parameterTypes