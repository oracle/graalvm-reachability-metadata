eterRegistry.class)).isInstanceOf(SimpleMeterRegistry.class);\n            assertThat(context.getBean(ObservationRegistry.class)).isNotNull();\n\n            MeterRegistry registry = context.getBean(MeterRegistry.class);\n            Counter counter = registry.counter(\"test.requests\", \"result\", \"accepted\");\n            counter.increment(3.0);\n\n            assertThat(registry.get(\"test.requests\").tag(\"result\", \"accepted\").counter().count()).isEqualTo(3.0);\n            assertThat(context.getEnvironment().getProperty(\"management.defaults.metrics.export.enabled\")).isNull();\n        }\n    }\n\n    @Test\n    void annotationDisablesExternalExportEvenWhenTheGlobalTestPropertyEnablesIt() {\n        try (AnnotationConfigApplicationContext context =\n                loadContext(MetricsExportDisabledConfiguration.class, \"spring.test.metrics.export=true\")) {\n            assertThat(context.getEnvironment().getProperty(\"spring.test.metrics.export\")).isEqualTo(\"true\");\n            assertThat(context.getEnvironment().getProperty(\"management.defaults.metrics.export.enabled\"))\n                    .isEqualTo(\"false\");\n            assertThat(context.getEnvironment().getProperty(\"management.simple.metrics.export.enabled\"))\n                    .isEqualTo(\"true\");\n        }\n    }\n\n    private static AnnotationConfigApplicationContext loadContext(Class<?> configurationClass,\n            String... properties) {\n        AnnotationConfigApplicationContext context = new AnnotationConfigApplicationContext();\n        TestPropertyValues.of(properties).applyTo(context);\n        ContextCustomizer customizer = metricsContextCustomizerFactory().createContextCustomizer(configurationClass,\n                List.of());\n        assertThat(customizer).isNotNull();\n        customizer.customizeContext(context,\n                new MergedContextConfiguration(configurationClass, null, null, null, null));\n        context.register(configurationClass);\n        context.refresh();\n        return context;\n    }\n\n    private static ContextCustomizerFactory metricsContextCustomizerFactory() {\n        return SpringFactoriesLoader\n            .loadFactories(ContextCustomizerFactory.class, AutoConfigureMetricsIntegrationTest.class.getClassLoader())\n            .stream()\n            .filter((factory) -> factory.getClass().getName().equals(METRICS_CONTEXT_CUSTOMIZER_FACTORY))\n            .findFirst()\n            .orElseThrow(() -> new IllegalStateException(\"Metrics context customizer factory was not loaded\"));\n    }\n\n    @Configuration(proxyBeanMethods = false)\n    @AutoConfigureMetrics\n    static class MetricsEnabledConfiguration {\n    }\n\n    @Configuration(proxyBeanMethods = false)\n    @AutoConfigureMetrics(export = false)\n    static class MetricsExportDisabledConfiguration {\n    }\n}\n"}
