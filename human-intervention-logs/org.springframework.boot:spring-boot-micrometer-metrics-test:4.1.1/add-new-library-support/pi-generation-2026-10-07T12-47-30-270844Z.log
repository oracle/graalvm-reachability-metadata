m_mxue0c5jm21tjXTIw8VcWj_-bthVwYLcdg==\",\"summary\":[{\"type\":\"summary_text\",\"text\":\"**Refactoring test configuration and annotations**\"},{\"type\":\"summary_text\",\"text\":\"**Implementing context setup with customizer**\"}]}"}, {"type": "toolCall", "id": "call_aYcVLajIbDgztXvDV4Osuo0H|fc_0f60cd5d66dab6f2016ac641b0baa887d085df63b03dcb13b2", "name": "write", "arguments": {"path": "tests/src/org.springframework.boot/spring-boot-micrometer-metrics-test/4.1.1/src/test/java/org_springframework_boot/spring_boot_micrometer_metrics_test/AutoConfigureMetricsIntegrationTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_springframework_boot.spring_boot_micrometer_metrics_test;\n\nimport java.util.List;\n\nimport io.micrometer.core.instrument.Counter;\nimport io.micrometer.core.instrument.MeterRegistry;\nimport io.micrometer.core.instrument.simple.SimpleMeterRegistry;\nimport io.micrometer.observation.ObservationRegistry;\nimport org.junit.jupiter.api.Test;\n\nimport org.springframework.boot.micrometer.metrics.test.autoconfigure.AutoConfigureMetrics;\nimport org.springframework.boot.test.util.TestPropertyValues;\nimport org.springframework.context.annotation.AnnotationConfigApplicationContext;\nimport org.springframework.context.annotation.Configuration;\nimport org.springframework.core.io.support.SpringFactoriesLoader;\nimport org.springframework.test.context.ContextCustomizer;\nimport org.springframework.test.context.ContextCustomizerFactory;\nimport org.springframework.test.context.MergedContextConfiguration;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\npublic class AutoConfigureMetricsIntegrationTest {\n\n    private static final String METRICS_CONTEXT_CUSTOMIZER_FACTORY =\n            \"org.springframework.boot.micrometer.metrics.test.autoconfigure.MetricsContextCustomizerFactory\";\n\n    @Test\n    void importsUsableInMemoryMetricsAndObservationInfrastructure() {\n        try (AnnotationConfigApplicationContext context = loadContext(MetricsEnabledConfiguration.class)) {\n            assertThat(context.getBean(MeterRegistry.class)).isInstanceOf(SimpleMeterRegistry.class);\n            assertThat(context.getBean(ObservationRegistry.class)).isNotNull();\n\n            MeterRegistry registry = context.getBean(MeterRegistry.class);\n            Counter counter = registry.counter(\"test.requests\", \"result\", \"accepted\");\n            counter.increment(3.0);\n\n            assertThat(registry.get(\"test.requests\").tag(\"result\", \"accepted\").counter().count()).isEqualTo(3.0);\n            assertThat(context.getEnvironment().getProperty(\"management.defaults.metrics.export.enabled\")).isNull();\n        }\n    }\n\n    @Test\n    void annotationDisablesExternalExportEvenWhenTheGlobalTestPropertyEnablesIt() {\n        try (AnnotationConfigApplicationContext context =\n                loadContext(MetricsExportDisabledConfiguration.class, \"spring.test.metrics.export=true\")) {\n            assertThat(context.getEnvironment().getProperty(\"spring.test.metrics.export\")).isEqualTo(\"true\");\n            assertThat(context.getEnvironment().getProperty(\"management.defaults.metrics.export.enabled\"))\n                    .isEqualTo(\"false\");\n            assertThat(context.getEnvironment().getProperty(\"management.simple.metrics.export.enabled\"))\n                    .isEqualTo(\"true\");\n        }\n    }\n\n    private static AnnotationConfigApplicationContext loadContext(Class<?> configurationClass,\n            String... properties) {\n        AnnotationConfigApplicationContext context = new AnnotationConfigApplicationContext();\n        TestPropertyValues.of(properties).applyTo(context);\n        ContextCustomizer customizer = metricsContextCustomizerFactory().createContextCustomizer(configurationClass,\n                List.of());\n        assertThat(customizer).isNotNull();\n        customizer.customizeContext(context,\n                new MergedContextConfiguration(configurationClass, null, null, null, null));\n        context.register(configurationClass);\n        context.refresh();\n        return context;\n    }\n\n    private static ContextCustomizerFactory metricsContextCustomizerFactory() {\n        return SpringFactoriesLoader\n            .loadFactories(ContextCustomizerFactory.class, AutoConfigureMetricsIntegrationTest.class.getClassLoader())\n            .stream()\n            .filter((factory) -> factory.getClass().getName().equals(METRICS_CONTEXT_CUSTOMIZER_FACTORY))\n            .findFirst()\n            .orElseThrow(() -> new IllegalStateException(\"Metrics context customizer factory was not loaded\"));\n    }\n\n    @Configuration(proxyBeanMethods = false)\n    @AutoConfigureMetrics\n    static class MetricsEnabledConfiguration {\n    }\n\n    @Configuration(proxyBeanMethods = false)\n    @AutoConfigureMetrics(export = false)\n    static class MetricsExportDisabledConfiguration {\n    }\n}\n"}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-sol", "usage": {"input": 1513, "output": 1887, "cacheRead": 67584, "cacheWrite": 0, "reasoning": 913, "totalTokens": 70984, "cost": {"input": 0.006052, "output": 0.03774, "cacheRead": 0.0270336, "cacheWrite": 0, "total": 0.0708256}}, "stopReason": "toolUse", "timestamp": 1791377805773, "responseId": "resp_0f60cd5d66dab6f2016ac6418e8ea487d0a346e899a0f50f54", "rawStopReason": "completed"}}
