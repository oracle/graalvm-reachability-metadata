dText": "import org.springframework.context.support.GenericApplicationContext;\n", "newText": "import org.springframework.context.annotation.AnnotationConfigApplicationContext;\nimport org.springframework.context.support.GenericApplicationContext;\n"}, {"oldText": "    @Test\n    void absentAnnotationDisablesExternalExportAndRetainsSimpleMetrics() {\n", "newText": "    @Test\n    void annotationCreatesAnInMemoryRegistryThatRecordsMetrics() {\n        try (AnnotationConfigApplicationContext context =\n                new AnnotationConfigApplicationContext(MetricsEnabledConfiguration.class)) {\n            MeterRegistry registry = context.getBean(MeterRegistry.class);\n            Counter counter = registry.counter(\"test.requests\", \"outcome\", \"accepted\");\n\n            counter.increment(2.0);\n\n            assertThat(registry.find(\"test.requests\").tag(\"outcome\", \"accepted\").counter()).isSameAs(counter);\n            assertThat(counter.count()).isEqualTo(2.0);\n        }\n    }\n\n    @Test\n    void absentAnnotationDisablesExternalExportAndRetainsSimpleMetrics() {\n"}]}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-sol", "usage": {"input": 1218, "output": 1101, "cacheRead": 44672, "cacheWrite": 0, "reasoning": 729, "totalTokens": 46991, "cost": {"input": 0.004872, "output": 0.02202, "cacheRead": 0.0178688, "cacheWrite": 0, "total": 0.0447608}}, "stopReason": "toolUse", "timestamp": 1791378444213, "responseId": "resp_08de95fe082c3e2b016ac6440cd1e087d0a7037c93e996ebde", "rawStopReason": "completed"}}
