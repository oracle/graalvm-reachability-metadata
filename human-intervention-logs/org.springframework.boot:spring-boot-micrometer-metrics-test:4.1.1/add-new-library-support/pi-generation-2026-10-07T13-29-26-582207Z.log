                      assertThat(context).hasSingleBean(OpenTelemetrySdk.class);
                      assertThat(context).doesNotHaveBean(SdkLoggerProvider.class);
                      assertThat(context.getBean(OpenTelemetrySdk.class).shutdown().join(10, TimeUnit.SECONDS)
