ns.factory.annotation.Autowired;\nimport org.springframework.boot.SpringBootConfiguration;\nimport org.springframework.boot.autoconfigure.EnableAutoConfiguration;\nimport org.springframework.boot.micrometer.metrics.test.autoconfigure.AutoConfigureMetrics;\nimport org.springframework.boot.test.context.SpringBootTest;\nimport org.springframework.context.ApplicationContext;\nimport org.springframework.core.env.Environment;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\npublic class Spring_boot_micrometer_metrics_testTest {\n\n    @SpringBootConfiguration\n    @EnableAutoConfiguration\n    static class MetricsTestApplication {\n    }\n\n    @Nested\n    @SpringBootTest(classes = MetricsTestApplication.class)\n    @AutoConfigureMetrics\n    class MetricsExportEnabledTests {\n\n        @Autowired\n        private ApplicationContext applicationContext;\n\n        @Autowired\n        private Environment environment;\n\n        @Autowired\n        private MeterRegistry meterRegistry;\n\n        @Autowired\n        private ObservationRegistry observationRegistry;\n\n        @Test\n        void annotationLeavesExportConfigurationEnabledAndProvidesRegistries() {\n            assertThat(this.applicationContext.getBean(MeterRegistry.class)).isSameAs(this.meterRegistry);\n            assertThat(this.applicationContext.getBean(ObservationRegistry.class)).isSameAs(this.observationRegistry);\n            assertThat(this.environment.containsProperty(\"management.defaults.metrics.export.enabled\")).isFalse();\n            assertThat(this.environment.containsProperty(\"management.simple.metrics.export.enabled\")).isFalse();\n\n            Counter counter = this.meterRegistry.counter(\"application.requests\", \"status\", \"ok\");\n            counter.increment(3.0);\n\n            assertThat(counter.count()).isEqualTo(3.0);\n        }\n\n    }\n\n    @Nested\n    @SpringBootTest(classes = MetricsTestApplication.class)\n    @AutoConfigureMetrics(export = false)\n    class MetricsExportDisabledTests {\n\n        @Autowired\n        private ApplicationContext applicationContext;\n\n        @Autowired\n        private Environment environment;\n\n        @Autowired\n        private MeterRegistry meterRegistry;\n\n        @Autowired\n        private ObservationRegistry observationRegistry;\n\n        @Test\n        void annotationDisablesExternalExportAndProvidesInMemoryRegistries() {\n            assertThat(this.meterRegistry).isInstanceOf(SimpleMeterRegistry.class);\n            assertThat(this.applicationContext.getBean(ObservationRegistry.class)).isSameAs(this.observationRegistry);\n            assertThat(this.environment.getProperty(\"management.defaults.metrics.export.enabled\"))\n                .isEqualTo(\"false\");\n            assertThat(this.environment.getProperty(\"management.simple.metrics.export.enabled\")).isEqualTo(\"true\");\n\n            Counter counter = this.meterRegistry.counter(\"application.requests\", \"status\", \"accepted\");\n            counter.increment();\n\n            assertThat(this.meterRegistry.get(\"application.requests\").counter().count()).isEqualTo(1.0);\n        }\n\n    }\n\n}\n"}]}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-luna", "usage": {"input": 3682, "output": 4256, "cacheRead": 70144, "cacheWrite": 0, "reasoning": 3435, "totalTokens": 78082, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1791344890817, "responseId": "resp_0af86cda2a74782d016ac5c0fb5e6887d187544dbbcff174c5", "rawStopReason": "completed"}, "toolResults": [{"role": "toolResult", "toolCallId": "call_7ZxrOKSnN0a9UTeXIuFzCWFD|fc_0af86cda2a74782d016ac5c139fcb887d1a0aacce876c1c730", "toolName": "edit", "content": [{"type": "text", "text": "Successfully replaced 1 block(s) in tests/src/org.springframework.boot/spring-boot-micrometer-metrics-test/4.1.1/src/test/java/org_springframework_boot/spring_boot_micrometer_metrics_