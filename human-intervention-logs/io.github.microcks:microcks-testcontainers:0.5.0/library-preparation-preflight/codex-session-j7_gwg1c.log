s.core5/httpcore5-h2/5.4.3/execution-metrics.json:78:      \"agent_guidance\": \"Use the artifact's own APIs; do not add httpclient5, Elasticsearch, Conscrypt, Docker, or an external HTTPS service. Create SSLParameters, set retransmissions to true, then call H2TlsSupport.enforceRequirements(HttpVersionPolicy.NEGOTIATE, parameters) and assert retransmissions become false and ALPN protocols are configured. This reaches the reflective setEnableRetransmissions call in the production path. No environment variables or system properties are required. See [the artifact dependencies](https://hc.apache.org/httpcomponents-core-5.4.x/5.4.3/httpcore5-h2/dependencies.html) and [H2TlsSupport](https://raw.githubusercontent.com/apache/httpcomponents-core/rel/v5.4.3/httpcore5-h2/src/main/java/org/apache/hc/core5/http2/ssl/H2TlsSupport.java).\",\n./stats/org.springframework.security/spring-security-oauth2-resource-server/7.1.0/execution-metrics.json:47:      \"deterministic_setup\": [],\n./stats/org.springframework.security/spring-security-oauth2-resource-server/7.1.0/execution-metrics.json:48:      \"agent_guidance\": \"\",\n./stats/org.springframework.security/spring-security-oauth2-jose/7.1.0/execution-metrics.json:47:      \"deterministic_setup\": [],\n./stats/org.springframework.security/spring-security-oauth2-jose/7.1.0/execution-metrics.json:48:      \"agent_guidance\": \"\",\n./stats/io.circe/circe-generic_3/0.14.12/execution-metrics.json:47:      \"deterministic_setup\": [],\n./stats/io.circe/circe-generic_3/0.14.12/execution-metrics.json:48:      \"agent_guidance\": \"No environment variables or system properties are required. Meaningful tests should use Scala 3 case classes or sealed traits with io.circe.generic.semiauto._ or io.circe.generic.auto._, plus circe-core APIs such as io.circe.syntax._ and Json/hcursor decoding.\",\n./stats/com.github.ghik/silencer-lib_2.13.12/1.7.14/execution-metrics.json:47:      \"deterministic_setup\": [\n./stats/com.github.ghik/silencer-lib_2.13.12/1.7.14/execution-metrics.json:55:      \"agent_guidance\": \"Tests should treat this as compile-time Scala functionality. Meaningful coverage should compile temporary Scala 2.13.12 source that imports com.github.ghik.silencer.silent, applies @silent to code that would otherwise warn, enables warning flags such as -deprecation or -Xlint, and asserts the expected compiler outcome. Use temporary files/directories only; no Docker image, service, environment variable, or system property appears required.\",\n./stats/org.jctools/jctools-core/4.0.3/execution-metrics.json:53:      \"deterministic_setup\": [],\n./stats/org.jctools/jctools-core/4.0.3/execution-metrics.json:54:      \"agent_guidance\": \"Directly instantiate an Unsafe-backed linked queue such as `MpscLinkedQueue`, then exercise construction and `offer`/`poll`. No environment variables or system properties are required.\",\n./stats/io.prometheus/simpleclient_common/0.16.0/execution-metrics.json:47:      \"deterministic_setup\": [],\n./stats/io.prometheus/simpleclient_common/0.16.0/execution-metrics.json:48:      \"agent_guidance\": \"\",\n./stats/org.hsqldb/hsqldb/2.7.3/execution-metrics.json:52:      \"deterministic_setup\": [],\n./stats/org.hsqldb/hsqldb/2.7.3/execution-metrics.json:53:      \"agent_guidance\": \"\",\n./stats/org.apache.commons/commons-lang3/3.19.0/execution-metrics.json:89:      \"deterministic_setup\": [],\n./stats/org.apache.commons/commons-lang3/3.19.0/execution-metrics.json:90:      \"agent_guidance\": \"\",\n./stats/org.apache.maven.plugin-tools/maven-plugin-annotations/3.1/execution-metrics.json:47:      \"deterministic_setup\": [],\n./stats/org.apache.maven.plugin-tools/maven-plugin-annotations/3.1/execution-metrics.json:48:      \"agent_guidance\": \"No environment variables or system properties are needed. Be aware that the annotations use RetentionPolicy.CLASS, so runtime reflection on annotated test classes will not find @Mojo/@Parameter/@Component/@Execute; tests should inspect annotation type metadata/default values or classfile-visible annotation attributes if they need to assert annotation usage.\",\n./stats/org.scalatestplus/mockito-5-12_3/3.2.19.0/execution-metrics.json:47:      \"deterministic_setup\": [],\n./stats/org.scalatestplus/mockito-5-12_3/3.2.19.0/execution-metrics.json:48:      \"agent_guidance\": \"Add test resource `src/test/resources/mockito-extensions/org.mockito.plugins.MockMaker` with content `mock-maker-proxy` so Mockito uses its proxy mock maker. Write coverage around `org.scalatestplus.mockito.MockitoSugar` by mocking Scala traits or Java interfaces only, and exercise `mock[T]`, named/default-answer/settings overloads, and `capture[T]`; avoid class/final-class mocks because the proxy mock maker only supports interfaces/traits.\",\n./stats/org.jetbrains.kotlinx/kotlinx-coroutines-debug/1.10.2/execution-metrics.json:47:      \"deterministic_setup\": [],\n./stats/org.jetbrains.kotlinx/kotlinx-coroutines-debug/1.10.2/execution-metrics.json:48:      \"agent_guidance\": \"\",\n./stats/org.jetbrains.kotlinx/kotlinx-coroutines-swing/1.10.2/execution-metrics.json:47:      \"deterministic_setup\": [],\n./stats/org.jetbrains.kotlinx/kotlinx-coroutines-swing/1.10.2/execution-metrics.json:48:      \"agent_guidance\": \"\",\n./stats/io.ktor/ktor-server-call-logging-jvm/3.4.3/execution-metrics.json:47:      \"deterministic_setup\": [\n./stats/io.ktor/ktor-server-call-logging-jvm/3.4.3/execution-metrics.json:55:      \"agent_guidance\": \"Use Ktor's testApplication to install CallLogging, define simple routing, and issue client requests. For assertions, inject a custom in-memory org.slf4j.Logger through the Ktor application environment or CallLogging configuration instead of relying on an external SLF4J binding. Configure deterministic clock values and consider disableDefaultColors() when asserting log text.\",\n./stats/io.ktor/ktor-serialization-kotlinx-cbor-jvm/3.4.3/execution-metrics.json:47:      \"deterministic_setup\": [],\n./stats/io.ktor/ktor-serialization-kotlinx-cbor-jvm/3.4.3/execution-metrics.json:48:      \"agent_guidance\": \"\",\n./stats/io.ktor/ktor-http-jvm/3.2.0/execution-metrics.json:53:      \"deterministic_setup\": [],\n./stats/io.ktor/ktor-http-jvm/3.2.0/execution-metrics.json:54:      \"agent_guidance\": \"\",\n./stats/io.ktor/ktor-client-cio-jvm/3.2.0/execution-metrics.json:47:      \"deterministic_setup\": [],\n./stats/io.ktor/ktor-client-cio-jvm/3.2.0/execution-metrics.json:48:      \"agent_guidance\": \"\",\n./stats/org.bouncycastle/bc-fips/2.1.2/execution-metrics.json:52:      \"deterministic_setup\": [],\n./stats/org.bouncycastle/bc-fips/2.1.2/execution-metrics.json:53:      \"agent_guidance\": \"In tests, add `new BouncyCastleFipsProvider()` through `Security.addProvider` before obtaining BCFIPS algorithms, then exercise provider-backed crypto. For native tests, configure BCFIPS as a security provider during image generation; runtime-only registration fails with Native Image provider-verification errors. Set `org.bouncycastle.native.cpu_variant=java` for native-image tests to disable BC-FIPS extraction/loading of its bundled Linux JNI acceleration libraries.\",\n./stats/org.bouncycastle/bc-fips/2.1.2/execution-metrics.json:142:      \"deterministic_setup\": [],\n./stats/org.bouncycastle/bc-fips/2.1.2/execution-metrics.json:143:      \"agent_guidance\": \"Register `new BouncyCastleFipsProvider()` with `Security.addProvider` before requesting BCFIPS algorithms. For native tests, add `-H:AdditionalSecurityProviders=org.bouncycastle.jcajce.provider.BouncyCastleFipsProvider` at image build time and set `org.bouncycastle.native.cpu_variant=java` for both image build (`-J-D...`) and runtime (`-D...`) to disable extraction of the artifact's bundled Linux JNI acceleration libraries.\",\n./stats/org.bouncycastle/bc-fips/2.1.2/execution-metrics.json:227:      \"agent_guidance\": \"Register BouncyCastleFipsProvider before exercising JCA APIs. Configure Native Image with -H:AdditionalSecurityProviders=org.bouncycastle.jcajce.provider.BouncyCastleFipsProvider. Set org.bouncycastle.native.cpu_variant=java for deterministic execution without platform-specific native code, and set jdk.util.jar.version=9 for the Java 9+ jar behavior used by this artifact. Exercise provider-backed algorithms through public JCA APIs and preserve reflection/serialization metadata discovered by the tests.\",\n./stats/org.bouncycastle/bc-fips/2.1.2/execution-metrics.json:229:      \"deterministic_setup\": [],\n./stats/io.sundr/sundr-model-repo/0.230.1/execution-metrics.json:47:      \"deterministic_setup\": [],\n./stats/io.sundr/sundr-model-repo/0.230.1/execution-metrics.json:48:      \"agent_guidance\": \"\",\n./stats/io.sundr/sundr-adapter-reflect/0.230.1/execution-metrics.json:53:      \"deterministic_setup\": [],\n./stats/io.sundr/sundr-adapter-reflect/0.230.1/execution-metrics.json:54:      \"agent_guidance\": \"\",\n./stats/org.springframework/spring-core/5.3.15/execution-metrics.json:58:      \"deterministic_setup\": [],\n./stats/org.springframework/spring-core/5.3.15/execution-metrics.json:59:      \"agent_guidance\": \"\",\n./stats/org.springframework/spring-core/5.3.15/execution-metrics.json:154:      \"deterministic_setup\": [\n./stats/org.springframework/spring-core/5.3.15/execution-metrics.json:162:      \"agent_guidance\": \"No environment variables, system properties, Docker images, or special runtime setup are required. Include classpath-resource and temporary-filesystem fixtures when exercising resource APIs.\",\n./stats/org.springframework/spring-core/5.3.15/execution-metrics.json:263:      \"deterministic_setup\": [\n./stats/org.springframework/spring-core/5.3.15/execution-metrics.json:277:      \"agent_guidance\": \"Add --add-opens=java.base/java.io=ALL-UNNAMED to JVM test arguments and Native Image build arguments for Objenesis/ObjectStreamClass serialization coverage. Include a spring.properties test resource only when testing SpringProperties loading.\",\n./stats/org.springframework/spring-core/5.3.15/execution-metrics.json:384:      \"deterministic_setup\": [\n./stats/org.springframework/spring-core/5.3.15/execution-metrics.json:398:      \"agent_guidance\": \"Add --add-opens=java.base/java.io=ALL-UNNAMED to JVM test arguments and Native Image build arguments when exercising Objenesis/ObjectStream serialization paths. Add classpath resource fixtures, including spring.properties, only for tests covering resource loading or SpringProperties.\",\n./stats/org.springframework/spring-websocket/6.2.10/execution-metrics.json:47:      \"deterministic_setup\": [\n./stats/org.springframework/spring-websocket/6.2.10/execution-metrics.json:55:      \"agent_guidance\": \"No environment variable, system property, Docker image, external broker, or browser is required. Prefer in-process tests with fake WebSocket sessions/clients, Spring MessageChannels, STOMP frames, and the simple broker. Avoid full servlet-container deployment unless local verification shows it is necessary.\",\n./stats/org.slf4j/slf4j-log4j12/1.6.1/execution-metrics.json:53:      \"deterministic_setup\": [],\n./stats/org.slf4j/slf4j-log4j12/1.6.1/execution-metrics.json:54:      \"agent_guidance\": \"For meaningful assertions, attach a Log4j 1.2 test appender programmatically to the root logger and reset its configuration afterward; no log4j.properties or system property is required.\",\n./stats/com.oracle.database.jdbc/ojdbc11/23.26.2.0.0/execution-metrics.json:58:      \"deterministic_setup\": [],\n./stats/com.oracle.database.jdbc/ojdbc11/23.26.2.0.0/execution-metrics.json:59:      \"agent_guidance\": \"Exercise thin-driver APIs such as OracleDriver registration/URL acceptance, property inspection, OracleDataSource configuration, and connection-builder setup without opening a network connection. Avoid OCI, wallet/TCPS, FAN/RAC, pooling, and SQL integration paths unless separately provisioned.\",\n./stats/com.oracle.database.jdbc/ojdbc11/23.26.2.0.0/execution-metrics.json:154:      \"deterministic_setup\": [\n./stats/com.oracle.database.jdbc/ojdbc11/23.26.2.0.0/execution-metrics.json:174:      \"agent_guidance\": \"Exercise sharding and True Cache with their documented connection properties. Use a closed local endpoint with bounded oracle.net.CONNECT_TIMEOUT and oracle.jdbc.ReadTimeout; do not require an Oracle server. Scope and restore oracle.jdbc.diagnostic.enableObservability for DMS tests. Create wallets in temporary directories without requiring pre-existing wallet files or TNS_ADMIN.\",\n./stats/com.oracle.database.jdbc/ojdbc11/23.26.2.0.0/execution-metrics.json:288:      \"deterministic_setup\": [],\n./stats/com.oracle.database.jdbc/ojdbc11/23.26.2.0.0/execution-metrics.json:289:      \"agent_guidance\": \"\",\n./stats/com.oracle.database.jdbc/ojdbc11/23.26.2.0.0/execution-metrics.json:380:      \"deterministic_setup\": [\n./stats/com.oracle.database.jdbc/ojdbc11/23.26.2.0.0/execution-metrics.json:412:      \"agent_guidance\": \"Set system property oracle.jdbc.diagnostic.enableObservability=true for JVM tests and native-test runtime so observability and DMS paths initialize deterministically. Use offline driver, wallet, type, and bounded connection-failure tests; an Oracle database container is not required.\",\n./stats/com.oracle.database.jdbc/ojdbc11/23.26.2.0.0/execution-metrics.json:538:      \"deterministic_setup\": [\n./stats/com.oracle.database.jdbc/ojdbc11/23.26.2.0.0/execution-metrics.json:570:      \"agent_guidance\": \"Set oracle.jdbc.diagnostic.enableObservability=true for JVM and Native Image test execution so the observability path is reachable. Use offline fixtures and bounded loopback failures; an Oracle database Docker image is not required for initial coverage. [Oracle property reference](https://docs.oracle.com/en/database/oracle/oracle-database/26/jajdb/oracle/jdbc/OracleConnection.html)\",\n./stats/com.twitter/chill-java/0.10.0/execution-metrics.json:53:      \"deterministic_setup\": [],\n./stats/com.twitter/chill-java/0.10.0/execution-metrics.json:54:      \"agent_guidance\": \"Do not add Maven dependencies or Docker services. Tests should exercise normal in-memory usage via KryoInstantiator/KryoPool and PackageRegistrar.all(). Because chill-java 0.10.0 serializers reflect into private java.util implementation fields such as Arrays$ArrayList.a, BitSet.words, PriorityQueue.comparator, and Collections unmodifiable wrappers, configure the generated JVM test run with the JVM argument --add-opens=java.base/java.util=ALL-UNNAMED before exercising PackageRegistrar/all Java collection serializers.\",\n./stats/com.lihaoyi/pprint_2.13/0.9.0/execution-metrics.json:47:      \"deterministic_setup\": [],\n./stats/com.lihaoyi/pprint_2.13/0.9.0/execution-metrics.json:48:      \"agent_guidance\": \"\",\n./stats/io.opentelemetry.contrib/opentelemetry-aws-resources/1.57.0-alpha/execution-metrics.json:47:      \"deterministic_setup\": [],\n./stats/io.opentelemetry.contrib/opentelemetry-aws-resources/1.57.0-alpha/execution-metrics.json:48:      \"agent_guidance\": \"\",\n./stats/io.opentelemetry.contrib/opentelemetry-azure-resources/1.57.0-alpha/execution-metrics.json:47:      \"deterministic_setup\": [\n./stats/io.opentelemetry.contrib/opentelemetry-azure-resources/1.57.0-alpha/execution-metrics.json:61:      \"agent_guidance\": \"Exercise the resource detectors with simulated Azure inputs. Prefer putting tests in package io.opentelemetry.contrib.azure.resource so they can use the package-private constructors that accept Map<String,String> environments or Supplier<Optional<String>> metadata JSON. Cover App Service/Functions/Container Apps with representative WEBSITE_*, FUNCTIONS_EXTENSION_VERSION, CONTAINER_APP_* values. Cover VM/AKS by supplying Azure Instance Metadata Service JSON through the test supplier; avoid relying on the hardcoded 169.254.169.254 metadata endpoint because it may time out or be unavailable.\",\n./stats/io.opentelemetry.contrib/opentelemetry-cloudfoundry-resources/1.57.0-alpha/execution-metrics.json:47:      \"deterministic_setup\": [\n./stats/io.opentelemetry.contrib/opentelemetry-cloudfoundry-resources/1.57.0-alpha/execution-metrics.json:61:      \"agent_guidance\": \"Set VCAP_APPLICATION for tests that exercise CloudFoundryResource.get(), ResourceProvider, ServiceLoader, or autoconfiguration. Use a JSON object with fields such as application_id, application_name, instance_index, organization_id, organization_name, process_id, process_type, space_id, and space_name. Ensure the variable is present before CloudFoundryResource is first loaded because the public singleton is initialized from System.getenv at class initialization. Parser edge cases can alternatively be tested from the same package via buildResource(Function<String,String>).\",\n./stats/io.opentelemetry.contrib/opentelemetry-baggage-processor/1.57.0-alpha/execution-metrics.json:47:      \"deterministic_setup\": [],\n./stats/io.opentelemetry.contrib/opentelemetry-baggage-processor/1.57.0-alpha/execution-metrics.json:48:      \"agent_guidance\": \"\",\n./stats/io.opentelemetry.contrib/opentelemetry-samplers/1.57.0-alpha/execution-metrics.json:47:      \"deterministic_setup\": [\n./stats/io.opentelemetry.contrib/opentelemetry-samplers/1.57.0-alpha/execution-metrics.json:61:      \"agent_guidance\": \"No Docker image or external service is needed. For autoconfigure coverage, configure tests with an in-memory properties supplier such as `otel.traces.sampler=linksbased_parentbased_always_on`. For declarative-config coverage, use an in-memory YAML/string configuration for `rule_based_routing`; no environment variables or system properties are required.\",\n./stats/org.apache.kafka/kafka-clients/4.2.1/execution-metrics.json:124:      \"deterministic_setup\": [],\n./stats/org.apache.kafka/kafka-clients/4.2.1/execution-metrics.json:125:      \"agent_guidance\": \"\",\n./stats/org.apache.kafka/kafka-clients/4.2.1/execution-metrics.json:216:      \"deterministic_setup\": [\n./stats/org.apache.kafka/kafka-clients/4.2.1/execution-metrics.json:230:      \"agent_guidance\": \"No Kafka Docker broker is required for baseline coverage; prefer MockProducer, MockConsumer, serializers/deserializers, config instantiation, and Kafka test fixtures. If exercising Kerberos/SASL internals on JDK 21 or in native-image, pass --add-exports=java.security.jgss/sun.security.krb5=ALL-UNNAMED to JVM tests and native-image build arguments. If using a JUnit extension to force IBM-vendor branches, set junit.jupiter.extensions.autodetection.enabled=true for JVM and native runs.\",\n./stats/io.opentelemetry.semconv/opentelemetry-semconv-incubating/1.41.1-alpha/execution-metrics.json:47:      \"deterministic_setup\": [\n./stats/io.opentelemetry.semconv/opentelemetry-semconv-incubating/1.41.1-alpha/execution-metrics.json:55:      \"agent_guidance\": \"\",\n./stats/io.grpc/grpc-auth/1.68.0/execution-metrics.json:53:      \"deterministic_setup\": [],\n./stats/io.grpc/grpc-auth/1.68.0/execution-metrics.json:54:      \"agent_guidance\": \"\",\n./stats/com.baomidou/mybatis-plus-boot-starter/3.5.3.1/execution-metrics.json:47:      \"deterministic_setup\": [\n./stats/com.baomidou/mybatis-plus-boot-starter/3.5.3.1/execution-metrics.json:55:      \"agent_guidance\": \"Start a Spring Boot application context with mapper scanning, an entity and BaseMapper, and exercise CRUD against `jdbc:h2:mem:test;MODE=MYSQL;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE` using user `sa`. Initialize a small schema before invoking the mapper.\",\n./stats/junit/junit/3.7/execution-metrics.json:53:      \"deterministic_setup\": [],\n./stats/junit/junit/3.7/execution-metrics.json:54:      \"agent_guidance\": \"\",\n./stats/junit/junit/3.7/execution-metrics.json:148:      \"deterministic_setup\": [],\n./stats/junit/junit/3.7/execution-metrics.json:149:      \"agent_guidance\": \"Ensure the test runtime resolves junit:junit strictly to 3.7. Use Jupiter tests that invoke JUnit 3 APIs directly rather than relying on Vintage discovery, and assert junit.runner.Version.id() is \\\"3.7\\\".\",\n./stats/junit/junit/3.7/execution-metrics.json:244:      \"deterministic_setup\": [],\n./stats/junit/junit/3.7/execution-metrics.json:245:      \"agent_guidance\": \"\",\n./stats/javax.ws.rs/javax.ws.rs-api/2.0.1/execution-metrics.json:58:      \"deterministic_setup\": [],\n./stats/javax.ws.rs/javax.ws.rs-api/2.0.1/execution-metrics.json:59:      \"agent_guidance\": \"Do not add Jersey/RESTEasy just to make the API factories work. For tests that call RuntimeDelegate, Response, UriBuilder, Link, Variant, or ClientBuilder factory methods, provide test-local stub implementations and point the JAX-RS lookup at them with system properties such as `javax.ws.rs.ext.RuntimeDelegate` and `javax.ws.rs.client.ClientBuilder`, or equivalent `META-INF/services/...` test resources. Reset `RuntimeDelegate.setInstance(null)` and restore/clear any system properties after each test to avoid cross-test contamination.\",\n./stats/org.springframework.amqp/spring-rabbitmq-client/4.2.0-M1/execution-metrics.json:77:      \"deterministic_setup\": [],\n./stats/org.springframework.amqp/spring-rabbitmq-client/4.2.0-M1/execution-metrics.json:78:      \"agent_guidance\": \"\",\n./stats/org.springframework.amqp/spring-rabbitmq-client/4.1.0/execution-metrics.json:77:      \"deterministic_setup\": [],\n./stats/org.springframework.amqp/spring-rabbitmq-client/4.1.0/execution-metrics.json:78:      \"agent_guidance\": \"\",\n./stats/com.softwaremill.sttp.client4/json-common_3/4.0.23/execution-metrics.json:47:      \"deterministic_setup\": [],\n./stats/com.softwaremill.sttp.client4/json-common_3/4.0.23/execution-metrics.json:48:      \"agent_guidance\": \"No environment or system properties are needed. Use the normal Scala 3 scaffold and cover the direct APIs: `IsOption` evidence for `Option`/`Either` vs non-option types, `JsonInput.sanitize` converting blank optional JSON input to `null`, and `sttp.client4.json.RichResponseAs`/`showAsJson*` label changes on `ResponseAs`. Avoid live HTTP calls; this module does not require a backend or external JSON parser to test its own behavior.\",\n./stats/com.sun.istack/istack-commons-tools/4.1.2/execution-metrics.json:53:      \"deterministic_setup\": [\n./stats/com.sun.istack/istack-commons-tools/4.1.2/execution-metrics.json:61:      \"agent_guidance\": \"No Docker image or external service is indicated. For DefaultAuthenticator coverage, create temporary auth files and set/clear http.proxyUser/http.proxyPassword or proxyUser/proxyPassword inside the test if exercising proxy branches, restoring global Authenticator state with reset/cleanup. For ProtectedTask coverage, use a minimal in-test subclass and dummy task/classloader setup rather than invoking external Ant builds.\",\n./stats/com.github.victools/jsonschema-module-jackson/4.38.0/execution-metrics.json:48:      \"agent_guidance\": \"No Docker image, environment variable, or system property setup appears necessary. Generated tests should exercise the documented integration path by registering JacksonModule with SchemaGeneratorConfigBuilder/SchemaGenerator and generating schemas for small annotated fixture classes using Jackson annotations such as @JsonProperty, @JsonIgnore, @JsonPropertyDescription, @JsonTypeInfo/@JsonSubTypes, or @JsonUnwrapped.\",\n./stats/com.github.victools/jsonschema-module-jackson/4.38.0/execution-metrics.json:57:      \"deterministic_setup\": [\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/usr/bin/zsh -lc \"sed -n '1,220p' forge/utility_scripts/library_preparation_preflight.py; sed -n '260,410p' forge/utility_scripts/library_preparation_preflight.py; sed -n '1,120p' forge/.continuation-marker.json; for f in tests/tck-build-logic/src/main/resources/allowed-docker-images/Dockerfile-*; do echo \\\"\"'$f\"; sed -n '\"'1,20p' \\\"\"'$f\"; done'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/usr/bin/zsh -lc \"sed -n '1,220p' forge/utility_scripts/library_preparation_preflight.py; sed -n '260,410p' forge/utility_scripts/library_preparation_preflight.py; sed -n '1,120p' forge/.continuation-marker.json; for f in tests/tck-build-logic/src/main/resources/allowed-docker-images/Dockerfile-*; do echo \\\"\"'$f\"; sed -n '\"'1,20p' \\\"\"'$f\"; done'","aggregated_output":"# Copyright and related rights waived via CC0\n#\n# You should have received a copy of the CC0 legalcode along with this\n# work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n\n\"\"\"Shared helpers for library-specific preparation preflight records.\"\"\"\n\nimport json\nimport os\nimport re\nfrom typing import Any, Callable\n\nfrom utility_scripts.metadata_index import (\n    coordinate_parts as metadata_coordinate_parts,\n    resolve_test_dir,\n)\nfrom ai_workflows.agents.agent_runtime import AgentRunResult, get_setup_agent, setup_agent_run\nfrom utility_scripts.run_location import (\n    PHASE_SETUP,\n    STEP_NEURAL_SETUP,\n    log_step_progress,\n)\nfrom utility_scripts.stage_logger import log_detail\nfrom utility_scripts.task_logs import display_log_path\n\nLIBRARY_PREPARATION_PREFLIGHT_FILENAME = \".library_preparation_preflight.json\"\nNO_LIBRARY_PREPARATION_PREFLIGHT_CONTEXT = (\n    \"Library preparation preflight did not request additional setup.\"\n)\nLIBRARY_PREFLIGHT_TIMEOUT_SECONDS = 900\nLIBRARY_PREFLIGHT_MAX_ISSUE_BODY_CHARS = 8000\nLIBRARY_PREFLIGHT_MAX_TEST_FILES = 40\nLIBRARY_PREFLIGHT_MAX_DETERMINISTIC_SETUP = 8\n# Only the free-text advisory guidance is scanned for these; the deterministic\n# setup entries are validated structurally and cannot smuggle prose commands.\nLIBRARY_PREFLIGHT_UNSAFE_TERMS = (\n    \"sudo\",\n    \"curl \",\n    \"wget \",\n    \"git clone\",\n    \"rm -rf\",\n    \"docker run\",\n    \"credential\",\n    \"secret\",\n    \"token\",\n)\n# Deterministic setup the driver applies itself, idempotently, as source edits\n# (§AR-forge-orchestration.1.1). Anything else stays advisory guidance.\nLIBRARY_PREFLIGHT_DETERMINISTIC_KINDS = (\"dependency\", \"docker_image\")\nLIBRARY_PREFLIGHT_DEPENDENCY_SCOPES = (\n    \"testImplementation\",\n    \"testRuntimeOnly\",\n    \"implementation\",\n    \"runtimeOnly\",\n)\n_DEPENDENCY_COORDINATE_RE = re.compile(r\"^[\\w.\\-]+:[\\w.\\-]+:[\\w.\\-]+$\")\n_DOCKER_IMAGE_RE = re.compile(r\"^[\\w][\\w./\\-]*(:[\\w][\\w.\\-]*)?$\")\n_DOCKER_SLUG_RE = re.compile(r\"^[a-z0-9][a-z0-9_\\-]*$\")\nALLOWED_DOCKER_IMAGES_RELDIR = os.path.join(\n    \"tests\", \"tck-build-logic\", \"src\", \"main\", \"resources\", \"allowed-docker-images\"\n)\n\n\ndef _truncate_preflight_text(value: str | None, max_chars: int) -> str:\n    \"\"\"Return bounded text for the preflight evidence bundle.\"\"\"\n    if not value:\n        return \"\"\n    stripped = value.strip()\n    if len(stripped) <= max_chars:\n        return stripped\n    return stripped[:max_chars] + \"\\n...[truncated]\"\n\n\ndef _target_library_for_preflight(claimed_issue: Any) -> str:\n    \"\"\"Return the library coordinate the workflow will edit or verify.\"\"\"\n    if claimed_issue.label in {\"library-new-request\", \"library-update-request\"}:\n        return claimed_issue.issue_coordinates\n    if claimed_issue.current_coordinates and claimed_issue.new_version:\n        group, artifact, _version = metadata_coordinate_parts(claimed_issue.current_coordinates)\n        return f\"{group}:{artifact}:{claimed_issue.new_version}\"\n    return claimed_issue.issue_coordinates\n\n\ndef _preflight_evidence(name: str, summary: str) -> dict[str, str]:\n    \"\"\"Build one schema-compatible preflight evidence summary.\"\"\"\n    return {\"name\": name, \"summary\": _truncate_preflight_text(summary, 1000) or \"not available\"}\n\n\ndef _list_all_files(root_dir: str) -> list[str]:\n    \"\"\"Return all regular files under a directory in stable order.\"\"\"\n    result: list[str] = []\n    for dirpath, _dirnames, filenames in os.walk(root_dir):\n        for file_name in sorted(filenames):\n            result.append(os.path.join(dirpath, file_name))\n    return result\n\n\ndef _list_preflight_test_files(repo_path: str, coordinate: str) -> list[str]:\n    \"\"\"Return a bounded list of existing test files for a supported coordinate.\"\"\"\n    try:\n        group, artifact, version = metadata_coordinate_parts(coordinate)\n        if version is None:\n            return []\n        test_dir = resolve_test_dir(repo_path, group, artifact, version)\n    except Exception:\n        return []\n    if not os.path.isdir(test_dir):\n        return []\n    files = []\n    for file_path in _list_all_files(test_dir):\n        if len(files) >= LIBRARY_PREFLIGHT_MAX_TEST_FILES:\n            break\n        files.append(os.path.relpath(file_path, repo_path))\n    return files\n\n\ndef build_library_preflight_input_bundle(\n        claimed_issue: Any,\n        issue_body_provider: Callable[[int], str],\n) -> dict[str, Any]:\n    \"\"\"Collect the small starting context the preflight agent researches from.\"\"\"\n    issue_number = int(claimed_issue.issue[\"number\"])\n    target_library = _target_library_for_preflight(claimed_issue)\n    issue_body_error = \"\"\n    try:\n        issue_body = _truncate_preflight_text(\n            issue_body_provider(issue_number),\n            LIBRARY_PREFLIGHT_MAX_ISSUE_BODY_CHARS,\n        )\n    except Exception as exc:\n        issue_body = \"\"\n        issue_body_error = f\"{type(exc).__name__}: {exc}\"\n    existing_test_coordinates = [\n        coordinate for coordinate in (\n            claimed_issue.current_coordinates,\n            claimed_issue.issue_coordinates,\n            target_library,\n        )\n        if coordinate\n    ]\n    existing_tests: dict[str, list[str]] = {}\n    for coordinate in dict.fromkeys(existing_test_coordinates):\n        files = _list_preflight_test_files(claimed_issue.worktree_path, coordinate)\n        if files:\n            existing_tests[coordinate] = files\n\n    return {\n        \"issue\": {\n            \"number\": issue_number,\n            \"title\": claimed_issue.issue.get(\"title\") or \"\",\n            \"label\": claimed_issue.label,\n            \"body\": issue_body,\n            \"body_error\": issue_body_error,\n        },\n        \"library\": target_library,\n        \"current_library\": claimed_issue.current_coordinates,\n        \"new_version\": claimed_issue.new_version,\n        \"existing_tests\": existing_tests,\n    }\n\n\ndef _library_preflight_input_evidence(input_bundle: dict[str, Any]) -> list[dict[str, str]]:\n    \"\"\"Summarize the preflight bundle for durable metrics.\"\"\"\n    issue = input_bundle.get(\"issue\") if isinstance(input_bundle.get(\"issue\"), dict) else {}\n    issue_body = str(issue.get(\"body\") or \"\")\n    issue_body_error = str(issue.get(\"body_error\") or \"\")\n    existing_tests = input_bundle.get(\"existing_tests\") or {}\n    return [\n        _preflight_evidence(\n            \"issue\",\n            (\n                f\"#{issue.get('number')} {issue.get('title')}; \"\n                f\"label={issue.get('label')}; body_chars={len(issue_body)}\"\n                f\"{'; body_error=' + issue_body_error if issue_body_error else ''}\"\n            ),\n        ),\n        _preflight_evidence(\n            \"existing_tests\",\n            f\"{sum(len(files) for files in existing_tests.values())} existing test file path(s) included\",\n        ),\n    ]\n\n\ndef _base_library_preflight_record(\n        claimed_issue: Any,\n        input_bundle: dict[str, Any],\n) -> dict[str, Any]:\n    \"\"\"Return fields common to completed and degraded preflight records.\"\"\"\n    record: dict[str, Any] = {\n        \"status\": \"degraded\",\n        \"action\": \"no_action\",\n        \"issue_number\": int(claimed_issue.issue[\"number\"]),\n        \"issue_label\": claimed_issue.label,\n        \"library\": str(input_bundle.get(\"library\") or _target_library_for_preflight(claimed_issue)),\n        \"summary\": \"\",\n        \"deterministic_setup\": [],\n        \"agent_guidance\": \"\",\n        \"risks\": [],\n        \"applied_setup\": [],\n        \"input_evidence\": _library_preflight_input_evidence(input_bundle),\n    }\n    if claimed_issue.current_coordinates:\n        record[\"current_library\"] = claimed_issue.current_coordinates\n    if claimed_issue.new_version:\n        record[\"new_version\"] = claimed_issue.new_version\n    return record\n\n\ndef _degraded_library_preflight_record(\n        claimed_issue: Any,\n        input_bundle: dict[str, Any],\n        failure_reason: str,\n        model_name: str | None = None,\n        prompt_path: str | None = None,\n        raw_response_path: str | None = None,\n        session_log_path: str | None = None,\n) -> dict[str, Any]:\n    \"\"\"Record an unavailable or unusable preflight as no-action advisory output.\"\"\"\n    record = _base_library_preflight_record(claimed_issue, input_bundle)\n    record[\"summary\"] = \"Library preparation preflight did not produce usable advisory setup.\"\n    normalized = []\n    for item in values:\n        if not isinstance(item, str) or not item.strip():\n            continue\n        normalized.append(_truncate_preflight_text(item, 600))\n        if len(normalized) >= limit:\n            break\n    return normalized\n\n\ndef _preflight_contains_unsafe_text(*values: Any) -> bool:\n    \"\"\"Return True when advisory text asks for unsafe preparation behavior.\"\"\"\n    combined = \"\\n\".join(str(value).lower() for value in values if value is not None)\n    return any(term in combined for term in LIBRARY_PREFLIGHT_UNSAFE_TERMS)\n\n\ndef _parse_deterministic_setup_entry(entry: Any) -> dict[str, str] | None:\n    \"\"\"Validate one deterministic-setup entry by shape, or drop it (return None).\"\"\"\n    if not isinstance(entry, dict):\n        return None\n    kind = str(entry.get(\"kind\") or \"\").strip()\n    reason = _truncate_preflight_text(str(entry.get(\"reason\") or \"\"), 300)\n    if kind == \"dependency\":\n        coordinate = str(entry.get(\"coordinate\") or \"\").strip()\n        if not _DEPENDENCY_COORDINATE_RE.match(coordinate):\n            return None\n        scope = str(entry.get(\"scope\") or \"testImplementation\").strip()\n        if scope not in LIBRARY_PREFLIGHT_DEPENDENCY_SCOPES:\n            scope = \"testImplementation\"\n        return {\"kind\": kind, \"coordinate\": coordinate, \"scope\": scope, \"reason\": reason}\n    if kind == \"docker_image\":\n        image = str(entry.get(\"image\") or \"\").strip()\n        slug = str(entry.get(\"slug\") or \"\").strip().lower()\n        if not _DOCKER_IMAGE_RE.match(image) or not _DOCKER_SLUG_RE.match(slug):\n            return None\n        return {\"kind\": kind, \"image\": image, \"slug\": slug, \"reason\": reason}\n    return None\n\n\ndef _parse_deterministic_setup(value: Any) -> list[dict[str, str]]:\n    \"\"\"Normalize the response's deterministic setup into validated, bounded entries.\"\"\"\n    if not isinstance(value, list):\n        return []\n    parsed: list[dict[str, str]] = []\n    for entry in value:\n        validated = _parse_deterministic_setup_entry(entry)\n        if validated is None:\n            continue\n        parsed.append(validated)\n        if len(parsed) >= LIBRARY_PREFLIGHT_MAX_DETERMINISTIC_SETUP:\n            break\n    return parsed\n\n\ndef _completed_library_preflight_record(\n        claimed_issue: Any,\n        input_bundle: dict[str, Any],\n        response_payload: dict[str, Any],\n        model_name: str,\n        result: Any | None,\n        prompt_path: str | None,\n        raw_response_path: str | None,\n        session_log_path: str | None,\n) -> dict[str, Any]:\n    \"\"\"Normalize a valid preflight response into the persisted metrics shape.\"\"\"\n    action = str(response_payload.get(\"action\") or \"no_action\").strip()\n    if action not in {\"no_action\", \"advisory_preparation\"}:\n        raise ValueError(f\"unsupported preflight action: {action}\")\n    summary = _truncate_preflight_text(str(response_payload.get(\"summary\") or \"\"), 1000)\n    deterministic_setup = _parse_deterministic_setup(response_payload.get(\"deterministic_setup\"))\n    agent_guidance = _truncate_preflight_text(str(response_payload.get(\"agent_guidance\") or \"\"), 2000)\n    risks = _preflight_string_list(response_payload.get(\"risks\"))\n    if action == \"advisory_preparation\" and not (deterministic_setup or agent_guidance):\n        raise ValueError(\"advisory_preparation response did not include deterministic setup or guidance\")\n    # Deterministic entries are validated structurally above; only the free-text\n    # advisory fields can carry prose, so only those are scanned for unsafe terms.\n    if _preflight_contains_unsafe_text(summary, agent_guidance, risks):\n        raise ValueError(\"preflight response requested unsafe preparation behavior\")\n\n    record = _base_library_preflight_record(claimed_issue, input_bundle)\n    record[\"status\"] = \"completed\"\n    record[\"action\"] = action\n    record[\"summary\"] = summary\n    record[\"deterministic_setup\"] = deterministic_setup\n    record[\"agent_guidance\"] = agent_guidance\n    record[\"risks\"] = risks\n    record[\"model\"] = model_name\n    record[\"input_tokens_used\"] = int(getattr(result, \"input_tokens\", 0) or 0)\n    record[\"output_tokens_used\"] = int(getattr(result, \"output_tokens\", 0) or 0)\n    if prompt_path:\n        record[\"prompt_path\"] = prompt_path\n    if raw_response_path:\n        record[\"raw_response_path\"] = raw_response_path\n    if session_log_path:\n        record[\"session_log_path\"] = session_log_path\n    return record\n\n\ndef _library_preflight_prompt(input_bundle: dict[str, Any]) -> str:\n    \"\"\"Build the LLM prompt instructing the agent to research preparation needs.\"\"\"\n    return (\n        \"You are preparing a Forge workflow for a library issue. Decide whether the \"\n        \"library needs setup beyond the normal generated test scaffold before \"\n        \"meaningful coverage is reachable.\\n\\n\"\n        \"Research the library yourself to make this decision. Investigate the resolved \"\n        \"artifact and its dependencies, how the library is normally used, and its \"\n        \"documentation. The JSON context below is only a starting point, not the limit \"\n        \"of what you may consider. Do not modify the repository or apply any setup \"\n        \"yourself — return only the decision. Local Gradle and Native Image verification \"\n        \"remain authoritative.\\n\\n\"\n        \"The setup can be one of three things: an extra Maven dependency, a Docker \"\n        \"image the tests need, or an environment/system property the generated tests \"\n        \"must set. Represent dependencies and Docker images as `deterministic_setup` \"\n        \"entries the driver can apply before generation:\\n\"\n        '  - {\"kind\": \"dependency\", \"coordinate\": \"group:artifact:version\", '\n        '\"scope\": \"testImplementation\", \"reason\": \"...\"}\\n'\n        '  - {\"kind\": \"docker_image\", \"image\": \"name:tag\", \"slug\": \"short-slug\", \"reason\": \"...\"}\\n'\n        \"If a test needs a Docker image that is already pinned under \"\n        \"`tests/tck-build-logic/src/main/resources/allowed-docker-images/`, reuse the exact \"\n        \"tag from that `Dockerfile-<slug>` instead of introducing a new one, since the \"\n        \"allow-list permits a single shared tag per image.\\n\"\n        \"Put environment variables, system properties, and other test-code setup in \"\n        \"`agent_guidance`. Do not restate deterministic entries as guidance.\\n\\n\"\n        \"Return a single JSON object with this shape:\\n\"\n        \"{\\n\"\n        '  \"action\": \"no_action\" | \"advisory_preparation\",\\n'\n        '  \"summary\": \"short reason\",\\n'\n        '  \"deterministic_setup\": [ ... dependency or docker_image entries, if any ... ],\\n'\n        '  \"agent_guidance\": \"environment/system property/test setup guidance, if any\",\\n'\n        '  \"risks\": [\"risk notes, if any\"]\\n'\n        \"}\\n\\n\"\n        \"Choose no_action unless your research finds concrete evidence that extra setup is needed.\\n\\n\"\n        \"Context (starting point):\\n\"\n        f\"{json.dumps(input_bundle, indent=2, ensure_ascii=False)}\"\n    )\n\n\ndef _relative_or_absolute_path(path: str | None, root: str) -> str | None:\n    \"\"\"Return a stable metrics path, relative when it is under the metrics root.\"\"\"\n    if not path:\n        return None\n    try:\n        absolute_path = os.path.abspath(path)\n        absolute_root = os.path.abspath(root)\n        if os.path.commonpath([absolute_path, absolute_root]) == absolute_root:\n            return os.path.relpath(absolute_path, absolute_root)\n    except ValueError:\n        pass\n    return path\n\n\n{\n  \"continueFrom\": \"setup\",\n  \"coordinate\": \"io.github.microcks:microcks-testcontainers:0.5.0\",\n  \"failure\": null,\n  \"issueNumber\": 9686,\n  \"label\": \"library-new-request\",\n  \"libraryPreparationPreflight\": null,\n  \"libraryUpdateRoute\": null,\n  \"newVersion\": null,\n  \"phases\": {\n    \"explore\": {\n      \"chunkClassCount\": null,\n      \"chunkProcessedClassCount\": 0,\n      \"exhaustedClasses\": [],\n      \"status\": \"pending\"\n    },\n    \"finalization\": {\n      \"status\": \"pending\"\n    },\n    \"fix\": {\n      \"iteration\": null,\n      \"status\": \"pending\"\n    },\n    \"publication\": {\n      \"branch\": null,\n      \"coverageFollowUpIssueNumber\": null,\n      \"isPushed\": false,\n      \"publicationId\": null,\n      \"publicationTimestamp\": null,\n      \"status\": \"pending\"\n    },\n    \"setup\": {\n      \"preflightDone\": false,\n 