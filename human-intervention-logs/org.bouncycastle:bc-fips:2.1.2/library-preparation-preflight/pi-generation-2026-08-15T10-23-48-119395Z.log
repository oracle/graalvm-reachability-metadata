vailable.\n56-     *\n57:     * @return true if native libs have been installed and are NOT disabled.\n58-     */\n59-    static synchronized boolean isNativeAvailable()\n60-    {\n61:        return nativeLibsAvailableForSystem.get() && nativeInstalled.get() && nativeEnabled.get();\n62-    }\n63-\n64-    /**\n65:     * Disable native library even if loaded.\n66-     *\n67:     * @param enabled when false will disable the use of native extensions.\n68-     */\n69-    static synchronized void setNativeEnabled(boolean enabled)\n70-    {\n71:        nativeEnabled.set(enabled);\n72-    }\n73-\n74-    static synchronized String getNativeStatusMessage()\n75-    {\n76:        return nativeStatusMessage.get();\n77-    }\n78-\n79-    static synchronized String getSelectedVariant()\n80-    {\n81:        return selectedVariant.get();\n82-    }\n83-\n84-\n--\n147-    static synchronized void loadDriver()\n148-    {\n149-\n150:        String forcedVariant = Properties.getPropertyValue(BCFIPS_LIB_CPU_VARIANT);\n151-\n152-\n153-        // No variants defined at all, or a\n--\n155-        //\n156-        if (\"java\".equals(forcedVariant))\n157-        {\n158:            nativeEnabled.set(false);\n159:            nativeInstalled.set(false);\n160:            nativeStatusMessage.set(\"java support only\");\n161-            return;\n162-        }\n163-\n164-\n165:        String arch_ = Strings.toLowerCase(Properties.getPropertyValue(\"os.arch\", \"\"));\n166:        String os_ = Strings.toLowerCase(Properties.getPropertyValue(\"os.name\", \"\"));\n167-        String platform = null;\n168-        String arch = null;\n169-\n--\n175-\n176-        if (platform == null)\n177-        {\n178:            nativeStatusMessage.set(\"OS '\" + os_ + \"' is not supported.\");\n179-            return;\n180-        }\n181-\n--\n187-\n188-        if (arch == null)\n189-        {\n190:            nativeStatusMessage.set(\"architecture '\" + arch_ + \"' is not supported\");\n191-            return;\n192-