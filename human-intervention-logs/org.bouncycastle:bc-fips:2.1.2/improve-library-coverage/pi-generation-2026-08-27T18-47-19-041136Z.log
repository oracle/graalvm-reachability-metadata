  plugins {
      id "org.graalvm.internal.tck"
  }
  
  String libraryVersion = tck.testedLibraryVersion.get()
  
  dependencies {
      testImplementation "org.postgresql:postgresql:$libraryVersion"
      testImplementation 'org.assertj:assertj-core:3.22.0'
      testImplementation 'org.awaitility:awaitility:4.2.0'
  }
  
  test {
      // Isolate TimestampUtilsTest so it can set java.version before pgjdbc caches JavaVersion.
      forkEvery = 1
      jvmArgs '--add-opens=java.base/java.util=ALL-UNNAMED'
  }
  
  graalvmNative {
      agent {
          defaultMode = "conditional"
          modes {
              conditional {
                  userCodeFilterPath = "user-code-filter.json"
              }
          }
      }
  }
[tool-exec] end id=call_05bYmRK87WZ27BPRcS3pozTA|fc_016ef86f8c7f33a8016a9085793a5887d28c06eb8e5cd0f75c name=read status=success
  /*
   * Copyright and related rights waived via CC0
   *
   * You should have received a copy of the CC0 legalcode along with this
   * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.
   */
  plugins {
      id "org.graalvm.internal.tck"
  }
  
  String libraryVersion = tck.testedLibraryVersion.get()
  String customLoggerClass = 'org_jgroups.jgroups.LogFactoryTest$ConfiguredLog'
  
  tasks.withType(Test).configureEach {
      forkEvery = 1
      systemProperty 'jgroups.bind_addr', '127.0.0.1'
      systemProperty 'java.net.preferIPv4Stack', 'true'
      systemProperty 'jgroups.log_class', customLoggerClass
  }
  
  tasks.named('nativeTest') {
      runtimeArgs.add('-Djgroups.bind_addr=127.0.0.1')
      runtimeArgs.add('-Djava.net.preferIPv4Stack=true')
      runtimeArgs.add("-Djgroups.log_class=${customLoggerClass}")
  }
  
  dependencies {
      testImplementation "org.jgroups:jgroups:$libraryVersion"
      testImplementation 'org.slf4j:slf4j-api:1.7.31'
      testRuntimeOnly('org.wildfly.openssl:wildfly-openssl:2.1.1.Final') {
          transitive = false
      }
      testImplementation 'org.assertj:assertj-core:3.22.0'
  }
  
  graalvmNative {
      agent {
          defaultMode = "conditional"
          modes {
              conditional {
                  userCodeFilterPath = "user-code-filter.json"
              }
          }
      }
  }
[tool-exec] end id=call_RmabRGcChZYRZzPYnkbOvDST|fc_016ef86f8c7f33a8016a9085793a7887d2b89934ee01375d3f name=read status=success
  }
  
  // §forge/AR-code-coverage-improvement.3.1: the extension suite runs and is
  // measured separately from the metadata-justifying tests.
  tasks.register("codeCoverageTest", Test) {
      description = "Runs the code-coverage-improvement extension suite on the JVM"
      group = JavaBasePlugin.VERIFICATION_GROUP
      testClassesDirs = sourceSets.codeCoverage.output.classesDirs
      classpath = sourceSets.codeCoverage.runtimeClasspath
      useJUnitPlatform()
      dependsOn tasks.named("checkTestTimeoutAnnotations")
      onlyIf { !sourceSets.codeCoverage.java.isEmpty() }
  }
  
  // Combined regular + extension coverage; jacocoTestReport stays the
  // regular-suite baseline, so the extension delta is the difference.
  tasks.register("jacocoCodeCoverageReport", org.gradle.testing.jacoco.tasks.JacocoReport) {
      description = "Generates the combined JaCoCo report for the regular and code-coverage-improvement suites"
      group = JavaBasePlugin.VERIFICATION_GROUP
      dependsOn tasks.named("codeCoverageTest")
      executionData fileTree(layout.buildDirectory.dir("jacoco")) { include "*.exec" }
      sourceDirectories.setFrom(files())
  }
  
  tasks.named("nativeTest", NativeRunTask).configure { NativeRunTask task ->
      task.runtimeArgs.addAll(junitTimeoutRuntimeArgs)
  }
  
   // Configure JaCoCo report to analyze only the effective classes of the target library (handles multi-release JARs)
  tasks.withType(org.gradle.testing.jacoco.tasks.JacocoReport).configureEach { r ->
      r.dependsOn(tasks.named('test'))
  
      reports {
          xml.required = true
          html.required = false
          csv.required = false
      }
  
      // Classified artifacts remain executable dependencies but never enter the coverage denominator.
      List<File> matched = resolveTestedLibraryMainJars()
  
      // Produce one deterministic directory of .class files that represents exactly what the JVM would load at runtime for a given library jar, without duplicates
      int runtimeMajor = (JavaVersion.current().majorVersion as int)
  
      def effectiveDirs = matched.collect { File jarFile ->
          String safe = jarFile.name.replaceAll(/[^A-Za-z0-9]/, '_')
          layout.buildDirectory.dir("jacoco/effective/${safe}").get().asFile
      }
  
      r.inputs.files(matched)
      r.outputs.dirs(effectiveDirs)
  
      r.doFirst {
          matched.eachWithIndex { File jarFile, int idx ->
              File outDir = effectiveDirs[idx]
              project.delete(outDir)
