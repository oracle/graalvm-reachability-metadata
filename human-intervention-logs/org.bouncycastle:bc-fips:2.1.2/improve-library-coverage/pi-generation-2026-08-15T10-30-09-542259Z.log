          synchronized (statusLock)
          {
              if (loader == null && statusException == null)
              {
                  try
                  {
                      loader = new Loader();
  
                      loader.run();
                  }
                  catch (Exception e)
                  {
                      statusException = e;
  
                      moveToErrorStatus(new FipsOperationError("Module startup failed: " + e.getMessage(), e));
                  }
  
