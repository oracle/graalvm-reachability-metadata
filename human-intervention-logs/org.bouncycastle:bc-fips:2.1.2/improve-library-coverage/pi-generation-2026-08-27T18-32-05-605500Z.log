              assertArrayEquals(nonce, chaCha20Spec.getNonce());
              assertEquals(0, chaCha20Spec.getCounter());
          } catch (InvalidParameterSpecException e) {
              assertTrue(e.getMessage().startsWith("construction failed:"));
          }
