ared(serializeUnshared(publicKey));\n\n        assertThat(restoredPublicKey.getAlgorithm()).isEqualTo(\"DSTU4145\");\n        assertThat(restoredPublicKey.getEncoded()).isEqualTo(publicKey.getEncoded());\n        assertThat(restoredUnsharedPublicKey.getEncoded()).isEqualTo(publicKey.getEncoded());\n        assertThat(verifiesSignature(keyPair, restoredPublicKey)).isTrue();\n        assertThat(verifiesSignature(keyPair, restoredUnsharedPublicKey)).isTrue();", "newText": "        PublicKey restoredPublicKey = deserialize(serialize(publicKey));\n        PublicKey reserializedPublicKey = deserialize(serialize(restoredPublicKey));\n\n        assertThat(restoredPublicKey.getAlgorithm()).isEqualTo(\"DSTU4145\");\n        assertThat(restoredPublicKey.getEncoded()).isEqualTo(publicKey.getEncoded());\n        assertThat(reserializedPublicKey.getEncoded()).isEqualTo(publicKey.getEncoded());\n        assertThat(verifiesSignature(keyPair, restoredPublicKey)).isTrue();\n        assertThat(verifiesSignature(keyPair, reserializedPublicKey)).isTrue();"}, {"oldText": "    private byte[] serializeUnshared(PublicKey publicKey) throws Exception {\n        ByteArrayOutputStream bytes = new ByteArrayOutputStream();\n        try (ObjectOutputStream output = new ObjectOutputStream(bytes)) {\n            output.writeUnshared(publicKey);\n        }\n        return bytes.toByteArray();\n    }\n\n", "newText": ""}, {"oldText": "\n    private PublicKey deserializeUnshared(byte[] serializedPublicKey) throws Exception {\n        try (ObjectInputStream input = new ObjectInputStream(\n            new ByteArrayInputStream(serializedPublicKey))) {\n            return (PublicKey) input.readUnshared();\n        }\n    }\n", "newText": "\n"}]}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-terra", "usage": {"input": 1793, "output": 1350, "cacheRead": 34304, "cacheWrite": 0, "totalTokens": 37447, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total":