              AsymmetricKeyPair pair = engine.generateKeyPair();
  
              return new KeyPair(new ProvDSAPublicKey((AsymmetricDSAPublicKey)pair.getPublicKey()), new ProvDSAPrivateKey((AsymmetricDSAPrivateKey)pair.getPrivateKey()));
          }
      }
  
