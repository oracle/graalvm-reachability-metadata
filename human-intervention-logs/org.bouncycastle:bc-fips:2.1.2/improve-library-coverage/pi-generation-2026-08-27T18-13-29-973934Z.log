  +            "CHACHA20", BouncyCastleFipsProvider.PROVIDER_NAME);
  +        encryptor.init(Cipher.ENCRYPT_MODE, key, parameters);
  +        byte[] ciphertext = encryptor.doFinal(plaintext);
  +
  +        Cipher decryptor = Cipher.getInstance(
  +            "CHACHA20", BouncyCastleFipsProvider.PROVIDER_NAME);
  +        decryptor.init(Cipher.DECRYPT_MODE, key, parameters);
  +
  +        assertThat(ciphertext).isNotEqualTo(plaintext);
  +        assertThat(decryptor.doFinal(ciphertext)).isEqualTo(plaintext);
  +    }
  +}
  diff --git a/tests/src/org.bouncycastle/bc-fips/2.1.2/src/test/java/org_bouncycastle/bc_fips/ClassUtilTest.java b/tests/src/org.bouncycastle/bc-fips/2.1.2/src/test/java/org_bouncycastle/bc_fips/ClassUtilTest.java
  new file mode 100644
  index 0000000000..2769541f14
  --- /dev/null
  +++ b/tests/src/org.bouncycastle/bc-fips/2.1.2/src/test/java/org_bouncycastle/bc_fips/ClassUtilTest.java
  @@ -0,0 +1,52 @@
  +/*
