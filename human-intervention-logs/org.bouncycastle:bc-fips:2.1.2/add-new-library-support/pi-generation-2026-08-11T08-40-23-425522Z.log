       7	package org_bouncycastle.bc_fips;
       8	
       9	import java.io.ByteArrayInputStream;
      10	import java.io.ByteArrayOutputStream;
      11	import java.io.ObjectInputStream;
      12	import java.io.ObjectOutputStream;
      13	import java.security.KeyPair;
      14	import java.security.KeyPairGenerator;
      15	import java.security.PrivateKey;
      16	import java.security.PublicKey;
      17	import java.security.Security;
      18	import java.security.Signature;
      19	import java.security.interfaces.DSAPrivateKey;
      20	import java.security.spec.DSAParameterSpec;
      21	
      22	import org.bouncycastle.jcajce.provider.BouncyCastleFipsProvider;
      23	import org.junit.jupiter.api.BeforeAll;
      24	import org.junit.jupiter.api.Test;
      25	
      26	import static org.assertj.core.api.Assertions.assertThat;
      27	
      28	public class ProvDSAPrivateKeyTest {
      29	    @BeforeAll
      30	    static void registerProvider() {
      31	        Security.addProvider(new BouncyCastleFipsProvider());
      32	    }
      33	
      34	    @Test
      35	    void serializesAndRestoresADsaPrivateKey() throws Exception {
      36	        KeyPairGenerator generator = KeyPairGenerator.getInstance(
      37	            "DSA", BouncyCastleFipsProvider.PROVIDER_NAME);
      38	        generator.initialize(parametersFromJdkProvider());
      39	        KeyPair keyPair = generator.generateKeyPair();
      40	        PrivateKey privateKey = keyPair.getPrivate();
      41	        byte[] serializedPrivateKey = serialize(privateKey);
      42	        PrivateKey restoredPrivateKey = deserialize(serializedPrivateKey);
      43	
      44	        assertThat(serializedPrivateKey).isNotEmpty();
      45	        assertThat(restoredPrivateKey.getAlgorithm()).isEqualTo("DSA");
      46	        assertThat(restoredPrivateKey.getEncoded()).isEqualTo(privateKey.getEncoded());
      47	        assertThat(signAndVerify(restoredPrivateKey, keyPair.getPublic(), "serialized DSA private key"))
      48	            .isTrue();
      49	    }
      50	
      51	    private DSAParameterSpec parametersFromJdkProvider() throws Exception {
      52	        KeyPairGenerator generator = KeyPairGenerator.getInstance("DSA", "SUN");
      53	        generator.initialize(2048);
      54	        KeyPair keyPair = generator.generateKeyPair();
      55	        return toParameterSpec((DSAPrivateKey) keyPair.getPrivate());
      56	    }
      57	
      58	    private DSAParameterSpec toParameterSpec(DSAPrivateKey privateKey) {
      59	        return new DSAParameterSpec(
      60	            privateKey.getParams().getP(), privateKey.getParams().getQ(), privateKey.getParams().getG());
      61	    }
      62	
      63	    private byte[] serialize(PrivateKey privateKey) throws Exception {
      64	        ByteArrayOutputStream bytes = new ByteArrayOutputStream();
      65	        try (ObjectOutputStream output = new ObjectOutputStream(bytes)) {
      66	            output.writeObject(privateKey);
      67	        }
      68	        return bytes.toByteArray();
      69	    }
      70	
      71	    private PrivateKey deserialize(byte[] serializedPrivateKey) throws Exception {
      72	        try (ObjectInputStream input = new ObjectInputStream(
      73	            new ByteArrayInputStream(serializedPrivateKey))) {
      74	            return (PrivateKey) input.readObject();
      75	        }
      76	    }
      77	
      78	    private boolean signAndVerify(PrivateKey privateKey, PublicKey publicKey, String message)
      79	        throws Exception {
      80	        byte[] messageBytes = message.getBytes();
      81	        Signature signer = Signature.getInstance("SHA256withDSA", BouncyCastleFipsProvider.PROVIDER_NAME);
      82	        signer.initSign(privateKey);
      83	        signer.update(messageBytes);
      84	
      85	        Signature verifier = Signature.getInstance("SHA256withDSA", BouncyCastleFipsProvider.PROVIDER_NAME);
      86	        verifier.initVerify(publicKey);
      87	        verifier.update(messageBytes);
      88	        return verifier.verify(signer.sign());
      89	    }
      90	}
