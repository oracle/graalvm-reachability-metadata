tsReadyAfterSelfTestsComplete() throws Exception {\\n        assertThat(FipsStatus.isReady()).isTrue();\\n        assertThat(FipsStatus.getStatusMessage()).isEqualTo(FipsStatus.READY);\\n        assertThat(FipsStatus.getModuleHMAC()).hasSize(32);\\n\\n        MessageDigest digest = MessageDigest.getInstance(\\n            \\\"SHA-256\\\", BouncyCastleFipsProvider.PROVIDER_NAME);\\n\\n        assertThat(digest.digest(\\\"fips status\\\".getBytes(StandardCharsets.UTF_8)))\\n            .isEqualTo(MessageDigest.getInstance(\\\"SHA-256\\\", \\\"SUN\\\")\\n                .digest(\\\"fips status\\\".getBytes(StandardCharsets.UTF_8)));\\n    }\\n}\\n\"}}], \"api\": \"openai-codex-responses\", \"provider\": \"openai-codex\", \"model\": \"gpt-5.5\", \"usage\": {\"input\": 1725, \"output\": 882, \"cacheRead\": 31232, \"cacheWrite\": 0, \"reasoning\": 479, \"totalTokens\": 33839, \"cost\": {\"input\": 0.008625, \"output\": 0.02646, \"cacheRead\": 0.015616, \"cacheWrite\": 0, \"total\": 0.050701}}, \"stopReason\": \"toolUse\", \"timestamp\": 1786789777694, \"responseId\": \"resp_03a7f8e351d786cf016a803f91f99c81919cded630ef1a02d1\", \"rawStopReason\": \"completed\"}}\n484:[tool-exec] start id=call_GmB0lVeeEbBToFcKXLI9J2Yn|fc_03a7f8e351d786cf016a803f9bd7d08191956e83cc841432be name=write args={\"path\": \"tests/src/org.bouncycastle/bc-fips/2.1.2/src/test/java/org_bouncycastle/bc_fips/FipsStatusTest.java\", \"content\": \"/*\\n * Copyright and related rights waived via CC0\\n *\\n * You should have received a copy of the CC0 legalcode along with this\\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\\n */\\npackage org_bouncycastle.bc_fips;\\n\\nimport java.nio.charset.StandardCharsets;\\nimport java.security.MessageDigest;\\nimport java.security.Security;\\n\\nimport org.bouncycastle.crypto.fips.FipsStatus;\\nimport org.bouncycastle.jcajce.provider.BouncyCastleFipsProvider;\\nimport org.junit.jupiter.api.BeforeAll;\\nimport org.junit.jupiter.api.Test;\\n\\nimport static org.assertj.core.api.Assertions.assertThat;\\n\\npublic class FipsStatusTest {\\n    @BeforeAll\\n    static void registerProvider() {\\n        Security.addProvider(new BouncyCastleFipsProvider());\\n    }\\n\\n    @Test\\n    void reportsReadyAfterSelfTestsComplete() throws Exception {\\n        assertThat(FipsStatus.isReady()).isTrue();\\n        assertThat(FipsStatus.getStatusMessage()).isEqualTo(FipsStatus.READY);\\n        assertThat(FipsStatus.getModuleHMAC()).hasSize(32);\\n\\n        MessageDigest digest = MessageDigest.getInstance(\\n            \\\"SHA-256\\\", BouncyCastleFipsProvider.PROVIDER_NAME);\\n\\n        assertThat(digest.digest(\\\"fips status\\\".getBytes(StandardCharsets.UTF_8)))\\n            .isEqualTo(MessageDigest.getInstance(\\\"SHA-256\\\", \\\"SUN\\\")\\n                .digest(\\\"fips status\\\".getBytes(StandardCharsets.UTF_8)));\\n    }\\n}\\n\"}\n485-[tool-exec] end id=call_GmB0lVeeEbBToFcKXLI9J2Yn|fc_03a7f8e351d786cf016a803f9bd7d08191956e83cc841432be name=write status=success\n486:  Successfully wrote 1368 bytes to tests/src/org.bouncycastle/bc-fips/2.1.2/src/test/java/org_bouncycastle/bc_fips/FipsStatusTest.java\n487:[recv] {\"type\": \"message_start\", \"message\": {\"role\": \"toolResult\", \"toolCallId\": \"call_GmB0lVeeEbBToFcKXLI9J2Yn|fc_03a7f8e351d786cf016a803f9bd7d08191956e83cc841432be\", \"toolName\": \"write\", \"content\": [{\"type\": \"text\", \"text\": \"Successfully wrote 1368 bytes to tests/src/org.bouncycastle/bc-fips/2.1.2/src/test/java/org_bouncycastle/bc_fips/FipsStatusTest.java\"}], \"isError\": false, \"timestamp\": 1786789794636}}\n488:[recv] {\"type\": \"message_end\", \"message\": {\"role\": \"toolResult\", \"toolCallId\": \"call_GmB0lVeeEbBToFcKXLI9J2Yn|fc_03a7f8e351d786cf016a803f9bd7d08191956e83cc841432be\", \"toolName\": \"write\", \"content\": [{\"type\": \"text\", \"text\": \"Successfully wrote 1368 bytes to tests/src/org.bouncycastle/bc-fips/2.1.2/src/test/java/org_bouncycastle/bc_fi