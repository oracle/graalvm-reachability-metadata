              assertThat(factory.getMetamodel().entity(MetamodelRecord.class).getName())
                      .isEqualTo("StaticMetamodelRecord");
              assertThat(MetamodelRecord_.id).isNotNull();
              assertThat(MetamodelRecord_.name.getName()).isEqualTo("name");
          }
      }
  }
