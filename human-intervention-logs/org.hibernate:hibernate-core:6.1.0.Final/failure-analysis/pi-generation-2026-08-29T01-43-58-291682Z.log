vate static SessionFactory createSessionFactory() {\n        return new Configuration()\n                .setProperty(AvailableSettings.URL, \"jdbc:h2:mem:thread-context\")\n                .setProperty(AvailableSettings.DRIVER, \"org.h2.Driver\")\n                .setProperty(AvailableSettings.DIALECT, \"org.hibernate.dialect.H2Dialect\")\n                .setProperty(AvailableSettings.CURRENT_SESSION_CONTEXT_CLASS, \"thread\")\n                .setProperty(AvailableSettings.JAKARTA_VALIDATION_MODE, \"none\")\n                .buildSessionFactory();\n    }\n}\ntests/src/org.hibernate/hibernate-core/6.1.0.Final/src/test/java/org_hibernate/hibernate_core/MetamodelRecord.java\n--- tests/src/org.hibernate/hibernate-core/6.1.0.Final/src/test/java/org_hibernate/hibernate_core/MetamodelRecord.java\n/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_hibernate.hibernate_core;\n\nimport jakarta.persistence.Entity;\nimport jakarta.persistence.GeneratedValue;\nimport jakarta.persistence.Id;\nimport jakarta.persistence.Table;\n\n@Entity(name = \"StaticMetamodelRecord\")\n@Table(name = \"STATIC_METAMODEL_RECORD\")\npublic class MetamodelRecord {\n    @Id\n    @GeneratedValue\n    private Long id;\n\n    private String name;\n\n    public Long getId() {\n        return id;\n    }\n\n    public String getName() {\n        return name;\n    }\n\n    public void setName(String name) {\n        this.name = name;\n    }\n}\ntests/src/org.hibernate/hibernate-core/6.1.0.Final/src/test/java/org_hibernate/hibernate_core/DialectResolverInitiatorTest.java\n--- tests/src/org.hibernate/hibernate-core/6.1.0.Final/src/test/java/org_hibernate/hibernate_core/DialectResolverInitiatorTest.java\n/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. I