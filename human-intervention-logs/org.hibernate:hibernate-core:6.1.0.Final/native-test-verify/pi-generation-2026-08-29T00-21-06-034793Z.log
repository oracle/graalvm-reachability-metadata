ionTask.class) { task ->\n    task.setDescription(\"Generates JaCoCo coverage reports for all subprojects (runs tests first)\")\n    task.setGroup(JavaBasePlugin.VERIFICATION_GROUP)\n}\n\n// §forge/AR-code-coverage-improvement.3.1\n\n// gradle codeCoverageTest -Pcoordinates=<maven-coordinates>\ntasks.register(\"codeCoverageTest\", CodeCoverageTestInvocationTask.class) { task ->\n    task.setDescription(\"Runs the code-coverage-improvement extension suite for matching coordinates\")\n    task.setGroup(JavaBasePlugin.VERIFICATION_GROUP)\n}\n\n// §forge/AR-code-coverage-improvement.3.1\n\n// gradle jacocoCodeCoverageReport -Pcoordinates=<maven-coordinates>\ntasks.register(\"jacocoCodeCoverageReport\", JacocoCodeCoverageReportInvocationTask.class) { task ->\n    task.setDescription(\"Generates the combined regular + code-coverage-improvement JaCoCo report for matching coordinates\")\n    task.setGroup(JavaBasePlugin.VERIFICATION_GROUP)\n}\n\n\n[817 more lines in file. Use offset=348 to continue.]"}], "isError": false, "timestamp": 1787960449306}}
