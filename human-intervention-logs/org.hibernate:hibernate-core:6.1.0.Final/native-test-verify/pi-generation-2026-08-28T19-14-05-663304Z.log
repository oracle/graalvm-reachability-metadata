ackages\": [\n      \"com.microsoft.sqlserver.jdbc.SQLServerDriver\",\n      \"com.mysql.cj.jdbc.Driver\",\n      \"jakarta\",\n      \"oracle.jdbc.driver.OracleDriver\",\n      \"org.h2.Driver\",\n      \"org.hibernate\",\n      \"org.hsqldb.jdbc.JDBCDriver\",\n      \"org.mariadb.jdbc.Driver\",\n      \"org.postgresql.Driver\"\n    ],\n    \"metadata-version\": \"6.1.1.Final\",\n    \"tested-versions\": [\n      \"6.1.1.Final\"\n    ],\n    \"source-code-url\": \"https://repo.maven.apache.org/maven2/org/hibernate/orm/hibernate-core/$version$/hibernate-core-$version$-sources.jar\",\n    \"repository-url\": \"https://github.com/hibernate/hibernate-orm\",\n    \"test-code-url\": \"https://github.com/hibernate/hibernate-orm/tree/6.1.1/hibernate-core/src/test\",\n    \"documentation-url\": \"https://repo.maven.apache.org/maven2/org/hibernate/orm/hibernate-core/$version$/hibernate-core-$version$-javadoc.jar\",\n    \"description\": \"Hibernate ORM provides the core object-relational mapping functionality of Hibernate for mapping Java objects to relational database tables. It implements Jakarta Persistence (JPA) and also exposes Hibernate's native SessionFactory and Session APIs for querying, transactions, and entity lifecycle management.\"\n  }\n]\n\n--- trace config file inventory ---\ntests/src/org.hibernate/hibernate-core/6.1.0.Final/build/natively-collected/runs/cycle-0/reachability-metadata.json\ntests/src/org.hibernate/hibernate-core/6.1.0.Final/build/natively-collected/runs/cycle-1/reachability-metadata.json\ntests/src/org.hibernate/hibernate-core/6.1.0.Final/build/natively-collected/runs/cycle-2/reachability-metadata.json\ntests/src/org.hibernate/hibernate-core/6.1.0.Final/build/natively-collected/runs/cycle-3/reachability-metadata.json\ntests/src/org.hibernate/hibernate-core/6.1.0.Final/build/natively-collected/runs/cycle-4/reachability-metadata.json\ntests/src/org.hibernate/hibernate-core/6.1.0.Final/build/natively-collected/runs/cycle-5/reachability-metadata.