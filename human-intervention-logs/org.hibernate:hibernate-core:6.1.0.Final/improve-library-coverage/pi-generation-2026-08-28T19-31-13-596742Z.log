  			if ( LOG.isTraceEnabled() ) {
  				LOG.trace( "Starting deserialization of [" + count + "] collectionsByKey entries" );
  			}
  			rtn.collectionsByKey = CollectionHelper.mapOfSize(Math.max(count, INIT_COLL_SIZE));
  			for ( int i = 0; i < count; i++ ) {
