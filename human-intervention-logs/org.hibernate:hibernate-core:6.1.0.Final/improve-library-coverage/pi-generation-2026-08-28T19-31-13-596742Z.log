  				LOG.trace( "Starting deserialization of [" + count + "] entitySnapshotsByKey entries" );
  			}
  			rtn.entitySnapshotsByKey = CollectionHelper.mapOfSize(Math.max(count, INIT_COLL_SIZE));
  			for ( int i = 0; i < count; i++ ) {
