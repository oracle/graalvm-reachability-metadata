  	public void serialize(ObjectOutputStream oos) throws IOException {
  		LOG.trace( "Serializing persistence-context" );
  
  		oos.writeBoolean( defaultReadOnly );
  		oos.writeBoolean( hasNonReadOnlyEntities );
  
