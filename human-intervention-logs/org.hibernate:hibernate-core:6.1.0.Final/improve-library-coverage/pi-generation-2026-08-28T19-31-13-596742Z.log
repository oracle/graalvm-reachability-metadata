  	private CurrentSessionContext buildCurrentSessionContext() {
  		String impl = (String) properties.get( Environment.CURRENT_SESSION_CONTEXT_CLASS );
  		// for backward-compatibility
  		if ( impl == null ) {
  			if ( canAccessTransactionManager() ) {
  				impl = "jta";
  			}
  			else {
  				return null;
