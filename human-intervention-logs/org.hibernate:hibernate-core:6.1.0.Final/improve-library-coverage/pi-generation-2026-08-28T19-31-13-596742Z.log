 factory = configuration.buildSessionFactory();\n                Session session = factory.openSession()) {\n            Transaction transaction = session.beginTransaction();\n            FieldLiteralEntity entity = new FieldLiteralEntity();\n            entity.setName(\"covered\");\n            entity.setStatus(QueryStatus.ACTIVE);\n            session.persist(entity);\n            transaction.commit();\n\n            List<FieldLiteralEntity> results = session.createQuery(\n                            \"from HqlFieldLiteralEntity e \"\n                                    + \"where e.status = \"\n                                    + \"org_hibernate.hibernate_core.QueryStatus.ACTIVE\",\n                            FieldLiteralEntity.class\n                    )\n                    .getResultList();\n\n            assertThat(results).singleElement().extracting(FieldLiteralEntity::getName)\n                    .isEqualTo(\"covered\");\n        }\n    }\n\n    @Entity(name = \"HqlFieldLiteralEntity\")\n    @Table(name = \"HQL_FIELD_LITERAL_ENTITY\")\n    public static class FieldLiteralEntity {\n        @Id\n        @GeneratedValue\n        private Long id;\n\n        private String name;\n\n        @Enumerated(EnumType.STRING)\n        private QueryStatus status;\n\n        public Long getId() {\n            return id;\n        }\n\n        public String getName() {\n            return name;\n        }\n\n        public void setName(String name) {\n            this.name = name;\n        }\n\n        public QueryStatus getStatus() {\n            return status;\n        }\n\n        public void setStatus(QueryStatus status) {\n            this.status = status;\n        }\n    }\n}\n"}
