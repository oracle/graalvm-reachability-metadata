ession.persist(entity);\n            transaction.commit();\n            session.clear();\n\n            FormulaEntity loaded = session.find(FormulaEntity.class, entity.getId());\n\n            assertThat(loaded.getNormalizedName()).isEqualTo(\"hibernate\");\n        }\n    }\n\n    @Entity(name = \"DialectOverrideFormulaEntity\")\n    @Table(name = \"DIALECT_OVERRIDE_FORMULA_ENTITY\")\n    public static class FormulaEntity {\n        @Id\n        @GeneratedValue\n        private Long id;\n\n        private String name;\n\n        @Formula(\"upper(name)\")\n        @DialectOverride.Formula(\n                dialect = H2Dialect.class,\n                override = @Formula(\"lower(name)\")\n        )\n        @DialectOverride.Formula(\n                dialect = PostgreSQLDialect.class,\n                override = @Formula(\"upper(name)\")\n        )\n        private String normalizedName;\n\n        public Long getId() {\n            return id;\n        }\n\n        public String getName() {\n            return name;\n        }\n\n        public void setName(String name) {\n            this.name = name;\n        }\n\n        public String getNormalizedName() {\n            return normalizedName;\n        }\n    }\n}\n"}
