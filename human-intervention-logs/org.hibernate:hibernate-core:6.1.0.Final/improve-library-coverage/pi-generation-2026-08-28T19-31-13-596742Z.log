tNormalizedName()).isEqualTo(\"hibernate\");\n        }\n    }\n\n    @Entity(name = \"DialectOverrideFormulaEntity\")\n    @Table(name = \"DIALECT_OVERRIDE_FORMULA_ENTITY\")\n    public static class FormulaEntity {\n        @Id\n        @GeneratedValue\n        private Long id;\n\n        private String name;\n\n        @Formula(\"upper(name)\")\n        @DialectOverride.Formula(\n                dialect = H2Dialect.class,\n                override = @Formula(\"lower(name)\")\n        )\n        @DialectOverride.Formula(\n                dialect = PostgreSQLDialect.class,\n                override = @Formula(\"upper(name)\")\n        )\n        private String normalizedName;\n\n        public Long getId() {\n            return id;\n        }\n\n        public String getName() {\n            return name;\n        }\n\n        public void setName(String name) {\n            this.name = name;\n        }\n\n        public String getNormalizedName() {\n            return normalizedName;\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_HZSyCcYmDIsPeAWgFhnIH1tO|fc_0318ff907922e8ad016a91e049614887d2a44e620cf06a289a", "name": "write", "arguments": {"path": "tests/src/org.hibernate/hibernate-core/6.1.0.Final/src/test/java/org_hibernate/hibernate_core/AnnotationBinderInnerCustomIdGeneratorCreatorTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_hibernate.hibernate_core;\n\nimport org.hibernate.Session;\nimport org.hibernate.SessionFactory;\nimport org.hibernate.Transaction;\nimport org.hibernate.annotations.UuidGenerator;\nimport org.hibernate.cfg.AvailableSettings;\nimport org.hibernate.cfg.Configuration;\nimport org.junit.jupiter.api.Test;\n\nimport jakarta.persistence.Entity;\nimport jakarta.persistence.Id;\nimport jakarta.persistence.Table;\nimport java.util.UUID;\n\nim