bernate/hibernate_core/BaselineSessionEventsListenerBuilderTest.java\ntests/src/org.hibernate/hibernate-core/6.1.0.Final/src/test/java/org_hibernate/hibernate_core/BasicDialectResolverTest.java\ntests/src/org.hibernate/hibernate-core/6.1.0.Final/src/test/java/org_hibernate/hibernate_core/BasicDotIdentifierConsumerInnerBaseLocalSequencePartTest.java\ntests/src/org.hibernate/hibernate-core/6.1.0.Final/src/test/java/org_hibernate/hibernate_core/BatchBuilderInitiatorTest.java\ntests/src/org.hibernate/hibernate-core/6.1.0.Final/src/test/java/org_hibernate/hibernate_core/BeanInjectorFieldTest.java\ntests/src/org.hibernate/hibernate-core/6.1.0.Final/src/test/java/org_hibernate/hibernate_core/BeanInjectorSetterTest.java\ntests/src/org.hibernate/hibernate-core/6.1.0.Final/src/test/java/org_hibernate/hibernate_core/BooleanPrimitiveArrayJavaTypeTest.java\ntests/src/org.hibernate/hibernate-core/6.1.0.Final/src/test/java/org_hibernate/hibernate_core/BoundedConcurrentHashMapTest.java\ntests/src/org.hibernate/hibernate-core/6.1.0.Final/src/test/java/org_hibernate/hibernate_core/ClassLoaderAccessImplTest.java\ntests/src/org.hibernate/hibernate-core/6.1.0.Final/src/test/java/org_hibernate/hibernate_core/ClassLoaderServiceImplTest.java\ntests/src/org.hibernate/hibernate-core/6.1.0.Final/src/test/java/org_hibernate/hibernate_core/ClobProxyTest.java\ntests/src/org.hibernate/hibernate-core/6.1.0.Final/src/test/java/org_hibernate/hibernate_core/CollectionBinderTest.java\ntests/src/org.hibernate/hibernate-core/6.1.0.Final/src/test/java/org_hibernate/hibernate_core/ConcurrentReferenceHashMapTest.java\ntests/src/org.hibernate/hibernate-core/6.1.0.Final/src/test/java/org_hibernate/hibernate_core/ConfigHelperTest.java\ntests/src/org.hibernate/hibernate-core/6.1.0.Final/src/test/java/org_hibernate/hibernate_core/ConfigurationServiceImplTest.java\ntests/src/org.hibernate/hibernate-core/6.1.0.Final/src/test/java/org_hibernate/hibernate_core/ConnectionProviderInitiatorTest.java\ntests/src/org.hib