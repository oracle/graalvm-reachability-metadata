 private final String name;\n        private final int major;\n\n        public ResultValue(String name, int major) {\n            this.name = name;\n            this.major = major;\n        }\n\n        public String getName() {\n            return name;\n        }\n\n        public int getMajor() {\n            return major;\n        }\n    }\n}\n"}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-sol", "usage": {"input": 1927, "output": 764, "cacheRead": 159232, "cacheWrite": 0, "reasoning": 351, "totalTokens": 161923, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1787940128215, "responseId": "resp_0d634f0dee980855016a91cd20946887d2bb1034ab9a37860b", "rawStopReason": "completed"}, "toolResults": [{"role": "toolResult", "toolCallId": "call_mE7vx4aCnAgh3xSbgStNy2qB|fc_0d634f0dee980855016a91cd2bdb3087d2a9496c2786392272", "toolName": "write", "content": [{"type": "text", "text": "Successfully wrote 1556 bytes to tests/src/org.hibernate/hibernate-core/6.1.0.Final/src/test/java/org_hibernate/hibernate_core/AliasToBeanConstructorResultTransformerTest.java"}], "isError": false, "timestamp": 1787940144357}]}
