nimport org.hibernate.boot.registry.StandardServiceRegistryBuilder;\nimport org.hibernate.cfg.AvailableSettings;\nimport org.hibernate.engine.jdbc.connections.internal.ConnectionProviderInitiator;\nimport org.hibernate.engine.jdbc.connections.spi.ConnectionProvider;\nimport org.hibernate.service.UnknownUnwrapTypeException;\nimport org.junit.jupiter.api.Test;\n\nimport java.sql.Connection;\nimport java.sql.SQLException;\nimport java.util.Map;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\npublic class ConnectionProviderInitiatorTest {\n\n    @Test\n    public void instantiatesAndInjectsAnExplicitConnectionProvider() {\n        StandardServiceRegistry registry = new StandardServiceRegistryBuilder()\n                .applySetting(\n                        AvailableSettings.CONNECTION_PROVIDER,\n                        ConfigurableConnectionProvider.class\n                )\n                .applySetting(\n                        ConnectionProviderInitiator.INJECTION_DATA,\n                        Map.of(\"label\", \"configured\")\n                )\n                .build();\n        try {\n            ConnectionProvider provider = registry.getService(ConnectionProvider.class);\n\n            assertThat(provider).isInstanceOf(ConfigurableConnectionProvider.class);\n            assertThat(((ConfigurableConnectionProvider) provider).getLabel())\n                    .isEqualTo(\"configured\");\n        }\n        finally {\n            StandardServiceRegistryBuilder.destroy(registry);\n        }\n    }\n\n    public static class ConfigurableConnectionProvider implements ConnectionProvider {\n        private String label;\n\n        public void setLabel(String label) {\n            this.label = label;\n        }\n\n        public String getLabel() {\n            return label;\n        }\n\n        @Override\n        public Connection getConnection() throws SQLException {\n            throw new SQLException(\"No connection was requested by this service test\");\n        }\n\n        @Override\n        public void closeConnection(Connection connection) throws SQLException {\n            connection.close();\n        }\n\n        @Override\n        public boolean supportsAggressiveRelease() {\n            return false;\n        }\n\n        @Override\n        public boolean isUnwrappableAs(Class<?> unwrapType) {\n            return unwrapType.isInstance(this);\n        }\n\n        @Override\n        public <T> T unwrap(Class<T> unwrapType) {\n            if (isUnwrappableAs(unwrapType)) {\n                return unwrapType.cast(this);\n            }\n            throw new UnknownUnwrapTypeException(unwrapType);\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_AoR7Yj42uTYHXcgEkXAu9kQb|fc_0d634f0dee980855016a91cc08684c87d2a60aa9a5063faacb", "name": "write", "arguments": {"path": "tests/src/org.hibernate/hibernate-core/6.1.0.Final/src/test/java/org_hibernate/hibernate_core/SessionFactoryOptionsBuilderTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_hibernate.hibernate_core;\n\nimport org.hibernate.EmptyInterceptor;\nimport org.hibernate.Session;\nimport org.hibernate.SessionFactory;\nimport org.hibernate.cfg.AvailableSettings;\nimport org.hibernate.cfg.Configuration;\nimport org.junit.jupiter.api.Test;\n\nimport java.util.concurrent.atomic.AtomicInteger;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\npublic class SessionFactoryOptionsBuilderTest {\n\n    @Test\n    public void createsAConfiguredSessionScopedInterceptor() {\n        RecordingInterceptor.instances.set(0);\n        Configuration configuration = new Configuration()\n                .setProperty(AvailableSettings.URL, \"jdbc:h2:mem:session-options\")\n                .setProperty(AvailableSettings.DRIVER, \"org.h2.Driver\")\n                .setProperty(AvailableSettings.DIALECT, \"org.hibernate.dialect.H2Dialect\")\n                .setProperty(\n                        AvailableSettings.SESSION_SCOPED_INTERCEPTOR,\n                        RecordingInterceptor.class.getName()\n                );\n\n        try (SessionFactory factory = configuration.buildSessionFactory();\n                Session session = factory.openSession()) {\n            assertThat(session.isOpen()).isTrue();\n            assertThat(RecordingInterceptor.instances).hasValue(1);\n        }\n    }\n\n    public static class RecordingInterceptor extends EmptyInterceptor {\n        private static final long serialVersionUID = 1L;\n        private static final AtomicInteger instances = new AtomicInteger();\n\n        public RecordingInterceptor() {\n            instances.incrementAndGet();\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_wyyatZqL8MriLRWP469ORmex|fc_0d634f0dee980855016a91cc08685487d2997a7448515c38c0", "name": "write", "arguments": {"path": "tests/src/org.hibernate/hibernate-core/6.1.0.Final/src/test/java/org_hibernate/hibernate_core/EventListenerGroupImplTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_hibernate.hibernate_core;\n\nimport org.hibernate.SessionFactory;\nimport org.hibernate.cfg.AvailableSettings;\nimport org.hibernate.cfg.Configuration;\nimport org.hibernate.engine.spi.SessionFactoryImplementor;\nimport org.hibernate.event.service.spi.EventListenerGroup;\nimport org.hibernate.event.service.spi.EventListenerRegistry;\nimport org.hibernate.event.spi.EventType;\nimport org.hibernate.event.spi.PreLoadEvent;\nimport org.hibernate.event.spi.PreLoadEventListener;\nimport org.junit.jupiter.api.Test;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\npublic class EventListenerGroupImplTest {\n\n    @Test\n    public void appendsAndPrependsListenerInstances() {\n        try (SessionFactory factory = createSessionFactory()) {\n            EventListenerRegistry registry = ((SessionFactoryImplementor) factory)\n                    .getServiceRegistry()\n                    .getService(EventListenerRegistry.class);\n            EventListenerGroup<PreLoadEventListener> group =\n                    registry.getEventListenerGroup(EventType.PRE_LOAD);\n            FirstListener first = new FirstListener();\n            SecondListener second = new SecondListener();\n\n            group.appendListener(first);\n            group.prependListener(second);\n\n            assertThat(group.listeners()).containsExactly(second, first);\n        }\n    }\n\n    private static SessionFactory createSessionFactory() {\n        return new Configuration()\n                .setProperty(AvailableSettings.URL, \"jdbc:h2:mem:event-group\")\n                .setProperty(AvailableSettings.DRIVER, \"org.h2.Driver\")\n                .setProperty(AvailableSettings.DIALECT, \"org.hibernate.dialect.H2Dialect\")\n                .buildSessionFactory();\n    }\n\n    public static class FirstListener implements PreLoadEventListener {\n        @Override\n        public void onPreLoad(PreLoadEvent event) {\n        }\n    }\n\n    public static class SecondListener implements PreLoadEventListener {\n        @Override\n        public void onPreLoad(PreLoadEvent event) {\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_OITEXJeG1G7nBUpiXZLrs98D|fc_0d634f0dee980855016a91cc08685c87d291ddd3a11fcc828e", "name": "write", "arguments": {"path": "tests/src/org.hibernate/hibernate-core/6.1.0.Final/src/test/java/org_hibernate/hibernate_core/EventListenerRegistryImplTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_hibernate.hibernate_core;\n\nimport org.hibernate.SessionFactory;\nimport org.hibernate.cfg.AvailableSettings;\nimport org.hibernate.cfg.Configuration;\nimport org.hibernate.engine.spi.SessionFactoryImplementor;\nimport org.hibernate.event.service.spi.EventListenerGroup;\nimport org.hibernate.event.service.spi.EventListenerRegistry;\nimport org.hibernate.event.spi.EventType;\nimport org.hibernate.event.spi.PreLoadEvent;\nimport org.hibernate.event.spi.PreLoadEventListener;\nimport org.junit.jupiter.api.Test;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\npublic class EventListenerRegistryImplTest {\n\n    @Test\n    public void createsListenersFromConfiguredClasses() {\n        try (SessionFactory factory = createSessionFactory()) {\n            EventListenerRegistry registry = ((SessionFactoryImplementor) factory)\n                    .getServiceRegistry()\n                    .getService(EventListenerRegistry.class);\n\n            registry.setListeners(\n                    EventType.PRE_LOAD,\n                    FirstListener.class,\n                    SecondListener.class\n            );\n            EventListenerGroup<PreLoadEventListener> group =\n                    registry.getEventListenerGroup(EventType.PRE_LOAD);\n\n            assertThat(group.listeners())\n                    .hasOnlyElementsOfTypes(FirstListener.class, SecondListener.class)\n                    .hasSize(2);\n        }\n    }\n\n    private static SessionFactory createSessionFactory() {\n        return new Configuration()\n                .setProperty(AvailableSettings.URL, \"jdbc:h2:mem:event-registry\")\n                .setProperty(AvailableSettings.DRIVER, \"org.h2.Driver\")\n                .setProperty(AvailableSettings.DIALECT, \"org.hibernate.dialect.H2Dialect\")\n                .buildSessionFactory();\n    }\n\n    public static class FirstListener implements PreLoadEventListener {\n        @Override\n        public void onPreLoad(PreLoadEvent event) {\n        }\n    }\n\n    public static class SecondListener implements PreLoadEventListener {\n        @Override\n        public void onPreLoad(PreLoadEvent event) {\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_8WynFOGXAx8rDrYq2L2jGs72|fc_0d634f0dee980855016a91cc08686487d2b9488550ce5f93c9", "name": "write", "arguments": {"path": "tests/src/org.hibernate/hibernate-core/6.1.0.Final/src/test/java/org_hibernate/hibernate_core/LocalXsdResolverTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_hibernate.hibernate_core;\n\nimport org.hibernate.boot.xsd.LocalXsdResolver;\nimport org.junit.jupiter.api.Test;\n\nimport java.net.URL;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\npublic class LocalXsdResolverTest {\n\n    @Test\n    public void locatesHibernateSchemasFromTheLibraryJar() {\n        URL schema = LocalXsdResolver.resolveLocalXsdUrl(\n                \"org/hibernate/xsd/cfg/legacy-configuration-4.0.xsd\"\n        );\n\n        assertThat(schema).isNotNull();\n    }\n}\n"}}, {"type": "toolCall", "id": "call_tv2dPDeaUiOyFf0cjBomJCFf|fc_0d634f0dee980855016a91cc08686887d2859c2361aab30935", "name": "write", "arguments": {"path": "tests/src/org.hibernate/hibernate-core/6.1.0.Final/src/test/java/org_hibernate/hibernate_core/SimpleResourceLocatorTest.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_hibernate.hibernate_core;\n\nimport org.hibernate.boot.internal.SimpleResourceLocator;\nimport org.junit.jupiter.api.Test;\n\nimport java.net.URL;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\npublic class SimpleResourceLocatorTest {\n\n    @Test\n    public void locatesApplicationResources() {\n        URL resource = SimpleResourceLocator.INSTANCE.locateResource(\n                \"hibernate-coverage.cfg.xml\"\n        );\n\n        assertThat(resource).isNotNull();\n    }\n}\n"}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-sol", "usage": {"input": 1320, "output": 2874, "cacheRead": 131584, "cacheWrite": 0, "reasoning": 217, "totalTokens": 135778, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1787939792351, "responseId": "resp_0d634f0dee980855016a91cbd0bedc87d282f42debb335be2f", "rawStopReason": "completed"}, "toolResults": [{"role": "toolResult", "toolCallId": "call_SQSKTbeuo2jrKoO9nqkLYduQ|fc_0d634f0dee980855016a91cc08683c87d297dfbde10a8fa24c", "toolName": "write", "content": [{"type": "text", "text": "Successfully wrote 2902 bytes to tests/src/org.hibernate/hibernate-core/6.1.0.Final/src/test/java/org_hibernate/hibernate_core/ConnectionProviderInitiatorTest.java"}], "isError": false, "timestamp": 1787939848607}, {"role": "toolResult", "toolCallId": "call_AoR7Yj42uTYHXcgEkXAu9kQb|fc_0d634f0dee980855016a91cc08684c87d2a60aa9a5063faacb", "toolName": "write", "content": [{"type": "text", "text": "Successfully wrote 1807 bytes to tests/src/org.hibernate/hibernate-core/6.1.0.Final/src/test/java/org_hibernate/hibernate_core/SessionFactoryOptionsBuilderTest.java"}], "isError": false, "timestamp": 1787939848607}, {"role": "toolResult", "toolCallId": "call_wyyatZqL8MriLRWP469ORmex|fc_0d634f0dee980855016a91cc08685487d2997a7448515c38c0", "toolName": "write", "content": [{"type": "text", "text": "Successfully wrote 2264 bytes to tests/src/org.hibernate/hibernate-core/6.1.0.Final/src/test/java/org_hibernate/hibernate_core/EventListenerGroupImplTest.java"}], "isError": false, "timestamp": 1787939848607}, {"role": "toolResult", "toolCallId": "call_OITEXJeG1G7nBUpiXZLrs98D|fc_0d634f0dee980855016a91cc08685c87d291ddd