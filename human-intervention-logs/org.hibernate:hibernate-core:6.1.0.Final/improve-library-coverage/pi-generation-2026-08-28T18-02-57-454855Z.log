  				else {
  					// i + 4, because there has to be a comma or closing brace after null
  					if ( i + 4 < len
  							&& charSequence.charAt( i ) == 'n'
  							&& charSequence.charAt( i + 1 ) == 'u'
  							&& charSequence.charAt( i + 2 ) == 'l'
  							&& charSequence.charAt( i + 3 ) == 'l') {
