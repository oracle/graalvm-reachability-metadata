org_hibernate.hibernate_core;\n\nimport org.hibernate.jpa.internal.util.PersistenceUtilHelper;\nimport org.junit.jupiter.api.Test;\n\nimport jakarta.persistence.spi.LoadState;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\npublic class PersistenceUtilHelperTest {\n\n    @Test\n    public void resolvesBooleanPropertiesUsingTheirAccessorMethod() {\n        LoadState state = PersistenceUtilHelper.isLoadedWithReference(\n                new GetterOnlyValue(),\n                \"ready\",\n                new PersistenceUtilHelper.MetadataCache()\n        );\n\n        assertThat(state).isEqualTo(LoadState.UNKNOWN);\n    }\n\n    public static class GetterOnlyValue {\n        public boolean isReady() {\n            return true;\n        }\n    }\n}\n"}}, {"type": "toolCall", "id": "call_X8GHFZYBXCiVZH59xVNd4XoU|fc_0d634f0dee980855016a91cc7516b087d288a2ebe3c4127f23", "name": "write", "arguments": {"path": "tests/src/org.hibernate/hibernate-core/6.1.0.Final/src/test/java/org_hibernate/hibernate_core/PersistenceUtilHelperInnerClassMetadataCacheAnonymous1Test.java", "content": "/*\n * Copyright and related rights waived via CC0\n *\n * You should have received a copy of the CC0 legalcode along with this\n * work. If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.\n */\npackage org_hibernate.hibernate_core;\n\nimport org.hibernate.jpa.internal.util.PersistenceUtilHelper;\nimport org.junit.jupiter.api.Test;\n\nimport jakarta.persistence.spi.LoadState;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\npublic class PersistenceUtilHelperInnerClassMetadataCacheAnonymous1Test {\n\n    @Test\n    public void discoversAnApplicationField() {\n        LoadState state = PersistenceUtilHelper.isLoadedWithReference(\n                new FieldValue(),\n                \"value\",\n                new PersistenceUtilHelper.MetadataCache()\n        );\n\n        assertThat(state).isEqualTo(LoadState.UNKNOWN);\n    }\n\n    public static class FieldV