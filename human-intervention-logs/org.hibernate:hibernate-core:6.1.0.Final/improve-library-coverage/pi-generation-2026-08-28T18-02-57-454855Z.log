       @Id\n        private Long id;\n        private boolean createdByListener;\n    }\n\n    public static class CreationListener {\n        @PrePersist\n        public void beforePersist(ListenedEntity entity) {\n            entity.createdByListener = true;\n        }\n    }\n}\n"}
