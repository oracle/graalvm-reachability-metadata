[tool-call] delta {"path":"tests/src/org.hibernate/hibernate-core/6.1.0.Final/src/test/java/org_hibernate/hibernate_core/ConnectionProviderInitiatorTest.java","edits":[{"oldText":"import org.hibernate.service.UnknownUnwrapTypeException;\nimport org.junit.jupiter.api.Test;\n\nimport java.sql.Connection;\nimport java.sql.SQLException;\nimport java.util.Map;","newText":"import org.hibernate.service.UnknownUnwrapTypeException;\nimport org.hibernate.service.spi.ServiceRegistryImplementor;\nimport org.junit.jupiter.api.Test;\n\nimport java.sql.Connection;\nimport java.sql.SQLException;\nimport java.util.HashMap;\nimport java.util.Map;"},{"oldText":"        StandardServiceRegistry registry = new StandardServiceRegistryBuilder()\n                .applySetting(\n                        AvailableSettings.CONNECTION_PROVIDER,\n                        ConfigurableConnectionProvider.class\n                )\n                .applySetting(\n                        ConnectionProviderInitiator.INJECTION_DATA,\n                        Map.of(\"label\", \"configured\")\n                )\n                .build();\n        try {\n            ConnectionProvider provider = registry.getService(ConnectionProvider.class);\n\n            assertThat(provider).isInstanceOf(ConfigurableConnectionProvider.class);\n            assertThat(((ConfigurableConnectionProvider) provider).getLabel())\n                    .isEqualTo(\"configured\");\n        }\n        finally {\n            StandardServiceRegistryBuilder.destroy(registry);\n        }","newText":"        StandardServiceRegistry registry = new StandardServiceRegistryBuilder().build();\n        Map<String, Object> settings = new HashMap<>();\n        settings.put(\n                AvailableSettings.CONNECTION_PROVIDER,\n                ConfigurableConnectionProvider.class\n        );\n        settings.put(\n                ConnectionProviderInitiator.INJECTION_DATA,\n                Map.of(\"label\", \"configured\")\n        );\n        try {\n            ConnectionProvider provider = new ConnectionProviderInitiator().initiateService(\n                    settings,\n                    (ServiceRegistryImplementor) registry\n            );\n\n            assertThat(provider).isInstanceOf(ConfigurableConnectionProvider.class);\n            assertThat(((ConfigurableConnectionProvider) provider).getLabel())\n                    .isEqualTo(\"configured\");\n        }\n        finally {\n            StandardServiceRegistryBuilder.destroy(registry);\n        }"}]}
