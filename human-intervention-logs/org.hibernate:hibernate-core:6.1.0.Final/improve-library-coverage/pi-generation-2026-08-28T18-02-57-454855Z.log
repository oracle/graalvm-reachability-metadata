  			try {
  				ReflectHelper.ensureAccessibility( constructor );
  			}
  			catch ( SecurityException e ) {
  				constructor = null;
  			}
  		}
  		catch ( NoSuchMethodException ignore ) {
  		}
  
  		return constructor;
  	}
  
