  		}
  		if ( "getAsciiStream".equals( methodName ) && argCount == 0 ) {
  			return getAsciiStream();
  		}
  		if ( "getCharacterStream".equals( methodName ) ) {
  			if ( argCount == 0 ) {
  				return getCharacterStream();
  			}
