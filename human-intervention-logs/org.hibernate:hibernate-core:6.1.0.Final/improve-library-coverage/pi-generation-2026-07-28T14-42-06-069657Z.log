\n    }\n\n    public DialectOverrideEntity(String name, boolean active) {\n        this.name = name;\n        this.active = active;\n    }\n\n    public Long getId() {\n        return id;\n    }\n\n    public boolean isActive() {\n        return active;\n    }\n\n    public String getName() {\n        return name;\n    }\n}\n"}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-terra", "usage": {"input": 5677, "output": 1652, "cacheRead": 25600, "cacheWrite": 0, "totalTokens": 32929, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1785249655768, "responseId": "resp_0c2afbd71237b35d016a68bf789ad481969c9b1e8aff2d7126"}, "toolResults": [{"role": "toolResult", "toolCallId": "call_O56gOanKVpPMEcUYSjgqKcpY|fc_0c2afbd71237b35d016a68bf8f098c8196be439557847b1f5d", "toolName": "write", "content": [{"type": "text", "text": "Successfully wrote 1630 bytes to tests/src/org.hibernate/hibernate-core/6.1.0.Final/src/test/java/org_hibernate/hibernate_core/entity/DialectOverrideEntity.java"}], "isError": false, "timestamp": 1785249687235}]}
