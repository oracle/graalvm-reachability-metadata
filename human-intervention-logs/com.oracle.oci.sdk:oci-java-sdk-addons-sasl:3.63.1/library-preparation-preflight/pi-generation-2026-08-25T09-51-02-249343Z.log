er();\n52: \n53:     private final OciMechanism mechanism;\n54:     private final BasicAuthenticationDetailsProvider authProvider;\n55:     private final String intent;\n56:     private OciPrivateKey currentPrivateKey = null;\n57:     private State state = State.KEY_ID;\n58: \n59:     private enum State {\n60:         KEY_ID,\n61:         SIGNING,\n62:         COMPLETE\n63:     }\n64: \n65:     private OciSaslClient(\n66:             OciMechanism mechanism,\n67:             BasicAuthenticationDetailsProvider authProvider,\n68:             String intent) {\n69:         this.mechanism = mechanism;\n70:         this.authProvider = authProvider;\n71:         this.intent = intent;\n72:     }\n73: \n74:     @Override\n75:     public String getMechanismName() {\n76:         return mechanism.mechanismName();\n77:     }\n78: \n79:     @Override\n80:     public byte[] evaluateChallenge(byte[] challenge) throws SaslException {\n81:         switch (state) {\n82:             case KEY_ID:\n83:                 // First step is to send the keyId with the intent\n84:                 state = State.SIGNING;\n85:                 return generateKeyMessage().toByteArray();\n86:             case SIGNING:\n87:                 // Response should now contain the challenge sent by the server that we have to sign\n88:                 Response response = signChallenge(challenge);\n89:                 state = State.COMPLETE;\n90:                 return response.toByteArray();\n91:             default:\n92:                 return new byte[0];\n93:         }\n94:     }\n95: \n96:     private Key generateKeyMessage() {\n97:         // Because the authProvider might be used across multiple clients,\n98:         // we need to protect its access while we generate and retrieve a new private key\n99:         synchronized (authProvider) {\n100:             // Get a new token for each new key exchange to prevent stale keys\n101:             if (authProvider instanceof ConfigurableRefreshOnNotAuthenticatedProvider) {\n102:                 ((ConfigurableRefreshOnNotAuthenticatedProvider<?>) authProvider)\n103:                         .refreshIfExpiringWithin(Duration.ofMinutes(5), false);\n104:             }\n105: \n106:             if (currentPrivateKey != null) {\n107:                 StreamUtils.closeQuietly(currentPrivateKey.privateKey);\n108:                 currentPrivateKey = null;\n109:             }\n110: \n--- 120-180\n120: \n121:     private Response signChallenge(byte[] serializedChallenge) throws SaslException {\n122: \n123:         Validate.isTrue(currentPrivateKey != null, \"required: currentPrivateKey != null\");\n124: \n125:         final Challenge challenge = getAndValidateChallenge(serializedChallenge);\n126:         final long epoch = OffsetDateTime.now().toEpochSecond();\n127: \n128:         final PEMFileRSAPrivateKeySupplier keySupplier =\n129:                 new PEMFileRSAPrivateKeySupplier(\n130:                         currentPrivateKey.privateKey, currentPrivateKey.passphraseCharacters);\n131: \n132:         currentPrivateKey = null;\n133: \n134:         final RSAPrivateKey privateKey =\n135:                 keySupplier\n136:                         .supplyKey()\n137:                         .orElseThrow(() -> new SaslException(\"Unable to get private key\"));\n138: \n139:         final byte[] intentBytes = intent.getBytes(StandardCharsets.UTF_8);\n140: \n141:         final int messageToSignLength =\n142:                 challenge.getChallenge().toByteArray().length + intentBytes.length + Long.BYTES;\n143:         final ByteBuffer messageToSign = ByteBuffer.allocate(messageToSignLength);\n144:         messageToSign.put(challenge.getChallenge().toByteArray());\n145:         messageToSign.put(intentBytes);\n146:         messageToSign.putLong(epoch);\n147: \n148:         final byte[] signedMessage =\n149:                 SIGNER.sign(privateKey, messageToSign.array(), mechanism.algorithm().getJvmName());\n150: \n151:         return Response.newBuilder()\n152:                 .setTime(epoch)\n153:                 .setSignature(ByteString.copyFrom(signedMessage))\n154:                 .build();\n155:     }\n156: \n157:     private Challenge getAndValidateChallenge(byte[] data) throws SaslException {\n158: \n159:         try {\n160:             Challenge challenge = Challenge.parseFrom(data);\n161: \n162:             final int challengeSize = challenge.getChallenge().size();\n163:             if (challengeSize < MIN_CHALLENGE_SIZE || challengeSize > MAX_CHALLENGE_SIZE) {\n164:                 throw new SaslException(\n165:                         \"Challenge sent by the server doesn't have the right size - \"\n166:                                 + challengeSize);\n167:             }\n168: \n169:             return challenge;\n170: \n171:         } catch (InvalidProtocolBufferException exc) {\n172:             throw new SaslException(\"Challenge sent by the server is invalid\", exc);\n173:         }\n174:     }\n175: \n176:     @Override\n177:     public boolean hasInitialResponse() {\n178:         return true;\n179:     }\n180: \n--- 200-285\n200: \n201:     @Override\n202:     public void dispose() {}\n203: \n204:     public static class OciSaslClientFactory implements SaslClientFactory {\n205: \n206:         @Override\n207:         public SaslClient createSaslClient(\n208:                 String[] mechanisms,\n209:                 String authorizationId,\n210:                 String protocol,\n211:                 String serverName,\n212:                 Map<String, ?> props,\n213:                 CallbackHandler cbh)\n214:                 throws SaslException {\n215: \n216:             OciMechanism ociMechanism = null;\n217:             for (String mechanism : mechanisms) {\n218:                 ociMechanism = OciMechanism.fromMechanismName(mechanism);\n219:                 if (ociMechanism != null) {\n220:                     break;\n221:                 }\n222:             }\n223:             if (ociMechanism == null) {\n224:                 throw new SaslException(\n225:                         String.format(\n226:                                 \"Requested mechanisms '%s' not supported. Supported mechanisms are '%s'.\",\n227:                                 Collections.singletonList(mechanisms),\n228:                                 OciMechanism.mechanismNames()));\n229:             }\n230: \n231:             final Credentials credentials = getCredentials(cbh);\n232: \n233:             return new OciSaslClient(ociMechanism, credentials.authProvider, credentials.payload);\n234:         }\n235: \n236:         @Override\n237:         public String[] getMechanismNames(Map<String, ?> props) {\n238:             Collection<String> mechanisms = OciMechanism.mechanismNames();\n239:             return mechanisms.toArray(new String[0]);\n240:         }\n241: \n242:         private Credentials getCredentials(CallbackHandler callbackHandler) throws SaslException {\n243: \n244:             final NameCallback nameCallback = new NameCallback(\"Payload\");\n245:             final PasswordCallback passwordCallback =\n246:                     new PasswordCallback(\"AuthProviderKey\", false);\n247:             final OciAuthProviderCallback authProviderCallback = new OciAuthProviderCallback();\n248: \n249:             execute(callbackHandler, nameCallback, true);\n250:             execute(callbackHandler, passwordCallback, false);\n251:             execute(callbackHandler, authProviderCallback, false);\n252: \n253:             if (authProviderCallback.authProvider() == null\n254:                     && passwordCallback.getPassword() == null) {\n255:                 throw new SaslException(\n256:                         \"Callback handler needs to support either PasswordCallback or OciAuthProviderCallback\");\n257:             }\n258: \n259:             final BasicAuthenticationDetailsProvider authProvider =\n260:                     authProviderCallback.authProvider() != null\n261:                             ? authProviderCallback.authProvider()\n262:                             : AuthProviderCache.get(new String(passwordCallback.getPassword()));\n263: \n264:             final String intent = nameCallback.getName();\n265: \n266:             return new Credentials(authProvider, intent);\n267:         }\n268: \n269:         static <T extends Callback> void execute(\n270:                 CallbackHandler callbackHandler, T callback, boolean required)\n271:                 throws SaslException {\n272:             try {\n273:                 callbackHandler.handle(new Callback[] {callback});\n274:             } catch (UnsupportedCallbackException exc) {\n275:                 if (required) {\n276:                     throw new SaslException(\n277:                             exc.getCallback().getClass().getSimpleName()\n278:                                     + \" is not supported by the callback handler\",\n279:                             exc);\n280:                 }\n281:             } catch (IOException exc) {\n282:                 throw new SaslException(\"Unexpected IOException during callback handler\", exc);\n283:             }\n284:         }\n285: \n"}], "isError": false, "timestamp": 1787651439370}, {"role": "toolResult", "toolCallId": "call_juGVlN6eONtnG0g9JAh9rzfy|fc_09409964c023463a016a8d656e537887d2a8cacf473840442c", "toolName": "bash", "content": [{"type": "text", "text": "(no output)"}], "isError": false, "timestamp": 1787651439370}]}
