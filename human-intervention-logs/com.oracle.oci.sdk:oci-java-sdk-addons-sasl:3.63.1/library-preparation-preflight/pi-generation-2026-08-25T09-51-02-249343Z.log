d>\n            <executions>\n              <!-- Copy jar for signing -->\n              <execution>\n                <id>copy-jar</id>\n                <phase>package</phase>\n                <goals>\n                  <goal>run</goal>\n                </goals>\n                <configuration>\n                  <target name=\"copy-jar\">\n                    <copy file=\"${project.build.directory}/${project.artifactId}-${project.version}.jar\" tofile=\"${source.jar.for.zip}\"/>\n                  </target>\n                </configuration>\n              </execution>\n            </executions>\n          </plugin>\n          <plugin>\n            <!-- https://csshub.us-phoenix-1.oci.oraclecorp.com/webcodesign/ -->\n            <groupId>com.oracle.ccss</groupId>\n            <artifactId>codesign-maven-plugin</artifactId>\n            <executions>\n              <execution>\n                <!-- Run in pre-integration-test phase, which comes after the package phase. -->\n                <!-- That way, all jar files have been built already. -->\n                <phase>pre-integration-test</phase>\n                <goals>\n                  <goal>sign</goal>\n                </goals>\n              </execution>\n            </executions>\n            <configuration>\n              <user>dexsdk_grp</user>\n              <globalUID>joshunte</globalUID>\n              <fileToSign>${source.jar.for.zip}</fileToSign>\n              <signLocation>${project.build.directory}</signLocation>\n              <signMethod>java2</signMethod>\n              <signingParameters>${codesign-maven-plugin.signingParameters}</signingParameters>\n            </configuration>\n          </plugin>\n          <!-- Assemble only during the 'sign' profile as we need to assemble the signed jar -->\n          <!-- Assemble the single jar, dependencies, docs, examples into a zip archive -->\n          <plugin>\n            <groupId>org.apache.maven.plugins</groupId>\n            <artifactId>maven-assembly-plugin</artifactId>\n            <configuration>\n              <appendAssemblyId>true</appendAssemblyId>\n              <attach>true</attach>\n              <descriptors>\n                <descriptor>src/main/assembly/assembly.xml</descriptor>\n              </descriptors>\n            </configuration>\n            <executions>\n              <execution>\n                <phase>pre-integration-test</phase>\n                <goals>\n                  <goal>single</goal>\n                </goals>\n              </execution>\n            </executions>\n          </plugin>\n        </plugins>\n      </build>\n    </profile>\n    <!-- Just do assembly, no signing -->\n    <profile>\n      <id>ziponly</id>\n      <properties>\n        <source.jar.for.zip>${project.build.directory}/${project.artifactId}-${project.version}.jar</source.jar.for.zip>\n      </properties>\n      <build>\n        <plugins>\n          <!-- Explicitly generate the sources jar in the package phase so that it will be included in the bundle -->\n          <plugin>\n            <groupId>org.apache.maven.plugins</groupId>\n            <artifactId>maven-source-plugin</artifactId>\n            <executions>\n              <execution>\n                <id>attach-sources</id>\n                <phase>package</phase>\n                <goals>\n                  <goal>jar-no-fork</goal>\n                </goals>\n              </execution>\n            </executions>\n          </plugin>\n          <plugin>\n            <artifactId>maven-assembly-plugin</artifactId>\n            <configuration>\n              <appendAssemblyId>true</appendAssemblyId>\n              <attach>true</attach>\n              <descriptors>\n                <descriptor>src/main/assembly/assembly.xml</descriptor>\n              </descriptors>\n            </configuration>\n            <executions>\n              <execution>\n                <phase>package</phase>\n                <goals>\n                  <goal>single</goal>\n                </goals>\n              </execution>\n            </executions>\n          </plugin>\n        </plugins>\n      </build>\n    </profile>\n  </profiles>\n  <!-- END: Delete Public GitHub -->\n\n  <build>\n    <!-- Substitutes maven properties into the SDK properties -->\n    <resources>\n      <resource>\n        <directory>src/main/resources</directory>\n        <filtering>true</filtering>\n      </resource>\n    </resources>\n    <plugins>\n      <plugin>\n        <groupId>com.github.os72</groupId>\n        <artifactId>protoc-jar-maven-plugin</artifactId>\n        <version>3.11.4</version>\n        <executions>\n          <execution>\n            <phase>generate-sources</phase>\n            <goals>\n              <goal>run</goal>\n            </goals>\n            <configuration>\n              <inputDirectories>\n                <include>${project.basedir}/src/main/protobuf</include>\n              </inputDirectories>\n              <outputTargets>\n                <outputTarget>\n                  <type>java</type>\n                  <outputDirectory>${project.basedir}/target/generated-sources/protobuf</outputDirectory>\n                </outputTarget>\n              </outputTargets>\n            </configuration>\n          </execution>\n        </executions>\n      </plugin>\n    </plugins>\n  </build>\n\n  <dependencies>\n    <dependency>\n      <groupId>com.google.protobuf</groupId>\n      <artifactId>protobuf-java</artifactId>\n      <version>3.25.5</version>\n    </dependency>\n    <dependency>\n      <groupId>com.oracle.oci.sdk</groupId>\n      <artifactId>oci-java-sdk-common</artifactId>\n      <version>3.63.1</version>\n    </dependency>\n  </dependencies>\n\n</project>\n--- source files ---\nArchive:  /tmp/oci-sasl-research/oci-java-sdk-addons-sasl-3.63.1-sources.jar\n  Length      Date    Time    Name\n---------  ---------- -----   ----\n   116489  2025-04-14 22:40   THIRD_PARTY_LICENSES.txt\n    13218  2025-04-14 22:40   LICENSE.txt\n      