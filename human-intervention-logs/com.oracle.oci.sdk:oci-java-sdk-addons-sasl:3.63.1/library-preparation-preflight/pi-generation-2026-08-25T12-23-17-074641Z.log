                    <type>java</type>
                    <outputDirectory>${project.basedir}/target/generated-sources/protobuf</outputDirectory>
                  </outputTarget>
                </outputTargets>
              </configuration>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </build>
  
