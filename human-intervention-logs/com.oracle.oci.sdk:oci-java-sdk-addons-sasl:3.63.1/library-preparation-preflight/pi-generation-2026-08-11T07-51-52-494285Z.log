                  String protocol,
                  String serverName,
                  Map<String, ?> props,
                  CallbackHandler cbh)
                  throws SaslException {
  
              OciMechanism ociMechanism = null;
              for (String mechanism : mechanisms) {
                  ociMechanism = OciMechanism.fromMechanismName(mechanism);
                  if (ociMechanism != null) {
                      break;
