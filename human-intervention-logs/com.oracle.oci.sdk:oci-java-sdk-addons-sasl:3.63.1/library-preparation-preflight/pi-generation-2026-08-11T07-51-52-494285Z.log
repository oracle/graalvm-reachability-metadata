                  this.authProvider = authProvider;
                  this.payload = payload;
              }
          }
      }
  
      static class AuthProviderCache {
  
          private static final Map<String, BasicAuthenticationDetailsProvider> authProvidersCache =
                  new ConcurrentHashMap<>();
  
