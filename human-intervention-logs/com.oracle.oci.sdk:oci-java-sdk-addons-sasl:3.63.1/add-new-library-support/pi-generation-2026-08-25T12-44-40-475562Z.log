e.Path;\nimport java.security.KeyPair;\n"}, {"oldText": "import javax.security.auth.callback.Callback;\n", "newText": "import javax.security.auth.Subject;\nimport javax.security.auth.callback.Callback;\n"}, {"oldText": "import org.junit.jupiter.api.Test;\n", "newText": "import org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.io.TempDir;\n"}, {"oldText": "    @Test\n    void registeredProviderCreatesAndCompletesAnOciSaslExchange() throws Exception {\n", "newText": "    @Test\n    void userPrincipalsLoginModuleLoadsConfiguredCredentialsIntoSubject(@TempDir Path tempDirectory)\n            throws Exception {\n        KeyPair keyPair = KeyPairGenerator.getInstance(\"RSA\").generateKeyPair();\n        BasicAuthenticationDetailsProvider configuredProvider = new TestAuthenticationProvider(keyPair);\n        Path privateKeyFile = tempDirectory.resolve(\"oci_api_key.pem\");\n        try (InputStream privateKey = configuredProvider.getPrivateKey()) {\n            Files.write(privateKeyFile, privateKey.readAllBytes());\n        }\n\n        Path configurationFile = tempDirectory.resolve(\"config\");\n        Files.writeString(\n                configurationFile,\n                \"\"\"\n                [SASL]\n                user=ocid1.user.oc1..test\n                fingerprint=fingerprint\n                tenancy=ocid1.tenancy.oc1..test\n                region=us-ashburn-1\n                key_file=%s\n                \"\"\"\n                        .formatted(privateKeyFile));\n\n        Subject subject = new Subject();\n        UserPrincipalsLoginModule loginModule = new UserPrincipalsLoginModule();\n        loginModule.initialize(\n                subject,\n                null,\n                Map.of(),\n                Map.of(\"intent\", \"database\", \"config\", configurationFile.toString(), \"profile\", \"SASL\"));\n\n        assertThat(loginModule.login()).isTrue();\n        assertThat(loginModule.commit()).isTrue();\n        assertThat(subject.getPublicCredentials()).contains(\"database\");\n        assertThat(subject.getPrivateCredentials(BasicAuthenticationDetailsProvider.class))\n                .singleElement()\n                .satisfies(\n                        provider ->\n                                assertThat(provider.getKeyId())\n                                        .isEqualTo(\"ocid1.user.oc1..test/fingerprint\"));\n    }\n\n    @Test\n    void registeredProviderCreatesAndCompletesAnOciSaslExchange() throws Exception {\n"}]}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-terra", "usage": {"input": 5151, "output": 1254, "cacheRead": 70144, "cacheWrite": 0, "reasoning": 559, "totalTokens": 76549, "cost": {"input": 0.010302, "output": 0.015048, "cacheRead": 0.014028800000000001, "cacheWrite": 0, "total": 0.039378800000000005}}, "stopReason": "toolUse", "timestamp": 1787661795670, "responseId": "resp_06eb7c9f767ff06f016a8d8de4117c87d2a78f899a064989d2", "rawStopReason": "completed"}, "toolResults": [{"role": "toolResult", "toolCallId": "call_p9kJsWpGaegttT0GAzS5xBNg|fc_06eb7c9f767ff06f016a8d8def302887d2b89fc861010c6b3b", "toolName": "edit", "content": [{"type": "text", "text": "Successfully replaced 5 block(s) in tests/src/com.oracle.oci.sdk/oci-java-sdk-addons-sasl/3.63.1/src/test/java/com_oracle_oci_sdk/oci_java_sdk_addons_sasl/Oci_java_sdk_addons_saslTest.java."}], "details": {"diff": "     ...\n  13 import com.oracle.bmc.auth.sasl.OciAuthProviderCallback;\n  14 import com.oracle.bmc.auth.sasl.OciMechanism;\n  15 import com.oracle.bmc.auth.sasl.OciSaslClient;\n  16 import com.oracle.bmc.auth.sasl.OciSaslClientProvider;\n+ 17 import com.oracle.bmc.auth.sasl.UserPrincipalsLoginModule;\n  17 import com.oracle.bmc.identity.auth.sasl.messages.OciSaslMessages;\n  18 import java.io.ByteArrayInputStream;\n  19 import java.io.IOException;\n  20 import java.io.InputStream;\n+ 22 import java.nio.file.Files;\n+ 23 import java.nio.file.Path;\n  21 import java.security.KeyPair;\