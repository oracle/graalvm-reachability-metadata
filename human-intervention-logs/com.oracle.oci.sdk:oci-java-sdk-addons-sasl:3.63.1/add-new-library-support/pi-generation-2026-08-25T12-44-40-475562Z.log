cCredentials()).contains(\"database\");\n        assertThat(subject.getPrivateCredentials(BasicAuthenticationDetailsProvider.class))\n                .singleElement()\n                .satisfies(\n                        provider ->\n                                assertThat(provider.getKeyId())\n                                        .isEqualTo(\"ocid1.user.oc1..test/fingerprint\"));\n    }\n\n    @Test\n    void registeredProviderCreatesAndCompletesAnOciSaslExchange() throws Exception {\n"}]}}], "api": "openai-codex-responses", "provider": "openai-codex", "model": "gpt-5.6-terra", "usage": {"input": 5151, "output": 1254, "cacheRead": 70144, "cacheWrite": 0, "reasoning": 559, "totalTokens": 76549, "cost": {"input": 0.010302, "output": 0.015048, "cacheRead": 0.014028800000000001, "cacheWrite": 0, "total": 0.039378800000000005}}, "stopReason": "toolUse", "timestamp": 1787661795670, "responseId": "resp_06eb7c9f767ff06f016a8d8de4117c87d2a78f899a064989d2", "rawStopReason": "completed"}}
