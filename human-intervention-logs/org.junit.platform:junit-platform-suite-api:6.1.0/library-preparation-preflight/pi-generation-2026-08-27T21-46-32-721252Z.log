ation file ci.json not found at expected path: ${ciJsonFile.absolutePath}\\\"\")\n}\n\nString baseLayerFilePath = providers.gradleProperty(\"tck.baseLayerFile\").getOrElse(\"\").trim()\nboolean layeredNativeImage = !baseLayerFilePath.isEmpty()\nboolean dedicatedLayer = providers.gradleProperty(\"tck.dedicatedLayer\")\n        .map { String value -> value.toBoolean() }\n        .getOrElse(false)\nFile baseLayerFile = layeredNativeImage ? file(baseLayerFilePath) : null\nif (dedicatedLayer && !layeredNativeImage) {\n    throw new GradleException(\"Property 'tck.dedicatedLayer=true' requires 'tck.baseLayerFile'.\")\n}\n\ntck.testedLibraryVersion = libraryVersion\n// This value can be used to request specific library version to test with.\n\ndependencies {\n    testImplementation(platform(libs.test.junit.bom))\n    testImplementation(libs.test.junit.jupiter.core)\n    testImplementation(libs.test.junit.vintage)\n    testImplementation \"org.graalvm:tck-test-support:1.0.0-SNAPSHOT\"\n    testRuntimeOnly \"org.junit.platform:junit-platform-launcher\"\n}\n\nClosure<List<ResolvedArtifact>> resolveTestedLibraryArtifacts = {\n    String targetGroup = \"\"\n    String targetArtifact = \"\"\n    String targetVersion = \"\"\n    String[] coordsParts = (libraryGAV ?: \"\").split(\":\")\n    if (coordsParts.length >= 3) {\n        targetGroup = coordsParts[0]\n        targetArtifact = coordsParts[1]\n        targetVersion = coordsParts[2]\n    }\n\n    Set<ResolvedArtifact> artifacts = configurations.testRuntimeClasspath.resolvedConfiguration.resolvedArtifacts\n    Set<ResolvedArtifact> matched = new LinkedHashSet<>(artifacts.findAll { ResolvedArtifact artifact ->\n        (artifact.moduleVersion.id.group == targetGroup) && (artifact.moduleVersion.id.name == targetArtifact)\n    })\n\n    if (matched.isEmpty()) {\n        // Fallback for relocated or substituted modules: the requested G:A coordinates may resolve\n        // to a different group in published metadata, so no resolved artifact carries the original group.\n        matched.addAll(artifacts.findAll { ResolvedArtifact artifact ->\n            (artifact.moduleVersion.id.name == targetArtifact) && (artifact.moduleVersion.id.version == targetVersion)\n        })\n    }\n\n    if (matched.isEmpty()) {\n        throw new GradleException(\"No eligible artifacts found on the classpath for ${libraryGAV}.\\nPlease verify that the provided artifact exists.\")\n    }\n\n    return matched.toList().sort { ResolvedArtifact artifact -> artifact.file.absolutePath }\n}\n\nClosure<List<File>> resolveTestedLibraryJars = {\n    return resolveTestedLibraryArtifacts().collect { ResolvedArtifact artifact -> artifact.file }\n}\n\nClosure<List<File>> resolveTestedLibraryMainJars = {\n    List<ResolvedArtifact> mainArtifacts = resolveTestedLibraryArtifacts().findAll { ResolvedArtifact artifact ->\n        JarUtils.isUnclassifiedMainJar(artifact.extension, artifact.classifier)\n    }\n    if (mainArtifacts.isEmpty()) {\n        throw new GradleException(\n                \"No unclassified main JAR found on the classpath for ${libraryGAV}.\\n\" +\n                        \"Please verify that the coordinate publishes a main JAR.\"\n        )\n    }\n    return mainArtifacts.collect { ResolvedArtifact artifact -> artifact.file }\n}\n\nClosure<List<File>> resolveJUnitRuntimeJars = {\n    Set<File> matched = new LinkedHashSet<>(\n            configurations.nativeImageTestClasspath.resolvedConfiguration.resolvedArtifacts.findAll { artifact ->\n                BaseLayerUtils.isJUnitRuntimeArtifact(\n                        artifact.moduleVersion.id.group,\n                        artifact.moduleVersion.id.name)\n            }.collect { artifact ->\n                artifact.file\n            })\n    if (matched.isEmpty()) {\n        throw new GradleException(\"No JUnit runtime artifacts found on the test runtime classpath.\")\n    }\n    return matched.toList().sort { File file -> file.absolutePath }\n}\n\nClosure<List<File>> resolveDedicatedLayerJars = {\n    Set<File> includedJars = new LinkedHashSet<>(resolveTestedLibraryJars())\n    includedJars.addAll(resolveJUnitRuntimeJars())\n    return includedJars.toList().sort { File file -> file.absolutePath }\n}\n\nFile coordinateMetadataDirectory = file(metadataPath).absoluteFile\nString coordinateMetadataArgument = \"-H:ConfigurationFileDirectories=${coordinateMetadataDirectory.absolutePath}\"\nString junitPlatformFeatureArgument = \"--features=org.graalvm.junit.platform.JUnitPlatformFeature\"\nTaskProvider<BuildNativeImageTask> nativeTestCompileTask = tasks.named(\n        \"nativeTestCompile\", BuildNativeImageTask)\nProvider<Directory> dedicatedLayerJUnitTestListDirectory = layout.buildDirectory.dir(\n        \"native/generated/dedicatedLayerJUnitTestList\")\nProvider<Directory> dedicatedLayerConfigurationDirectory = layout.buildDirectory.dir(\n        \"native/generated/dedicatedLayerConfiguration\")\nProvider<Directory> dedicatedLayerReachabilityMetadataDirectory = layout.buildDirectory.dir(\n        \"native/generated/dedicatedLayerReachabilityMetadata\")\n\nif (dedicatedLayer) {\n    tasks.named(\"processTestResources\").configure { task ->\n        task.exclude(\"META-INF/native-image/**/reachability-metadata.json\")\n    }\n    tasks.named(\"generateTestResourcesConfigFile\").configure { task ->\n        task.dependsOn(tasks.named(\"processTestResources\"))\n    }\n}\n\ntasks.register(\"generateDedicatedLayerJUnitTestList\") { task ->\n    task.setDescription(\"Generates engine-root JUnit selectors for the dedicated layer\")\n    task.setGroup(\"build\")\n    task.outputs.dir(dedicatedLayerJUnitTestListDirectory)\n    task.doLast {\n        File outputDirectory = dedicatedLayerJUnitTestListDirectory.get().asFile\n        delete(outputDirectory)\n        if (!outputDirectory.mkdirs()) {\n            throw new GradleException(\"Failed to create base-layer JUnit test-list directory: \" +\n                    outputDirectory.absolutePath)\n        }\n        File selectorsFile = new File(outputDirectory, \"junit-platform-unique-ids-base\")\n        List<String> engineRootSelectors = [\n                \"[engine:junit-jupiter]\",\n                \"[engine:junit-vintage]\"\n        ]\n        selectorsFile.text = engineRootSelectors.join(System.lineSeparator()) + System.lineSeparator()\n    }\n}\n\nClosure<List<File>> resolveTestReachabilityMetadataFiles = {\n    return sourceSets.test.resources.srcDirs.collectMany { File resourceDirectory ->\n        fileTree(resourceDirectory) {\n            include(\"META-INF/native-image/**/reachability-metadata.json\")\n        }.files\n    }.unique().sort { File file -> file.absolutePath }\n}\n\nClosure<Object> withoutReachabilityConditions\nwithoutReachabilityConditions = { Object value ->\n    if (value instanceof Map) {\n        Map<String, Object> result = new LinkedHashMap<>()\n        value.each { Object key, Object nestedValue ->\n            if (key != \"condition\") {\n                result.put(key.toString(), withoutReachabilityConditions(nestedValue))\n            }\n\n[581 more lines in file. Use offset=505 to continue.]"}], "isError": false, "timestamp": 1787867138135}, {"role": "toolResult", "toolCallId": "call_NfBiTEyMpVJfzOnNCNIkPJER|fc_068c3fe54e3b03b8016a90b001cd7887d29f161a79d967ab83", "toolName": "read", "content": [{"type": "text", "text": "[\n  {\n    \"latest\" : true,\n    \"auto-update\" : true,\n    \"high-priority\" : true,\n    \"metadata-version\" : \"6.0.0\",\n    \"source-code-url\" : \"https://repo.maven.apache.org/maven2/org/junit/platform/junit-platform-suite-api/$version$/junit-platform-suite-api-$version$-sources.jar\",\n    \"repository-url\" : \"https://github.com/junit-team/junit-framework\",\n    \"test-code-url\" : \"https://github.com/junit-team/junit-framework/tree/r$version$/platform-tests/src/test/java/org/junit/platform/suite\",\n    \"documentation-url\" : \"https://repo.maven.apache.org/maven2/org/