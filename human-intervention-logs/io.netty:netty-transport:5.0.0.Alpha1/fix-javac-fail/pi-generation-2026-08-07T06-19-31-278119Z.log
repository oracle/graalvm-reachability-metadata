          private final int status;
  
          private final String protocol;
  
          private final String content;
  
          Response(int status, String protocol, String content) {
              this.status = status;
              this.protocol = protocol;
              this.content = content;
          }
  
          @Override
          public String toString() {
              return "Response{" +
                      "status=" + status +
                      ", protocol='" + protocol + '\'' +
                      ", content='" + content + '\'' +
                      '}';
