assertTrue(errorSubscriber.awaitFailure() instanceof IllegalStateException);\n+216 \n+217         AtomicReference<Tube<String>> ignoreTubeReference = new AtomicReference<>();\n+218         RecordingSubscriber<String> ignoreSubscriber = subscribe(\n+219                 new TubeConfiguration().withBackpressureStrategy(BackpressureStrategy.IGNORE), ignoreTubeReference);\n+220         ignoreTubeReference.get().send(\"one\").send(\"two\").complete();\n+221         ignoreSubscriber.awaitCompletion();\n+222         assertEquals(List.of(\"one\", \"two\"), ignoreSubscriber.items());\n+223     }\n+224 \n+225     @Test\n+226     public void signalsTubeFailureAndCancellationCallbacks() throws Exception {\n+227         AtomicReference<Tube<String>> failedTubeReference = new AtomicReference<>();\n+228         RecordingSubscriber<String> failedSubscriber = subscribe(new TubeConfiguration(), failedTubeReference);\n+229         IllegalArgumentException failure = new IllegalArgumentException(\"tube failed\");\n+230         failedTubeReference.get().fail(failure);\n+231         assertSame(failure, failedSubscriber.awaitFailure());\n+232 \n+233         AtomicReference<Tube<String>> cancelledTubeReference = new AtomicReference<>();\n+234         RecordingSubscriber<String> cancelledSubscriber = subscribe(new TubeConfiguration(), cancelledTubeReference);\n+235         AtomicBoolean cancelled = new AtomicBoolean();\n+236         AtomicBoolean terminated = new AtomicBoolean();\n+237         Tube<String> cancelledTube = cancelledTubeReference.get()\n+238                 .whenCancelled(() -> cancelled.set(true))\n+239                 .whenTerminates(() -> terminated.set(true));\n+240 \n+241         cancelledSubscriber.cancel();\n+242 \n+243         assertTrue(cancelledTube.cancelled());\n+244         assertTrue(cancelled.get());\n+245         assertTrue(terminated.get());\n+246     }\n+247 \n+248     private static <T> List<T> collect(Flow.Publisher<T> publisher) throws Exception {\n+249         return PublisherHelpers.collectToList(publisher)\n+250                 .toCompletableFuture()\n+251                 .get(TIMEOUT_SECONDS, SECONDS);\n+252     }\n+253 \n+254     private static <T> RecordingSubscriber<T> subscribe(\n+255             TubeConfiguration configuration, AtomicReference<Tube<T>> tubeReference) {\n+256         Flow.Publisher<T> publisher = ZeroPublisher.create(configuration, tubeReference::set);\n+257         RecordingSubscriber<T> subscriber = new RecordingSubscriber<>();\n+258         publisher.subscribe(subscriber);\n+259         assertNotNull(tubeReference.get());\n+260         return subscriber;\n+261     }\n+262 \n+263     private static final class RecordingSubscriber<T> implements Flow.Subscriber<T> {\n+264         private final List<T> items = Collections.synchronizedList(new ArrayList<>());\n+265         private final CompletableFuture<Void> terminated = new CompletableFuture<>();\n+266         private volatile Flow.Subscription subscription;\n+267         private volatile Throwable failure;\n+268 \n+269         @Override\n+270         public void onSubscribe(Flow.Subscription newSubscription) {\n+271             subscription = newSubscription;\n+272         }\n+273 \n+274         @Override\n+275         public void onNext(T item) {\n+276             items.add(item);\n+277         }\n+278 \n+279         @Override\n+280         public void onError(Throwable throwable) {\n+281             failure = throwable;\n+282             terminated.complete(null);\n+283         }\n+284 \n+285         @Override\n+286         public void onComplete() {\n+287             terminated.complete(null);\n+288         }\n+289 \n+290         private void request(long count) {\n+291             assertNotNull(subscription);\n+292             subscription.request(count);\n+293         }\n+294 \n+295         private void cancel() {\n+296             assertNotNull(subscription);\n+297             subscription.cancel();\n+298         }\n+299 \n+300        