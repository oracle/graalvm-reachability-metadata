  {
    "coordinates" : "io.smallrye.reactive:mutiny-zero:1.3.1",
    "repository-url" : "https://github.com/smallrye/smallrye-mutiny-zero",
    "source-code-url" : "https://repo1.maven.org/maven2/io/smallrye/reactive/mutiny-zero/$version$/mutiny-zero-$version$-sources.jar",
    "test-code-url" : "https://github.com/smallrye/smallrye-mutiny-zero/tree/$version$/mutiny-zero/src/test",
