  53:            streamSubscriptions.incrementAndGet();
  54:            return Stream.of("one", "two");
  56:        assertThat(collect(streamed)).containsExactly("one", "two");
  57:        assertThat(collect(streamed)).containsExactly("one", "two");
  58:        assertThat(streamSubscriptions).hasValue(2);
