9:import java.util.concurrent.atomic.AtomicBoolean;\n20:import java.util.concurrent.atomic.AtomicInteger;\n21:import java.util.concurrent.atomic.AtomicLong;\n22:import java.util.concurrent.atomic.AtomicReference;\n23:import java.util.function.Consumer;\n24:import java.util.stream.IntStream;\n25:import java.util.stream.Stream;\n27:import mutiny.zero.AsyncHelpers;\n28:import mutiny.zero.BackpressureStrategy;\n29:import mutiny.zero.PublisherHelpers;\n30:import mutiny.zero.Tube;\n31:import mutiny.zero.TubeConfiguration;\n32:import mutiny.zero.ZeroPublisher;\n33:import mutiny.zero.operators.Concatenate;\n34:import mutiny.zero.operators.Recover;\n35:import mutiny.zero.operators.Retry;\n36:import mutiny.zero.operators.Select;\n37:import mutiny.zero.operators.Spread;\n38:import mutiny.zero.operators.Transform;\n39:import org.junit.jupiter.api.Test;\n41:public class MutinyZeroTest {\n42:    @Test\n43:    void createsPublishersFromValuesAndLazySources() throws Exception {\n44:        assertThat(collect(ZeroPublisher.fromItems(\"alpha\", \"beta\"))).containsExactly(\"alpha\", \"beta\");\n45:        assertThat(collect(ZeroPublisher.fromIterable(List.of(1, 2, 3)))).containsExactly(1, 2, 3);\n47:        Flow.Publisher<Integer> generated = ZeroPublisher.fromGenerator(\n48:                () -> 4, count -> IntStream.rangeClosed(1, count).iterator());\n49:        assertThat(collect(generated)).containsExactly(1, 2, 3, 4);\n51:        AtomicInteger streamSubscriptions = new AtomicInteger();\n52:        Flow.Publisher<String> streamed = ZeroPublisher.fromStream(() -> {\n53:            streamSubscriptions.incrementAndGet();\n54:            return Stream.of(\"one\", \"two\");\n56:        assertThat(collect(streamed)).containsExactly(\"one\", \"two\");\n57:        assertThat(collect(streamed)).containsExactly(\"one\", \"two\");\n58:        assertThat(streamSubscriptions).hasValue(2);\n61:    @Test\n62:    void bridgesPublishersAndCompletionStages() throws Exception {\n63:        Flow.Publisher<String> publisher = ZeroPublisher.fromCompletionStage(\n64:                () -> CompletableFuture.completedFuture(\"ready\"));\n65:        assertThat(collect(publisher)).containsExactly(\"ready\");\n67:        Optional<String> first = await(ZeroPublisher.toCompletionStage(ZeroPublisher.fromItems(\"first\", \"second\")));\n68:        Optional<String> empty = await(ZeroPublisher.toCompletionStage(ZeroPublisher.empty()));\n69:        assertThat(first).contains(\"first\");\n70:        assertThat(empty).isEmpty();\n72:        IllegalStateException failure = new IllegalStateException(\"unavailable\");\n73:        assertThat(awaitFailure(PublisherHelpers.collectToList(ZeroPublisher.fromFailure(failure))))\n74:                .isSameAs(failure);\n77:    @Test\n78:    void composesTransformationSelectionSpreadingAndConcatenation() throws Exception {\n79:        Flow.Publisher<Integer> transformed = new Transform<>(ZeroPublisher.fromItems(1, 2, 3), value -> value * 10);\n80:        Flow.Publisher<Integer> selected = new Select<>(transformed, value -> value >= 20);\n81:        Flow.Publisher<String> spread = new Spread<>(selected,\n82:                value -> ZeroPublisher.fromItems(value + \"a\", value + \"b\"), 2, 2);\n83:        Flow.Publisher<String> concatenated = new Concatenate<>(\n84:                List.of(ZeroPublisher.fromItems(\"start\"), spread, ZeroPublisher.empty()));\n86:        assertThat(collect(concatenated)).containsExactly(\"start\", \"20a\", \"20b\", \"30a\", \"30b\");\n89:    @Test\n90:    void recoversFromFailuresAndRetriesSubscriptions() throws Exception {\n91:        Flow.Publisher<String> recovered = new Recover<>(\n92:                ZeroPublisher.fromFailure(new IllegalArgumentException(\"rejected\")),\n93:                failure -> \"fallback:\" + failure.getMessage());\n94:        assertThat(collect(recovered)).containsExactly(\"fallback:rejected\");\n96:        AtomicInteger boundedAttempts = new AtomicInteger();\n97:        Flow.Publisher<String> boundedRetry = new Retry<>(\n98:                succeedsAfter(boundedAttempts, 2, \"bounded\"), Retry.atMost(2));\n99:        assertThat(collect(boundedRetry)).containsExactly(\"bounded\");\n100:        assertThat(boundedAttempts).hasValue(3);\n102:        AtomicInteger unlimitedAttempts = new AtomicInteger();\n103:        Flow.Publisher<String> unlimitedRetry = new Retry<>(\n104:                succeedsAfter(unlimitedAttempts, 1, \"unlimited\"), Retry.always());\n105:        assertThat(collect(unlimitedRetry)).containsExactly(\"unlimited\");\n106:        assertThat(unlimitedAttempts).hasValue(2);\n109:    @Test\n110:    void mapsAndComposesAsynchronousFailures() throws Exception {\n111:        AtomicBoolean successMapperCalled = new AtomicBoolean();\n112:        CompletionStage<String> unchanged = AsyncHelpers.applyExceptionally(\n113:                CompletableFuture.completedFuture(\"ok\"), failure -> {\n114:                    successMapperCalled.set(true);\n115:                    return failure;\n117:        assertThat(await(unchanged)).isEqualTo(\"ok\");\n118:        assertThat(successMapperCalled).isFalse();\n120:        IllegalArgumentException original = new IllegalArgumentException(\"invalid\");\n121:        IllegalStateException mapped = new IllegalStateException(\"mapped\");\n122:        CompletionStage<String> mappedFailure = AsyncHelpers.applyExceptionally(\n123:                CompletableFuture.failedFuture(original), failure -> mapped);\n124:        assertThat(awaitFailure(mappedFailure)).isSameAs(mapped);\n126:        CompletionStage<String> recovered = AsyncHelpers.composeExceptionally(\n127:                CompletableFuture.failedFuture(original),\n128:                failure -> CompletableFuture.completedFuture(\"recovered:\" + failure.getMessage()));\n129:        assertThat(await(recovered)).isEqualTo(\"recovered:invalid\");\n132:    @Test\n133:    void buffersTubeItemsUntilDemandAndRunsLifecycleCallbacks() throws Exception {\n134:        TubeConfiguration configuration = new TubeConfiguration()\n135:                .withBackpressureStrategy(BackpressureStrategy.BUFFER)\n136:                .withBufferSize(2);\n137:        assertThat(configuration.getBackpressureStrategy()).isEqualTo(BackpressureStrategy.BUFFER);\n138:        assertThat(configuration.getBufferSize()).isEqualTo(2);\n140:        AtomicLong requested = new AtomicLong();\n141:        AtomicBoolean terminated = new AtomicBoolean();\n142:        AtomicReference<Tube<String>> tubeReference = new AtomicReference<>();\n143:        ProbeSubscriber<String> subscriber = subscribe(configuration, tube -> {\n144:            tubeReference.set(tube);\n145:            tube.whenRequested(requested::addAndGet)\n146:                    .whenTerminates(() -> terminated.set(true))\n147:                    .send(\"first\")\n148:                    .send(\"second\")\n149:                    .complete();\n152:        assertThat(subscriber.items()).isEmpty();\n153:        subscriber.request(2);\n154:        subscriber.awaitDone();\n155:        assertThat(subscriber.items()).containsExactly(\"first\", \"second\");\n156:        assertThat(requested).hasValue(2);\n157:        assertThat(terminated).isTrue();\n158:        assertThat(tubeReference.get().cancelled()).isTrue();\n159:        assertThat(tubeReference.get().outstandingRequests()).isZero();\n162:    @Test\n163:    void appliesEachTubeOverflowStrategy() throws Exception {\n164:        ProbeSubscriber<String> unbounded = subscribe(\n165:                configuration(BackpressureStrategy.UNBOUNDED_BUFFER, -1),\n166:                tube -> tube.send(\"one\").send(\"two\").complete());\n167:        unbounded.request(2);\n168:        unbounded.awaitDone();\n169:        assertThat(unbounded.items()).containsExactly(\"one\", \"two\");\n171:        ProbeSubscriber<String> latest = subscribe(\n172:                configuration(BackpressureStrategy.LATEST, 1),\n173:                tube -> tube.send(\"old\").send(\"new\").complete());\n174:        latest.request(1);\n175:        latest.awaitDone();\n176:        assertThat(latest.items()).containsExactly(\"new\");\n178:        ProbeSubscriber<String> dropped = subscribe(new TubeConfiguration(),\n179:                tube -> tube.send(\"dropped\").complete());\n180:        dropped.awaitDone();\n181:        assertThat(dropped.items()).isEmpty();\n183:        ProbeSubscriber<String> ignored = subscribe(\n184:                configuration(BackpressureStrategy.IGNORE, -1),\n185:                tube -> tube.send(\"delivered\").complete());\n186:        ignored.awaitDone();\n187:        assertThat(ignored.items()).containsExactly(\"delivered\");\n189:        ProbeSubscriber<String> errored = subscribe(\n190:                configuration(BackpressureStrategy.ERROR, -1),\n191:                tube -> tube.send(\"without-demand\"));\n192:        assertThat(errored.awaitFailure())\n193:                .isInstanceOf(IllegalStateException.class)\n194:                .hasMessageContaining(\"without-demand\");\n197:    @Test\n198:    void propagatesTubeFailures() throws Exception {\n199:        IllegalStateException failure = new IllegalStateException(\"tube failed\");\n200:        ProbeSubscriber<String> subscriber = subscribe(new TubeConfiguration(), tube -> tube.fail(failure));\n202:        assertThat(subscriber.awaitFailure()).isSameAs(failure);\n205:    @Test\n206:    void notifiesTubeCancellationCallbacks() {\n207:        AtomicBoolean cancelled = new AtomicBoolean();\n208:        AtomicBoolean terminated = new AtomicBoolean();\n209:        ProbeSubscriber<String> subscriber = subscribe(new TubeConfiguration(), tube -> tube\n210:                .whenCancelled(() -> cancelled.set(true))\n211:                .whenTerminates(() -> terminated.set(true)));\n213:        subscriber.cancel();\n214:        assertThat(cancelled).isTrue();\n215:        assertThat(terminated).isTrue();\n218:    private static TubeConfiguration configuration(BackpressureStrategy strategy, int bufferSize) {\n219:        return new TubeConfiguration().withBackpressureStrategy(strategy).withBufferSize(bufferSize);\n222:    private static <T> ProbeSubscriber<T> subscribe(\n223:            TubeConfiguration configuration, Consumer<Tube<T>> tubeConsumer) {\n224:        ProbeSubscriber<T> subscriber = new ProbeSubscriber<>();\n225:        ZeroPublisher.create(configuration, tubeConsumer).subscribe(subscriber);\n226:        return subscriber;\n229:    private static Flow.Publisher<String> succeedsAfter(\n230:            AtomicInteger attempts, int failuresBeforeSuccess, String result) {\n231:        return subscriber -> subscriber.onSubscribe(new Flow.Subscription() {\n232:            private boolean finished;\n234:            @Override\n235:            public void request(long count) {\n236:                if (finished) {\n237:                    return;\n239:                finished = true;\n240:                if (attempts.incrementAndGet() <= failuresBeforeSuccess) {\n241:                    subscriber.onError(new IllegalStateException(\"try again\"));\n242:                } else {\n243:                    subscriber.onNext(result);\n244:                    subscriber.onComplete();\n248:            @Override\n249:            public void cancel() {\n250:                finished = true;\n255:    private static <T> List<T> collect(Flow.Publisher<T> publisher) throws Exception {\n256:        return await(PublisherHelpers.collectToList(publisher));\n259:    private static <T> T await(CompletionStage<T> stage) throws Exception {\n260:        return stage.toCompletableFuture().get(10, SECONDS);\n263:    private static Throwable awaitFailure(CompletionStage<?> stage) throws Exception {\n264:        try {\n265:            stage.toCompletableFuture().get(10, SECONDS);\n266:            throw new AssertionError(\"Expected the completion stage to fail\");\n267:        } catch (ExecutionException exception) {\n268:            return exception.getCause();\n272:    private static final class ProbeSubscriber<T> implements Flow.Subscriber<T> {\n273:        private final List<T> items = new ArrayList<>();\n274:        private final CompletableFuture<Void> done = new CompletableFuture<>();\n275:        private final CompletableFuture<Throwable> failure = new CompletableFuture<>();\n276:        private Flow.Subscription subscription;\n278:        @Override\n279:        public void onSubscribe(Flow.Subscription newSubscription) {\n280:            subscription = newSubscription;\n283:        @Override\n284:        public void onNext(T item) {\n285:            items.add(item);\n288:        @Override\n289:        public void onError(Throwable throwable) {\n290:            failure.complete(throwable);\n291:            done.complete(null);\n294:        @Override\n295:        public void onComplete() {\n296:            done.complete(null);\n299:        private void request(long count) {\n300:            subscription.request(count);\n303:        private void cancel() {\n304:            subscription.cancel();\n307:        private List<T> items() {\n308:            return List.copyOf(items);\n311:        private void awaitDone() throws Exception {\n312:            done.get(10, SECONDS);\n315:        private Throwable awaitFailure() throws Exception {\n316:            return failure.get(10, SECONDS);\n"}], "isError": false, "timestamp": 1791227465630}]}
