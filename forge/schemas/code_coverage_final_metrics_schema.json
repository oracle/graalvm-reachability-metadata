{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Code Coverage Final Metrics",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "coordinate",
    "coverageSuitePath",
    "finalMeasurementArtifacts",
    "runCoverage",
    "apiJacoco",
    "deepJacoco",
    "pgoGuidance",
    "targets",
    "stopDecisions",
    "validationCommands",
    "needsHumanIntervention"
  ],
  "properties": {
    "schemaVersion": {"const": "1.3.0"},
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "coordinate": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+:[A-Za-z0-9_.+-]+$"
    },
    "coverageSuitePath": {"type": "string", "minLength": 1},
    "finalMeasurementArtifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jacoco", "discoveryReport"],
      "properties": {
        "jacoco": {"type": "string", "minLength": 1},
        "discoveryReport": {"type": "string", "minLength": 1}
      }
    },
    "runCoverage": {"$ref": "#/$defs/runCoverage"},
    "apiJacoco": {"$ref": "#/$defs/apiEvidence"},
    "deepJacoco": {"$ref": "#/$defs/deepEvidence"},
    "pgoGuidance": {"$ref": "#/$defs/pgoGuidance"},
    "targets": {"$ref": "#/$defs/outcomes"},
    "stopDecisions": {
      "description": "Each phase's recorded loop decision, API first. Empty only for a run finalized without them.",
      "type": "array",
      "maxItems": 2,
      "items": {"$ref": "#/$defs/stopDecision"}
    },
    "validationCommands": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "needsHumanIntervention": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "targets": {
            "properties": {"failed": {"minItems": 1}},
            "required": ["failed"]
          }
        },
        "required": ["targets"]
      },
      "then": {
        "properties": {"needsHumanIntervention": {"const": true}}
      },
      "else": {
        "properties": {"needsHumanIntervention": {"const": false}}
      }
    }
  ],
  "$defs": {
    "runCoverage": {
      "description": "Whole-run coverage on one denominator: the complete count of library methods JaCoCo can rule on. Every checkpoint is counted over that one frozen method-id set from a single JaCoCo report, so each phase begins where the previous phase ended.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "universe",
        "apiUniverse",
        "deepUniverse",
        "checkpoints",
        "phases"
      ],
      "properties": {
        "universe": {"type": "integer", "minimum": 0},
        "apiUniverse": {"type": "integer", "minimum": 0},
        "deepUniverse": {"type": "integer", "minimum": 0},
        "checkpoints": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/runCheckpoint"}
        },
        "phases": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/runPhaseGain"}
        }
      }
    },
    "runCheckpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "apiCovered",
        "deepCovered",
        "covered",
        "uncovered",
        "coveragePercent"
      ],
      "properties": {
        "name": {"enum": ["runStart", "afterApiPhase", "final"]},
        "apiCovered": {"type": "integer", "minimum": 0},
        "deepCovered": {"type": "integer", "minimum": 0},
        "covered": {"type": "integer", "minimum": 0},
        "uncovered": {"type": "integer", "minimum": 0},
        "coveragePercent": {"type": "number", "minimum": 0, "maximum": 100}
      }
    },
    "stopDecision": {
      "description": "Why one coverage phase's loop ended, recorded by that phase's own measurement. A phase may end before its budget because nothing uncovered remains or because its pass yield collapsed; without this record a short run cannot be told apart from a crashed one.",
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "passes", "budget", "threshold", "window", "floor", "reason", "passYields"],
      "properties": {
        "phase": {"enum": ["api", "deep"]},
        "passes": {"type": "integer", "minimum": 0},
        "budget": {"type": "integer", "minimum": 1},
        "threshold": {
          "description": "Pass yield below which a pass counts as low, in newly covered methods.",
          "type": "integer",
          "minimum": 1
        },
        "window": {"type": "integer", "minimum": 1},
        "floor": {"type": "integer", "minimum": 1},
        "reason": {
          "description": "Null only for a decision recorded on a pass that did not end the phase.",
          "type": ["string", "null"],
          "enum": ["no-targets", "budget-spent", "marginal-yield", null]
        },
        "passYields": {
          "description": "Methods newly covered by each cover pass, in run order.",
          "type": "array",
          "items": {"type": "integer"}
        }
      }
    },
    "runPhaseGain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "covered", "coveragePercentagePoints"],
      "properties": {
        "name": {"enum": ["api", "deep"]},
        "covered": {"type": "integer"},
        "coveragePercentagePoints": {"type": "number"}
      }
    },
    "apiSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "measured",
        "covered",
        "uncovered",
        "notReported",
        "coveragePercent"
      ],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "measured": {"type": "integer", "minimum": 0},
        "covered": {"type": "integer", "minimum": 0},
        "uncovered": {"type": "integer", "minimum": 0},
        "notReported": {"type": "integer", "minimum": 0},
        "coveragePercent": {"type": "number", "minimum": 0, "maximum": 100}
      }
    },
    "deepSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "covered", "uncovered", "coveragePercent"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "covered": {"type": "integer", "minimum": 0},
        "uncovered": {"type": "integer", "minimum": 0},
        "coveragePercent": {"type": "number", "minimum": 0, "maximum": 100}
      }
    },
    "apiDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "covered",
        "uncovered",
        "notReported",
        "coveragePercentagePoints"
      ],
      "properties": {
        "covered": {"type": "integer"},
        "uncovered": {"type": "integer"},
        "notReported": {"type": "integer"},
        "coveragePercentagePoints": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        }
      }
    },
    "deepDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["covered", "uncovered", "coveragePercentagePoints"],
      "properties": {
        "covered": {"type": "integer"},
        "uncovered": {"type": "integer"},
        "coveragePercentagePoints": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        }
      }
    },
    "apiEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "final", "delta"],
      "properties": {
        "baseline": {"$ref": "#/$defs/apiSnapshot"},
        "final": {"$ref": "#/$defs/apiSnapshot"},
        "delta": {"$ref": "#/$defs/apiDelta"}
      }
    },
    "deepEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "final", "delta"],
      "properties": {
        "baseline": {"$ref": "#/$defs/deepSnapshot"},
        "final": {"$ref": "#/$defs/deepSnapshot"},
        "delta": {"$ref": "#/$defs/deepDelta"}
      }
    },
    "pgoSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "samplingContexts",
        "sampledMethods",
        "sampleCount",
        "sampledJoins"
      ],
      "properties": {
        "samplingContexts": {"type": "integer", "minimum": 0},
        "sampledMethods": {"type": "integer", "minimum": 0},
        "sampleCount": {"type": "integer", "minimum": 0},
        "sampledJoins": {"type": "integer", "minimum": 0}
      }
    },
    "pgoGuidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["guidanceOnly", "note", "baseline", "final"],
      "properties": {
        "guidanceOnly": {"const": true},
        "note": {"type": "string", "minLength": 1},
        "baseline": {"$ref": "#/$defs/pgoSnapshot"},
        "final": {"$ref": "#/$defs/pgoSnapshot"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "phase", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "phase": {"enum": ["api", "deep"]},
        "status": {"enum": ["completed", "skipped", "exhausted", "failed"]},
        "attemptCount": {"type": "integer", "minimum": 0},
        "lastAttemptedIteration": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 5
        },
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "completedTarget": {
      "allOf": [
        {"$ref": "#/$defs/target"},
        {"properties": {"status": {"const": "completed"}}}
      ]
    },
    "terminalTarget": {
      "allOf": [
        {"$ref": "#/$defs/target"},
        {
          "required": [
            "attemptCount",
            "lastAttemptedIteration",
            "reason"
          ],
          "properties": {"phase": {"const": "deep"}}
        }
      ]
    },
    "skippedTarget": {
      "allOf": [
        {"$ref": "#/$defs/terminalTarget"},
        {"properties": {"status": {"const": "skipped"}}}
      ]
    },
    "exhaustedTarget": {
      "allOf": [
        {"$ref": "#/$defs/terminalTarget"},
        {"properties": {"status": {"const": "exhausted"}}}
      ]
    },
    "failedTarget": {
      "allOf": [
        {"$ref": "#/$defs/terminalTarget"},
        {"properties": {"status": {"const": "failed"}}}
      ]
    },
    "outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completed", "skipped", "exhausted", "failed"],
      "properties": {
        "completed": {
          "type": "array",
          "items": {"$ref": "#/$defs/completedTarget"}
        },
        "skipped": {
          "type": "array",
          "items": {"$ref": "#/$defs/skippedTarget"}
        },
        "exhausted": {
          "type": "array",
          "items": {"$ref": "#/$defs/exhaustedTarget"}
        },
        "failed": {
          "type": "array",
          "items": {"$ref": "#/$defs/failedTarget"}
        }
      }
    }
  }
}
